// Standalone checker for the supported schematic certificate fragment.
import std.env
import std.fs
import std.sys
import schematic

fn run() -> Result(schematic.Report, String) {
    let args = env.args()
    if args.len() != 4 { return Err("usage: schematic-check THEORY GOALS PROOF") }
    let theory = fs.read_file(args[1])?
    let goals = fs.read_file(args[2])?
    let proof = fs.read_file(args[3])?
    schematic.check(theory.as_str(), goals.as_str(), proof.as_str())
}

fn main() {
    match run() {
        Ok(r) => println("ACCEPT " + r.goals.to_string() + " " + r.open_goals.to_string() +
            " " + r.steps.to_string() + " " + r.hypotheses.to_string() +
            " " + r.inductions.to_string() + " " + r.instances.to_string())
        Err(e) => { eprintln("REJECT: " + e.as_str()); sys.exit(1) }
    }
}
