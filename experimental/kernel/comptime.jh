// A certificate is checked during compilation, using the ordinary kernel.
import kernel

const THEORY = "(sort Nat) (ctor z () Nat) (ctor s (Nat) Nat) (pred even (Nat)) (rule zero () (even z)) (rule plus-two ((even ?n)) (even (s (s ?n))))"
const GOALS = "(goal four-is-even (even (s (s (s (s z))))))"
const PROOF = "(step 0 zero ()) (step 1 plus-two (0)) (step 2 plus-two (1)) (result four-is-even 2)"

fn verify() -> i64 {
    let th = kernel.Theory.parse(THEORY).unwrap()
    match th.check(GOALS, PROOF) {
        Ok(report) => report.steps
        Err(_) => trap()
    }
}

const CHECKED_STEPS = verify()
fn main() { println(CHECKED_STEPS) }
