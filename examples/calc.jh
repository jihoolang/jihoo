// A calculator with variables: a tokenizer, a parser that builds a tree of
// boxed nodes, and an evaluator. The shape of a small compiler.
//   jihoo run examples/calc.jh

enum Tok {
    Num(i64)
    Name(String)
    Op(u8)
    LParen
    RParen
    Eq
}

fn tokenize(src: str) -> Result(Vec(Tok), String) {
    var out = Vec(Tok).new()
    var i = 0
    while i < src.len {
        let c = src[i]
        if is_space(c) {
            i += 1
        } else if is_digit(c) {
            var n = 0
            while i < src.len && is_digit(src[i]) {
                n = n * 10 + (src[i] - '0') as i64
                i += 1
            }
            out.push(Tok.Num(n))
        } else if is_alpha(c) {
            let start = i
            while i < src.len && (is_alpha(src[i]) || is_digit(src[i])) {
                i += 1
            }
            out.push(Tok.Name(src[start..i].to_string()))
        } else {
            let t = match c {
                '(' => Tok.LParen
                ')' => Tok.RParen
                '=' => Tok.Eq
                '+' | '-' | '*' | '/' => Tok.Op(c)
                _ => return Err("unexpected character")
            }
            out.push(t)
            i += 1
        }
    }
    Ok(out)
}

enum Expr {
    Num(i64)
    Var(String)
    Bin(u8, Box(Expr), Box(Expr))
    Let(String, Box(Expr))
}

struct Parser {
    toks: Vec(Tok)
    at: i64
}

impl Parser {
    fn peek_op(self) -> u8 {
        if self.at < self.toks.len() {
            match self.toks[self.at] {
                Op(c) => c
                _ => 0
            }
        } else {
            0
        }
    }

    fn statement(inout self) -> Result(Expr, String) {
        // name = expr
        if self.at + 1 < self.toks.len() {
            let is_let = match self.toks[self.at + 1] {
                Eq => true
                _ => false
            }
            if is_let {
                let name = match self.toks[self.at] {
                    Name(n) => n.clone()
                    _ => return Err("expected a name before `=`")
                }
                self.at += 2
                let value = self.expr(0)?
                return Ok(Expr.Let(name, Box.new(value)))
            }
        }
        self.expr(0)
    }

    // Precedence climbing.
    fn expr(inout self, min: i64) -> Result(Expr, String) {
        var lhs = self.atom()?
        loop {
            let op = self.peek_op()
            let prec = match op {
                '+' | '-' => 1
                '*' | '/' => 2
                _ => 0
            }
            if prec == 0 || prec <= min {
                break
            }
            self.at += 1
            let rhs = self.expr(prec)?
            lhs = Expr.Bin(op, Box.new(lhs), Box.new(rhs))
        }
        Ok(lhs)
    }

    fn atom(inout self) -> Result(Expr, String) {
        if self.at >= self.toks.len() {
            return Err("unexpected end")
        }
        let i = self.at
        self.at += 1
        match self.toks[i] {
            Num(n) => Ok(Expr.Num(n))
            Name(s) => Ok(Expr.Var(s.clone()))
            LParen => {
                let e = self.expr(0)?
                match self.toks[self.at] {
                    RParen => {}
                    _ => return Err("expected `)`")
                }
                self.at += 1
                Ok(e)
            }
            _ => Err("expected a value")
        }
    }
}

fn eval(e: Expr, inout vars: Map(String, i64)) -> Result(i64, String) {
    match e {
        Num(n) => Ok(n)
        Var(name) => match vars.get(name) {
            Some(v) => Ok(v)
            None => Err("unknown variable " + name.as_str())
        }
        Bin(op, a, b) => {
            let x = eval(a, &vars)?
            let y = eval(b, &vars)?
            match op {
                '+' => Ok(x + y)
                '-' => Ok(x - y)
                '*' => Ok(x * y)
                _ => if y == 0 { Err("division by zero") } else { Ok(x / y) }
            }
        }
        Let(name, value) => {
            let v = eval(value, &vars)?
            vars.insert(name.clone(), v)
            Ok(v)
        }
    }
}

fn run(line: str, inout vars: Map(String, i64)) -> Result(i64, String) {
    let toks = tokenize(line)?
    var p = Parser { toks: toks, at: 0 }
    let e = p.statement()?
    eval(e, &vars)
}

fn main() {
    var vars = Map(String, i64).new()
    let program = ["x = 6 * 7", "y = x - 2", "(x + y) / 2", "z * 2", "10 / (y - 40)"]
    for line in program {
        match run(line, &vars) {
            Ok(v) => println(v)
            Err(e) => println("error: " + e.as_str())
        }
    }
}
