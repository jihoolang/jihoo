; Declared inductive propositions: graph edges and reachability from 0,
; a structural induction bounding reachable nodes, and an array load.
(inductive Edge 2
  (e01 (Edge 0 1))
  (e12 (Edge 1 2))
  (e02 (Edge 0 2)))

(inductive Reach 1
  (start (Reach 0))
  (step (pi a U64 (pi b U64 (pi0 r (Reach a) (pi0 e (Edge a b) (Reach b))))))
  (same (pi a U64 (pi b U64 (pi0 r (Reach a) (pi0 e (Eq a b) (Reach b)))))))

(def sym
  (pi a U64 (pi b U64 (pi0 e (Eq a b) (Eq b a))))
  (lam a U64 (lam b U64 (lam0 e (Eq a b)
    (transport (lam k U64 (Eq k a)) e (refl a))))))

(def edge_bound
  (pi a U64 (pi b U64 (pi0 e (Edge a b) (Lt b 3))))
  (lam a U64 (lam b U64 (lam0 e (Edge a b)
    (induct Edge (lam x U64 (lam y U64 (Lt y 3)))
      (decide-lt 1 3) (decide-lt 2 3) (decide-lt 2 3) e)))))

(def reach_bound
  (pi b U64 (pi0 r (Reach b) (Lt b 3)))
  (lam b U64 (lam0 r (Reach b)
    (induct Reach (lam x U64 (Lt x 3))
      (decide-lt 0 3)
      (lam a U64 (lam b U64 (lam0 r (Reach a) (lam0 e (Edge a b) (lam0 ih (Lt a 3)
        (app edge_bound a b e))))))
      (lam a U64 (lam b U64 (lam0 r (Reach a) (lam0 e (Eq a b) (lam0 ih (Lt a 3)
        (transport (lam k U64 (Lt k 3)) e ih))))))
      r))))

(def node
  (pi b U64 (pi0 r (Reach b) I64))
  (lam b U64 (lam0 r (Reach b)
    (index (array (int 10) (int 20) (int 30)) b (app reach_bound b r)))))

(def at_one (Reach 1) (step 0 1 start e01))

(def at_two (Reach 2) (step 1 2 at_one e12))

(export cost
  (pi b U64 I64)
  (lam b U64
    (if-eq b 2 e (app node b (same 2 b at_two (app sym b 2 e)))
      (if-eq b 1 e (app node b (same 1 b at_one (app sym b 1 e)))
        (int -1)))))
