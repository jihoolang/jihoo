// A record let keeps the same dependent field and ownership rules as match.
// exit: 17
#![dependent_core]

struct Sized(n: u64) { data: buffer(n) }
struct Envelope(n: u64) { inner: Sized(n), scratch: buffer(n) }

fn main() -> i64 {
    let Envelope { inner: Sized { data: bytes }, scratch: _ }: Envelope(3) = Envelope {
        inner: Sized { data: alloc(3, 17) }, scratch: alloc(3, 0)
    }
    let result = index(bytes, 0, decide_lt(0, 3))
    free(bytes, result)
}
