#![freestanding]
// No libc: the standard library talks to Linux with system calls and has
// its own allocator, and the program is a small static executable. The
// same code builds for x86_64 and aarch64 (`--target`).
//   jihoo build examples/freestanding.jh -o hello && ./hello

fn main() {
    var v = Vec(i64).new()
    for i in 1..101 {
        v.push(i)
    }
    var sum = 0
    for x in v {
        sum += x
    }
    println(sum)
}
