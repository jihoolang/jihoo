; Reading a list where the result's type depends on the borrow, written
; out: core_nth.jh compiles to the same MIR. A view's result may be a motive
; (lam r (Ref T) ...) over the borrow, whose cases give it at a borrow of the
; node they read, and it may be a function, applied where the view is made.
(data List
  (Nil List)
  (Cons (pi x I64 (pi xs List List))))

(def head_or
  (pi xs (Ref List) (pi missing I64 I64))
  (lam xs (Ref List) (lam missing I64
    (view List I64 missing (lam x I64 (lam rest (Ref List) x)) xs))))

(def ascending
  (pi n U64 (pi x I64 List))
  (lam n U64 (lam x I64
    (fold n Nil (lam i U64 (lam0 p (Lt i n) (lam acc List
      (lend acc (lam r (Ref List) (app head_or r x))
        (lam top I64 (lam y List (Cons (add top (int 1)) y)))))))))))

(def length
  (pi xs (Ref List) U64)
  (lam xs (Ref List) (view-rec List U64 0
    (lam x I64 (lam rest (Ref List) (lam ih U64 (uadd ih 1)))) xs)))

(def size
  (pi xs (Ref List) (Refine (lam k U64 (Eq k (app length xs)))))
  (lam xs (Ref List)
    (view-rec List (lam r (Ref List) (Refine (lam k U64 (Eq k (app length r)))))
      (pack (lam k U64 (Eq k 0)) 0 (refl 0))
      (lam x I64 (lam rest (Ref List)
        (lam ih (Refine (lam k U64 (Eq k (app length rest))))
          (pack (lam k U64 (Eq k (uadd (app length rest) 1))) (uadd (witness ih) 1)
            (transport (lam k U64 (Eq (uadd (witness ih) 1) (uadd k 1))) (proof ih)
              (refl (uadd (witness ih) 1)))))))
      xs)))

(def head
  (pi xs (Ref List) (pi0 p (Lt 0 (app length xs)) I64))
  (lam xs (Ref List) (lam0 p (Lt 0 (app length xs))
    (app
      (view List (lam r (Ref List) (pi0 p (Lt 0 (app length r)) I64))
        (lam0 p (Lt 0 0) (absurd I64 p))
        (lam x I64 (lam rest (Ref List) (lam0 p (Lt 0 (uadd (app length rest) 1)) x)))
        xs)
      p))))

(def nth
  (pi xs (Ref List) (pi i U64 (pi0 p (Lt i (app length xs)) I64)))
  (lam xs (Ref List) (lam i U64 (lam0 p (Lt i (app length xs))
    (app
      (view-rec List (lam r (Ref List) (pi i U64 (pi0 p (Lt i (app length r)) I64)))
        (lam i U64 (lam0 p (Lt i 0) (absurd I64 p)))
        (lam x I64 (lam rest (Ref List)
          (lam ih (pi i U64 (pi0 p (Lt i (app length rest)) I64))
            (lam i U64 (lam0 p (Lt i (uadd (app length rest) 1))
              (if-lt 0 i q
                (app ih (usub i 1 (lt-add 0 i 1 q))
                  (lt-cancel (usub i 1 (lt-add 0 i 1 q)) (app length rest) 1 p))
                x))))))
        xs)
      i p)))))

(export at
  (pi n U64 (pi i U64 (pi x I64 I64)))
  (lam n U64 (lam i U64 (lam x I64
    (app (lam xs List
      (lend xs (lam r (Ref List) (app size r))
        (lam k (Refine (lam m U64 (Eq m (app length (borrow xs))))) (lam y List
          (if-lt i (witness k) q
            (lend xs
              (lam r (Ref List)
                (app nth r i (transport (lam m U64 (Lt i m)) (proof k) q)))
              (lam a I64 (lam xs List (drop List xs a))))
            (drop List xs (int -1)))))))
      (app ascending n x))))))

(export first
  (pi n U64 (pi x I64 I64))
  (lam n U64 (lam x I64
    (app (lam xs List
      (lend xs (lam r (Ref List) (app size r))
        (lam k (Refine (lam m U64 (Eq m (app length (borrow xs))))) (lam y List
          (if-lt 0 (witness k) q
            (lend xs
              (lam r (Ref List)
                (app head r (transport (lam m U64 (Lt 0 m)) (proof k) q)))
              (lam a I64 (lam xs List (drop List xs a))))
            (drop List xs (int -1)))))))
      (app ascending n x)))))
