// Reuse destination storage, then shift an overlapping range within one owner.
// Imported range-composition evidence supplies the first destination bound.
// main returns 28.
#![dependent_core]
import dependent.range

fn total(n: u64, xs: ref buffer(n)) -> i64 {
    fold(n, 0, fn(i, p, acc) { acc + index(xs, i, p) })
}

export fn shifted(x: i64) -> i64 {
    let source = alloc(4, x)
    let target = alloc(6, 0)
    let fits = range.subrange_fits(6, 1, 4, 1, 3, decide_lt(5, 7), decide_lt(4, 5))
    let copied = range.copy_into(4, source, 6, target, 0, 2, 3, decide_lt(3, 5), fits)
    let moved = range.move_within(6, copied, 2, 1, 3, decide_lt(5, 7), decide_lt(4, 7))
    total(6, moved)
}

fn main() -> i64 { shifted(7) }
