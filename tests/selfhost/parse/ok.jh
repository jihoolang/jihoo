#![freestanding]
import std.vec
pub import a.b.c as d

#[view]
#[derive(Clone, Eq)]
pub struct Pair(T: type, comptime N: i64) {
    pub a: T, b: [T; N]
    c: *u8; d: (i64, bool)
}

enum E(T: type) { A, B(T, i64)
    C(fn(inout i64, sink T) -> bool, fnptr(i64))
}

unsafe extern fn printf(fmt: *u8, ...) -> i32
export fn entry(argc: i32) -> i32 { 0 }
const N: i64 = 10
static mut_: [u8; 4] = [0; 4]
type Alias = std.map.Map(String, Vec(i64))

trait Show2: Show + Clone {
    type Item
    fn show2(self, inout out: String)
    fn twice(sink self) -> (Self, Self) { (self.clone(), self) }
}

impl(T: Ord + Hash, comptime n: i64) Show2 for Pair(T, n) {
    type Item = ref T
    fn show2(self, inout out: String) {}
    pub fn get(self, i: i64) -> ref T { self.b[i] }
    fn get_mut(inout self) -> inout T { self.a }
}

