// load-args: --no-prelude
struct Pt {
    x: i64
    y: i64
}

struct Bag {
    items: [i64; 3]
}

impl Bag {
    fn as_slice(self) -> [i64] {
        self.items
    }
}

fn main() {
    var s = 0
    for i in 0..10 {
        if i == 5 {
            continue
        }
        if i == 8 {
            break
        }
        s += i
    }
    for _ in 0 as u8..3 {
        s += 1
    }
    let a = [1, 2, 3]
    for x in a {
        s += x
    }
    for i, x in a[1..] {
        s += i * x
    }
    for c in "abc" {
        s += c as i64
    }
    let ps = [Pt { x: 1, y: 2 }, Pt { x: 3, y: 4 }]
    for Pt { x, y } in ps {
        s += x * y
    }
    let b = Bag { items: [4, 5, 6] }
    for v in b {
        s += v
    }
}
