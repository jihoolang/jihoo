// load-args: --no-prelude
fn fib(n: i64) -> i64 {
    if n < 2 {
        return n
    }
    fib(n - 1) + fib(n - 2)
}

fn count(limit: i64) -> i64 {
    var i = 0
    var sum = 0
    while i < limit {
        i += 1
        if i % 2 == 0 {
            continue
        }
        sum += i
    }
    loop {
        if sum > 100 || i == 0 && sum > 0 {
            break
        }
        sum = sum * 2
    }
    sum
}

fn pick(a: bool, x: i64, y: i64) -> i64 {
    let v = if a { x } else if x > y { y } else { x + y }
    v
}

fn main() {
    let a = fib(10)
    let b = count(10)
    let c = pick(true, 1, 2)
}
