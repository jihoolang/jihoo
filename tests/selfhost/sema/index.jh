// load-args: --no-prelude
fn sum(xs: [i64]) -> i64 {
    var s = 0
    var i = 0
    while i < xs.len {
        s += xs[i]
        i += 1
    }
    s
}

fn main() {
    var a = [1, 2, 3, 4]
    a[1] = 5
    let x = a[2]
    let t = sum(a)
    let part = a[1..3]
    let head = a[..2]
    let tail = part[1..]
    let s = "hello"
    let c = s[1]
    let sub = s[1..4]
    let p = &a[0]
    let q = unsafe { p[1] }
    let u = unsafe { *(p + 2) }
}
