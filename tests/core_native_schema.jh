// Exhaustive serializer fixture: no typing assumptions on these individual nodes.
import core
import core_native_snapshot

fn refs(count: i64) -> Vec(u32) {
    var out = Vec(u32).new()
    for i in 0..count { out.push(0) }
    out
}

fn emit(count: i64) {
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.Var(0))
        print(count)
        print("\tVar\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.Global(0))
        print(count)
        print("\tGlobal\t")
