(def value (Eq (app (lam A (Type 0) (lam f A (lam b (Buffer 1) (load b 0 (decide-lt 0 1) (lam i I64 (lam again (Buffer 1) f)))))) (pi x U64 U64) (lam x U64 x) (alloc 1 (int 0)) 0) (app (lam A (Type 0) (lam f A (lam b (Buffer 1) (load b 0 (decide-lt 0 1) (lam i I64 (lam again (Buffer 1) f)))))) (pi x U64 U64) (lam x U64 x) (alloc 1 (int 0)) 0)) (refl (app (lam A (Type 0) (lam f A (lam b (Buffer 1) (load b 0 (decide-lt 0 1) (lam i I64 (lam again (Buffer 1) f)))))) (pi x U64 U64) (lam x U64 x) (alloc 1 (int 0)) 0)))
