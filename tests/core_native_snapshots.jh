// Regression adapter for the full native constructor snapshot exporter.
import std.env
import core_snapshot
import core_native_snapshot

fn main() -> i32 {
    let args = env.args()
    if args.len() != 2 {
        eprintln("usage: core-native-snapshots infer|require|code-infer|code-require|program|families")
        return 2
    }
    let source = match core_snapshot.stdin_once() {
        Ok(source) => source
        Err(message) => { eprintln(message); return 1 }
    }
    let result = if args[1] == "program" {
        core_native_snapshot.program_snapshot(source.as_str())
    } else if args[1] == "families" {
        core_native_snapshot.family_program_snapshot(source.as_str())
    } else { core_native_snapshot.snapshot(source.as_str(), args[1]) }
    match result {
        Ok(bytes) => { print(bytes); 0 }
        Err(message) => { eprintln(message); 1 }
    }
}
