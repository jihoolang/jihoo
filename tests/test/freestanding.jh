#![freestanding]

// Tests of a freestanding program run as they do in a native one.
//> running 1 test
//> test sums ... ok
//>
//> test result: ok. 1 passed; 0 failed; 0 filtered out

#[test]
fn sums() {
    var total = 0
    for i in 1..5 {
        total += i
    }
    assert(total == 10, "1 + 2 + 3 + 4")
}
