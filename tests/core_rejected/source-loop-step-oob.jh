#![dependent_core]
enum List { Nil, Cons(i64, List) }
fn length(xs: ref List) -> u64 { induct(fn(t) { u64 }, 0, fn(x, rest, ih) { ih + 1 }, xs) }
fn bad(n: u64) -> buffer(n + 1) {
 fold(n, fn(k) { buffer(k + 1) }, alloc(1, 0), fn(i, p, acc) {
  store(acc, i + 1, 8, lt_add(0, 1, i + 1, decide_lt(0, 1)))
 })
}
export fn good() -> i64 { 0 }
