(data List (Nil List) (Cons (pi x I64 (pi xs List List))))
(def length (pi xs (Ref List) U64) (lam xs (Ref List) (view-rec List U64 0 (lam x I64 (lam rest (Ref List) (lam ih U64 (uadd ih 1)))) xs)))
(def bad (pi xs (Ref List) (Refine (lam n U64 (Eq n (app length xs))))) (lam xs (Ref List) (view-rec List (lam r (Ref List) (Refine (lam n U64 (Eq n (app length r))))) (pack (lam n U64 (Eq n 0)) 0 (refl 0)) (lam x I64 (lam rest (Ref List) (lam ih (Refine (lam n U64 (Eq n (app length rest)))) ih))) xs)))
(export good I64 (int 0))
