#![dependent_core]
enum List { Nil, Cons(i64, List) }
fn length(xs: ref List) -> u64 { induct(fn(t) { u64 }, 0, fn(x, rest, ih) { ih + 1 }, xs) }
fn bad(xs: ref List, b: buffer(1)) -> buffer(1) {
 induct(fn(t, b: buffer(1)) { buffer(1) }, fn(b) { b }, fn(x, rest, ih, b) {
  let c = ih(b)
  free(c, c)
 }, xs)(b)
}
export fn good() -> i64 { 0 }
