// Slicing checks `hi <= len` and `lo <= hi` as unsigned comparisons, with
// no `+ 1` that could overflow, and the slice's length is `hi - lo`: a new
// variable equal to it, which a length's range says is not negative. So
// a slice after a length test, and indexing into it, keep no check.

fn tail(s: str) -> str {
    if s.len == 0 { return s }
    s[1..]
}

fn head(s: str, n: i64) -> str {
    if n < 0 || n > s.len { return s }
    s[..n]
}

fn middle(xs: [i64]) -> [i64] {
    if xs.len < 2 { return xs }
    xs[1..xs.len - 1]
}

fn second(s: str) -> u8 {
    if s.len < 2 { return 0 }
    let t = s[1..]
    t[0]
}

fn spaces(s: str) -> i64 {
    var n = 0
    var i = 0
    while i < s.len {
        let rest = s[i..]
        if rest[0] == 32 { n += 1 }
        i += 1
    }
    n
}

fn of_string(s: String) -> str {
    if s.len() < 3 { return "" }
    s[1..3]
}

// Unproved: `n` may be past the end.
fn unchecked(s: str, n: i64) -> str {
    if n < 0 { return s }
    s[..n]
}

fn main() {
    println(tail("abc"))
    println(head("abc", 2))
    println(middle([1, 2, 3][..]).len.to_string())
    println(second("abc").to_string())
    println(spaces("a b c").to_string())
    println(of_string("abcd".to_string()))
    println(unchecked("abc", 1))
}
