// Loops over slices: inferred invariants prove the index and the counter,
// a sum of unknown elements can overflow, and an off-by-one loop keeps its
// bounds check.

fn sum(xs: [i64]) -> i64 {
    var s = 0
    var i = 0
    while i < xs.len {
        s += xs[i]
        i += 1
    }
    s
}

fn last(xs: [i64]) -> i64 {
    var i = 0
    var x = 0
    while i <= xs.len {
        x = xs[i]
        i += 1
    }
    x
}

fn main() {
    let xs = [1, 2, 3]
    println(sum(xs[0..3]))
    println(last(xs[0..2]))
}

