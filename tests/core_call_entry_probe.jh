// Test-only inspection of current Core lowering before LLVM code generation.
import std.env
import core_mir
import core_init
import std.mem
import types
import core_elab
import diag
import load
import mir
import target
import lex

fn init_assignment(to: u32, sink rv: mir.Rvalue) -> mir.Stmt {
    mir.Stmt.Assign(mir.Place.local(to), rv, diag.Span.nowhere())
}

fn init_number(to: u32, n: i128, ty: u32) -> mir.Stmt {
    init_assignment(to, mir.Rvalue.Use(mir.Operand.Const(mir.Const.Int(n, ty))))
}

fn init_read(to: u32, from: u32) -> mir.Stmt {
    init_assignment(to, mir.Rvalue.Use(mir.Operand.Copy(mir.Place.local(from))))
}

fn init_block(sink term: mir.Term) -> mir.Block {
    mir.Block { stmts: Vec(mir.Stmt).new(), term }
}

fn init_local(inout body: mir.Body, ty: u32) -> u32 {
    let id = body.locals.len() as u32
    body.locals.push(mir.LocalDecl {
        ty,
        name: None,
        span: diag.Span.nowhere(),
        mutable: true,
        kind: mir.LocalKind.Temp
    })
    id
}

// Replace one actual lowered recursion's body with small well-typed CFGs.
// Other functions, its signature and parameter frame remain authentic.
fn initialization_case(
    inout body: mir.Body,
    inout ts: types.Types,
    function: u32,
    mode: str
) -> bool {
    if !mode.starts_with("init-") { return false }
    let sp = diag.Span.nowhere()
    let temp = init_local(&body, types.I64)
    body.blocks.clear()
    body.blocks.push(init_block(mir.Term.Return))
    if mode == "init-state-limit" {
        for _ in 0..3000 { init_local(&body, types.I64); }
        for _ in 0..2000 { body.blocks.push(init_block(mir.Term.Return)) }
        return true
    }
    if mode == "init-work-limit" || mode == "init-valid-work" {
        // Small state matrix, many edges: isolate the work guard from the
        // independent state-allocation cap.
        for _ in 0..4000 { init_local(&body, types.I64); }
        body.blocks[0].stmts.push(init_number(0, 7, types.I64))
        var cases = Vec(mir.SwitchTarget).new()
        let count: i64 = if mode == "init-work-limit" { 17000 } else { 16 }
        for value in 0..count { cases.push(mir.SwitchTarget { value: value as i128, block: 1 }) }
        body.blocks[0].term = mir.Term.Switch(
            mir.Operand.Const(mir.Const.Int(0, types.U64)),
            cases,
            1
        )
        body.blocks.push(init_block(mir.Term.Return))
        return true
    }
    if mode == "init-return" { return true }
    if mode == "init-read" || mode == "init-valid-straight" {
        if mode == "init-valid-straight" { body.blocks[0].stmts.push(init_number(
            temp,
            7,
            types.I64
        )) }
        body.blocks[0].stmts.push(init_read(0, temp))
        return true
    }
    if mode == "init-self" {
        body.blocks[0].stmts.push(init_read(temp, temp))
        body.blocks[0].stmts.push(init_number(0, 7, types.I64))
        return true
    }
    if mode == "init-pointer" {
        let ptr = ts.ptr(types.I64)
        let at = init_local(&body, ptr)
        body.blocks[0].stmts.push(init_assignment(
            0,
            mir.Rvalue.Use(mir.Operand.Copy(mir.Place.deref(at)))
        ))
        return true
    }
    if mode == "init-index" || mode == "init-valid-index" {
        let array = ts.intern(types.TyKind.Array(types.I64, 1))
        let at = init_local(&body, array)
        let index = init_local(&body, types.U64)
        var ops = Vec(mir.Operand).new()
        ops.push(mir.Operand.Const(mir.Const.Int(7, types.I64)))
        body.blocks[0].stmts.push(init_assignment(
            at,
            mir.Rvalue.Aggregate(mir.Agg.Array(array), ops)
        ))
        if mode == "init-valid-index" { body.blocks[0].stmts.push(init_number(index, 0, types.U64)) }
        body.blocks[0].stmts.push(init_assignment(
            0,
            mir.Rvalue.Use(mir.Operand.Copy(mir.Place.local(at).with(mir.Proj.Index(index))))
        ))
        return true
    }
    if mode == "init-aggregate" {
        var parts = Vec(u32).new()
        parts.push(types.I64)
        let tuple = ts.tuple(parts)
        let at = init_local(&body, tuple)
        var ops = Vec(mir.Operand).new()
        ops.push(mir.Operand.Copy(mir.Place.local(temp)))
        body.blocks[0].stmts.push(init_assignment(
            at,
            mir.Rvalue.Aggregate(mir.Agg.Struct(tuple), ops)
        ))
        body.blocks[0].stmts.push(init_number(0, 7, types.I64))
        return true
    }
    if mode == "init-valid-unreachable" {
        body.blocks[0].stmts.push(init_number(0, 7, types.I64))
        var dead = init_block(mir.Term.Return)
        dead.stmts.push(init_read(0, temp))
        body.blocks.push(dead)
        return true
    }
    if mode == "init-call" || mode == "init-valid-call" {
        var args = Vec(mir.Operand).new()
        var replaced = false
        for j in 1..body.arg_count + 1 {
            if !replaced && body.locals[j].ty == types.I64 && mode == "init-call" {
                args.push(mir.Operand.Copy(mir.Place.local(temp)))
                replaced = true
            } else { args.push(mir.Operand.Copy(mir.Place.local(j as u32))) }
        }
        if mode == "init-call" && !replaced { return false }
        body.blocks[0].term = mir.Term.Call(
            mir.Callee.Fn(function),
            args,
            mir.Place.local(temp),
            1,
            sp
        )
        var next = init_block(mir.Term.Return)
        next.stmts.push(init_read(0, temp))
        body.blocks.push(next)
        return true
    }
    if mode == "init-join" || mode == "init-valid-join" {
        // The work stack visits branch 1 and the join before branch 2. A
        // missing write on branch 2 must invalidate and revisit the join.
        var cases = Vec(mir.SwitchTarget).new()
        cases.push(mir.SwitchTarget { value: 0, block: 1 })
        body.blocks[0].term = mir.Term.Switch(mir.Operand.Const(mir.Const.Bool(false)), cases, 2)
        var yes = init_block(mir.Term.Goto(3))
        yes.stmts.push(init_number(temp, 7, types.I64))
        body.blocks.push(yes)
        var no = init_block(mir.Term.Goto(3))
        if mode == "init-valid-join" { no.stmts.push(init_number(temp, 8, types.I64)) }
        body.blocks.push(no)
        var join = init_block(mir.Term.Return)
        join.stmts.push(init_read(0, temp))
        body.blocks.push(join)
        return true
    }
    if mode == "init-loop" || mode == "init-valid-loop" {
        if mode == "init-valid-loop" { body.blocks[0].stmts.push(init_number(temp, 7, types.I64)) }
        body.blocks[0].term = mir.Term.Goto(1)
        var cases = Vec(mir.SwitchTarget).new()
        cases.push(mir.SwitchTarget { value: 0, block: 2 })
        var head = init_block(mir.Term.Switch(mir.Operand.Const(mir.Const.Bool(false)), cases, 3))
        head.stmts.push(init_read(0, temp))
        body.blocks.push(head)
        var step = init_block(mir.Term.Goto(1))
        step.stmts.push(init_number(temp, 8, types.I64))
        body.blocks.push(step)
        body.blocks.push(init_block(mir.Term.Return))
        return true
    }
    false
}

fn numbers(ids: Vec(u32)) -> String {
    var out = String.new()
    for i, id in ids {
        if i > 0 { out.push_str(",") }
        out.push_str(id.to_string().as_str())
    }
    out
}

fn initialization_certificate(p: mir.Program) -> Result(String, String) {
    var out = String.new()
    for i, f in p.fns {
        let Some(body) = f.body else { continue }
        let analysis = match core_init.analyze(body, f.span) {
            Ok(a) => a
            Err(e) => return Err(e.msg.clone())
        }
        out.push_str(("function\t" + i.to_string().as_str() + "\ninitial\t" + numbers(
            analysis.initial
        ).as_str() + "\n").as_str())
        for j, block in analysis.graph {
            var facts = Vec(u32).new()
            if analysis.reached[j] {
                for k, present in analysis.facts[j] { if present { facts.push(k as u32) } }
            }
            let encoded = if analysis.reached[j] { numbers(facts) } else { "-".to_string() }
            out.push_str(
                ("facts\t" + j.to_string().as_str() + "\t" + encoded.as_str() + "\n").as_str()
            )
            for a in block.actions {
                out.push_str(
                    (
                        "action\t" + j.to_string().as_str() + "\t" + numbers(a.reads).as_str() + "\t" + numbers(
                            a.writes
                        ).as_str() + "\n"
                    ).as_str()
                )
            }
            out.push_str(("successors\t" + j.to_string().as_str() + "\t" + numbers(
                block.successors
            ).as_str() + "\n").as_str())
        }
        out.push_str("end\n")
    }
    Ok(out)
}

fn inspect(path: str, tgt: target.Target, mutation: str) -> Result(String, String) {
    var sources = diag.Sources.new()
    let ast = match load.load(
        path,
        load.default_search(Vec(String).new()),
        tgt.name(),
        &sources,
        false
    ) {
        Ok(a) => a
        Err(e) => return Err(e.msg.clone())
    }
    var p = match core_elab.compile(ast, tgt, true, target.Codegen.default()) {
        Ok(p) => p
        Err(e) => return Err(e.msg.clone())
    }
    if mutation == "init-certificate" { return initialization_certificate(p) }
    if mutation != "none" {
        var changed = false
        for i in 0..p.fns.len() {
            if !p.fns[i].name.as_str().starts_with("recursion.") { continue }
            let Some(b) = mem.replace(&p.fns[i].body, None) else { continue }
            var body = b
            if initialization_case(&body, &p.types, i as u32, mutation) { changed = true }
            if mutation == "negative-count" { body.arg_count = -1; changed = true }
            if mutation == "count" { body.arg_count += 1; changed = true }
            if mutation == "return-kind" { body.locals[0].kind = mir.LocalKind.Temp; changed = true }
            if mutation == "return-type" { body.locals[0].ty = types.BOOL; changed = true }
            if mutation == "parameter-kind" { body.locals[1].kind = mir.LocalKind.Temp; changed = true }
            if mutation == "parameter-type" { body.locals[1].ty = types.BOOL; changed = true }
            if mutation == "late-argument" {
                body.locals.push(body.locals[1].clone()); changed = true
            }
            if mutation == "pass" { p.fns[i].pass.push(mir.ParamPass.Value); changed = true }
            if mutation == "variadic" { p.fns[i].variadic = true; changed = true }
            let sp = p.fns[i].span
            let bad_local = body.locals.len() as u32
            if mutation == "local-type" { body.locals[body.locals.len() - 1].ty = p.types.kinds.len() as u32; changed = true }
            if mutation == "builtin-type" { p.types.kinds[types.I64 as i64] = types.TyKind.Bool; changed = true }
            if mutation == "cyclic-type" {
                let t = p.types.kinds.len() as u32
                p.types.kinds.push(types.TyKind.Ptr(t))
                body.locals[body.locals.len() - 1].ty = t
                changed = true
            }
            var replacement: Option(mir.Rvalue) = None
            if mutation == "assignment-type" { replacement = Some(mir.Rvalue.Use(mir.Operand.Const(mir.Const.Bool(
                true
            )))) }
            if mutation == "operand-local" { replacement = Some(mir.Rvalue.Use(mir.Operand.Copy(mir.Place.local(
                bad_local
            )))) }
            if mutation == "dereference" { replacement = Some(mir.Rvalue.Use(mir.Operand.Copy(mir.Place.deref(
                0
            )))) }
            if mutation == "field" { replacement = Some(mir.Rvalue.Use(mir.Operand.Copy(
                mir.Place.local(0).with(mir.Proj.Field(0))
            ))) }
            if mutation == "index-local" { replacement = Some(mir.Rvalue.Use(mir.Operand.Copy(
                mir.Place.local(0).with(mir.Proj.Index(bad_local))
            ))) }
            if mutation == "constant-type" { replacement = Some(mir.Rvalue.Use(mir.Operand.Const(mir.Const.Int(
                1,
                types.BOOL
            )))) }
            if mutation == "constant-range" { replacement = Some(mir.Rvalue.Use(mir.Operand.Const(mir.Const.Int(
                -1,
                types.U64
            )))) }
            if mutation == "binary-type" { replacement = Some(mir.Rvalue.Bin(
                lex.Op.Add,
                mir.Operand.Const(mir.Const.Int(1, types.I64)),
                mir.Operand.Const(mir.Const.Int(1, types.U64))
            )) }
            if mutation == "cast-type" { replacement = Some(mir.Rvalue.Cast(
                mir.Operand.Const(mir.Const.Bool(true)),
                types.I64,
                mir.CastKind.Numeric
            )) }
            if mutation == "offset-type" { replacement = Some(mir.Rvalue.Offset(
                mir.Operand.Const(mir.Const.Int(1, types.I64)),
                mir.Operand.Const(mir.Const.Int(1, types.U64))
            )) }
            if mutation == "aggregate-count" {
                let t = p.types.tuple({ var parts = Vec(u32).new(); parts.push(types.I64); parts })
                replacement = Some(mir.Rvalue.Aggregate(mir.Agg.Struct(t), Vec(mir.Operand).new()))
            }
            if mutation == "aggregate-type" {
                let t = p.types.tuple({ var parts = Vec(u32).new(); parts.push(types.I64); parts })
                var ops = Vec(mir.Operand).new()
                ops.push(mir.Operand.Const(mir.Const.Bool(true)))
                replacement = Some(mir.Rvalue.Aggregate(mir.Agg.Struct(t), ops))
            }
            match move replacement {
                Some(rv) => {
                    body.blocks[0].stmts.insert(0, mir.Stmt.Assign(mir.Place.local(0), rv, sp))
                    changed = true
                }
                None => {}
            }
            if mutation == "goto" { body.blocks[0].term = mir.Term.Goto(body.blocks.len() as u32); changed = true }
            if mutation == "pending" { body.blocks[0].term = mir.Term.Pending; changed = true }
            if mutation == "assert-type" { body.blocks[0].term = mir.Term.Assert(
                mir.Operand.Const(mir.Const.Int(1, types.I64)),
                "test".to_string(),
                0,
                sp
            ); changed = true }
            if mutation == "switch-duplicate" || mutation == "switch-bool" || mutation == "switch-target" {
                var cases = Vec(mir.SwitchTarget).new()
                cases.push(mir.SwitchTarget { value: 0, block: 0 })
                if mutation == "switch-duplicate" { cases.push(mir.SwitchTarget {
                    value: 0,
                    block: 0
                }) }
                if mutation == "switch-bool" { cases.push(mir.SwitchTarget { value: 2, block: 0 }) }
                if mutation == "switch-target" { cases.push(mir.SwitchTarget {
                    value: 1,
                    block: body.blocks.len() as u32
                }) }
                body.blocks[0].term = mir.Term.Switch(
                    mir.Operand.Const(mir.Const.Bool(true)),
                    cases,
                    0
                )
                changed = true
            }
            for j in 0..body.blocks.len() {
                if changed { break }
                let old = mem.replace(&body.blocks[j].term, mir.Term.Pending)
                match move old {
                    mir.Term.Call(callee, operands, place, continuation, sp) => {
                        var callee = callee
                        var operands = operands
                        var place = place
                        var continuation = continuation
                        if mutation == "call-type" && operands.len() > 0 { operands[0] = mir.Operand.Const(mir.Const.Bool(
                            true
                        )); changed = true }
                        if mutation == "callee" { callee = mir.Callee.Fn(p.fns.len() as u32); changed = true }
                        if mutation == "missing-operand" && operands.len() > 0 {
                            operands.remove(0); changed = true
                        }
                        if mutation == "extra-operand" {
                            operands.push(mir.Operand.Const(mir.Const.Int(0, types.I64))); changed = true
                        }
                        if mutation == "destination" { place.local = body.locals.len() as u32; changed = true }
                        if mutation == "indirect" { callee = mir.Callee.Ptr(mir.Operand.Const(mir.Const.Int(
                            0,
                            types.I64
                        ))); changed = true }
                        if mutation == "projection" { place.proj.push(mir.Proj.Deref); changed = true }
                        if mutation == "result-type" { body.locals[place.local as i64].ty = types.BOOL; changed = true }
                        if mutation == "continuation" { continuation = body.blocks.len() as u32; changed = true }
                        body.blocks[j].term = mir.Term.Call(
                            callee,
                            operands,
                            place,
                            continuation,
                            sp
                        )
                    }
                    term => body.blocks[j].term = term
                }
            }
            p.fns[i].body = Some(body)
            if changed { break }
        }
        if !changed { return Err("mutation was not applied".to_string()) }
        match core_mir.validate(p) {
            Err(e) => return Err(e.msg.clone())
            Ok(()) => {
                if mutation.starts_with("init-valid-") { return Ok(
                    "initialization control accepted".to_string()
                ) }
                return Err("mutation was accepted".to_string())
            }
        }
    }
    var functions: i64 = 0
    var calls: i64 = 0
    var parameters: i64 = 0
    for f in p.fns {
        let Some(body) = f.body else { continue }
        if f.name.as_str().starts_with("recursion.") {
            functions += 1
            if body.arg_count != f.sig.params.len() || f.pass.len() != f.sig.params.len() {
                return Err("signature and argument count differ".to_string())
            }
            if body.arg_count < 1 || body.locals.len() <= body.arg_count {
                return Err("missing return or node parameter".to_string())
            }
            if body.locals[0].kind != mir.LocalKind.Ret { return Err(
                "local zero is not return".to_string()
            ) }
            for i, local in body.locals {
                if i > 0 && i <= body.arg_count {
                    if local.kind != mir.LocalKind.Arg || local.ty != f.sig.params[i - 1] {
                        return Err("parameter local ordering or type mismatch".to_string())
                    }
                } else if local.kind == mir.LocalKind.Arg {
                    return Err("noncontiguous parameter locals".to_string())
                }
            }
            parameters += body.arg_count
        }
        for block in body.blocks {
            let mir.Term.Call(mir.Callee.Fn(id), args, _, _, _) = block.term else { continue }
            if id as i64 >= p.fns.len() { return Err("invalid callee".to_string()) }
            let callee = p.fns[id as i64]
            if callee.name.as_str().starts_with("recursion.") {
                if args.len() != callee.sig.params.len() {
                    return Err("call operand count differs from callee".to_string())
                }
                calls += 1
            }
        }
    }
    if functions == 0 || calls == 0 { return Err("no generated recursion observed".to_string()) }
    Ok("entry-layout\t" + functions.to_string().as_str() + "\t" + calls.to_string().as_str() + "\t" + parameters.to_string().as_str())
}

fn main() -> i32 {
    let args = env.args()
    if args.len() != 3 && args.len() != 4 { return 2 }
    let Some(tgt) = target.Target.parse(args[2]) else { return 2 }
    let mutation = if args.len() == 4 { args[3] } else { "none" }
    match inspect(args[1], tgt, mutation) {
        Ok(output) => { println(output); 0 }
        Err(message) => { eprintln(message); 1 }
    }
}
