// Test-only inspection of current Core lowering before LLVM code generation.
import std.env
import core_mir
import std.mem
import types
import core_elab
import diag
import load
import mir
import target
import lex

fn inspect(path: str, tgt: target.Target, mutation: str) -> Result(String, String) {
    var sources = diag.Sources.new()
    let ast = match load.load(
        path,
        load.default_search(Vec(String).new()),
        tgt.name(),
        &sources,
        false
    ) {
        Ok(a) => a
        Err(e) => return Err(e.msg.clone())
    }
    var p = match core_elab.compile(ast, tgt, true, target.Codegen.default()) {
        Ok(p) => p
        Err(e) => return Err(e.msg.clone())
    }
    if mutation != "none" {
        var changed = false
        for i in 0..p.fns.len() {
            if !p.fns[i].name.as_str().starts_with("recursion.") { continue }
            let Some(b) = mem.replace(&p.fns[i].body, None) else { continue }
            var body = b
            if mutation == "negative-count" { body.arg_count = -1; changed = true }
            if mutation == "count" { body.arg_count += 1; changed = true }
            if mutation == "return-kind" { body.locals[0].kind = mir.LocalKind.Temp; changed = true }
            if mutation == "return-type" { body.locals[0].ty = types.BOOL; changed = true }
            if mutation == "parameter-kind" { body.locals[1].kind = mir.LocalKind.Temp; changed = true }
            if mutation == "parameter-type" { body.locals[1].ty = types.BOOL; changed = true }
            if mutation == "late-argument" {
                body.locals.push(body.locals[1].clone()); changed = true
            }
            if mutation == "pass" { p.fns[i].pass.push(mir.ParamPass.Value); changed = true }
            if mutation == "variadic" { p.fns[i].variadic = true; changed = true }
            let sp = p.fns[i].span
            let bad_local = body.locals.len() as u32
            if mutation == "local-type" { body.locals[body.locals.len() - 1].ty = p.types.kinds.len() as u32; changed = true }
            if mutation == "builtin-type" { p.types.kinds[types.I64 as i64] = types.TyKind.Bool; changed = true }
            if mutation == "cyclic-type" {
                let t = p.types.kinds.len() as u32
                p.types.kinds.push(types.TyKind.Ptr(t))
                body.locals[body.locals.len() - 1].ty = t
                changed = true
            }
            var replacement: Option(mir.Rvalue) = None
            if mutation == "assignment-type" { replacement = Some(mir.Rvalue.Use(mir.Operand.Const(mir.Const.Bool(
                true
            )))) }
            if mutation == "operand-local" { replacement = Some(mir.Rvalue.Use(mir.Operand.Copy(mir.Place.local(
                bad_local
            )))) }
            if mutation == "dereference" { replacement = Some(mir.Rvalue.Use(mir.Operand.Copy(mir.Place.deref(
                0
            )))) }
            if mutation == "field" { replacement = Some(mir.Rvalue.Use(mir.Operand.Copy(
                mir.Place.local(0).with(mir.Proj.Field(0))
            ))) }
            if mutation == "index-local" { replacement = Some(mir.Rvalue.Use(mir.Operand.Copy(
                mir.Place.local(0).with(mir.Proj.Index(bad_local))
            ))) }
            if mutation == "constant-type" { replacement = Some(mir.Rvalue.Use(mir.Operand.Const(mir.Const.Int(
                1,
                types.BOOL
            )))) }
            if mutation == "constant-range" { replacement = Some(mir.Rvalue.Use(mir.Operand.Const(mir.Const.Int(
                -1,
                types.U64
            )))) }
            if mutation == "binary-type" { replacement = Some(mir.Rvalue.Bin(
                lex.Op.Add,
                mir.Operand.Const(mir.Const.Int(1, types.I64)),
                mir.Operand.Const(mir.Const.Int(1, types.U64))
            )) }
            if mutation == "cast-type" { replacement = Some(mir.Rvalue.Cast(
                mir.Operand.Const(mir.Const.Bool(true)),
                types.I64,
                mir.CastKind.Numeric
            )) }
            if mutation == "offset-type" { replacement = Some(mir.Rvalue.Offset(
                mir.Operand.Const(mir.Const.Int(1, types.I64)),
                mir.Operand.Const(mir.Const.Int(1, types.U64))
            )) }
            if mutation == "aggregate-count" {
                let t = p.types.tuple({ var parts = Vec(u32).new(); parts.push(types.I64); parts })
                replacement = Some(mir.Rvalue.Aggregate(mir.Agg.Struct(t), Vec(mir.Operand).new()))
            }
            if mutation == "aggregate-type" {
                let t = p.types.tuple({ var parts = Vec(u32).new(); parts.push(types.I64); parts })
                var ops = Vec(mir.Operand).new()
                ops.push(mir.Operand.Const(mir.Const.Bool(true)))
                replacement = Some(mir.Rvalue.Aggregate(mir.Agg.Struct(t), ops))
            }
            match move replacement {
                Some(rv) => {
                    body.blocks[0].stmts.insert(0, mir.Stmt.Assign(mir.Place.local(0), rv, sp))
                    changed = true
                }
                None => {}
            }
            if mutation == "goto" { body.blocks[0].term = mir.Term.Goto(body.blocks.len() as u32); changed = true }
            if mutation == "pending" { body.blocks[0].term = mir.Term.Pending; changed = true }
            if mutation == "assert-type" { body.blocks[0].term = mir.Term.Assert(
                mir.Operand.Const(mir.Const.Int(1, types.I64)),
                "test".to_string(),
                0,
                sp
            ); changed = true }
            if mutation == "switch-duplicate" || mutation == "switch-bool" || mutation == "switch-target" {
                var cases = Vec(mir.SwitchTarget).new()
                cases.push(mir.SwitchTarget { value: 0, block: 0 })
                if mutation == "switch-duplicate" { cases.push(mir.SwitchTarget {
                    value: 0,
                    block: 0
                }) }
                if mutation == "switch-bool" { cases.push(mir.SwitchTarget { value: 2, block: 0 }) }
                if mutation == "switch-target" { cases.push(mir.SwitchTarget {
                    value: 1,
                    block: body.blocks.len() as u32
                }) }
                body.blocks[0].term = mir.Term.Switch(
                    mir.Operand.Const(mir.Const.Bool(true)),
                    cases,
                    0
                )
                changed = true
            }
            for j in 0..body.blocks.len() {
                if changed { break }
                let old = mem.replace(&body.blocks[j].term, mir.Term.Pending)
                match move old {
                    mir.Term.Call(callee, operands, place, continuation, sp) => {
                        var callee = callee
                        var operands = operands
                        var place = place
                        var continuation = continuation
                        if mutation == "call-type" && operands.len() > 0 { operands[0] = mir.Operand.Const(mir.Const.Bool(
                            true
                        )); changed = true }
                        if mutation == "callee" { callee = mir.Callee.Fn(p.fns.len() as u32); changed = true }
                        if mutation == "missing-operand" && operands.len() > 0 {
                            operands.remove(0); changed = true
                        }
                        if mutation == "extra-operand" {
                            operands.push(mir.Operand.Const(mir.Const.Int(0, types.I64))); changed = true
                        }
                        if mutation == "destination" { place.local = body.locals.len() as u32; changed = true }
                        if mutation == "indirect" { callee = mir.Callee.Ptr(mir.Operand.Const(mir.Const.Int(
                            0,
                            types.I64
                        ))); changed = true }
                        if mutation == "projection" { place.proj.push(mir.Proj.Deref); changed = true }
                        if mutation == "result-type" { body.locals[place.local as i64].ty = types.BOOL; changed = true }
                        if mutation == "continuation" { continuation = body.blocks.len() as u32; changed = true }
                        body.blocks[j].term = mir.Term.Call(
                            callee,
                            operands,
                            place,
                            continuation,
                            sp
                        )
                    }
                    term => body.blocks[j].term = term
                }
            }
            p.fns[i].body = Some(body)
            if changed { break }
        }
        if !changed { return Err("mutation was not applied".to_string()) }
        match core_mir.validate(p) {
            Err(e) => return Err(e.msg.clone())
            Ok(()) => return Err("mutation was accepted".to_string())
        }
    }
    var functions: i64 = 0
    var calls: i64 = 0
    var parameters: i64 = 0
    for f in p.fns {
        let Some(body) = f.body else { continue }
        if f.name.as_str().starts_with("recursion.") {
            functions += 1
            if body.arg_count != f.sig.params.len() || f.pass.len() != f.sig.params.len() {
                return Err("signature and argument count differ".to_string())
            }
            if body.arg_count < 1 || body.locals.len() <= body.arg_count {
                return Err("missing return or node parameter".to_string())
            }
            if body.locals[0].kind != mir.LocalKind.Ret { return Err(
                "local zero is not return".to_string()
            ) }
            for i, local in body.locals {
                if i > 0 && i <= body.arg_count {
                    if local.kind != mir.LocalKind.Arg || local.ty != f.sig.params[i - 1] {
                        return Err("parameter local ordering or type mismatch".to_string())
                    }
                } else if local.kind == mir.LocalKind.Arg {
                    return Err("noncontiguous parameter locals".to_string())
                }
            }
            parameters += body.arg_count
        }
        for block in body.blocks {
            let mir.Term.Call(mir.Callee.Fn(id), args, _, _, _) = block.term else { continue }
            if id as i64 >= p.fns.len() { return Err("invalid callee".to_string()) }
            let callee = p.fns[id as i64]
            if callee.name.as_str().starts_with("recursion.") {
                if args.len() != callee.sig.params.len() {
                    return Err("call operand count differs from callee".to_string())
                }
                calls += 1
            }
        }
    }
    if functions == 0 || calls == 0 { return Err("no generated recursion observed".to_string()) }
    Ok("entry-layout\t" + functions.to_string().as_str() + "\t" + calls.to_string().as_str() + "\t" + parameters.to_string().as_str())
}

fn main() -> i32 {
    let args = env.args()
    if args.len() != 3 && args.len() != 4 { return 2 }
    let Some(tgt) = target.Target.parse(args[2]) else { return 2 }
    let mutation = if args.len() == 4 { args[3] } else { "none" }
    match inspect(args[1], tgt, mutation) {
        Ok(output) => { println(output); 0 }
        Err(message) => { eprintln(message); 1 }
    }
}
