// What docs/language/from-rust.md and docs/reference/grammar.md say works.
import std.mem

struct A {
    s: String
}

enum Tok {
    Eq
    Num(i64)
}

// Rust's `#[derive(Clone, PartialEq, Debug)]`.
#[derive(Clone, Eq, Show)]
struct Word {
    text: String
    n: i64
}

fn count_words(text: str) -> Map(String, i64) {
    var counts = Map(String, i64).new()
    for w in text.split(" ") {
        if w.len == 0 {
            continue
        }
        match counts.get_mut(w) {
            Some(n) => n += 1
            None => {
                counts.insert(w.to_string(), 1)
            }
        }
    }
    counts
}

fn digit(c: u8) -> bool {
    match c {
        '0'..'9' => true
        _ => false
    }
}

fn digit_eq(c: u8) -> bool {
    match c {
        '0'..='9' => true
        _ => false
    }
}

// `a` is borrowed, so `+` copies its text.
fn shout(a: String) -> String {
    a + "!"
}

fn is_eq(t: Tok) -> bool {
    match t {
        Eq => true
        Num(_) => false
    }
}

fn main() {
    let counts = count_words("a b  a")
    println(counts["a"])
    //> 2
    println(counts["b"])
    //> 1

    println(digit('9') && digit_eq('9'))
    //> true

    let a = String.from("x")
    let b = a.as_str() + "y"
    println(a)
    //> x
    println(b)
    //> xy
    println(shout(a))
    //> x!
    println(a == "x" && "x" == a)
    //> true

    var r = A { s: "old" }
    let t = mem.replace(&r.s, String.new())
    println(t)
    //> old

    println(is_eq(Tok.Eq))
    //> true

    let c: u8 = 97
    println(c as i64 * 2)
    //> 194
    println(6 & 1 == 0)
    //> true
    println(1 << 2 + 1)
    //> 8
    let n: u8 = 7
    println(0 -% n)
    //> 249

    let pair = ((1, 2), 3)
    println(pair.0.1)
    //> 2

    let total = 1 +
        2
    let s = "  hi  "
        .trim()
    println(total)
    //> 3
    println(s)
    //> hi

    if (A { s: "p" }).s == "p" {
        println("paren")
        //> paren
    }

    var x = 0
    for i in 0..3 + 1 {
        x += i
    }
    println(x)
    //> 6

    // `let (var a, b)`, not `let (mut a, b)`
    let (var a, b) = (1, 2)
    a += b
    println(a)
    //> 3

    // `for x in v` borrows; `into_iter` gives the values away
    var names = Vec(String).new()
    names.push("x".to_string())
    var all = String.new()
    for n in names.into_iter() {
        all = all + n.as_str()
    }
    println(all)
    //> x

    // a `match` that binds parts of a whole owned variable uses it up
    println(first_name(Named.One("y".to_string())))
    //> y

    // no 128-bit literals: build the value
    let max = 0 -% (1 as u128)
    println(max)
    //> 340282366920938463463374607431768211455

    // patterns see through `ref` values
    var names = Vec(Named).new()
    names.push(Named.Two("p".to_string(), "q".to_string()))
    match names.first() {
        Some(Two(a, _)) => println(a)
        _ => {}
    }
    //> p

    // `.clone()` of a named `ref T` clones the `T`
    var words = Vec(String).new()
    words.push("a".to_string())
    let w = words.first().unwrap()
    let wc = w.clone()
    words.push("b".to_string())
    println(wc)
    //> a

    // `None` alone in an `if` arm needs the type written
    let picked: Option(i64) = if names.len() > 5 { None } else { Some(1) }
    println(picked.is_some())
    //> true
    let w = Word { text: "hi".to_string(), n: 2 }
    println(w.clone() == w)
    //> true
    println(w)
    //> Word { text: hi, n: 2 }
}

enum Named {
    One(String)
    Two(String, String)
}

fn first_name(sink n: Named) -> String {
    match n {
        One(s) => s
        Two(s, _) => s
    }
}
