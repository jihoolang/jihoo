fn main() {
    var n = 0
    loop {
        n += 1
        if n == 5 {
            break
        }
    }
    println(n)
    var v = Vec(String).new()
    v.push("a")
    v.push("b")
    v.push("c")
    for i, s in v {
        print(i)
        println(s)
    }
    var grid = [[0; 3]; 3]
    for i in 0..3 {
        for j in 0..3 {
            grid[i][j] = i * 3 + j
        }
    }
    println(grid[2][1])
    var count = 0
    for x in [5, 6, 7] {
        count += x
    }
    println(count)
    var ticks = 0
    for _ in 0..3 {
        ticks += 1
    }
    println(ticks)
}
//> 5
//> 0a
//> 1b
//> 2c
//> 7
//> 18
//> 3
