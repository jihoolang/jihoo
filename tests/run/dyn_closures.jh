// `dyn fn`: closures that own what they capture, so they can be returned
// and stored.

fn adder(n: i64) -> dyn fn(i64) -> i64 {
    fn(x) { x + n }
}

fn greeter(name: str) -> dyn fn() -> String {
    let owned = String.from(name)
    fn() { "hello, " + owned.as_str() }
}

fn double(x: i64) -> i64 {
    x * 2
}

fn compose(sink f: dyn fn(i64) -> i64, sink g: dyn fn(i64) -> i64) -> dyn fn(i64) -> i64 {
    fn(x) { g(f(x)) }
}

fn curry(a: i64) -> dyn fn(i64) -> dyn fn(i64) -> i64 {
    fn(b) { fn(c) { a * 100 + b * 10 + c } }
}

fn apply_all(fs: [dyn fn(i64) -> i64], x: i64) -> i64 {
    var t = 0
    for f in fs {
        t += f(x)
    }
    t
}

struct Button {
    label: String
    on_click: dyn fn(i64) -> String
}

fn main() {
    let add5 = adder(5)
    println(add5(10))
    //> 15
    println(greeter("jihoo")())
    //> hello, jihoo

    // Closures, named functions and returned closures in one `Vec`.
    var fs = Vec(dyn fn(i64) -> i64).new()
    fs.push(adder(1))
    fs.push(double)
    fs.push(fn(x) { x * x })
    println(apply_all(fs.as_slice(), 3))
    //> 19

    let h = compose(fn(x) { x + 1 }, fn(x) { x * 3 })
    println(h(4))
    //> 15
    println(curry(1)(2)(3))
    //> 123

    // Parameter conventions are those of `fn` types.
    let push7: dyn fn(inout Vec(i64)) = fn(v) { v.push(7) }
    var v = Vec(i64).new()
    push7(&v)
    push7(&v)
    println(v.len())
    //> 2

    let suffix = String.from("!")
    let b = Button { label: String.from("ok"), on_click: fn(n) { n.to_string() + suffix.as_str() } }
    println(b.label)
    //> ok
    println((b.on_click)(3))
    //> 3!
}
