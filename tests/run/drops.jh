struct Noisy {
    name: i64
}

impl Drop for Noisy {
    fn drop(inout self) {
        println(self.name)
    }
}

fn take(sink n: Noisy) {
    println(100)
}

fn main() {
    let a = Noisy { name: 1 }
    let b = Noisy { name: 2 }
    take(b)
    {
        let c = Noisy { name: 3 }
    }
    var v = Vec(Noisy).new()
    v.push(Noisy { name: 4 })
    v.push(Noisy { name: 5 })
    if a.name == 1 {
        let d = Noisy { name: 6 }
        take(d)
    }
    println(0)
    consume()
}

// `into_iter` gives each value away; the ones not taken drop with it.
fn consume() {
    var v = Vec(Noisy).new()
    v.push(Noisy { name: 7 })
    v.push(Noisy { name: 8 })
    v.push(Noisy { name: 9 })
    for n in v.into_iter() {
        if n.name == 8 {
            break
        }
        take(n)
    }
    println(10)
}
//> 100
//> 2
//> 3
//> 100
//> 6
//> 0
//> 100
//> 7
//> 8
//> 9
//> 10
//> 4
//> 5
//> 1
