#![freestanding]
// Listing a directory and removing files, with system calls.
import std.fs

fn main() {
    let names = fs.read_dir("tests/selfhost").unwrap()
    for n in names {
        println(n)
    }
    let path = "/tmp/jihoo-dirs-freestanding-test.txt"
    fs.write_file(path, "x").unwrap()
    println(fs.remove_file(path).is_ok())
    println(fs.remove_file(path).is_err())
    println(fs.read_file(path).is_err())
    println(fs.read_dir("/nonexistent").is_err())
    println(fs.read_dir("tests/run/dirs.jh").is_err())
}
