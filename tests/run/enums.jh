enum Shape {
    Circle(i64)
    Rect(i64, i64)
    Empty
}

fn area(s: Shape) -> i64 {
    match s {
        Circle(r) => 3 * r * r
        Rect(w, h) => w * h
        Empty => 0
    }
}

fn describe(n: i64) -> str {
    match n {
        0 => "zero"
        1 | 2 | 3 => "small"
        4..=9 => "medium"
        _ => "large"
    }
}

fn main() {
    println(area(Shape.Circle(2)))
    println(area(Shape.Rect(3, 4)))
    println(area(Shape.Empty))
    println(describe(0))
    println(describe(2))
    println(describe(7))
    println(describe(100))
    let s = Shape.Rect(5, 6)
    let w = match s {
        Rect(w, _) if w > 3 => w
        _ => 0
    }
    println(w)
}
//> 12
//> 12
//> 0
//> zero
//> small
//> medium
//> large
//> 5
