fn fib(n: i64) -> i64 {
    if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

fn main() {
    println(fib(20))
    let x: u8 = 200
    println(x +% 100)
    var i = 0
    var s = 0
    while i < 10 {
        if i % 2 == 0 {
            i += 1
            continue
        }
        s += i
        i += 1
    }
    println(s)
    println(-7 / 2)
    println(-7 % 2)
    println(1 << 10)
    println(0xff & 0x0f)
    println(true && !false)
    let c = 'a'
    println(c + 1)
}
//> 6765
//> 44
//> 25
//> -3
//> -1
//> 1024
//> 15
//> true
//> 98
