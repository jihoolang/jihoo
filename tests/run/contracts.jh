// Contracts: `requires`, `ensures` and `invariant` change nothing when the
// program runs; `emit-obligations` gives them to the verifier.
fn clamp(x: i64, lo: i64, hi: i64) -> i64
    requires lo <= hi
    ensures lo <= result && result <= hi
{
    if x < lo { return lo }
    if x > hi { return hi }
    x
}

fn bump(inout n: i64)
    requires n < 100
    ensures n == old(n) + 1
{
    n += 1
}

// `ensures` reads a `sink` parameter as it was on entry.
fn countdown(sink n: u8) -> u8
    requires n <= 10
    ensures result == 0 && n <= 10
{
    while n > 0
        invariant 0 <= n && n <= 10
    {
        n -= 1
    }
    n
}

fn sum(xs: [i64]) -> i64 {
    var s = 0
    var i = 0
    while i < xs.len
        invariant 0 <= i && i <= xs.len
    {
        s += xs[i]
        i += 1
    }
    var k = 0
    for j in 0..3
        invariant 0 <= k && k <= 3 * 2 - -1
    {
        k += j
    }
    loop
        invariant k >= 0
    {
        if k > 0 { break }
        k += 1
    }
    s + k - k
}

// `result`, `requires` and `old` are only special in clauses.
fn requires(old: i64) -> i64 {
    let result = old + 1
    result
}

fn main() {
    var y = 1
    bump(&y)
    println(clamp(5, 0, 3))
    println(y)
    println(countdown(7) as i64)
    println(sum([1, 2, 3]))
    println(requires(1))
}
//> 3
//> 2
//> 0
//> 6
//> 2
