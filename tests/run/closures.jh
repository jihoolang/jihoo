fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
    f(x)
}

fn each(xs: [i64], f: fn(i64)) {
    for x in xs {
        f(x)
    }
}

fn twice(comptime f: fn(i64) -> i64, x: i64) -> i64 {
    f(f(x))
}

fn double(x: i64) -> i64 {
    x * 2
}

fn main() {
    let k = 10
    println(apply(fn(x) { x + k }, 5))
    var total = 0
    each([1, 2, 3, 4], fn(x) { total += x })
    println(total)
    println(twice(fn(x) { x * 3 }, 2))
    println(apply(double, 21))
    let p: fnptr(i64) -> i64 = double
    println(p(4))
}
//> 15
//> 10
//> 18
//> 42
//> 8
