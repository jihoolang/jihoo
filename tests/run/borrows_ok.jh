fn longest(a: str, b: str) -> str {
    if a.len >= b.len { a } else { b }
}

fn first_word(s: str) -> str {
    var i = 0
    while i < s.len && s[i] != ' ' {
        i += 1
    }
    s[0..i]
}

fn main() {
    var v = Vec(i64).new()
    v.push(1)
    v.push(v.len())
    let n = v[0] + v[1]
    v.push(n)
    println(v[2])
    let s = String.from("hello world")
    let w = first_word(s.as_str())
    println(w)
    println(longest("ab", "abc"))
    var words = Vec(str).new()
    words.push(w)
    words.push("x")
    println(words.len())
    inout last = &v[2]
    last += 10
    println(v[2])
    // a `ref` returned through `Option`: a reborrow of `index`'s result
    match v.last() {
        Some(x) => println(x)
        None => {}
    }
    match v.first() {
        Some(x) => println(x)
        None => {}
    }
    loop_elements_outlive_iteration()
}

struct Named {
    name: String
}

struct Entry {
    of: ref Named
}

// Elements of a `for` loop kept after their iteration: in a variable, a
// `Vec` of views, and a struct field of type `ref T`.
fn loop_elements_outlive_iteration() {
    var words = Vec(String).new()
    words.push("a".to_string())
    words.push("b".to_string())
    var last = ""
    for w in words {
        last = w.as_str()
    }
    println(last)
    var views = Vec(str).new()
    for w in words {
        views.push(w.as_str())
    }
    println(views.len())
    var named = Vec(Named).new()
    named.push(Named { name: "c".to_string() })
    var entries = Vec(Entry).new()
    for n in named {
        entries.push(Entry { of: n })
    }
    println(entries[0].of.name)
}
//> 2
//> hello
//> abc
//> 2
//> 12
//> 12
//> 1
//> b
//> 2
//> c
