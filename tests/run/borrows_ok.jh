fn longest(a: str, b: str) -> str {
    if a.len >= b.len { a } else { b }
}

fn first_word(s: str) -> str {
    var i = 0
    while i < s.len && s[i] != ' ' {
        i += 1
    }
    s[0..i]
}

fn main() {
    var v = Vec(i64).new()
    v.push(1)
    v.push(v.len())
    let n = v[0] + v[1]
    v.push(n)
    println(v[2])
    let s = String.from("hello world")
    let w = first_word(s.as_str())
    println(w)
    println(longest("ab", "abc"))
    var words = Vec(str).new()
    words.push(w)
    words.push("x")
    println(words.len())
    inout last = &v[2]
    last += 10
    println(v[2])
    // a `ref` returned through `Option`: a reborrow of `index`'s result
    match v.last() {
        Some(x) => println(x)
        None => {}
    }
    match v.first() {
        Some(x) => println(x)
        None => {}
    }
    loop_elements_outlive_iteration()
    borrows_as_values()
}

struct Named {
    name: String
}

struct Shelf {
    items: ref Vec(Named)
}

struct Entry {
    of: ref Named
}

// Elements of a `for` loop kept after their iteration: in a variable, a
// `Vec` of views, and a struct field of type `ref T`.
fn loop_elements_outlive_iteration() {
    var words = Vec(String).new()
    words.push("a".to_string())
    words.push("b".to_string())
    var last = ""
    for w in words {
        last = w.as_str()
    }
    println(last)
    var views = Vec(str).new()
    for w in words {
        views.push(w.as_str())
    }
    println(views.len())
    var named = Vec(Named).new()
    named.push(Named { name: "c".to_string() })
    var entries = Vec(Entry).new()
    for n in named {
        entries.push(Entry { of: n })
    }
    println(entries[0].of.name)
    // a loop over a `ref Vec` held in a struct
    let shelf = Shelf { items: named }
    for n in shelf.items {
        println(n.name)
    }
}

struct Holder {
    p: *i64
}

fn name_len(n: Named) -> i64 {
    n.name.len()
}

// A `ref T` value lent where a `T` is borrowed; a `Map` whose values are
// borrows (its `insert` returns the old one as a value); a raw pointer read
// out of a `Vec`, which borrows nothing, kept while the `Vec` grows.
fn borrows_as_values() {
    var named = Vec(Named).new()
    named.push(Named { name: "dd".to_string() })
    let e = Entry { of: named[0] }
    println(name_len(e.of))
    var by_name = Map(String, ref Named).new()
    by_name.insert("x".to_string(), named[0])
    match by_name.insert("x".to_string(), named[0]) {
        Some(old) => println(old.name)
        None => println("none")
    }
    var holders = Vec(Holder).new()
    holders.push(Holder { p: null })
    let p = holders[0].p
    holders.push(Holder { p: null })
    println(p == null)
}

