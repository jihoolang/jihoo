// 128-bit integers: arithmetic, printing, conversions, patterns, constants.

const BIG: u128 = 1 << 100
const ALL: u128 = 0 -% 1

fn kind(x: i128) -> i64 {
    match x {
        -5..5 => 0
        100 => 1
        _ => 2
    }
}

fn main() {
    println(ALL)
    //> 340282366920938463463374607431768211455
    let imax = (ALL >> 1) as i128
    println(0 -% imax -% 1)
    //> -170141183460469231731687303715884105728
    let m: u128 = 0xffffffffffffffff
    println(m * m)
    //> 340282366920938463426481119284349108225
    println(BIG * 7 / 3 % 1000000)
    //> 145877
    let x: i128 = -5 * 1000000000000000000 * 1000
    println(x)
    //> -5000000000000000000000
    println(x / 7)
    //> -714285714285714285714
    println(x % 7)
    //> -2
    println(x as i64)
    //> -932356024711512064
    println((x as f64) as i128)
    //> -5000000000000000000000
    println(1e30 as u128)
    //> 1000000000000000019884624838656
    let amount: u8 = 70
    let one: u128 = 1
    println(one << amount)
    //> 1180591620717411303424
    let b: u8 = 1 << 3
    println(b)
    //> 8
    println(kind(3))
    //> 0
    println(kind(-1000))
    //> 2
    var seen = Map(i128, i64).new()
    seen.insert(x, 1)
    seen.insert(x + 1, 2)
    println(seen[x + 1])
    //> 2
    println(size_of(i128))
    //> 16
}
