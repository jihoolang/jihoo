// args: SEED COUNT. Runs compiler/linear.jh's `check`, `Lin.add_scaled`,
// `add` and `mul` on random inputs and prints each input with what the
// code returned, one case per line, for tests/horn/differential/check.py to
// compare with what the rules `jihoo emit-horn` writes say:
//
//     (check (FACT...) CLAIM (WEIGHT...) (ok N) | (err))
//     (add_scaled A B W (some LIN) | (none))
//     (add A B (some N) | (none))      (mul A B (some N) | (none))
//
// where a form is ((VAR COEF)...) CONSTANT. Certificates are built to be
// accepted, then often broken: a weight changed or made negative, a form
// left unsorted, numbers near the ends of i128.
import std.env
import std.sys
import linear

const VARS: i64 = 6
const MAX: i128 = (((1 as i128) << 126) - 1) * 2 + 1

struct Rng { s: u64 }

impl Rng {
    fn next(inout self) -> u64 {
        self.s = self.s *% 6364136223846793005 +% 1442695040888963407
        self.s >> 33
    }

    // 0 <= result < n
    fn below(inout self, n: i64) -> i64 { (self.next() % n as u64) as i64 }

    // lo <= result <= hi, for small ranges
    fn between(inout self, lo: i64, hi: i64) -> i128 { (lo + self.below(hi - lo + 1)) as i128 }

    // A number from small ones, powers of two near the limits and the limits.
    fn big(inout self) -> i128 {
        let k = self.below(8)
        if k == 0 { return MAX }
        if k == 1 { return -MAX - 1 }
        if k == 2 { return (1 as i128) << (60 + self.below(67)) as i128 }
        if k == 3 { return -((1 as i128) << (60 + self.below(67)) as i128) }
        if k == 4 { return ((1 as i128) << 126) + self.between(-3, 3) }
        self.between(-9, 9)
    }
}

// A dense form over variables 0..VARS, then the constant.
fn dense() -> Vec(i128) {
    var d = Vec(i128).new()
    for i in 0..VARS + 1 { d.push(0) }
    d
}

fn sparse(d: [i128]) -> linear.Lin {
    var terms = Vec((i64, i128)).new()
    for v in 0..VARS {
        if d[v] != 0 { terms.push((v, d[v])) }
    }
    linear.Lin { terms, constant: d[VARS] }
}

fn random_form(inout r: Rng) -> Vec(i128) {
    var d = dense()
    for v in 0..VARS {
        if r.below(2) == 0 { d[v] = r.between(-5, 5) }
    }
    d[VARS] = r.between(-6, 6)
    d
}

fn add_into(inout acc: Vec(i128), d: [i128], w: i128) {
    for i in 0..VARS + 1 { acc[i] = acc[i] + d[i] * w }
}

fn show_lin(l: linear.Lin) -> String {
    var out = String.from("((")
    for i in 0..l.terms.len() {
        if i > 0 { out.push_str(" ") }
        out.push_str(
            "(" + l.terms[i].0.to_string().as_str() + " " + l.terms[i].1.to_string().as_str() + ")"
        )
    }
    out.push_str(") " + l.constant.to_string().as_str() + ")")
    out
}

fn show_opt(o: Option(i128)) -> String {
    match o {
        Some(n) => "(some " + n.to_string().as_str() + ")"
        None => String.from("(none)")
    }
}

// A form broken one way: unsorted, a zero coefficient or a negative variable.
fn unsorted(inout r: Rng, l: linear.Lin) -> linear.Lin {
    var terms = l.terms.clone()
    let k = r.below(3)
    if k == 0 && terms.len() >= 2 {
        let t = terms[0]
        terms[0] = terms[1]
        terms[1] = t
    } else if k == 1 && terms.len() >= 1 {
        terms[0] = (terms[0].0, 0)
    } else {
        terms.insert(0, (-1, if r.below(2) == 0 { 1 } else { -1 }))
    }
    linear.Lin { terms, constant: l.constant }
}

fn check_case(inout r: Rng) {
    let n = 1 + r.below(4)
    var forms = Vec(Vec(i128)).new()
    var ws = Vec(i128).new()
    let claim = random_form(&r)
    let wc = r.between(1, 3)
    // The weighted sum of the negated claim, -1 - claim, and the facts.
    var sum = dense()
    sum[VARS] = -wc
    add_into(&sum, claim.as_slice(), -wc)
    for i in 0..n - 1 {
        let f = random_form(&r)
        let w = r.between(0, 3)
        add_into(&sum, f.as_slice(), w)
        forms.push(f)
        ws.push(w)
    }
    // The last fact cancels the variables and leaves a negative constant.
    var last = dense()
    for v in 0..VARS { last[v] = -sum[v] }
    last[VARS] = -sum[VARS] - 1 - r.between(0, 2)
    forms.push(last)
    ws.push(1)
    var facts = Vec(linear.Lin).new()
    for f in forms { facts.push(sparse(f.as_slice())) }
    var cl = sparse(claim.as_slice())
    // Break it, often.
    let k = r.below(12)
    let i = r.below(n)
    if k == 0 {
        ws[i] = ws[i] + 1
    } else if k == 1 {
        ws[i] = -1 - r.between(0, 2)
    } else if k == 2 {
        facts[i] = unsorted(&r, facts[i])
    } else if k == 3 {
        cl = unsorted(&r, cl)
    } else if k == 4 {
        facts[i] = linear.Lin {
            terms: facts[i].terms.clone(),
            constant: facts[i].constant + r.between(1, 9)
        }
    } else if k == 5 {
        if r.below(2) == 0 { ws.push(1) } else { let _ = ws.pop() }
    } else if k == 6 {
        ws[i] = r.big()
    } else if k == 7 {
        facts[i] = linear.Lin { terms: facts[i].terms.clone(), constant: r.big() }
    } else if k == 8 {
        // A fact after the contradiction, whose weight spoils the sum (or
        // not, at weight 0): the sum loop must go on to the end.
        facts.push(sparse(random_form(&r).as_slice()))
        ws.push(r.between(0, 2))
    } else if k == 9 {
        // The facts in another order, each with its weight.
        let j = r.below(n)
        let f = facts[i].clone()
        facts[i] = facts[j].clone()
        facts[j] = f
        let w = ws[i]
        ws[i] = ws[j]
        ws[j] = w
    }
    var wv = ws.clone()
    wv.push(wc)
    print_check(linear.Goal { facts, claim: cl }, linear.Certificate { weights: wv })
}

fn print_check(g: linear.Goal, c: linear.Certificate) {
    var out = String.from("(check (")
    for j in 0..g.facts.len() {
        if j > 0 { out.push_str(" ") }
        out.push_str(show_lin(g.facts[j]).as_str())
    }
    out.push_str(") " + show_lin(g.claim).as_str() + " (")
    for j in 0..c.weights.len() {
        if j > 0 { out.push_str(" ") }
        out.push_str(c.weights[j].to_string().as_str())
    }
    out.push_str(") ")
    match linear.check(g, c) {
        Ok(m) => out.push_str("(ok " + m.to_string().as_str() + "))")
        Err(_) => out.push_str("(err))")
    }
    println(out)
}

fn scaled_case(inout r: Rng) {
    var a = sparse(random_form(&r).as_slice())
    if r.below(6) == 0 {
        // A zero coefficient, which `check` never passes but the code
        // handles: it drops the term.
        var terms = a.terms.clone()
        if terms.len() > 0 { terms[r.below(terms.len())] = (terms[0].0, 0) }
        if terms.len() == 1 || r.below(2) == 0 { terms = Vec((i64, i128)).new(); terms.push(
            (r.below(VARS), 0)
        ) }
        a = linear.Lin { terms, constant: a.constant }
    }
    var b = sparse(random_form(&r).as_slice())
    if r.below(4) == 0 {
        var terms = b.terms.clone()
        if terms.len() > 0 { terms[0] = (terms[0].0, r.big()) }
        b = linear.Lin { terms, constant: r.big() }
    }
    let w = if r.below(3) == 0 { r.big() } else { r.between(-4, 4) }
    var out = "(add_scaled " + show_lin(a).as_str() + " " + show_lin(b).as_str() + " " + w.to_string().as_str() + " "
    match a.add_scaled(b, w) {
        Some(l) => out.push_str("(some " + show_lin(l).as_str() + "))")
        None => out.push_str("(none))")
    }
    println(out)
}

fn arith_case(inout r: Rng) {
    let a = r.big()
    let b = r.big()
    println(
        "(add " + a.to_string().as_str() + " " + b.to_string().as_str() + " " + show_opt(linear.add(
            a,
            b
        )).as_str() + ")"
    )
    println(
        "(mul " + a.to_string().as_str() + " " + b.to_string().as_str() + " " + show_opt(linear.mul(
            a,
            b
        )).as_str() + ")"
    )
}

fn main() {
    let a = env.args()
    if a.len() != 3 {
        println("usage: cases SEED COUNT")
        sys.exit(2)
    }
    let Some(seed) = a[1].parse_int() else { sys.exit(2) }
    let Some(count) = a[2].parse_int() else { sys.exit(2) }
    var r = Rng { s: seed as u64 }
    // More facts than the checker takes.
    var facts = Vec(linear.Lin).new()
    var ws = Vec(i128).new()
    for _ in 0..linear.MAX_FACTS + 1 {
        facts.push(linear.Lin.num(0))
        ws.push(0)
    }
    ws.push(1)
    print_check(linear.Goal { facts, claim: linear.Lin.num(0) }, linear.Certificate { weights: ws })
    for _ in 0..count {
        check_case(&r)
        scaled_case(&r)
        arith_case(&r)
    }
}
