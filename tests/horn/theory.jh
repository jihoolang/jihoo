// args: FILE: the output of `jihoo emit-horn`, which must be a theory that
// lib/proof accepts (every rule well sorted, every symbol declared).
import std.env
import std.fs
import std.sys
import proof.code
import proof.schematic

fn main() {
    let a = env.args()
    let Ok(rules) = fs.read_file(a[1]) else {
        println("cannot read " + a[1])
        sys.exit(1)
    }
    let th = code.theory(rules.as_str())
    match schematic.Theory.parse(th.as_str()) {
        Ok(_) => println("ok")
        Err(e) => {
            println("not a theory: " + e.as_str())
            sys.exit(1)
        }
    }
}
