// The tests of the compiler and its standard library, run from the root of
// the checkout:
//
//   jihoo run tests/runner.jh                    every suite
//   jihoo run tests/runner.jh -- check fail      some of them
//   JIHOO_TEST=maps jihoo run tests/runner.jh    the files whose path has `maps`
//   JIHOO_TEST_OPT=-O0 jihoo run tests/runner.jh -- run
//   JIHOO_COMPILER=out/jihoo jihoo run tests/runner.jh
//
// The compiler tested is JIHOO_COMPILER, else compiler/main.jh built by the
// compiler that runs this program (the `jihoo` on PATH: in the dev shell,
// the seed). The suites:
//
// - run: each program in tests/run is built and run. Its `//> text` lines
//   are its standard output in order, `// exit: N` its exit status (128 + N
//   for a signal N, so a trap is 132), `// args: a b` its arguments and
//   `// link: f.c` more inputs.
// - test: `jihoo test` runs each file in tests/test, with the directives
//   of tests/run: its output is the list of tests and results. The tests
//   of each file of lib/std that has them must pass.
// - fail: each program in tests/fail must not compile, and the error must
//   contain every `// error: text`, with the same diagnostics from check.
// - check: valid programs pass without LLVM or linkers, produce no files
//   or runtime output, and check supports modules and both targets. Python
//   independently parses JSON diagnostics and compares them with text errors,
//   drives the language server as an editor would, and compares float
//   digits with Python's.
// - format: source comments, syntax and emitted IR survive formatting;
//   formatting is idempotent and fmt --check detects unformatted source.
// - examples: each program in examples builds and runs.
// - backend: the C ABI at every optimization level and with both backends,
//   objects that C links, programs split into code generation units,
//   cross-compiled objects, link errors and a missing LLVM.
// - selfhost: the compiler builds itself, and the compiler it builds writes
//   the same LLVM IR, errors included, for every .jh file of the checkout.
// - uefi: the programs of tests/uefi, and those of tests/run that need
//   nothing UEFI lacks, built as `#![uefi]` programs for x86_64 and run in
//   QEMU with OVMF and the UEFI shell, given JIHOO_QEMU (the
//   qemu-system-x86_64 to use), JIHOO_OVMF (its firmware) and
//   JIHOO_UEFI_SHELL (the shell's .efi), as `nix develop .#uefi` sets
//   them; without them they are only built. Some are also built for
//   aarch64.

import std.env
import std.fs
import std.process

struct Tests {
    // the compiler under test
    compiler: String
    // a directory for the files the tests make
    tmp: String
    // JIHOO_TEST: only the files whose path contains it
    filter: String
    failures: Vec(String)
    count: i64
}

// ---- running programs ----

// What a program wrote and how it ended; a program that cannot start ends
// with status 127, the reason in its standard error.
fn exec(program: str, args: [str]) -> process.Output {
    match process.output(program, args) {
        Ok(o) => o
        Err(e) => process.Output {
            status: process.Exit.Code(127),
            stdout: String.new(),
            stderr: e.to_string()
        }
    }
}

// The exit status as a shell reports it.
fn status(o: process.Output) -> i64 {
    match o.status {
        Code(c) => c as i64
        Signal(s) => 128 + s as i64
    }
}

// ---- reading the expectations in a test ----

fn trim_start(s: str) -> str {
    var i = 0
    while i < s.len && (s[i] == ' ' || s[i] == '\t') {
        i += 1
    }
    s[i..]
}

// What follows `prefix` on each line that starts with it.
fn directives(src: str, prefix: str) -> Vec(str) {
    var out = Vec(str).new()
    for line in src.lines() {
        let l = trim_start(line)
        if l.starts_with(prefix) {
            out.push(l[prefix.len..])
        }
    }
    out
}

// Adds the words after the first line that starts with `prefix`.
fn words(src: str, prefix: str, inout out: Vec(str)) {
    for line in src.lines() {
        let l = trim_start(line)
        if l.starts_with(prefix) {
            let rest = l[prefix.len..]
            var i = 0
            while i < rest.len {
                while i < rest.len && rest[i] == ' ' {
                    i += 1
                }
                let start = i
                while i < rest.len && rest[i] != ' ' {
                    i += 1
                }
                if i > start {
                    out.push(rest[start..i])
                }
            }
            break
        }
    }
}

fn join(xs: Vec(str)) -> String {
    var s = String.new()
    for i in 0..xs.len() {
        if i > 0 {
            s.push('\n')
        }
        s.push_str(xs[i])
    }
    s
}

fn same(a: Vec(str), b: Vec(str)) -> bool {
    if a.len() != b.len() {
        return false
    }
    for i in 0..a.len() {
        if a[i] != b[i] {
            return false
        }
    }
    true
}

// The file name without its directory and extension.
fn stem(path: str) -> str {
    var start = path.len
    while start > 0 && path[start - 1] != '/' {
        start -= 1
    }
    var end = path.len
    if path.ends_with(".jh") {
        end -= 3
    }
    path[start..end]
}

// The file operations of `std.fs`, with errors as text for `?`.
fn read_file(path: str) -> Result(String, String) {
    match fs.read_file(path) {
        Ok(t) => Ok(t)
        Err(e) => Err("cannot read " + path + ": " + e.to_string().as_str())
    }
}

fn write_file(path: str, text: str) -> Result((), String) {
    match fs.write_file(path, text) {
        Ok(_) => Ok(())
        Err(e) => Err("cannot write " + path + ": " + e.to_string().as_str())
    }
}

fn read_dir(path: str) -> Result(Vec(String), String) {
    match fs.read_dir(path) {
        Ok(names) => Ok(names)
        Err(e) => Err("cannot read " + path + ": " + e.to_string().as_str())
    }
}

fn remove_file(path: str) -> Result((), String) {
    match fs.remove_file(path) {
        Ok(_) => Ok(())
        Err(e) => Err("cannot remove " + path + ": " + e.to_string().as_str())
    }
}

// The .jh files of a directory, sorted, and with `deep` those of the
// directories in it.
fn jh_files(dir: str, deep: bool, inout out: Vec(String)) {
    match fs.read_dir(dir) {
        Ok(names) => {
            for n in names {
                let path = dir + "/" + n.as_str()
                if n.as_str().ends_with(".jh") {
                    out.push(path)
                } else if deep {
                    jh_files(path.as_str(), true, &out)
                }
            }
        }
        Err(_) => {}
    }
}

// ---- the tests ----

impl Tests {
    fn selected(self, path: str) -> bool {
        self.filter.len() == 0 || path.contains(self.filter.as_str())
    }

    fn temp(self, name: str) -> String {
        self.tmp.as_str() + "/" + name
    }

    // Records the result of one test.
    fn check(inout self, what: str, r: Result((), String)) {
        self.count += 1
        match r {
            Ok(_) => {}
            Err(e) => {
                eprintln("--- " + what + ": " + e.as_str())
                self.failures.push(what.to_string())
            }
        }
    }

    // compiler/main.jh built by `compiler`, as `name` in the temporary
    // directory.
    fn build_compiler(self, compiler: str, name: str) -> Result(String, String) {
        let out = self.temp(name)
        let o = exec(compiler, ["build", "-O1", "compiler/main.jh", "-o", out.as_str()])
        if !o.status.success() {
            return Err(
                "compiler/main.jh does not compile with " + compiler + ":\n" + o.stderr.as_str()
            )
        }
        Ok(out)
    }

    fn run_one(self, path: str) -> Result((), String) {
        let src = read_file(path)?
        let lines = directives(src.as_str(), "//>")
        var want = Vec(str).new()
        for d in lines {
            want.push(if d.starts_with(" ") { d[1..] } else { d })
        }
        var code: i64 = 0
        let exits = directives(src.as_str(), "// exit:")
        if exits.len() > 0 {
            code = exits[0].trim().parse_int().unwrap()
        }
        let exe = self.temp(stem(path))
        let opt = match env.get("JIHOO_TEST_OPT") {
            Some(o) => o
            None => "-O1"
        }
        var a = Vec(str).new()
        a.push("build")
        a.push(opt)
        a.push(path)
        words(src.as_str(), "// link:", &a)
        a.push("-o")
        a.push(exe.as_str())
        let built = exec(self.compiler.as_str(), a.as_slice())
        if !built.status.success() {
            return Err("does not compile:\n" + built.stderr.as_str())
        }
        var args = Vec(str).new()
        words(src.as_str(), "// args:", &args)
        let r = exec(exe.as_str(), args.as_slice())
        fs.remove_file(exe.as_str())
        let got = r.stdout.as_str().lines()
        let st = status(r)
        if !same(got, want) || st != code {
            return Err(
                "expected (exit " + code.to_string().as_str() + "):\n" + join(want).as_str() +
                    "\ngot (exit " + st.to_string().as_str() + "):\n" + join(got).as_str() +
                    "\nstderr:\n" + r.stderr.as_str()
            )
        }
        Ok(())
    }

    fn test_one(self, path: str) -> Result((), String) {
        let src = read_file(path)?
        let lines = directives(src.as_str(), "//>")
        var want = Vec(str).new()
        for d in lines {
            want.push(if d.starts_with(" ") { d[1..] } else { d })
        }
        var code: i64 = 0
        let exits = directives(src.as_str(), "// exit:")
        if exits.len() > 0 {
            code = exits[0].trim().parse_int().unwrap()
        }
        var a = Vec(str).new()
        a.push("test")
        a.push("-O1")
        a.push(path)
        words(src.as_str(), "// args:", &a)
        let r = exec(self.compiler.as_str(), a.as_slice())
        let got = r.stdout.as_str().lines()
        let st = status(r)
        if !same(got, want) || st != code {
            return Err(
                "expected (exit " + code.to_string().as_str() + "):\n" + join(want).as_str() +
                    "\ngot (exit " + st.to_string().as_str() + "):\n" + join(got).as_str() +
                    "\nstderr:\n" + r.stderr.as_str()
            )
        }
        Ok(())
    }

    // `jihoo test` passes for each file of the standard library with tests.
    fn std_tests(inout self) {
        var files = Vec(String).new()
        jh_files("lib/std", true, &files)
        for f in files {
            if !self.selected(f.as_str()) { continue }
            let src = match read_file(f.as_str()) {
                Ok(s) => s
                Err(e) => {
                    self.check(f.as_str(), Err(e))
                    continue
                }
            }
            if !src.as_str().contains("#[test]") { continue }
            let o = exec(self.compiler.as_str(), ["test", "-O1", f.as_str()])
            let r: Result((), String) = if o.status.success() {
                Ok(())
            } else {
                Err("tests failed:\n" + o.stdout.as_str() + o.stderr.as_str())
            }
            self.check(f.as_str(), r)
        }
    }

    fn fail_one(self, path: str) -> Result((), String) {
        let src = read_file(path)?
        let want = directives(src.as_str(), "// error:")
        if want.len() == 0 {
            return Err(String.from("no `// error:` line"))
        }
        var a = Vec(str).new()
        a.push("emit-mir")
        a.push(path)
        let o = exec(self.compiler.as_str(), a.as_slice())
        if o.status.success() {
            return Err(String.from("compiles, but should not"))
        }
        for w in want {
            if !o.stderr.as_str().contains(w.trim()) {
                return Err("the error does not say `" + w.trim() + "`:\n" + o.stderr.as_str())
            }
        }
        // The debug MIR switch must never bypass validation in check mode.
        let checked = exec("env", ["JIHOO_NO_ELAB=1", self.compiler.as_str(), "check", path])
        if status(checked) != 1 || checked.stderr != o.stderr.as_str() || checked.stdout.len() != 0 {
            return Err("check disagrees with emit-mir:\n" + checked.stderr.as_str())
        }
        Ok(())
    }

    fn check_one(self, path: str, options: [str]) -> Result((), String) {
        var a = Vec(str).new()
        for setting in ["JIHOO_LLVM=/no-library.so", "JIHOO_CC=/no-c-compiler",
            "JIHOO_LD=/no-linker", "JIHOO_BACKEND=no-backend"] {
                a.push(setting)
            }
        a.push(self.compiler.as_str())
        a.push("check")
        a.push(path)
        for option in options { a.push(option) }
        let o = exec("env", a.as_slice())
        if !o.status.success() || o.stdout.len() != 0 || o.stderr.len() != 0 {
            return Err("check failed or wrote output:\n" + o.stdout.as_str() + o.stderr.as_str())
        }
        Ok(())
    }

    fn check_command(self) -> Result((), String) {
        let source = self.temp("check-only.jh")
        // This program would fail to link, and its main must not execute.
        write_file(
            source.as_str(),
            "extern fn missing_symbol()\nfn main() { unsafe { missing_symbol() }; trap() }\n"
        )?
        let before = read_dir(self.tmp.as_str())?
        for target in ["x86_64", "aarch64"] {
            self.check_one(source.as_str(), ["--target", target])?
            self.check_one("tests/ffi/export.jh", ["--lib", "--target", target])?
        }
        let missing_main = exec(self.compiler.as_str(), ["check", "tests/ffi/export.jh"])
        if status(missing_main) != 1 || !missing_main.stderr.as_str().contains("no `main` function") {
            return Err("check without --lib must require main:\n" + missing_main.stderr.as_str())
        }
        let output = self.temp("check-output")
        for option in ["-o", "--keep-ll", "-lmissing", "--"] {
            var a = Vec(str).new()
            a.push("check")
            a.push(source.as_str())
            a.push(option)
            if option == "-o" || option == "--" { a.push(output.as_str()) }
            let o = exec(self.compiler.as_str(), a.as_slice())
            if status(o) != 2 || !o.stderr.as_str().contains("check does not accept") {
                return Err("check accepted " + option + ":\n" + o.stderr.as_str())
            }
        }
        let missing_output = exec(self.compiler.as_str(), ["check", source.as_str(), "-o"])
        if status(missing_output) != 2 || !missing_output.stderr.as_str().contains(
            "check does not accept"
        ) {
            return Err(String.from("check accepted -o without a path"))
        }
        let after = read_dir(self.tmp.as_str())?
        if before.len() != after.len() { return Err(String.from("check created output files")) }
        for i in 0..before.len() {
            if before[i] != after[i].as_str() { return Err(String.from(
                "check changed output files"
            )) }
        }
        remove_file(source.as_str())?
        Ok(())
    }

    // `--version` and `--help` as the first argument succeed on stdout.
    fn version_and_help(self) -> Result((), String) {
        for flag in ["--version", "-V"] {
            let o = exec(self.compiler.as_str(), [flag])
            if status(o) != 0 || !o.stdout.as_str().starts_with("jihoo ") || o.stdout.as_str().trim().len <= 6 {
                return Err(
                    flag + " does not print the version:\n" + o.stdout.as_str() + o.stderr.as_str()
                )
            }
        }
        for flag in ["--help", "-h"] {
            let o = exec(self.compiler.as_str(), [flag])
            if status(o) != 0 || !o.stdout.as_str().contains("usage:") {
                return Err(flag + " does not print the usage:\n" + o.stderr.as_str())
            }
        }
        Ok(())
    }

    fn json_diagnostics(self) -> Result((), String) {
        let o = exec("python3", ["tests/diagnostics.py", "--compiler", self.compiler.as_str()])
        if !o.status.success() {
            return Err(
                "JSON diagnostic validation failed:\n" + o.stdout.as_str() + o.stderr.as_str()
            )
        }
        let floats = exec("python3", ["tests/floats.py", "--compiler", self.compiler.as_str()])
        if !floats.status.success() {
            return Err("float formatting validation failed:\n" + floats.stdout.as_str() + floats.stderr.as_str())
        }
        let server = exec("python3", ["tests/lsp.py", "--compiler", self.compiler.as_str()])
        if !server.status.success() {
            return Err("language server validation failed:\n" + server.stdout.as_str() + server.stderr.as_str())
        }
        let report = exec(
            "python3",
            ["tests/comptime_report.py", "--compiler", self.compiler.as_str()]
        )
        if !report.status.success() {
            return Err("compile-time resource report validation failed:\n" + report.stdout.as_str() + report.stderr.as_str())
        }
        let times = exec("python3", ["tests/time_passes.py", "--compiler", self.compiler.as_str()])
        if !times.status.success() {
            return Err(
                "phase timing validation failed:\n" + times.stdout.as_str() + times.stderr.as_str()
            )
        }
        Ok(())
    }

    fn formatting(self) -> Result((), String) {
        let o = exec("python3", ["tests/format.py", "--compiler", self.compiler.as_str()])
        if !o.status.success() {
            return Err("formatter validation failed:\n" + o.stdout.as_str() + o.stderr.as_str())
        }
        Ok(())
    }

    // The compiler and the standard library are formatted.
    fn formatted_sources(self) -> Result((), String) {
        let o = exec(self.compiler.as_str(), ["fmt", "compiler", "lib/std", "--check"])
        if !o.status.success() {
            return Err("run `jihoo fmt compiler lib/std --write`:\n" + o.stderr.as_str())
        }
        Ok(())
    }

    fn example_one(self, path: str) -> Result((), String) {
        let src = read_file(path)?
        if src.as_str().starts_with("#![uefi]") {
            return self.uefi_build(path, "x86_64", self.temp("example.efi").as_str())
        }
        let exe = self.temp(stem(path))
        var a = Vec(str).new()
        a.push("build")
        a.push(path)
        a.push("-o")
        a.push(exe.as_str())
        let built = exec(self.compiler.as_str(), a.as_slice())
        if !built.status.success() {
            return Err("does not compile:\n" + built.stderr.as_str())
        }
        var args = Vec(str).new()
        words(src.as_str(), "// args:", &args)
        let r = exec(exe.as_str(), args.as_slice())
        fs.remove_file(exe.as_str())
        match r.status {
            Signal(s) => return Err(
                "stopped by signal " + s.to_string().as_str() + ":\n" + r.stderr.as_str()
            )
            Code(_) => {}
        }
        Ok(())
    }

    fn suite_files(inout self, dir: str, kind: str) {
        var files = Vec(String).new()
        jh_files(dir, false, &files)
        for f in files {
            if !self.selected(f.as_str()) {
                continue
            }
            let r = if kind == "run" {
                self.run_one(f.as_str())
            } else if kind == "fail" {
                self.fail_one(f.as_str())
            } else if kind == "test" {
                self.test_one(f.as_str())
            } else if kind == "check" {
                self.check_one(f.as_str(), [])
            } else {
                self.example_one(f.as_str())
            }
            self.check(f.as_str(), r)
        }
    }

    // ---- backend ----

    fn c_abi(self) -> Result((), String) {
        self.c_abi_file("tests/run/ffi.jh")?
        self.c_abi_file("tests/run/ffi_aggregates.jh")
    }

    fn c_abi_file(self, file: str) -> Result((), String) {
        let src = read_file(file)?
        let lines = directives(src.as_str(), "//> ")
        var want = String.new()
        for d in lines {
            want.push_str(d)
            want.push('\n')
        }
        let exe = self.temp("ffi")
        for backend in ["JIHOO_BACKEND=llvm", "JIHOO_BACKEND=clang"] {
            for opt in ["-O0", "-O1", "-O2", "-O3"] {
                var a = Vec(str).new()
                a.push(backend)
                a.push(self.compiler.as_str())
                a.push("build")
                a.push(opt)
                a.push(file)
                words(src.as_str(), "// link:", &a)
                a.push("-o")
                a.push(exe.as_str())
                let built = exec("env", a.as_slice())
                if !built.status.success() {
                    return Err(file + ": " + backend + " " + opt + ": does not compile:\n" + built.stderr.as_str())
                }
                let r = exec(exe.as_str(), [])
                if !r.status.success() || r.stdout != want.as_str() {
                    return Err(file + ": " + backend + " " + opt + ": prints\n" + r.stdout.as_str() + r.stderr.as_str())
                }
            }
        }
        fs.remove_file(exe.as_str())
        Ok(())
    }

    // Programs split into several code generation units, which are small
    // enough for one: cross-unit calls, globals, closures, `dyn` tables,
    // threads, C callbacks and a freestanding `_start`.
    fn codegen_units(self) -> Result((), String) {
        let exe = self.temp("units")
        let files = [
            "tests/run/ffi.jh",
            "tests/run/dyn_traits.jh",
            "tests/run/closures.jh",
            "tests/run/threads.jh",
            "tests/run/dyn_threads_freestanding.jh"
        ]
        for file in files {
            let src = read_file(file)?
            var want = String.new()
            for d in directives(src.as_str(), "//> ") {
                want.push_str(d)
                want.push('\n')
            }
            for opt in ["-O0", "-O2"] {
                var a = Vec(str).new()
                a.push("JIHOO_CODEGEN_UNITS=3")
                a.push(self.compiler.as_str())
                a.push("build")
                a.push(opt)
                a.push(file)
                words(src.as_str(), "// link:", &a)
                a.push("-o")
                a.push(exe.as_str())
                let built = exec("env", a.as_slice())
                if !built.status.success() {
                    return Err(file + ": three units " + opt + ": does not compile:\n" + built.stderr.as_str())
                }
                let r = exec(exe.as_str(), [])
                if !r.status.success() || r.stdout != want.as_str() {
                    return Err(file + ": three units " + opt + ": prints\n" + r.stdout.as_str() + r.stderr.as_str())
                }
            }
        }
        fs.remove_file(exe.as_str())
        Ok(())
    }

    // An object without `main` that C links, statically and as a shared
    // library that a jihoo program opens.
    fn c_links_export(self) -> Result((), String) {
        let obj = self.temp("exports.o")
        let exe = self.temp("consumer")
        let shared = self.temp("libexports.so")
        let cc = match env.get("JIHOO_CC") {
            Some(c) => c
            None => "clang"
        }
        var a = Vec(str).new()
        a.push("emit-obj")
        a.push("--lib")
        a.push("tests/ffi/export.jh")
        a.push("-o")
        a.push(obj.as_str())
        let o = exec(self.compiler.as_str(), a.as_slice())
        if !o.status.success() {
            return Err("emit-obj --lib fails:\n" + o.stderr.as_str())
        }
        var c = Vec(str).new()
        c.push("tests/ffi/consumer.c")
        c.push(obj.as_str())
        c.push("-lm")
        c.push("-ldl")
        c.push("-o")
        c.push(exe.as_str())
        let linked = exec(cc, c.as_slice())
        if !linked.status.success() {
            return Err(cc + " cannot link the object:\n" + linked.stderr.as_str())
        }
        let r = exec(exe.as_str(), [])
        if !r.status.success() || r.stdout != "C called jihoo\n" {
            return Err("the C program prints\n" + r.stdout.as_str() + r.stderr.as_str())
        }
        var s = Vec(str).new()
        s.push("-shared")
        s.push(obj.as_str())
        s.push("-lm")
        s.push("-ldl")
        s.push("-o")
        s.push(shared.as_str())
        let so = exec(cc, s.as_slice())
        if !so.status.success() {
            return Err(cc + " cannot make a shared library:\n" + so.stderr.as_str())
        }
        var d = Vec(str).new()
        d.push("run")
        d.push("tests/ffi/dynamic.jh")
        d.push("--")
        d.push(shared.as_str())
        let dyn = exec(self.compiler.as_str(), d.as_slice())
        fs.remove_file(obj.as_str())
        fs.remove_file(exe.as_str())
        fs.remove_file(shared.as_str())
        if !dyn.status.success() || dyn.stdout != "42\n" {
            return Err("tests/ffi/dynamic.jh prints\n" + dyn.stdout.as_str() + dyn.stderr.as_str())
        }
        Ok(())
    }

    // Objects for both machines, with no C compiler to call.
    fn cross_objects(self) -> Result((), String) {
        let obj = self.temp("cross.o")
        for t in ["x86_64", "aarch64"] {
            for file in ["examples/freestanding.jh", "tests/run/ffi_aggregates.jh"] {
                var a = Vec(str).new()
                a.push("JIHOO_CC=/no-such-c-compiler")
                a.push(self.compiler.as_str())
                a.push("emit-obj")
                a.push(file)
                a.push("--target")
                a.push(t)
                a.push("-o")
                a.push(obj.as_str())
                let o = exec("env", a.as_slice())
                if !o.status.success() {
                    return Err(t + ": " + o.stderr.as_str())
                }
                let bytes = read_file(obj.as_str())?
                let b = bytes.as_str()
                // ELF, and e_machine: 62 for x86_64, 183 for aarch64
                let want: i64 = if t == "x86_64" { 62 } else { 183 }
                if b.len < 20 || b[0] != 0x7f || b[1..4] != "ELF" || (
                    b[18] as i64 | (b[19] as i64) << 8
                ) != want {
                    return Err(t + ": not an ELF object for that machine")
                }
            }
        }
        fs.remove_file(obj.as_str())
        Ok(())
    }

    // A failed link reports clang's messages without its warnings.
    fn link_errors(self) -> Result((), String) {
        let exe = self.temp("no-link")
        var a = Vec(str).new()
        a.push("build")
        a.push("examples/hello.jh")
        a.push("no-such-input.o")
        a.push("-o")
        a.push(exe.as_str())
        let o = exec(self.compiler.as_str(), a.as_slice())
        let err = o.stderr.as_str()
        if o.status.success() || !err.contains("failed:\n") || !err.contains("no-such-input.o") || err.contains(
            "warning:"
        ) {
            return Err("the link error is\n" + err)
        }
        Ok(())
    }

    // Without LLVM, building fails and names the library; emit-llvm needs
    // no LLVM.
    fn missing_llvm(self) -> Result((), String) {
        let exe = self.temp("no-llvm")
        let lib = self.temp("no-library.so")
        let var_ = "JIHOO_LLVM=" + lib.as_str()
        var a = Vec(str).new()
        a.push(var_.as_str())
        a.push(self.compiler.as_str())
        a.push("build")
        a.push("examples/hello.jh")
        a.push("-o")
        a.push(exe.as_str())
        let o = exec("env", a.as_slice())
        if o.status.success() || !o.stderr.as_str().contains("no-library.so") || fs.read_file(
            exe.as_str()
        ).is_ok() {
            return Err("building without LLVM says\n" + o.stderr.as_str())
        }
        var b = Vec(str).new()
        b.push("JIHOO_LLVM=/no-library.so")
        b.push(self.compiler.as_str())
        b.push("emit-llvm")
        b.push("examples/hello.jh")
        let e = exec("env", b.as_slice())
        if !e.status.success() {
            return Err("emit-llvm without LLVM fails:\n" + e.stderr.as_str())
        }
        Ok(())
    }

    fn backend(inout self) {
        let r = self.c_abi()
        self.check("backend: C ABI", r)
        let r = self.c_links_export()
        self.check("backend: C links an exported object", r)
        let r = self.codegen_units()
        self.check("backend: code generation units", r)
        let r = self.cross_objects()
        self.check("backend: cross-compiled objects", r)
        let r = self.link_errors()
        self.check("backend: link errors", r)
        let r = self.missing_llvm()
        self.check("backend: missing LLVM", r)
    }

    // ---- uefi ----

    // `path` as a UEFI program for `target`, at `out`. A program of
    // tests/run gets the attribute in a copy, which finds its modules with
    // `-I`; C link inputs are compiled for the target first.
    fn uefi_build(self, path: str, target: str, out: str) -> Result((), String) {
        let src = read_file(path)?
        var file = String.from(path)
        var objs = Vec(String).new()
        var a = Vec(str).new()
        a.push("build")
        a.push("-O1")
        a.push("--target")
        a.push(target)
        var end = path.len
        while end > 0 && path[end - 1] != '/' {
            end -= 1
        }
        let dir = if end == 0 { "." } else { path[0..end] }
        if !src.as_str().starts_with("#![uefi]") {
            file = self.temp("uefi-" + stem(path) + ".jh")
            write_file(file.as_str(), ("#![uefi]\n" + src.as_str()).as_str())?
            a.push("-I")
            a.push(dir)
        }
        a.push(file.as_str())
        var inputs = Vec(str).new()
        words(src.as_str(), "// link:", &inputs)
        for c in inputs {
            let obj = self.temp(stem(c) + "-" + target + ".obj")
            let triple = target + "-unknown-windows"
            let cc = match env.get("JIHOO_CC") {
                Some(cc) => cc
                None => "clang"
            }
            // The Nix wrapper's hardening flags (-fPIC) do not apply to
            // Windows triples.
            let o = exec(
                "env",
                ["NIX_HARDENING_ENABLE=", cc, "-target", triple.as_str(), "-ffreestanding",
                    "-fno-stack-protector", "-O1", "-c", c, "-o", obj.as_str()]
            )
            if !o.status.success() {
                return Err(
                    c + " does not compile for " + triple.as_str() + ":\n" + o.stderr.as_str()
                )
            }
            objs.push(obj)
        }
        for o in objs { a.push(o.as_str()) }
        a.push("-o")
        a.push(out)
        let built = exec(self.compiler.as_str(), a.as_slice())
        if !built.status.success() {
            return Err("does not compile for " + target + ":\n" + built.stderr.as_str())
        }
        // a PE image for the machine: "MZ", the PE header's offset at 0x3c,
        // "PE\0\0" and the machine, 0x8664 or 0xaa64
        let b = match fs.read_bytes(out) {
            Ok(b) => b
            Err(e) => return Err("cannot read " + out + ": " + e.to_string().as_str())
        }
        let want: i64 = if target == "x86_64" { 0x8664 } else { 0xaa64 }
        var pe: i64 = 0
        if b.len() > 0x40 { pe = b[0x3c] as i64 | (b[0x3d] as i64) << 8 }
        if b.len() < 0x40 || b[0] != 'M' || b[1] != 'Z' || pe + 6 > b.len() || b[pe] != 'P' ||
            b[pe + 1] != 'E' || (b[pe + 4] as i64 | (b[pe + 5] as i64) << 8) != want {
            return Err(out + " is not a PE image for " + target)
        }
        Ok(())
    }

    fn uefi(inout self) {
        var files = Vec(String).new()
        jh_files("tests/uefi", false, &files)
        var run = Vec(String).new()
        jh_files("tests/run", false, &run)
        for f in run {
            if runs_on_uefi(f.as_str()) { files.push(f.clone()) }
        }
        for f in ["tests/uefi/services.jh", "tests/run/ffi_aggregates.jh"] {
            if self.selected(f) {
                let r = self.uefi_build(f, "aarch64", self.temp("aarch64.efi").as_str())
                self.check(("uefi: aarch64 " + f).as_str(), r)
            }
        }
        let esp = self.temp("esp")
        exec("mkdir", ["-p", (esp.as_str() + "/EFI/BOOT").as_str()])
        // The shell runs startup.nsh: each program with its standard output
        // and error in files, then its status, then it turns QEMU off.
        var script = String.from("@echo -off\r\nfs0:\r\n")
        var names = Vec(String).new()
        var paths = Vec(String).new()
        for f in files {
            if !self.selected(f.as_str()) { continue }
            let name = "t" + names.len().to_string().as_str()
            let out = esp.as_str() + "/" + name.as_str() + ".efi"
            match self.uefi_build(f.as_str(), "x86_64", out.as_str()) {
                Ok(_) => {}
                Err(e) => {
                    self.check(("uefi: " + f.as_str()).as_str(), Err(e))
                    continue
                }
            }
            let n = name.as_str()
            script.push_str(n + ".efi > " + n + ".out 2> " + n + ".err\r\n")
            script.push_str("echo %lasterror% > " + n + ".st\r\n")
            names.push(name)
            paths.push(f.clone())
        }
        script.push_str("reset -s\r\n")
        let qemu = env.get("JIHOO_QEMU")
        let ovmf = env.get("JIHOO_OVMF")
        let shell = env.get("JIHOO_UEFI_SHELL")
        if qemu.is_none() || ovmf.is_none() || shell.is_none() || names.len() == 0 {
            if names.len() > 0 {
                eprintln(
                    "uefi: built, not run: set JIHOO_QEMU, JIHOO_OVMF and JIHOO_UEFI_SHELL (nix develop .#uefi)"
                )
            }
            return
        }
        let boot = esp.as_str() + "/EFI/BOOT/BOOTX64.EFI"
        exec("cp", [shell.unwrap(), boot.as_str()])
        let r = write_file((esp.as_str() + "/startup.nsh").as_str(), script.as_str())
        self.check("uefi: startup.nsh", r)
        let disk = "format=raw,file=fat:rw:" + esp.as_str()
        let console = exec(
            "timeout",
            ["900", qemu.unwrap(), "-accel", "kvm", "-accel", "tcg", "-m", "512", "-nographic",
                "-no-reboot", "-bios", ovmf.unwrap(), "-drive", disk.as_str(), "-net", "none"]
        )
        for i, name in names {
            let r = self.uefi_result(
                paths[i].as_str(),
                (esp.as_str() + "/" + name.as_str()).as_str(),
                console
            )
            self.check(("uefi: " + paths[i].as_str()).as_str(), r)
        }
    }

    // What the program `path` wrote to `stem.out` and its status in
    // `stem.st`, against its `//>` lines and `// exit:`.
    fn uefi_result(self, path: str, stem: str, console: process.Output) -> Result((), String) {
        let src = read_file(path)?
        let lines = directives(src.as_str(), "//>")
        var want = Vec(str).new()
        for d in lines {
            want.push(if d.starts_with(" ") { d[1..] } else { d })
        }
        var code: i64 = 0
        let exits = directives(src.as_str(), "// exit:")
        if exits.len() > 0 {
            code = exits[0].trim().parse_int().unwrap()
        }
        let out = utf16_file((stem + ".out").as_str())
        let st = utf16_file((stem + ".st").as_str())
        if out.is_none() || st.is_none() {
            let text = console.stdout.as_str()
            let tail = if text.len > 4000 { text[text.len - 4000..] } else { text }
            return Err("no result; the console showed:\n" + tail)
        }
        let out = out.unwrap()
        let st = st.unwrap()
        let got = out.as_str().lines()
        let status = parse_hex(st.as_str().trim())
        if !same(got, want) || status != code {
            let err = match utf16_file((stem + ".err").as_str()) {
                Some(e) => e
                None => String.new()
            }
            return Err(
                "expected (exit " + code.to_string().as_str() + "):\n" + join(want).as_str() +
                    "\ngot (exit " + status.to_string().as_str() + "):\n" + join(got).as_str() +
                    "\nstandard error:\n" + err.as_str()
            )
        }
        Ok(())
    }

    // ---- selfhost ----

    fn selfhost(inout self) {
        let next = match self.build_compiler(self.compiler.as_str(), "next") {
            Ok(n) => n
            Err(e) => {
                self.check("selfhost: the compiler builds itself", Err(e))
                return
            }
        }
        var files = Vec(String).new()
        for d in ["compiler", "examples", "lib", "tests"] {
            jh_files(d, true, &files)
        }
        files.push(String.from("tests/selfhost/load/nonexistent.jh"))
        for f in files {
            if !self.selected(f.as_str()) {
                continue
            }
            let src = match fs.read_file(f.as_str()) {
                Ok(s) => s
                Err(_) => String.new()
            }
            for t in ["x86_64", "aarch64"] {
                var a = Vec(str).new()
                a.push("emit-llvm")
                a.push("--target")
                a.push(t)
                words(src.as_str(), "// load-args:", &a)
                a.push(f.as_str())
                let want = exec(self.compiler.as_str(), a.as_slice())
                let got = exec(next.as_str(), a.as_slice())
                var r: Result((), String) = Ok(())
                if want.stdout != got.stdout.as_str() || want.stderr != got.stderr.as_str() || status(
                    want
                ) != status(got) {
                    r = Err(
                        "the compiler it builds writes something else:\n--- tested\n" + want.stderr.as_str() +
                            "--- built by it\n" + got.stderr.as_str()
                    )
                }
                let what = "selfhost: emit-llvm --target " + t + " " + f.as_str()
                self.check(what.as_str(), r)
            }
        }
        fs.remove_file(next.as_str())
    }
}

// Whether a program of tests/run can run as a UEFI program: not those that
// need files, processes, threads, arguments or dynamic libraries, nor the
// variants for another profile.
fn runs_on_uefi(path: str) -> bool {
    let name = stem(path)
    if name.ends_with("_freestanding") {
        return false
    }
    for n in [
        "buffered_utf8",
        "channel_closed",
        "channels",
        "dirs",
        "dyn_threads",
        "ffi",
        "freestanding",
        "files_args",
        "os_io",
        "process",
        "scoped_threads",
        "sync",
        "threads"
    ] {
        if name == n {
            return false
        }
    }
    true
}

// A text file the UEFI shell wrote: UTF-16LE after a byte order mark, as
// UTF-8 without carriage returns.
fn utf16_file(path: str) -> Option(String) {
    let b = match fs.read_bytes(path) {
        Ok(b) => b
        Err(_) => return None
    }
    var s = String.new()
    var i = 0
    if b.len() >= 2 && b[0] == 0xff && b[1] == 0xfe {
        i = 2
    }
    while i + 1 < b.len() {
        let u = b[i] as u32 | (b[i + 1] as u32) << 8
        i += 2
        if u == 13 {
            continue
        }
        if u < 0x80 {
            s.push(u as u8)
        } else if u < 0x800 {
            s.push((0xc0 | u >> 6) as u8)
            s.push((0x80 | u & 0x3f) as u8)
        } else {
            s.push((0xe0 | u >> 12) as u8)
            s.push((0x80 | (u >> 6) & 0x3f) as u8)
            s.push((0x80 | u & 0x3f) as u8)
        }
    }
    Some(s)
}

// `0x1f` and the like, as the shell writes statuses; -1 for anything else.
fn parse_hex(s: str) -> i64 {
    if !s.starts_with("0x") || s.len < 3 {
        return -1
    }
    var n: i64 = 0
    for c in s[2..] {
        let d = if c >= '0' && c <= '9' {
            (c - '0') as i64
        } else if c >= 'a' && c <= 'f' {
            (c - 'a') as i64 + 10
        } else if c >= 'A' && c <= 'F' {
            (c - 'A') as i64 + 10
        } else {
            return -1
        }
        n = n * 16 + d
    }
    n
}

fn main() -> i32 {
    if !fs.read_file("compiler/main.jh").is_ok() {
        eprintln("run tests/runner.jh from the root of the checkout")
        return 2
    }
    let args = env.args()
    var suites = Vec(str).new()
    for i in 1..args.len() {
        suites.push(args[i])
    }
    if suites.len() == 0 {
        for s in ["format", "check", "run", "test", "fail", "examples", "backend", "selfhost", "uefi"] {
            suites.push(s)
        }
    }
    let made = exec("mktemp", ["-d", "-t", "jihoo-tests.XXXXXX"])
    if !made.status.success() {
        eprintln("cannot make a temporary directory: " + made.stderr.as_str())
        return 2
    }
    let filter = match env.get("JIHOO_TEST") {
        Some(f) => f
        None => ""
    }
    var t = Tests {
        compiler: String.new(),
        tmp: made.stdout.as_str().trim().to_string(),
        filter: filter.to_string(),
        failures: Vec(String).new(),
        count: 0
    }
    match env.get("JIHOO_COMPILER") {
        Some(c) => t.compiler = c.to_string()
        None => {
            match t.build_compiler("jihoo", "jihoo") {
                Ok(c) => t.compiler = c
                Err(e) => {
                    eprintln(e)
                    return 1
                }
            }
        }
    }
    for s in suites {
        if s == "format" {
            let r = t.formatting()
            t.check("format: comments, syntax, idempotence and LLVM IR", r)
            let r = t.formatted_sources()
            t.check("format: compiler and standard library are formatted", r)
        } else if s == "check" {
            let r = t.check_command()
            t.check("check: command, targets and no code generation", r)
            let r = t.version_and_help()
            t.check("check: --version and --help", r)
            let r = t.json_diagnostics()
            t.check(
                "check: JSON diagnostics, float digits, the language server and phase timings",
                r
            )
            t.suite_files("tests/run", "check")
            t.suite_files("tests/uefi", "check")
            t.suite_files("examples", "check")
        } else if s == "run" {
            t.suite_files("tests/run", "run")
        } else if s == "test" {
            t.suite_files("tests/test", "test")
            t.std_tests()
        } else if s == "fail" {
            t.suite_files("tests/fail", "fail")
        } else if s == "examples" {
            t.suite_files("examples", "examples")
        } else if s == "backend" {
            t.backend()
        } else if s == "selfhost" {
            t.selfhost()
        } else if s == "uefi" {
            t.uefi()
        } else {
            eprintln("unknown suite " + s + "; the suites are format, check, run, test, fail, examples, backend, selfhost and uefi")
            return 2
        }
    }
    exec("rm", ["-rf", t.tmp.as_str()])
    if t.failures.len() > 0 {
        eprintln(
            t.failures.len().to_string() + " of " + t.count.to_string().as_str() + " tests failed:"
        )
        for f in t.failures {
            eprintln("  " + f.as_str())
        }
        return 1
    }
    println(t.count.to_string() + " tests passed")
    0
}
