// A clause names only the fields the code could: a `Vec`'s length is
// `v.len()` outside `std`.
// error: the field `len` of `Vec(i64)` is private
fn f(v: Vec(i64), i: i64) -> i64
    requires 0 <= i && i < v.len
{
    v[i]
}

fn main() {
    var v = Vec(i64).new()
    v.push(1)
    println(f(v, 0))
}
