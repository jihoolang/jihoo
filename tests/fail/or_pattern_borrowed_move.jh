// Alternatives on a borrowed value bind borrows, which cannot move out.
// error: cannot move the value of this `match` out of its place

enum Msg {
    Text(String)
    Shout(String)
}
fn f(m: Msg) -> String {
    match m {
        Text(t) | Shout(t) => t
    }
}
fn main() { println(f(Msg.Text(String.from("a")))) }
