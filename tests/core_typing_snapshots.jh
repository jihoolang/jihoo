// Regression adapter for the shared production snapshot exporter.
import std.env
import core_snapshot

fn produce(mode: str) -> Result(String, String) {
    let source = core_snapshot.stdin_once()?
    core_snapshot.snapshot(source.as_str(), mode)
}

fn main() -> i32 {
    let args = env.args()
    if args.len() != 2 {
        eprintln(
            "usage: core-typing-snapshots infer|require|both|apply|spine < one-definition.core"
        )
        return 2
    }
    match produce(args[1]) {
        Ok(bytes) => { print(bytes); 0 }
        Err(message) => { eprintln(message); 1 }
    }
}
