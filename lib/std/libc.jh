// C library functions, declared as C has them.

pub extern fn write(fd: i32, buf: *u8, n: i64) -> i64
pub extern fn read(fd: i32, buf: *u8, n: i64) -> i64
pub extern fn open(path: *u8, flags: i32, mode: i32) -> i32
pub extern fn close(fd: i32) -> i32
pub extern fn malloc(n: i64) -> *u8
pub extern fn calloc(n: i64, size: i64) -> *u8
pub extern fn realloc(p: *u8, n: i64) -> *u8
pub extern fn free(p: *u8)
pub extern fn abort() -> never
pub extern fn exit(code: i32) -> never
pub extern fn getenv(name: *u8) -> *u8
pub extern fn strlen(s: *u8) -> i64
pub extern fn memcmp(a: *u8, b: *u8, n: i64) -> i32
pub extern fn printf(fmt: *u8, ...) -> i32
pub extern fn snprintf(buf: *u8, n: i64, fmt: *u8, ...) -> i32
pub extern fn strtod(s: *u8, end: **u8) -> f64
pub extern fn fork() -> i32
pub extern fn execve(path: *u8, argv: **u8, envp: **u8) -> i32
pub extern fn waitpid(pid: i32, status: *i32, options: i32) -> i32
pub extern fn _exit(code: i32) -> never
pub extern fn access(path: *u8, mode: i32) -> i32
pub extern fn pipe2(fds: *i32, flags: i32) -> i32
pub extern fn dup2(fd: i32, to: i32) -> i32
pub extern fn poll(fds: *u8, n: u64, timeout: i32) -> i32
pub extern fn __errno_location() -> *i32
pub extern fn getdents64(fd: i32, buf: *u8, n: i64) -> i64
pub extern fn unlink(path: *u8) -> i32
pub extern fn fcntl(fd: i32, cmd: i32, ...) -> i32
