// The operating system, as UEFI firmware's boot services: consoles for
// standard output and error, and memory pools. There are no files,
// processes or descriptors to poll; those calls fail with ENOSYS.

import std.uefi
// 128-bit division and float conversions, which LLVM calls
import std.rt

// Descriptor 1 is the firmware's output console, 2 its standard error
// console (the output console when it has none).
pub fn write_fd(fd: i32, s: str) -> i64 {
    let st = uefi.system_table()
    let out = unsafe {
        if fd == 1 {
            st.con_out
        } else if fd == 2 {
            if st.std_err == null { st.con_out } else { st.std_err }
        } else {
            null
        }
    }
    if uefi.is_error(uefi.output(out, s)) { -1 } else { s.len }
}

pub fn write_err(s: str) {
    write_fd(2, s)
}

pub unsafe fn read_fd(fd: i32, buf: *u8, n: i64) -> i64 {
    -1
}

pub fn open_read(path: str) -> i32 {
    -1
}

pub fn open_write(path: str) -> i32 {
    -1
}

pub fn close(fd: i32) {}

// Ends the program as returning `code` from `main` would: status 0 for
// 0, otherwise `code` with the error bit set.
pub fn exit(code: i32) -> never {
    uefi.exit(if code == 0 { uefi.SUCCESS } else { uefi.ERROR | code as u32 as u64 })
}

pub fn abort() -> never {
    exit(134)
}

// ---- memory ----
//
// Blocks come from the boot services' pool, which aligns them to eight
// bytes: each is placed at the next 16-byte boundary after a header with
// the pool's address and the block's size. Boot services run on one
// processor, so nothing here takes turns.

unsafe fn pool(n: i64) -> *u8 {
    var p: *u8 = null
    let s = (*uefi.boot_services()).allocate_pool(uefi.LOADER_DATA, n as u64, &p)
    if uefi.is_error(s) {
        write_err("out of memory\n")
        abort()
    }
    p
}

pub unsafe fn alloc_bytes(n: i64) -> *u8 {
    let raw = pool(n + 32)
    let at = (raw as u64 + 31) / 16 * 16
    let p = at as *u8
    *((p - 16) as **u8) = raw
    *((p - 8) as *i64) = n
    p
}

pub unsafe fn free_bytes(p: *u8) {
    if p == null {
        return
    }
    (*uefi.boot_services()).free_pool(*((p - 16) as **u8))
}

pub unsafe fn realloc_bytes(p: *u8, n: i64) -> *u8 {
    let old = *((p - 8) as *i64)
    if n <= old {
        return p
    }
    let q = alloc_bytes(n)
    mem_copy(q, p, old)
    free_bytes(p)
    q
}

// A file descriptor to wait on, and what happened to it.
pub struct PollFd {
    pub fd: i32
    pub events: i16
    pub revents: i16
}

pub fn is_executable(path: str) -> bool {
    false
}

pub unsafe fn read_dir_fd(fd: i32, buf: *u8, n: i64) -> i64 {
    -1
}

pub fn remove_file(path: str) -> bool {
    false
}

// ---- calls that report failure as minus the error number ----
//
// What `std.os` builds on. Standard output and error can be written; the
// rest fails with ENOSYS.

const ENOSYS: i64 = 38

pub unsafe fn read_raw(fd: i32, buf: *u8, n: i64) -> i64 {
    0 - ENOSYS
}

pub unsafe fn write_raw(fd: i32, buf: *u8, n: i64) -> i64 {
    if fd != 1 && fd != 2 {
        return 0 - ENOSYS
    }
    let r = write_fd(fd, make_str(buf, n))
    if r < 0 { 0 - ENOSYS } else { r }
}

pub fn open_raw(path: str, flags: i32, mode: i32) -> i64 {
    0 - ENOSYS
}

pub fn close_raw(fd: i32) -> i64 {
    0 - ENOSYS
}

pub fn fcntl_raw(fd: i32, cmd: i32, arg: i64) -> i64 {
    0 - ENOSYS
}

pub unsafe fn poll_raw(fds: *PollFd, n: i64, timeout_ms: i64) -> i64 {
    0 - ENOSYS
}

pub fn pipe_raw(inout fds: [i32; 2]) -> i64 {
    0 - ENOSYS
}

pub unsafe fn read_dir_raw(fd: i32, buf: *u8, n: i64) -> i64 {
    0 - ENOSYS
}

pub fn unlink_raw(path: str) -> i64 {
    0 - ENOSYS
}

pub unsafe fn spawn_raw(path: *u8, argv: **u8, envp: **u8, stdio: [i32; 3], report: i32) -> i64 {
    0 - ENOSYS
}

pub fn wait_raw(pid: i32, inout status: i32) -> i64 {
    0 - ENOSYS
}
