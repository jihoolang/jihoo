// Formatting several values with a pattern:
//
//     fmt.println("{} has {:>6.2} ({:+})", (name, total, change))
//
// The values are a tuple, or one value that is not a tuple. Each `{}` takes
// the next value, `{2}` the value at that index; `{{` and `}}` are braces.
// After a `:` comes a specification, in this order, each part optional:
//
//     [[fill]align][+][#][0][width][.precision][kind]
//
// `align` is `<`, `>` or `^` (centered), with any one character as `fill`;
// numbers align right and other values left. `+` shows the sign of
// positive numbers. `0` pads numbers with zeros after their sign and
// prefix. `width` counts characters (UTF-8 scalar values). `precision` is
// the digits after the point of a float, or the most characters of a
// string. `kind` is `x`, `X`, `o` or `b` for integers in base 16, 8 or 2
// (`#` adds `0x`, `0o` or `0b`), and `e` for a float with an exponent.
//
// Values format through the `Format` trait: integers, floats, `bool`, `str`
// and `String` have it, and any other type with `Show` uses that, padded.
// A pattern written as a literal is checked while compiling: a malformed
// one, a placeholder without a value, or a base or exponent for a value
// that is not a number, is a compile error. A pattern made while the
// program runs is checked then, and stops the program (`panic`).

import std.float
import std.sys
import std.utf8

pub struct Spec {
    // A Unicode scalar value.
    pub fill: u32
    // `<`, `>`, `^`, or 0 for the value's default.
    pub align: u8
    pub plus: bool
    pub alternate: bool
    pub zero: bool
    pub width: i64
    // -1 when not given.
    pub precision: i64
    // 0, `x`, `X`, `o`, `b` or `e`.
    pub kind: u8
}

impl Spec {
    pub fn default() -> Spec {
        Spec {
            fill: 32,
            align: 0,
            plus: false,
            alternate: false,
            zero: false,
            width: 0,
            precision: -1,
            kind: 0
        }
    }
}

pub trait Format {
    fn format(self, inout out: String, spec: Spec)
}

// `body` padded to the spec's width; `right` is the default alignment.
pub fn pad(inout out: String, body: str, spec: Spec, right: bool) {
    let n = chars(body)
    if n >= spec.width {
        out.push_str(body)
        return
    }
    let gap = spec.width - n
    let align = if spec.align != 0 { spec.align } else if right { '>' } else { '<' }
    let before = if align == '>' { gap } else if align == '^' { gap / 2 } else { 0 }
    for _ in 0..before { push_char(&out, spec.fill) }
    out.push_str(body)
    for _ in 0..gap - before { push_char(&out, spec.fill) }
}

// A scalar value as UTF-8.
fn push_char(inout out: String, c: u32) {
    if c < 0x80 {
        out.push(c as u8)
    } else if c < 0x800 {
        out.push((0xc0 | c >> 6) as u8)
        out.push((0x80 | c & 63) as u8)
    } else if c < 0x10000 {
        out.push((0xe0 | c >> 12) as u8)
        out.push((0x80 | c >> 6 & 63) as u8)
        out.push((0x80 | c & 63) as u8)
    } else {
        out.push((0xf0 | c >> 18) as u8)
        out.push((0x80 | c >> 12 & 63) as u8)
        out.push((0x80 | c >> 6 & 63) as u8)
        out.push((0x80 | c & 63) as u8)
    }
}

// The number of UTF-8 scalar values: bytes that do not continue one.
pub fn chars(s: str) -> i64 {
    var n = 0
    for b in s {
        if b & 0xc0 != 0x80 { n += 1 }
    }
    n
}

// A number's sign (with `+`), prefix and digits, padded; zeros go between
// the prefix and the digits.
fn pad_number(inout out: String, negative: bool, prefix: str, digits: str, spec: Spec) {
    var head = String.new()
    if negative {
        head.push('-')
    } else if spec.plus {
        head.push('+')
    }
    head.push_str(prefix)
    if spec.zero && spec.align == 0 {
        let len = head.len() + digits.len
        out.push_str(head.as_str())
        for _ in 0..spec.width - len { out.push('0') }
        out.push_str(digits)
        return
    }
    head.push_str(digits)
    pad(&out, head.as_str(), spec, true)
}

impl(T: Int) Format for T {
    fn format(self, inout out: String, spec: Spec) {
        let base: u128 = if spec.kind == 'x' || spec.kind == 'X' {
            16
        } else if spec.kind == 'o' {
            8
        } else if spec.kind == 'b' {
            2
        } else {
            10
        }
        // Other bases show the bits: two's complement for negative values.
        var negative = self < (0 as T)
        var n: u128 = if negative { 0 -% (self as i128) as u128 } else { self as u128 }
        if negative && base != 10 {
            negative = false
            n = self as u128
            if size_of(T) < 16 { n = n & ((1 as u128 << (size_of(T) * 8) as u128) - 1) }
        }
        let digits = if spec.kind == 'X' { "0123456789ABCDEF" } else { "0123456789abcdef" }
        var buf = [0 as u8; 128]
        var i = 128
        loop {
            i -= 1
            buf[i] = digits[(n % base) as i64]
            n = n / base
            if n == 0 { break }
        }
        let prefix = if !spec.alternate {
            ""
        } else if base == 16 {
            "0x"
        } else if base == 8 {
            "0o"
        } else if base == 2 {
            "0b"
        } else {
            ""
        }
        pad_number(&out, negative, prefix, unsafe { make_str(&buf[i], 128 - i) }, spec)
    }
}

impl Format for f64 {
    fn format(self, inout out: String, spec: Spec) {
        format_float(&out, float.parts_f64(self), spec)
    }
}

impl Format for f32 {
    fn format(self, inout out: String, spec: Spec) {
        format_float(&out, float.parts_f32(self), spec)
    }
}

fn format_float(inout out: String, p: float.Parts, spec: Spec) {
    var digits = String.new()
    var unsigned = p
    unsigned.negative = false
    if spec.kind == 'e' {
        if spec.precision >= 0 {
            float.write_exponent(&digits, unsigned, spec.precision)
        } else if !float.special(&digits, unsigned) {
            float.write_scientific(&digits, float.shortest(unsigned))
        }
    } else if spec.precision >= 0 {
        float.write_fixed(&digits, unsigned, spec.precision)
    } else {
        float.write_shortest(&digits, unsigned)
    }
    // NaN has no sign, and is not padded with zeros.
    if p.special && p.f != 0 {
        var s = spec
        s.zero = false
        pad(&out, digits.as_str(), s, true)
        return
    }
    pad_number(&out, p.negative, "", digits.as_str(), spec)
}

impl Format for str {
    fn format(self, inout out: String, spec: Spec) {
        if spec.precision < 0 {
            pad(&out, self, spec, false)
            return
        }
        // At most `precision` characters.
        var end = 0
        var n = 0
        while end < self.len {
            if self[end] & 0xc0 != 0x80 {
                if n == spec.precision { break }
                n += 1
            }
            end += 1
        }
        pad(&out, self[0..end], spec, false)
    }
}

impl Format for String {
    fn format(self, inout out: String, spec: Spec) {
        self.as_str().format(&out, spec)
    }
}

impl Format for bool {
    fn format(self, inout out: String, spec: Spec) {
        pad(&out, if self { "true" } else { "false" }, spec, false)
    }
}

impl(T: Show) Format for T {
    fn format(self, inout out: String, spec: Spec) {
        var s = String.new()
        self.show(&s)
        pad(&out, s.as_str(), spec, false)
    }
}

// ---- patterns ----

// Appends the formatted pattern to `out`.
#[literal_check(pattern, check_pattern)]
pub fn write(comptime T: type, inout out: String, pattern: str, values: T) {
    var next = 0
    var i = 0
    while i < pattern.len {
        let b = pattern[i]
        if b == '}' {
            if i + 1 < pattern.len && pattern[i + 1] == '}' {
                out.push('}')
                i += 2
                continue
            }
            bad(pattern, "an unmatched `}`")
        }
        if b != '{' {
            out.push(b)
            i += 1
            continue
        }
        if i + 1 < pattern.len && pattern[i + 1] == '{' {
            out.push('{')
            i += 2
            continue
        }
        // `{index:spec}`
        var j = i + 1
        var index = -1
        while j < pattern.len && is_digit(pattern[j]) {
            index = if index < 0 { 0 } else { index * 10 }
            index += (pattern[j] - '0') as i64
            j += 1
        }
        var spec = Spec.default()
        if j < pattern.len && pattern[j] == ':' {
            j = parse_spec(pattern, j + 1, &spec)
            if j < 0 { bad(pattern, "a `.` without a precision") }
        }
        if j >= pattern.len || pattern[j] != '}' { bad(pattern, "an unclosed `{`") }
        if index < 0 {
            index = next
            next += 1
        }
        format_at(&out, values, index, spec, pattern)
        i = j + 1
    }
}

// Formats value `index` of the tuple, or the one value.
fn format_at(comptime T: type, inout out: String, values: T, index: i64, spec: Spec, pattern: str) {
    inline if is_tuple(T) {
        if index >= field_count(T) { bad(pattern, "more placeholders than values") }
        inline for k in 0..field_count(T) {
            if k == index { field(values, k).format(&out, spec) }
        }
    } else {
        if index > 0 { bad(pattern, "more placeholders than values") }
        values.format(&out, spec)
    }
}

// Reads `[[fill]align][+][#][0][width][.precision][kind]` from `at`; where
// it ends, or -1 for a `.` without a precision.
fn parse_spec(pattern: str, at: i64, inout spec: Spec) -> i64 {
    var j = at
    let p = pattern
    // A fill character, then an alignment.
    let width = if j >= p.len {
        1
    } else if p[j] < 0xc0 {
        1
    } else if p[j] < 0xe0 {
        2
    } else if p[j] < 0xf0 {
        3
    } else {
        4
    }
    if j + width < p.len && is_align(p[j + width]) && p[j] != '}' {
        spec.fill = utf8.decode(p, j).ok().unwrap_or((p[j] as u32, 1)).0
        spec.align = p[j + width]
        j += width + 1
    } else if j < p.len && is_align(p[j]) {
        spec.align = p[j]
        j += 1
    }
    if j < p.len && p[j] == '+' {
        spec.plus = true
        j += 1
    }
    if j < p.len && p[j] == '#' {
        spec.alternate = true
        j += 1
    }
    if j < p.len && p[j] == '0' {
        spec.zero = true
        j += 1
    }
    while j < p.len && is_digit(p[j]) {
        spec.width = spec.width * 10 + (p[j] - '0') as i64
        j += 1
    }
    if j < p.len && p[j] == '.' {
        j += 1
        if j >= p.len || !is_digit(p[j]) { return -1 }
        spec.precision = 0
        while j < p.len && is_digit(p[j]) {
            spec.precision = spec.precision * 10 + (p[j] - '0') as i64
            j += 1
        }
    }
    if j < p.len && (p[j] == 'x' || p[j] == 'X' || p[j] == 'o' || p[j] == 'b' || p[j] == 'e') {
        spec.kind = p[j]
        j += 1
    }
    j
}

// What is wrong with a pattern for values of type `T`, or "": what the
// compiler runs for a literal pattern (`#[literal_check]`), with the
// messages `write` would panic with.
pub fn check_pattern(comptime T: type, pattern: str) -> String {
    var names = Vec(str).new()
    inline if is_tuple(T) {
        inline for k in 0..field_count(T) {
            names.push(type_name(field_type(T, k)))
        }
    } else {
        names.push(type_name(T))
    }
    var next = 0
    var i = 0
    while i < pattern.len {
        let b = pattern[i]
        if b == '}' {
            if i + 1 < pattern.len && pattern[i + 1] == '}' {
                i += 2
                continue
            }
            return pattern_error(pattern, "an unmatched `}`")
        }
        if b != '{' {
            i += 1
            continue
        }
        if i + 1 < pattern.len && pattern[i + 1] == '{' {
            i += 2
            continue
        }
        var j = i + 1
        var index = -1
        while j < pattern.len && is_digit(pattern[j]) {
            index = if index < 0 { 0 } else { index * 10 }
            index += (pattern[j] - '0') as i64
            j += 1
        }
        var spec = Spec.default()
        if j < pattern.len && pattern[j] == ':' {
            j = parse_spec(pattern, j + 1, &spec)
            if j < 0 { return pattern_error(pattern, "a `.` without a precision") }
        }
        if j >= pattern.len || pattern[j] != '}' {
            return pattern_error(pattern, "an unclosed `{`")
        }
        if index < 0 {
            index = next
            next += 1
        }
        if index >= names.len() {
            var m = String.from("more placeholders than values: `")
            m.push_str(pattern[i..j + 1])
            m.push_str("` takes value ")
            index.show(&m)
            m.push_str(" (from 0), but ")
            names.len().show(&m)
            m.push_str(if names.len() == 1 { " value is given" } else { " values are given" })
            return pattern_error(pattern, m.as_str())
        }
        let name = names[index]
        let int_kind = spec.kind == 'x' || spec.kind == 'X' || spec.kind == 'o' || spec.kind == 'b'
        if (int_kind && !is_int_name(name)) || (spec.kind == 'e' && name != "f64" && name != "f32") {
            var m = "format pattern `" + pattern + "`: `"
            m.push_str(pattern[i..j + 1])
            m.push_str(if int_kind { "` formats an integer" } else { "` formats a float" })
            m.push_str(", but value ")
            index.show(&m)
            m.push_str(" is a `")
            m.push_str(name)
            m.push('`')
            return m
        }
        i = j + 1
    }
    String.new()
}

fn pattern_error(pattern: str, what: str) -> String {
    "format pattern `" + pattern + "` has " + what
}

fn is_int_name(n: str) -> bool {
    n == "i8" || n == "i16" || n == "i32" || n == "i64" || n == "i128" || n == "u8" ||
        n == "u16" || n == "u32" || n == "u64" || n == "u128"
}

fn is_align(b: u8) -> bool {
    b == '<' || b == '>' || b == '^'
}

fn bad(pattern: str, what: str) -> never {
    panic(("format pattern `" + pattern + "` has " + what).as_str())
}

#[literal_check(pattern, check_pattern)]
pub fn format(comptime T: type, pattern: str, values: T) -> String {
    var out = String.new()
    write(&out, pattern, values)
    out
}

#[literal_check(pattern, check_pattern)]
pub fn print(comptime T: type, pattern: str, values: T) {
    let s = format(pattern, values)
    sys.write_fd(1, s.as_str())
}

#[literal_check(pattern, check_pattern)]
pub fn println(comptime T: type, pattern: str, values: T) {
    var s = format(pattern, values)
    s.push('\n')
    sys.write_fd(1, s.as_str())
}

#[literal_check(pattern, check_pattern)]
pub fn eprintln(comptime T: type, pattern: str, values: T) {
    var s = format(pattern, values)
    s.push('\n')
    sys.write_fd(2, s.as_str())
}
