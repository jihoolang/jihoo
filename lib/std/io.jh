// Printing and reading.

import std.os
import std.sys
import std.utf8

pub trait BufRead {
    // Append one UTF-8 line, including '\n'. Zero means end of input.
    // On error, out is restored to its original length; invalid UTF-8 is
    // `InvalidData`.
    fn read_line(inout self, inout out: String) -> Result(i64, os.Error)
}

pub struct StrReader {
    text: str
    pos: i64
}

impl StrReader {
    pub fn new(text: str) -> StrReader {
        StrReader { text, pos: 0 }
    }
}

impl BufRead for StrReader {
    fn read_line(inout self, inout out: String) -> Result(i64, os.Error) {
        let start = self.pos
        while self.pos < self.text.len {
            let b = self.text[self.pos]
            self.pos += 1
            if b == '\n' { break }
        }
        let line = self.text[start..self.pos]
        if utf8.validate(line).is_err() { return Err(os.Error.InvalidData) }
        out.push_str(line)
        Ok(self.pos - start)
    }
}

// Owns a file (or borrows a standard stream) and a buffer reused between
// lines.
pub struct BufReader {
    file: os.File
    buffer: Vec(u8)
    size: i64
    pos: i64
    end: i64
}

impl BufReader {
    pub fn open(path: str) -> Result(BufReader, os.Error) {
        Self.with_capacity(path, 65536)
    }

    pub fn with_capacity(path: str, capacity: i64) -> Result(BufReader, os.Error) {
        if capacity <= 0 { return Err(os.Error.InvalidInput) }
        let file = os.File.open(path)?
        Ok(BufReader {
            file,
            buffer: Vec(u8).with_capacity(capacity),
            size: capacity,
            pos: 0,
            end: 0
        })
    }

    // Reads lines from an open file, such as `os.stdin()`.
    pub fn new(sink file: os.File) -> BufReader {
        BufReader { file, buffer: Vec(u8).with_capacity(65536), size: 65536, pos: 0, end: 0 }
    }

    fn append_line(inout self, inout out: String) -> Result((), os.Error) {
        loop {
            if self.pos == self.end {
                self.buffer.clear()
                match self.file.read(&self.buffer, self.size) {
                    Ok(n) => {
                        self.pos = 0
                        self.end = n
                        if n == 0 { return Ok(()) }
                    }
                    Err(Interrupted) => continue
                    Err(e) => return Err(e)
                }
            }
            let start = self.pos
            while self.pos < self.end {
                let b = self.buffer[self.pos]
                self.pos += 1
                if b == '\n' { break }
            }
            let last = self.buffer[self.pos - 1]
            let part = unsafe { make_str(&self.buffer[start], self.pos - start) }
            out.push_str(part)
            if last == '\n' { return Ok(()) }
        }
    }
}

impl BufRead for BufReader {
    fn read_line(inout self, inout out: String) -> Result(i64, os.Error) {
        let start = out.len()
        var result = self.append_line(&out)
        if result.is_ok() && utf8.validate(out.as_str()[start..]).is_err() {
            result = Err(os.Error.InvalidData)
        }
        match result {
            Ok(_) => Ok(out.len() - start)
            Err(e) => {
                out.bytes.truncate(start)
                Err(e)
            }
        }
    }
}

pub fn print(comptime T: Show, x: T) {
    var s = String.new()
    x.show(&s)
    sys.write_fd(1, s.as_str())
}

pub fn println(comptime T: Show, x: T) {
    var s = String.new()
    x.show(&s)
    s.push('\n')
    sys.write_fd(1, s.as_str())
}

pub fn eprintln(comptime T: Show, x: T) {
    var s = String.new()
    x.show(&s)
    s.push('\n')
    sys.write_fd(2, s.as_str())
}
