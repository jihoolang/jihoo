// Files, whole. Failures are `os.Error`s.

import std.os
import std.sys

// The whole file as text. Its bytes are not checked to be UTF-8; see
// `std.utf8.validate`.
pub fn read_file(path: str) -> Result(String, os.Error) {
    Ok(String { bytes: read_bytes(path)? })
}

// The whole file.
pub fn read_bytes(path: str) -> Result(Vec(u8), os.Error) {
    var f = os.File.open(path)?
    var out = Vec(u8).new()
    f.read_to_end(&out)?
    Ok(out)
}

// Replaces the file's contents with `text`, creating it if missing.
pub fn write_file(path: str, text: str) -> Result((), os.Error) {
    write_bytes(path, text.as_bytes())
}

pub fn write_bytes(path: str, data: [u8]) -> Result((), os.Error) {
    var f = os.File.create(path)?
    f.write_all(data)
}

// Adds `data` at the file's end, creating it if missing.
pub fn append_bytes(path: str, data: [u8]) -> Result((), os.Error) {
    var f = os.File.append(path)?
    f.write_all(data)
}

pub fn remove_file(path: str) -> Result((), os.Error) {
    for b in path {
        if b == 0 { return Err(os.Error.InvalidInput) }
    }
    let r = sys.unlink_raw(path)
    if r < 0 { return Err(os.Error.from_code((0 - r) as i32)) }
    Ok(())
}

// The names in a directory, sorted, without `.` and `..`.
pub fn read_dir(path: str) -> Result(Vec(String), os.Error) {
    let dir = os.File.open(path)?
    var names = Vec(String).new()
    var buf = [0 as u8; 8192]
    loop {
        let n = unsafe { sys.read_dir_raw(dir.fd(), &buf[0], 8192) }
        if n == -4 { continue }
        if n < 0 { return Err(os.Error.from_code((0 - n) as i32)) }
        if n == 0 {
            break
        }
        // Each record: inode (8 bytes), offset (8), its length (2), type
        // (1), then the name and a 0.
        var at = 0
        while at < n {
            let size = buf[at + 16] as i64 | (buf[at + 17] as i64) << 8
            var end = at + 19
            while buf[end] != 0 {
                end += 1
            }
            let name = unsafe { make_str(&buf[at + 19], end - at - 19) }
            if name != "." && name != ".." {
                names.push(name.to_string())
            }
            at += size
        }
    }
    sort(&names)
    Ok(names)
}
