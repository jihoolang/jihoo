// The program's environment: its arguments.

// The command-line arguments, the program's name first.
pub fn args() -> Vec(str) {
    var out = Vec(str).new()
    let n = argc()
    let v = argv()
    for i in 0..n {
        unsafe {
            let p = *(v + i)
            out.push(make_str(p, c_len(p)))
        }
    }
    out
}

unsafe fn c_len(p: *u8) -> i64 {
    var n = 0
    while *(p + n) != 0 {
        n += 1
    }
    n
}
