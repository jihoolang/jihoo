// The program's environment: its arguments.

// The command-line arguments, the program's name first.
pub fn args() -> Vec(str) {
    var out = Vec(str).new()
    let n = argc()
    let v = argv()
    for i in 0..n {
        unsafe {
            let p = *(v + i)
            out.push(make_str(p, c_len(p)))
        }
    }
    out
}

unsafe fn c_len(p: *u8) -> i64 {
    var n = 0
    while *(p + n) != 0 {
        n += 1
    }
    n
}

// The environment as C has it: after the arguments' null pointer.
pub fn environ() -> **u8 {
    unsafe { argv() + argc() + 1 }
}

// The value of an environment variable.
pub fn get(name: str) -> Option(str) {
    unsafe {
        let env = environ()
        var i = 0
        while *(env + i) != null {
            let p = *(env + i)
            let s = make_str(p, c_len(p))
            if s.len > name.len && s[name.len] == '=' && s[0..name.len] == name {
                return Some(s[name.len + 1..])
            }
            i += 1
        }
    }
    None
}
