// The operating system, through libc.

import std.libc

pub fn write_fd(fd: i32, s: str) -> i64 {
    var done = 0
    while done < s.len {
        let n = unsafe { libc.write(fd, s.ptr + done, s.len - done) }
        if n <= 0 {
            return -1
        }
        done += n
    }
    done
}

pub fn write_err(s: str) {
    write_fd(2, s)
}

pub unsafe fn read_fd(fd: i32, buf: *u8, n: i64) -> i64 {
    libc.read(fd, buf, n)
}

pub unsafe fn alloc_bytes(n: i64) -> *u8 {
    let p = libc.malloc(n)
    if p == null {
        write_err("out of memory\n")
        libc.abort()
    }
    p
}

pub unsafe fn realloc_bytes(p: *u8, n: i64) -> *u8 {
    let q = libc.realloc(p, n)
    if q == null {
        write_err("out of memory\n")
        libc.abort()
    }
    q
}

pub unsafe fn free_bytes(p: *u8) {
    libc.free(p)
}

pub fn abort() -> never {
    unsafe { libc.abort() }
}

pub fn exit(code: i32) -> never {
    unsafe { libc.exit(code) }
}

// A path as a C string, for the system.
fn c_path(path: str) -> Vec(u8) {
    var v = Vec(u8).with_capacity(path.len + 1)
    for b in path {
        v.push(b)
    }
    v.push(0)
    v
}

pub fn open_read(path: str) -> i32 {
    let p = c_path(path)
    unsafe { libc.open(p.ptr, 0, 0) }
}

pub fn open_write(path: str) -> i32 {
    let p = c_path(path)
    // O_WRONLY | O_CREAT | O_TRUNC
    unsafe { libc.open(p.ptr, 0x241, 0o644) }
}

pub fn close(fd: i32) {
    unsafe { libc.close(fd) }
}

// Starts a program in a new process; the child's pid, or -1.
pub unsafe fn spawn(path: *u8, argv: **u8, envp: **u8) -> i32 {
    spawn_io(path, argv, envp, [-1, -1, -1])
}

// Starts a program with `stdio[i]` as its file descriptor `i` (-1 keeps
// this process's own); the child's pid, or -1.
pub unsafe fn spawn_io(path: *u8, argv: **u8, envp: **u8, stdio: [i32; 3]) -> i32 {
    let pid = libc.fork()
    if pid == 0 {
        for i in 0..3 {
            if stdio[i] >= 0 && stdio[i] != i as i32 {
                libc.dup2(stdio[i], i as i32)
            }
        }
        for i in 0..3 {
            if stdio[i] > 2 {
                libc.close(stdio[i])
            }
        }
        libc.execve(path, argv, envp)
        libc._exit(127)
    }
    pid
}

// A pipe, as (read end, write end); both ends close when a program is
// started.
pub fn pipe() -> Option((i32, i32)) {
    var fds = [0 as i32; 2]
    // O_CLOEXEC
    if unsafe { libc.pipe2(&fds[0], 0x80000) } < 0 {
        return None
    }
    Some((fds[0], fds[1]))
}

// A file descriptor to wait on, and what happened to it.
pub struct PollFd {
    pub fd: i32
    pub events: i16
    pub revents: i16
}

// Waits until something happens to one of `n` descriptors (C's `poll`, no
// timeout); how many, or -1.
pub unsafe fn poll(fds: *PollFd, n: i64) -> i32 {
    loop {
        let r = libc.poll(fds as *u8, n as u64, -1)
        // EINTR: a signal came first
        if r >= 0 || *libc.__errno_location() != 4 {
            return r
        }
    }
}

// Waits for a child; its raw wait status, or -1.
pub fn wait(pid: i32) -> i32 {
    var status: i32 = 0
    let r = unsafe { libc.waitpid(pid, &status, 0) }
    if r < 0 { -1 } else { status }
}

pub fn is_executable(path: str) -> bool {
    let p = c_path(path)
    // X_OK
    unsafe { libc.access(p.ptr, 1) == 0 }
}

// Reads directory entries (Linux's `linux_dirent64` records) into `buf`;
// the bytes read, 0 at the end, or -1.
pub unsafe fn read_dir_fd(fd: i32, buf: *u8, n: i64) -> i64 {
    libc.getdents64(fd, buf, n)
}

// Removes a file; whether it could.
pub fn remove_file(path: str) -> bool {
    let p = c_path(path)
    unsafe { libc.unlink(p.ptr) == 0 }
}
