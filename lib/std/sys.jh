// The operating system, through libc.

import std.libc

pub fn write_fd(fd: i32, s: str) -> i64 {
    var done = 0
    while done < s.len {
        let n = unsafe { libc.write(fd, s.ptr + done, s.len - done) }
        if n <= 0 {
            return -1
        }
        done += n
    }
    done
}

pub fn write_err(s: str) {
    write_fd(2, s)
}

pub unsafe fn read_fd(fd: i32, buf: *u8, n: i64) -> i64 {
    libc.read(fd, buf, n)
}

pub unsafe fn alloc_bytes(n: i64) -> *u8 {
    let p = libc.malloc(n)
    if p == null {
        write_err("out of memory\n")
        libc.abort()
    }
    p
}

pub unsafe fn realloc_bytes(p: *u8, n: i64) -> *u8 {
    let q = libc.realloc(p, n)
    if q == null {
        write_err("out of memory\n")
        libc.abort()
    }
    q
}

pub unsafe fn free_bytes(p: *u8) {
    libc.free(p)
}

pub fn abort() -> never {
    unsafe { libc.abort() }
}

pub fn exit(code: i32) -> never {
    unsafe { libc.exit(code) }
}

// A path as a C string, for the system.
fn c_path(path: str) -> Vec(u8) {
    var v = Vec(u8).with_capacity(path.len + 1)
    for b in path {
        v.push(b)
    }
    v.push(0)
    v
}

pub fn open_read(path: str) -> i32 {
    let p = c_path(path)
    unsafe { libc.open(p.ptr, 0, 0) }
}

pub fn open_write(path: str) -> i32 {
    let p = c_path(path)
    // O_WRONLY | O_CREAT | O_TRUNC
    unsafe { libc.open(p.ptr, 0x241, 0o644) }
}

pub fn close(fd: i32) {
    unsafe { libc.close(fd) }
}

// A file descriptor to wait on, and what happened to it.
pub struct PollFd {
    pub fd: i32
    pub events: i16
    pub revents: i16
}

pub fn is_executable(path: str) -> bool {
    let p = c_path(path)
    // X_OK
    unsafe { libc.access(p.ptr, 1) == 0 }
}

// Reads directory entries (Linux's `linux_dirent64` records) into `buf`;
// the bytes read, 0 at the end, or -1.
pub unsafe fn read_dir_fd(fd: i32, buf: *u8, n: i64) -> i64 {
    libc.getdents64(fd, buf, n)
}

// Removes a file; whether it could.
pub fn remove_file(path: str) -> bool {
    let p = c_path(path)
    unsafe { libc.unlink(p.ptr) == 0 }
}

// ---- calls that report failure as minus the error number ----
//
// `std.os` builds on these: each makes one system call and returns its
// result, or `-errno` when it fails, the same in both profiles.

fn result(r: i64) -> i64 {
    if r < 0 { 0 - unsafe { *libc.__errno_location() } as i64 } else { r }
}

pub unsafe fn read_raw(fd: i32, buf: *u8, n: i64) -> i64 {
    result(libc.read(fd, buf, n))
}

pub unsafe fn write_raw(fd: i32, buf: *u8, n: i64) -> i64 {
    result(libc.write(fd, buf, n))
}

// `path` must not contain a zero byte.
pub fn open_raw(path: str, flags: i32, mode: i32) -> i64 {
    let p = c_path(path)
    result(unsafe { libc.open(p.ptr, flags, mode) } as i64)
}

pub fn close_raw(fd: i32) -> i64 {
    result(unsafe { libc.close(fd) } as i64)
}

pub fn fcntl_raw(fd: i32, cmd: i32, arg: i64) -> i64 {
    result(unsafe { libc.fcntl(fd, cmd, arg) } as i64)
}

// Waits at most `timeout_ms` milliseconds (forever when negative) for
// something to happen to one of `n` descriptors, once: a signal makes it
// return `-EINTR`.
pub unsafe fn poll_raw(fds: *PollFd, n: i64, timeout_ms: i64) -> i64 {
    result(libc.poll(fds as *u8, n as u64, timeout_ms as i32) as i64)
}

// `(read end, write end)`, both closed when a program is started.
pub fn pipe_raw(inout fds: [i32; 2]) -> i64 {
    // O_CLOEXEC
    result(unsafe { libc.pipe2(&fds[0], 0x80000) } as i64)
}

pub unsafe fn read_dir_raw(fd: i32, buf: *u8, n: i64) -> i64 {
    result(libc.getdents64(fd, buf, n))
}

pub fn unlink_raw(path: str) -> i64 {
    let p = c_path(path)
    result(unsafe { libc.unlink(p.ptr) } as i64)
}

// Starts a program in a new process with `stdio[i]` as its file descriptor
// `i` (-1 keeps this process's own); the child's pid, or `-errno` when it
// cannot fork. When `execve` fails, the child writes its error number to
// `report` (4 bytes, little-endian) and exits with 127; `report` should be
// above 2 and close on exec, so that a started program closes it.
pub unsafe fn spawn_raw(path: *u8, argv: **u8, envp: **u8, stdio: [i32; 3], report: i32) -> i64 {
    let pid = libc.fork()
    if pid == 0 {
        for i in 0..3 {
            if stdio[i] >= 0 && stdio[i] != i as i32 {
                libc.dup2(stdio[i], i as i32)
            }
        }
        for i in 0..3 {
            if stdio[i] > 2 {
                libc.close(stdio[i])
            }
        }
        libc.execve(path, argv, envp)
        let code = *libc.__errno_location()
        var b = [code as u8, (code >> 8) as u8, (code >> 16) as u8, (code >> 24) as u8]
        libc.write(report, &b[0], 4)
        libc._exit(127)
    }
    result(pid as i64)
}

// Waits for a child once (a signal makes it return `-EINTR`); its pid, the
// raw wait status in `status`.
pub fn wait_raw(pid: i32, inout status: i32) -> i64 {
    result(unsafe { libc.waitpid(pid, &status, 0) } as i64)
}
