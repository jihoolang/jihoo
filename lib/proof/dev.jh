// Building proofs in a theory over proof.ring: equational steps,
// unfolding the model's functions, inequalities, and inversion case by
// case. Not trusted.
import proof.cert
import proof.ring

pub fn tm(f: str, a: [cert.Tm]) -> cert.Tm {
    var xs = Vec(cert.Tm).new()
    for t in a { xs.push(t.clone()) }
    cert.app(f, xs)
}

fn ev(t: cert.Tm, x: cert.Tm) -> cert.Tm { tm("ev", [t.clone(), x.clone()]) }

fn look(x: cert.Tm, n: cert.Tm) -> cert.Tm { tm("look", [x.clone(), n.clone()]) }

pub fn one(r: cert.Ref) -> Vec(cert.Ref) {
    var out = Vec(cert.Ref).new()
    out.push(r.clone())
    out
}

pub struct Dev {
    pub k: cert.Cert
    pub ring: ring.Ring
    pub rules: cert.Rules
}

impl Dev {
    pub fn hyp(inout self, j: cert.Tm) -> cert.Ref {
        let n = self.k.hyp(j.clone())
        self.k.plain(n)
    }

    pub fn step(inout self, rule: str, refs: [cert.Ref], j: cert.Tm) -> cert.Ref {
        let n = self.k.step_refs(rule, refs, j.clone())
        self.k.plain(n)
    }

    // e = e', unfolding the theory's functions where their arguments are
    // constructors, and replacing each left side in `eqs` by its right.
    pub fn unfold(inout self, e: cert.Tm, eqs: [cert.Ref]) -> cert.Ref {
        for p in eqs {
            if ring.lhs(p) == e {
                let rest = self.unfold(ring.rhs(p), eqs)
                return ring.trans(&self.k, p, rest)
            }
        }
        if e.is("val") && e.arg(0).is("Lin.mk") {
            let l = e.arg(0)
            let j = ring.eq(e, ring.add(ev(l.arg(0), e.arg(1)), l.arg(1)))
            let p = ring.axiom(&self.k, "val.lin", j)
            let rest = self.unfold(ring.rhs(p), eqs)
            return ring.trans(&self.k, p, rest)
        }
        if e.is("ev") && e.arg(0).is("Vec<<i64,i128>>.nil") {
            let p = ring.axiom(&self.k, "ev.nil", ring.eq(e, ring.z0()))
            return p
        }
        if e.is("ev") && e.arg(0).is("Vec<<i64,i128>>.cons") {
            let t = e.arg(0)
            let x = e.arg(1)
            let p = t.arg(0)
            let body = ring.add(ring.mul(p.arg(1), look(x, p.arg(0))), ev(t.arg(1), x))
            let p = ring.axiom(&self.k, "ev.cons", ring.eq(e, body))
            let rest = self.unfold(ring.rhs(p), eqs)
            return ring.trans(&self.k, p, rest)
        }
        if e.is("add") {
            let a = self.unfold(e.arg(0), eqs)
            let b = self.unfold(e.arg(1), eqs)
            return ring.cong_add(&self.k, a, b)
        }
        if e.is("mul") {
            let a = self.unfold(e.arg(0), eqs)
            let b = self.unfold(e.arg(1), eqs)
            return ring.cong_mul(&self.k, a, b)
        }
        if e.is("neg") {
            let a = self.unfold(e.arg(0), eqs)
            return ring.cong_neg(&self.k, a)
        }
        ring.refl(&self.k, e)
    }

    // eq x y by unfolding both sides, then ring identities.
    pub fn prove(inout self, x: cert.Tm, y: cert.Tm, eqs: [cert.Ref]) -> cert.Ref {
        let px = self.unfold(x, eqs)
        let py = self.unfold(y, eqs)
        let mid = self.ring.prove(&self.k, ring.rhs(px), ring.rhs(py))
        let back = ring.sym(&self.k, py)
        ring.chain(&self.k, [px.clone(), mid.clone(), back.clone()])
    }

    // le c d from le a b, a = c and b = d.
    pub fn le_eq(inout self, p: cert.Ref, c: cert.Tm, d: cert.Tm, eqs: [cert.Ref]) -> cert.Ref {
        let a = p.judgment.arg(0)
        let b = p.judgment.arg(1)
        let e1 = self.prove(a, c, eqs)
        let e2 = self.prove(b, d, eqs)
        self.step("le.eq", [p.clone(), e1.clone(), e2.clone()], ring.le(c, d))
    }

    // le z0 (a + b) from le z0 a and le z0 b.
    pub fn nonneg_add(inout self, p: cert.Ref, q: cert.Ref) -> cert.Ref {
        let a = p.judgment.arg(1)
        let b = q.judgment.arg(1)
        // 0 + b <= a + b, so b <= a + b
        let s = self.step("le.add", [p.clone()], ring.le(ring.add(ring.z0(), b), ring.add(a, b)))
        let s = self.le_eq(s, b, ring.add(a, b), [])
        self.step("le.trans", [q.clone(), s.clone()], ring.le(ring.z0(), ring.add(a, b)))
    }

    // One case of inverting `h`: the branch for `rule`, with its premises
    // and the context hypotheses under the unifier as new hypotheses.
    pub fn open(inout self, h: cert.Ref, context: [i64], rule: str, prefix: str) -> Opened {
        let Some(o) = self.try_open(h, context, rule, prefix) else {
            panic("rule " + rule + " cannot conclude " + h.judgment.show().as_str())
        }
        o
    }

    // Every case of inverting `h`: one per rule that can conclude it.
    pub fn open_all(inout self, h: cert.Ref, context: [i64], prefix: str) -> Vec(Opened) {
        var out = Vec(Opened).new()
        for r in self.rules.names_for(h.judgment.head()) {
            match self.try_open(h, context, r.as_str(), prefix) {
                Some(o) => out.push(o)
                None => {}
            }
        }
        out
    }

    pub fn try_open(
        inout self,
        h: cert.Ref,
        context: [i64],
        rule: str,
        prefix: str
    ) -> Option(Opened) {
        let Some(b) = self.rules.branch(&self.k, h.judgment, rule, prefix) else { return None }
        var prem = Vec(cert.Ref).new()
        for p in b.premises { prem.push(self.hyp(p)) }
        var ctx = Vec(cert.Ref).new()
        for c in context {
            var general = Vec(str).new()
            for g in self.k.general(c) { general.push(g.as_str()) }
            let local = b.theta.without(general.as_slice())
            let cj = local.apply(self.k.judgment(c))
            if general.len() == 0 && self.k.premises(c).len == 0 {
                ctx.push(self.hyp(cj))
            } else {
                var ps = Vec(cert.Tm).new()
                for q in self.k.premises(c) { ps.push(local.apply(q)) }
                let n = self.k.rule_hyp(ps.as_slice(), cj, general.as_slice())
                ctx.push(self.k.plain(n))
            }
        }
        Some(Opened { b, prem, ctx })
    }

    // `j` from `false`, by the theory's rule that concludes j's predicate
    // from `false`.
    pub fn from_false(inout self, f: cert.Ref, j: cert.Tm) -> cert.Ref {
        if j.head() == "false" { return f.clone() }
        for r in self.rules.names_for(j.head()) {
            if r.as_str().starts_with("efq") { return self.step(r.as_str(), [f.clone()], j) }
        }
        panic("no rule concludes " + j.head() + " from false")
    }

    pub fn close(
        inout self,
        h: cert.Ref,
        context: [i64],
        j: cert.Tm,
        cases: [cert.InvCase]
    ) -> cert.Ref {
        // A rule that concludes anything from `false` is a case too: its
        // `false` gives the judgment.
        var all = Vec(cert.InvCase).new()
        for c in cases { all.push(c.clone()) }
        for r in self.rules.names_for(h.judgment.head()) {
            if !r.as_str().starts_with("efq") { continue }
            var given = false
            for c in cases {
                if c.rule == r { given = true }
            }
            if given { continue }
            match self.try_open(h, context, r.as_str(), "ef") {
                Some(o) => {
                    let want = o.b.theta.apply(j)
                    let s = self.from_false(o.prem[0].clone(), want)
                    all.push(o.case(s))
                }
                None => {}
            }
        }
        let n = self.k.invert(h.index(), context, j.clone(), all.as_slice())
        self.k.plain(n)
    }
}

pub struct Opened {
    pub b: cert.Branch
    pub prem: Vec(cert.Ref)
    pub ctx: Vec(cert.Ref)
}

impl Opened {
    pub fn case(self, r: cert.Ref) -> cert.InvCase { self.b.case(r.index()) }

    pub fn at(self, i: i64) -> cert.Tm { cert.v(self.b.vars[i.clone()].as_str()) }
}
