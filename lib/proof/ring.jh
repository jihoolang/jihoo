// The integers as an ordered commutative ring, in Horn rules, and a
// prover of ring identities that writes their certificates.
//
// The sort Z has the constructors z0, z1, add, mul and neg (and any a
// theory adds, such as functions with defining equations); `eq` and `le`
// are equality and order, given by the axioms below, each of which holds
// in ℤ. Z is never the subject of induction or inversion: its terms are
// expressions, not values, so every expression has a value without a
// proof that it exists.
//
// The prover is not trusted. `Ring.prove` normalizes both sides to a
// sorted sum of signed monomials, each rewrite justified by an axiom or a
// lemma derived from them, and the checker checks every step.
import proof.cert

// Declarations and axioms; a theory declares `(sort Z)` before them.
pub fn theory() -> String {
    String.from(
        "(ctor z0 () Z) (ctor z1 () Z) (ctor add (Z Z) Z) (ctor mul (Z Z) Z) (ctor neg (Z) Z)\n"
    ) +
        "(pred eq (Z Z)) (pred le (Z Z)) (pred false ())\n" +
        "(rule eq.refl () (eq ?a ?a))\n" +
        "(rule eq.sym ((eq ?a ?b)) (eq ?b ?a))\n" +
        "(rule eq.trans ((eq ?a ?b) (eq ?b ?c)) (eq ?a ?c))\n" +
        "(rule eq.add ((eq ?a ?b) (eq ?c ?d)) (eq (add ?a ?c) (add ?b ?d)))\n" +
        "(rule eq.mul ((eq ?a ?b) (eq ?c ?d)) (eq (mul ?a ?c) (mul ?b ?d)))\n" +
        "(rule eq.neg ((eq ?a ?b)) (eq (neg ?a) (neg ?b)))\n" +
        "(rule add.comm () (eq (add ?a ?b) (add ?b ?a)))\n" +
        "(rule add.assoc () (eq (add (add ?a ?b) ?c) (add ?a (add ?b ?c))))\n" +
        "(rule add.zero () (eq (add ?a z0) ?a))\n" +
        "(rule add.neg () (eq (add ?a (neg ?a)) z0))\n" +
        "(rule mul.comm () (eq (mul ?a ?b) (mul ?b ?a)))\n" +
        "(rule mul.assoc () (eq (mul (mul ?a ?b) ?c) (mul ?a (mul ?b ?c))))\n" +
        "(rule mul.one () (eq (mul ?a z1) ?a))\n" +
        "(rule mul.dist () (eq (mul ?a (add ?b ?c)) (add (mul ?a ?b) (mul ?a ?c))))\n" +
        "(rule le.eq ((le ?a ?b) (eq ?a ?c) (eq ?b ?d)) (le ?c ?d))\n" +
        "(rule le.refl () (le ?a ?a))\n" +
        "(rule le.antisym ((le ?a ?b) (le ?b ?a)) (eq ?a ?b))\n" +
        "(rule le.trans ((le ?a ?b) (le ?b ?c)) (le ?a ?c))\n" +
        "(rule le.add ((le ?a ?b)) (le (add ?a ?c) (add ?b ?c)))\n" +
        "(rule le.mul ((le z0 ?a) (le z0 ?b)) (le z0 (mul ?a ?b)))\n" +
        "(rule le.one () (le z0 z1))\n" +
        "(rule absurd ((le z1 z0)) (false))\n"
}

pub fn z0() -> cert.Tm { cert.c("z0") }

pub fn z1() -> cert.Tm { cert.c("z1") }

pub fn add(a: cert.Tm, b: cert.Tm) -> cert.Tm { cert.app2("add", a.clone(), b.clone()) }

pub fn mul(a: cert.Tm, b: cert.Tm) -> cert.Tm { cert.app2("mul", a.clone(), b.clone()) }

pub fn neg(a: cert.Tm) -> cert.Tm { cert.app1("neg", a.clone()) }

pub fn eq(a: cert.Tm, b: cert.Tm) -> cert.Tm { cert.app2("eq", a.clone(), b.clone()) }

pub fn le(a: cert.Tm, b: cert.Tm) -> cert.Tm { cert.app2("le", a.clone(), b.clone()) }

// The two sides of an `eq` reference.
pub fn lhs(r: cert.Ref) -> ref cert.Tm { r.judgment.arg(0) }

pub fn rhs(r: cert.Ref) -> ref cert.Tm { r.judgment.arg(1) }

// A signed product of atoms, sorted.
#[derive(Clone)]
struct Mono {
    negative: bool
    atoms: Vec(cert.Tm)
}

fn cmp_str(a: str, b: str) -> i64 {
    let n = if a.len < b.len { a.len } else { b.len }
    for i in 0..n {
        if a[i] != b[i] { return if a[i] < b[i] { -1 } else { 1 } }
    }
    if a.len == b.len { 0 } else if a.len < b.len { -1 } else { 1 }
}

fn cmp_atom(a: cert.Tm, b: cert.Tm) -> i64 { cmp_str(a.show().as_str(), b.show().as_str()) }

// By atoms, then positive before negative.
fn cmp_atoms(a: [cert.Tm], b: [cert.Tm]) -> i64 {
    let n = if a.len < b.len { a.len } else { b.len }
    for i in 0..n {
        let k = cmp_atom(a[i], b[i])
        if k != 0 { return k }
    }
    if a.len == b.len { 0 } else if a.len < b.len { -1 } else { 1 }
}

fn product(atoms: [cert.Tm]) -> cert.Tm {
    var t = z1()
    var i = atoms.len
    while i > 0 {
        i -= 1
        t = mul(atoms[i], t)
    }
    t
}

fn mono_tm(m: Mono) -> cert.Tm {
    let p = product(m.atoms.as_slice())
    if m.negative { neg(p) } else { p }
}

fn poly_tm(p: [Mono]) -> cert.Tm {
    var t = z0()
    var i = p.len
    while i > 0 {
        i -= 1
        t = add(mono_tm(p[i]), t)
    }
    t
}

fn rest(p: [Mono]) -> Vec(Mono) {
    var out = Vec(Mono).new()
    for i in 1..p.len { out.push(p[i].clone()) }
    out
}

fn cons(m: Mono, p: [Mono]) -> Vec(Mono) {
    var out = Vec(Mono).new()
    out.push(m.clone())
    for x in p { out.push(x.clone()) }
    out
}

fn one(m: Mono) -> Vec(Mono) {
    var out = Vec(Mono).new()
    out.push(m.clone())
    out
}

fn tail(xs: [cert.Tm]) -> Vec(cert.Tm) {
    var out = Vec(cert.Tm).new()
    for i in 1..xs.len { out.push(xs[i].clone()) }
    out
}

fn push_front(x: cert.Tm, xs: [cert.Tm]) -> Vec(cert.Tm) {
    var out = Vec(cert.Tm).new()
    out.push(x.clone())
    for y in xs { out.push(y.clone()) }
    out
}

// An equation and the normal form its right side is.
struct Norm {
    proof: cert.Ref
    poly: Vec(Mono)
}

// The lemmas derived from the axioms, as hypothesis-free steps over the
// variables ra, rb and rc.
pub struct Ring {
    zero_add: i64
    add_lcomm: i64
    neg_zero: i64
    cancel: i64
    cancel_neg: i64
    neg_add: i64
    neg_neg: i64
    mul_zero: i64
    zero_mul: i64
    rdist: i64
    one_mul: i64
    mul_neg: i64
    neg_mul: i64
    mul_lcomm: i64
}

fn a() -> cert.Tm { cert.v("ra") }

fn b() -> cert.Tm { cert.v("rb") }

fn c() -> cert.Tm { cert.v("rc") }

// Equational steps.
pub fn axiom(inout k: cert.Cert, rule: str, j: cert.Tm) -> cert.Ref {
    let n = k.step_refs(rule, [], j.clone())
    k.plain(n)
}

pub fn refl(inout k: cert.Cert, t: cert.Tm) -> cert.Ref { axiom(&k, "eq.refl", eq(t, t)) }

pub fn sym(inout k: cert.Cert, p: cert.Ref) -> cert.Ref {
    let n = k.step_refs("eq.sym", [p.clone()], eq(rhs(p), lhs(p)))
    k.plain(n)
}

pub fn trans(inout k: cert.Cert, p: cert.Ref, q: cert.Ref) -> cert.Ref {
    if rhs(p) != lhs(q) {
        panic("trans: " + rhs(p).show().as_str() + " is not " + lhs(q).show().as_str())
    }
    let n = k.step_refs("eq.trans", [p.clone(), q.clone()], eq(lhs(p), rhs(q)))
    k.plain(n)
}

pub fn chain(inout k: cert.Cert, ps: [cert.Ref]) -> cert.Ref {
    var r = ps[0].clone()
    for i in 1..ps.len { r = trans(&k, r, ps[i]) }
    r
}

pub fn cong_add(inout k: cert.Cert, p: cert.Ref, q: cert.Ref) -> cert.Ref {
    let j = eq(add(lhs(p), lhs(q)), add(rhs(p), rhs(q)))
    let n = k.step_refs("eq.add", [p.clone(), q.clone()], j)
    k.plain(n)
}

pub fn cong_mul(inout k: cert.Cert, p: cert.Ref, q: cert.Ref) -> cert.Ref {
    let j = eq(mul(lhs(p), lhs(q)), mul(rhs(p), rhs(q)))
    let n = k.step_refs("eq.mul", [p.clone(), q.clone()], j)
    k.plain(n)
}

pub fn cong_neg(inout k: cert.Cert, p: cert.Ref) -> cert.Ref {
    let n = k.step_refs("eq.neg", [p.clone()], eq(neg(lhs(p)), neg(rhs(p))))
    k.plain(n)
}

// a + b on the left of p's sides: (a + x) = (a + y).
fn left(inout k: cert.Cert, t: cert.Tm, p: cert.Ref) -> cert.Ref {
    let r = refl(&k, t)
    cong_add(&k, r, p)
}

fn right(inout k: cert.Cert, p: cert.Ref, t: cert.Tm) -> cert.Ref {
    let r = refl(&k, t)
    cong_add(&k, p, r)
}

pub fn add_comm(inout k: cert.Cert, x: cert.Tm, y: cert.Tm) -> cert.Ref {
    axiom(&k, "add.comm", eq(add(x, y), add(y, x)))
}

pub fn add_assoc(inout k: cert.Cert, x: cert.Tm, y: cert.Tm, z: cert.Tm) -> cert.Ref {
    axiom(&k, "add.assoc", eq(add(add(x, y), z), add(x, add(y, z))))
}

pub fn add_zero(
    inout k: cert.Cert,
    x: cert.Tm
) -> cert.Ref { axiom(&k, "add.zero", eq(add(x, z0()), x)) }

pub fn add_neg(
    inout k: cert.Cert,
    x: cert.Tm
) -> cert.Ref { axiom(&k, "add.neg", eq(add(x, neg(x)), z0())) }

pub fn mul_comm(inout k: cert.Cert, x: cert.Tm, y: cert.Tm) -> cert.Ref {
    axiom(&k, "mul.comm", eq(mul(x, y), mul(y, x)))
}

pub fn mul_assoc(inout k: cert.Cert, x: cert.Tm, y: cert.Tm, z: cert.Tm) -> cert.Ref {
    axiom(&k, "mul.assoc", eq(mul(mul(x, y), z), mul(x, mul(y, z))))
}

pub fn mul_one(
    inout k: cert.Cert,
    x: cert.Tm
) -> cert.Ref { axiom(&k, "mul.one", eq(mul(x, z1()), x)) }

pub fn mul_dist(inout k: cert.Cert, x: cert.Tm, y: cert.Tm, z: cert.Tm) -> cert.Ref {
    axiom(&k, "mul.dist", eq(mul(x, add(y, z)), add(mul(x, y), mul(x, z))))
}

fn last(k: cert.Cert) -> i64 { k.steps() - 1 }

impl Ring {
    // Derive the lemmas; `k` must not have declared ra, rb or rc.
    pub fn new(inout k: cert.Cert) -> Ring {
        k.declare("ra", "Z")
        k.declare("rb", "Z")
        k.declare("rc", "Z")
        // 0 + a = a
        let p1 = add_comm(&k, z0(), a())
        let p2 = add_zero(&k, a())
        trans(&k, p1, p2)
        let zero_add = last(k)
        // a + (b + c) = b + (a + c)
        let q1 = add_assoc(&k, a(), b(), c())
        let q1 = sym(&k, q1)
        let q2 = add_comm(&k, a(), b())
        let q2 = right(&k, q2, c())
        let q3 = add_assoc(&k, b(), a(), c())
        chain(&k, [q1, q2, q3])
        let add_lcomm = last(k)
        // neg 0 = 0
        let r1 = k.instance(zero_add, ["ra"], [neg(z0())])
        let r1 = sym(&k, r1)
        let r2 = add_neg(&k, z0())
        trans(&k, r1, r2)
        let neg_zero = last(k)
        // (a + b) + (neg a + c) = b + c
        let s1 = add_assoc(&k, a(), b(), add(neg(a()), c()))
        let s2 = k.instance(add_lcomm, ["ra", "rb", "rc"], [b(), neg(a()), c()])
        let s2 = left(&k, a(), s2)
        let s3 = add_assoc(&k, a(), neg(a()), add(b(), c()))
        let s3 = sym(&k, s3)
        let s4 = add_neg(&k, a())
        let s4 = right(&k, s4, add(b(), c()))
        let s5 = k.instance(zero_add, ["ra"], [add(b(), c())])
        chain(&k, [s1, s2, s3, s4, s5])
        let cancel = last(k)
        // (neg a + b) + (a + c) = b + c
        let t1 = add_comm(&k, add(neg(a()), b()), add(a(), c()))
        let t2 = k.instance(cancel, ["ra", "rb", "rc"], [a(), c(), b()])
        let t3 = add_comm(&k, c(), b())
        chain(&k, [t1, t2, t3])
        let cancel_neg = last(k)
        // (a + b) + (neg a + neg b) = 0
        let u1 = k.instance(cancel, ["ra", "rb", "rc"], [a(), b(), neg(b())])
        let u2 = add_neg(&k, b())
        let zero_sum = trans(&k, u1, u2)
        // neg (a + b) = neg a + neg b
        let s = add(a(), b())
        let ns = neg(s)
        let nab = add(neg(a()), neg(b()))
        let v1 = add_zero(&k, ns)
        let v1 = sym(&k, v1)
        let v2 = sym(&k, zero_sum)
        let v2 = left(&k, ns, v2)
        let v3 = add_assoc(&k, ns, s, nab)
        let v3 = sym(&k, v3)
        let v4 = add_comm(&k, ns, s)
        let v5 = add_neg(&k, s)
        let v45 = trans(&k, v4, v5)
        let v45 = right(&k, v45, nab)
        let v6 = k.instance(zero_add, ["ra"], [nab])
        chain(&k, [v1, v2, v3, v45, v6])
        let neg_add = last(k)
        // neg (neg a) = a
        let n = neg(a())
        let nn = neg(n)
        let w1 = add_zero(&k, nn)
        let w1 = sym(&k, w1)
        let w2 = add_neg(&k, a())
        let w2 = sym(&k, w2)
        let w2c = add_comm(&k, a(), n)
        let w2 = trans(&k, w2, w2c)
        let w2 = left(&k, nn, w2)
        let w3 = add_assoc(&k, nn, n, a())
        let w3 = sym(&k, w3)
        let w4 = add_comm(&k, nn, n)
        let w5 = add_neg(&k, n)
        let w45 = trans(&k, w4, w5)
        let w45 = right(&k, w45, a())
        let w6 = k.instance(zero_add, ["ra"], [a()])
        chain(&k, [w1, w2, w3, w45, w6])
        let neg_neg = last(k)
        // a * 0 = 0
        let p = mul(a(), z0())
        let x1 = add_zero(&k, p)
        let x1 = sym(&k, x1)
        let x2 = add_neg(&k, p)
        let x2 = sym(&k, x2)
        let x2 = left(&k, p, x2)
        let x3 = add_assoc(&k, p, p, neg(p))
        let x3 = sym(&k, x3)
        let x4 = mul_dist(&k, a(), z0(), z0())
        let x4 = sym(&k, x4)
        let x4r = refl(&k, a())
        let x4z = add_zero(&k, z0())
        let x4b = cong_mul(&k, x4r, x4z)
        let x4 = trans(&k, x4, x4b)
        let x4 = right(&k, x4, neg(p))
        let x5 = add_neg(&k, p)
        chain(&k, [x1, x2, x3, x4, x5])
        let mul_zero = last(k)
        // 0 * a = 0
        let y1 = mul_comm(&k, z0(), a())
        let y2 = k.instance(mul_zero, ["ra"], [a()])
        trans(&k, y1, y2)
        let zero_mul = last(k)
        // (a + b) * c = a * c + b * c
        let d1 = mul_comm(&k, add(a(), b()), c())
        let d2 = mul_dist(&k, c(), a(), b())
        let d3a = mul_comm(&k, c(), a())
        let d3b = mul_comm(&k, c(), b())
        let d3 = cong_add(&k, d3a, d3b)
        chain(&k, [d1, d2, d3])
        let rdist = last(k)
        // 1 * a = a
        let o1 = mul_comm(&k, z1(), a())
        let o2 = mul_one(&k, a())
        trans(&k, o1, o2)
        let one_mul = last(k)
        // a * neg b = neg (a * b)
        let q = mul(a(), neg(b()))
        let pp = mul(a(), b())
        let m1 = add_zero(&k, q)
        let m1 = sym(&k, m1)
        let m2 = add_neg(&k, pp)
        let m2 = sym(&k, m2)
        let m2 = left(&k, q, m2)
        let m3 = add_assoc(&k, q, pp, neg(pp))
        let m3 = sym(&k, m3)
        let m4 = mul_dist(&k, a(), neg(b()), b())
        let m4 = sym(&k, m4)
        let m4r = refl(&k, a())
        let m4c = add_comm(&k, neg(b()), b())
        let m4n = add_neg(&k, b())
        let m4s = trans(&k, m4c, m4n)
        let m4b = cong_mul(&k, m4r, m4s)
        let m4z = k.instance(mul_zero, ["ra"], [a()])
        let m4 = chain(&k, [m4, m4b, m4z])
        let m4 = right(&k, m4, neg(pp))
        let m5 = k.instance(zero_add, ["ra"], [neg(pp)])
        chain(&k, [m1, m2, m3, m4, m5])
        let mul_neg = last(k)
        // neg a * b = neg (a * b)
        let e1 = mul_comm(&k, neg(a()), b())
        let e2 = k.instance(mul_neg, ["ra", "rb"], [b(), a()])
        let e3 = mul_comm(&k, b(), a())
        let e3 = cong_neg(&k, e3)
        chain(&k, [e1, e2, e3])
        let neg_mul = last(k)
        // a * (b * c) = b * (a * c)
        let f1 = mul_assoc(&k, a(), b(), c())
        let f1 = sym(&k, f1)
        let f2a = mul_comm(&k, a(), b())
        let f2r = refl(&k, c())
        let f2 = cong_mul(&k, f2a, f2r)
        let f3 = mul_assoc(&k, b(), a(), c())
        chain(&k, [f1, f2, f3])
        let mul_lcomm = last(k)
        Ring {
            zero_add,
            add_lcomm,
            neg_zero,
            cancel,
            cancel_neg,
            neg_add,
            neg_neg,
            mul_zero,
            zero_mul,
            rdist,
            one_mul,
            mul_neg,
            neg_mul,
            mul_lcomm
        }
    }

    fn inst1(
        self,
        inout k: cert.Cert,
        n: i64,
        x: cert.Tm
    ) -> cert.Ref { k.instance(n, ["ra"], [x.clone()]) }

    fn inst2(self, inout k: cert.Cert, n: i64, x: cert.Tm, y: cert.Tm) -> cert.Ref {
        k.instance(n, ["ra", "rb"], [x.clone(), y.clone()])
    }

    fn inst3(self, inout k: cert.Cert, n: i64, x: cert.Tm, y: cert.Tm, z: cert.Tm) -> cert.Ref {
        k.instance(n, ["ra", "rb", "rc"], [x.clone(), y.clone(), z.clone()])
    }

    // e = its normal form.
    fn norm(self, inout k: cert.Cert, e: cert.Tm) -> Norm {
        if e.is("z0") && e.arity() == 0 {
            return Norm { proof: refl(&k, e), poly: Vec(Mono).new() }
        }
        if e.is("z1") && e.arity() == 0 {
            let m = Mono { negative: false, atoms: Vec(cert.Tm).new() }
            let p = add_zero(&k, z1())
            let p = sym(&k, p)
            return Norm { proof: p, poly: one(m) }
        }
        if e.is("add") {
            let x = self.norm(&k, e.arg(0))
            let y = self.norm(&k, e.arg(1))
            let p = cong_add(&k, x.proof, y.proof)
            let s = self.add_polys(&k, x.poly.as_slice(), y.poly.as_slice())
            return Norm { proof: trans(&k, p, s.proof), poly: s.poly.clone() }
        }
        if e.is("neg") {
            let x = self.norm(&k, e.arg(0))
            let p = cong_neg(&k, x.proof)
            let s = self.neg_poly(&k, x.poly.as_slice())
            return Norm { proof: trans(&k, p, s.proof), poly: s.poly.clone() }
        }
        if e.is("mul") {
            let x = self.norm(&k, e.arg(0))
            let y = self.norm(&k, e.arg(1))
            let p = cong_mul(&k, x.proof, y.proof)
            let s = self.mul_polys(&k, x.poly.as_slice(), y.poly.as_slice())
            return Norm { proof: trans(&k, p, s.proof), poly: s.poly.clone() }
        }
        // An atom a: a = a * 1 + 0.
        var atoms = Vec(cert.Tm).new()
        atoms.push(e.clone())
        let m = Mono { negative: false, atoms }
        let p1 = mul_one(&k, e)
        let p2 = add_zero(&k, mul(e, z1()))
        let p = trans(&k, p2, p1)
        Norm { proof: sym(&k, p), poly: one(m) }
    }

    // tm(p) + tm(q) = the normal form of their sum.
    fn add_polys(self, inout k: cert.Cert, p: [Mono], q: [Mono]) -> Norm {
        let x = poly_tm(p)
        let y = poly_tm(q)
        if p.len == 0 {
            return Norm { proof: self.inst1(&k, self.zero_add, y), poly: copy(q) }
        }
        if q.len == 0 { return Norm { proof: add_zero(&k, x), poly: copy(p) } }
        let tp = mono_tm(p[0])
        let tq = mono_tm(q[0])
        let p1 = rest(p)
        let q1 = rest(q)
        let xp = poly_tm(p1.as_slice())
        let yq = poly_tm(q1.as_slice())
        let order = cmp_atoms(p[0].atoms.as_slice(), q[0].atoms.as_slice())
        if order == 0 && p[0].negative != q[0].negative {
            // m + -m cancels.
            let r = if p[0].negative {
                self.inst3(&k, self.cancel_neg, mono_tm(q[0]), xp, yq)
            } else {
                self.inst3(&k, self.cancel, tp, xp, yq)
            }
            let s = self.add_polys(&k, p1.as_slice(), q1.as_slice())
            return Norm { proof: trans(&k, r, s.proof), poly: s.poly.clone() }
        }
        if order < 0 || (order == 0 && !p[0].negative) || (
            order == 0 && p[0].negative == q[0].negative
        ) {
            let r = add_assoc(&k, tp, xp, y)
            let s = self.add_polys(&k, p1.as_slice(), q)
            let s2 = left(&k, tp, s.proof)
            return Norm { proof: trans(&k, r, s2), poly: cons(p[0], s.poly.as_slice()) }
        }
        let r = self.inst3(&k, self.add_lcomm, x, tq, yq)
        let s = self.add_polys(&k, p, q1.as_slice())
        let s2 = left(&k, tq, s.proof)
        Norm { proof: trans(&k, r, s2), poly: cons(q[0], s.poly.as_slice()) }
    }

    // neg tm(p) = the normal form of its negation.
    fn neg_poly(self, inout k: cert.Cert, p: [Mono]) -> Norm {
        if p.len == 0 { return Norm { proof: k.plain(self.neg_zero), poly: Vec(Mono).new() } }
        let tp = mono_tm(p[0])
        let p1 = rest(p)
        let xp = poly_tm(p1.as_slice())
        let r = self.inst2(&k, self.neg_add, tp, xp)
        let flipped = Mono { negative: !p[0].negative, atoms: p[0].atoms.clone() }
        let head = if p[0].negative {
            self.inst1(&k, self.neg_neg, product(p[0].atoms.as_slice()))
        } else {
            refl(&k, neg(tp))
        }
        let s = self.neg_poly(&k, p1.as_slice())
        let both = cong_add(&k, head, s.proof)
        Norm { proof: trans(&k, r, both), poly: cons(flipped, s.poly.as_slice()) }
    }

    // tm(p) * tm(q) = the normal form of the product.
    fn mul_polys(self, inout k: cert.Cert, p: [Mono], q: [Mono]) -> Norm {
        let y = poly_tm(q)
        if p.len == 0 { return Norm {
            proof: self.inst1(&k, self.zero_mul, y),
            poly: Vec(Mono).new()
        } }
        let tp = mono_tm(p[0])
        let p1 = rest(p)
        let xp = poly_tm(p1.as_slice())
        let r = self.inst3(&k, self.rdist, tp, xp, y)
        let s1 = self.mono_poly(&k, p[0], q)
        let s2 = self.mul_polys(&k, p1.as_slice(), q)
        let both = cong_add(&k, s1.proof, s2.proof)
        let sum = self.add_polys(&k, s1.poly.as_slice(), s2.poly.as_slice())
        Norm { proof: chain(&k, [r, both, sum.proof.clone()]), poly: sum.poly.clone() }
    }

    // tm(m) * tm(q).
    fn mono_poly(self, inout k: cert.Cert, m: Mono, q: [Mono]) -> Norm {
        let tm = mono_tm(m)
        if q.len == 0 { return Norm {
            proof: self.inst1(&k, self.mul_zero, tm),
            poly: Vec(Mono).new()
        } }
        let tq = mono_tm(q[0])
        let q1 = rest(q)
        let yq = poly_tm(q1.as_slice())
        let r = mul_dist(&k, tm, tq, yq)
        let head = self.mono_mono(&k, m, q[0])
        // tm(mq) = tm(mq) + 0, the one-monomial normal form.
        let head_sum = add_zero(&k, rhs(head))
        let head_sum = sym(&k, head_sum)
        let head = trans(&k, head, head_sum)
        let s = self.mono_poly(&k, m, q1.as_slice())
        let both = cong_add(&k, head, s.proof)
        let mq = self.mono_product(m, q[0])
        let sum = self.add_polys(&k, one(mq).as_slice(), s.poly.as_slice())
        Norm { proof: chain(&k, [r, both, sum.proof.clone()]), poly: sum.poly.clone() }
    }

    fn mono_product(self, m: Mono, n: Mono) -> Mono {
        Mono {
            negative: m.negative != n.negative,
            atoms: merge_atoms(m.atoms.as_slice(), n.atoms.as_slice())
        }
    }

    // tm(m) * tm(n) = tm(their product).
    fn mono_mono(self, inout k: cert.Cert, m: Mono, n: Mono) -> cert.Ref {
        let pm = product(m.atoms.as_slice())
        let pn = product(n.atoms.as_slice())
        let merged = self.prod_merge(&k, m.atoms.as_slice(), n.atoms.as_slice())
        if !m.negative && !n.negative { return merged }
        if m.negative && !n.negative {
            let r = self.inst2(&k, self.neg_mul, pm, pn)
            let s = cong_neg(&k, merged)
            return trans(&k, r, s)
        }
        if !m.negative && n.negative {
            let r = self.inst2(&k, self.mul_neg, pm, pn)
            let s = cong_neg(&k, merged)
            return trans(&k, r, s)
        }
        // neg x * neg y = neg (x * neg y) = neg (neg (x * y)) = x * y
        let r1 = self.inst2(&k, self.neg_mul, pm, neg(pn))
        let r2 = self.inst2(&k, self.mul_neg, pm, pn)
        let r2 = cong_neg(&k, r2)
        let r3 = self.inst1(&k, self.neg_neg, mul(pm, pn))
        chain(&k, [r1, r2, r3, merged])
    }

    // product(a) * product(b) = product(merged a and b).
    fn prod_merge(self, inout k: cert.Cert, xs: [cert.Tm], ys: [cert.Tm]) -> cert.Ref {
        let px = product(xs)
        let py = product(ys)
        if xs.len == 0 { return self.inst1(&k, self.one_mul, py) }
        if ys.len == 0 { return mul_one(&k, px) }
        let xs1 = tail(xs)
        let ys1 = tail(ys)
        if cmp_atom(xs[0], ys[0]) <= 0 {
            let r = mul_assoc(&k, xs[0], product(xs1.as_slice()), py)
            let s = self.prod_merge(&k, xs1.as_slice(), ys)
            let h = refl(&k, xs[0])
            let s2 = cong_mul(&k, h, s)
            return trans(&k, r, s2)
        }
        let r = self.inst3(&k, self.mul_lcomm, px, ys[0], product(ys1.as_slice()))
        let s = self.prod_merge(&k, xs, ys1.as_slice())
        let h = refl(&k, ys[0])
        let s2 = cong_mul(&k, h, s)
        trans(&k, r, s2)
    }

    // A proof of eq x y, if they are equal in every commutative ring.
    pub fn prove(self, inout k: cert.Cert, x: cert.Tm, y: cert.Tm) -> cert.Ref {
        let nx = self.norm(&k, x)
        let ny = self.norm(&k, y)
        if rhs(nx.proof) != rhs(ny.proof) {
            panic(
                "not a ring identity: " + x.show().as_str() + " = " + y.show().as_str() + "\n  " +
                    rhs(nx.proof).show().as_str() + "\n  " + rhs(ny.proof).show().as_str()
            )
        }
        let back = sym(&k, ny.proof)
        trans(&k, nx.proof, back)
    }
}

fn copy(p: [Mono]) -> Vec(Mono) {
    var out = Vec(Mono).new()
    for m in p { out.push(m.clone()) }
    out
}

fn merge_atoms(xs: [cert.Tm], ys: [cert.Tm]) -> Vec(cert.Tm) {
    if xs.len == 0 { return copy_tms(ys) }
    if ys.len == 0 { return copy_tms(xs) }
    if cmp_atom(xs[0], ys[0]) <= 0 {
        let r = merge_atoms(xs[1..], ys)
        return push_front(xs[0], r.as_slice())
    }
    let r = merge_atoms(xs, ys[1..])
    push_front(ys[0], r.as_slice())
}

fn copy_tms(xs: [cert.Tm]) -> Vec(cert.Tm) {
    var out = Vec(cert.Tm).new()
    for x in xs { out.push(x.clone()) }
    out
}
