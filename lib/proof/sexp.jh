// S-expressions for theories, goals and certificates, read from a whole
// string. Comments start with `;`. ASCII is read byte by byte; other text
// must be valid UTF-8.
import std.utf8

pub const MAX_DEPTH: i64 = 256

pub enum Sexp { Atom(String), List(Vec(Sexp)) }

impl Sexp {
    pub fn atom(self) -> Result(str, String) {
        match self {
            Atom(s) => Ok(s.as_str())
            _ => Err("expected an atom")
        }
    }

    pub fn list(self) -> Result([Sexp], String) {
        match self {
            List(xs) => Ok(xs.as_slice())
            _ => Err("expected a list")
        }
    }

    pub fn is_list(self) -> bool {
        match self {
            List(_) => true
            _ => false
        }
    }

    // The expression as text, for error messages.
    pub fn show(self) -> String {
        match self {
            Atom(s) => s.clone()
            List(xs) => {
                var out = String.from("(")
                for i in 0..xs.len() {
                    if i > 0 { out.push_str(" ") }
                    out.push_str(xs[i].show().as_str())
                }
                out.push_str(")")
                out
            }
        }
    }
}

struct Reader { source: str, at: i64 }

fn is_blank(b: u8) -> bool { b == ' ' || (b >= 9 && b <= 13) }

impl Reader {
    fn skip(inout self) -> Result((), String) {
        while self.at < self.source.len {
            let b = self.source[self.at]
            if is_blank(b) {
                self.at += 1
            } else if b == ';' {
                while self.at < self.source.len && self.source[self.at] != '\n' {
                    if self.source[self.at] < 128 {
                        self.at += 1
                    } else {
                        self.at += utf8.decode(self.source, self.at)?.1
                    }
                }
            } else if b >= 128 {
                let d = utf8.decode(self.source, self.at)?
                if !utf8.is_whitespace(d.0) { break }
                self.at += d.1
            } else {
                break
            }
        }
        Ok(())
    }

    fn read(inout self, depth: i64) -> Result(Sexp, String) {
        if depth > MAX_DEPTH { return Err("S-expression nesting exceeds 256") }
        self.skip()?
        if self.at == self.source.len { return Err("unexpected end of input") }
        let b = self.source[self.at]
        if b == '(' {
            self.at += 1
            var xs = Vec(Sexp).new()
            loop {
                self.skip()?
                if self.at == self.source.len { return Err("unexpected end of input") }
                if self.source[self.at] == ')' {
                    self.at += 1
                    break
                }
                xs.push(self.read(depth + 1)?)
            }
            Ok(Sexp.List(xs))
        } else if b == ')' {
            Err("unexpected closing parenthesis")
        } else {
            let start = self.at
            while self.at < self.source.len {
                let c = self.source[self.at]
                if c == '(' || c == ')' || c == ';' || is_blank(c) { break }
                if c < 128 {
                    self.at += 1
                } else {
                    let d = utf8.decode(self.source, self.at)?
                    if utf8.is_whitespace(d.0) { break }
                    self.at += d.1
                }
            }
            Ok(Sexp.Atom(self.source[start..self.at].to_string()))
        }
    }
}

// Every expression of `source`, in order.
pub fn parse(source: str) -> Result(Vec(Sexp), String) {
    var r = Reader { source, at: 0 }
    var forms = Vec(Sexp).new()
    loop {
        r.skip()?
        if r.at == source.len { break }
        forms.push(r.read(0)?)
    }
    Ok(forms)
}
