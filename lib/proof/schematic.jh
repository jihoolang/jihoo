// Schematic certificates: Horn derivations over open judgments, with
// variables, hypotheses, structural induction and implications. A port of
// Horn's checker (src/schematic.rs, with the theory checks of its kernel),
// whose algorithm Horn's agda/Schematic.agda and agda/Implication.agda
// prove sound. It knows no mathematics: the theory is data.
//
// Goals:
//
//     (var NAME SORT)                  a variable
//     (goal NAME J)                    J for every value of its variables
//     (goal NAME (H...) J)             the judgments H imply J
//
// Certificate, one step per index, in order:
//
//     (var NAME SORT)
//     (def ?NAME TERM)                 an abbreviation
//     (step N RULE (REF...) ITEM...)   a rule; ITEM is (?X TERM) or the judgment
//     (hyp N J)                        assume J
//     (hyp N (P...) J (X...))          assume the rule P... ⊢ J, general in X
//     (apply N M (BIND...) (REF...))   use step M as a rule
//     (induct N X J (CASE...))         J for every X; CASE = (STEP Y...)
//     (induct N X (H...) J (CASE...))  H... imply J for every X
//     (invert N K (C...) J (CASE...))  how hypothesis K was derived;
//                                      CASE = (RULE STEP (X...))
//     (result NAME REF)
//     REF = N | (N (X TERM)...)        a step, or an instance of one
//                                      without hypotheses
//
// A step with judgment J and hypotheses H is valid when every ground
// instance of J is derivable from the theory whenever the same instance of
// H is. The checker keeps that invariant; a result must equal its goal and
// rest only on the hypotheses its goal states.
import proof.sexp

const PROP: i64 = -1
const NONE: i64 = -1

enum Pat { Var(i64), App(i64, Vec(Pat)) }

struct Rule {
    name: String
    vars: Vec((String, i64))
    premises: Vec(Pat)
    conclusion: Pat
}

// A theory: sorts, constructors and predicates (numbered together as
// symbols), and rules.
pub struct Theory {
    sorts: Map(String, i64)
    ctors: Map(String, i64)
    preds: Map(String, i64)
    names: Vec(String)
    inputs: Vec(Vec(i64))
    outputs: Vec(i64)
    by_sort: Vec(Vec(i64))
    rules: Vec(Rule)
    rule_ix: Map(String, i64)
    by_pred: Vec(Vec(i64))
}

// A judgment pattern's predicate.
fn pattern_head(p: Pat) -> i64 {
    match p {
        App(h, _) => h
        Var(_) => NONE
    }
}

fn name(x: sexp.Sexp) -> Result(str, String) {
    let s = x.atom()?
    if s.starts_with("?") { return Err("declaration names cannot be variables") }
    Ok(s)
}

fn lookup(m: Map(String, i64), k: str) -> Option(i64) {
    match m.get(k.to_string()) {
        Some(v) => Some(v)
        None => None
    }
}

impl Theory {
    pub fn parse(source: str) -> Result(Theory, String) {
        var th = Theory {
            sorts: Map(String, i64).new()
            ctors: Map(String, i64).new()
            preds: Map(String, i64).new()
            names: Vec(String).new()
            inputs: Vec(Vec(i64)).new()
            outputs: Vec(i64).new()
            by_sort: Vec(Vec(i64)).new()
            rules: Vec(Rule).new()
            rule_ix: Map(String, i64).new()
            by_pred: Vec(Vec(i64)).new()
        }
        for form in sexp.parse(source)? {
            let xs = form.list()?
            if xs.len == 0 { return Err("empty declaration") }
            let tag = xs[0].atom()?
            if tag == "sort" && xs.len == 2 {
                let id = th.by_sort.len()
                if th.sorts.insert(name(xs[1])?.to_string(), id).is_some() {
                    return Err("duplicate sort")
                }
                th.by_sort.push(Vec(i64).new())
            } else if (tag == "ctor" && xs.len == 4) || (tag == "pred" && xs.len == 3) {
                let key = name(xs[1])?.to_string()
                var inputs = Vec(i64).new()
                for s in xs[2].list()? { inputs.push(th.sort(s)?) }
                let id = th.names.len()
                var output = PROP
                if tag == "ctor" {
                    output = th.sort(xs[3])?
                    if th.ctors.insert(key.clone(), id).is_some() { return Err("duplicate ctor") }
                    th.by_sort[output].push(id)
                } else if th.preds.insert(key.clone(), id).is_some() {
                    return Err("duplicate pred")
                }
                th.names.push(key)
                th.inputs.push(inputs)
                th.outputs.push(output)
                th.by_pred.push(Vec(i64).new())
            } else if tag == "rule" && xs.len == 4 {
                var vars = Vec((String, i64)).new()
                var premises = Vec(Pat).new()
                for j in xs[2].list()? { premises.push(th.pattern(j, PROP, &vars)?) }
                let conclusion = th.pattern(xs[3], PROP, &vars)?
                let key = name(xs[1])?.to_string()
                let id = th.rules.len()
                if th.rule_ix.insert(key.clone(), id).is_some() { return Err("duplicate rule") }
                let pred = pattern_head(conclusion)
                th.by_pred[pred].push(id)
                th.rules.push(Rule { name: key, vars, premises, conclusion })
            } else {
                return Err("invalid theory declaration: " + form.show().as_str())
            }
        }
        Ok(th)
    }

    fn sort(self, x: sexp.Sexp) -> Result(i64, String) {
        let s = name(x)?
        let Some(id) = lookup(self.sorts, s) else { return Err("unknown sort " + s) }
        Ok(id)
    }

    fn ctor(self, c: str) -> Result(i64, String) {
        let Some(id) = lookup(self.ctors, c) else { return Err("unknown constructor " + c) }
        Ok(id)
    }

    fn pred(self, p: str) -> Result(i64, String) {
        let Some(id) = lookup(self.preds, p) else { return Err("unknown predicate " + p) }
        Ok(id)
    }

    fn rule(self, r: str) -> Result(i64, String) {
        let Some(id) = lookup(self.rule_ix, r) else { return Err("unknown rule " + r) }
        Ok(id)
    }

    // A schema term of sort `sort`, or a judgment when `sort` is PROP.
    fn pattern(
        self,
        x: sexp.Sexp,
        sort: i64,
        inout vars: Vec((String, i64))
    ) -> Result(Pat, String) {
        if sort == PROP {
            let xs = x.list()?
            if xs.len == 0 { return Err("empty judgment") }
            let head = self.pred(xs[0].atom()?)?
            return self.app(x, head, xs[1..], sort, &vars)
        }
        match x {
            Atom(a) => {
                if a.as_str().starts_with("?") {
                    if a.len() == 1 { return Err("invalid ground variable " + a.as_str()) }
                    for i in 0..vars.len() {
                        if vars[i].0 == a {
                            if vars[i].1 != sort {
                                return Err("variable " + a.as_str() + " has conflicting sorts")
                            }
                            return Ok(Pat.Var(i))
                        }
                    }
                    vars.push((a.clone(), sort))
                    return Ok(Pat.Var(vars.len() - 1))
                }
                let head = self.ctor(a.as_str())?
                if self.outputs[head] != sort || self.inputs[head].len() != 0 {
                    return Err("sort or arity mismatch: " + a.as_str())
                }
                Ok(Pat.App(head, Vec(Pat).new()))
            }
            List(xs) => {
                if xs.len() == 0 { return Err("empty term") }
                let h = xs[0].atom()?
                if xs.len() == 1 { return Err("nullary constructors must be atoms") }
                let head = self.ctor(h)?
                self.app(x, head, xs.as_slice()[1..], sort, &vars)
            }
        }
    }

    fn app(
        self, x: sexp.Sexp, head: i64, args: [sexp.Sexp], sort: i64, inout vars: Vec((String, i64))
    ) -> Result(Pat, String) {
        let inputs = self.inputs[head]
        if self.outputs[head] != sort || inputs.len() != args.len {
            return Err("sort or arity mismatch: " + x.show().as_str())
        }
        var out = Vec(Pat).new()
        for i in 0..args.len { out.push(self.pattern(args[i], inputs[i], &vars)?) }
        Ok(Pat.App(head, out))
    }
}

// Hash-consed nodes `[head, args...]`: equal terms have equal ids.
struct Store {
    data: Vec(i64)
    starts: Vec(i64)
    table: Vec(i64)
    bits: i64
}

impl Store {
    fn new() -> Store {
        var starts = Vec(i64).new()
        starts.push(0)
        Store { data: Vec(i64).new(), starts, table: Vec(i64).filled(1 << 10, NONE), bits: 10 }
    }

    fn len(self) -> i64 { self.starts.len() - 1 }

    fn node(self, id: i64) -> [i64] { self.data.as_slice()[self.starts[id]..self.starts[id + 1]] }

    fn slot(self, key: [i64]) -> i64 {
        var h: u64 = 0xcbf29ce484222325
        for x in key { h = (h ^ (x as u64)) *% 0x100000001b3 }
        (h >> ((64 - self.bits) as u64)) as i64
    }

    fn same(self, id: i64, key: [i64]) -> bool {
        let start = self.starts[id]
        if self.starts[id + 1] - start != key.len { return false }
        for i in 0..key.len {
            if self.data[start + i] != key[i] { return false }
        }
        true
    }

    fn intern(inout self, key: [i64]) -> i64 {
        if 2 * self.len() >= self.table.len() {
            self.bits += 1
            self.table = Vec(i64).filled(1 << self.bits, NONE)
            let mask = self.table.len() - 1
            for id in 0..self.len() {
                var i = self.slot(self.node(id))
                while self.table[i] != NONE { i = (i + 1) & mask }
                self.table[i] = id
            }
        }
        let mask = self.table.len() - 1
        var i = self.slot(key)
        loop {
            let id = self.table[i]
            if id == NONE { break }
            if self.same(id, key) { return id }
            i = (i + 1) & mask
        }
        let id = self.len()
        for x in key { self.data.push(x) }
        self.starts.push(self.data.len())
        self.table[i] = id
        id
    }
}

struct Fact {
    judgment: i64
    // The hypothesis steps this step depends on, sorted.
    hyps: Vec(i64)
    is_hyp: bool
    // For a hypothesis: the premises it assumes its judgment from, and the
    // variables an application may instantiate. Both empty for a plain one.
    premises: Vec(i64)
    general: Vec(i64)
}

impl Fact {
    fn plain(judgment: i64, sink hyps: Vec(i64), is_hyp: bool) -> Fact {
        Fact { judgment, hyps, is_hyp, premises: Vec(i64).new(), general: Vec(i64).new() }
    }

    fn is_plain_hyp(self) -> bool {
        self.is_hyp && self.premises.len() == 0 && self.general.len() == 0
    }
}

pub struct Report {
    pub steps: i64
    pub goals: i64
    pub open_goals: i64
    pub hypotheses: i64
    pub inductions: i64
    pub inversions: i64
    pub instances: i64
}

fn contains(xs: [i64], x: i64) -> bool {
    for y in xs {
        if y == x { return true }
    }
    false
}

fn add_unique(inout xs: Vec(i64), x: i64) {
    if !contains(xs.as_slice(), x) { xs.push(x) }
}

// xs with x, kept sorted and without repeats.
fn add_sorted(inout xs: Vec(i64), x: i64) {
    var i = 0
    while i < xs.len() && xs[i] < x { i += 1 }
    if i < xs.len() && xs[i] == x { return }
    xs.insert(i, x)
}

fn subset(xs: [i64], ys: [i64]) -> bool {
    for x in xs {
        if !contains(ys, x) { return false }
    }
    true
}

fn copy(xs: [i64]) -> Vec(i64) {
    var out = Vec(i64).with_capacity(xs.len)
    for x in xs { out.push(x) }
    out
}

fn same_list(xs: [i64], ys: [i64]) -> bool {
    if xs.len != ys.len { return false }
    for i in 0..xs.len {
        if xs[i] != ys[i] { return false }
    }
    true
}

fn index(x: sexp.Sexp) -> Result(i64, String) {
    let Some(n) = x.atom()?.parse_int() else { return Err("expected a step index") }
    if n < 0 { return Err("expected a step index") }
    Ok(n)
}

// A substitution of terms for variables.
struct Subst { from: Vec(i64), to: Vec(i64) }

impl Subst {
    fn new() -> Subst { Subst { from: Vec(i64).new(), to: Vec(i64).new() } }

    fn one(x: i64, t: i64) -> Subst {
        var s = Subst.new()
        s.from.push(x)
        s.to.push(t)
        s
    }

    fn get(self, x: i64) -> i64 {
        for i in 0..self.from.len() {
            if self.from[i] == x { return self.to[i] }
        }
        NONE
    }

    fn has(self, x: i64) -> bool { self.get(x) != NONE }

    // Whether it binds x for the first time.
    fn bind(inout self, x: i64, t: i64) -> bool {
        if self.has(x) { return false }
        self.from.push(x)
        self.to.push(t)
        true
    }
}

impl Clone for Subst {
    fn clone(self) -> Subst { Subst { from: self.from.clone(), to: self.to.clone() } }
}

struct Checker {
    // The output sort of every symbol, then of every variable.
    output: Vec(i64)
    vars: Map(String, i64)
    store: Store
    // Whether each node contains a variable.
    open: Vec(bool)
    defs: Map(String, i64)
    facts: Vec(Fact)
    symbols: i64
}

impl Checker {
    fn new(th: Theory) -> Checker {
        Checker {
            output: th.outputs.clone()
            vars: Map(String, i64).new()
            store: Store.new()
            open: Vec(bool).new()
            defs: Map(String, i64).new()
            facts: Vec(Fact).new()
            symbols: th.names.len()
        }
    }

    fn next(self, n: i64) -> Result(i64, String) {
        if n != self.facts.len() {
            return Err(
                "step " + n.to_string() + ": expected next index " + self.facts.len().to_string()
            )
        }
        Ok(n)
    }

    fn declare(inout self, th: Theory, name: sexp.Sexp, sort: sexp.Sexp) -> Result((), String) {
        let n = name.atom()?
        let s = sort.atom()?
        let Some(sort) = lookup(th.sorts, s) else { return Err("unknown sort " + s) }
        let taken = lookup(th.ctors, n).is_some() || lookup(th.preds, n).is_some() ||
            lookup(self.vars, n).is_some()
        if n.starts_with("?") || taken {
            return Err("invalid or duplicate variable " + n)
        }
        self.vars.insert(n.to_string(), self.output.len())
        self.output.push(sort)
        Ok(())
    }

    fn var_sort(self, v: i64) -> i64 { self.output[v] }

    fn is_var(self, head: i64) -> bool { head >= self.symbols }

    fn sort(self, id: i64) -> i64 { self.output[self.store.node(id)[0]] }

    // The node, after checking its arity and argument sorts.
    fn make(inout self, th: Theory, key: [i64]) -> Result(i64, String) {
        let head = key[0]
        if self.is_var(head) {
            if key.len != 1 { return Err("sort or arity mismatch") }
        } else {
            let inputs = th.inputs[head]
            if inputs.len() + 1 != key.len { return Err("sort or arity mismatch") }
            for i in 0..inputs.len() {
                if self.sort(key[i + 1]) != inputs[i] { return Err("sort or arity mismatch") }
            }
        }
        let id = self.store.intern(key)
        if id == self.open.len() {
            var open = self.is_var(head)
            for i in 1..key.len {
                if self.open[key[i]] { open = true }
            }
            self.open.push(open)
        }
        Ok(id)
    }

    fn make1(inout self, th: Theory, head: i64) -> Result(i64, String) {
        var key = Vec(i64).new()
        key.push(head)
        self.make(th, key.as_slice())
    }

    // A term of the given sort, or of any sort when `sort` is NONE.
    fn term(inout self, th: Theory, x: sexp.Sexp, sort: i64) -> Result(i64, String) {
        var id: i64 = 0
        match x {
            Atom(a) => {
                if a.as_str().starts_with("?") {
                    let Some(d) = lookup(self.defs, a.as_str()) else {
                        return Err("undefined abbreviation " + a.as_str())
                    }
                    id = d
                } else {
                    var head = NONE
                    match lookup(self.vars, a.as_str()) {
                        Some(v) => head = v
                        None => head = th.ctor(a.as_str())?
                    }
                    id = self.make1(th, head)?
                }
            }
            List(xs) => {
                if xs.len() == 0 { return Err("empty term") }
                let head = th.ctor(xs[0].atom()?)?
                if xs.len() == 1 { return Err("nullary constructors must be atoms") }
                var key = Vec(i64).new()
                key.push(head)
                for i in 1..xs.len() { key.push(self.term(th, xs[i], NONE)?) }
                id = self.make(th, key.as_slice())?
            }
        }
        let s = self.sort(id)
        if (sort != NONE && s != sort) || s == PROP {
            return Err("ill-sorted term " + x.show().as_str())
        }
        Ok(id)
    }

    fn judgment(inout self, th: Theory, x: sexp.Sexp) -> Result(i64, String) {
        let xs = x.list()?
        if xs.len == 0 { return Err("empty judgment") }
        var key = Vec(i64).new()
        key.push(th.pred(xs[0].atom()?)?)
        for i in 1..xs.len { key.push(self.term(th, xs[i], NONE)?) }
        self.make(th, key.as_slice())
    }

    fn judgments(inout self, th: Theory, x: sexp.Sexp) -> Result(Vec(i64), String) {
        var out = Vec(i64).new()
        for j in x.list()? { out.push(self.judgment(th, j)?) }
        Ok(out)
    }

    fn variable(self, x: sexp.Sexp) -> Result(i64, String) {
        let a = x.atom()?
        let Some(v) = lookup(self.vars, a) else { return Err("unknown variable " + a) }
        Ok(v)
    }

    fn substitute(inout self, th: Theory, id: i64, map: Subst) -> i64 {
        if !self.open[id] { return id }
        let node = copy(self.store.node(id))
        if node.len() == 1 {
            let t = map.get(node[0])
            return if t == NONE { id } else { t }
        }
        var key = Vec(i64).new()
        key.push(node[0])
        for i in 1..node.len() { key.push(self.substitute(th, node[i], map)) }
        // Terms of the same sorts as the variables keep the sorts right.
        match self.make(th, key.as_slice()) {
            Ok(r) => r
            Err(_) => panic("substitution changed a sort")
        }
    }

    fn at(inout self, th: Theory, t: i64, x: i64, by: i64) -> i64 {
        self.substitute(th, t, Subst.one(x, by))
    }

    fn variables(self, id: i64, inout out: Vec(i64)) {
        if !self.open[id] { return }
        let node = self.store.node(id)
        if node.len == 1 { add_unique(&out, node[0]) }
        for i in 1..node.len { self.variables(node[i], &out) }
    }

    fn variables_of(self, id: i64) -> Vec(i64) {
        var out = Vec(i64).new()
        self.variables(id, &out)
        out
    }

    // A premise or result reference: its judgment and hypotheses.
    fn reference(inout self, th: Theory, x: sexp.Sexp) -> Result((i64, Vec(i64)), String) {
        if !x.is_list() {
            let n = index(x)?
            if n >= self.facts.len() { return Err("reference to a later step") }
            return Ok((self.facts[n].judgment, self.facts[n].hyps.clone()))
        }
        let xs = x.list()?
        if xs.len == 0 { return Err("empty reference") }
        let n = index(xs[0])?
        if n >= self.facts.len() { return Err("reference to a later step") }
        if self.facts[n].hyps.len() != 0 {
            return Err("instance of step " + n.to_string() + ", which has hypotheses")
        }
        let judgment = self.facts[n].judgment
        var map = Subst.new()
        for i in 1..xs.len {
            let ys = xs[i].list()?
            if ys.len != 2 { return Err("expected (VAR TERM)") }
            let v = self.variable(ys[0])?
            let sort = self.var_sort(v)
            let t = self.term(th, ys[1], sort)?
            if !map.bind(v, t) { return Err("variable substituted twice") }
        }
        Ok((self.substitute(th, judgment, map), Vec(i64).new()))
    }

    fn matches(self, p: Pat, id: i64, inout bindings: Vec(i64)) -> bool {
        match p {
            Var(v) => {
                if bindings[v] == NONE {
                    bindings[v] = id
                    return true
                }
                bindings[v] == id
            }
            App(head, args) => {
                let node = self.store.node(id)
                if node[0] != head || node.len != args.len() + 1 { return false }
                for i in 0..args.len() {
                    if !self.matches(args[i], node[i + 1], &bindings) { return false }
                }
                true
            }
        }
    }

    fn build(inout self, th: Theory, p: Pat, bindings: [i64]) -> Result(i64, String) {
        match p {
            Var(v) => {
                if bindings[v] == NONE { return Err("unbound conclusion variable") }
                Ok(bindings[v])
            }
            App(head, args) => {
                var key = Vec(i64).new()
                key.push(head)
                for a in args { key.push(self.build(th, a, bindings)?) }
                self.make(th, key.as_slice())
            }
        }
    }

    // Whether the variables of every term in `ts` are among those of
    // `judgment` and of the hypotheses `hyps` fix.
    fn grounded(self, judgment: i64, hyps: [i64], ts: [i64]) -> bool {
        var allowed = self.variables_of(judgment)
        for h in hyps { self.hyp_vars(h, &allowed) }
        for t in ts {
            if !subset(self.variables_of(t).as_slice(), allowed.as_slice()) { return false }
        }
        true
    }

    // `RULE (REF...) ITEM...`; returns the number of instance references.
    fn step(inout self, th: Theory, xs: [sexp.Sexp]) -> Result(i64, String) {
        let n = self.facts.len()
        let at = "step " + n.to_string()
        let r = th.rule(xs[0].atom()?)?
        let rule = th.rules[r]
        let refs = xs[1].list()?
        if refs.len != rule.premises.len() { return Err(at + ": wrong number of premises") }
        var premises = Vec(i64).new()
        var hyps = Vec(i64).new()
        var instances = 0
        for x in refs {
            let (j, h) = self.reference(th, x)?
            if x.is_list() { instances += 1 }
            premises.push(j)
            for k in h { add_sorted(&hyps, k) }
        }
        var bindings = Vec(i64).filled(rule.vars.len(), NONE)
        var bound = Vec(i64).new()
        var stated = NONE
        for i in 2..xs.len {
            let ys = xs[i].list()?
            if ys.len == 0 { return Err("empty item") }
            let head = ys[0].atom()?
            if head.starts_with("?") && ys.len == 2 {
                var v = NONE
                for k in 0..rule.vars.len() {
                    if rule.vars[k].0 == head { v = k }
                }
                if v == NONE { return Err(at + ": unknown variable " + head) }
                let value = self.term(th, ys[1], rule.vars[v].1)?
                if bindings[v] != NONE { return Err(at + ": invalid binding") }
                bindings[v] = value
                bound.push(value)
            } else {
                if stated != NONE { return Err(at + ": more than one conclusion") }
                stated = self.judgment(th, xs[i])?
            }
        }
        if stated != NONE && !self.matches(rule.conclusion, stated, &bindings) {
            return Err(at + " (" + rule.name.as_str() + "): conclusion mismatch")
        }
        for i in 0..premises.len() {
            if !self.matches(rule.premises[i], premises[i], &bindings) {
                return Err(at + " (" + rule.name.as_str() + "): premise mismatch")
            }
        }
        let judgment = if stated != NONE { stated } else { self.build(
            th,
            rule.conclusion,
            bindings.as_slice()
        )? }
        var used = premises.clone()
        for b in bound { used.push(b) }
        var open = false
        for t in used {
            if self.open[t] { open = true }
        }
        // Grounding the conclusion and hypotheses must ground the premises,
        // or a variable of an empty sort could stand for a term that does
        // not exist.
        if open && !self.grounded(judgment, hyps.as_slice(), used.as_slice()) {
            return Err(
                at + " (" + rule.name.as_str() + "): premise variable absent from the conclusion"
            )
        }
        self.facts.push(Fact.plain(judgment, hyps, false))
        Ok(instances)
    }

    // The variables a hypothesis fixes: all but those it generalizes.
    fn hyp_vars(self, h: i64, inout out: Vec(i64)) {
        let f = self.facts[h]
        var vs = self.variables_of(f.judgment)
        for p in f.premises { self.variables(p, &vs) }
        for v in vs {
            if !contains(f.general.as_slice(), v) { add_unique(&out, v) }
        }
    }

    fn vars_list(self, x: sexp.Sexp) -> Result(Vec(i64), String) {
        var out = Vec(i64).new()
        for y in x.list()? {
            let v = self.variable(y)?
            if contains(out.as_slice(), v) { return Err("a variable is listed twice") }
            out.push(v)
        }
        Ok(out)
    }

    // Hypothesis steps: plain ones only when `plain`.
    fn hyp_list(self, x: sexp.Sexp, plain: bool) -> Result(Vec(i64), String) {
        var out = Vec(i64).new()
        for y in x.list()? {
            let i = index(y)?
            if i >= self.facts.len() { return Err("reference to a later step") }
            if plain && !self.facts[i].is_plain_hyp() {
                return Err("step " + i.to_string() + " is not a plain hypothesis")
            }
            if !self.facts[i].is_hyp { return Err("step " + i.to_string() + " is not a hypothesis") }
            add_sorted(&out, i)
        }
        Ok(out)
    }

    // `(hyp N (P...) J (X...))`: assume the rule P ⊢ J, whose variables X
    // an application may instantiate.
    fn rule_hyp(
        inout self,
        th: Theory,
        n: i64,
        ps: sexp.Sexp,
        j: sexp.Sexp,
        xs: sexp.Sexp
    ) -> Result((), String) {
        let premises = self.judgments(th, ps)?
        let judgment = self.judgment(th, j)?
        let general = self.vars_list(xs)?
        var hyps = Vec(i64).new()
        hyps.push(n)
        self.facts.push(Fact { judgment, hyps, is_hyp: true, premises, general })
        Ok(())
    }

    // `(X TERM)...`, with sort checks.
    fn bindings(inout self, th: Theory, x: sexp.Sexp) -> Result(Subst, String) {
        var map = Subst.new()
        for b in x.list()? {
            let ys = b.list()?
            if ys.len != 2 { return Err("expected (VAR TERM)") }
            let v = self.variable(ys[0])?
            let sort = self.var_sort(v)
            let t = self.term(th, ys[1], sort)?
            if !map.bind(v, t) { return Err("variable substituted twice") }
        }
        Ok(map)
    }

    // `(apply N M (BIND...) (REF...))`: use the rule hypothesis M, or an
    // earlier fact M whose hypotheses are plain, as a derived rule. The
    // references prove its premises (for a fact, its hypotheses in step
    // order) under the bindings.
    fn apply(
        inout self,
        th: Theory,
        m: sexp.Sexp,
        binds: sexp.Sexp,
        refs: sexp.Sexp
    ) -> Result((), String) {
        let n = self.facts.len()
        let at = "step " + n.to_string()
        let mi = index(m)?
        let map = self.bindings(th, binds)?
        if mi >= self.facts.len() { return Err("reference to a later step") }
        var premises = Vec(i64).new()
        var hyps = Vec(i64).new()
        let conclusion = self.facts[mi].judgment
        if self.facts[mi].is_hyp {
            for v in map.from {
                if !contains(self.facts[mi].general.as_slice(), v) {
                    return Err(
                        at + ": binds a variable step " + mi.to_string() + " does not generalize"
                    )
                }
            }
            premises = self.facts[mi].premises.clone()
            hyps.push(mi)
        } else {
            for h in self.facts[mi].hyps {
                if !self.facts[h].is_plain_hyp() {
                    return Err(at + ": step " + mi.to_string() + " depends on a rule hypothesis")
                }
                premises.push(self.facts[h].judgment)
            }
        }
        let rs = refs.list()?
        if rs.len != premises.len() { return Err(at + ": wrong number of premises") }
        let judgment = self.substitute(th, conclusion, map)
        var used = Vec(i64).new()
        for i in 0..rs.len {
            let want = self.substitute(th, premises[i], map)
            let (got, h) = self.reference(th, rs[i])?
            if got != want { return Err(at + ": a premise does not match") }
            for k in h { add_sorted(&hyps, k) }
            used.push(want)
        }
        for t in map.to { used.push(t) }
        if !self.grounded(judgment, hyps.as_slice(), used.as_slice()) {
            return Err(at + ": premise variable absent from the conclusion")
        }
        self.facts.push(Fact.plain(judgment, hyps, false))
        Ok(())
    }

    // `(induct N X (H...) J (CASE...))`: for every X, the plain hypotheses
    // H give J. Case i concludes J[X := cᵢ(Y...)] from H[X := cᵢ(Y...)]
    // and, for each Y of X's sort, the induction hypothesis
    // H[X := Y] ⊢ J[X := Y] as a rule hypothesis generalizing any of the
    // other variables. With no H, the induction hypothesis may also be the
    // plain hypothesis J[X := Y].
    fn induct(
        inout self, th: Theory, xv: sexp.Sexp, hs: [sexp.Sexp], j: sexp.Sexp, cases: sexp.Sexp
    ) -> Result((), String) {
        let n = self.facts.len()
        let at = "step " + n.to_string()
        let x = self.variable(xv)?
        var hyps = Vec(i64).new()
        // `hs` is empty, or the one list of hypotheses.
        for h in hs { hyps = self.hyp_list(h, true)? }
        var premises = Vec(i64).new()
        for h in hyps { premises.push(self.facts[h].judgment) }
        let judgment = self.judgment(th, j)?
        let sort = self.output[x]
        let ctors = th.by_sort[sort]
        let cs = cases.list()?
        if cs.len != ctors.len() { return Err(
            at + ": expected " + ctors.len().to_string() + " cases"
        ) }
        var in_motive = self.variables_of(judgment)
        for p in premises { self.variables(p, &in_motive) }
        // Otherwise, for a sort whose every constructor is recursive (a sort
        // without ground terms), each case could be its own hypothesis, and
        // the conclusion would not keep the vacuous quantifier.
        if !contains(in_motive.as_slice(), x) {
            return Err(at + ": the induction variable must occur in the judgment")
        }
        for ci in 0..cs.len {
            let c = ctors[ci]
            let ys = cs[ci].list()?
            if ys.len == 0 { return Err("empty case") }
            let m = index(ys[0])?
            let inputs = th.inputs[c]
            if ys.len != inputs.len() + 1 { return Err(
                at + ": case variables do not match the constructor"
            ) }
            var fresh = Vec(i64).new()
            for i in 0..inputs.len() {
                let v = self.variable(ys[i + 1])?
                let repeated = contains(in_motive.as_slice(), v) || contains(fresh.as_slice(), v)
                if self.output[v] != inputs[i] || repeated {
                    return Err(at + ": invalid case variable " + ys[i + 1].show().as_str())
                }
                fresh.push(v)
            }
            var key = Vec(i64).new()
            key.push(c)
            for v in fresh { key.push(self.make1(th, v)?) }
            let term = self.make(th, key.as_slice())?
            let want = self.at(th, judgment, x, term)
            var case_premises = Vec(i64).new()
            for p in premises { case_premises.push(self.at(th, p, x, term)) }
            // Induction hypotheses: premises and conclusion at each Y.
            var ih_premises = Vec(Vec(i64)).new()
            var ih_concl = Vec(i64).new()
            for i in 0..fresh.len() {
                if inputs[i] == sort {
                    let y = self.make1(th, fresh[i])?
                    var ps = Vec(i64).new()
                    for p in premises { ps.push(self.at(th, p, x, y)) }
                    ih_premises.push(ps)
                    ih_concl.push(self.at(th, judgment, x, y))
                }
            }
            if m >= self.facts.len() { return Err("case refers to a later step") }
            if self.facts[m].judgment != want {
                return Err(at + ": case " + m.to_string() + " proves the wrong judgment")
            }
            for h in self.facts[m].hyps {
                let f = self.facts[h]
                var ok = false
                if f.is_plain_hyp() {
                    ok = contains(case_premises.as_slice(), f.judgment) ||
                        (premises.len() == 0 && contains(ih_concl.as_slice(), f.judgment))
                } else if f.is_hyp {
                    var general_ok = true
                    for g in f.general {
                        if g == x || !contains(in_motive.as_slice(), g) { general_ok = false }
                    }
                    if general_ok {
                        for k in 0..ih_concl.len() {
                            let same = same_list(ih_premises[k].as_slice(), f.premises.as_slice())
                            if ih_concl[k] == f.judgment && same {
                                ok = true
                            }
                        }
                    }
                }
                if !ok {
                    return Err(
                        at + ": case " + m.to_string() + " uses a hypothesis that is not an induction hypothesis"
                    )
                }
            }
        }
        self.facts.push(Fact.plain(judgment, hyps, false))
        Ok(())
    }

    // A most general unifier of two terms, every variable a unification
    // variable; None when there is none.
    fn unify(inout self, th: Theory, a: i64, b: i64) -> Option(Subst) {
        var theta = Subst.new()
        var work = Vec((i64, i64)).new()
        work.push((a, b))
        loop {
            let Some(pair) = work.pop() else { break }
            let s = self.substitute(th, pair.0, theta)
            let t = self.substitute(th, pair.1, theta)
            if s == t { continue }
            let ns = copy(self.store.node(s))
            let nt = copy(self.store.node(t))
            var x = NONE
            var u = NONE
            if ns.len() == 1 && self.is_var(ns[0]) {
                x = ns[0]
                u = t
            } else if nt.len() == 1 && self.is_var(nt[0]) {
                x = nt[0]
                u = s
            } else {
                if ns[0] != nt[0] || ns.len() != nt.len() { return None }
                for i in 1..ns.len() { work.push((ns[i], nt[i])) }
                continue
            }
            if contains(self.variables_of(u).as_slice(), x) { return None }
            let single = Subst.one(x, u)
            for i in 0..theta.to.len() {
                let v = theta.to[i]
                theta.to[i] = self.substitute(th, v, single)
            }
            theta.bind(x, u)
        }
        Some(theta)
    }

    // `(invert N K (C...) J (CASE...))`, `CASE = (RULE M (X...))`: the plain
    // hypothesis K was derived by some rule. For each rule whose conclusion
    // unifies with K's judgment, its variables renamed to the fresh X, case
    // M concludes θJ for the most general unifier θ, from θ(the rule's
    // premises) and θC.
    fn invert(
        inout self, th: Theory, k: sexp.Sexp, cs: sexp.Sexp, j: sexp.Sexp, cases: sexp.Sexp
    ) -> Result((), String) {
        let n = self.facts.len()
        let at = "step " + n.to_string()
        let ki = index(k)?
        if ki >= self.facts.len() { return Err("reference to a later step") }
        if !self.facts[ki].is_plain_hyp() {
            return Err(at + ": step " + ki.to_string() + " is not a plain hypothesis")
        }
        let h = self.facts[ki].judgment
        let context = self.hyp_list(cs, false)?
        let judgment = self.judgment(th, j)?
        var used = self.variables_of(h)
        self.variables(judgment, &used)
        for c in context {
            self.variables(self.facts[c].judgment, &used)
            for p in self.facts[c].premises { self.variables(p, &used) }
        }
        let pred = self.store.node(h)[0]
        var given_names = Vec(String).new()
        var given_steps = Vec(i64).new()
        var given_vars = Vec(Vec(i64)).new()
        for case in cases.list()? {
            let ys = case.list()?
            if ys.len != 3 { return Err(at + ": expected (RULE STEP (VAR...))") }
            let rname = ys[0].atom()?
            for g in given_names {
                if g == rname { return Err(at + ": two cases for rule " + rname) }
            }
            given_names.push(rname.to_string())
            given_steps.push(index(ys[1])?)
            given_vars.push(self.vars_list(ys[2])?)
        }
        var fresh_seen = Vec(i64).new()
        for r in th.by_pred[pred] {
            let rule = th.rules[r]
            var g = NONE
            for i in 0..given_names.len() {
                if given_names[i] == rule.name { g = i }
            }
            // Rename the rule's variables apart: to the case's variables, or
            // to internal ones when no case is given.
            var names = Vec(i64).new()
            if g != NONE {
                let xs = given_vars[g]
                if xs.len() != rule.vars.len() {
                    return Err(at + ": wrong variables for rule " + rule.name.as_str())
                }
                for i in 0..xs.len() {
                    if self.output[xs[i]] != rule.vars[i].1 {
                        return Err(at + ": wrong variables for rule " + rule.name.as_str())
                    }
                    if contains(used.as_slice(), xs[i]) || contains(fresh_seen.as_slice(), xs[i]) {
                        return Err(at + ": case variables must be fresh")
                    }
                    fresh_seen.push(xs[i])
                }
                names = xs.clone()
            } else {
                for v in rule.vars {
                    names.push(self.output.len())
                    self.output.push(v.1)
                }
            }
            var env = Vec(i64).new()
            for v in names { env.push(self.make1(th, v)?) }
            let concl = self.build(th, rule.conclusion, env.as_slice())?
            let Some(theta) = self.unify(th, h, concl) else {
                if g != NONE { return Err(
                    at + ": rule " + rule.name.as_str() + " cannot conclude it"
                ) }
                continue
            }
            if g == NONE { return Err(at + ": missing case for rule " + rule.name.as_str()) }
            let m = given_steps[g]
            let want = self.substitute(th, judgment, theta)
            // What the case may assume: the rule's premises and the context,
            // under θ. A rule hypothesis keeps its generalized variables, so
            // θ applies to the others only and must not capture them.
            var allowed_premises = Vec(Vec(i64)).new()
            var allowed_concl = Vec(i64).new()
            var allowed_general = Vec(Vec(i64)).new()
            for p in rule.premises {
                let q = self.build(th, p, env.as_slice())?
                allowed_premises.push(Vec(i64).new())
                allowed_concl.push(self.substitute(th, q, theta))
                allowed_general.push(Vec(i64).new())
            }
            for c in context {
                let general = self.facts[c].general.clone()
                var local = Subst.new()
                for i in 0..theta.from.len() {
                    if !contains(general.as_slice(), theta.from[i]) {
                        local.bind(theta.from[i], theta.to[i])
                        for v in self.variables_of(theta.to[i]) {
                            if contains(general.as_slice(), v) {
                                return Err(
                                    at + ": the unifier would capture a generalized variable"
                                )
                            }
                        }
                    }
                }
                var ps = Vec(i64).new()
                let premises = self.facts[c].premises.clone()
                for p in premises { ps.push(self.substitute(th, p, local)) }
                let cj = self.facts[c].judgment
                allowed_premises.push(ps)
                allowed_concl.push(self.substitute(th, cj, local))
                allowed_general.push(general)
            }
            if m >= self.facts.len() { return Err("case refers to a later step") }
            if self.facts[m].judgment != want {
                return Err(at + ": case " + m.to_string() + " proves the wrong judgment")
            }
            for hh in self.facts[m].hyps {
                let hf = self.facts[hh]
                var ok = false
                if hf.is_hyp {
                    for i in 0..allowed_concl.len() {
                        let same = same_list(allowed_premises[i].as_slice(), hf.premises.as_slice()) &&
                            same_list(allowed_general[i].as_slice(), hf.general.as_slice())
                        if allowed_concl[i] == hf.judgment && same {
                            ok = true
                        }
                    }
                }
                if !ok { return Err(
                    at + ": case " + m.to_string() + " uses a hypothesis it may not"
                ) }
            }
        }
        var hyps = context
        add_sorted(&hyps, ki)
        self.facts.push(Fact.plain(judgment, hyps, false))
        Ok(())
    }
}

// Check `proof` against `goals` in `theory`: every goal has exactly one
// result, which derives it from the theory under the goal's hypotheses.
pub fn check(theory: str, goals: str, proof: str) -> Result(Report, String) {
    let th = Theory.parse(theory)?
    var ck = Checker.new(th)
    var report = Report {
        steps: 0, goals: 0, open_goals: 0, hypotheses: 0, inductions: 0, inversions: 0, instances: 0
    }
    var goal_names = Vec(String).new()
    var goal_judgments = Vec(i64).new()
    var goal_hyps = Vec(Vec(i64)).new()
    var done = Vec(bool).new()
    for form in sexp.parse(goals)? {
        let xs = form.list()?
        if xs.len >= 1 && xs[0].atom()? == "var" && xs.len == 3 {
            ck.declare(th, xs[1], xs[2])?
        } else if xs.len >= 1 && xs[0].atom()? == "goal" && (xs.len == 3 || xs.len == 4) {
            // `(goal NAME J)`, or `(goal NAME (H...) J)`: H implies J.
            var hs = Vec(i64).new()
            if xs.len == 4 { hs = ck.judgments(th, xs[2])? }
            let j = ck.judgment(th, xs[xs.len - 1])?
            if ck.open[j] { report.open_goals += 1 }
            let key = xs[1].atom()?
            for g in goal_names {
                if g == key { return Err("duplicate goal") }
            }
            goal_names.push(key.to_string())
            goal_judgments.push(j)
            goal_hyps.push(hs)
            done.push(false)
        } else {
            return Err("invalid goal form: " + form.show().as_str())
        }
    }
    if goal_names.len() == 0 { return Err("no expected goals") }
    report.goals = goal_names.len()
    for form in sexp.parse(proof)? {
        let xs = form.list()?
        if xs.len == 0 { return Err("empty form") }
        let tag = xs[0].atom()?
        if tag == "var" && xs.len == 3 {
            ck.declare(th, xs[1], xs[2])?
        } else if tag == "def" && xs.len == 3 {
            let key = xs[1].atom()?
            if !key.starts_with("?") || key.len == 1 { return Err(
                "invalid abbreviation name " + key
            ) }
            let t = ck.term(th, xs[2], NONE)?
            if ck.defs.insert(key.to_string(), t).is_some() { return Err("duplicate abbreviation") }
        } else if tag == "step" && xs.len >= 4 {
            ck.next(index(xs[1])?)?
            report.instances += ck.step(th, xs[2..])?
        } else if tag == "hyp" && xs.len == 3 {
            let n = ck.next(index(xs[1])?)?
            let j = ck.judgment(th, xs[2])?
            var hyps = Vec(i64).new()
            hyps.push(n)
            ck.facts.push(Fact.plain(j, hyps, true))
            report.hypotheses += 1
        } else if tag == "hyp" && xs.len == 5 {
            let n = ck.next(index(xs[1])?)?
            ck.rule_hyp(th, n, xs[2], xs[3], xs[4])?
            report.hypotheses += 1
        } else if tag == "induct" && xs.len == 5 {
            ck.next(index(xs[1])?)?
            ck.induct(th, xs[2], xs[3..3], xs[3], xs[4])?
            report.inductions += 1
        } else if tag == "induct" && xs.len == 6 {
            ck.next(index(xs[1])?)?
            ck.induct(th, xs[2], xs[3..4], xs[4], xs[5])?
            report.inductions += 1
        } else if tag == "apply" && xs.len == 5 {
            ck.next(index(xs[1])?)?
            ck.apply(th, xs[2], xs[3], xs[4])?
        } else if tag == "invert" && xs.len == 6 {
            ck.next(index(xs[1])?)?
            ck.invert(th, xs[2], xs[3], xs[4], xs[5])?
            report.inversions += 1
        } else if tag == "result" && xs.len == 3 {
            let key = xs[1].atom()?
            var g = NONE
            for i in 0..goal_names.len() {
                if goal_names[i] == key && !done[i] { g = i }
            }
            if g == NONE { return Err("unknown or repeated result " + key) }
            done[g] = true
            let (fact, hyps) = ck.reference(th, xs[2])?
            // The result may use only plain hypotheses its goal states.
            for h in hyps {
                let stated = contains(goal_hyps[g].as_slice(), ck.facts[h].judgment)
                if !ck.facts[h].is_plain_hyp() || !stated {
                    return Err("result " + key + " depends on hypotheses")
                }
            }
            if fact != goal_judgments[g] { return Err("result " + key + " does not match its goal") }
        } else {
            return Err("invalid proof form: " + tag)
        }
    }
    for i in 0..done.len() {
        if !done[i] { return Err("missing result: " + goal_names[i].as_str()) }
    }
    report.steps = ck.facts.len()
    Ok(report)
}

// Horn's tests/schematic.rs and tests/implication.rs.

fn accepts(theory: str, goals: str, proof: str) -> Report {
    match check(theory, goals, proof) {
        Ok(r) => r
        Err(e) => panic("rejected: " + e.as_str())
    }
}

fn rejects(theory: str, goals: str, proof: str, reason: str) {
    match check(theory, goals, proof) {
        Ok(_) => panic("accepted, expected rejection: " + reason)
        Err(e) => assert(e.as_str().contains(reason), "rejected for another reason: " + e.as_str())
    }
}

// `s` with its one `old` replaced by `new`.
fn edit(s: str, old: str, new: str) -> String {
    let Some(i) = s.find(old) else { panic("no " + old) }
    s[0..i] + new + s[i + old.len..s.len]
}

fn nat() -> String {
    String.from("(sort N) (ctor z () N) (ctor s (N) N) (pred max (N N N))") +
        "(rule max.z () (max z ?n ?n)) (rule max.sz () (max (s ?n) z (s ?n)))" +
        "(rule max.ss ((max ?m ?n ?k)) (max (s ?m) (s ?n) (s ?k)))"
}

const NAT_GOALS: str = "(var L N) (goal idem (max L L L)) (goal two (max (s (s z)) (s (s z)) (s (s z))))"

// `max l l l` is admissible, not derivable: it needs induction on l.
fn idem() -> String {
    String.from("(var P N) (step 0 max.z () (?n z)) (hyp 1 (max P P P)) (step 2 max.ss (1))") +
        "(induct 3 L (max L L L) ((0) (2 P))) (result idem 3) (result two (3 (L (s (s z)))))"
}

#[test]
fn induction_proves_an_admissible_rule() {
    let r = accepts(nat().as_str(), NAT_GOALS, idem().as_str())
    assert(r.goals == 2 && r.open_goals == 1 && r.inductions == 1 && r.instances == 0, "counts")
}

#[test]
fn induction_rejects_a_case_for_the_wrong_constructor() {
    let th = nat()
    let p = idem()
    rejects(
        th.as_str(),
        NAT_GOALS,
        edit(p.as_str(), "((0) (2 P))", "((0) (0 P))").as_str(),
        "proves the wrong judgment"
    )
    rejects(
        th.as_str(),
        NAT_GOALS,
        edit(p.as_str(), "((0) (2 P))", "((2 P) (0))").as_str(),
        "case variables do not match"
    )
}

#[test]
fn induction_rejects_a_case_proving_another_judgment() {
    let bad = edit(idem().as_str(), "(step 0 max.z () (?n z))", "(step 0 max.z () (?n (s z)))")
    rejects(nat().as_str(), NAT_GOALS, bad.as_str(), "proves the wrong judgment")
}

#[test]
fn induction_rejects_a_hypothesis_that_is_not_the_inductive_one() {
    // Assuming the conclusion itself is circular.
    let bad = String.from("(var P N) (step 0 max.z () (?n z)) (hyp 1 (max (s P) (s P) (s P)))") +
        "(induct 2 L (max L L L) ((0) (1 P))) (result idem 2) (result two (2 (L (s (s z)))))"
    rejects(nat().as_str(), NAT_GOALS, bad.as_str(), "not an induction hypothesis")
}

#[test]
fn induction_rejects_a_case_variable_of_the_judgment() {
    let goals = "(var L N) (var P N) (goal g (max L P P))"
    let bad = "(step 0 max.z () (?n P)) (hyp 1 (max P P P)) (step 2 max.ss (1)) (induct 3 L (max L P P) ((0) (2 P))) (result g 3)"
    rejects(nat().as_str(), goals, bad, "invalid case variable")
}

#[test]
fn results_and_instances_cannot_depend_on_hypotheses() {
    rejects(
        nat().as_str(),
        NAT_GOALS,
        "(hyp 0 (max L L L)) (result idem 0)",
        "depends on hypotheses"
    )
    rejects(
        nat().as_str(),
        NAT_GOALS,
        "(hyp 0 (max L L L)) (step 1 max.ss ((0 (L z))))",
        "which has hypotheses"
    )
}

#[test]
fn instances_substitute_only_well_sorted_terms() {
    let th = nat() + " (sort B) (ctor t () B)"
    let bad = edit(idem().as_str(), "(3 (L (s (s z))))", "(3 (L t))")
    rejects(th.as_str(), NAT_GOALS, bad.as_str(), "ill-sorted term")
}

#[test]
fn a_free_premise_variable_of_an_empty_sort_is_rejected() {
    // E has no constructors, so `q` is not derivable: a derivation of
    // `(p X)` for a variable X of sort E has no ground instance.
    let th = "(sort E) (pred p (E)) (pred q ()) (rule intro () (p ?x)) (rule elim ((p ?x)) (q))"
    let proof = "(var X E) (step 0 intro () (p X)) (step 1 elim (0)) (result g 1)"
    rejects(th, "(goal g (q))", proof, "premise variable absent")
}

#[test]
fn ground_certificates_keep_their_verdict() {
    let th = "(sort Nat) (ctor zero () Nat) (ctor succ (Nat) Nat) (pred even (Nat)) (rule zero () (even zero)) (rule plus-two ((even ?n)) (even (succ (succ ?n))))"
    let goals = "(goal four-is-even (even (succ (succ (succ (succ zero))))))"
    accepts(
        th,
        goals,
        "(step 0 zero ()) (step 1 plus-two (0)) (step 2 plus-two (1)) (result four-is-even 2)"
    )
    rejects(
        th,
        goals,
        "(step 0 zero ()) (step 1 plus-two (0)) (result four-is-even 1)",
        "does not match its goal"
    )
}

#[test]
fn induction_variable_must_occur_in_the_judgment() {
    // S has no ground terms, so `false` has no derivation. If X did not
    // occur in the judgment, the only case could be its own hypothesis.
    let th = "(sort S) (ctor next (S) S) (pred false ())"
    let bad = "(var Y S) (hyp 0 (false)) (induct 1 X (false) ((0 Y))) (result g 1)"
    rejects(th, "(var X S) (goal g (false))", bad, "must occur in the judgment")
}

const LE: str = "(sort N) (ctor z () N) (ctor s (N) N) (pred le (N N)) (rule le.zero () (le z ?n)) (rule le.succ ((le ?m ?n)) (le (s ?m) (s ?n)))"

const LE_GOALS: str = "(var A N) (var B N) (var C N) (goal trans ((le A B) (le B C)) (le A C))"

// Transitivity of `le`, by induction on A and inversion of both hypotheses.
fn trans() -> String {
    String.from("(var P N) (var M N) (var Nn N) (var M2 N) (var N2 N)") +
        "(hyp 0 (le A B)) (hyp 1 (le B C)) (step 2 le.zero () (le z C)) (hyp 3 (le (s P) B))" +
        "(hyp 4 (le B C)) (hyp 5 ((le P B) (le B C)) (le P C) (B C)) (hyp 6 (le M Nn))" +
        "(hyp 7 (le (s Nn) C)) (hyp 8 ((le M B) (le B C)) (le M C) (B C)) (hyp 9 (le M2 N2))" +
        "(hyp 10 (le M M2)) (hyp 11 ((le M B) (le B C)) (le M C) (B C))" +
        "(apply 12 11 ((B M2) (C N2)) (10 9)) (step 13 le.succ (12) (le (s M) (s N2)))" +
        "(invert 14 7 (6 8) (le (s M) C) ((le.succ 13 (M2 N2))))" +
        "(invert 15 3 (4 5) (le (s P) C) ((le.succ 14 (M Nn))))" +
        "(induct 16 A (0 1) (le A C) ((2) (15 P))) (result trans 16)"
}

#[test]
fn transitivity_by_induction_and_inversion() {
    let r = accepts(LE, LE_GOALS, trans().as_str())
    assert(r.goals == 1 && r.inductions == 1 && r.inversions == 2, "counts")
}

#[test]
fn an_impossible_hypothesis_proves_anything() {
    // No rule concludes le (s A) z, so inversion needs no case.
    let goals = "(var A N) (goal g ((le (s A) z)) (le (s z) z))"
    accepts(LE, goals, "(hyp 0 (le (s A) z)) (invert 1 0 () (le (s z) z) ()) (result g 1)")
}

#[test]
fn inversion_needs_every_possible_rule() {
    // le A B may come from either rule.
    let goals = "(var A N) (var B N) (goal g ((le A (s B))) (le z (s B)))"
    let proof = "(var M N) (var K N) (hyp 0 (le A (s B))) (step 1 le.zero () (le z (s B))) (invert 2 0 () (le z (s B)) ((le.zero 1 (K)))) (result g 2)"
    rejects(LE, goals, proof, "missing case for rule le.succ")
}

#[test]
fn an_inversion_case_must_prove_the_unified_goal() {
    let bad = edit(
        trans().as_str(), "(invert 15 3 (4 5) (le (s P) C)", "(invert 15 3 (4 5) (le P C)"
    )
    rejects(LE, LE_GOALS, bad.as_str(), "proves the wrong judgment")
}

#[test]
fn an_inversion_case_may_not_assume_more() {
    let bad = edit(trans().as_str(), "(invert 14 7 (6 8)", "(invert 14 7 (8)")
    rejects(LE, LE_GOALS, bad.as_str(), "uses a hypothesis it may not")
}

#[test]
fn the_unifier_may_not_capture_a_generalized_variable() {
    // Unifying eq X (f B) with eq K K gives X := f B, but hypothesis 1
    // generalizes B: substituting would capture it.
    let th = "(sort N) (ctor f (N) N) (pred eq (N N)) (rule refl () (eq ?x ?x))"
    let goals = "(var X N) (var B N) (goal g ((eq X (f B))) (eq X X))"
    let proof = "(var K N) (hyp 0 (eq X (f B))) (hyp 1 () (eq X B) (B)) (step 2 refl () (eq (f K) (f K))) (invert 3 0 (1) (eq X X) ((refl 2 (K)))) (result g 3)"
    rejects(th, goals, proof, "capture")
}

#[test]
fn a_conditional_motive_needs_a_conditional_induction_hypothesis() {
    // Motive le z A ⊢ le A (s (s A)); the successor case may not assume
    // le P (s (s P)) outright.
    let goals = "(var A N) (goal g ((le z A)) (le A (s (s A))))"
    let bad = "(var P N) (hyp 0 (le z A)) (step 1 le.zero () (le z (s (s z)))) (hyp 2 (le P (s (s P)))) (step 3 le.succ (2) (le (s P) (s (s (s P))))) (induct 4 A (0) (le A (s (s A))) ((1) (3 P))) (result g 4)"
    rejects(LE, goals, bad, "not an induction hypothesis")
    // With the rule hypothesis le z P ⊢ le P (s (s P)) it is fine.
    let good = "(var P N) (hyp 0 (le z A)) (step 1 le.zero () (le z (s (s z)))) (hyp 2 ((le z P)) (le P (s (s P))) ()) (step 3 le.zero () (le z P)) (apply 4 2 () (3)) (step 5 le.succ (4) (le (s P) (s (s (s P))))) (induct 6 A (0) (le A (s (s A))) ((1) (5 P))) (result g 6)"
    accepts(LE, goals, good)
}

#[test]
fn application_binds_only_generalized_variables() {
    let bad = edit(
        trans().as_str(),
        "(apply 12 11 ((B M2) (C N2)) (10 9))",
        "(apply 12 11 ((M M2)) (10 9))"
    )
    rejects(LE, LE_GOALS, bad.as_str(), "does not generalize")
}

#[test]
fn a_result_may_use_only_stated_hypotheses() {
    let goals = "(var A N) (var B N) (var C N) (goal trans ((le A B)) (le A C))"
    rejects(LE, goals, trans().as_str(), "depends on hypotheses")
}

#[test]
fn a_proved_implication_applies_as_a_rule() {
    // trans, then le z (s (s z)) from le z (s z) and le (s z) (s (s z)).
    let goals = String.from(LE_GOALS) + " (goal two (le z (s (s z))))"
    let proof = trans() + "(step 17 le.zero () (le z (s z))) (step 18 le.zero () (le z z))" +
        "(step 19 le.succ (18) (le (s z) (s z))) (step 20 le.succ (19) (le (s (s z)) (s (s z))))" +
        "(step 21 le.zero () (le z (s z))) (step 22 le.succ (21) (le (s z) (s (s z))))" +
        "(apply 23 16 ((A z) (B (s z)) (C (s (s z)))) (17 22)) (result two 23)"
    accepts(LE, goals.as_str(), proof.as_str())
}
