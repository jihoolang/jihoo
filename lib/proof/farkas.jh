// The soundness of the compiler's linear checker (compiler/linear.jh),
// proved in Horn rules and checked by proof.schematic.
//
// The theory models `check`: forms are lists of (variable, coefficient)
// terms and a constant; `add_scaled` merges two term lists (`ms`, one
// rule for each branch of its loop, with the fuel `n` counting its
// iterations) and drops a coefficient that is zero (`push`); the weighted
// sum goes over the facts (`sums`), skipping zero weights; and `accepts`
// is everything `check` tests before it returns `Ok`. The model admits
// more than the code does (any order of variables, sums with a zero
// weight), which makes the theorem stronger.
//
// The theorem: when `accepts` holds, no point `x` satisfies every fact
// and the negated claim, `val claim x + 1 <= 0`; from those, `false`
// follows, and no rule concludes `false`. The integers are the axioms of
// proof.ring, each of which holds in ℤ.
import proof.cert
import proof.dev
import proof.ring
import proof.schematic

// The program's sorts, as `jihoo emit-horn` names them for linear.jh.
pub const P: str = "Tup<Z,Z>"
pub const T: str = "Vec<<i64,i128>>"
pub const L: str = "Lin"
pub const F: str = "Vec<Lin>"
pub const W: str = "Vec<i128>"

// A list sort as `jihoo emit-horn` declares a `Vec`: constructors, then
// len, nth and snoc with their rules, in its words.
fn list(n: str, e: str) -> String {
    String.from(
        "(ctor " + n + ".nil () " + n + ") (ctor " + n + ".cons (" + e + " " + n + ") " + n + ")\n"
    ) +
        "(pred " + n + ".len (" + n + " Z)) (pred " + n + ".nth (" + n + " Z " + e + ")) (pred " + n + ".snoc (" + n +
        " " + e + " " + n + "))\n" +
        "(rule " + n + ".len.nil () (" + n + ".len " + n + ".nil z0))\n" +
        "(rule " + n + ".len.cons ((" + n + ".len ?l ?n)) (" + n + ".len (" + n + ".cons ?e ?l) (add ?n z1)))\n" +
        "(rule " + n + ".nth.zero ((eq ?i z0)) (" + n + ".nth (" + n + ".cons ?e ?l) ?i ?e))\n" +
        "(rule " + n + ".nth.succ ((" + n + ".nth ?l ?j ?e) (eq ?i (add ?j z1))) (" + n + ".nth (" + n + ".cons ?x ?l) ?i ?e))\n" +
        "(rule " + n + ".snoc.nil () (" + n + ".snoc " + n + ".nil ?e (" + n + ".cons ?e " + n + ".nil)))\n" +
        "(rule " + n + ".snoc.cons ((" + n + ".snoc ?l ?e ?m)) (" + n + ".snoc (" + n + ".cons ?x ?l) ?e (" + n + ".cons ?x ?m)))\n"
}

// The program's data, declared as `jihoo emit-horn` declares it; the
// model alone (for its own tests) needs it, the model with the code's
// rules takes theirs.
pub fn data() -> String {
    String.from(
        "(sort Tup<Z,Z>)\n(sort Vec<<i64,i128>>)\n(sort Lin)\n(sort Vec<Lin>)\n(sort Vec<i128>)\n"
    ) +
        "(ctor Tup<Z,Z>.mk (Z Z) Tup<Z,Z>)\n" + list(T, P).as_str() + "(ctor Lin.mk (Vec<<i64,i128>> Z) Lin)\n" +
        list(F, L).as_str() + list(W, "Z").as_str()
}

// The model of `check`, over the program's data. Sorts come first, one
// per line, so that proof.code.theory can put them before every
// declaration.
pub fn model() -> String {
    let t = T
    String.from("(sort N)\n(sort X)\n") + "(ctor n0 () N) (ctor ns (N) N)\n" +
        "(ctor look (X Z) Z) (ctor ev (" + t + " X) Z) (ctor val (Lin X) Z)\n" +
        "(pred push (Z Z " + t + " " + t + ")) (pred ms (N " + t + " " + t + " Z " + t + "))\n" +
        "(pred as (Lin Lin Z Lin)) (pred sums (Vec<Lin> Vec<i128> Lin Lin)) (pred good (Vec<Lin> Vec<i128> Lin))\n" +
        "(pred nnw (Vec<i128>)) (pred sat (Vec<Lin> X)) (pred accepts (Vec<Lin> Lin Vec<i128>))\n" +
        "(rule eq.look ((eq ?a ?b)) (eq (look ?x ?a) (look ?x ?b)))\n" +
        "(rule ev.nil () (eq (ev " + t + ".nil ?x) z0))\n" +
        "(rule ev.cons () (eq (ev (" + t + ".cons (Tup<Z,Z>.mk ?v ?k) ?r) ?x) (add (mul ?k (look ?x ?v)) (ev ?r ?x))))\n" +
        "(rule val.lin () (eq (val (Lin.mk ?t ?c) ?x) (add (ev ?t ?x) ?c)))\n" +
        "(rule push.keep () (push ?v ?k ?r (" + t + ".cons (Tup<Z,Z>.mk ?v ?k) ?r)))\n" +
        "(rule push.drop ((eq ?k z0)) (push ?v ?k ?r ?r))\n" +
        "(rule ms.nil () (ms n0 " + t + ".nil " + t + ".nil ?w " + t + ".nil))\n" +
        "(rule ms.left ((ms ?n ?a ?b ?w ?r) (push ?v ?k ?r ?s)) (ms (ns ?n) (" + t + ".cons (Tup<Z,Z>.mk ?v ?k) ?a) ?b ?w ?s))\n" +
        "(rule ms.right ((eq ?p (mul ?k ?w)) (ms ?n ?a ?b ?w ?r) (push ?v ?p ?r ?s))" +
        " (ms (ns ?n) ?a (" + t + ".cons (Tup<Z,Z>.mk ?v ?k) ?b) ?w ?s))\n" +
        "(rule ms.both ((eq ?v ?u) (eq ?p (add ?j (mul ?k ?w))) (ms ?n ?a ?b ?w ?r) (push ?v ?p ?r ?s))" +
        " (ms (ns ?n) (" + t + ".cons (Tup<Z,Z>.mk ?v ?j) ?a) (" + t + ".cons (Tup<Z,Z>.mk ?u ?k) ?b) ?w ?s))\n" +
        "(rule as.lin ((eq ?e (add ?c (mul ?d ?w))) (ms ?n ?t ?u ?w ?r))" +
        " (as (Lin.mk ?t ?c) (Lin.mk ?u ?d) ?w (Lin.mk ?r ?e)))\n" +
        "(rule sums.nil () (sums Vec<Lin>.nil ?ws ?s ?s))\n" +
        "(rule sums.skip ((eq ?w z0) (sums ?fs ?ws ?s ?t)) (sums (Vec<Lin>.cons ?f ?fs) (Vec<i128>.cons ?w ?ws) ?s ?t))\n" +
        "(rule sums.add ((as ?s ?f ?w ?u) (sums ?fs ?ws ?u ?t)) (sums (Vec<Lin>.cons ?f ?fs) (Vec<i128>.cons ?w ?ws) ?s ?t))\n" +
        "(rule good ((sums ?fs ?ws ?s (Lin.mk " + t + ".nil ?c)) (le (add ?c z1) z0)) (good ?fs ?ws ?s))\n" +
        "(rule nnw.nil () (nnw Vec<i128>.nil))\n" +
        "(rule nnw.cons ((le z0 ?w) (nnw ?ws)) (nnw (Vec<i128>.cons ?w ?ws)))\n" +
        "(rule sat.nil () (sat Vec<Lin>.nil ?x))\n" +
        "(rule sat.cons ((le z0 (val ?f ?x)) (sat ?fs ?x)) (sat (Vec<Lin>.cons ?f ?fs) ?x))\n" +
        "(rule accepts ((nnw ?ws) (Vec<Lin>.len ?fs ?n) (Vec<i128>.nth ?ws ?n ?wc)" +
        " (as (Lin.mk " + t + ".nil (neg z1)) ?cl (neg z1) ?ng) (as (Lin.mk " + t + ".nil z0) ?ng ?wc ?first)" +
        " (good ?fs ?ws ?first)) (accepts ?fs ?cl ?ws))\n"
}

// The model alone: the ring, the program's data and the model.
pub fn theory() -> String {
    let d = data()
    let m = model()
    var sorts = String.from("(sort Z)\n")
    var rest = String.new()
    for text in [d.as_str(), m.as_str()] {
        for line in text.lines() {
            if line.starts_with("(sort ") {
                sorts.push_str(line)
                sorts.push('\n')
            } else {
                rest.push_str(line)
                rest.push('\n')
            }
        }
    }
    sorts + ring.theory().as_str() + rest.as_str()
}

pub fn goals() -> String {
    String.from("(var fs Vec<Lin>) (var cl Lin) (var ws Vec<i128>) (var x X)\n") +
        "(goal sound ((accepts fs cl ws) (sat fs x) (le (add (val cl x) z1) z0)) (false))\n"
}

fn tnil() -> cert.Tm { cert.c("Vec<<i64,i128>>.nil") }

fn v(n: str) -> cert.Tm { cert.v(n) }

fn tm(f: str, a: [cert.Tm]) -> cert.Tm {
    var xs = Vec(cert.Tm).new()
    for t in a { xs.push(t.clone()) }
    cert.app(f, xs)
}

fn ev(t: cert.Tm, x: cert.Tm) -> cert.Tm { tm("ev", [t.clone(), x.clone()]) }

fn val(l: cert.Tm, x: cert.Tm) -> cert.Tm { tm("val", [l.clone(), x.clone()]) }

fn look(x: cert.Tm, n: cert.Tm) -> cert.Tm { tm("look", [x.clone(), n.clone()]) }

fn lin(t: cert.Tm, c: cert.Tm) -> cert.Tm { tm("Lin.mk", [t.clone(), c.clone()]) }

// The steps of the development's lemmas; each is a fact whose plain
// hypotheses are the premises it is applied with.
struct Lemmas {
    push_ev: i64
    ms_ev: i64
    as_val: i64
    sat_head: i64
    sat_tail: i64
    nnw_head: i64
    nnw_tail: i64
    sums_nonneg: i64
    nth_nnw: i64
    good_false: i64
}

fn ms_at(n: cert.Tm) -> cert.Tm { tm("ms", [n.clone(), v("ma"), v("mb"), v("mw"), v("mr")]) }

impl dev.Dev {
    // push v k r s ⊢ ev s x = k * look x v + ev r x
    fn push_ev(inout self) -> i64 {
        self.k.declare("pv", "Z")
        self.k.declare("pk", "Z")
        self.k.declare("pr", T)
        self.k.declare("ps", T)
        self.k.declare("px", "X")
        let h = self.hyp(tm("push", [v("pv"), v("pk"), v("pr"), v("ps")]))
        let j = ring.eq(
            ev(v("ps"), v("px")),
            ring.add(ring.mul(v("pk"), look(v("px"), v("pv"))), ev(v("pr"), v("px")))
        )
        var cases = Vec(cert.InvCase).new()
        let o = self.open(h, [], "push.keep", "pk")
        let want = o.b.theta.apply(j)
        let r = ring.axiom(&self.k, "ev.cons", want)
        cases.push(o.case(r))
        let o = self.open(h, [], "push.drop", "pd")
        let want = o.b.theta.apply(j)
        // The variables are k v r; k = 0, so k * look x v + e = e.
        let kz = o.prem[0].clone()
        let lk = look(v("px"), o.at(1))
        let e = ev(o.at(2), v("px"))
        let r1 = ring.refl(&self.k, lk)
        let r1 = ring.cong_mul(&self.k, kz, r1)
        let r2 = self.ring.prove(&self.k, ring.mul(ring.z0(), lk), ring.z0())
        let r = ring.trans(&self.k, r1, r2)
        let er = ring.refl(&self.k, e)
        let r = ring.cong_add(&self.k, r, er)
        let r3 = self.ring.prove(&self.k, ring.add(ring.z0(), e), e)
        let r = ring.trans(&self.k, r, r3)
        let r = ring.sym(&self.k, r)
        if r.judgment != want { panic("push.drop: " + r.judgment.show().as_str()) }
        cases.push(o.case(r))
        self.close(h, [], j, cases.as_slice()).index()
    }

    // ms n a b w r ⊢ ev r x = ev a x + w * ev b x, by induction on n.
    fn ms_ev(inout self, push_ev: i64) -> i64 {
        self.k.declare("mn", "N")
        self.k.declare("ma", T)
        self.k.declare("mb", T)
        self.k.declare("mw", "Z")
        self.k.declare("mr", T)
        self.k.declare("mx", "X")
        self.k.declare("m1", "N")
        let x = v("mx")
        let j = ring.eq(ev(v("mr"), x), ring.add(ev(v("ma"), x), ring.mul(v("mw"), ev(v("mb"), x))))
        let h = self.hyp(ms_at(v("mn")))
        // n = 0: only ms.nil, so a = b = r = tnil.
        let h0 = self.hyp(ms_at(cert.c("n0")))
        let o = self.open(h0, [], "ms.nil", "mz")
        let want = o.b.theta.apply(j)
        let r = self.prove(want.arg(0), want.arg(1), [])
        let zero_case = self.close(h0, [], j, [o.case(r)])
        // n = m1 + 1
        let ih = self.k.rule_hyp([ms_at(v("m1"))], j.clone(), ["ma", "mb", "mr"])
        let hs = self.hyp(ms_at(cert.app1("ns", v("m1"))))
        var cases = Vec(cert.InvCase).new()
        for rule in ["ms.left", "ms.right", "ms.both"] {
            let o = self.open(hs, [ih.clone()], rule, "mc")
            let want = o.b.theta.apply(j)
            // The premises by their roles: ms n a b w r, push v p r s, and
            // for ms.right and ms.both an equation for p (and v = u).
            var msp = 0
            var pushp = 0
            for q in 0..o.prem.len() {
                if o.prem[q].judgment.is("ms") { msp = q }
                if o.prem[q].judgment.is("push") { pushp = q }
            }
            let mj = o.prem[msp].judgment.clone()
            let pj = o.prem[pushp].judgment.clone()
            let a = mj.arg(1).clone()
            let b = mj.arg(2).clone()
            let rr = mj.arg(4).clone()
            let vv = pj.arg(0).clone()
            let s = pj.arg(3).clone()
            let i1 = self.k.apply_at(
                o.ctx[0].index(),
                ["ma", "mb", "mr"],
                [a.clone(), b.clone(), rr.clone()],
                dev.one(o.prem[msp].clone()).as_slice()
            )
            let pushed = pj.arg(1)
            let p1 = self.k.apply_at(
                push_ev,
                ["pv", "pk", "pr", "ps", "px"],
                [vv.clone(), pushed.clone(), rr.clone(), s.clone(), x.clone()],
                dev.one(o.prem[pushp].clone()).as_slice()
            )
            var eqs = Vec(cert.Ref).new()
            eqs.push(p1.clone())
            eqs.push(i1.clone())
            for q in 0..o.prem.len() {
                let qj = o.prem[q].judgment.clone()
                if !qj.is("eq") { continue }
                if rule == "ms.both" && q == 0 {
                    // look x u = look x v, from v = u.
                    let uv = ring.sym(&self.k, o.prem[0].clone())
                    let u = qj.arg(1)
                    let lj = ring.eq(look(x, u), look(x, vv))
                    let l = self.step("eq.look", [uv], lj)
                    eqs.push(l)
                } else { eqs.push(o.prem[q].clone()) }
            }
            let r = self.prove(want.arg(0), want.arg(1), eqs.as_slice())
            cases.push(o.case(r))
        }
        let succ_case = self.close(hs, [ih.clone()], j, cases.as_slice())
        var ind = Vec(cert.Case).new()
        ind.push(cert.Case { step: zero_case.index(), vars: Vec(String).new() })
        var m1 = Vec(String).new()
        m1.push(String.from("m1"))
        ind.push(cert.Case { step: succ_case.index(), vars: m1 })
        self.k.induct("mn", [h.index()], true, j, ind.as_slice())
    }
}

impl dev.Dev {
    // as a b w l ⊢ val l x = val a x + w * val b x
    fn as_val(inout self, ms_ev: i64) -> i64 {
        self.k.declare("aa", "Lin")
        self.k.declare("ab", "Lin")
        self.k.declare("aw", "Z")
        self.k.declare("al", "Lin")
        self.k.declare("ax", "X")
        let x = v("ax")
        let h = self.hyp(tm("as", [v("aa"), v("ab"), v("aw"), v("al")]))
        let j = ring.eq(
            val(v("al"), x),
            ring.add(val(v("aa"), x), ring.mul(v("aw"), val(v("ab"), x)))
        )
        // The premises: e = c + d * w, then ms n t u w r.
        let o = self.open(h, [], "as.lin", "al")
        let want = o.b.theta.apply(j)
        let mj = o.prem[1].judgment.clone()
        let b = self.k.apply_at(
            ms_ev,
            ["mn", "ma", "mb", "mw", "mr", "mx"],
            [
                mj.arg(0).clone(),
                mj.arg(1).clone(),
                mj.arg(2).clone(),
                mj.arg(3).clone(),
                mj.arg(4).clone(),
                x.clone()
            ],
            dev.one(o.prem[1].clone()).as_slice()
        )
        let r = self.prove(want.arg(0), want.arg(1), [b.clone(), o.prem[0].clone()])
        self.close(h, [], j, [o.case(r)]).index()
    }

    // A premise of the one rule that concludes `j` with constructors:
    // inverting gives premise `i`.
    fn premise(inout self, j: cert.Tm, rule: str, i: i64, want: cert.Tm) -> i64 {
        let h = self.hyp(j)
        let o = self.open(h, [], rule, "pr")
        let r = o.prem[i.clone()]
        if r.judgment != o.b.theta.apply(want) { panic(rule + ": " + r.judgment.show().as_str()) }
        self.close(h, [], want, [o.case(r)]).index()
    }

    // sums fs ws s t, sat fs x, nnw ws, 0 <= val s x ⊢ 0 <= val t x, by
    // induction on fs, for every ws and s.
    fn sums_nonneg(inout self, l: Lemmas) -> i64 {
        self.k.declare("sf", F)
        self.k.declare("sws", W)
        self.k.declare("ss", "Lin")
        self.k.declare("st", "Lin")
        self.k.declare("sx", "X")
        self.k.declare("cf", "Lin")
        self.k.declare("cfs", F)
        let x = v("sx")
        let j = ring.le(ring.z0(), val(v("st"), x))
        var hs = Vec(i64).new()
        for f in [v("sf")] {
            let ps = sums_hyps(f)
            for p in ps { hs.push(self.hyp(p).index()) }
        }
        // fs = fnil: only sums.nil, so t = s.
        let g = sums_hyps(cert.c("Vec<Lin>.nil"))
        var gs = Vec(cert.Ref).new()
        for p in g { gs.push(self.hyp(p)) }
        let o = self.open(gs[0], [gs[3].index()], "sums.nil", "sn")
        let r = o.ctx[0].clone()
        let nil_case = self.close(gs[0], [gs[3].index()], j, [o.case(r)])
        // fs = fcons cf cfs
        let ih = self.k.rule_hyp(sums_hyps(v("cfs")).as_slice(), j.clone(), ["sws", "ss"])
        let g = sums_hyps(cert.app2("Vec<Lin>.cons", v("cf"), v("cfs")))
        var gs = Vec(cert.Ref).new()
        for p in g { gs.push(self.hyp(p)) }
        let context = [ih, gs[1].index(), gs[2].index(), gs[3].index()]
        var cases = Vec(cert.InvCase).new()
        // skip: the variables are w fs ws s t f.
        let o = self.open(gs[0], context, "sums.skip", "sk")
        let (f, fs, w, ws, s) = (o.at(5), o.at(1), o.at(0), o.at(2), o.at(3))
        let tail_sat = self.k.apply_at(
            l.sat_tail,
            ["tf", "tfs", "tx"],
            [f.clone(), fs.clone(), x.clone()],
            dev.one(o.ctx[1].clone()).as_slice()
        )
        let tail_w = self.k.apply_at(
            l.nnw_tail,
            ["nw", "nws"],
            [w.clone(), ws.clone()],
            dev.one(o.ctx[2].clone()).as_slice()
        )
        let r = self.k.apply_at(
            o.ctx[0].index(),
            ["sws", "ss"],
            [ws.clone(), s.clone()],
            [o.prem[1].clone(), tail_sat, tail_w, o.ctx[3].clone()]
        )
        cases.push(o.case(r))
        // add: the variables are s f w u fs ws t.
        let o = self.open(gs[0], context, "sums.add", "sa")
        let (s, f, w, u, fs, ws) = (o.at(0), o.at(1), o.at(2), o.at(3), o.at(4), o.at(5))
        let head_sat = self.k.apply_at(
            l.sat_head,
            ["tf", "tfs", "tx"],
            [f.clone(), fs.clone(), x.clone()],
            dev.one(o.ctx[1].clone()).as_slice()
        )
        let tail_sat = self.k.apply_at(
            l.sat_tail,
            ["tf", "tfs", "tx"],
            [f.clone(), fs.clone(), x.clone()],
            dev.one(o.ctx[1].clone()).as_slice()
        )
        let head_w = self.k.apply_at(
            l.nnw_head,
            ["nw", "nws"],
            [w.clone(), ws.clone()],
            dev.one(o.ctx[2].clone()).as_slice()
        )
        let tail_w = self.k.apply_at(
            l.nnw_tail,
            ["nw", "nws"],
            [w.clone(), ws.clone()],
            dev.one(o.ctx[2].clone()).as_slice()
        )
        let product = self.step(
            "le.mul",
            [head_w.clone(), head_sat.clone()],
            ring.le(ring.z0(), ring.mul(w, val(f, x)))
        )
        let sum = self.nonneg_add(o.ctx[3].clone(), product)
        let av = self.k.apply_at(
            l.as_val,
            ["aa", "ab", "aw", "al", "ax"],
            [s.clone(), f.clone(), w.clone(), u.clone(), x.clone()],
            dev.one(o.prem[0].clone()).as_slice()
        )
        let nonneg_u = self.le_eq(sum, ring.z0(), val(u, x), [av.clone()])
        let r = self.k.apply_at(
            o.ctx[0].index(),
            ["sws", "ss"],
            [ws.clone(), u.clone()],
            [o.prem[1].clone(), tail_sat, tail_w, nonneg_u]
        )
        cases.push(o.case(r))
        let cons_case = self.close(gs[0], context, j, cases.as_slice())
        var ind = Vec(cert.Case).new()
        ind.push(cert.Case { step: nil_case.index(), vars: Vec(String).new() })
        var vs = Vec(String).new()
        vs.push(String.from("cf"))
        vs.push(String.from("cfs"))
        ind.push(cert.Case { step: cons_case.index(), vars: vs })
        self.k.induct("sf", hs.as_slice(), true, j, ind.as_slice())
    }

    // nnw ws, nth ws n w ⊢ 0 <= w, by induction on ws, for every n.
    fn nth_nnw(inout self, l: Lemmas) -> i64 {
        self.k.declare("qw", W)
        self.k.declare("qn", "Z")
        self.k.declare("qe", "Z")
        self.k.declare("qa", "Z")
        self.k.declare("qr", W)
        let j = ring.le(ring.z0(), v("qe"))
        let at = fn(ws: cert.Tm) -> Vec(cert.Tm) {
            var out = Vec(cert.Tm).new()
            out.push(tm("nnw", [ws.clone()]))
            out.push(tm("Vec<i128>.nth", [ws.clone(), v("qn"), v("qe")]))
            out
        }
        var hs = Vec(i64).new()
        for p in at(v("qw")) { hs.push(self.hyp(p).index()) }
        // nil: no rule gives nth of an empty list.
        let g = at(cert.c("Vec<i128>.nil"))
        self.hyp(g[0].clone())
        let n1 = self.hyp(g[1].clone())
        let nil_case = self.close(n1, [], j, [])
        // cons qa qr
        let ih = self.k.rule_hyp(at(v("qr")).as_slice(), j.clone(), ["qn"])
        let g = at(cert.app2("Vec<i128>.cons", v("qa"), v("qr")))
        let g1 = self.hyp(g[0].clone())
        let g2 = self.hyp(g[1].clone())
        let context = [ih, g1.index()]
        var cases = Vec(cert.InvCase).new()
        // zero: the element is the head.
        let o = self.open(g2, context, "Vec<i128>.nth.zero", "nz")
        let nj = o.ctx[1].judgment.arg(0).clone()
        let r = self.k.apply_at(
            l.nnw_head,
            ["nw", "nws"],
            [nj.arg(0).clone(), nj.arg(1).clone()],
            dev.one(o.ctx[1].clone()).as_slice()
        )
        cases.push(o.case(r))
        // succ: the element is in the tail, at j.
        let o = self.open(g2, context, "Vec<i128>.nth.succ", "ns")
        let nj = o.ctx[1].judgment.arg(0).clone()
        let tail = self.k.apply_at(
            l.nnw_tail,
            ["nw", "nws"],
            [nj.arg(0).clone(), nj.arg(1).clone()],
            dev.one(o.ctx[1].clone()).as_slice()
        )
        let pj = o.prem[0].judgment.clone()
        let r = self.k.apply_at(
            o.ctx[0].index(),
            ["qn"],
            [pj.arg(1).clone()],
            [tail, o.prem[0].clone()]
        )
        cases.push(o.case(r))
        let cons_case = self.close(g2, context, j, cases.as_slice())
        var ind = Vec(cert.Case).new()
        ind.push(cert.Case { step: nil_case.index(), vars: Vec(String).new() })
        var vs = Vec(String).new()
        vs.push(String.from("qa"))
        vs.push(String.from("qr"))
        ind.push(cert.Case { step: cons_case.index(), vars: vs })
        self.k.induct("qw", hs.as_slice(), true, j, ind.as_slice())
    }

    // good fs ws s, sat fs x, nnw ws, 0 <= val s x ⊢ false: the sum is a
    // constant c with c + 1 <= 0, and it is non-negative.
    fn good_false(inout self, l: Lemmas) -> i64 {
        self.k.declare("gf", F)
        self.k.declare("gw", W)
        self.k.declare("gs", "Lin")
        self.k.declare("gx", "X")
        let x = v("gx")
        let h = self.hyp(tm("good", [v("gf"), v("gw"), v("gs")]))
        let c1 = self.hyp(tm("sat", [v("gf"), x.clone()]))
        let c2 = self.hyp(tm("nnw", [v("gw")]))
        let c3 = self.hyp(ring.le(ring.z0(), val(v("gs"), x)))
        let context = [c1.index(), c2.index(), c3.index()]
        let o = self.open(h, context, "good", "gd")
        let sj = o.prem[0].judgment.clone()
        let total = sj.arg(3).clone()
        let c = total.arg(1).clone()
        let s = self.k.apply_at(
            l.sums_nonneg,
            ["sf", "sws", "ss", "st", "sx"],
            [sj.arg(0).clone(), sj.arg(1).clone(), sj.arg(2).clone(), total.clone(), x.clone()],
            [o.prem[0].clone(), o.ctx[0].clone(), o.ctx[1].clone(), o.ctx[2].clone()]
        )
        let nonneg_c = self.le_eq(s, ring.z0(), c, [])
        let t2 = self.step(
            "le.add",
            [nonneg_c.clone()],
            ring.le(ring.add(ring.z0(), ring.z1()), ring.add(c, ring.z1()))
        )
        let t3 = self.step(
            "le.trans",
            [t2, o.prem[1].clone()],
            ring.le(ring.add(ring.z0(), ring.z1()), ring.z0())
        )
        let t4 = self.le_eq(t3, ring.z1(), ring.z0(), [])
        let f = self.step("absurd", [t4.clone()], cert.c("false"))
        self.close(h, context, cert.c("false"), [o.case(f)]).index()
    }

    // accepts fs cl ws, sat fs x, val cl x + 1 <= 0 ⊢ false
    fn sound(inout self, l: Lemmas) -> i64 {
        let x = v("x")
        let m1 = self.hyp(tm("accepts", [v("fs"), v("cl"), v("ws")]))
        let m2 = self.hyp(tm("sat", [v("fs"), x.clone()]))
        let m3 = self.hyp(ring.le(ring.add(val(v("cl"), x), ring.z1()), ring.z0()))
        let context = [m2.index(), m3.index()]
        // The variables are ws fs n wc cl ng first; the premises nnw, len,
        // nth, the negated claim, the first sum and good.
        let o = self.open(m1, context, "accepts", "ac")
        let (ws, fs, n, wc, cl, ng, first) = (
            o.at(0),
            o.at(1),
            o.at(2),
            o.at(3),
            o.at(4),
            o.at(5),
            o.at(6)
        )
        let wc_nonneg = self.k.apply_at(
            l.nth_nnw,
            ["qw", "qn", "qe"],
            [ws.clone(), n.clone(), wc.clone()],
            [o.prem[0].clone(), o.prem[2].clone()]
        )
        let minus_one = ring.neg(ring.z1())
        // The negated claim: val ng x = -1 - val cl x >= 0.
        let a1 = self.k.apply_at(
            l.as_val,
            ["aa", "ab", "aw", "al", "ax"],
            [lin(tnil(), minus_one), cl.clone(), minus_one.clone(), ng.clone(), x.clone()],
            dev.one(o.prem[3].clone()).as_slice()
        )
        let claim = ring.add(val(cl, x), ring.z1())
        let t1 = self.step(
            "le.add",
            [o.ctx[1].clone()],
            ring.le(ring.add(claim, ring.neg(claim)), ring.add(ring.z0(), ring.neg(claim)))
        )
        let nonneg_ng = self.le_eq(t1, ring.z0(), val(ng, x), [a1.clone()])
        // The first sum: val first x = wc * val ng x >= 0.
        let a2 = self.k.apply_at(
            l.as_val,
            ["aa", "ab", "aw", "al", "ax"],
            [lin(tnil(), ring.z0()), ng.clone(), wc.clone(), first.clone(), x.clone()],
            dev.one(o.prem[4].clone()).as_slice()
        )
        let p = self.step(
            "le.mul",
            [wc_nonneg, nonneg_ng],
            ring.le(ring.z0(), ring.mul(wc, val(ng, x)))
        )
        let nonneg_first = self.le_eq(p, ring.z0(), val(first, x), [a2.clone()])
        let f = self.k.apply_at(
            l.good_false,
            ["gf", "gw", "gs", "gx"],
            [fs.clone(), ws.clone(), first.clone(), x.clone()],
            [o.prem[5].clone(), o.ctx[0].clone(), o.prem[0].clone(), nonneg_first]
        )
        self.close(m1, context, cert.c("false"), [o.case(f)]).index()
    }
}

// The hypotheses of sums_nonneg at the facts `f`.
fn sums_hyps(f: cert.Tm) -> Vec(cert.Tm) {
    let x = v("sx")
    var out = Vec(cert.Tm).new()
    out.push(tm("sums", [f.clone(), v("sws"), v("ss"), v("st")]))
    out.push(tm("sat", [f.clone(), x.clone()]))
    out.push(tm("nnw", [v("sws")]))
    out.push(ring.le(ring.z0(), val(v("ss"), x)))
    out
}

// The certificate of the theorem `sound`.
pub fn certificate() -> String {
    let th = theory()
    var k = cert.Cert.new()
    let r = ring.Ring.new(&k)
    var d = dev.Dev { k, ring: r, rules: cert.Rules.parse(th.as_str()) }
    let push_ev = d.push_ev()
    let ms_ev = d.ms_ev(push_ev)
    let as_val = d.as_val(ms_ev)
    d.k.declare("tf", "Lin")
    d.k.declare("tfs", F)
    d.k.declare("tx", "X")
    let sat_fcons = tm("sat", [cert.app2("Vec<Lin>.cons", v("tf"), v("tfs")), v("tx")])
    let sat_head = d.premise(sat_fcons, "sat.cons", 0, ring.le(ring.z0(), val(v("tf"), v("tx"))))
    let sat_tail = d.premise(sat_fcons, "sat.cons", 1, tm("sat", [v("tfs"), v("tx")]))
    d.k.declare("nw", "Z")
    d.k.declare("nws", W)
    let nnw_wcons = tm("nnw", [cert.app2("Vec<i128>.cons", v("nw"), v("nws"))])
    let nnw_head = d.premise(nnw_wcons, "nnw.cons", 0, ring.le(ring.z0(), v("nw")))
    let nnw_tail = d.premise(nnw_wcons, "nnw.cons", 1, tm("nnw", [v("nws")]))
    var l = Lemmas {
        push_ev,
        ms_ev,
        as_val,
        sat_head,
        sat_tail,
        nnw_head,
        nnw_tail,
        sums_nonneg: 0,
        nth_nnw: 0,
        good_false: 0
    }
    l.sums_nonneg = d.sums_nonneg(l)
    l.nth_nnw = d.nth_nnw(l)
    l.good_false = d.good_false(l)
    let main = d.sound(l)
    d.k.result("sound", main)
    d.k.text().to_string()
}

// Check the certificate of `sound` against the theory.
pub fn check() -> Result(schematic.Report, String) {
    let th = theory()
    let g = goals()
    let c = certificate()
    schematic.check(th.as_str(), g.as_str(), c.as_str())
}

fn edit(s: str, old: str, new: str) -> String {
    let Some(i) = s.find(old) else { panic("no " + old) }
    s[0..i] + new + s[i + old.len..s.len]
}

#[test]
fn the_checker_is_sound() {
    match check() {
        Ok(r) => assert(r.goals == 1 && r.inductions == 3, "one theorem, three inductions")
        Err(e) => panic("rejected: " + e.as_str())
    }
}

// Without the test that the sum is negative, or that the weights are not,
// `check` would be unsound, and the proof no longer goes through.
#[test]
fn a_weaker_checker_is_not_proved() {
    let c = certificate()
    let g = goals()
    let th = theory()
    let no_sign = edit(th.as_str(), " (le (add ?c z1) z0)) (good", ") (good")
    assert(schematic.check(no_sign.as_str(), g.as_str(), c.as_str()).is_err(), "sum's sign")
    let any_weight = edit(
        th.as_str(),
        "(rule nnw.cons ((le z0 ?w) (nnw ?ws))",
        "(rule nnw.cons ((nnw ?ws))"
    )
    assert(schematic.check(any_weight.as_str(), g.as_str(), c.as_str()).is_err(), "facts' weights")
}

// A merge that keeps a coefficient of the wrong variable is caught.
#[test]
fn a_wrong_merge_is_not_proved() {
    let c = certificate()
    let g = goals()
    let th = theory()
    let wrong = edit(th.as_str(), "((eq ?v ?u) (eq ?p", "((eq ?p")
    assert(schematic.check(wrong.as_str(), g.as_str(), c.as_str()).is_err(), "both branch")
}
