// An owned list whose exact length is an erased index. Runtime construction
// and reads use the same checked core as the structural evidence.
#![dependent_core]
import dependent.list
import dependent.nat
import dependent.range

pub struct Sized(n: u64) {
    data: list.List
    exact: erased(Eq(list.length(data), n))
}

pub fn empty() -> Sized(0) { Sized { data: list.List.Nil, exact: refl(0) } }

pub fn cons(n: erased(u64), x: i64, xs: Sized(n)) -> Sized(n + 1) {
    match xs {
        Sized { data, exact } => Sized {
            data: list.List.Cons(x, data),
            exact: nat.eq_add(list.length(data), n, 1, exact)
        }
    }
}

// The accumulator's erased index advances with the loop counter.
pub fn repeat(n: u64, x: i64) -> Sized(n) {
    fold(n, fn(k) { Sized(k) }, empty(), fn(i, p, acc) { cons(i, x, acc) })
}

pub fn nth(n: erased(u64), xs: ref Sized(n), i: u64, p: erased(Lt(i, n))) -> i64 {
    match xs {
        Sized { data, exact } => list.nth(data, i,
            nat.rewrite_upper(i, n, list.length(data), nat.eq_sym(list.length(data), n, exact), p))
    }
}

pub fn head(n: erased(u64), xs: ref Sized(n), p: erased(Lt(0, n))) -> i64 {
    nth(n, xs, 0, p)
}

pub fn size(n: erased(u64), xs: ref Sized(n)) -> refine(fn(k) { Eq(k, n) }) {
    match xs { Sized { data, exact } => pack(list.length(data), exact) }
}

pub fn into_list(n: erased(u64), xs: Sized(n)) -> list.List {
    match xs { Sized { data, .. } => data }
}

// The structural map theorem preserves the wrapper's erased length index.
// Like list.map, callbacks execute tail-to-head and may allocate or trap.
pub fn map(n: erased(u64), xs: ref Sized(n), f: fn(i64) -> i64) -> Sized(n) {
    match xs {
        Sized { data, exact } => Sized {
            data: list.map(data, f),
            exact: nat.eq_trans(list.length(list.map(data, f)), list.length(data), n,
                list.map_borrowed_length(data, f), exact)
        }
    }
}

// Copy the prefix, consume the suffix and retain their exact combined length.
pub fn append_into(n: erased(u64), m: erased(u64), xs: ref Sized(n), ys: Sized(m)) -> Sized(n + m) {
    match xs {
        Sized { data: left, exact: left_exact } => match ys {
            Sized { data: right, exact: right_exact } => Sized {
                data: list.append_into(left, right),
                exact: transport(
                    fn(k) { Eq(list.length(list.append_into(left, right)), n + k) },
                    right_exact,
                    transport(
                        fn(k) { Eq(
                            list.length(list.append_into(left, right)),
                            k + list.length(right)
                        ) },
                        left_exact,
                        list.append_into_length(left, right)
                    )
                )
            }
        }
    }
}

// Build directly from bounded indices. Prepending visits callbacks from n - 1
// down to 0, once each, while the final list retains ascending index order.
pub fn tabulate(n: u64, f: fn(i: u64, erased(Lt(i, n))) -> i64) -> Sized(n) {
    fold(n, fn(k) { Sized(k) }, empty(), fn(i, p, acc) {
        cons(i, f(sub(n, i + 1, lt_add(i, n, 1, p)), nat.mirror_lt(i, n, p)), acc)
    })
}

pub fn from_buffer(n: u64, source: ref buffer(n)) -> Sized(n) {
    tabulate(n, fn(i, p) { index(source, i, p) })
}

// Copy the selected range directly into list nodes, without an intermediate
// buffer. The source stays borrowed; the returned list is an independent owner.
pub fn from_range(
    n: erased(u64),
    source: ref buffer(n),
    offset: u64,
    count: u64,
    fits: erased(Lt(offset + count, n + 1))
) -> Sized(count) {
    tabulate(count, fn(i, p) {
        index(source, offset + i, range.offset_lt(n, offset, count, i, fits, p))
    })
}
