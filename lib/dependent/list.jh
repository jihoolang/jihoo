// Owned lists of i64 with borrowing observations and structural length proofs.
#![dependent_core]

pub enum List {
    Nil
    Cons(i64, List)
}

pub fn repeat(n: u64, x: i64) -> List {
    fold(n, List.Nil, fn(i, p, acc) { List.Cons(x, acc) })
}

pub fn length(xs: ref List) -> u64 {
    induct(fn(t) { u64 }, 0, fn(x, rest, ih) { ih + 1 }, xs)
}

// Consumes a freshly produced list while measuring it, freeing every node.
pub fn into_length(xs: List) -> u64 {
    induct(fn(t) { u64 }, 0, fn(x, rest, ih) { ih + 1 }, xs)
}

pub fn sum(xs: ref List) -> i64 {
    induct(fn(t) { i64 }, 0, fn(x, rest, ih) { x + ih }, xs)
}

pub fn clone(xs: ref List) -> List {
    induct(fn(t) { List }, List.Nil, fn(x, rest, ih) { List.Cons(x, ih) }, xs)
}

// Both inputs remain borrowed; the result owns newly allocated nodes.
pub fn append(xs: ref List, ys: ref List) -> List {
    induct(fn(t) { List }, clone(ys), fn(x, rest, ih) { List.Cons(x, ih) }, xs)
}

pub fn clone_length(xs: ref List) -> Eq(into_length(clone(xs)), length(xs)) {
    induct(fn(t) { Eq(into_length(clone(t)), length(t)) }, refl(0), fn(x, rest, ih) {
        transport(fn(k) { Eq(into_length(clone(rest)) + 1, k + 1) }, ih,
            refl(into_length(clone(rest)) + 1))
    }, xs)
}

pub fn append_length(
    xs: ref List,
    ys: ref List
) -> Eq(into_length(append(xs, ys)), length(xs) + length(ys)) {
    induct(
        fn(t) { Eq(into_length(append(t, ys)), length(t) + length(ys)) },
        clone_length(ys),
        fn(x, rest, ih) {
            transport(fn(k) { Eq(into_length(append(rest, ys)) + 1, k + 1) }, ih,
                refl(into_length(append(rest, ys)) + 1))
        },
        xs
    )
}

pub fn size(xs: ref List) -> refine(fn(k) { Eq(k, length(xs)) }) {
    pack(length(xs), refl(length(xs)))
}

pub fn head_or(xs: ref List, missing: i64) -> i64 {
    match xs {
        Nil => missing
        Cons(x, rest) => x
    }
}

// Read with evidence rather than a fallback or a runtime bounds check.
pub fn head(xs: ref List, p: erased(Lt(0, length(xs)))) -> i64 {
    match xs {
        Nil => absurd(p)
        Cons(x, rest) => x
    }
}

pub fn nth(xs: ref List, i: u64, p: erased(Lt(i, length(xs)))) -> i64 {
    induct(fn(t, i: u64, p: erased(Lt(i, length(t)))) { i64 }, fn(i, p) { absurd(p) },
        fn(x, rest, ih, i, p) {
            if_lt(0, i, fn(q) {
                let e = lt_add(0, i, 1, q)
                ih(sub(i, 1, e), lt_cancel(sub(i, 1, e), length(rest), 1, p))
            }, x)
        }, xs)(i, p)
}

// Preserve element order. Structural recursion computes the tail first,
// so callbacks run from the last element to the first, once per element.
pub fn map(xs: ref List, f: fn(i64) -> i64) -> List {
    induct(fn(t) { List }, List.Nil, fn(x, rest, ih) { List.Cons(f(x), ih) }, xs)
}

pub fn map_length(xs: ref List, f: fn(i64) -> i64) -> Eq(into_length(map(xs, f)), length(xs)) {
    induct(fn(t) { Eq(into_length(map(t, f)), length(t)) }, refl(0), fn(x, rest, ih) {
        transport(fn(k) { Eq(into_length(map(rest, f)) + 1, k + 1) }, ih,
            refl(into_length(map(rest, f)) + 1))
    }, xs)
}

// Borrowing form for a record that retains the newly mapped list.
pub fn map_borrowed_length(xs: ref List, f: fn(i64) -> i64) -> Eq(length(map(xs, f)), length(xs)) {
    induct(fn(t) { Eq(length(map(t, f)), length(t)) }, refl(0), fn(x, rest, ih) {
        transport(fn(k) { Eq(length(map(rest, f)) + 1, k + 1) }, ih,
            refl(length(map(rest, f)) + 1))
    }, xs)
}
