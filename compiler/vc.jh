// The verification model of MIR's integer part and the obligations its
// checks give (docs/internals/verification.md). The model, which
// `obligations.jh` builds from MIR, and this generator are trusted: they are
// the semantics. Each check gives goals for `linear.check`: *these facts
// imply that claim*.

import forms
import linear

type Lin = linear.Lin

pub enum Operand {
    Local(i64)
    Const(i128)
    // A value the model does not follow, and why (`why_code`).
    Opaque(i64)
}

// Where a variable's value comes from, which is why a check that depends on
// it may not be proved: the first six are the model's own, the others the
// reasons `emit-obligations` gives for an opaque value.
pub const WHY_ARGUMENT: i64 = 0
pub const WHY_LOOP: i64 = 1
pub const WHY_CALL: i64 = 2
pub const WHY_CAST: i64 = 3
pub const WHY_UNSTATED: i64 = 4
pub const WHY_OTHER: i64 = 5
pub const WHY_COUNT: i64 = 23

pub fn why_name(w: i64) -> str {
    match w {
        0 => "argument"
        1 => "loop"
        2 => "call"
        3 => "cast"
        4 => "unstated"
        5 => "other"
        6 => "load"
        7 => "field"
        8 => "variant"
        9 => "element"
        10 => "escaped"
        11 => "aggregate"
        12 => "constant"
        13 => "wrap"
        14 => "bits"
        15 => "bool"
        16 => "div"
        17 => "rem"
        18 => "shift"
        19 => "neg"
        20 => "pointer"
        21 => "tag"
        22 => "length"
        _ => "other"
    }
}

pub fn why_code(name: str) -> i64 {
    for i in 0..WHY_COUNT {
        if why_name(i) == name { return i }
    }
    WHY_OTHER
}

pub enum Cmp {
    Lt
    Le
    Gt
    Ge
    Eq
    Ne
}

pub enum Rvalue {
    Use(Operand)
    // `+ - *` trap on overflow (the debug build's checked MIR `Bin`).
    Add(Operand, Operand)
    Sub(Operand, Operand)
    // Linear only when one side is a constant.
    Mul(Operand, Operand)
    // `+% -%`, and `+ -` without overflow checks: modulo the type's size.
    AddWrap(Operand, Operand)
    SubWrap(Operand, Operand)
    Compare(Cmp, Operand, Operand)
    // `!b` and `a && b` on bools.
    Not(Operand)
    And(Operand, Operand)
    // An integer cast to the destination's type: the same value when the
    // source's range fits, `i64` to `u64` read modulo 2^64.
    Cast(Operand)
    // A value the model does not follow (a load, a call's result): only its
    // type's range is known. The reason is a `why_code`.
    Opaque(i64)
}

// A check's source span as byte offsets, `(-1, -1)` when there is none.
pub fn nowhere() -> (i64, i64) { (-1, -1) }

// Where a check is in MIR: the block and the statement, or -1 for the
// block's terminator; `nowhere()` for a contract's clause.
pub type Site = (i64, i64)

pub enum Stmt {
    // The local, its value, the span and site of its overflow check.
    Assign(i64, Rvalue, (i64, i64), Site)
    // A type's invariant must hold here (a writer's drop), at the span.
    Check(Holds, (i64, i64))
}

pub enum Term {
    Goto(i64)
    // MIR's `switch _b [0 => zero; else other]` on a bool.
    Switch(i64, i64, i64)
    // `assert _b, msg -> next`; a negative local is a condition the model
    // does not follow.
    Assert(i64, String, i64, (i64, i64))
    // Any of the blocks (a `switch` the model does not follow).
    Any(Vec(i64))
    // A call whose result goes to the local (none if negative), then the block.
    Call(i64, i64, CallSite)
    // The program stops on purpose (`trap()`), at the span: a check that
    // the path cannot be taken.
    Trap((i64, i64))
    Return
    Unreachable
}

// A field of a function's parameter, through it if it is a borrow, or of
// its result (parameter 0), and the variable that is it.
pub struct FieldOf {
    pub param: i64
    pub path: Vec(u32)
    pub v: i64
}

impl Clone for FieldOf {
    fn clone(self) -> FieldOf { FieldOf { param: self.param, path: self.path.clone(), v: self.v } }
}

// A call's argument as the callee's contract sees it.
pub enum Arg {
    Value(Operand)
    // A `str` or slice whose length is the variable.
    View(i64)
    // A variable lent to an `inout` parameter: the call may change it.
    Lent(i64)
}

pub struct CallSite {
    // A writer's obligations of the invariants of what the call is given,
    // and the invariants of what it gives back or is lent, after it.
    pub before: Vec(Holds)
    pub after: Vec(Holds)
    // The callee's function, -1 for a call through a pointer or closure.
    pub callee: i64
    pub args: Vec(Arg)
    pub at: (i64, i64)
    // The variables the call may change besides its result and its `Lent`
    // arguments: fields inside what it is lent or where its result goes.
    pub changes: Vec(i64)
    // The callee never returns (`panic`): the call is a check that the path
    // cannot be taken.
    pub never: bool
    // The callee's fields here: (parameter, fields, the caller's variable).
    // Parameter 0 is the result.
    pub fields: Vec(FieldOf)
    // The variable of the result's length, when it is a view (in
    // `changes`); -1 if not.
    pub result_len: i64
}

pub struct Block {
    pub stmts: Vec(Stmt)
    pub term: Term
}

// A variable's values: an integer range, or anything else (a bool, a slice).
pub enum Kind {
    Int(i128, i128)
    Other
}

impl Clone for Kind {
    fn clone(self) -> Kind {
        match self {
            Int(lo, hi) => Kind.Int(lo, hi)
            Other => Kind.Other
        }
    }
}

// A fact about the function's variables, `a op b`, over linear forms;
// `_0` is the result in postconditions. A fact that names what the model
// does not follow is not `stated`: it is never assumed, and never proved.
// A disjunction (a clause with `||`) holds when one of the conjunctions in
// `ors` does, or, when it is `partial`, one of the alternatives over what
// the model does not follow, which are left out. It is not `stated`, so
// that what reads only `a op b` never assumes or proves it; `alternatives`
// reads it.
pub struct Fact {
    pub op: Cmp
    pub a: Lin
    pub b: Lin
    pub stated: bool
    pub ors: Vec(Vec(Cond))
    pub partial: bool
}

impl Clone for Fact {
    fn clone(self) -> Fact {
        Fact {
            op: self.op, a: self.a.clone(), b: self.b.clone(), stated: self.stated,
            ors: self.ors.clone(), partial: self.partial
        }
    }
}

impl Fact {
    pub fn compare(op: Cmp, sink a: Lin, sink b: Lin) -> Fact {
        Fact { op, a, b, stated: true, ors: Vec(Vec(Cond)).new(), partial: false }
    }

    pub fn is_or(self) -> bool { self.ors.len() > 0 || self.partial }

    // The variables it names.
    pub fn names(self) -> Vec(i64) {
        var out = Vec(i64).new()
        for t in self.a.terms { out.push(t.0) }
        for t in self.b.terms { out.push(t.0) }
        for alt in self.ors {
            for c in alt {
                for t in c.a.terms { out.push(t.0) }
                for t in c.b.terms { out.push(t.0) }
            }
        }
        out
    }
}

fn form(o: Operand) -> Option(Lin) {
    match o {
        Local(l) => Some(Lin.of(l))
        Const(c) => Some(Lin.num(c))
        Opaque(_) => None
    }
}

pub fn fact(op: Cmp, a: Operand, b: Operand) -> Fact {
    match (form(a), form(b)) {
        (Some(x), Some(y)) => Fact.compare(op, x, y)
        _ => unstated(op)
    }
}

pub fn unstated(op: Cmp) -> Fact {
    Fact {
        op, a: Lin.num(0), b: Lin.num(0), stated: false, ors: Vec(Vec(Cond)).new(),
        partial: false
    }
}

// One of the conjunctions holds, or with `partial`, one left out.
pub fn disjunction(sink ors: Vec(Vec(Cond)), partial: bool) -> Fact {
    if ors.len() == 0 { return unstated(Cmp.Eq) }
    Fact { op: Cmp.Eq, a: Lin.num(0), b: Lin.num(0), stated: false, ors, partial }
}

// A struct's invariant at a place, as a fact over the function's
// variables, and the type (docs/language/contracts.md): what assumes it
// rests on every writer of the type proving it.
pub struct Holds {
    pub ty: i64
    pub fact: Fact
}

impl Clone for Holds {
    fn clone(self) -> Holds { Holds { ty: self.ty, fact: self.fact.clone() } }
}

// What a call needs of its callee: the contract, and how its parameters
// map to the contract's variables.
pub struct Callee {
    pub symbol: String
    pub kinds: Vec(Kind)
    // The parameters are variables 1 to `args`.
    pub args: i64
    // (local, variable): a view's length, an `inout` parameter's integer.
    pub lengths: Vec((i64, i64))
    pub derefs: Vec((i64, i64))
    // (parameter, fields, variable): a field of a parameter, through it if
    // it is a borrow, or of the result (parameter 0).
    pub fields: Vec(FieldOf)
    // (variable, its value on entry), for the parameters' variables.
    pub entries: Vec((i64, i64))
    pub requires: Vec(Fact)
    pub ensures: Vec(Fact)
}

impl Clone for Callee {
    fn clone(self) -> Callee {
        Callee {
            symbol: self.symbol.clone(),
            kinds: self.kinds.clone(),
            args: self.args,
            lengths: self.lengths.clone(),
            derefs: self.derefs.clone(),
            fields: self.fields.clone(),
            entries: self.entries.clone(),
            requires: self.requires.clone(),
            ensures: self.ensures.clone()
        }
    }
}

pub struct Function {
    pub name: String
    // The variables: MIR's locals, then lengths, `inout` integers and
    // values on entry.
    pub kinds: Vec(Kind)
    pub blocks: Vec(Block)
    // Cut points and what holds each time control reaches them: loop heads,
    // and with no facts, any block where following every path costs too
    // much. Control reaching one checks its facts and stops there.
    pub invariants: Vec((i64, Vec(Fact)))
    pub callee: Callee
    // Small, with a call that never returns: record the paths to it.
    pub liftable: bool
    // The invariants of what the parameters hold, assumed on entry; in a
    // writer, those of the result and of what `inout` parameters hold,
    // proved on return; and the types it is a writer of.
    pub holds_in: Vec(Holds)
    pub holds_out: Vec(Holds)
    pub writes: Vec(i64)
}

impl Function {
    pub fn args(self) -> i64 { self.callee.args }
    pub fn requires(self) -> [Fact] { self.callee.requires.as_slice() }
    pub fn ensures(self) -> [Fact] { self.callee.ensures.as_slice() }
}

pub fn len_range() -> Kind { Kind.Int(0, (1 << 63) - 1) }

pub enum Source {
    // A check in MIR at the site.
    Check(Site)
    // A callee's `requires` at the call in the block.
    Requires(i64, i64)
    // A fact of `invariants[i]`, the `j`th.
    Invariant(i64, i64)
    // The `j`th clause of `ensures`.
    Ensures(i64)
    // At the call in the block, the callee does not reach its call that
    // never returns at the site.
    Lift(i64, i64, Site)
    // A writer's obligation of the type's invariant.
    TypeInvariant(i64)
}

// What a fact on a path rests on, besides the path itself: an assumption
// that holds only if something else is proved.
pub enum Tag {
    Path
    // The function's `requires`, which its callers prove.
    Requires
    // What holds at the cut point `invariants[k]`.
    Cut(i64)
    // The `ensures` of the function called.
    Ensures(i64)
    // The type's invariant, which every writer of it proves.
    TypeInvariant(i64)
}

pub struct Obligation {
    pub what: String
    // The check's span; `nowhere()` for invariants and `ensures`.
    pub at: (i64, i64)
    pub source: Source
    // Where the claim's variables come from (`why_code`s), for reports.
    pub depends: Vec(i64)
    // The obligation holds when every goal does: one per case of the
    // disjunctions on the path.
    pub goals: Vec(linear.Goal)
    // What each goal's facts rest on.
    pub tags: Vec(Vec(Tag))
}

// A path on which a function reaches a call that never returns: what
// holds there, over its variables on entry and fresh ones.
pub struct Panic {
    pub site: Site
    pub facts: Vec(Lin)
    pub tags: Vec(Tag)
    pub ors: Vec(Vec(Vec(Lin)))
    pub or_tags: Vec(Tag)
}

impl Clone for Panic {
    fn clone(self) -> Panic {
        Panic {
            site: self.site, facts: self.facts.clone(), tags: self.tags.clone(),
            ors: self.ors.clone(), or_tags: self.or_tags.clone()
        }
    }
}

// What a call needs to prove that a small function does not reach its
// calls that never return: the sites every path to which starts at the
// entry, those paths, the ranges of the fresh variables they name (after
// the function's own), and how the function's variables map to a call's.
pub struct Lift {
    pub sites: Vec(Site)
    pub paths: Vec(Panic)
    pub fresh: Vec(Kind)
    pub callee: Callee
}

impl Clone for Lift {
    fn clone(self) -> Lift {
        Lift {
            sites: self.sites.clone(), paths: self.paths.clone(), fresh: self.fresh.clone(),
            callee: self.callee.clone()
        }
    }
}

// What a local holds on a path, over the values at the path's start
// (variable `v` for local `v`) and fresh variables for opaque results.
enum Sym {
    // Exactly the variable, as at a path's start.
    Var(i64)
    Num(Lin)
    // A bool: what holds when it is true, and what holds when it is false,
    // each a disjunction of conjunctions (`Dnf`). Each is implied by the
    // bool's value, though it may say less.
    Bool(Vec(Vec(Cond)), Vec(Vec(Cond)))
    // An `i64` cast to `u64`: the form's value modulo 2^64.
    Wrapped(Lin)
    Unknown
}

impl Clone for Sym {
    fn clone(self) -> Sym {
        match self {
            Var(v) => Sym.Var(v)
            Num(l) => Sym.Num(l.clone())
            Wrapped(l) => Sym.Wrapped(l.clone())
            Bool(y, n) => Sym.Bool(y.clone(), n.clone())
            Unknown => Sym.Unknown
        }
    }
}

// A condition over linear forms, as `Rvalue.Compare` made it.
pub struct Cond {
    pub op: Cmp
    pub a: Lin
    pub b: Lin
}

impl Clone for Cond {
    fn clone(self) -> Cond { Cond { op: self.op, a: self.a.clone(), b: self.b.clone() } }
}

struct Path {
    block: i64
    state: Vec(Sym)
    facts: Vec(Lin)
    tags: Vec(Tag)
    // Disjunctions that hold: one of the alternatives, each facts `>= 0`,
    // and what each disjunction rests on.
    ors: Vec(Vec(Vec(Lin)))
    or_tags: Vec(Tag)
    // Where the values at the path's start come from: an argument on
    // entry, a loop at a cut point.
    origin: i64
    steps: i64
    // The path starts at the function's entry.
    from_entry: bool
}

impl Clone for Path {
    fn clone(self) -> Path {
        Path {
            block: self.block, state: self.state.clone(), facts: self.facts.clone(),
            tags: self.tags.clone(), ors: self.ors.clone(), or_tags: self.or_tags.clone(),
            origin: self.origin, steps: self.steps, from_entry: self.from_entry
        }
    }
}

// Paths followed per walk. Sequential branches double the paths, and a
// function cut short says nothing, so its checks stay unproved.
pub const MAX_PATHS: i64 = 2000

// Goals per obligation, at most: the cases of the disjunctions it uses.
pub const MAX_CASES: i64 = 16
// Alternatives in one disjunction, at most; a larger one says nothing.
pub const MAX_DISJUNCTS: i64 = 8

struct Gen {
    out: Vec(Obligation)
    errors: Vec(String)
    // The range and origin of every variable: the function's, then fresh.
    ranges: Vec(Kind)
    origins: Vec(i64)
    // Per variable, the last obligation that named it (to add its range once).
    mark: Vec(i64)
    stamp: i64
    // The span and source of the check being generated.
    at: (i64, i64)
    source: Source
    // For a liftable function: the paths from the entry to its calls that
    // never return, and the sites a path from a cut point reaches.
    panics: Vec(Panic)
    blocked: Vec(Site)
}

fn copy_source(s: Source) -> Source {
    match s {
        Check(x) => Source.Check(x)
        Requires(b, f) => Source.Requires(b, f)
        Invariant(i, j) => Source.Invariant(i, j)
        Ensures(j) => Source.Ensures(j)
        Lift(b, f, s) => Source.Lift(b, f, s)
        TypeInvariant(t) => Source.TypeInvariant(t)
    }
}

impl Gen {
    fn origin(self, p: Path, v: i64) -> i64 {
        if v < p.state.len() { p.origin } else { self.origins[v] }
    }

    fn name(inout self, v: i64, inout facts: Vec(Lin), inout tags: Vec(Tag)) {
        if self.mark[v] == self.stamp { return }
        self.mark[v] = self.stamp
        match self.ranges[v] {
            Int(lo, hi) => {
                facts.push(Lin.of(v).shift(0 - lo))
                facts.push(Lin.of(v).scale(-1).shift(hi))
                tags.push(Tag.Path)
                tags.push(Tag.Path)
            }
            Other => {}
        }
    }

    // The path's facts imply `claim`. Range facts are added only for the
    // variables the goal names; they hold for every variable.
    fn obligation(inout self, p: Path, what: str, sink claim: Lin) {
        self.obligation_with(p, what, Vec(Lin).new().as_slice(), claim, false)
    }

    // The path's facts and `extra` imply `claim`. A disjunction on the path
    // gives a goal per alternative, all of which must hold; the latest
    // disjunctions count while their cases stay few, and the others are
    // left out, which only loses facts.
    // `reach`: the claim is that the path cannot be taken, and why it may
    // be is what its latest conditions name.
    fn obligation_with(inout self, p: Path, what: str, extra: [Lin], sink claim: Lin, reach: bool) {
        // The range facts first: a prover looks at the latest facts first.
        var facts = Vec(Lin).new()
        var tags = Vec(Tag).new()
        let chosen = cases_for(p, claim, extra)
        var cases = 1
        for c in chosen { cases *= p.ors[c].len() }
        self.stamp += 1
        for t in claim.terms { self.name(t.0, &facts, &tags) }
        for x in p.facts {
            for t in x.terms { self.name(t.0, &facts, &tags) }
        }
        for x in extra {
            for t in x.terms { self.name(t.0, &facts, &tags) }
        }
        for c in chosen {
            for alt in p.ors[c] {
                for x in alt {
                    for t in x.terms { self.name(t.0, &facts, &tags) }
                }
            }
        }
        for i, x in p.facts {
            facts.push(x.clone())
            tags.push(p.tags[i])
        }
        for x in extra {
            facts.push(x.clone())
            tags.push(Tag.Path)
        }
        // Why the claim may fail: where its variables, or those of the
        // facts it refutes, come from.
        var depends = Vec(i64).new()
        var named = Vec(i64).new()
        for t in claim.terms { named.push(t.0) }
        for x in extra {
            for t in x.terms { named.push(t.0) }
        }
        // That the path cannot be taken: the latest conditions on it.
        if named.len() == 0 && reach {
            if p.ors.len() > 0 {
                for alt in p.ors[p.ors.len() - 1] {
                    for x in alt {
                        for t in x.terms { named.push(t.0) }
                    }
                }
            } else if p.facts.len() > 0 {
                for t in p.facts[p.facts.len() - 1].terms { named.push(t.0) }
            }
        }
        if named.len() == 0 { depends.push(WHY_UNSTATED) }
        for v in named {
            let w = self.origin(p, v)
            var have = false
            for d in depends {
                if d == w { have = true }
            }
            if !have { depends.push(w) }
        }
        var goals = Vec(linear.Goal).new()
        var goal_tags = Vec(Vec(Tag)).new()
        for case in 0..cases {
            var gf = facts.clone()
            var gt = tags.clone()
            var r = case
            for c in chosen {
                let alts = p.ors[c]
                let j = r % alts.len()
                r = r / alts.len()
                for x in alts[j] {
                    gf.push(x.clone())
                    gt.push(p.or_tags[c])
                }
            }
            goals.push(linear.Goal { facts: gf, claim: claim.clone() })
            goal_tags.push(gt)
        }
        self.out.push(Obligation {
            what: "bb" + p.block.to_string() + ": " + what
            at: self.at
            source: copy_source(self.source)
            depends
            goals
            tags: goal_tags
        })
    }

    // A check the model cannot state: `-1 >= 0`, proved only if the path
    // cannot be taken.
    fn unknown(inout self, p: Path, what: str) { self.obligation(p, what, Lin.num(-1)) }

    // The path cannot be taken: it reaches a call that never returns.
    fn unreachable(inout self, p: Path, what: str) {
        self.obligation_with(p, what, Vec(Lin).new().as_slice(), Lin.num(-1), true)
    }

    // The path with `facts >= 0` added cannot be taken: the others imply
    // that the last one fails, `-last - 1 >= 0` over the integers.
    fn refute(inout self, p: Path, what: str, facts: [Lin]) {
        if facts.len == 0 {
            self.unknown(p, what)
            return
        }
        let last = facts[facts.len - 1].scale(-1).shift(-1)
        self.obligation_with(p, what, facts[..facts.len - 1], last, false)
    }

    // `c` must hold on this path: each of its linear parts, or for `!=`,
    // `==` must be impossible.
    fn require(inout self, p: Path, what: str, c: Cond) {
        match c.op {
            Ne => {
                let eq = lins(Cmp.Eq, c.a, c.b).unwrap()
                self.refute(p, what, eq.as_slice())
            }
            _ => {
                let ls = lins(c.op, c.a, c.b).unwrap()
                for l in ls.into_iter() { self.obligation(p, what, l) }
            }
        }
    }

    // A condition holds on this path: each case of what holds when it does
    // not is impossible. With no such case, it holds trivially.
    fn require_bool(inout self, p: Path, what: str, no: [Vec(Cond)]) {
        if no.len == 0 { self.obligation(p, what, Lin.num(0)) }
        for conj in no { self.refute(p, what, conj_lins(conj.as_slice()).as_slice()) }
    }

    // The fact must hold on this path. A single conjunction gives a goal
    // per comparison; a disjunction holds when the path and the negation
    // of every alternative it can state cannot all hold (one it cannot
    // state is left out, which only makes the claim stronger).
    fn require_fact(inout self, p: Path, what: str, x: Fact, map: [Option(Lin)]) {
        var known = Vec(Vec(Cond)).new()
        for alt in alternatives(x, map).into_iter() {
            match alt {
                Some(conj) => known.push(conj)
                None => {}
            }
        }
        if known.len() == 0 {
            self.unknown(p, what)
            return
        }
        if known.len() == 1 {
            for c in known[0] { self.require(p, what, c) }
            return
        }
        // None of the alternatives: in each, one comparison fails.
        var no = truth()
        for conj in known {
            var fails = Vec(Vec(Cond)).new()
            for c in conj {
                let n = Cond { op: negate(c.op), a: c.a.clone(), b: c.b.clone() }
                fails = disj_dnf(fails.as_slice(), atom_dnf(n).as_slice())
            }
            no = conj_dnf(no.as_slice(), fails.as_slice())
        }
        self.require_bool(p, what, no.as_slice())
    }

    // A new variable with a range, from a value the model does not follow.
    fn fresh(inout self, kind: Kind, why: i64) -> Lin {
        let x = Lin.of(self.ranges.len())
        self.ranges.push(kind)
        self.origins.push(why)
        self.mark.push(0)
        x
    }
}

// The disjunctions an obligation splits into cases, latest first while
// the cases stay few. Of those a type's invariant gives, which every value
// of the type adds after each call, only those that name the claim's
// variables, or those of facts that do, directly or through others:
// another can help only to show that the path cannot be taken. Leaving
// one out only loses facts. For a claim without variables (the path
// cannot be taken), the latest facts on the path count as the claim's.
fn cases_for(p: Path, claim: Lin, extra: [Lin]) -> Vec(i64) {
    var chosen = Vec(i64).new()
    var seen = Vec(bool).new()
    var any = false
    for t in claim.terms { any = mark(&seen, t.0) || any }
    for x in extra {
        for t in x.terms { any = mark(&seen, t.0) || any }
    }
    // That the path cannot be taken: the latest conditions on it.
    if !any {
        var j = p.facts.len()
        while j > 0 && p.facts.len() - j < 8 {
            j -= 1
            for t in p.facts[j].terms { any = mark(&seen, t.0) || any }
        }
    }
    if any {
        var changed = true
        var rounds = 0
        while changed && rounds < 8 {
            changed = false
            rounds += 1
            for x in p.facts {
                if touches(seen.as_slice(), x) {
                    for t in x.terms {
                        if mark(&seen, t.0) { changed = true }
                    }
                }
            }
        }
    }
    // Those that name the claim's variables first, then the others while
    // the cases stay few: a path's later conditions can push out an
    // earlier one the claim needs.
    var cases = 1
    var taken = Vec(bool).filled(p.ors.len(), false)
    for pass in 0..2 {
        var k = p.ors.len()
        while k > 0 {
            k -= 1
            if taken[k] { continue }
            let n = p.ors[k].len()
            let typed = match p.or_tags[k] {
                TypeInvariant(_) => true
                _ => false
            }
            var relevant = !any
            if any {
                for alt in p.ors[k] {
                    for x in alt {
                        if touches(seen.as_slice(), x) { relevant = true }
                    }
                }
            }
            if pass == 0 && !relevant { continue }
            if pass == 1 && typed { continue }
            if cases * n > MAX_CASES { continue }
            cases *= n
            taken[k] = true
            chosen.push(k)
            if any {
                for alt in p.ors[k] {
                    for x in alt {
                        for t in x.terms {
                            let _ = mark(&seen, t.0)
                        }
                    }
                }
            }
        }
    }
    chosen
}

// Marks the variable; whether it was not marked yet.
fn mark(inout seen: Vec(bool), v: i64) -> bool {
    while seen.len() <= v { seen.push(false) }
    if seen[v] { return false }
    seen[v] = true
    true
}

fn touches(seen: [bool], x: Lin) -> bool {
    for t in x.terms {
        if t.0 < seen.len && seen[t.0] { return true }
    }
    false
}

// The forms that are `>= 0` exactly when `a op b`; None for `!=`, which is
// not one conjunction of linear facts.
fn lins(op: Cmp, a: Lin, b: Lin) -> Option(Vec(Lin)) {
    var out = Vec(Lin).new()
    match op {
        Lt => out.push(b.minus(a).shift(-1))
        Le => out.push(b.minus(a))
        Gt => out.push(a.minus(b).shift(-1))
        Ge => out.push(a.minus(b))
        Eq => {
            out.push(a.minus(b))
            out.push(b.minus(a))
        }
        Ne => return None
    }
    Some(out)
}

fn negate(op: Cmp) -> Cmp {
    match op {
        Lt => Cmp.Ge
        Le => Cmp.Gt
        Gt => Cmp.Le
        Ge => Cmp.Lt
        Eq => Cmp.Ne
        Ne => Cmp.Eq
    }
}

fn sym_form(s: Sym) -> Option(Lin) {
    match s {
        Var(v) => Some(Lin.of(v))
        Num(x) => Some(x.clone())
        _ => None
    }
}

fn operand(p: Path, o: Operand) -> Option(Lin) {
    match o {
        Const(c) => Some(Lin.num(c))
        Local(l) => sym_form(p.state[l])
        Opaque(_) => None
    }
}

// `x * k` while its numbers stay within the checker's bounds.
fn scaled(x: Lin, k: i128) -> Option(Lin) {
    if k != 0 && x.magnitude() > linear.MAX_VALUE / forms.abs(k) { return None }
    Some(x.scale(k))
}

// `x + k * y` (`k` is 1 or -1) while its numbers stay within the checker's
// bounds: each side is at most 2^65, so the sum cannot overflow, and a
// larger result is not followed.
fn sum(x: Lin, y: Lin, k: i128) -> Option(Lin) {
    if x.magnitude() > linear.MAX_VALUE || y.magnitude() > linear.MAX_VALUE { return None }
    let r = x.combine(1, y, k)
    if r.magnitude() > linear.MAX_VALUE { return None }
    Some(r)
}

// The form with each variable replaced by its value on this path.
fn value(p: Path, x: Lin) -> Option(Lin) {
    var out = Lin.num(x.constant)
    for t in x.terms {
        if t.0 >= p.state.len() { return None }
        let Some(y) = sym_form(p.state[t.0]) else { return None }
        let Some(z) = scaled(y, t.1) else { return None }
        out = out.plus(z)
    }
    Some(out)
}

// The form with each variable replaced by the form the map gives it.
fn substitute(x: Lin, map: [Option(Lin)]) -> Option(Lin) {
    var out = Lin.num(x.constant)
    for t in x.terms {
        if t.0 >= map.len { return None }
        let Some(y) = map[t.0] else { return None }
        let Some(z) = scaled(y, t.1) else { return None }
        out = out.plus(z)
    }
    Some(out)
}

// Each variable's form on this path, as `substitute` reads a map.
fn state_map(p: Path) -> Vec(Option(Lin)) {
    var out = Vec(Option(Lin)).with_capacity(p.state.len())
    for x in p.state { out.push(sym_form(x)) }
    out
}

// The comparison over the map's forms; None if it is not stated or names
// a variable the map does not give.
fn mapped(x: Fact, map: [Option(Lin)]) -> Option(Cond) {
    if !x.stated { return None }
    let Some(a) = substitute(x.a, map) else { return None }
    let Some(b) = substitute(x.b, map) else { return None }
    Some(Cond { op: x.op, a, b })
}

// The fact's alternatives over the map's forms, one of which holds: the
// fact itself, or each conjunction of a disjunction. None stands for an
// alternative the map cannot state.
fn alternatives(x: Fact, map: [Option(Lin)]) -> Vec(Option(Vec(Cond))) {
    var out = Vec(Option(Vec(Cond))).new()
    if !x.is_or() {
        out.push(match mapped(x, map) {
            Some(c) => {
                var one = Vec(Cond).new()
                one.push(c)
                Some(one)
            }
            None => None
        })
        return out
    }
    if x.partial { out.push(None) }
    for alt in x.ors {
        var conj = Vec(Cond).new()
        var known = true
        for y in alt {
            match (substitute(y.a, map), substitute(y.b, map)) {
                (Some(a), Some(b)) => conj.push(Cond { op: y.op, a, b })
                _ => known = false
            }
        }
        out.push(if known { Some(conj) } else { None })
    }
    out
}

// The fact holds on this path, resting on `tag`. An alternative the map
// cannot state could be the one that holds, so then nothing is assumed.
fn assume_fact(inout p: Path, x: Fact, map: [Option(Lin)], tag: Tag) {
    var d = Vec(Vec(Cond)).new()
    for alt in alternatives(x, map).into_iter() {
        let Some(conj) = alt else { return }
        var c = truth()
        for y in conj { c = conj_dnf(c.as_slice(), atom_dnf(y.clone()).as_slice()) }
        d = disj_dnf(d.as_slice(), c.as_slice())
    }
    assume_dnf(&p, d.as_slice(), tag)
}

// The linear facts of a conjunction; a `!=` in it, which is not one, is
// left out.
fn conj_lins(conj: [Cond]) -> Vec(Lin) {
    var out = Vec(Lin).new()
    for c in conj {
        match lins(c.op, c.a, c.b) {
            Some(ls) => {
                for l in ls.into_iter() { out.push(l) }
            }
            None => {}
        }
    }
    out
}

// One of the conjunctions holds on this path: no conjunction means the path
// cannot be taken, one gives facts, more a disjunction.
fn assume_dnf(inout p: Path, d: [Vec(Cond)], tag: Tag) {
    if d.len == 0 {
        p.facts.push(Lin.num(-1))
        p.tags.push(tag)
        return
    }
    if d.len == 1 {
        for l in conj_lins(d[0].as_slice()).into_iter() {
            p.facts.push(l)
            p.tags.push(tag)
        }
        return
    }
    var alts = Vec(Vec(Lin)).new()
    for conj in d { alts.push(conj_lins(conj.as_slice())) }
    p.ors.push(alts)
    p.or_tags.push(tag)
}

// True: one conjunction of nothing. A form too large to keep becomes this,
// which is implied by anything.
fn truth() -> Vec(Vec(Cond)) {
    var d = Vec(Vec(Cond)).new()
    d.push(Vec(Cond).new())
    d
}

// `a op b` as conjunctions without `!=`, which is `<` or `>`.
fn atom_dnf(sink c: Cond) -> Vec(Vec(Cond)) {
    var d = Vec(Vec(Cond)).new()
    match c.op {
        Ne => {
            var lt = Vec(Cond).new()
            lt.push(Cond { op: Cmp.Lt, a: c.a.clone(), b: c.b.clone() })
            d.push(lt)
            var gt = Vec(Cond).new()
            gt.push(Cond { op: Cmp.Gt, a: c.a.clone(), b: c.b.clone() })
            d.push(gt)
        }
        _ => {
            var one = Vec(Cond).new()
            one.push(c)
            d.push(one)
        }
    }
    d
}

// Both hold.
fn conj_dnf(x: [Vec(Cond)], y: [Vec(Cond)]) -> Vec(Vec(Cond)) {
    if x.len * y.len > MAX_DISJUNCTS { return truth() }
    var out = Vec(Vec(Cond)).new()
    for a in x {
        for b in y {
            var c = a.clone()
            for z in b { c.push(z.clone()) }
            out.push(c)
        }
    }
    out
}

// Either holds.
fn disj_dnf(x: [Vec(Cond)], y: [Vec(Cond)]) -> Vec(Vec(Cond)) {
    if x.len + y.len > MAX_DISJUNCTS { return truth() }
    var out = Vec(Vec(Cond)).new()
    for a in x { out.push(a.clone()) }
    for b in y { out.push(b.clone()) }
    out
}

fn invariant(f: Function, block: i64) -> Option(i64) {
    for i, inv in f.invariants {
        if inv.0 == block { return Some(i) }
    }
    None
}

// Per variable: nothing in the function gives it a new value (no
// assignment, call result or lending), so it keeps its value on entry.
pub fn unassigned(f: Function) -> Vec(bool) {
    var out = Vec(bool).filled(f.kinds.len(), true)
    for b in f.blocks {
        for st in b.stmts {
            match st {
                Assign(dst, _, _, _) => if dst >= 0 && dst < out.len() { out[dst] = false }
                Check(_, _) => {}
            }
        }
        match b.term {
            Call(dst, _, site) => {
                if dst >= 0 && dst < out.len() { out[dst] = false }
                for a in site.args {
                    match a {
                        Lent(x) => if x >= 0 && x < out.len() { out[x] = false }
                        _ => {}
                    }
                }
                for x in site.changes {
                    if x >= 0 && x < out.len() { out[x] = false }
                }
            }
            _ => {}
        }
    }
    out
}

// A path starting at `block`: every variable is its own, inside its range,
// and `facts` hold, resting on `tag`.
fn start(f: Function, fixed: [bool], block: i64, facts: [Fact], tag: Tag) -> Path {
    var p = Path {
        block,
        state: Vec(Sym).with_capacity(f.kinds.len()),
        facts: Vec(Lin).new(),
        tags: Vec(Tag).new(),
        ors: Vec(Vec(Vec(Lin))).new(),
        or_tags: Vec(Tag).new(),
        origin: if block == 0 { WHY_ARGUMENT } else { WHY_LOOP },
        steps: 0,
        from_entry: match tag {
            Requires => block == 0
            _ => false
        }
    }
    for v, k in f.kinds {
        match k {
            Int(_, _) => p.state.push(Sym.Var(v))
            Other => p.state.push(Sym.Unknown)
        }
    }
    // On entry, a parameter's value on entry is its value. At a cut point,
    // so is that of a variable the function never assigns, and `requires`
    // still holds of such variables.
    for e in f.callee.entries {
        if e.0 < p.state.len() && e.1 < p.state.len() && (block == 0 || fixed[e.0]) {
            p.state[e.1] = Sym.Var(e.0)
        }
    }
    let map = state_map(p)
    if block != 0 {
        for x in f.requires() {
            var all = x.stated || x.is_or()
            for v in x.names() {
                if v >= fixed.len || !fixed[v] { all = false }
            }
            if all { assume_fact(&p, x, map.as_slice(), Tag.Requires) }
        }
    }
    // The invariants of what the parameters hold, on entry, and at a cut
    // point when nothing changes them.
    for h in f.holds_in {
        var all = true
        if block != 0 {
            for v in h.fact.names() {
                if v >= fixed.len || !fixed[v] { all = false }
            }
        }
        if all { assume_fact(&p, h.fact, map.as_slice(), Tag.TypeInvariant(h.ty)) }
    }
    for x in facts { assume_fact(&p, x, map.as_slice(), tag) }
    p
}

// Each fact holds on this path; `inv` is the invariant they are, or -1.
// Each invariant holds on this path: a writer's obligations.
fn invariants_hold(inout g: Gen, p: Path, what: str, hs: [Holds]) {
    if hs.len == 0 { return }
    let map = state_map(p)
    for h in hs {
        g.source = Source.TypeInvariant(h.ty)
        g.require_fact(p, what, h.fact, map.as_slice())
    }
}

// A fact over what the model does not follow is never proved.
fn holds(inout g: Gen, p: Path, what: str, facts: [Fact], inv: i64) {
    let map = state_map(p)
    for j, x in facts {
        g.source = if inv >= 0 { Source.Invariant(inv, j) } else { Source.Ensures(j) }
        g.require_fact(p, what, x, map.as_slice())
    }
}

// The bool `a op b`: when it is false, the opposite comparison holds.
fn single(sink x: Cond) -> Sym {
    let n = Cond { op: negate(x.op), a: x.a.clone(), b: x.b.clone() }
    Sym.Bool(atom_dnf(x), atom_dnf(n))
}

// The form is always in [0, max]: a constant, or a variable whose range is.
fn within(g: Gen, x: Lin, max: i128) -> bool {
    if x.is_constant() { return x.constant >= 0 && x.constant <= max }
    if x.constant != 0 || x.terms.len() != 1 || x.terms[0].1 != 1 { return false }
    match g.ranges[x.terms[0].0] {
        Int(lo, hi) => lo >= 0 && hi <= max
        Other => false
    }
}

fn kind_of(f: Function, o: Operand) -> Option((i128, i128)) {
    match o {
        Local(l) => match f.kinds[l] {
            Int(lo, hi) => Some((lo, hi))
            Other => None
        }
        Const(c) => Some((c, c))
        Opaque(_) => None
    }
}

fn cast(f: Function, p: Path, dst: i64, o: Operand) -> Sym {
    let Int(lo, hi) = f.kinds[dst] else { return Sym.Unknown }
    let Some(src) = kind_of(f, o) else { return Sym.Unknown }
    let Some(x) = operand(p, o) else { return Sym.Unknown }
    if src.0 >= lo && src.1 <= hi { return Sym.Num(x) }
    let i64_min: i128 = 0 - (1 << 63)
    let u64_max: i128 = (1 << 64) - 1
    if src.0 == i64_min && src.1 == 0 - i64_min - 1 && lo == 0 && hi == u64_max {
        return Sym.Wrapped(x)
    }
    Sym.Unknown
}

fn compare(g: Gen, p: Path, op: Cmp, a: Operand, b: Operand) -> Sym {
    match (operand(p, a), operand(p, b)) {
        (Some(x), Some(y)) => return single(Cond { op, a: x, b: y })
        _ => {}
    }
    // An unsigned comparison with an `i64` cast to `u64`.
    let Some(x) = unsigned(g, p, a) else { return Sym.Unknown }
    let Some(y) = unsigned(g, p, b) else { return Sym.Unknown }
    match op {
        Lt => Sym.Bool(below_u(x, y, true), below_u(y, x, false))
        Le => Sym.Bool(below_u(x, y, false), below_u(y, x, true))
        Gt => Sym.Bool(below_u(y, x, true), below_u(x, y, false))
        Ge => Sym.Bool(below_u(y, x, false), below_u(x, y, true))
        // Equal as `u64`s exactly when equal as integers: a wrapped value
        // is its form modulo 2^64, the others are below 2^63.
        Eq | Ne => single(Cond { op, a: x.0.clone(), b: y.0.clone() })
    }
}

// An operand of an unsigned comparison: an `i64` cast to `u64` (its form,
// wrapped), or a value in [0, 2^63). A fixed array's bounds check compares
// with a constant length.
fn unsigned(g: Gen, p: Path, o: Operand) -> Option((Lin, bool)) {
    let i64_max: i128 = (1 << 63) - 1
    match o {
        Const(c) => if c >= 0 && c <= i64_max { Some((Lin.num(c), false)) } else { None }
        Local(l) => match p.state[l] {
            Wrapped(x) => Some((x.clone(), true))
            Num(y) => if within(g, y, i64_max) { Some((y.clone(), false)) } else { None }
            Var(v) => if within(g, Lin.of(v), i64_max) { Some((Lin.of(v), false)) } else { None }
            _ => None
        }
        Opaque(_) => None
    }
}

// `a < b` (`strict`) or `a <= b` as `u64`s. A wrapped form below zero is
// itself plus 2^64, at least 2^63, so above every value that is not
// wrapped, and below no other wrapped form that is not negative.
fn below_u(a: (Lin, bool), b: (Lin, bool), strict: bool) -> Vec(Vec(Cond)) {
    let op = if strict { Cmp.Lt } else { Cmp.Le }
    let c = Cond { op, a: a.0.clone(), b: b.0.clone() }
    let a_pos = Cond { op: Cmp.Ge, a: a.0.clone(), b: Lin.num(0) }
    let a_neg = Cond { op: Cmp.Lt, a: a.0.clone(), b: Lin.num(0) }
    let b_pos = Cond { op: Cmp.Ge, a: b.0.clone(), b: Lin.num(0) }
    let b_neg = Cond { op: Cmp.Lt, a: b.0.clone(), b: Lin.num(0) }
    var out = Vec(Vec(Cond)).new()
    var one = Vec(Cond).new()
    if !a.1 && !b.1 {
        one.push(c)
        out.push(one)
    } else if a.1 && !b.1 {
        one.push(a_pos)
        one.push(c)
        out.push(one)
    } else if !a.1 && b.1 {
        one.push(b_pos.clone())
        one.push(c)
        out.push(one)
        var two = Vec(Cond).new()
        two.push(b_neg)
        out.push(two)
    } else {
        one.push(a_pos.clone())
        one.push(b_pos)
        one.push(c.clone())
        out.push(one)
        var two = Vec(Cond).new()
        two.push(a_pos)
        two.push(b_neg.clone())
        out.push(two)
        var three = Vec(Cond).new()
        three.push(a_neg)
        three.push(b_neg)
        three.push(c)
        out.push(three)
    }
    out
}

fn bools(p: Path, o: Operand) -> Option((Vec(Vec(Cond)), Vec(Vec(Cond)))) {
    let Local(l) = o else { return None }
    match p.state[l] {
        Bool(y, n) => Some((y.clone(), n.clone()))
        _ => None
    }
}

// The result of `+ - *` must fit the destination; a result the model cannot
// state gives a check that cannot be proved.
fn arithmetic(inout g: Gen, f: Function, p: Path, dst: i64, sink r: Option(Lin)) -> Sym {
    let Int(lo, hi) = f.kinds[dst] else { return Sym.Unknown }
    match r {
        Some(x) => {
            g.obligation(p, "no overflow", x.shift(0 - lo))
            g.obligation(p, "no overflow", x.scale(-1).shift(hi))
            Sym.Num(x)
        }
        None => {
            g.unknown(p, "no overflow")
            Sym.Unknown
        }
    }
}

// An operand of `+ - *`. MIR gives both operands the result's type, so an
// opaque one is a new variable in the destination's range.
fn term(inout g: Gen, f: Function, p: Path, o: Operand, dst: i64) -> Option(Lin) {
    match o {
        Opaque(w) => match f.kinds[dst] {
            Int(_, _) => Some(g.fresh(f.kinds[dst], w))
            Other => None
        }
        _ => operand(p, o)
    }
}

fn assign(inout g: Gen, f: Function, inout p: Path, dst: i64, rv: Rvalue) {
    let value = match rv {
        Use(o) => match o {
            Local(l) => p.state[l].clone()
            Const(c) => Sym.Num(Lin.num(c))
            Opaque(_) => Sym.Unknown
        }
        Add(a, b) => {
            let r = match (term(&g, f, p, a, dst), term(&g, f, p, b, dst)) {
                (Some(x), Some(y)) => sum(x, y, 1)
                _ => None
            }
            arithmetic(&g, f, p, dst, r)
        }
        Sub(a, b) => {
            let r = match (term(&g, f, p, a, dst), term(&g, f, p, b, dst)) {
                (Some(x), Some(y)) => sum(x, y, -1)
                _ => None
            }
            arithmetic(&g, f, p, dst, r)
        }
        Mul(a, b) => {
            let r = match (term(&g, f, p, a, dst), term(&g, f, p, b, dst)) {
                (Some(x), Some(y)) => if y.is_constant() {
                    scaled(x, y.constant)
                } else if x.is_constant() { scaled(y, x.constant) } else { None }
                _ => None
            }
            arithmetic(&g, f, p, dst, r)
        }
        AddWrap(a, b) => wrapping(&g, f, &p, dst, a, b, 1)
        SubWrap(a, b) => wrapping(&g, f, &p, dst, a, b, -1)
        Compare(op, a, b) => compare(g, p, op, a, b)
        Not(a) => match bools(p, a) {
            Some(x) => Sym.Bool(x.1.clone(), x.0.clone())
            None => Sym.Unknown
        }
        And(a, b) => match (bools(p, a), bools(p, b)) {
            (Some(x), Some(y)) => Sym.Bool(
                conj_dnf(x.0.as_slice(), y.0.as_slice()),
                disj_dnf(x.1.as_slice(), y.1.as_slice())
            )
            _ => Sym.Unknown
        }
        Cast(o) => cast(f, p, dst, o)
        Opaque(_) => Sym.Unknown
    }
    // Why the value is unknown, if it is.
    let why = match rv {
        Use(o) => match o {
            Opaque(w) => w
            _ => WHY_OTHER
        }
        Opaque(w) => w
        Cast(_) => WHY_CAST
        AddWrap(_, _) | SubWrap(_, _) => why_code("wrap")
        _ => WHY_UNSTATED
    }
    havoc_or(&g, f, &p, dst, value, why)
}

// `a +% b` (`k` 1) or `a -% b` (`k` -1): a new variable, which is the
// exact result when that fits the destination's type, and otherwise the
// result minus or plus the type's size (both operands are in the type's
// range, so it wraps at most once). Unknown for 128-bit types, whose size
// is beyond the checker's numbers.
fn wrapping(
    inout g: Gen,
    f: Function,
    inout p: Path,
    dst: i64,
    a: Operand,
    b: Operand,
    k: i128
) -> Sym {
    let Int(lo, hi) = f.kinds[dst] else { return Sym.Unknown }
    if lo < 0 - (1 << 63) || hi > (1 << 64) - 1 { return Sym.Unknown }
    let size = hi - lo + 1
    let x = match (term(&g, f, p, a, dst), term(&g, f, p, b, dst)) {
        (Some(x), Some(y)) => sum(x, y, k)
        _ => None
    }
    let Some(x) = x else { return Sym.Unknown }
    if x.magnitude() > linear.MAX_VALUE - size { return Sym.Unknown }
    let r = g.fresh(f.kinds[dst], why_code("wrap"))
    var fits = Vec(Cond).new()
    fits.push(Cond { op: Cmp.Le, a: Lin.num(lo), b: x.clone() })
    fits.push(Cond { op: Cmp.Le, a: x.clone(), b: Lin.num(hi) })
    fits.push(Cond { op: Cmp.Eq, a: r.clone(), b: x.clone() })
    var above = Vec(Cond).new()
    above.push(Cond { op: Cmp.Gt, a: x.clone(), b: Lin.num(hi) })
    above.push(Cond { op: Cmp.Eq, a: r.clone(), b: x.shift(0 - size) })
    var below = Vec(Cond).new()
    below.push(Cond { op: Cmp.Lt, a: x.clone(), b: Lin.num(lo) })
    below.push(Cond { op: Cmp.Eq, a: r.clone(), b: x.shift(size) })
    // Adding a constant that is not negative never goes below, nor does
    // subtracting one go above.
    let up = match b {
        Const(c) => if c >= 0 { k } else { 0 - k }
        _ => 0
    }
    var d = Vec(Vec(Cond)).new()
    d.push(fits)
    if up >= 0 { d.push(above) }
    if up <= 0 { d.push(below) }
    assume_dnf(&p, d.as_slice(), Tag.Path)
    Sym.Num(r)
}

// Gives the local the value, or a fresh variable in its range when the
// value is unknown.
fn havoc_or(inout g: Gen, f: Function, inout p: Path, dst: i64, sink value: Sym, why: i64) {
    match value {
        Unknown => match f.kinds[dst] {
            Int(_, _) => p.state[dst] = Sym.Num(g.fresh(f.kinds[dst], why))
            Other => p.state[dst] = Sym.Unknown
        }
        _ => p.state[dst] = value
    }
}

fn lookup(pairs: [(i64, i64)], key: i64) -> Option(i64) {
    for x in pairs {
        if x.0 == key { return Some(x.1) }
    }
    None
}

fn copy(x: Option(Lin)) -> Option(Lin) {
    match x {
        Some(l) => Some(l.clone())
        None => None
    }
}

// The callee's variables as the call gives them: its parameters' values,
// lengths and `inout` integers, and their values on entry.
fn parameters(inout g: Gen, p: Path, c: Callee, site: CallSite) -> Vec(Option(Lin)) {
    var pre = Vec(Option(Lin)).filled(c.kinds.len(), None)
    for i in 1..c.args + 1 {
        if i - 1 >= site.args.len() || i >= c.kinds.len() { break }
        let a = site.args[i - 1]
        match c.kinds[i] {
            Int(_, _) => pre[i] = Some(match a {
                Value(o) => match o {
                    Opaque(w) => g.fresh(c.kinds[i], w)
                    _ => match operand(p, o) {
                        Some(x) => x
                        None => g.fresh(c.kinds[i], WHY_UNSTATED)
                    }
                }
                _ => g.fresh(c.kinds[i], WHY_UNSTATED)
            })
            Other => {}
        }
        match lookup(c.lengths.as_slice(), i) {
            Some(n) => if n < c.kinds.len() {
                let view = match a {
                    View(m) => sym_form(p.state[m])
                    _ => None
                }
                pre[n] = Some(match view {
                    Some(x) => x
                    None => g.fresh(len_range(), WHY_OTHER)
                })
            }
            None => {}
        }
        match lookup(c.derefs.as_slice(), i) {
            Some(d) => if d < c.kinds.len() {
                let lent = match a {
                    Lent(x) => sym_form(p.state[x])
                    _ => None
                }
                pre[d] = Some(match lent {
                    Some(y) => y
                    None => g.fresh(c.kinds[d], WHY_OTHER)
                })
            }
            None => {}
        }
    }
    // The parameters' fields, as the caller's variables.
    for x in c.fields {
        if x.param == 0 || x.v >= pre.len() { continue }
        var form: Option(Lin) = None
        for y in site.fields {
            if y.param == x.param && y.path == x.path && y.v < p.state.len() {
                form = sym_form(p.state[y.v])
            }
        }
        pre[x.v] = Some(match form {
            Some(l) => l
            None => g.fresh(c.kinds[x.v], WHY_OTHER)
        })
    }
    for e in c.entries {
        if e.0 < pre.len() && e.1 < pre.len() { pre[e.1] = copy(pre[e.0]) }
    }
    pre
}

// A call: the variables lent to it and its result get new values. When the
// callee has a contract, its `requires` must hold here, with the arguments
// for its parameters, and its `ensures` holds after, over the new values.
fn call(
    inout g: Gen,
    f: Function,
    contracts: [Option(Callee)],
    sink p: Path,
    dst: i64,
    next: i64,
    site: CallSite
) -> Path {
    var q = p
    invariants_hold(&g, q, "invariant", site.before.as_slice())
    var pre = Vec(Option(Lin)).new()
    let has = site.callee >= 0 && site.callee < contracts.len && contracts[site.callee].is_some()
    if has {
        let Some(c) = contracts[site.callee] else { return q }
        pre = parameters(&g, q, c, site)
        let what = "requires of " + c.symbol.as_str()
        g.source = Source.Requires(q.block, site.callee)
        for x in c.requires { g.require_fact(q, what.as_str(), x, pre.as_slice()) }
    }
    q.block = next
    q.steps += 1
    // New values for what the call may change: a fresh variable for an
    // integer, and nothing known of anything else (a bool's condition).
    var lent = Vec((i64, Lin)).new()
    for a in site.args {
        match a {
            Lent(x) => match f.kinds[x] {
                Int(_, _) => lent.push((x, g.fresh(f.kinds[x], WHY_CALL)))
                Other => q.state[x] = Sym.Unknown
            }
            _ => {}
        }
    }
    for x in site.changes {
        match f.kinds[x] {
            Int(_, _) => lent.push((x, g.fresh(f.kinds[x], WHY_CALL)))
            Other => q.state[x] = Sym.Unknown
        }
    }
    let result = if dst >= 0 {
        match f.kinds[dst] {
            Int(_, _) => Some(g.fresh(f.kinds[dst], WHY_CALL))
            Other => None
        }
    } else { None }
    if has {
        let Some(c) = contracts[site.callee] else { return q }
        var post = pre.clone()
        for d in c.derefs {
            if d.1 < post.len() {
                post[d.1] = None
                let i = d.0
                if i >= 1 && i - 1 < site.args.len() {
                    match site.args[i - 1] {
                        Lent(x) => {
                            for y in lent {
                                if y.0 == x { post[d.1] = Some(y.1.clone()) }
                            }
                        }
                        _ => {}
                    }
                }
            }
        }
        // A field after the call is the caller's variable's new value, or
        // unknown when the caller does not follow it.
        for x in c.fields {
            if x.v >= post.len() { continue }
            post[x.v] = None
            for y in site.fields {
                if y.param == x.param && y.path == x.path && y.v < q.state.len() {
                    var now = sym_form(q.state[y.v])
                    for z in lent {
                        if z.0 == y.v { now = Some(z.1.clone()) }
                    }
                    post[x.v] = now
                }
            }
        }
        if post.len() > 0 { post[0] = copy(result) }
        // A view result's length is the caller's new one.
        match lookup(c.lengths.as_slice(), 0) {
            Some(n) => if n < post.len() {
                post[n] = None
                for z in lent {
                    if z.0 == site.result_len { post[n] = Some(z.1.clone()) }
                }
            }
            None => {}
        }
        for x in c.ensures { assume_fact(&q, x, post.as_slice(), Tag.Ensures(site.callee)) }
    }
    for y in lent { q.state[y.0] = Sym.Num(y.1.clone()) }
    if dst >= 0 {
        match result {
            Some(r) => q.state[dst] = Sym.Num(r)
            None => havoc_or(&g, f, &q, dst, Sym.Unknown, WHY_CALL)
        }
    }
    if site.after.len() > 0 {
        let map = state_map(q)
        for h in site.after { assume_fact(&q, h.fact, map.as_slice(), Tag.TypeInvariant(h.ty)) }
    }
    q
}

// A fact on the path, which a caller keeps, names a variable on entry.
fn on_entry(pp: Panic, n: i64) -> bool {
    for i, x in pp.facts {
        let kept = match pp.tags[i] {
            Requires | Cut(_) => false
            _ => true
        }
        if kept {
            for t in x.terms {
                if t.0 < n { return true }
            }
        }
    }
    for alts in pp.ors {
        for alt in alts {
            for x in alt {
                for t in x.terms {
                    if t.0 < n { return true }
                }
            }
        }
    }
    false
}

// A liftable function reaches a call that never returns on this path.
fn record(inout g: Gen, f: Function, p: Path) {
    if !f.liftable { return }
    if !p.from_entry {
        g.blocked.push((p.block, -1))
        return
    }
    g.panics.push(Panic {
        site: (p.block, -1), facts: p.facts.clone(), tags: p.tags.clone(), ors: p.ors.clone(),
        or_tags: p.or_tags.clone()
    })
}

// A call to a function whose panics a call may prove away: each path on
// which it reaches one, over the call's arguments, must be impossible
// here. What the path rests on stays (a callee's `ensures`), except the
// function's own `requires`, which is left out; a variable that is not a
// parameter's is a fresh one in its range.
fn lift(inout g: Gen, lifts: [Option(Lift)], p: Path, site: CallSite) {
    if site.callee < 0 || site.callee >= lifts.len { return }
    let Some(l) = lifts[site.callee] else { return }
    if l.sites.len() == 0 { return }
    let c = l.callee
    let pre = parameters(&g, p, c, site)
    var map = Vec(Option(Lin)).new()
    let n = c.kinds.len()
    for v in 0..n + l.fresh.len() {
        if v < n {
            match pre[v] {
                Some(x) => map.push(Some(x.clone()))
                None => map.push(match c.kinds[v] {
                    Int(_, _) => Some(g.fresh(c.kinds[v], WHY_CALL))
                    Other => None
                })
            }
        } else {
            map.push(match l.fresh[v - n] {
                Int(_, _) => Some(g.fresh(l.fresh[v - n], WHY_CALL))
                Other => None
            })
        }
    }
    for pp in l.paths {
        var q = p.clone()
        var ok = true
        for i, x in pp.facts {
            let keep = match pp.tags[i] {
                Requires | Cut(_) => false
                _ => true
            }
            if keep {
                match substitute(x, map.as_slice()) {
                    Some(y) => {
                        q.facts.push(y)
                        q.tags.push(pp.tags[i])
                    }
                    // A fact that cannot be stated here is left out.
                    None => {}
                }
            }
        }
        for i, alts in pp.ors {
            let keep = match pp.or_tags[i] {
                Requires | Cut(_) => false
                _ => true
            }
            var mapped = Vec(Vec(Lin)).new()
            for alt in alts {
                var m = Vec(Lin).new()
                for x in alt {
                    match substitute(x, map.as_slice()) {
                        Some(y) => m.push(y)
                        None => ok = false
                    }
                }
                mapped.push(m)
            }
            if keep && ok {
                q.ors.push(mapped)
                q.or_tags.push(pp.or_tags[i])
            }
            ok = true
        }
        g.source = Source.Lift(p.block, site.callee, pp.site)
        g.unreachable(q, "panic")
    }
}

fn moved(sink p: Path, block: i64) -> Path {
    var q = p
    q.block = block
    q.steps += 1
    q
}

// Follows every path from `first` to its end: a return, a cut point or a
// trap.
fn walk(
    inout g: Gen,
    f: Function,
    contracts: [Option(Callee)],
    lifts: [Option(Lift)],
    sink first: Path
) {
    var work = Vec(Path).new()
    work.push(first)
    var followed = 0
    loop {
        let Some(path) = work.pop() else { break }
        var p = path
        followed += 1
        if followed > MAX_PATHS {
            g.errors.push("more than " + MAX_PATHS.to_string() + " paths")
            return
        }
        // Every edge into a cut point, from any terminator, ends the path there.
        if p.steps > 0 {
            match invariant(f, p.block) {
                Some(i) => {
                    let what = "invariant of bb" + p.block.to_string()
                    holds(&g, p, what.as_str(), f.invariants[i].1.as_slice(), i)
                    continue
                }
                None => {}
            }
        }
        // A path longer than the function runs a block twice: a loop
        // without a cut point, which unrolling would never finish.
        if p.steps > f.blocks.len() {
            g.errors.push("a loop without an invariant reaches bb" + p.block.to_string())
            return
        }
        let b = f.blocks[p.block]
        for s in b.stmts {
            match s {
                Assign(dst, rv, at, site) => {
                    g.at = at
                    g.source = Source.Check(site)
                    assign(&g, f, &p, dst, rv)
                    g.at = nowhere()
                }
                Check(h, at) => {
                    g.at = at
                    var one = Vec(Holds).new()
                    one.push(h.clone())
                    invariants_hold(&g, p, "invariant", one.as_slice())
                    g.at = nowhere()
                }
            }
        }
        match b.term {
            Goto(t) => work.push(moved(p, t))
            Switch(c, zero, other) => {
                var no = p.clone()
                no.block = zero
                no.steps += 1
                let cond = p.state[c].clone()
                var yes = moved(p, other)
                match cond {
                    Bool(y, n) => {
                        assume_dnf(&no, n.as_slice(), Tag.Path)
                        assume_dnf(&yes, y.as_slice(), Tag.Path)
                    }
                    _ => {}
                }
                work.push(no)
                work.push(yes)
            }
            Assert(c, msg, next, at) => {
                g.at = at
                g.source = Source.Check((p.block, -1))
                let cond = if c >= 0 { p.state[c].clone() } else { Sym.Unknown }
                match cond {
                    Bool(y, n) => {
                        g.require_bool(p, msg.as_str(), n.as_slice())
                        var q = moved(p, next)
                        assume_dnf(&q, y.as_slice(), Tag.Path)
                        work.push(q)
                    }
                    _ => {
                        g.unknown(p, msg.as_str())
                        work.push(moved(p, next))
                    }
                }
                g.at = nowhere()
            }
            Any(targets) => {
                for i, t in targets {
                    if i + 1 < targets.len() {
                        var q = p.clone()
                        q.block = t
                        q.steps += 1
                        work.push(q)
                    }
                }
                if targets.len() > 0 { work.push(moved(p, targets[targets.len() - 1])) }
            }
            Call(dst, next, site) => {
                g.at = site.at
                if site.never {
                    g.source = Source.Check((p.block, -1))
                    g.unreachable(p, "unreachable")
                    record(&g, f, p)
                } else { lift(&g, lifts, p, site) }
                let q = call(&g, f, contracts, p, dst, next, site)
                g.at = nowhere()
                work.push(q)
            }
            Trap(at) => {
                g.at = at
                g.source = Source.Check((p.block, -1))
                g.unreachable(p, "unreachable")
                record(&g, f, p)
                g.at = nowhere()
            }
            Return => {
                invariants_hold(&g, p, "invariant", f.holds_out.as_slice())
                holds(&g, p, "ensures", f.ensures(), -1)
            }
            // MIR's `unreachable` is a promise the compiler makes (after a
            // call that does not return, an impossible `match` arm), and LLVM
            // relies on it too: a path that reaches it is not taken.
            Unreachable => {}
        }
    }
}

pub struct Obligations {
    pub list: Vec(Obligation)
    pub errors: Vec(String)
    // For a liftable function, what its callers need (None if it was not
    // followed everywhere).
    pub lift: Option(Lift)
}

// The obligations of a function: from its entry under `requires`, and from
// each cut point under its invariant. A call to a function with an entry
// in `contracts` (by function) proves its `requires` and assumes its
// `ensures`.
pub fn generate(f: Function, contracts: [Option(Callee)], lifts: [Option(Lift)]) -> Obligations {
    var g = Gen {
        out: Vec(Obligation).new(), errors: Vec(String).new(), ranges: f.kinds.clone(),
        origins: Vec(i64).filled(f.kinds.len(), WHY_OTHER), mark: Vec(i64).filled(f.kinds.len(), 0),
        stamp: 0, at: nowhere(), source: Source.Ensures(0), panics: Vec(Panic).new(),
        blocked: Vec(Site).new()
    }
    let fixed = unassigned(f)
    if f.blocks.len() > 0 {
        walk(&g, f, contracts, lifts, start(f, fixed.as_slice(), 0, f.requires(), Tag.Requires))
        for k, inv in f.invariants {
            if g.errors.len() == 0 {
                walk(
                    &g,
                    f,
                    contracts,
                    lifts,
                    start(f, fixed.as_slice(), inv.0, inv.1.as_slice(), Tag.Cut(k))
                )
            }
        }
    }
    // The sites every path to which starts at the entry, and depends on
    // the function's variables there: a caller can know nothing else.
    var lift: Option(Lift) = None
    if f.liftable && g.errors.len() == 0 {
        for pp in g.panics {
            if !on_entry(pp, f.kinds.len()) { g.blocked.push(pp.site) }
        }
        var sites = Vec(Site).new()
        for pp in g.panics {
            var seen = false
            for s in sites {
                if s.0 == pp.site.0 && s.1 == pp.site.1 { seen = true }
            }
            for s in g.blocked {
                if s.0 == pp.site.0 && s.1 == pp.site.1 { seen = true }
            }
            if !seen { sites.push(pp.site) }
        }
        var paths = Vec(Panic).new()
        for pp in g.panics {
            var keep = false
            for s in sites {
                if s.0 == pp.site.0 && s.1 == pp.site.1 { keep = true }
            }
            if keep { paths.push(pp.clone()) }
        }
        var fresh = Vec(Kind).new()
        for i in f.kinds.len()..g.ranges.len() { fresh.push(g.ranges[i].clone()) }
        lift = Some(Lift { sites, paths, fresh, callee: f.callee.clone() })
    }
    match g {
        Gen { out, errors, .. } => Obligations { list: out, errors, lift }
    }
}
