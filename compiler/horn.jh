// What a function's MIR computes, as Horn rules for lib/proof: the
// meaning of the code, which a proof in Horn can then be about. Like
// vc.jh, it states what MIR means, so it is trusted; unlike it, it
// follows values of every type in a small fragment instead of integers
// alone, and it says what a function returns rather than what it checks.
//
// The fragment: integers (exact: a `+` that overflows traps, so it has no
// result, and the program must be built with overflow checks), comparisons,
// widening casts, structs, tuples and enums (constructor terms), `Vec`
// through `new`, `with_capacity`, `len`, `index`, `push` and `clone`
// (lists, by the relations `len`, `nth` and `snoc`, which say what std's
// `Vec` does), `overflowing_*`, borrows (a shared borrow is the value it
// borrows, which nothing changes while it lives; a mutable one is the
// place, which a call updates), and calls of functions in the fragment.
// Anything else is an error, never an approximation.
//
// Each function `f` is a predicate `fn.f` over its arguments and its
// result. Loop heads (targets of back edges) are cut points: `fn.f@K`
// holds of fuel n, the values of the locals live at block K and the
// function's result when the function, from K with those values, returns
// that result after at most n passes through cut points. Each path
// between the entry, cut points and returns is one rule; a path that
// traps, panics or reaches `unreachable` has none. A rule's variables are
// the values on entry to its path, and the values its calls return.
import lex
import mir
import types

type Program = mir.Program
type Body = mir.Body
type Place = mir.Place
type Operand = mir.Operand
type Rvalue = mir.Rvalue
type Op = lex.Op

// A term: a variable `?name`, or a symbol applied to arguments.
#[derive(Clone, Eq)]
enum Hm { V(String), A(String, Vec(Hm)) }

fn sym(f: str) -> Hm { Hm.A(f.to_string(), Vec(Hm).new()) }

fn ap(f: str, sink xs: Vec(Hm)) -> Hm { Hm.A(f.to_string(), xs) }

fn ap2(f: str, a: Hm, b: Hm) -> Hm {
    var xs = Vec(Hm).new()
    xs.push(a.clone())
    xs.push(b.clone())
    Hm.A(f.to_string(), xs)
}

impl Hm {
    fn write(self, inout out: String) {
        match self {
            V(n) => {
                out.push('?')
                out.push_str(n.as_str())
            }
            A(f, xs) => {
                if xs.len() == 0 {
                    out.push_str(f.as_str())
                    return
                }
                out.push('(')
                out.push_str(f.as_str())
                for x in xs {
                    out.push(' ')
                    x.write(&out)
                }
                out.push(')')
            }
        }
    }

    fn subst(self, x: str, t: Hm) -> Hm {
        match self {
            V(n) => if n == x { t.clone() } else { self.clone() }
            A(f, xs) => {
                var ys = Vec(Hm).new()
                for y in xs { ys.push(y.subst(x, t)) }
                Hm.A(f.clone(), ys)
            }
        }
    }

    fn is_var(self) -> bool {
        match self {
            V(_) => true
            A(_, _) => false
        }
    }

    fn name(self) -> str {
        match self {
            V(n) => n.as_str()
            A(f, _) => f.as_str()
        }
    }

    fn args(self) -> [Hm] {
        match self {
            V(_) => panic("a variable has no arguments")
            A(_, xs) => xs.as_slice()
        }
    }
}

fn show(t: Hm) -> String {
    var s = String.new()
    t.write(&s)
    s
}

// An integer as a ring term.
fn num(v: i128) -> Hm {
    if v == 0 { return sym("z0") }
    if v == 1 { return sym("z1") }
    if v < 0 {
        let (magnitude, over) = overflowing_sub(0 as i128, v)
        // -MIN does not fit an i128, but its ring expression does. Keep
        // the usual spelling for every other negative numeral.
        let n = if over {
            ap2("add", num(0 - (v + 1)), sym("z1"))
        } else { num(magnitude) }
        return Hm.A("neg".to_string(), one(n))
    }
    // 2 * (v / 2) + v % 2
    let two = ap2("add", sym("z1"), sym("z1"))
    let half = ap2("mul", two, num(v / 2))
    if v % 2 == 0 { half } else { ap2("add", half, sym("z1")) }
}

// MIR stores integer bits in i128, including the upper half of u128.
// Interpret those constants and switch labels in their source type.
fn typed_num(prog: Program, ty: u32, v: i128) -> Hm {
    match prog.types.int(ty) {
        Some(i) => if !i.signed && i.bits == 128 && v < 0 {
            let modulus = ap2("mul", num((1 as i128) << 126), num(4))
            return ap2("add", num(v), modulus)
        }
        None => {}
    }
    num(v)
}

fn one(sink t: Hm) -> Vec(Hm) {
    var xs = Vec(Hm).new()
    xs.push(t)
    xs
}

// Interpret a numeral's magnitude independently, in u128 so that 2^127
// fits. Used by the signed-boundary regression below.
fn numeral_magnitude(t: Hm) -> u128 {
    let n = t.name()
    if n == "z0" { return 0 }
    if n == "z1" { return 1 }
    let xs = t.args()
    if n == "add" { return numeral_magnitude(xs[0]) + numeral_magnitude(xs[1]) }
    if n == "mul" { return numeral_magnitude(xs[0]) * numeral_magnitude(xs[1]) }
    panic("not a non-negative numeral")
}

#[test]
fn signed_numeral_boundaries() {
    let half: i128 = 1 << 126
    let min = (0 - half) - half
    let limit: u128 = 1 << 127
    let t = num(min)
    assert(t.name() == "neg", "the minimum is negative")
    assert(numeral_magnitude(t.args()[0]) == limit, "the minimum's exact magnitude")
    assert(numeral_magnitude(num(half + (half - 1))) == limit - 1, "the maximum")
    assert(show(num(-1)) == "(neg z1)", "keep the existing negative spelling")
    assert(show(num(0)) == "z0", "zero")
}

// A local's value while a path runs.
#[derive(Clone)]
enum Val {
    Term(Hm)
    // A comparison of integers: Lt, Le, Eq or Ne.
    Cmp(Op, Hm, Hm)
    // A bool term, or its negation (false).
    Is(Hm, bool)
    // A mutable borrow of a place of this function.
    Ptr(Place)
    // The variant index of the value in a place.
    Discr(Place)
    Undef
}

fn negate(op: Op, a: Hm, b: Hm) -> Val {
    match op {
        Lt => Val.Cmp(Op.Le, b.clone(), a.clone())
        Le => Val.Cmp(Op.Lt, b.clone(), a.clone())
        Eq => Val.Cmp(Op.Ne, a.clone(), b.clone())
        _ => Val.Cmp(Op.Eq, a.clone(), b.clone())
    }
}

fn atom(op: Op, a: Hm, b: Hm) -> Hm {
    let name = match op {
        Lt => "lt"
        Le => "le"
        Eq => "eq"
        _ => "ne"
    }
    ap2(name, a, b)
}

impl St {
    // The path takes the comparison: false when it took one that
    // contradicts it before (its negation, or for `==` a strict order).
    fn assume(inout self, op: Op, a: Hm, b: Hm) -> bool {
        var bad = Vec(Hm).new()
        match op {
            Lt => {
                bad.push(atom(Op.Le, b, a))
                bad.push(atom(Op.Eq, a, b))
                bad.push(atom(Op.Eq, b, a))
            }
            Le => bad.push(atom(Op.Lt, b, a))
            Eq => {
                bad.push(atom(Op.Ne, a, b))
                bad.push(atom(Op.Ne, b, a))
                bad.push(atom(Op.Lt, a, b))
                bad.push(atom(Op.Lt, b, a))
            }
            _ => {
                bad.push(atom(Op.Eq, a, b))
                bad.push(atom(Op.Eq, b, a))
            }
        }
        for f in self.facts {
            if contains(bad.as_slice(), f) { return false }
        }
        self.facts.push(atom(op, a, b))
        true
    }
}

// The premises under which a comparison holds: one list per case.
fn holds(op: Op, a: Hm, b: Hm) -> Vec(Vec(Hm)) {
    var out = Vec(Vec(Hm)).new()
    match op {
        Lt => out.push(one(ap2("le", ap2("add", a, sym("z1")), b)))
        Le => out.push(one(ap2("le", a, b)))
        Eq => out.push(one(ap2("eq", a, b)))
        _ => {
            out.push(one(ap2("le", ap2("add", a, sym("z1")), b)))
            out.push(one(ap2("le", ap2("add", b, sym("z1")), a)))
        }
    }
    out
}

// A path's state: the locals' values, the rule head's terms (the values
// on entry), the premises so far, and where it is.
#[derive(Clone)]
struct St {
    vals: Vec(Val)
    head: Vec(Hm)
    prem: Vec(Hm)
    block: u32
    stmt: i64
    steps: i64
    // The comparisons the path has taken, as (lt a b), (le a b), (eq a b)
    // or (ne a b): a path that takes one and its negation has no rule.
    facts: Vec(Hm)
    // Calls of `Vec`'s `len` and `index` so far, which are functions: the
    // call (without its result) and the result.
    memo_keys: Vec(Hm)
    memo_vals: Vec(Hm)
}

impl St {
    // Every occurrence of the variable x replaced by t.
    fn subst(inout self, x: str, t: Hm) {
        for i in 0..self.vals.len() {
            let v = match self.vals[i].clone() {
                Term(a) => Val.Term(a.subst(x, t))
                Cmp(op, a, b) => Val.Cmp(op, a.subst(x, t), b.subst(x, t))
                Is(a, pos) => Val.Is(a.subst(x, t), pos)
                other => other
            }
            self.vals[i] = v
        }
        for i in 0..self.head.len() {
            let h = self.head[i].subst(x, t)
            self.head[i] = h
        }
        for i in 0..self.prem.len() {
            let p = self.prem[i].subst(x, t)
            self.prem[i] = p
        }
        for i in 0..self.facts.len() {
            let p = self.facts[i].subst(x, t)
            self.facts[i] = p
        }
        for i in 0..self.memo_keys.len() {
            let k = self.memo_keys[i].subst(x, t)
            let r = self.memo_vals[i].subst(x, t)
            self.memo_keys[i] = k
            self.memo_vals[i] = r
        }
    }
}

// What the translation writes, and what it has left to translate.
struct Out {
    sorts: Vec(String)
    decls: String
    rules: String
    queue: Vec(u32)
    queued: Vec(bool)
    fresh: i64
    lists: Vec(String)
}

fn sanitize(s: str) -> String {
    var out = String.new()
    for i in 0..s.len {
        let b = s[i]
        if b == ' ' { continue }
        if b == '(' {
            out.push('<')
        } else if b == ')' {
            out.push('>')
        } else { out.push(b) }
    }
    out
}

fn is_unit(prog: Program, t: u32) -> bool {
    match prog.types.kind(t) {
        Tuple(ts) => ts.len() == 0
        _ => false
    }
}

// A `Vec(E)` instance: its element type.
fn vec_elem(prog: Program, t: u32) -> Option(u32) {
    let name = prog.types.show(t)
    if !name.as_str().starts_with("Vec(") { return None }
    match prog.types.kind(t) {
        Adt(_) => {}
        _ => return None
    }
    // Vec's first field is the pointer to its elements.
    let fs = prog.types.field_tys(t)
    if fs.len() == 0 { return None }
    prog.types.pointee(fs[0])
}

impl Out {
    fn fresh_var(inout self) -> Hm {
        self.fresh += 1
        Hm.V("x" + self.fresh.to_string().as_str())
    }

    fn has_sort(self, s: str) -> bool {
        for x in self.sorts {
            if x == s { return true }
        }
        false
    }

    // The sort of values of type t, declaring it and its constructors.
    fn sort(inout self, prog: Program, t: u32) -> Result(String, String) {
        match prog.types.kind(t) {
            Int(_) => return Ok(String.from("Z"))
            Bool => {
                if !self.has_sort("B") {
                    self.sorts.push(String.from("B"))
                    self.decls.push_str("(ctor B.tt () B) (ctor B.ff () B)\n")
                }
                return Ok(String.from("B"))
            }
            Ref(p) | RefMut(p) => return self.sort(prog, p)
            Str => {
                if !self.has_sort("Str") {
                    self.sorts.push(String.from("Str"))
                    self.decls.push_str("(ctor Str.s () Str)\n")
                }
                return Ok(String.from("Str"))
            }
            Tuple(ts) => {
                if ts.len() == 0 {
                    if !self.has_sort("U") {
                        self.sorts.push(String.from("U"))
                        self.decls.push_str("(ctor U.u () U)\n")
                    }
                    return Ok(String.from("U"))
                }
                var parts = Vec(String).new()
                for x in ts { parts.push(self.sort(prog, x)?) }
                var name = String.from("Tup<")
                for i in 0..parts.len() {
                    if i > 0 { name.push(',') }
                    name.push_str(parts[i].as_str())
                }
                name.push('>')
                if !self.has_sort(name.as_str()) {
                    self.sorts.push(name.clone())
                    self.decls.push_str("(ctor " + name.as_str() + ".mk (")
                    for i in 0..parts.len() {
                        if i > 0 { self.decls.push(' ') }
                        self.decls.push_str(parts[i].as_str())
                    }
                    self.decls.push_str(") " + name.as_str() + ")\n")
                }
                return Ok(name)
            }
            Adt(_) => {}
            _ => return Err(
                "a value of type " + prog.types.show(t).as_str() + " is not in the fragment"
            )
        }
        let name = sanitize(prog.types.show(t).as_str())
        if self.has_sort(name.as_str()) { return Ok(name) }
        self.sorts.push(name.clone())
        match vec_elem(prog, t) {
            Some(e) => {
                let es = self.sort(prog, e)?
                let n = name.as_str()
                self.decls.push_str("(ctor " + n + ".nil () " + n + ") (ctor " + n + ".cons (" + es.as_str() + " " + n + ") " + n + ")\n")
                self.decls.push_str("(pred " + n + ".len (" + n + " Z)) (pred " + n + ".nth (" + n + " Z " + es.as_str() + ")) (pred " + n + ".snoc (" + n + " " + es.as_str() + " " + n + "))\n")
                self.rules.push_str(
                    "(rule " + n + ".len.nil () (" + n + ".len " + n + ".nil z0))\n"
                )
                self.rules.push_str("(rule " + n + ".len.cons ((" + n + ".len ?l ?n)) (" + n + ".len (" + n + ".cons ?e ?l) (add ?n z1)))\n")
                self.rules.push_str("(rule " + n + ".nth.zero ((eq ?i z0)) (" + n + ".nth (" + n + ".cons ?e ?l) ?i ?e))\n")
                self.rules.push_str("(rule " + n + ".nth.succ ((" + n + ".nth ?l ?j ?e) (eq ?i (add ?j z1))) (" + n + ".nth (" + n + ".cons ?x ?l) ?i ?e))\n")
                self.rules.push_str("(rule " + n + ".snoc.nil () (" + n + ".snoc " + n + ".nil ?e (" + n + ".cons ?e " + n + ".nil)))\n")
                self.rules.push_str("(rule " + n + ".snoc.cons ((" + n + ".snoc ?l ?e ?m)) (" + n + ".snoc (" + n + ".cons ?x ?l) ?e (" + n + ".cons ?x ?m)))\n")
                return Ok(name)
            }
            None => {}
        }
        match prog.types.variants(t) {
            Some(vs) => {
                let vs = vs.clone()
                for v in vs {
                    var parts = Vec(String).new()
                    for f in v.fields { parts.push(self.sort(prog, f)?) }
                    self.decls.push_str("(ctor " + name.as_str() + "." + v.name.as_str() + " (")
                    for i in 0..parts.len() {
                        if i > 0 { self.decls.push(' ') }
                        self.decls.push_str(parts[i].as_str())
                    }
                    self.decls.push_str(") " + name.as_str() + ")\n")
                }
                return Ok(name)
            }
            None => {}
        }
        var parts = Vec(String).new()
        for f in prog.types.field_tys(t) { parts.push(self.sort(prog, f)?) }
        self.decls.push_str("(ctor " + name.as_str() + ".mk (")
        for i in 0..parts.len() {
            if i > 0 { self.decls.push(' ') }
            self.decls.push_str(parts[i].as_str())
        }
        self.decls.push_str(") " + name.as_str() + ")\n")
        Ok(name)
    }

    // The constructor of a struct or tuple type, and of an enum variant.
    fn ctor(inout self, prog: Program, t: u32, variant: i64) -> Result(String, String) {
        let s = self.sort(prog, t)?
        if variant < 0 { return Ok(s + ".mk") }
        match prog.types.variants(t) {
            Some(vs) => Ok(s + "." + vs[variant].name.as_str())
            None => Err(String.from("not an enum"))
        }
    }

    fn enqueue(inout self, f: u32) {
        while self.queued.len() <= f as i64 { self.queued.push(false) }
        if self.queued[f as i64] { return }
        self.queued[f as i64] = true
        self.queue.push(f)
    }
}

fn pred_name(
    prog: Program,
    f: u32
) -> String { "fn." + sanitize(prog.fns[f as i64].name.as_str()).as_str() }

// The type of a place, following its projections.
fn place_ty(prog: Program, b: Body, p: Place) -> u32 {
    var t = b.locals[p.local as i64].ty
    var variant: i64 = -1
    for pr in p.proj {
        match pr {
            Deref => t = match prog.types.pointee(t) {
                Some(x) => x
                None => t
            }
            Variant(v) => variant = v as i64
            Field(i) => {
                if variant >= 0 {
                    t = match prog.types.variants(t) {
                        Some(vs) => vs[variant].fields[i as i64]
                        None => t
                    }
                    variant = -1
                } else { t = prog.types.field_tys(t)[i as i64] }
            }
            Index(_) => {}
        }
    }
    t
}

// One function's translation.
struct Fx {
    f: u32
    pred: String
    cuts: Vec(bool)
    // The locals each cut point's state holds.
    live: Vec(Vec(u32))
}

fn successors(t: mir.Term) -> Vec(u32) {
    var out = Vec(u32).new()
    match t {
        Goto(x) => out.push(x)
        Switch(_, ts, other) => {
            for x in ts { out.push(x.block) }
            out.push(other)
        }
        Call(_, _, _, next, _) => out.push(next)
        Assert(_, _, next, _) => out.push(next)
        _ => {}
    }
    out
}

// Blocks that are targets of back edges, from a depth-first walk.
fn cut_points(b: Body) -> Vec(bool) {
    let n = b.blocks.len()
    var cuts = Vec(bool).filled(n, false)
    var state = Vec(u8).filled(n, 0)
    var stack = Vec((u32, i64)).new()
    stack.push((0, 0))
    state[0] = 1
    loop {
        let Some(top) = stack.pop() else { break }
        let succ = successors(b.blocks[top.0 as i64].term)
        if top.1 < succ.len() {
            stack.push((top.0, top.1 + 1))
            let s = succ[top.1]
            if state[s as i64] == 1 {
                cuts[s as i64] = true
            } else if state[s as i64] == 0 {
                state[s as i64] = 1
                stack.push((s, 0))
            }
        } else { state[top.0 as i64] = 2 }
    }
    cuts
}

// Locals whose value may be read, before it is set, from the entry of
// each block on: what a cut point's state must hold. A local read where
// it is not in the state is an error, so a mistake here loses a
// translation, never soundness.
fn live_locals(b: Body) -> Vec(Vec(bool)) {
    let n = b.blocks.len()
    let m = b.locals.len()
    var uses = Vec(Vec(bool)).new()
    var defs = Vec(Vec(bool)).new()
    for k in 0..n {
        var u = Vec(bool).filled(m, false)
        var d = Vec(bool).filled(m, false)
        for st in b.blocks[k].stmts {
            match st {
                Assign(p, rv, _) => {
                    rvalue_uses(rv, d.as_slice(), &u)
                    target(p, &u, &d)
                }
                _ => {}
            }
        }
        match b.blocks[k].term {
            Switch(op, _, _) => operand_use(op, d.as_slice(), &u)
            Assert(op, _, _, _) => operand_use(op, d.as_slice(), &u)
            Call(_, args, dest, _, _) => {
                for a in args { operand_use(a, d.as_slice(), &u) }
                target(dest, &u, &d)
            }
            Return => if !d[0] { u[0] = true }
            _ => {}
        }
        uses.push(u)
        defs.push(d)
    }
    var live = Vec(Vec(bool)).new()
    for _ in 0..n { live.push(Vec(bool).filled(m, false)) }
    var changed = true
    while changed {
        changed = false
        var k = n
        while k > 0 {
            k -= 1
            var cur = uses[k].clone()
            for s in successors(b.blocks[k].term) {
                for l in 0..m {
                    if live[s as i64][l] && !defs[k][l] { cur[l] = true }
                }
            }
            for l in 0..m {
                if cur[l] && !live[k][l] {
                    live[k][l] = true
                    changed = true
                }
            }
        }
    }
    live
}

// A write: of a whole local defines it, of a part reads it too.
fn target(p: Place, inout u: Vec(bool), inout d: Vec(bool)) {
    let l = p.local as i64
    if p.proj.len() == 0 {
        d[l] = true
    } else {
        place_use(p, d.as_slice(), &u)
    }
}

fn place_use(p: Place, d: [bool], inout u: Vec(bool)) {
    if !d[p.local as i64] { u[p.local as i64] = true }
    for pr in p.proj {
        match pr {
            Index(l) => if !d[l as i64] { u[l as i64] = true }
            _ => {}
        }
    }
}

fn operand_use(op: Operand, d: [bool], inout u: Vec(bool)) {
    match op {
        Copy(p) | Move(p) => place_use(p, d, &u)
        Const(_) => {}
    }
}

fn rvalue_uses(rv: Rvalue, d: [bool], inout u: Vec(bool)) {
    match rv {
        Use(x) => operand_use(x, d, &u)
        Bin(_, x, y) => {
            operand_use(x, d, &u)
            operand_use(y, d, &u)
        }
        Un(_, x) => operand_use(x, d, &u)
        Cast(x, _, _) => operand_use(x, d, &u)
        Ref(p) | RefMut(p) | Addr(p) | Discriminant(p) => place_use(p, d, &u)
        Aggregate(_, xs) => for x in xs { operand_use(x, d, &u) }
        Offset(x, y) => {
            operand_use(x, d, &u)
            operand_use(y, d, &u)
        }
        Repeat(x, _) => operand_use(x, d, &u)
    }
}

// The translation of the functions named in `roots` and of what they call.
pub fn emit(prog: Program, roots: [str]) -> Result(String, String) {
    if !prog.checked { return Err(String.from(
        "the translation needs overflow checks (not --release)"
    )) }
    var o = Out {
        sorts: Vec(String).new(), decls: String.new(), rules: String.new(), queue: Vec(u32).new()
        queued: Vec(bool).new(), fresh: 0, lists: Vec(String).new()
    }
    for r in roots {
        var found = false
        for i in 0..prog.fns.len() {
            if prog.fns[i].name == r && prog.fns[i].body.is_some() {
                o.enqueue(i as u32)
                found = true
            }
        }
        if !found { return Err("no function named " + r) }
    }
    var done = 0
    while done < o.queue.len() {
        let f = o.queue[done]
        done += 1
        translate(prog, f, &o)?
    }
    var text = String.from("; Generated by `jihoo emit-horn`: what the MIR computes.\n")
    text.push_str("(sort Fuel)\n")
    for s in o.sorts { text.push_str("(sort " + s.as_str() + ")\n") }
    text.push_str("(ctor fuel0 () Fuel) (ctor fuel1 (Fuel) Fuel)\n")
    text.push_str(o.decls.as_str())
    text.push_str(o.rules.as_str())
    Ok(text)
}

fn translate(prog: Program, f: u32, inout o: Out) -> Result((), String) {
    let func = prog.fns[f as i64]
    let Some(b) = func.body else { return Err("`" + func.name.as_str() + "` has no body") }
    let pred = pred_name(prog, f)
    let cuts = cut_points(b)
    let live = live_locals(b)
    var fx = Fx { f, pred: pred.clone(), cuts: cuts.clone(), live: Vec(Vec(u32)).new() }
    // The predicate of the function, and of each cut point.
    var sig = Vec(String).new()
    for a in 1..b.arg_count + 1 {
        if is_unit(prog, b.locals[a].ty) { return Err("a unit parameter is not in the fragment") }
        sig.push(o.sort(prog, b.locals[a].ty)?)
    }
    sig.push(o.sort(prog, b.locals[0].ty)?)
    o.decls.push_str("(pred " + pred.as_str() + " (" + join(sig.as_slice()).as_str() + "))\n")
    for k in 0..b.blocks.len() {
        var ls = Vec(u32).new()
        if cuts[k] {
            var ss = Vec(String).new()
            ss.push(String.from("Fuel"))
            for l in 1..b.locals.len() {
                let t = b.locals[l].ty
                if live[k][l] && !is_unit(prog, t) && t != types.NEVER {
                    ls.push(l as u32)
                    ss.push(o.sort(prog, t)?)
                }
            }
            ss.push(o.sort(prog, b.locals[0].ty)?)
            o.decls.push_str("(pred " + cut_pred(pred.as_str(), k as u32).as_str() + " (" + join(
                ss.as_slice()
            ).as_str() + "))\n")
        }
        fx.live.push(ls)
    }
    // From the entry, then from each cut point.
    var st = start(prog, b, &o)
    // A struct or tuple argument is its constructor of new variables: its
    // sort has that one constructor.
    for a in 1..b.arg_count + 1 { st.vals[a] = Val.Term(fresh_value(prog, b.locals[a].ty, &o)?) }
    for a in 1..b.arg_count + 1 {
        match st.vals[a].clone() {
            Term(t) => st.head.push(t)
            _ => {}
        }
    }
    st.block = 0
    match run(prog, b, fx, -1, st, &o) {
        Ok(_) => {}
        Err(e) => return Err("`" + func.name.as_str() + "`: " + e.as_str())
    }
    for k in 0..b.blocks.len() {
        if !cuts[k] { continue }
        var st = start(prog, b, &o)
        for l in fx.live[k] {
            let t = o.fresh_var()
            st.vals[l as i64] = Val.Term(t.clone())
            st.head.push(t)
        }
        st.block = k as u32
        match run(prog, b, fx, k, st, &o) {
            Ok(_) => {}
            Err(e) => return Err(
                "`" + func.name.as_str() + "` from bb" + k.to_string().as_str() + ": " + e.as_str()
            )
        }
    }
    Ok(())
}

// A value of type t: a new variable, or for a struct or tuple, its
// constructor applied to new values of its fields.
fn fresh_value(prog: Program, t: u32, inout o: Out) -> Result(Hm, String) {
    let u = match prog.types.pointee(t) {
        Some(x) => if prog.types.is_ref(t) { x } else { t }
        None => t
    }
    let plain = match prog.types.kind(u) {
        Adt(_) => prog.types.variants(u).is_none() && vec_elem(prog, u).is_none()
        Tuple(ts) => ts.len() > 0
        _ => false
    }
    if !plain { return Ok(o.fresh_var()) }
    let c = o.ctor(prog, u, -1)?
    var args = Vec(Hm).new()
    for f in prog.types.field_tys(u) { args.push(fresh_value(prog, f, &o)?) }
    Ok(ap(c.as_str(), args))
}

fn cut_pred(pred: str, k: u32) -> String { pred + "@" + k.to_string().as_str() }

fn join(xs: [String]) -> String {
    var out = String.new()
    for i in 0..xs.len {
        if i > 0 { out.push(' ') }
        out.push_str(xs[i].as_str())
    }
    out
}

fn start(prog: Program, b: Body, inout o: Out) -> St {
    var vals = Vec(Val).new()
    for l in 0..b.locals.len() {
        if is_unit(prog, b.locals[l].ty) { vals.push(Val.Term(sym("U.u"))) } else { vals.push(
            Val.Undef
        ) }
    }
    St {
        vals,
        head: Vec(Hm).new(),
        prem: Vec(Hm).new(),
        block: 0,
        stmt: 0,
        steps: 0,
        facts: Vec(Hm).new()
        memo_keys: Vec(Hm).new(), memo_vals: Vec(Hm).new()
    }
}

fn write_rule(inout o: Out, head: Hm, prem: [Hm]) {
    o.fresh += 1
    o.rules.push_str("(rule r" + o.fresh.to_string().as_str() + " (")
    for i in 0..prem.len {
        if i > 0 { o.rules.push(' ') }
        prem[i].write(&o.rules)
    }
    o.rules.push_str(") ")
    head.write(&o.rules)
    o.rules.push_str(")\n")
}

// The rule head for a path that started at `from` (-1: the entry).
fn head(fx: Fx, from: i64, st: St, result: Hm, fuel: Hm) -> Hm {
    var args = Vec(Hm).new()
    if from < 0 {
        for h in st.head { args.push(h.clone()) }
        args.push(result.clone())
        return ap(fx.pred.as_str(), args)
    }
    args.push(fuel.clone())
    for h in st.head { args.push(h.clone()) }
    args.push(result.clone())
    ap(cut_pred(fx.pred.as_str(), from as u32).as_str(), args)
}

fn term(v: Val) -> Result(Hm, String) {
    match v {
        Term(t) => Ok(t.clone())
        Undef => Err(String.from("a value is read before it is set"))
        _ => Err(String.from("a comparison, borrow or discriminant is used as a value"))
    }
}

// Run a path from its block and statement until it returns, reaches a
// cut point or stops.
fn run(
    prog: Program,
    b: Body,
    fx: Fx,
    from: i64,
    sink st0: St,
    inout o: Out
) -> Result((), String) {
    var st = st0
    loop {
        let k = st.block as i64
        if st.stmt == 0 && fx.cuts[k] && (st.steps > 0 || from != k) {
            // A cut point: the path continues from there, with each bool
            // that is a comparison made a term, case by case.
            var pending = Vec(St).new()
            pending.push(st)
            var states = Vec(St).new()
            reify(fx.live[k].as_slice(), 0, pending, &states, &o)?
            for s2 in states { cut(fx, from, k, s2, &o)? }
            return Ok(())
        }
        let stmts = b.blocks[k].stmts
        while st.stmt < stmts.len() {
            let s = stmts[st.stmt]
            match s {
                Assign(p, rv, _) => {
                    let v = rvalue(prog, b, &st, rv, &o)?
                    write(prog, b, &st, p, v, &o)?
                }
                _ => {}
            }
            st.stmt += 1
        }
        st.steps += 1
        match b.blocks[k].term {
            Goto(t) => {
                st.block = t
                st.stmt = 0
            }
            Return => {
                let r = match st.vals[0].clone() {
                    Cmp(op, x, y) => {
                        // Return each truth value under its case.
                        for s2 in truth(st, op, x, y, 0).into_iter() { finish(fx, from, s2, &o)? }
                        return Ok(())
                    }
                    other => other
                }
                st.vals[0] = r
                return finish(fx, from, st, &o)
            }
            Unreachable | Pending => return Ok(())
            Switch(op, targets, otherwise) => return switch(
                prog,
                b,
                fx,
                from,
                st,
                op,
                targets,
                otherwise,
                &o
            )
            Assert(cond, _, next, _) => {
                let c = operand(prog, b, &st, cond, &o)?
                return branch(prog, b, fx, from, st, c, true, next, &o)
            }
            Call(callee, args, dest, next, _) => {
                if b.locals[dest.local as i64].ty == types.NEVER { return Ok(()) }
                match callee {
                    Intrinsic(i) => match i {
                        Trap => return Ok(())
                        Overflowing(op, t) => {
                            let x = term(operand(prog, b, &st, args[0], &o)?)?
                            let y = term(operand(prog, b, &st, args[1], &o)?)?
                            let f = if op == Op.Add { "add" } else if op == Op.Sub { "sub" } else { "mul" }
                            let exact = if f == "sub" { ap2(
                                "add",
                                x,
                                Hm.A(String.from("neg"), one(y.clone()))
                            ) } else { ap2(f, x, y) }
                            let pair_ty = b.locals[dest.local as i64].ty
                            let c = o.ctor(prog, pair_ty, -1)?
                            // The flag is false and the result exact, or the
                            // flag is true and the result anything.
                            var s1 = st.clone()
                            write(
                                prog,
                                b,
                                &s1,
                                dest,
                                Val.Term(ap2(c.as_str(), exact, sym("B.ff"))),
                                &o
                            )?
                            s1.block = next
                            s1.stmt = 0
                            run(prog, b, fx, from, s1, &o)?
                            let w = o.fresh_var()
                            write(
                                prog,
                                b,
                                &st,
                                dest,
                                Val.Term(ap2(c.as_str(), w, sym("B.tt"))),
                                &o
                            )?
                            st.block = next
                            st.stmt = 0
                            continue
                        }
                        _ => return Err(String.from("this intrinsic is not in the fragment"))
                    }
                    Fn(g) => {
                        let v = call(prog, b, &st, g, args, &o)?
                        write(prog, b, &st, dest, v, &o)?
                        st.block = next
                        st.stmt = 0
                    }
                    _ => return Err(String.from("an indirect call is not in the fragment"))
                }
            }
        }
    }
}

// The states in which each of `locals` from `i` on holds a term: a
// comparison becomes true or false under the premises of each case.
fn reify(
    locals: [u32],
    i: i64,
    sink pending: Vec(St),
    inout out: Vec(St),
    inout o: Out
) -> Result((), String) {
    if i == locals.len {
        for s in pending.into_iter() { out.push(s) }
        return Ok(())
    }
    let l = locals[i] as i64
    var next = Vec(St).new()
    for st in pending.into_iter() {
        match st.vals[l].clone() {
            Cmp(op, x, y) => for s2 in truth(st, op, x, y, l).into_iter() { next.push(s2) }
            Is(t, pos) => {
                for want in [true, false] {
                    var s2 = st.clone()
                    if bind(&s2, t, sym(if want { "B.tt" } else { "B.ff" })) {
                        s2.vals[l] = Val.Term(sym(if want == pos { "B.tt" } else { "B.ff" }))
                        next.push(s2)
                    }
                }
            }
            _ => next.push(st)
        }
    }
    reify(locals, i + 1, next, &out, &o)
}

// The states where local l, the comparison op(x, y), is B.tt and B.ff:
// one per case of each, unless the path took the opposite already.
fn truth(st: St, op: Op, x: Hm, y: Hm, l: i64) -> Vec(St) {
    var out = Vec(St).new()
    for want in [true, false] {
        let v = if want { Val.Cmp(op, x.clone(), y.clone()) } else { negate(op, x, y) }
        let Cmp(op2, x2, y2) = v else { continue }
        for s2 in take(st, op2, x2, y2).into_iter() {
            var s3 = s2
            s3.vals[l] = Val.Term(sym(if want { "B.tt" } else { "B.ff" }))
            out.push(s3)
        }
    }
    out
}

// The states where the path takes op(x, y): one per case (`!=` is `<` or
// `>`), each without a case the path took the opposite of.
fn take(st: St, op: Op, x: Hm, y: Hm) -> Vec(St) {
    var out = Vec(St).new()
    if op == Op.Ne {
        var s0 = st.clone()
        if !s0.assume(Op.Ne, x, y) { return out }
        for s2 in take(s0, Op.Lt, x, y).into_iter() { out.push(s2) }
        for s2 in take(s0, Op.Lt, y, x).into_iter() { out.push(s2) }
        return out
    }
    var s1 = st.clone()
    if !s1.assume(op, x, y) { return out }
    for c in holds(op, x, y) {
        for p in c {
            if !contains(s1.prem.as_slice(), p) { s1.prem.push(p.clone()) }
        }
    }
    out.push(s1)
    out
}

// The rule for a path that reaches cut point k.
fn cut(fx: Fx, from: i64, k: i64, st: St, inout o: Out) -> Result((), String) {
    let r = o.fresh_var()
    var args = Vec(Hm).new()
    let n = o.fresh_var()
    args.push(n.clone())
    for l in fx.live[k] {
        // A local not set yet on this path is not read before it is set
        // (elab checks): any value stands for it.
        match st.vals[l as i64] {
            Undef => args.push(o.fresh_var())
            _ => args.push(term(st.vals[l as i64])?)
        }
    }
    args.push(r.clone())
    var prem = st.prem.clone()
    prem.push(ap(cut_pred(fx.pred.as_str(), k as u32).as_str(), args))
    let fuel = if from < 0 { n.clone() } else { Hm.A(String.from("fuel1"), one(n.clone())) }
    let h = head(fx, from, st, r, fuel)
    write_rule(&o, h, prem.as_slice())
    Ok(())
}

fn finish(fx: Fx, from: i64, st: St, inout o: Out) -> Result((), String) {
    let r = term(st.vals[0])?
    let fuel = o.fresh_var()
    let h = head(fx, from, st, r, fuel)
    write_rule(&o, h, st.prem.as_slice())
    Ok(())
}

// Continue at `next` where the condition `c` is `want`.
fn branch(
    prog: Program, b: Body, fx: Fx, from: i64, st: St, c: Val, want: bool, next: u32, inout o: Out
) -> Result((), String) {
    match c {
        Cmp(op, x, y) => {
            let v = if want { Val.Cmp(op, x.clone(), y.clone()) } else { negate(op, x, y) }
            match v {
                Cmp(op2, x2, y2) => for s2 in take(st, op2, x2, y2).into_iter() {
                    var s3 = s2
                    s3.block = next
                    s3.stmt = 0
                    run(prog, b, fx, from, s3, &o)?
                }
                _ => {}
            }
            Ok(())
        }
        Term(t) => branch(prog, b, fx, from, st, Val.Is(t.clone(), true), want, next, &o)
        Is(t, pos) => {
            let want_t = sym(if want == pos { "B.tt" } else { "B.ff" })
            var s2 = st.clone()
            if !bind(&s2, t, want_t) { return Ok(()) }
            s2.block = next
            s2.stmt = 0
            run(prog, b, fx, from, s2, &o)
        }
        _ => Err(String.from("a branch on a value that is not a bool"))
    }
}

// The path where t is u: false when they cannot be equal.
fn bind(inout st: St, t: Hm, u: Hm) -> bool {
    match t {
        V(x) => {
            st.subst(x.as_str(), u)
            true
        }
        A(f, xs) => match u {
            V(y) => {
                st.subst(y.as_str(), t)
                true
            }
            A(g, ys) => {
                if f != g || xs.len() != ys.len() { return false }
                for i in 0..xs.len() {
                    // Terms are the values of locals: unify the parts too.
                    let a = xs[i].clone()
                    let c = ys[i].clone()
                    if a != c && !bind(&st, a, c) { return false }
                }
                true
            }
        }
    }
}

fn switch(
    prog: Program,
    b: Body,
    fx: Fx,
    from: i64,
    sink st0: St,
    op: Operand,
    targets: Vec(mir.SwitchTarget),
    otherwise: u32,
    inout o: Out
) -> Result((), String) {
    var st = st0
    let v = operand(prog, b, &st, op, &o)?
    match v.clone() {
        Cmp(_, _, _) | Is(_, _) => {
            // A bool: 0 is false.
            for t in targets {
                branch(prog, b, fx, from, st, v, t.value != 0, t.block, &o)?
            }
            if targets.len() == 1 {
                branch(prog, b, fx, from, st, v, targets[0].value == 0, otherwise, &o)?
            }
            Ok(())
        }
        Discr(p) => {
            let t = place_ty(prog, b, p)
            let Some(vs) = prog.types.variants(t) else { return Err(String.from(
                "a discriminant of a non-enum"
            )) }
            let n = vs.len()
            for vi in 0..n {
                var target = otherwise
                for x in targets {
                    if x.value == vi as i128 { target = x.block }
                }
                var s2 = st.clone()
                let cur = term(read(prog, b, &s2, p, &o)?)?
                var args = Vec(Hm).new()
                for _ in vs[vi].fields { args.push(o.fresh_var()) }
                let c = o.ctor(prog, t, vi)?
                if !bind(&s2, cur, ap(c.as_str(), args)) { continue }
                s2.block = target
                s2.stmt = 0
                run(prog, b, fx, from, s2, &o)?
            }
            Ok(())
        }
        Term(x) => {
            if operand_ty(prog, b, op) == types.BOOL {
                // A bool from a call or a constant: 0 is false.
                for t in targets {
                    branch(prog, b, fx, from, st, v, t.value != 0, t.block, &o)?
                }
                if targets.len() == 1 {
                    branch(prog, b, fx, from, st, v, targets[0].value == 0, otherwise, &o)?
                }
                return Ok(())
            }
            if targets.len() != 1 { return Err(String.from(
                "a switch on an integer with several values"
            )) }
            // x == value, or x < value, or x > value.
            let c = Val.Cmp(
                Op.Eq,
                x.clone(),
                typed_num(prog, operand_ty(prog, b, op), targets[0].value)
            )
            branch(prog, b, fx, from, st, c, true, targets[0].block, &o)?
            branch(prog, b, fx, from, st, c, false, otherwise, &o)
        }
        _ => Err(String.from("a switch on something that is not a bool or a discriminant"))
    }
}

fn operand(prog: Program, b: Body, inout st: St, op: Operand, inout o: Out) -> Result(Val, String) {
    match op {
        Copy(p) | Move(p) => read(prog, b, &st, p, &o)
        Const(c) => match c {
            Int(v, t) => Ok(Val.Term(typed_num(prog, t, v)))
            Bool(x) => Ok(Val.Term(sym(if x { "B.tt" } else { "B.ff" })))
            Str(_) => Ok(Val.Term(sym("Str.s")))
            Zst(_) => Ok(Val.Term(sym("U.u")))
            _ => Err(String.from("a constant that is not in the fragment"))
        }
    }
}

// The value in a place; expanding a variable of a struct or enum type into
// its constructor where a field is read.
fn read(prog: Program, b: Body, inout st: St, p: Place, inout o: Out) -> Result(Val, String) {
    var v = st.vals[p.local as i64].clone()
    match v {
        Undef => return Err("_" + p.local.to_string().as_str() + " is read before it is set, in bb" + st.block.to_string().as_str())
        _ => {}
    }
    var t = b.locals[p.local as i64].ty
    var variant: i64 = -1
    for pr in p.proj {
        match pr {
            Deref => {
                match v.clone() {
                    Ptr(q) => v = read(prog, b, &st, q, &o)?
                    _ => {}
                }
                t = match prog.types.pointee(t) {
                    Some(x) => x
                    None => t
                }
            }
            Variant(vi) => variant = vi as i64
            Field(i) => {
                let cur = term(v)?
                let (c, n) = if variant >= 0 {
                    let Some(vs) = prog.types.variants(t) else { return Err(String.from(
                        "a variant of a non-enum"
                    )) }
                    (o.ctor(prog, t, variant)?, vs[variant].fields.len())
                } else { (o.ctor(prog, t, -1)?, prog.types.field_tys(t).len()) }
                var whole = cur.clone()
                if cur.is_var() {
                    var args = Vec(Hm).new()
                    for _ in 0..n { args.push(o.fresh_var()) }
                    whole = ap(c.as_str(), args)
                    st.subst(cur.name(), whole)
                } else if cur.name() != c {
                    return Err(String.from("a field of another variant"))
                }
                let next_t = if variant >= 0 {
                    prog.types.variants(t).unwrap()[variant].fields[i as i64]
                } else { prog.types.field_tys(t)[i as i64] }
                v = Val.Term(whole.args()[i as i64].clone())
                t = next_t
                variant = -1
            }
            Index(_) => return Err(String.from("an array index is not in the fragment"))
        }
    }
    Ok(v)
}

// Set the value in a place.
fn write(
    prog: Program,
    b: Body,
    inout st: St,
    p: Place,
    v: Val,
    inout o: Out
) -> Result((), String) {
    if p.proj.len() == 0 {
        st.vals[p.local as i64] = v.clone()
        return Ok(())
    }
    match p.proj[0] {
        Deref => match st.vals[p.local as i64].clone() {
            Ptr(q) => {
                var full = q.clone()
                for i in 1..p.proj.len() { full.proj.push(p.proj[i].clone()) }
                return write(prog, b, &st, full, v, &o)
            }
            _ => return Err(String.from("a write through a shared borrow"))
        }
        _ => {}
    }
    // A field: rebuild the value around it.
    var outer = p.clone()
    let last = outer.proj.pop().unwrap()
    let Field(i) = last else { return Err(String.from("a write to a part that is not a field")) }
    let container = term(read(prog, b, &st, outer, &o)?)?
    if container.is_var() { return Err(String.from("a field written before its value is known")) }
    var args = Vec(Hm).new()
    for a in container.args() { args.push(a.clone()) }
    args[i as i64] = term(v)?
    write(prog, b, &st, outer, Val.Term(Hm.A(container.name().to_string(), args)), &o)
}

fn rvalue(prog: Program, b: Body, inout st: St, rv: Rvalue, inout o: Out) -> Result(Val, String) {
    match rv {
        Use(x) => Ok(operand(prog, b, &st, x, &o)?)
        Bin(op, x, y) => {
            let tx = operand_ty(prog, b, x)
            if !prog.types.is_int(tx) { return Err(String.from(
                "an operation on values that are not integers"
            )) }
            let a = term(operand(prog, b, &st, x, &o)?)?
            let c = term(operand(prog, b, &st, y, &o)?)?
            match op {
                Add => Ok(Val.Term(ap2("add", a, c)))
                Sub => Ok(Val.Term(ap2("add", a, Hm.A(String.from("neg"), one(c)))))
                Mul => Ok(Val.Term(ap2("mul", a, c)))
                Lt => Ok(Val.Cmp(Op.Lt, a, c))
                Le => Ok(Val.Cmp(Op.Le, a, c))
                Gt => Ok(Val.Cmp(Op.Lt, c, a))
                Ge => Ok(Val.Cmp(Op.Le, c, a))
                Eq => Ok(Val.Cmp(Op.Eq, a, c))
                Ne => Ok(Val.Cmp(Op.Ne, a, c))
                _ => Err("the operation `" + op.text() + "` is not in the fragment")
            }
        }
        Un(op, x) => {
            let v = operand(prog, b, &st, x, &o)?
            match op {
                Neg => Ok(Val.Term(Hm.A(String.from("neg"), one(term(v)?))))
                Not => match v {
                    Cmp(o2, a, c) => Ok(negate(o2, a, c))
                    Term(t) => Ok(Val.Is(t.clone(), false))
                    Is(t, pos) => Ok(Val.Is(t.clone(), !pos))
                    _ => Err(String.from("`!` of a value that is not a bool"))
                }
            }
        }
        Cast(x, to, kind) => {
            let from = operand_ty(prog, b, x)
            let (Some(fi), Some(ti)) = (prog.types.int(from), prog.types.int(to)) else {
                return Err(String.from("a cast that is not between integers"))
            }
            // Widening keeps the value.
            let keeps = (fi.signed == ti.signed && ti.bits >= fi.bits) || (
                !fi.signed && ti.signed && ti.bits > fi.bits
            )
            if !keeps { return Err(String.from("a cast that may change the value")) }
            Ok(operand(prog, b, &st, x, &o)?)
        }
        Ref(p) => Ok(read(prog, b, &st, p, &o)?)
        RefMut(p) => Ok(Val.Ptr(p.clone()))
        Aggregate(agg, ops) => {
            var args = Vec(Hm).new()
            for x in ops { args.push(term(operand(prog, b, &st, x, &o)?)?) }
            match agg {
                Struct(t) => Ok(Val.Term(ap(o.ctor(prog, t, -1)?.as_str(), args)))
                Variant(t, vi) => Ok(Val.Term(ap(o.ctor(prog, t, vi as i64)?.as_str(), args)))
                _ => Err(String.from("an aggregate that is not in the fragment"))
            }
        }
        Discriminant(p) => Ok(Val.Discr(p.clone()))
        _ => Err(String.from("an rvalue that is not in the fragment"))
    }
}

fn operand_ty(prog: Program, b: Body, x: Operand) -> u32 {
    match x {
        Copy(p) | Move(p) => place_ty(prog, b, p)
        Const(c) => match c {
            Int(_, t) => t
            Bool(_) => types.BOOL
            _ => types.UNIT
        }
    }
}

// A call: std's `Vec` by its specification, other functions by their
// predicates.
fn call(
    prog: Program,
    b: Body,
    inout st: St,
    g: u32,
    args: Vec(Operand),
    inout o: Out
) -> Result(Val, String) {
    let func = prog.fns[g as i64]
    let name = func.name.as_str()
    if name.starts_with("Vec(") {
        let Some(dot) = last_dot(name) else { return Err("`" + name + "` is not in the fragment") }
        let method = name[dot + 1..name.len]
        // The Vec type: the result of `new` and `with_capacity`, else what
        // the first parameter borrows.
        let creates = method == "new" || method == "with_capacity"
        let self_ty = if creates || func.sig.params.len() == 0 {
            func.sig.ret
        } else {
            match prog.types.pointee(func.sig.params[0]) {
                Some(x) => x
                None => func.sig.params[0]
            }
        }
        let s = o.sort(prog, self_ty)?
        if method == "new" || method == "with_capacity" { return Ok(Val.Term(sym(
            (s + ".nil").as_str()
        ))) }
        if method == "clone" { return operand(prog, b, &st, args[0], &o) }
        if method == "len" {
            let v = term(operand(prog, b, &st, args[0], &o)?)?
            let key = ap2("len", v, sym("U.u"))
            for k in 0..st.memo_keys.len() {
                if st.memo_keys[k] == key { return Ok(Val.Term(st.memo_vals[k].clone())) }
            }
            let n = o.fresh_var()
            st.memo_keys.push(key)
            st.memo_vals.push(n.clone())
            st.prem.push(ap2((s + ".len").as_str(), v, n))
            return Ok(Val.Term(n))
        }
        if method == "index" {
            let v = term(operand(prog, b, &st, args[0], &o)?)?
            let i = term(operand(prog, b, &st, args[1], &o)?)?
            let key = ap2("nth", v, i)
            for k in 0..st.memo_keys.len() {
                if st.memo_keys[k] == key { return Ok(Val.Term(st.memo_vals[k].clone())) }
            }
            let e = o.fresh_var()
            st.memo_keys.push(key)
            st.memo_vals.push(e.clone())
            var xs = Vec(Hm).new()
            xs.push(v)
            xs.push(i)
            xs.push(e.clone())
            st.prem.push(ap((s + ".nth").as_str(), xs))
            return Ok(Val.Term(e))
        }
        if method == "push" {
            let p = operand(prog, b, &st, args[0], &o)?
            let Ptr(place) = p else { return Err(String.from("`push` without a mutable borrow")) }
            let old = term(read(prog, b, &st, place, &o)?)?
            let e = term(operand(prog, b, &st, args[1], &o)?)?
            let m = o.fresh_var()
            var xs = Vec(Hm).new()
            xs.push(old)
            xs.push(e)
            xs.push(m.clone())
            st.prem.push(ap((s + ".snoc").as_str(), xs))
            write(prog, b, &st, place, Val.Term(m), &o)?
            return Ok(Val.Term(sym("U.u")))
        }
        return Err("`" + name + "` is not in the fragment")
    }
    if func.body.is_none() { return Err("`" + name + "` has no body") }
    o.enqueue(g)
    var xs = Vec(Hm).new()
    for a in args {
        let v = operand(prog, b, &st, a, &o)?
        match v {
            Ptr(_) => return Err("a mutable borrow passed to `" + name + "`")
            _ => xs.push(term(v)?)
        }
    }
    let r = o.fresh_var()
    xs.push(r.clone())
    st.prem.push(ap(pred_name(prog, g).as_str(), xs))
    Ok(Val.Term(r))
}

fn contains(xs: [Hm], x: Hm) -> bool {
    for y in xs {
        if y == x { return true }
    }
    false
}

fn last_dot(s: str) -> Option(i64) {
    var i = s.len
    while i > 0 {
        i -= 1
        if s[i] == '.' { return Some(i) }
    }
    None
}
