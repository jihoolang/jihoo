// An untrusted prover for verification: Fourier-Motzkin elimination that
// remembers how each derived fact was made from the goal's facts, so a
// contradiction comes with the weights `linear.check` needs. Its bugs can
// only lose proofs.

import std.sort
import linear

type Lin = linear.Lin

struct Row {
    lin: Lin
    // The weight of each original fact; the last is the negated claim's.
    // Sparse, by increasing fact.
    weights: Vec((i64, i128))
}

const MAX_ROWS: i64 = 4096

fn gcd(a: i128, b: i128) -> i128 {
    var x = linear.abs(a)
    var y = linear.abs(b)
    while y != 0 {
        let t = x % y
        x = y
        y = t
    }
    x
}

// Divides a row by the common factor of all its numbers, which keeps the
// row equal to the weighted sum of its originals.
fn reduce(sink r: Row) -> Row {
    var g = gcd(r.lin.constant, 0)
    for t in r.lin.terms { g = gcd(g, t.1) }
    for w in r.weights { g = gcd(g, w.1) }
    if g <= 1 { return r }
    var terms = Vec((i64, i128)).with_capacity(r.lin.terms.len())
    for t in r.lin.terms { terms.push((t.0, t.1 / g)) }
    var weights = Vec((i64, i128)).with_capacity(r.weights.len())
    for w in r.weights { weights.push((w.0, w.1 / g)) }
    Row { lin: Lin { terms, constant: r.lin.constant / g }, weights }
}

// Products stay below 2^120; past that a row is dropped, which loses proofs
// but never makes one.
const LIMIT: i128 = 1 << 120

fn fits(x: i128, k: i128) -> bool { k == 0 || linear.abs(x) <= LIMIT / linear.abs(k) }

fn row_fits(r: Row, k: i128) -> bool {
    if !fits(r.lin.magnitude(), k) { return false }
    for w in r.weights {
        if !fits(w.1, k) { return false }
    }
    true
}

// p * a + q * b of two sparse weight lists.
fn mix(p: [(i64, i128)], a: i128, q: [(i64, i128)], b: i128) -> Vec((i64, i128)) {
    var out = Vec((i64, i128)).with_capacity(p.len + q.len)
    var i = 0
    var j = 0
    while i < p.len || j < q.len {
        if j == q.len || (i < p.len && p[i].0 < q[j].0) {
            out.push((p[i].0, p[i].1 * a))
            i += 1
        } else if i == p.len || q[j].0 < p[i].0 {
            out.push((q[j].0, q[j].1 * b))
            j += 1
        } else {
            out.push((p[i].0, p[i].1 * a + q[j].1 * b))
            i += 1
            j += 1
        }
    }
    out
}

fn combine(p: Row, a: i128, q: Row, b: i128) -> Option(Row) {
    if !row_fits(p, a) || !row_fits(q, b) { return None }
    let weights = mix(p.weights.as_slice(), a, q.weights.as_slice(), b)
    Some(reduce(Row { lin: p.lin.combine(a, q.lin, b), weights }))
}

// The position of `v` in the sorted `ids`.
fn position(ids: [i64], v: i64) -> i64 {
    var lo = 0
    var hi = ids.len
    while lo < hi {
        let mid = (lo + hi) / 2
        if ids[mid] < v { lo = mid + 1 } else { hi = mid }
    }
    lo
}

// The form over the variables' positions in `ids`.
fn renumber(x: Lin, ids: [i64]) -> Lin {
    var terms = Vec((i64, i128)).with_capacity(x.terms.len())
    for t in x.terms { terms.push((position(ids, t.0), t.1)) }
    Lin { terms, constant: x.constant }
}

// The facts that share a variable with the claim, directly or through other
// such facts. The others cannot help, so their weight stays zero.
fn relevant(facts: [Lin], claim: Lin, n: i64) -> Vec(bool) {
    var seen = Vec(bool).filled(n, false)
    for t in claim.terms { seen[t.0] = true }
    // A claim without variables (the path cannot be taken): start from the
    // latest facts, the conditions that led here.
    if claim.is_constant() {
        var k = facts.len
        while k > 0 && facts.len - k < 8 {
            k -= 1
            for t in facts[k].terms { seen[t.0] = true }
        }
    }
    var used = Vec(bool).filled(facts.len, false)
    var changed = true
    while changed {
        changed = false
        for i, f in facts {
            if !used[i] {
                var touches = f.is_constant() && f.constant < 0
                for t in f.terms {
                    if seen[t.0] { touches = true }
                }
                if touches {
                    used[i] = true
                    changed = true
                    for t in f.terms { seen[t.0] = true }
                }
            }
        }
    }
    used
}

// The variable whose elimination makes the fewest new rows, or -1 when no
// row has a variable left.
fn pick(rows: [Row], n: i64) -> i64 {
    var pos = Vec(i64).filled(n, 0)
    var neg = Vec(i64).filled(n, 0)
    for r in rows {
        for t in r.lin.terms {
            if t.1 > 0 { pos[t.0] += 1 } else { neg[t.0] += 1 }
        }
    }
    var best = -1
    var best_cost = 0
    for v in 0..n {
        if pos[v] + neg[v] > 0 {
            let cost = pos[v] * neg[v] - pos[v] - neg[v]
            if best < 0 || cost < best_cost {
                best = v
                best_cost = cost
            }
        }
    }
    best
}

fn certificate(r: Row, m: i64) -> linear.Certificate {
    var weights = Vec(i128).filled(m, 0)
    for w in r.weights { weights[w.0] = w.1 }
    linear.Certificate { weights }
}

pub fn prove(g: linear.Goal) -> Result(linear.Certificate, str) {
    let m = g.facts.len() + 1
    // The variables the goal names, sorted, so rows use small numbers.
    var ids = Vec(i64).new()
    for t in g.claim.terms { ids.push(t.0) }
    for f in g.facts {
        for t in f.terms { ids.push(t.0) }
    }
    sort_unique(&ids)
    let n = ids.len()
    var facts = Vec(Lin).with_capacity(g.facts.len())
    for f in g.facts { facts.push(renumber(f, ids.as_slice())) }
    let claim = renumber(g.claim, ids.as_slice())
    let used = relevant(facts.as_slice(), claim, n)
    var rows = Vec(Row).new()
    for i in 0..m {
        if i == g.facts.len() || used[i] {
            var weights = Vec((i64, i128)).new()
            weights.push((i, 1))
            let lin = if i < g.facts.len() { facts[i].clone() } else { claim.scale(-1).shift(-1) }
            rows.push(Row { lin, weights })
        }
    }
    loop {
        for r in rows {
            if r.lin.is_constant() && r.lin.constant < 0 { return Ok(certificate(r, m)) }
        }
        let v = pick(rows.as_slice(), n)
        if v < 0 { return Err("no linear proof") }
        var next = Vec(Row).new()
        for r in rows {
            // A row with no variables left and a non-negative constant says nothing.
            if r.lin.coef(v) == 0 && !r.lin.is_constant() {
                next.push(Row { lin: r.lin.clone(), weights: r.weights.clone() })
            }
        }
        for p in rows {
            let a = p.lin.coef(v)
            if a > 0 {
                for q in rows {
                    let b = q.lin.coef(v)
                    if b < 0 {
                        match combine(p, 0 - b, q, a) {
                            Some(r) => next.push(r)
                            None => {}
                        }
                        if next.len() > MAX_ROWS { return Err("too many derived facts") }
                    }
                }
            }
        }
        rows = next
    }
}

// Sorts and removes duplicates.
fn sort_unique(inout xs: Vec(i64)) {
    sort.sort(&xs)
    var out = Vec(i64).with_capacity(xs.len())
    for x in xs {
        if out.len() == 0 || out[out.len() - 1] != x { out.push(x) }
    }
    xs = out
}

#[test]
fn proves_a_bound() {
    // 0 <= x, x <= 3 imply x <= 5.
    var facts = Vec(Lin).new()
    facts.push(Lin.of(7))
    facts.push(Lin.of(7).scale(-1).shift(3))
    let g = linear.Goal { facts, claim: Lin.of(7).scale(-1).shift(5) }
    let c = prove(g).unwrap()
    assert(linear.check(g, c).is_ok(), "checked")
    let h = linear.Goal { facts: g.facts.clone(), claim: Lin.of(7).scale(-1).shift(2) }
    assert(prove(h).is_err(), "not provable")
}
