// Erase and lower the checked core itself to MIR. The executable fragment
// is pure: scalar exports, immutable local arrays, beta-reduced helpers,
// refinements as their U64, owned heap buffers (malloc and free, loads
// and stores at proved indices), proof-carrying indexing, I64 arithmetic and bounded loops. Array values and erased preconditions cannot
// cross the C ABI. No independent source/model translation is used.
import core
import diag
import lex
import mir
import target
import types
import std.mem

struct Value {
    op: mir.Operand
    ty: u32
}

struct Lower {
    body: mir.Body
    types: types.Types
    block: u32
    // The ids of the C library's malloc and free, declared after the
    // exports when a buffer is used.
    malloc: u32
    free: u32
    heap: bool
    // Recursive functions made for structural recursion on heap data,
    // declared after malloc and free; ids start at `free + 1`.
    generated: Vec(mir.Function)
    // Per boxed family, the generated function that frees a value of it.
    drops: Map(u32, u32)
}

impl Lower {
    fn local(inout self, ty: u32, kind: mir.LocalKind, sp: diag.Span) -> u32 {
        let id = self.body.locals.len() as u32
        self.body.locals.push(mir.LocalDecl { ty, name: None, span: sp, mutable: true, kind })
        id
    }

    fn block(inout self) -> u32 {
        let id = self.body.blocks.len() as u32
        self.body.blocks.push(mir.Block { stmts: Vec(mir.Stmt).new(), term: mir.Term.Pending })
        id
    }

    fn term(inout self, sink t: mir.Term) { self.body.blocks[self.block as i64].term = t }

    fn assign(inout self, local: u32, sink rv: mir.Rvalue, sp: diag.Span) {
        self.body.blocks[self.block as i64].stmts.push(mir.Stmt.Assign(
            mir.Place.local(local),
            rv,
            sp
        ))
    }

    fn value(inout self, ty: u32, sink rv: mir.Rvalue, sp: diag.Span) -> Value {
        let local = self.local(ty, mir.LocalKind.Temp, sp)
        self.assign(local, rv, sp)
        Value { op: mir.Operand.Copy(mir.Place.local(local)), ty }
    }

    fn expr(
        inout self,
        c: core.Core,
        id: u32,
        env: [Option(Value)],
        depth: u32
    ) -> Result(Value, diag.Diag) {
        if depth == 0 { return Err(c.error(id, "lowering nesting limit reached")) }
        let sp = c.nodes[id as i64].span
        match c.term(id) {
            Var(k) => {
                if k as i64 >= env.len { return Err(c.error(id, "unbound lowering variable")) }
                match env[env.len - 1 - k as i64] {
                    Some(v) => Ok(Value { op: v.op.clone(), ty: v.ty })
                    None => Err(c.error(id, "erased evidence reached runtime lowering"))
                }
            }
            Natural(n) => Ok(Value {
                op: mir.Operand.Const(mir.Const.Int(n as i128, types.U64)),
                ty: types.U64
            })
            Integer(n) => Ok(Value {
                op: mir.Operand.Const(mir.Const.Int(n as i128, types.I64)),
                ty: types.I64
            })
            Elements(xs) => {
                var ops = Vec(mir.Operand).new()
                for x in xs {
                    let v = self.expr(c, x, env, depth - 1)?
                    if v.ty != types.I64 { return Err(c.error(x, "array element layout mismatch")) }
                    ops.push(v.op.clone())
                }
                let ty = self.types.intern(types.TyKind.Array(types.I64, xs.len() as u64))
                Ok(self.value(ty, mir.Rvalue.Aggregate(mir.Agg.Array(ty), ops), sp))
            }
            Index(array, index, _) => {
                // The checker required exactly Lt index (array's length).
                // Evidence is deliberately not visited or materialized.
                let a = self.expr(c, array, env, depth - 1)?
                let i = self.expr(c, index, env, depth - 1)?
                let types.TyKind.Array(_, _) = self.types.kind(a.ty) else {
                    return Err(c.error(array, "array layout mismatch"))
                }
                let mir.Operand.Copy(place) = a.op else { return Err(c.error(
                    array,
                    "array needs backing storage"
                )) }
                let at = self.local(types.U64, mir.LocalKind.Temp, sp)
                self.assign(at, mir.Rvalue.Use(i.op.clone()), sp)
                Ok(self.value(types.I64,
                    mir.Rvalue.Use(mir.Operand.Copy(place.with(mir.Proj.Index(at)))), sp))
            }
            IfLt(a, b, yes, no) | IfEq(a, b, yes, no) => {
                let op = match c.term(id) { IfEq(_, _, _, _) => lex.Op.Eq, _ => lex.Op.Lt }
                let a = self.expr(c, a, env, depth - 1)?
                let b = self.expr(c, b, env, depth - 1)?
                let condition = self.value(
                    types.BOOL,
                    mir.Rvalue.Bin(op, a.op.clone(), b.op.clone()),
                    sp
                )
                let yes_block = self.block()
                let no_block = self.block()
                let join = self.block()
                var cases = Vec(mir.SwitchTarget).new()
                cases.push(mir.SwitchTarget { value: 0, block: no_block })
                self.term(mir.Term.Switch(condition.op.clone(), cases, yes_block))
                self.block = yes_block
                var inner = Vec(Option(Value)).new()
                for x in env {
                    inner.push(match x { Some(v) => Some(Value { op: v.op.clone(), ty: v.ty }), None => None })
                }
                inner.push(None)
                let y = self.expr(c, yes, inner.as_slice(), depth - 1)?
                let result = self.local(y.ty, mir.LocalKind.Temp, sp)
                self.assign(result, mir.Rvalue.Use(y.op.clone()), sp)
                self.term(mir.Term.Goto(join))
                self.block = no_block
                let n = self.expr(c, no, env, depth - 1)?
                if n.ty != y.ty { return Err(c.error(id, "branch layout mismatch")) }
                self.assign(result, mir.Rvalue.Use(n.op.clone()), sp)
                self.term(mir.Term.Goto(join))
                self.block = join
                Ok(Value { op: mir.Operand.Copy(mir.Place.local(result)), ty: y.ty })
            }
            // A heap node: its tag, then its runtime fields.
            Con(f, k, fields) if c.is_boxed(f) => {
                let erased = layout(c, f, k)?
                var values = Vec(Value).new()
                for j, x in fields {
                    if erased[j] { continue }
                    values.push(self.expr(c, x, env, depth - 1)?)
                }
                let at = self.allocate(values.len() as u64 + 1, sp)
                self.put(
                    at,
                    0,
                    mir.Operand.Const(mir.Const.Int(k as i128, types.I64)),
                    types.I64,
                    sp
                )
                for j, v in values { self.put(at, j as u64 + 1, v.op.clone(), v.ty, sp) }
                Ok(Value { op: mir.Operand.Copy(mir.Place.local(at)), ty: self.pointer() })
            }
            Case(f, _, cases, x) => {
                let x = self.expr(c, x, env, depth - 1)?
                self.dispatch(c, id, f, cases.as_slice(), x, env, None, depth)
            }
            Elim(f, _, cases, x) if c.is_boxed(f) => {
                let x = self.expr(c, x, env, depth - 1)?
                self.recursion(c, id, f, cases.as_slice(), x, env, depth)
            }
            // A redex the normalizer kept binds an argument that touches
            // memory: evaluated once, then the body.
            App(f, a) => {
                let core.Term.Lam(false, _, body) = c.term(f) else {
                    return Err(c.error(
                        id,
                        "term has no runtime representation in this core fragment"
                    ))
                }
                let v = self.expr(c, a, env, depth - 1)?
                var inner = copy_env(env)
                inner.push(Some(v))
                self.expr(c, body, inner.as_slice(), depth - 1)
            }
            Alloc(n, x) => {
                let n = self.expr(c, n, env, depth - 1)?
                let x = self.expr(c, x, env, depth - 1)?
                // n * 8 bytes, checked, and one more element so that an empty
                // buffer is still a distinct allocation.
                let bytes = self.value(types.U64, mir.Rvalue.Bin(lex.Op.Mul, n.op.clone(),
                    mir.Operand.Const(mir.Const.Int(8, types.U64))), sp)
                let bytes = self.value(types.U64, mir.Rvalue.Bin(lex.Op.Add, bytes.op.clone(),
                    mir.Operand.Const(mir.Const.Int(8, types.U64))), sp)
                let ptr = self.pointer()
                let at = self.local(ptr, mir.LocalKind.Temp, sp)
                let next = self.block()
                var args = Vec(mir.Operand).new()
                args.push(bytes.op.clone())
                self.heap = true
                self.term(mir.Term.Call(
                    mir.Callee.Fn(self.malloc),
                    args,
                    mir.Place.local(at),
                    next,
                    sp
                ))
                self.block = next
                // Allocation failure stops the program, like a trap.
                let address = self.value(types.U64, mir.Rvalue.Cast(
                    mir.Operand.Copy(mir.Place.local(at)),
                    types.U64,
                    mir.CastKind.Numeric
                ), sp)
                let ok = self.value(types.BOOL, mir.Rvalue.Bin(lex.Op.Ne, address.op.clone(),
                    mir.Operand.Const(mir.Const.Int(0, types.U64))), sp)
                let filled = self.block()
                self.term(mir.Term.Assert(
                    ok.op.clone(),
                    "allocation failed".to_string(),
                    filled,
                    sp
                ))
                self.block = filled
                // Every element starts as x.
                let i = self.local(types.U64, mir.LocalKind.Temp, sp)
                self.assign(i, mir.Rvalue.Use(mir.Operand.Const(mir.Const.Int(0, types.U64))), sp)
                let head = self.block()
                let step = self.block()
                let exit = self.block()
                self.term(mir.Term.Goto(head))
                self.block = head
                let more = self.value(types.BOOL, mir.Rvalue.Bin(lex.Op.Lt,
                    mir.Operand.Copy(mir.Place.local(i)), n.op.clone()), sp)
                var cases = Vec(mir.SwitchTarget).new()
                cases.push(mir.SwitchTarget { value: 0, block: exit })
                self.term(mir.Term.Switch(more.op.clone(), cases, step))
                self.block = step
                let slot = self.slot(at, mir.Operand.Copy(mir.Place.local(i)), sp)
                self.store(slot, x.op.clone(), sp)
                self.assign(i, mir.Rvalue.Bin(lex.Op.Add, mir.Operand.Copy(mir.Place.local(i)),
                    mir.Operand.Const(mir.Const.Int(1, types.U64))), sp)
                self.term(mir.Term.Goto(head))
                self.block = exit
                Ok(Value { op: mir.Operand.Copy(mir.Place.local(at)), ty: ptr })
            }
            Load(b, i, _, k) => {
                // The checker required Lt(i, n) for this buffer of length n.
                let b = self.expr(c, b, env, depth - 1)?
                let i = self.expr(c, i, env, depth - 1)?
                let at = self.local(b.ty, mir.LocalKind.Temp, sp)
                self.assign(at, mir.Rvalue.Use(b.op.clone()), sp)
                let slot = self.slot(at, i.op.clone(), sp)
                let x = self.value(types.I64, mir.Rvalue.Use(mir.Operand.Copy(
                    mir.Place.local(slot).with(mir.Proj.Deref)
                )), sp)
                let core.Term.Lam(false, _, inner) = c.term(k) else {
                    return Err(c.error(k, "load needs fn(x, b) { ... }"))
                }
                let core.Term.Lam(false, _, body) = c.term(inner) else {
                    return Err(c.error(k, "load needs fn(x, b) { ... }"))
                }
                var scope = copy_env(env)
                scope.push(Some(x))
                scope.push(Some(Value { op: mir.Operand.Copy(mir.Place.local(at)), ty: b.ty }))
                self.expr(c, body, scope.as_slice(), depth - 1)
            }
            Store(b, i, v, _) => {
                let b = self.expr(c, b, env, depth - 1)?
                let i = self.expr(c, i, env, depth - 1)?
                let v = self.expr(c, v, env, depth - 1)?
                let at = self.local(b.ty, mir.LocalKind.Temp, sp)
                self.assign(at, mir.Rvalue.Use(b.op.clone()), sp)
                let slot = self.slot(at, i.op.clone(), sp)
                self.store(slot, v.op.clone(), sp)
                Ok(Value { op: mir.Operand.Copy(mir.Place.local(at)), ty: b.ty })
            }
            Drop(f, x, rest) => {
                let x = self.expr(c, x, env, depth - 1)?
                let function = self.drop_glue(c, f, sp)?
                let unit = self.local(types.UNIT, mir.LocalKind.Temp, sp)
                let next = self.block()
                var args = Vec(mir.Operand).new()
                args.push(x.op.clone())
                self.term(mir.Term.Call(
                    mir.Callee.Fn(function),
                    args,
                    mir.Place.local(unit),
                    next,
                    sp
                ))
                self.block = next
                self.expr(c, rest, env, depth - 1)
            }
            Free(b, rest) => {
                let b = self.expr(c, b, env, depth - 1)?
                let unit = self.local(types.UNIT, mir.LocalKind.Temp, sp)
                let next = self.block()
                var args = Vec(mir.Operand).new()
                args.push(b.op.clone())
                self.heap = true
                self.term(mir.Term.Call(
                    mir.Callee.Fn(self.free),
                    args,
                    mir.Place.local(unit),
                    next,
                    sp
                ))
                self.block = next
                self.expr(c, rest, env, depth - 1)
            }
            // A refinement is its U64; its evidence is erased.
            Pack(_, a, _) | Witness(a) => {
                let v = self.expr(c, a, env, depth - 1)?
                if v.ty != types.U64 { return Err(c.error(id, "refinement layout mismatch")) }
                Ok(v)
            }
            Strict(a, b) => {
                // Evaluated for its traps only, before the rest.
                self.effect(c, a, env, depth - 1)?
                self.expr(c, b, env, depth - 1)
            }
            USub(a, b, _) => {
                // The evidence b <= a is erased; the subtraction cannot fail.
                let a = self.expr(c, a, env, depth - 1)?
                let b = self.expr(c, b, env, depth - 1)?
                Ok(self.value(
                    types.U64,
                    mir.Rvalue.Bin(lex.Op.Sub, a.op.clone(), b.op.clone()),
                    sp
                ))
            }
            UAdd(a, b) => {
                let a = self.expr(c, a, env, depth - 1)?
                let b = self.expr(c, b, env, depth - 1)?
                // Checked: overflow traps, so the value is the natural sum.
                Ok(self.value(
                    types.U64,
                    mir.Rvalue.Bin(lex.Op.Add, a.op.clone(), b.op.clone()),
                    sp
                ))
            }
            Arith(op, a, b) => {
                let a = self.expr(c, a, env, depth - 1)?
                let b = self.expr(c, b, env, depth - 1)?
                let op = match op { Add => lex.Op.Add, Sub => lex.Op.Sub, Mul => lex.Op.Mul }
                // The program is `checked`: overflow traps, as in the kernel.
                Ok(self.value(types.I64, mir.Rvalue.Bin(op, a.op.clone(), b.op.clone()), sp))
            }
            Fold(n, init, body) => {
                let n = self.expr(c, n, env, depth - 1)?
                let init = self.expr(c, init, env, depth - 1)?
                let core.Term.Lam(false, _, body) = c.term(body) else { return Err(c.error(
                    id,
                    "loop body needs an index binder"
                )) }
                let core.Term.Lam(true, _, body) = c.term(body) else { return Err(c.error(
                    id,
                    "loop body needs an erased bound"
                )) }
                let core.Term.Lam(false, _, body) = c.term(body) else { return Err(c.error(
                    id,
                    "loop body needs an accumulator"
                )) }
                let i = self.local(types.U64, mir.LocalKind.Temp, sp)
                // An i64 or a buffer's pointer.
                let acc_ty = init.ty
                let acc = self.local(acc_ty, mir.LocalKind.Temp, sp)
                self.assign(i, mir.Rvalue.Use(mir.Operand.Const(mir.Const.Int(0, types.U64))), sp)
                self.assign(acc, mir.Rvalue.Use(init.op.clone()), sp)
                let head = self.block()
                let step = self.block()
                let exit = self.block()
                self.term(mir.Term.Goto(head))
                self.block = head
                let condition = self.value(types.BOOL, mir.Rvalue.Bin(lex.Op.Lt,
                    mir.Operand.Copy(mir.Place.local(i)), n.op.clone()), sp)
                var cases = Vec(mir.SwitchTarget).new()
                cases.push(mir.SwitchTarget { value: 0, block: exit })
                self.term(mir.Term.Switch(condition.op.clone(), cases, step))
                self.block = step
                // The body sees the index, no evidence and the accumulator.
                var inner = Vec(Option(Value)).new()
                for x in env {
                    inner.push(match x { Some(v) => Some(Value { op: v.op.clone(), ty: v.ty }), None => None })
                }
                inner.push(Some(Value { op: mir.Operand.Copy(mir.Place.local(i)), ty: types.U64 }))
                inner.push(None)
                inner.push(Some(Value {
                    op: mir.Operand.Copy(mir.Place.local(acc)),
                    ty: acc_ty
                }))
                let v = self.expr(c, body, inner.as_slice(), depth - 1)?
                if v.ty != acc_ty { return Err(c.error(id, "loop layout mismatch")) }
                self.assign(acc, mir.Rvalue.Use(v.op.clone()), sp)
                // i < n, so the increment cannot overflow.
                self.assign(i, mir.Rvalue.Bin(lex.Op.Add, mir.Operand.Copy(mir.Place.local(i)),
                    mir.Operand.Const(mir.Const.Int(1, types.U64))), sp)
                self.term(mir.Term.Goto(head))
                self.block = exit
                Ok(Value { op: mir.Operand.Copy(mir.Place.local(acc)), ty: acc_ty })
            }
            _ => Err(c.error(id, "term has no runtime representation in this core fragment"))
        }
    }
}

impl Lower {
    // The runtime type of a buffer: a pointer to its first I64.
    fn pointer(inout self) -> u32 { self.types.intern(types.TyKind.Ptr(types.I64)) }

    // A pointer to element i of the buffer whose pointer is in local `at`.
    fn slot(inout self, at: u32, sink i: mir.Operand, sp: diag.Span) -> u32 {
        let ty = self.pointer()
        let slot = self.local(ty, mir.LocalKind.Temp, sp)
        self.assign(slot, mir.Rvalue.Offset(mir.Operand.Copy(mir.Place.local(at)), i), sp)
        slot
    }

    // malloc(8 * slots), stopping the program when it returns null.
    fn allocate(inout self, slots: u64, sp: diag.Span) -> u32 {
        let ptr = self.pointer()
        let at = self.local(ptr, mir.LocalKind.Temp, sp)
        let next = self.block()
        var args = Vec(mir.Operand).new()
        args.push(mir.Operand.Const(mir.Const.Int((slots * 8) as i128, types.U64)))
        self.heap = true
        self.term(mir.Term.Call(mir.Callee.Fn(self.malloc), args, mir.Place.local(at), next, sp))
        self.block = next
        let address = self.value(types.U64, mir.Rvalue.Cast(
            mir.Operand.Copy(mir.Place.local(at)),
            types.U64,
            mir.CastKind.Numeric
        ), sp)
        let ok = self.value(types.BOOL, mir.Rvalue.Bin(lex.Op.Ne, address.op.clone(),
            mir.Operand.Const(mir.Const.Int(0, types.U64))), sp)
        let after = self.block()
        self.term(mir.Term.Assert(ok.op.clone(), "allocation failed".to_string(), after, sp))
        self.block = after
        at
    }

    fn release(inout self, at: u32, sp: diag.Span) {
        let unit = self.local(types.UNIT, mir.LocalKind.Temp, sp)
        let next = self.block()
        var args = Vec(mir.Operand).new()
        args.push(mir.Operand.Copy(mir.Place.local(at)))
        self.heap = true
        self.term(mir.Term.Call(mir.Callee.Fn(self.free), args, mir.Place.local(unit), next, sp))
        self.block = next
    }

    // Slot i of the node in local `at`, which holds an i64, a u64 or a pointer.
    fn put(inout self, at: u32, i: u64, sink v: mir.Operand, ty: u32, sp: diag.Span) {
        let value = if ty == types.I64 { v }
        else { self.value(types.I64, mir.Rvalue.Cast(v, types.I64, mir.CastKind.Numeric), sp).op }
        let slot = self.slot(at, mir.Operand.Const(mir.Const.Int(i as i128, types.U64)), sp)
        self.store(slot, value, sp)
    }

    fn get(inout self, at: u32, i: u64, ty: u32, sp: diag.Span) -> Value {
        let slot = self.slot(at, mir.Operand.Const(mir.Const.Int(i as i128, types.U64)), sp)
        let raw = self.value(types.I64, mir.Rvalue.Use(mir.Operand.Copy(
            mir.Place.local(slot).with(mir.Proj.Deref)
        )), sp)
        if ty == types.I64 { return raw }
        self.value(ty, mir.Rvalue.Cast(raw.op.clone(), ty, mir.CastKind.Numeric), sp)
    }

    // The runtime type of a value of a core type, if it has one.
    fn runtime(inout self, c: core.Core, ty: u32) -> Option(u32) {
        match c.term(ty) {
            U64 | Refine(_) => Some(types.U64)
            I64 => Some(types.I64)
            Buffer(_) => Some(self.pointer())
            Ind(f, _) if c.is_boxed(f) => Some(self.pointer())
            _ => None
        }
    }

    // Take the node x apart: switch on its tag, load each case's fields,
    // free the node and run the case. With `recursion`, the function made
    // for the recursion and its extra arguments: each recursive field is
    // first given to it, and the case receives the results.
    fn dispatch(
        inout self,
        c: core.Core,
        id: u32,
        f: u32,
        cases: [u32],
        x: Value,
        env: [Option(Value)],
        recursion: Option((u32, Vec(mir.Operand), u32)),
        depth: u32
    ) -> Result(Value, diag.Diag) {
        if depth == 0 { return Err(c.error(id, "lowering nesting limit reached")) }
        let sp = c.nodes[id as i64].span
        let at = self.local(x.ty, mir.LocalKind.Temp, sp)
        self.assign(at, mir.Rvalue.Use(x.op.clone()), sp)
        let tag = self.get(at, 0, types.I64, sp)
        var blocks = Vec(u32).new()
        for _ in cases { blocks.push(self.block()) }
        let join = self.block()
        var targets = Vec(mir.SwitchTarget).new()
        for k in 0..blocks.len() - 1 { targets.push(mir.SwitchTarget {
            value: k as i128,
            block: blocks[k]
        }) }
        self.term(mir.Term.Switch(tag.op.clone(), targets, blocks[blocks.len() - 1]))
        var result: Option(Value) = None
        for k, case in cases {
            self.block = blocks[k]
            let erased = layout(c, f, k as u32)?
            let params = c.families[f as i64].params as i64
            var scope = copy_env(env)
            var body = case
            var slot: u64 = 1
            var results = Vec(Value).new()
            var bound = Vec(Option(Value)).new()
            for j in params..erased.len() {
                let core.Term.Lam(_, domain, rest) = c.term(body) else {
                    return Err(c.error(case, "a case needs one binder per field"))
                }
                if erased[j] { bound.push(None) }
                else {
                    let Some(ty) = self.runtime(c, domain) else {
                        return Err(c.error(domain, "field has no runtime representation"))
                    }
                    let v = self.get(at, slot, ty, sp)
                    slot += 1
                    // A recursion consumes the recursive field: the case
                    // sees it only in types, and receives its result.
                    let own = match c.term(domain) { Ind(g, _) => g == f, _ => false }
                    match recursion {
                        Some((function, extra, ret)) if own => {
                            let r = self.local(ret, mir.LocalKind.Temp, sp)
                            var args = Vec(mir.Operand).new()
                            args.push(v.op.clone())
                            for e in extra { args.push(e.clone()) }
                            let next = self.block()
                            self.term(mir.Term.Call(
                                mir.Callee.Fn(function),
                                args,
                                mir.Place.local(r),
                                next,
                                sp
                            ))
                            self.block = next
                            results.push(Value {
                                op: mir.Operand.Copy(mir.Place.local(r)),
                                ty: ret
                            })
                            bound.push(None)
                        }
                        _ => bound.push(Some(v))
                    }
                }
                body = rest
            }
            // Every field is loaded: the node is freed before the case runs.
            self.release(at, sp)
            for b in bound {
                scope.push(
                    match b { Some(v) => Some(Value { op: v.op.clone(), ty: v.ty }), None => None }
                )
            }
            for r in results {
                let core.Term.Lam(_, _, rest) = c.term(body) else {
                    return Err(c.error(case, "a case needs one binder per result"))
                }
                scope.push(Some(Value { op: r.op.clone(), ty: r.ty }))
                body = rest
            }
            let v = self.expr(c, body, scope.as_slice(), depth - 1)?
            let out = match result {
                Some(r) => {
                    if r.ty != v.ty { return Err(c.error(id, "case layout mismatch")) }
                    Value { op: r.op.clone(), ty: r.ty }
                }
                None => {
                    let local = self.local(v.ty, mir.LocalKind.Temp, sp)
                    Value { op: mir.Operand.Copy(mir.Place.local(local)), ty: v.ty }
                }
            }
            let mir.Operand.Copy(place) = out.op.clone() else { return Err(c.error(
                id,
                "unreachable"
            )) }
            self.body.blocks[self.block as i64].stmts.push(mir.Stmt.Assign(
                place,
                mir.Rvalue.Use(v.op.clone()),
                sp
            ))
            self.term(mir.Term.Goto(join))
            result = Some(out)
        }
        self.block = join
        let Some(r) = result else { return Err(c.error(id, "a data type without constructors")) }
        Ok(Value { op: r.op.clone(), ty: r.ty })
    }

    // Structural recursion on heap data: a recursive function of the node
    // and of the outer runtime values the cases may read.
    fn recursion(
        inout self,
        c: core.Core,
        id: u32,
        f: u32,
        cases: [u32],
        x: Value,
        env: [Option(Value)],
        depth: u32
    ) -> Result(Value, diag.Diag) {
        let sp = c.nodes[id as i64].span
        // The result's type: a case's first hypothesis.
        var ret: Option(u32) = None
        for k, case in cases {
            let erased = layout(c, f, k as u32)?
            let params = c.families[f as i64].params as i64
            var body = case
            for _ in params..erased.len() {
                let core.Term.Lam(_, _, rest) = c.term(body) else { break }
                body = rest
            }
            var own = false
            for j in 0..erased.len() { if !erased[j] && recursive_field(c, f, k as u32, j) { own = true } }
            if !own { continue }
            let core.Term.Lam(_, domain, _) = c.term(body) else { continue }
            ret = self.runtime(c, domain)
            break
        }
        let Some(ret) = ret else {
            // No recursive field: one level of case analysis.
            return self.dispatch(c, id, f, cases, x, env, None, depth)
        }
        // Reserve the function's id, then build its body in place of ours.
        let function = self.free + 1 + self.generated.len() as u32
        self.generated.push(mir.Function {
            name: "recursion".to_string(), symbol: "recursion".to_string()
            sig: types.Sig { c_abi: false, variadic: false, params: Vec(u32).new(), ret }
            pass: Vec(mir.ParamPass).new(), body: None, linkage: mir.Linkage.Internal,
            variadic: false, returns_ref: false, span: sp
        })
        let outer = mem.replace(&self.body, mir.Body { locals: Vec(mir.LocalDecl).new(),
            blocks: Vec(mir.Block).new(), arg_count: 0, contract: mir.Contract.new() })
        let outer_block = self.block
        self.local(ret, mir.LocalKind.Ret, sp)
        self.block = self.block()
        var params = Vec(u32).new()
        let node = self.local(x.ty, mir.LocalKind.Arg, sp)
        params.push(x.ty)
        var inner = Vec(Option(Value)).new()
        var extra = Vec(mir.Operand).new()
        var outside = Vec(mir.Operand).new()
        for e in env {
            match e {
                Some(v) => {
                    let local = self.local(v.ty, mir.LocalKind.Arg, sp)
                    params.push(v.ty)
                    inner.push(Some(Value {
                        op: mir.Operand.Copy(mir.Place.local(local)),
                        ty: v.ty
                    }))
                    extra.push(mir.Operand.Copy(mir.Place.local(local)))
                    outside.push(v.op.clone())
                }
                None => inner.push(None)
            }
        }
        self.body.arg_count = params.len()
        let argument = Value { op: mir.Operand.Copy(mir.Place.local(node)), ty: x.ty }
        let v = self.dispatch(
            c,
            id,
            f,
            cases,
            argument,
            inner.as_slice(),
            Some((function, extra, ret)),
            depth
        )?
        if v.ty != ret { return Err(c.error(id, "recursion layout mismatch")) }
        self.assign(0, mir.Rvalue.Use(v.op.clone()), sp)
        self.term(mir.Term.Return)
        let body = mem.replace(&self.body, outer)
        self.block = outer_block
        var pass = Vec(mir.ParamPass).new()
        for _ in params { pass.push(mir.ParamPass.Value) }
        let index = (function - self.free - 1) as i64
        self.generated[index].sig = types.Sig { c_abi: false, variadic: false, params, ret }
        self.generated[index].pass = pass
        self.generated[index].body = Some(body)
        self.generated[index].name = ("recursion." + function.to_string().as_str()).to_string()
        self.generated[index].symbol = (
            "__jihoo_core_recursion_" + function.to_string().as_str()
        ).to_string()
        // The call: the node and the outer values.
        let r = self.local(ret, mir.LocalKind.Temp, sp)
        var args = Vec(mir.Operand).new()
        args.push(x.op.clone())
        for o in outside { args.push(o.clone()) }
        let next = self.block()
        self.term(mir.Term.Call(mir.Callee.Fn(function), args, mir.Place.local(r), next, sp))
        self.block = next
        Ok(Value { op: mir.Operand.Copy(mir.Place.local(r)), ty: ret })
    }

    // The function that frees a value of boxed family f: it switches on the
    // tag, loads the fields on the heap, frees the node and then frees
    // each of them. Made once per family; its depth is the data's.
    fn drop_glue(inout self, c: core.Core, f: u32, sp: diag.Span) -> Result(u32, diag.Diag) {
        match self.drops.get(f) { Some(function) => return Ok(function), None => {} }
        let function = self.free + 1 + self.generated.len() as u32
        self.drops.insert(f, function)
        let name = c.families[f as i64].name.clone()
        self.generated.push(mir.Function {
            name: ("drop." + name.as_str()).to_string(),
            symbol: ("__jihoo_core_drop_" + function.to_string().as_str()).to_string()
            sig: types.Sig {
                c_abi: false,
                variadic: false,
                params: Vec(u32).new(),
                ret: types.UNIT
            }
            pass: Vec(mir.ParamPass).new(), body: None, linkage: mir.Linkage.Internal,
            variadic: false, returns_ref: false, span: sp
        })
        let outer = mem.replace(&self.body, mir.Body { locals: Vec(mir.LocalDecl).new(),
            blocks: Vec(mir.Block).new(), arg_count: 0, contract: mir.Contract.new() })
        let outer_block = self.block
        self.local(types.UNIT, mir.LocalKind.Ret, sp)
        self.block = self.block()
        let ptr = self.pointer()
        let node = self.local(ptr, mir.LocalKind.Arg, sp)
        self.body.arg_count = 1
        let count = c.families[f as i64].constructors.len()
        let join = self.block()
        if count > 0 {
            let tag = self.get(node, 0, types.I64, sp)
            var blocks = Vec(u32).new()
            for _ in 0..count { blocks.push(self.block()) }
            var targets = Vec(mir.SwitchTarget).new()
            for k in 0..count - 1 { targets.push(mir.SwitchTarget {
                value: k as i128,
                block: blocks[k]
            }) }
            self.term(mir.Term.Switch(tag.op.clone(), targets, blocks[count - 1]))
            for k in 0..count {
                self.block = blocks[k]
                var owned = Vec((u32, Value)).new()
                var slot: u64 = 1
                var ty = c.families[f as i64].constructors[k].ty
                var j = 0
                loop {
                    let core.Term.Pi(erased, domain, rest) = c.term(ty) else { break }
                    if j >= c.families[f as i64].params as i64 && !erased {
                        match c.term(domain) {
                            Ind(g, _) if c.is_boxed(g) => {
                                let v = self.get(node, slot, ptr, sp)
                                owned.push((g, v))
                            }
                            _ => {}
                        }
                        slot += 1
                    }
                    j += 1
                    ty = rest
                }
                self.release(node, sp)
                for (g, v) in owned {
                    let inner = self.drop_glue(c, g, sp)?
                    let unit = self.local(types.UNIT, mir.LocalKind.Temp, sp)
                    let next = self.block()
                    var args = Vec(mir.Operand).new()
                    args.push(v.op.clone())
                    self.term(mir.Term.Call(
                        mir.Callee.Fn(inner),
                        args,
                        mir.Place.local(unit),
                        next,
                        sp
                    ))
                    self.block = next
                }
                self.term(mir.Term.Goto(join))
            }
        } else { self.term(mir.Term.Goto(join)) }
        self.block = join
        self.term(mir.Term.Return)
        let body = mem.replace(&self.body, outer)
        self.block = outer_block
        let index = (function - self.free - 1) as i64
        var params = Vec(u32).new()
        params.push(ptr)
        var pass = Vec(mir.ParamPass).new()
        pass.push(mir.ParamPass.Value)
        self.generated[index].sig = types.Sig {
            c_abi: false,
            variadic: false,
            params,
            ret: types.UNIT
        }
        self.generated[index].pass = pass
        self.generated[index].body = Some(body)
        Ok(function)
    }

    fn store(inout self, slot: u32, sink v: mir.Operand, sp: diag.Span) {
        self.body.blocks[self.block as i64].stmts.push(mir.Stmt.Assign(
            mir.Place.local(slot).with(mir.Proj.Deref),
            mir.Rvalue.Use(v),
            sp
        ))
    }

    // Evaluate a term only for its traps. A data value has no runtime
    // representation: normalization removes every case analysis of one,
    // and what remains is evaluated field by field. Erased fields are not.
    fn effect(
        inout self,
        c: core.Core,
        id: u32,
        env: [Option(Value)],
        depth: u32
    ) -> Result((), diag.Diag) {
        if depth == 0 { return Err(c.error(id, "lowering nesting limit reached")) }
        let sp = c.nodes[id as i64].span
        match c.term(id) {
            Con(f, k, fields) => {
                var ty = c.families[f as i64].constructors[k as i64].ty
                for x in fields {
                    let core.Term.Pi(erased, _, rest) = c.term(ty) else {
                        return Err(c.error(id, "constructor layout mismatch"))
                    }
                    if !erased { self.effect(c, x, env, depth - 1)? }
                    ty = rest
                }
                Ok(())
            }
            Pack(_, a, _) => self.effect(c, a, env, depth - 1)
            Strict(a, b) => {
                self.effect(c, a, env, depth - 1)?
                self.effect(c, b, env, depth - 1)
            }
            IfLt(a, b, yes, no) | IfEq(a, b, yes, no) => {
                let op = match c.term(id) { IfEq(_, _, _, _) => lex.Op.Eq, _ => lex.Op.Lt }
                let a = self.expr(c, a, env, depth - 1)?
                let b = self.expr(c, b, env, depth - 1)?
                let condition = self.value(
                    types.BOOL,
                    mir.Rvalue.Bin(op, a.op.clone(), b.op.clone()),
                    sp
                )
                let yes_block = self.block()
                let no_block = self.block()
                let join = self.block()
                var cases = Vec(mir.SwitchTarget).new()
                cases.push(mir.SwitchTarget { value: 0, block: no_block })
                self.term(mir.Term.Switch(condition.op.clone(), cases, yes_block))
                self.block = yes_block
                var inner = Vec(Option(Value)).new()
                for x in env {
                    inner.push(match x { Some(v) => Some(Value { op: v.op.clone(), ty: v.ty }), None => None })
                }
                inner.push(None)
                self.effect(c, yes, inner.as_slice(), depth - 1)?
                self.term(mir.Term.Goto(join))
                self.block = no_block
                self.effect(c, no, env, depth - 1)?
                self.term(mir.Term.Goto(join))
                self.block = join
                Ok(())
            }
            _ => {
                self.expr(c, id, env, depth - 1)?
                Ok(())
            }
        }
    }
}

// Per field of constructor k, parameters included: whether it is erased
// (no slot in the node).
fn layout(c: core.Core, f: u32, k: u32) -> Result(Vec(bool), diag.Diag) {
    var out = Vec(bool).new()
    var ty = c.families[f as i64].constructors[k as i64].ty
    loop {
        let core.Term.Pi(erased, _, rest) = c.term(ty) else { break }
        out.push(erased)
        ty = rest
    }
    Ok(out)
}

// Whether field j of constructor k is recursive.
fn recursive_field(c: core.Core, f: u32, k: u32, j: i64) -> bool {
    var ty = c.families[f as i64].constructors[k as i64].ty
    var i = 0
    loop {
        let core.Term.Pi(_, domain, rest) = c.term(ty) else { return false }
        if i == j { return match c.term(domain) { Ind(g, _) => g == f, _ => false } }
        i += 1
        ty = rest
    }
}

fn copy_env(env: [Option(Value)]) -> Vec(Option(Value)) {
    var out = Vec(Option(Value)).new()
    for x in env {
        out.push(match x { Some(v) => Some(Value { op: v.op.clone(), ty: v.ty }), None => None })
    }
    out
}

fn scalar(c: core.Core, id: u32) -> Result(u32, diag.Diag) {
    match c.term(id) {
        U64 => Ok(types.U64)
        I64 => Ok(types.I64)
        _ => Err(c.error(id, "exports require scalar arguments and results"))
    }
}

// A result may also be a refinement: the export guarantees its evidence,
// and the caller receives the U64. Arguments cannot be refinements, since
// a foreign caller cannot supply evidence.
fn result(c: core.Core, id: u32) -> Result(u32, diag.Diag) {
    match c.term(id) {
        Refine(_) => Ok(types.U64)
        _ => scalar(c, id)
    }
}

pub fn compile(sink c: core.Core, tgt: target.Target) -> Result(mir.Program, diag.Diag) {
    var c = c
    // This entry point always checks, even if called without the parser.
    c.check()?
    var out = Vec(mir.Function).new()
    var runtime_types = types.Types.new()
    let count = c.definitions.len()
    // malloc and free follow the exports, declared only when used.
    var exports: u32 = 0
    for d in c.definitions { if d.exported { exports += 1 } }
    var heap = false
    var generated = Vec(mir.Function).new()
    var drops = Map(u32, u32).new()
    for i in 0..count {
        if !c.definitions[i].exported { continue }
        let sp = c.definitions[i].span
        let mut_ty = c.definitions[i].ty
        let mut_body = c.definitions[i].value
        var ty = c.normal(mut_ty, core.DEPTH)?
        // The body runs: arguments that touch memory are evaluated once.
        c.runtime = true
        var body = c.normal(mut_body, core.DEPTH)?
        c.runtime = false
        var lower = Lower {
            body: mir.Body { locals: Vec(mir.LocalDecl).new(), blocks: Vec(mir.Block).new(),
                arg_count: 0, contract: mir.Contract.new() }
            types: runtime_types
            block: 0
            malloc: exports
            free: exports + 1
            heap: false
            generated: mem.take(&generated)
            drops: mem.take(&drops)
        }
        lower.local(types.UNIT, mir.LocalKind.Ret, sp)
        lower.block()
        var params = Vec(u32).new()
        var pass = Vec(mir.ParamPass).new()
        var env = Vec(Option(Value)).new()
        loop {
            let core.Term.Pi(erased, domain, result) = c.term(ty) else { break }
            if erased { return Err(c.error(
                ty,
                "exports cannot require erased evidence from foreign callers"
            )) }
            let core.Term.Lam(false, _, rest) = c.term(body) else { return Err(c.error(
                body,
                "export needs a lambda"
            )) }
            let t = scalar(c, domain)?
            let local = lower.local(t, mir.LocalKind.Arg, sp)
            params.push(t)
            pass.push(mir.ParamPass.Value)
            env.push(Some(Value { op: mir.Operand.Copy(mir.Place.local(local)), ty: t }))
            ty = result
            body = rest
        }
        let ret = result(c, ty)?
        lower.body.locals[0].ty = ret
        lower.body.arg_count = params.len()
        let value = lower.expr(c, body, env.as_slice(), core.DEPTH)?
        if value.ty != ret { return Err(c.error(body, "return layout mismatch")) }
        lower.assign(0, mir.Rvalue.Use(value.op.clone()), sp)
        lower.term(mir.Term.Return)
        if lower.heap { heap = true }
        let Lower { body, types: next_types, generated: made, drops: known, .. } = move lower
        runtime_types = next_types
        generated = made
        drops = known
        out.push(mir.Function {
            name: c.definitions[i].name.clone(), symbol: c.definitions[i].name.clone()
            sig: types.Sig { c_abi: true, variadic: false, params, ret }
            pass, body: Some(body), linkage: mir.Linkage.Export, variadic: false,
            returns_ref: false, span: sp
        })
    }
    if out.len() == 0 { return Err(c.error(0, "no exported runtime functions")) }
    if heap {
        let ptr = runtime_types.intern(types.TyKind.Ptr(types.I64))
        let sp = diag.Span.nowhere()
        for (name, params, ret) in [("malloc", [types.U64], ptr), ("free", [ptr], types.UNIT)] {
            var ps = Vec(u32).new()
            var pass = Vec(mir.ParamPass).new()
            for p in params { ps.push(p); pass.push(mir.ParamPass.Value) }
            out.push(mir.Function {
                name: name.to_string(), symbol: name.to_string()
                sig: types.Sig { c_abi: true, variadic: false, params: ps, ret }
                pass, body: None, linkage: mir.Linkage.Extern, variadic: false,
                returns_ref: false, span: sp
            })
        }
        while generated.len() > 0 { out.push(generated.remove(0)) }
    }
    Ok(mir.Program { fns: out, types: runtime_types, entry: None, panic_handler: None,
        profile: target.Profile.Native, checked: true, statics: Vec(mir.StaticDef).new(),
        drop_impls: Map(u32, u32).new(), invariants: Map(u32, Vec(mir.Clause)).new(),
        target: tgt, codegen: target.Codegen.default() })
}
