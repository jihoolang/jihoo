// Types, interned in one table and referred to by index, and their memory
// layout, which the code generator and the interpreter share.
//
// The Rust compiler interns a `TyKind` through its derived `Hash`; here the
// key is a short text that spells the kind out (`kind_key`).

pub struct IntTy {
    pub signed: bool
    pub bits: u32
}

pub struct Sig {
    pub c_abi: bool
    pub variadic: bool
    pub params: Vec(u32)
    pub ret: u32
}

impl Clone for Sig {
    fn clone(self) -> Sig {
        Sig {
            params: self.params.clone(),
            ret: self.ret,
            c_abi: self.c_abi,
            variadic: self.variadic
        }
    }
}

impl Eq for Sig {
    fn eq(self, other: Sig) -> bool {
        self.ret == other.ret && self.params == other.params && self.c_abi == other.c_abi &&
            self.variadic == other.variadic
    }
}

pub enum TyKind {
    Bool
    Int(IntTy)
    Float(u32)
    // The type of `return`, `break`, `panic(...)`: no value.
    Never
    // Tuples, including `()` (no parts).
    Tuple(Vec(u32))
    Ptr(u32)
    Array(u32, u64)
    // `[T]`: a borrowed view, a pointer and a length.
    Slice(u32)
    // `str`: a borrowed view of bytes.
    Str
    // A struct or enum instance.
    Adt(u32)
    // Borrows, which only the compiler writes: parameters, local borrows,
    // projections.
    Ref(u32)
    RefMut(u32)
    // `fn(A) -> R`: a borrowed closure, a code pointer and an environment.
    Closure(Sig)
    // `fnptr(A) -> R`.
    FnPtr(Sig)
    // The type of types, at compile time.
    Type
    // `dyn Trait`: a value of some type with that trait, which it owns on
    // the heap; a data pointer, then its type's table of functions.
    Dyn(u32)
    // `dyn fn(A) -> R`: a closure that owns what it captured, laid out as
    // `Dyn`.
    DynFn(Sig)
    // `move fn(A) -> R`: a closure that owns what it captured, with its
    // function known while compiling (the lifted function, then the tuple
    // of captures it is laid out as). One type per closure expression; the
    // signature is not part of its identity, since it is known only after
    // the body.
    Lambda(u32, u32, Sig)
}

impl Clone for TyKind {
    fn clone(self) -> TyKind {
        match self {
            Bool => TyKind.Bool
            Int(i) => TyKind.Int(i)
            Float(b) => TyKind.Float(b)
            Never => TyKind.Never
            Tuple(ts) => TyKind.Tuple(ts.clone())
            Ptr(t) => TyKind.Ptr(t)
            Array(t, n) => TyKind.Array(t, n)
            Slice(t) => TyKind.Slice(t)
            Str => TyKind.Str
            Adt(i) => TyKind.Adt(i)
            Ref(t) => TyKind.Ref(t)
            RefMut(t) => TyKind.RefMut(t)
            Closure(s) => TyKind.Closure(s.clone())
            FnPtr(s) => TyKind.FnPtr(s.clone())
            Type => TyKind.Type
            Dyn(t) => TyKind.Dyn(t)
            DynFn(s) => TyKind.DynFn(s.clone())
            Lambda(f, e, s) => TyKind.Lambda(f, e, s.clone())
        }
    }
}

impl Eq for TyKind {
    fn eq(self, other: TyKind) -> bool {
        kind_key(self) == kind_key(other)
    }
}

// The interning key of a kind: a letter, then its parts.
pub fn kind_key(k: TyKind) -> String {
    var s = String.new()
    match k {
        Bool => s.push('b')
        Int(i) => {
            s.push(if i.signed { 'i' } else { 'u' })
            i.bits.show(&s)
        }
        Float(b) => {
            s.push('f')
            b.show(&s)
        }
        Never => s.push('!')
        Tuple(ts) => {
            s.push('(')
            ids(&s, ts)
        }
        Ptr(t) => {
            s.push('*')
            t.show(&s)
        }
        Array(t, n) => {
            s.push('[')
            t.show(&s)
            s.push(';')
            n.show(&s)
        }
        Slice(t) => {
            s.push('s')
            t.show(&s)
        }
        Str => s.push('S')
        Adt(i) => {
            s.push('A')
            i.show(&s)
        }
        Ref(t) => {
            s.push('r')
            t.show(&s)
        }
        RefMut(t) => {
            s.push('m')
            t.show(&s)
        }
        Closure(sig) => {
            s.push('c')
            ids(&s, sig.params)
            s.push('>')
            sig.ret.show(&s)
        }
        FnPtr(sig) => {
            s.push('p')
            s.push(if sig.c_abi { 'C' } else { 'J' })
            if sig.variadic { s.push('v') }
            ids(&s, sig.params)
            s.push('>')
            sig.ret.show(&s)
        }
        Type => s.push('T')
        Dyn(t) => {
            s.push('d')
            t.show(&s)
        }
        DynFn(sig) => {
            s.push('D')
            ids(&s, sig.params)
            s.push('>')
            sig.ret.show(&s)
        }
        Lambda(f, e, _) => {
            s.push('L')
            f.show(&s)
            s.push(',')
            e.show(&s)
        }
    }
    s
}

fn ids(inout s: String, ts: Vec(u32)) {
    for t in ts {
        t.show(&s)
        s.push(',')
    }
}

pub enum AdtBody {
    // Not filled in yet (an instance being built).
    Pending
    Struct(Vec(FieldDef))
    Enum(Vec(VariantDef))
}

impl Clone for AdtBody {
    fn clone(self) -> AdtBody {
        match self {
            Pending => AdtBody.Pending
            Struct(fs) => AdtBody.Struct(fs.clone())
            Enum(vs) => AdtBody.Enum(vs.clone())
        }
    }
}

pub struct FieldDef {
    pub name: String
    pub ty: u32
    pub public: bool
}

impl Clone for FieldDef {
    fn clone(self) -> FieldDef {
        FieldDef { name: self.name.clone(), ty: self.ty, public: self.public }
    }
}

pub struct VariantDef {
    pub name: String
    pub fields: Vec(u32)
}

impl Clone for VariantDef {
    fn clone(self) -> VariantDef {
        VariantDef { name: self.name.clone(), fields: self.fields.clone() }
    }
}

pub struct AdtDef {
    // What error messages call it: `Vec(i64)`.
    pub name: String
    // The declaration: an index into sema's table of struct and enum
    // declarations.
    pub decl: u32
    pub body: AdtBody
    // Whether the type has a `Drop` impl (filled in by sema).
    pub has_drop: bool
    // Marked `#[view]`, or has a view as an argument: it may hold borrows.
    pub view: bool
    // Marked `#[interior]`: unsafe code changes it behind shared borrows.
    pub interior: bool
}

pub struct Layout {
    pub size: u64
    pub align: u64
}

pub struct EnumLayout {
    pub tag_bits: u32
    // Offsets of each variant's fields.
    pub fields: Vec(Vec(u64))
}

pub struct Types {
    pub kinds: Vec(TyKind)
    map: Map(String, u32)
    pub adts: Vec(AdtDef)
    layouts: Map(u32, Layout)
    pub ptr_size: u64
    needs_drop_cache: Map(u32, bool)
    // The names of the traits of `dyn` types, for messages.
    pub trait_names: Map(u32, String)
}

pub const BOOL: u32 = 0
pub const UNIT: u32 = 1
pub const NEVER: u32 = 2
pub const I8: u32 = 3
pub const I16: u32 = 4
pub const I32: u32 = 5
pub const I64: u32 = 6
pub const U8: u32 = 7
pub const U16: u32 = 8
pub const U32: u32 = 9
pub const U64: u32 = 10
pub const F32: u32 = 11
pub const F64: u32 = 12
pub const STR: u32 = 13
pub const TYPE: u32 = 14
pub const I128: u32 = 15
pub const U128: u32 = 16
// `*u8`: the parts of `dyn` values.
pub const BYTES: u32 = 17

fn int(signed: bool, bits: u32) -> TyKind {
    TyKind.Int(IntTy { signed: signed, bits: bits })
}

impl Types {
    // C values have no language-managed ownership or borrowed storage.
    // Arrays are valid struct members, but C parameters decay to pointers.
    pub fn c_type(self, t: u32) -> bool {
        self.c_value(t, false, Vec(u32).new())
    }

    fn c_value(self, t: u32, field: bool, sink seen: Vec(u32)) -> bool {
        for x in seen {
            if x == t { return true }
        }
        seen.push(t)
        match self.kind(t) {
            Bool | Float(_) | Ptr(_) | Int(_) => true
            Array(e, _) => field && self.c_value(e, true, seen)
            Adt(i) => {
                let d = self.adts[i as i64]
                if d.has_drop || d.view || d.interior { return false }
                match d.body {
                    Struct(fs) => {
                        for f in fs {
                            if !self.c_value(f.ty, true, seen.clone()) { return false }
                        }
                        true
                    }
                    // A recursive function pointer can mention its struct
                    // while that struct's fields are still being resolved.
                    Pending => true
                    _ => false
                }
            }
            FnPtr(s) => {
                if !s.c_abi { return false }
                for p in s.params {
                    if !self.c_value(p, false, seen.clone()) { return false }
                }
                s.ret == UNIT || s.ret == NEVER || self.c_value(s.ret, false, seen)
            }
            _ => false
        }
    }

    pub fn new() -> Types {
        var t = Types {
            kinds: Vec(TyKind).new()
            map: Map(String, u32).new()
            adts: Vec(AdtDef).new()
            layouts: Map(u32, Layout).new()
            ptr_size: 8
            needs_drop_cache: Map(u32, bool).new()
            trait_names: Map(u32, String).new()
        }
        t.intern(TyKind.Bool)
        t.intern(TyKind.Tuple(Vec(u32).new()))
        t.intern(TyKind.Never)
        t.intern(int(true, 8))
        t.intern(int(true, 16))
        t.intern(int(true, 32))
        t.intern(int(true, 64))
        t.intern(int(false, 8))
        t.intern(int(false, 16))
        t.intern(int(false, 32))
        t.intern(int(false, 64))
        t.intern(TyKind.Float(32))
        t.intern(TyKind.Float(64))
        t.intern(TyKind.Str)
        t.intern(TyKind.Type)
        t.intern(int(true, 128))
        t.intern(int(false, 128))
        t.intern(TyKind.Ptr(U8))
        t
    }

    pub fn intern(inout self, sink k: TyKind) -> u32 {
        let key = kind_key(k)
        match self.map.get(key) {
            Some(id) => return id
            None => {}
        }
        let id = self.kinds.len() as u32
        self.kinds.push(k)
        self.map.insert(key, id)
        id
    }

    pub fn kind(self, t: u32) -> ref TyKind {
        self.kinds[t as i64]
    }

    pub fn ptr(inout self, t: u32) -> u32 {
        self.intern(TyKind.Ptr(t))
    }

    pub fn refty(inout self, t: u32) -> u32 {
        self.intern(TyKind.Ref(t))
    }

    pub fn refmut(inout self, t: u32) -> u32 {
        self.intern(TyKind.RefMut(t))
    }

    pub fn tuple(inout self, sink ts: Vec(u32)) -> u32 {
        self.intern(TyKind.Tuple(ts))
    }

    pub fn new_adt(inout self, sink name: String, decl: u32) -> u32 {
        let idx = self.adts.len() as u32
        self.adts.push(AdtDef {
            name: name,
            decl: decl,
            body: AdtBody.Pending,
            has_drop: false,
            view: false,
            interior: false
        })
        self.intern(TyKind.Adt(idx))
    }

    // The index into `adts` of a struct or enum type.
    pub fn adt_index(self, t: u32) -> Option(u32) {
        match self.kind(t) {
            Adt(i) => Some(i)
            _ => None
        }
    }

    pub fn int(self, t: u32) -> Option(IntTy) {
        match self.kind(t) {
            Int(i) => Some(i)
            _ => None
        }
    }

    pub fn is_int(self, t: u32) -> bool {
        self.int(t).is_some()
    }

    pub fn is_float(self, t: u32) -> bool {
        match self.kind(t) {
            Float(_) => true
            _ => false
        }
    }

    pub fn is_ptr(self, t: u32) -> bool {
        match self.kind(t) {
            Ptr(_) => true
            _ => false
        }
    }

    pub fn is_ref(self, t: u32) -> bool {
        match self.kind(t) {
            Ref(_) | RefMut(_) => true
            _ => false
        }
    }

    pub fn pointee(self, t: u32) -> Option(u32) {
        match self.kind(t) {
            Ptr(p) => Some(p)
            Ref(p) => Some(p)
            RefMut(p) => Some(p)
            _ => None
        }
    }

    // A value kept in one register: numbers, pointers, borrows.
    pub fn is_scalar(self, t: u32) -> bool {
        match self.kind(t) {
            Bool | Int(_) | Float(_) | Ptr(_) | Ref(_) | RefMut(_) | FnPtr(_) => true
            _ => false
        }
    }

    pub fn is_zst(inout self, t: u32) -> bool {
        self.layout(t).size == 0
    }

    // Whether a value of this type must be dropped: it owns memory or has a
    // `Drop` impl. Values that need no drop copy implicitly ("plain").
    pub fn needs_drop(inout self, t: u32) -> bool {
        match self.needs_drop_cache.get(t) {
            Some(b) => return b
            None => {}
        }
        // recursion through pointers stops here
        self.needs_drop_cache.insert(t, false)
        let k = self.kind(t).clone()
        let b = match k {
            Dyn(_) | DynFn(_) => true
            Tuple(ts) => self.any_needs_drop(ts)
            Lambda(_, e, _) => self.needs_drop(e)
            Array(e, n) => n > 0 && self.needs_drop(e)
            Adt(i) => {
                let has_drop = self.adts[i as i64].has_drop
                let body = self.adts[i as i64].body.clone()
                has_drop || match body {
                    Struct(fs) => {
                        var any = false
                        for f in fs {
                            if self.needs_drop(f.ty) {
                                any = true
                                break
                            }
                        }
                        any
                    }
                    Enum(vs) => {
                        var any = false
                        for v in vs {
                            if self.any_needs_drop(v.fields) {
                                any = true
                                break
                            }
                        }
                        any
                    }
                    Pending => false
                }
            }
            _ => false
        }
        self.needs_drop_cache.insert(t, b)
        b
    }

    fn any_needs_drop(inout self, ts: Vec(u32)) -> bool {
        for x in ts {
            if self.needs_drop(x) {
                return true
            }
        }
        false
    }

    // Views hold borrows: the checker follows what they borrow, and they
    // live no longer than it.
    pub fn is_view(self, t: u32) -> bool {
        match self.kind(t) {
            Str | Slice(_) | Ref(_) | RefMut(_) | Closure(_) => true
            Tuple(ts) => self.any_view(ts)
            Lambda(_, e, _) => self.is_view(e)
            Array(e, _) => self.is_view(e)
            Adt(i) => {
                let d = self.adts[i as i64]
                d.view || match d.body {
                    Struct(fs) => {
                        for f in fs {
                            if self.is_view(f.ty) {
                                return true
                            }
                        }
                        false
                    }
                    Enum(vs) => {
                        for v in vs {
                            if self.any_view(v.fields) {
                                return true
                            }
                        }
                        false
                    }
                    Pending => false
                }
            }
            _ => false
        }
    }

    fn any_view(self, ts: Vec(u32)) -> bool {
        for x in ts {
            if self.is_view(x) {
                return true
            }
        }
        false
    }

    // Holds an exclusive borrow somewhere, so it cannot be copied.
    pub fn has_refmut(self, t: u32) -> bool {
        match self.kind(t) {
            RefMut(_) => true
            Tuple(ts) => self.any_refmut(ts)
            Lambda(_, e, _) => self.has_refmut(e)
            Array(e, _) => self.has_refmut(e)
            Adt(i) => match self.adts[i as i64].body {
                Struct(fs) => {
                    for f in fs {
                        if self.has_refmut(f.ty) {
                            return true
                        }
                    }
                    false
                }
                Enum(vs) => {
                    for v in vs {
                        if self.any_refmut(v.fields) {
                            return true
                        }
                    }
                    false
                }
                Pending => false
            }
            _ => false
        }
    }

    fn any_refmut(self, ts: Vec(u32)) -> bool {
        for x in ts {
            if self.has_refmut(x) {
                return true
            }
        }
        false
    }

    // Holds a float in place, not behind a pointer: a value that would go
    // through floating-point registers.
    pub fn has_float(self, t: u32) -> bool {
        match self.kind(t) {
            Float(_) => true
            Tuple(ts) => self.any_float(ts)
            Lambda(_, e, _) => self.has_float(e)
            Array(e, _) => self.has_float(e)
            Adt(i) => match self.adts[i as i64].body {
                Struct(fs) => {
                    for f in fs {
                        if self.has_float(f.ty) {
                            return true
                        }
                    }
                    false
                }
                Enum(vs) => {
                    for v in vs {
                        if self.any_float(v.fields) {
                            return true
                        }
                    }
                    false
                }
                Pending => false
            }
            _ => false
        }
    }

    fn any_float(self, ts: Vec(u32)) -> bool {
        for x in ts {
            if self.has_float(x) {
                return true
            }
        }
        false
    }

    // Plain values copy implicitly. A value that changes behind shared
    // borrows does not: a copy would be another value.
    pub fn is_plain(inout self, t: u32) -> bool {
        !self.has_refmut(t) && !self.needs_drop(t) && !self.is_interior(t)
    }

    // Whether a value of `t` holds memory that `#[interior]` code changes
    // while it is borrowed shared: such borrows are not `readonly` or
    // `noalias`.
    pub fn is_interior(self, t: u32) -> bool {
        match self.kind(t) {
            Tuple(ts) => {
                for x in ts {
                    if self.is_interior(x) {
                        return true
                    }
                }
                false
            }
            Array(e, _) => self.is_interior(e)
            Lambda(_, e, _) => self.is_interior(e)
            Adt(i) => {
                if self.adts[i as i64].interior {
                    return true
                }
                match self.adts[i as i64].body {
                    Struct(fs) => {
                        for f in fs {
                            if self.is_interior(f.ty) {
                                return true
                            }
                        }
                        false
                    }
                    Enum(vs) => {
                        for v in vs {
                            for x in v.fields {
                                if self.is_interior(x) {
                                    return true
                                }
                            }
                        }
                        false
                    }
                    Pending => false
                }
            }
            _ => false
        }
    }

    pub fn reset_drop_cache(inout self) {
        self.needs_drop_cache = Map(u32, bool).new()
    }

    pub fn layout(inout self, t: u32) -> Layout {
        match self.layouts.get(t) {
            Some(l) => return l
            None => {}
        }
        let p = self.ptr_size
        let k = self.kind(t).clone()
        let l = match k {
            Bool => Layout { size: 1, align: 1 }
            Int(i) => Layout { size: (i.bits / 8) as u64, align: (i.bits / 8) as u64 }
            Float(b) => Layout { size: (b / 8) as u64, align: (b / 8) as u64 }
            Never | Type => Layout { size: 0, align: 1 }
            Ptr(_) | Ref(_) | RefMut(_) | FnPtr(_) => Layout { size: p, align: p }
            Slice(_) | Str | Closure(_) | Dyn(_) | DynFn(_) => Layout { size: 2 * p, align: p }
            Tuple(ts) => self.struct_layout(ts).0
            Lambda(_, e, _) => self.layout(e)
            Array(e, n) => {
                let el = self.layout(e)
                Layout { size: el.size * n, align: el.align }
            }
            Adt(i) => {
                let body = self.adts[i as i64].body.clone()
                match body {
                    Struct(fs) => self.struct_layout(field_types(fs)).0
                    Enum(_) => self.enum_layout(t).0
                    Pending => panic("layout of a type still being defined")
                }
            }
        }
        self.layouts.insert(t, l)
        l
    }

    // Fields in declaration order, each at its natural alignment, as C does.
    pub fn struct_layout(inout self, ts: Vec(u32)) -> (Layout, Vec(u64)) {
        var off: u64 = 0
        var align: u64 = 1
        var offs = Vec(u64).new()
        for f in ts {
            let l = self.layout(f)
            off = round_up(off, l.align)
            offs.push(off)
            off += l.size
            align = max(align, l.align)
        }
        (Layout { size: round_up(off, align), align: align }, offs)
    }

    pub fn field_offsets(inout self, t: u32) -> Vec(u64) {
        let k = self.kind(t).clone()
        match k {
            Tuple(ts) => self.struct_layout(ts).1
            Lambda(_, e, _) => self.field_offsets(e)
            Adt(i) => {
                let body = self.adts[i as i64].body.clone()
                match body {
                    Struct(fs) => self.struct_layout(field_types(fs)).1
                    _ => Vec(u64).new()
                }
            }
            Slice(_) | Str | Closure(_) | Dyn(_) | DynFn(_) => {
                var v = Vec(u64).new()
                v.push(0)
                v.push(self.ptr_size)
                v
            }
            _ => Vec(u64).new()
        }
    }

    // The fields' types, for tuples and structs.
    pub fn field_tys(self, t: u32) -> Vec(u32) {
        match self.kind(t) {
            Tuple(ts) => ts.clone()
            Lambda(_, e, _) => self.field_tys(e)
            Dyn(_) | DynFn(_) => {
                var v = Vec(u32).new()
                v.push(BYTES)
                v.push(BYTES)
                v
            }
            Adt(i) => match self.adts[i as i64].body {
                Struct(fs) => field_types(fs)
                _ => Vec(u32).new()
            }
            _ => Vec(u32).new()
        }
    }

    // The variants of an enum type, if it is one.
    pub fn variants(self, t: u32) -> Option(ref Vec(VariantDef)) {
        match self.kind(t) {
            Adt(i) => match self.adts[i as i64].body {
                Enum(vs) => Some(vs)
                _ => None
            }
            _ => None
        }
    }

    // A tag at offset 0, then each variant's fields laid out as a struct
    // after it.
    pub fn enum_layout(inout self, t: u32) -> (Layout, EnumLayout) {
        var vs = Vec(VariantDef).new()
        match self.variants(t) {
            Some(v) => vs = v.clone()
            None => {}
        }
        let tag_bits: u32 = if vs.len() <= 256 { 8 } else { 32 }
        let tag_size = (tag_bits / 8) as u64
        var size = tag_size
        var align = tag_size
        var fields = Vec(Vec(u64)).new()
        for v in vs {
            var off = tag_size
            var offs = Vec(u64).new()
            for f in v.fields {
                let l = self.layout(f)
                off = round_up(off, l.align)
                offs.push(off)
                off += l.size
                align = max(align, l.align)
            }
            size = max(size, off)
            fields.push(offs)
        }
        (
            Layout { size: round_up(size, align), align: align },
            EnumLayout { tag_bits: tag_bits, fields: fields }
        )
    }

    pub fn show(self, t: u32) -> String {
        var s = String.new()
        self.show_into(&s, t)
        s
    }

    fn show_into(self, inout s: String, t: u32) {
        match self.kind(t) {
            Bool => s.push_str("bool")
            Int(i) => {
                s.push(if i.signed { 'i' } else { 'u' })
                i.bits.show(&s)
            }
            Float(b) => {
                s.push('f')
                b.show(&s)
            }
            Never => s.push_str("never")
            Tuple(ts) => {
                s.push('(')
                self.show_list(&s, ts)
                s.push(')')
            }
            Ptr(p) => {
                s.push('*')
                self.show_into(&s, p)
            }
            Array(e, n) => {
                s.push('[')
                self.show_into(&s, e)
                s.push_str("; ")
                n.show(&s)
                s.push(']')
            }
            Slice(e) => {
                s.push('[')
                self.show_into(&s, e)
                s.push(']')
            }
            Str => s.push_str("str")
            Adt(i) => s.push_str(self.adts[i as i64].name.as_str())
            Ref(p) => {
                s.push_str("ref ")
                self.show_into(&s, p)
            }
            RefMut(p) => {
                s.push_str("inout ")
                self.show_into(&s, p)
            }
            Closure(sig) => {
                s.push_str("fn(")
                self.show_list(&s, sig.params)
                s.push(')')
                self.show_ret(&s, sig.ret)
            }
            FnPtr(sig) => {
                s.push_str("fnptr(")
                self.show_list(&s, sig.params)
                if sig.variadic {
                    if sig.params.len() > 0 { s.push_str(", ") }
                    s.push_str("...")
                }
                s.push(')')
                self.show_ret(&s, sig.ret)
            }
            Type => s.push_str("type")
            Dyn(tr) => {
                s.push_str("dyn ")
                match self.trait_names.get(tr) {
                    Some(n) => s.push_str(n.as_str())
                    None => s.push('?')
                }
            }
            DynFn(sig) => {
                s.push_str("dyn fn(")
                self.show_list(&s, sig.params)
                s.push(')')
                self.show_ret(&s, sig.ret)
            }
            Lambda(_, _, sig) => {
                s.push_str("move fn(")
                self.show_list(&s, sig.params)
                s.push(')')
                self.show_ret(&s, sig.ret)
            }
        }
    }

    fn show_list(self, inout s: String, ts: Vec(u32)) {
        for i, t in ts {
            if i > 0 {
                s.push_str(", ")
            }
            self.show_into(&s, t)
        }
    }

    fn show_ret(self, inout s: String, r: u32) {
        if r != UNIT {
            s.push_str(" -> ")
            self.show_into(&s, r)
        }
    }
}

fn field_types(fs: Vec(FieldDef)) -> Vec(u32) {
    var v = Vec(u32).new()
    for f in fs {
        v.push(f.ty)
    }
    v
}

pub fn round_up(x: u64, a: u64) -> u64 {
    if a <= 1 {
        x
    } else {
        (x + a - 1) / a * a
    }
}
