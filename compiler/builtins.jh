// Built-in functions: what the compiler itself must provide. Everything
// else is library code. The Rust compiler's `sema/builtins.rs`.

import ast
import body
import diag
import lex
import mir
import sema
import types

type Diag = diag.Diag
type Span = diag.Span
type Fb = body.Fb
type Val = body.Val
type TyKind = types.TyKind
type Place = mir.Place
type Operand = mir.Operand
type Rvalue = mir.Rvalue
type Const = mir.Const
type Callee = mir.Callee
type Intrinsic = mir.Intrinsic
type CVal = sema.CVal
type Env = sema.Env
type TypedConst = sema.TypedConst
type Proj = mir.Proj
type Term = mir.Term
type VK = body.VK

fn need_unsafe(fb: Fb, n: str, span: Span) -> Result((), Diag) {
    if fb.unsafe_depth == 0 {
        return Err(Diag.new(span, ("`" + n + "` is only allowed in `unsafe` code").as_str()))
    }
    Ok(())
}

fn arity(args: Vec(ast.Expr), k: i64, n: str, span: Span) -> Result((), Diag) {
    if args.len() != k {
        var m = "`" + n + "` takes "
        k.show(&m)
        m.push_str(" argument(s), ")
        args.len().show(&m)
        m.push_str(" given")
        return Err(Diag.new(span, m.as_str()))
    }
    Ok(())
}

fn no_ops() -> Vec(Operand) {
    Vec(Operand).new()
}

fn ops1(sink a: Operand) -> Vec(Operand) {
    var v = Vec(Operand).new()
    v.push(a)
    v
}

fn ops2(sink a: Operand, sink b: Operand) -> Vec(Operand) {
    var v = ops1(a)
    v.push(b)
    v
}

fn ops3(sink a: Operand, sink b: Operand, sink c: Operand) -> Vec(Operand) {
    var v = ops2(a, b)
    v.push(c)
    v
}

impl sema.Sema {
    // The pointee of a raw pointer type.
    fn raw_pointee(self, t: u32) -> Option(u32) {
        if self.types.is_ptr(t) { self.types.pointee(t) } else { None }
    }

    // `exp` if it is a float type.
    fn float_exp(self, exp: Option(u32)) -> Option(u32) {
        match exp {
            Some(t) => if self.types.is_float(t) { Some(t) } else { None }
            None => None
        }
    }

    pub fn builtin_call(inout self, inout fb: Fb, n: str, args: Vec(ast.Expr), exp: Option(u32), span: Span) -> Result(Option(Val), Diag) {
        let env = fb.env.clone()
        match self.reflect_const(n, args, env, exp, span)? {
            Some(r) => return Ok(Some(body.val_op(Operand.Const(r.c.clone()), r.ty)))
            None => {}
        }
        match self.reflect_call(&fb, n, args, span)? {
            Some(v) => return Ok(Some(v))
            None => {}
        }
        if n == "size_of" || n == "align_of" {
            arity(args, 1, n, span)?
            let t = self.expr_ty(args[0], env)?
            let l = self.types.layout(t)
            var rt = types.I64
            match exp {
                Some(x) => if self.types.is_int(x) { rt = x }
                None => {}
            }
            let v = if n == "size_of" { l.size } else { l.align }
            return Ok(Some(body.val_op(Operand.Const(Const.Int(v as i128, rt)), rt)))
        }
        if n == "type_name" {
            arity(args, 1, n, span)?
            let t = self.expr_ty(args[0], env)?
            let s = self.types.show(t)
            self.view_ty(TyKind.Str)
            return Ok(Some(body.val_op(Operand.Const(Const.Str(s)), types.STR)))
        }
        if n == "needs_drop" {
            arity(args, 1, n, span)?
            let t = self.expr_ty(args[0], env)?
            let b = self.types.needs_drop(t)
            return Ok(Some(body.val_op(Operand.Const(Const.Bool(b)), types.BOOL)))
        }
        if n == "trap" {
            arity(args, 0, n, span)?
            return Ok(Some(self.emit_call(&fb, Callee.Intrinsic(Intrinsic.Trap), no_ops(), types.NEVER, span)?))
        }
        if n == "syscall" {
            need_unsafe(fb, n, span)?
            if args.len() == 0 || args.len() > 7 {
                return Err(Diag.new(span, "`syscall` takes the number and up to 6 arguments"))
            }
            var ops = Vec(Operand).new()
            for a in args {
                let v = self.expr(&fb, a, Some(types.I64))?
                let ok = match self.types.kind(v.ty) {
                    Int(_) | Ptr(_) | Bool => true
                    _ => false
                }
                if !ok {
                    return Err(Diag.new(a.span, "`syscall` arguments are integers and pointers"))
                }
                let t = v.ty
                let o = self.operand(&fb, v, a.span)?
                if t == types.I64 {
                    ops.push(o)
                } else {
                    let c = self.rvalue(&fb, Rvalue.Cast(o, types.I64, mir.CastKind.Numeric), types.I64, a.span)
                    ops.push(Operand.Copy(self.place_of_val(c)))
                }
            }
            return Ok(Some(self.emit_call(&fb, Callee.Intrinsic(Intrinsic.Syscall), ops, types.I64, span)?))
        }
        if n == "mem_copy" {
            // mem_copy(dst: *T, src: *T, n: i64): copies n elements.
            need_unsafe(fb, n, span)?
            arity(args, 3, n, span)?
            let d = self.expr(&fb, args[0], None)?
            let et = match self.raw_pointee(d.ty) {
                Some(t) => t
                None => return Err(Diag.new(args[0].span, "`mem_copy` copies between pointers"))
            }
            let dt = d.ty
            let s = self.expr(&fb, args[1], Some(dt))?
            let s = self.coerce(&fb, s, dt, args[1].span)?
            let c = self.expr(&fb, args[2], Some(types.I64))?
            let c = self.coerce(&fb, c, types.I64, args[2].span)?
            let o1 = self.operand(&fb, d, span)?
            let o2 = self.operand(&fb, s, span)?
            let o3 = self.operand(&fb, c, span)?
            return Ok(Some(self.emit_call(&fb, Callee.Intrinsic(Intrinsic.Copy(et)), ops3(o1, o2, o3), types.UNIT, span)?))
        }
        if n == "mem_fill" {
            need_unsafe(fb, n, span)?
            arity(args, 3, n, span)?
            let pu8 = self.types.ptr(types.U8)
            var d = self.expr(&fb, args[0], Some(pu8))?
            if self.types.is_ptr(d.ty) && d.ty != pu8 {
                let o = self.operand(&fb, d, span)?
                d = self.rvalue(&fb, Rvalue.Cast(o, pu8, mir.CastKind.Ptr), pu8, span)
            } else {
                d = self.coerce(&fb, d, pu8, args[0].span)?
            }
            let b = self.expr(&fb, args[1], Some(types.U8))?
            let b = self.coerce(&fb, b, types.U8, args[1].span)?
            let c = self.expr(&fb, args[2], Some(types.I64))?
            let c = self.coerce(&fb, c, types.I64, args[2].span)?
            let o1 = self.operand(&fb, d, span)?
            let o2 = self.operand(&fb, b, span)?
            let o3 = self.operand(&fb, c, span)?
            return Ok(Some(self.emit_call(&fb, Callee.Intrinsic(Intrinsic.Fill), ops3(o1, o2, o3), types.UNIT, span)?))
        }
        if n == "read" {
            // read(p: *T) -> T: the value at p, which the caller now owns.
            need_unsafe(fb, n, span)?
            arity(args, 1, n, span)?
            let p = self.expr(&fb, args[0], None)?
            let et = match self.raw_pointee(p.ty) {
                Some(t) => t
                None => return Err(Diag.new(args[0].span, "`read` reads through a pointer"))
            }
            let o = self.operand(&fb, p, span)?
            let pet = self.types.ptr(et)
            let pl = self.operand_local(&fb, o, pet, span)
            return Ok(Some(self.rvalue(&fb, Rvalue.Use(Operand.Copy(Place.deref(pl))), et, span)))
        }
        if n == "write" {
            // write(p: *T, v: T): stores v at p without dropping what was there.
            need_unsafe(fb, n, span)?
            arity(args, 2, n, span)?
            let p = self.expr(&fb, args[0], None)?
            let et = match self.raw_pointee(p.ty) {
                Some(t) => t
                None => return Err(Diag.new(args[0].span, "`write` writes through a pointer"))
            }
            let o = self.operand(&fb, p, span)?
            let pt = self.types.ptr(et)
            let pl = self.operand_local(&fb, o, pt, span)
            let v = self.expr(&fb, args[1], Some(et))?
            let v = self.coerce(&fb, v, et, args[1].span)?
            let vo = self.operand(&fb, v, args[1].span)?
            fb.assign(Place.deref(pl), Rvalue.Use(vo), span)
            return Ok(Some(body.val_unit()))
        }
        if n == "forget" {
            // forget(v): v's destructor does not run.
            arity(args, 1, n, span)?
            let v = self.expr(&fb, args[0], None)?
            let t = v.ty
            let o = self.operand(&fb, v, span)?
            let tmp = fb.temp(t, span)
            fb.assign(Place.local(tmp), Rvalue.Use(o), span)
            fb.push(mir.Stmt.Forget(tmp))
            return Ok(Some(body.val_unit()))
        }
        if n == "make_slice" || n == "make_str" {
            // make_slice(p: *T, n: i64) -> [T]: a view of n elements at p.
            need_unsafe(fb, n, span)?
            arity(args, 2, n, span)?
            let is_str = n == "make_str"
            let pu8 = self.types.ptr(types.U8)
            let p = self.expr(&fb, args[0], if is_str { Some(pu8) } else { None })?
            let et = match self.raw_pointee(p.ty) {
                Some(t) => t
                None => return Err(Diag.new(args[0].span, "expected a pointer"))
            }
            if is_str && et != types.U8 {
                return Err(Diag.new(args[0].span, "`make_str` takes a `*u8`"))
            }
            let c = self.expr(&fb, args[1], Some(types.I64))?
            let c = self.coerce(&fb, c, types.I64, args[1].span)?
            let vt = if is_str { self.view_ty(TyKind.Str) } else { self.view_ty(TyKind.Slice(et)) }
            let o1 = self.operand(&fb, p, span)?
            let o2 = self.operand(&fb, c, span)?
            return Ok(Some(self.rvalue(&fb, Rvalue.Aggregate(mir.Agg.View(vt), ops2(o1, o2)), vt, span)))
        }
        if n == "zeroed" {
            need_unsafe(fb, n, span)?
            arity(args, 1, n, span)?
            let t = self.expr_ty(args[0], env)?
            return Ok(Some(body.val_op(Operand.Const(Const.Zeroed(t)), t)))
        }
        if n == "sqrt" || n == "floor" || n == "ceil" || n == "trunc" || n == "round" || n == "abs" {
            arity(args, 1, n, span)?
            let v = self.expr(&fb, args[0], self.float_exp(exp))?
            let t = v.ty
            if !self.types.is_float(t) {
                var signed = false
                match self.types.int(t) {
                    Some(i) => signed = i.signed
                    None => {}
                }
                if n == "abs" && signed {
                    let o = self.operand(&fb, v, span)?
                    return Ok(Some(self.emit_call(&fb, Callee.Intrinsic(Intrinsic.Abs(t)), ops1(o), t, span)?))
                }
                return Err(Diag.new(args[0].span, ("`" + n + "` takes a float").as_str()))
            }
            let o = self.operand(&fb, v, span)?
            let i = if n == "sqrt" {
                Intrinsic.Sqrt(t)
            } else if n == "floor" {
                Intrinsic.Floor(t)
            } else if n == "ceil" {
                Intrinsic.Ceil(t)
            } else if n == "trunc" {
                Intrinsic.Trunc(t)
            } else if n == "round" {
                Intrinsic.Round(t)
            } else {
                Intrinsic.Abs(t)
            }
            return Ok(Some(self.emit_call(&fb, Callee.Intrinsic(i), ops1(o), t, span)?))
        }
        if n == "copysign" {
            arity(args, 2, n, span)?
            let a = self.expr(&fb, args[0], self.float_exp(exp))?
            let t = a.ty
            if !self.types.is_float(t) {
                return Err(Diag.new(args[0].span, "`copysign` takes floats"))
            }
            let b = self.expr(&fb, args[1], Some(t))?
            let b = self.coerce(&fb, b, t, args[1].span)?
            let o1 = self.operand(&fb, a, span)?
            let o2 = self.operand(&fb, b, span)?
            return Ok(Some(self.emit_call(&fb, Callee.Intrinsic(Intrinsic.Copysign(t)), ops2(o1, o2), t, span)?))
        }
        if n == "argc" {
            arity(args, 0, n, span)?
            return Ok(Some(self.emit_call(&fb, Callee.Intrinsic(Intrinsic.Argc), no_ops(), types.I64, span)?))
        }
        if n == "argv" {
            arity(args, 0, n, span)?
            let pu8 = self.types.ptr(types.U8)
            let ppu8 = self.types.ptr(pu8)
            return Ok(Some(self.emit_call(&fb, Callee.Intrinsic(Intrinsic.Argv), no_ops(), ppu8, span)?))
        }
        if n == "atomic_load" || n == "atomic_store" || n == "atomic_swap" || n == "atomic_add" || n == "atomic_sub" || n == "atomic_and" || n == "atomic_or" || n == "atomic_xor" || n == "atomic_cas" {
            need_unsafe(fb, n, span)?
            if args.len() == 0 {
                return Err(Diag.new(span, "missing pointer"))
            }
            let p = self.expr(&fb, args[0], None)?
            let et = match self.raw_pointee(p.ty) {
                Some(t) => t
                None => return Err(Diag.new(args[0].span, "atomics work through a pointer"))
            }
            if !self.types.is_int(et) && !self.types.is_ptr(et) && et != types.BOOL {
                return Err(Diag.new(args[0].span, "atomics work on integers, bools and pointers"))
            }
            var ops = ops1(self.operand(&fb, p, span)?)
            let want = if n == "atomic_load" { 1 } else if n == "atomic_cas" { 3 } else { 2 }
            arity(args, want, n, span)?
            for i in 1..args.len() {
                let a = args[i]
                let v = self.expr(&fb, a, Some(et))?
                let v = self.coerce(&fb, v, et, a.span)?
                ops.push(self.operand(&fb, v, a.span)?)
            }
            var rt = et
            var i = Intrinsic.Fence
            if n == "atomic_load" {
                i = Intrinsic.AtomicLoad(et)
            } else if n == "atomic_store" {
                i = Intrinsic.AtomicStore(et)
                rt = types.UNIT
            } else if n == "atomic_cas" {
                i = Intrinsic.AtomicCas(et)
                rt = types.BOOL
            } else {
                i = Intrinsic.AtomicRmw(String.from(n[7..]), et)
            }
            return Ok(Some(self.emit_call(&fb, Callee.Intrinsic(i), ops, rt, span)?))
        }
        if n == "fence" {
            arity(args, 0, n, span)?
            return Ok(Some(self.emit_call(&fb, Callee.Intrinsic(Intrinsic.Fence), no_ops(), types.UNIT, span)?))
        }
        Ok(None)
    }
}

// ---- reflection ----

// The trait whose derived code a method of std.derive's `Derived` is.
fn derived_trait(method: str) -> str {
    if method == "clone" {
        "Clone"
    } else if method == "eq" {
        "Eq"
    } else if method == "compare" {
        "Ord"
    } else if method == "hash" {
        "Hash"
    } else if method == "show" {
        "Show"
    } else {
        ""
    }
}

fn reflect_int(v: i64, exp: Option(u32), t: types.Types) -> TypedConst {
    var rt = types.I64
    match exp {
        Some(x) => if t.is_int(x) { rt = x }
        None => {}
    }
    TypedConst { c: Const.Int(v as i128, rt), ty: rt }
}

impl sema.Sema {
    // What a type is made of, as compile-time constants: `field_count(T)`,
    // `field_name(T, i)`, `variant_count(T)`, `variant_name(T, v)`,
    // `variant_field_count(T, v)`, `is_struct(T)`, `is_enum(T)`,
    // `is_tuple(T)`. None if `n` is none of them.
    pub fn reflect_const(inout self, n: str, args: Vec(ast.Expr), env: Env, exp: Option(u32), span: Span) -> Result(Option(TypedConst), Diag) {
        let one = n == "field_count" || n == "variant_count" || n == "is_struct" || n == "is_enum" || n == "is_tuple"
        let two = n == "field_name" || n == "variant_name" || n == "variant_field_count"
        if !one && !two {
            return Ok(None)
        }
        arity(args, if one { 1 } else { 2 }, n, span)?
        let t = self.expr_ty(args[0], env)?
        var is_struct = false
        var fields = Vec(String).new()
        var tuple_len: Option(i64) = None
        var variants: Option(Vec(types.VariantDef)) = None
        match self.types.adt_index(t) {
            Some(a) => match self.types.adts[a as i64].body {
                Struct(fs) => {
                    for f in fs {
                        fields.push(f.name.clone())
                    }
                    is_struct = true
                }
                Enum(vs) => variants = Some(vs.clone())
                _ => {}
            }
            None => match self.types.kind(t) {
                Tuple(ts) => tuple_len = Some(ts.len())
                _ => {}
            }
        }
        if n == "is_struct" {
            return Ok(Some(TypedConst { c: Const.Bool(is_struct), ty: types.BOOL }))
        }
        if n == "is_enum" {
            return Ok(Some(TypedConst { c: Const.Bool(variants.is_some()), ty: types.BOOL }))
        }
        if n == "is_tuple" {
            return Ok(Some(TypedConst { c: Const.Bool(tuple_len.is_some()), ty: types.BOOL }))
        }
        let ts = self.types.show(t)
        if n == "field_count" || n == "field_name" {
            let count = if is_struct {
                fields.len()
            } else {
                match tuple_len {
                    Some(k) => k
                    None => return Err(Diag.new(args[0].span, ("`" + n + "` takes a struct or tuple type, not `" + ts.as_str() + "`").as_str()))
                }
            }
            if n == "field_count" {
                return Ok(Some(reflect_int(count, exp, self.types)))
            }
            let i = self.reflect_index(args[1], env, count, "field", ts.as_str())?
            var name = String.new()
            if is_struct {
                name = fields[i].clone()
            } else {
                i.show(&name)
            }
            self.view_ty(TyKind.Str)
            return Ok(Some(TypedConst { c: Const.Str(name), ty: types.STR }))
        }
        let vs = match variants {
            Some(vs) => vs
            None => return Err(Diag.new(args[0].span, ("`" + n + "` takes an enum type, not `" + ts.as_str() + "`").as_str()))
        }
        if n == "variant_count" {
            return Ok(Some(reflect_int(vs.len(), exp, self.types)))
        }
        let v = self.reflect_index(args[1], env, vs.len(), "variant", ts.as_str())?
        if n == "variant_name" {
            self.view_ty(TyKind.Str)
            return Ok(Some(TypedConst { c: Const.Str(vs[v].name.clone()), ty: types.STR }))
        }
        Ok(Some(reflect_int(vs[v].fields.len(), exp, self.types)))
    }

    // A compile-time index below `count`.
    fn reflect_index(inout self, e: ast.Expr, env: Env, count: i64, what: str, ty: str) -> Result(i64, Diag) {
        let i = self.const_int(e, env)?
        if i < 0 || i >= count as i128 {
            var m = String.from("`")
            m.push_str(ty)
            m.push_str("` has no ")
            m.push_str(what)
            m.push(' ')
            i.show(&m)
            return Err(Diag.new(e.span, m.as_str()))
        }
        Ok(i as i64)
    }

    // Whether the code being lowered may name the private fields of the
    // struct `a` through reflection: as `x.f` may, or as the derived code
    // (std.derive's `Derived`) of a trait the struct derives.
    fn reflect_private_ok(self, fb: Fb, a: u32) -> bool {
        let decl = self.types.adts[a as i64].decl
        if self.same_package(self.adts[decl as i64].module, fb.env.module) {
            return true
        }
        let dt = match self.lang.derived {
            Some(t) => t
            None => return false
        }
        if fb.id as i64 >= self.inst_info.len() {
            return false
        }
        let fid = match self.inst_info[fb.id as i64] {
            Some(info) => info.decl
            None => return false
        }
        match self.fns[fid as i64].owner {
            Trait(t) => if t != dt { return false }
            _ => return false
        }
        let tr = derived_trait(sema.at(self.fns[fid as i64].decl).name.as_str())
        for d in self.adts[decl as i64].derives {
            if d == tr {
                return true
            }
        }
        false
    }

    fn private_field_err(self, a: u32, name: str, span: Span) -> Diag {
        Diag.new(span, ("the field `" + name + "` of `" + self.types.adts[a as i64].name.as_str() + "` is private").as_str())
    }

    // Reflection that lowers code: `field(x, i)`, `variant_of(x)`,
    // `variant_field(x, v, j)`, `make(T, fn(i) { ... })`,
    // `make_variant(T, v, fn(j) { ... })`. None if `n` is none of them.
    fn reflect_call(inout self, inout fb: Fb, n: str, args: Vec(ast.Expr), span: Span) -> Result(Option(Val), Diag) {
        let env = fb.env.clone()
        if n == "field" {
            // The place of a struct's or tuple's field `i`.
            arity(args, 2, n, span)?
            let bv = self.expr(&fb, args[0], None)?
            let bv = self.auto_deref(&fb, bv, span)?
            let t = bv.ty
            let ts = self.types.show(t)
            match self.types.adt_index(t) {
                Some(a) => {
                    let fs = match self.types.adts[a as i64].body {
                        Struct(fs) => fs.clone()
                        _ => return Err(Diag.new(args[0].span, ("`field` takes a struct or tuple, not `" + ts.as_str() + "`").as_str()))
                    }
                    let i = self.reflect_index(args[1], env, fs.len(), "field", ts.as_str())?
                    if !fs[i].public && !self.reflect_private_ok(fb, a) {
                        return Err(self.private_field_err(a, fs[i].name.as_str(), span))
                    }
                    let temp = bv.temp
                    let (p, _) = self.as_place(&fb, bv, span)
                    return Ok(Some(Val { vk: VK.Place(p.with(Proj.Field(i as u32))), ty: fs[i].ty, temp: temp }))
                }
                None => {}
            }
            let tys = match self.types.kind(t) {
                Tuple(tys) => tys.clone()
                _ => return Err(Diag.new(args[0].span, ("`field` takes a struct or tuple, not `" + ts.as_str() + "`").as_str()))
            }
            let i = self.reflect_index(args[1], env, tys.len(), "field", ts.as_str())?
            let temp = bv.temp
            let (p, _) = self.as_place(&fb, bv, span)
            return Ok(Some(Val { vk: VK.Place(p.with(Proj.Field(i as u32))), ty: tys[i], temp: temp }))
        }
        if n == "variant_of" || n == "variant_field" {
            arity(args, if n == "variant_of" { 1 } else { 3 }, n, span)?
            let bv = self.expr(&fb, args[0], None)?
            let bv = self.auto_deref(&fb, bv, span)?
            let t = bv.ty
            let vs = match self.types.variants(t) {
                Some(vs) => vs.clone()
                None => return Err(Diag.new(args[0].span, ("`" + n + "` takes an enum, not `" + self.types.show(t).as_str() + "`").as_str()))
            }
            let temp = bv.temp
            let (p, _) = self.as_place(&fb, bv, span)
            let d = fb.temp(types.I64, span)
            fb.assign(Place.local(d), Rvalue.Discriminant(p.clone()), span)
            if n == "variant_of" {
                return Ok(Some(body.val_op(Operand.Copy(Place.local(d)), types.I64)))
            }
            // The payload of variant `v`, which the value must be.
            let ts = self.types.show(t)
            let v = self.reflect_index(args[1], env, vs.len(), "variant", ts.as_str())?
            let what = "field in variant `" + vs[v].name.as_str() + "`, field"
            let j = self.reflect_index(args[2], env, vs[v].fields.len(), what.as_str(), ts.as_str())?
            let c = fb.temp(types.BOOL, span)
            fb.assign(Place.local(c), Rvalue.Bin(lex.Op.Eq, Operand.Copy(Place.local(d)), Operand.Const(Const.Int(v as i128, types.I64))), span)
            let next = fb.new_block()
            fb.term(Term.Assert(Operand.Copy(Place.local(c)), String.from("`variant_field` of another variant"), next, span))
            fb.switch_to(next)
            let fp = p.with(Proj.Variant(v as u32)).with(Proj.Field(j as u32))
            return Ok(Some(Val { vk: VK.Place(fp), ty: vs[v].fields[j], temp: temp }))
        }
        if n == "make" || n == "make_variant" {
            // A value from its parts: the closure's body, inlined once per
            // part with its parameter the part's index.
            let variant = n == "make_variant"
            arity(args, if variant { 3 } else { 2 }, n, span)?
            let t = self.expr_ty(args[0], env)?
            let ts = self.types.show(t)
            let f = args[args.len() - 1]
            let (pname, fbody) = match f.kind {
                Lambda(ps, _, b) => {
                    if ps.len() != 1 || ps[0].ty.is_some() {
                        return Err(Diag.new(f.span, ("the last argument of `" + n + "` is a closure with one untyped parameter, the part's index: `fn(i) { ... }`").as_str()))
                    }
                    (ps[0].name.clone(), b.clone())
                }
                _ => return Err(Diag.new(f.span, ("the last argument of `" + n + "` is a closure written there: `fn(i) { ... }`").as_str()))
            }
            var parts = Vec(u32).new()
            var agg = mir.Agg.Struct(t)
            if variant {
                let vs = match self.types.variants(t) {
                    Some(vs) => vs.clone()
                    None => return Err(Diag.new(args[0].span, ("`make_variant` takes an enum type, not `" + ts.as_str() + "`").as_str()))
                }
                let v = self.reflect_index(args[1], env, vs.len(), "variant", ts.as_str())?
                parts = vs[v].fields.clone()
                agg = mir.Agg.Variant(t, v as u32)
            } else {
                var ok = false
                match self.types.adt_index(t) {
                    Some(a) => match self.types.adts[a as i64].body {
                        Struct(fs) => {
                            for fd in fs {
                                if !fd.public && !self.reflect_private_ok(fb, a) {
                                    return Err(self.private_field_err(a, fd.name.as_str(), span))
                                }
                                parts.push(fd.ty)
                            }
                            ok = true
                        }
                        _ => {}
                    }
                    None => match self.types.kind(t) {
                        Tuple(tys) => {
                            parts = tys.clone()
                            ok = true
                        }
                        _ => {}
                    }
                }
                if !ok {
                    return Err(Diag.new(args[0].span, ("`make` takes a struct or tuple type, not `" + ts.as_str() + "`").as_str()))
                }
            }
            if fb.lookup(pname.as_str()).is_some() {
                return Err(Diag.new(f.span, ("`" + pname.as_str() + "` is already a variable here; name the index differently").as_str()))
            }
            let mark = fb.env.names.len()
            var ops = Vec(Operand).new()
            for i, pt in parts {
                fb.env.push(pname.as_str(), CVal.Int(i as i128))
                let r = self.reflect_part(&fb, fbody, pt)
                fb.env.names.truncate(mark)
                ops.push(r?)
            }
            return Ok(Some(self.rvalue(&fb, Rvalue.Aggregate(agg, ops), t, span)))
        }
        Ok(None)
    }

    fn reflect_part(inout self, inout fb: Fb, b: ast.Block, t: u32) -> Result(Operand, Diag) {
        let v = self.block(&fb, b, Some(t), true)?
        let v = self.coerce(&fb, v, t, b.span)?
        self.operand(&fb, v, b.span)
    }
}
