// Built-in functions: what the compiler itself must provide. Everything
// else is library code. The Rust compiler's `sema/builtins.rs`.

import ast
import body
import diag
import mir
import sema
import types

type Diag = diag.Diag
type Span = diag.Span
type Fb = body.Fb
type Val = body.Val
type TyKind = types.TyKind
type Place = mir.Place
type Operand = mir.Operand
type Rvalue = mir.Rvalue
type Const = mir.Const
type Callee = mir.Callee
type Intrinsic = mir.Intrinsic

fn need_unsafe(fb: Fb, n: str, span: Span) -> Result((), Diag) {
    if fb.unsafe_depth == 0 {
        return Err(Diag.new(span, ("`" + n + "` is only allowed in `unsafe` code").as_str()))
    }
    Ok(())
}

fn arity(args: Vec(ast.Expr), k: i64, n: str, span: Span) -> Result((), Diag) {
    if args.len() != k {
        var m = "`" + n + "` takes "
        k.show(&m)
        m.push_str(" argument(s), ")
        args.len().show(&m)
        m.push_str(" given")
        return Err(Diag.new(span, m.as_str()))
    }
    Ok(())
}

fn no_ops() -> Vec(Operand) {
    Vec(Operand).new()
}

fn ops1(sink a: Operand) -> Vec(Operand) {
    var v = Vec(Operand).new()
    v.push(a)
    v
}

fn ops2(sink a: Operand, sink b: Operand) -> Vec(Operand) {
    var v = ops1(a)
    v.push(b)
    v
}

fn ops3(sink a: Operand, sink b: Operand, sink c: Operand) -> Vec(Operand) {
    var v = ops2(a, b)
    v.push(c)
    v
}

impl sema.Sema {
    // The pointee of a raw pointer type.
    fn raw_pointee(self, t: u32) -> Option(u32) {
        if self.types.is_ptr(t) { self.types.pointee(t) } else { None }
    }

    // `exp` if it is a float type.
    fn float_exp(self, exp: Option(u32)) -> Option(u32) {
        match exp {
            Some(t) => if self.types.is_float(t) { Some(t) } else { None }
            None => None
        }
    }

    pub fn builtin_call(inout self, inout fb: Fb, n: str, args: Vec(ast.Expr), exp: Option(u32), span: Span) -> Result(Option(Val), Diag) {
        let env = fb.env.clone()
        if n == "size_of" || n == "align_of" {
            arity(args, 1, n, span)?
            let t = self.expr_ty(args[0], env)?
            let l = self.types.layout(t)
            var rt = types.I64
            match exp {
                Some(x) => if self.types.is_int(x) { rt = x }
                None => {}
            }
            let v = if n == "size_of" { l.size } else { l.align }
            return Ok(Some(body.val_op(Operand.Const(Const.Int(v as i128, rt)), rt)))
        }
        if n == "type_name" {
            arity(args, 1, n, span)?
            let t = self.expr_ty(args[0], env)?
            let s = self.types.show(t)
            self.view_ty(TyKind.Str)
            return Ok(Some(body.val_op(Operand.Const(Const.Str(s)), types.STR)))
        }
        if n == "needs_drop" {
            arity(args, 1, n, span)?
            let t = self.expr_ty(args[0], env)?
            let b = self.types.needs_drop(t)
            return Ok(Some(body.val_op(Operand.Const(Const.Bool(b)), types.BOOL)))
        }
        if n == "trap" {
            arity(args, 0, n, span)?
            return Ok(Some(self.emit_call(&fb, Callee.Intrinsic(Intrinsic.Trap), no_ops(), types.NEVER, span)?))
        }
        if n == "syscall" {
            need_unsafe(fb, n, span)?
            if args.len() == 0 || args.len() > 7 {
                return Err(Diag.new(span, "`syscall` takes the number and up to 6 arguments"))
            }
            var ops = Vec(Operand).new()
            for a in args {
                let v = self.expr(&fb, a, Some(types.I64))?
                let ok = match self.types.kind(v.ty) {
                    Int(_) | Ptr(_) | Bool => true
                    _ => false
                }
                if !ok {
                    return Err(Diag.new(a.span, "`syscall` arguments are integers and pointers"))
                }
                let t = v.ty
                let o = self.operand(&fb, v, a.span)?
                if t == types.I64 {
                    ops.push(o)
                } else {
                    let c = self.rvalue(&fb, Rvalue.Cast(o, types.I64, mir.CastKind.Numeric), types.I64, a.span)
                    ops.push(Operand.Copy(self.place_of_val(c)))
                }
            }
            return Ok(Some(self.emit_call(&fb, Callee.Intrinsic(Intrinsic.Syscall), ops, types.I64, span)?))
        }
        if n == "mem_copy" {
            // mem_copy(dst: *T, src: *T, n: i64): copies n elements.
            need_unsafe(fb, n, span)?
            arity(args, 3, n, span)?
            let d = self.expr(&fb, args[0], None)?
            let et = match self.raw_pointee(d.ty) {
                Some(t) => t
                None => return Err(Diag.new(args[0].span, "`mem_copy` copies between pointers"))
            }
            let dt = d.ty
            let s = self.expr(&fb, args[1], Some(dt))?
            let s = self.coerce(&fb, s, dt, args[1].span)?
            let c = self.expr(&fb, args[2], Some(types.I64))?
            let c = self.coerce(&fb, c, types.I64, args[2].span)?
            let o1 = self.operand(&fb, d, span)?
            let o2 = self.operand(&fb, s, span)?
            let o3 = self.operand(&fb, c, span)?
            return Ok(Some(self.emit_call(&fb, Callee.Intrinsic(Intrinsic.Copy(et)), ops3(o1, o2, o3), types.UNIT, span)?))
        }
        if n == "mem_fill" {
            need_unsafe(fb, n, span)?
            arity(args, 3, n, span)?
            let pu8 = self.types.ptr(types.U8)
            var d = self.expr(&fb, args[0], Some(pu8))?
            if self.types.is_ptr(d.ty) && d.ty != pu8 {
                let o = self.operand(&fb, d, span)?
                d = self.rvalue(&fb, Rvalue.Cast(o, pu8, mir.CastKind.Ptr), pu8, span)
            } else {
                d = self.coerce(&fb, d, pu8, args[0].span)?
            }
            let b = self.expr(&fb, args[1], Some(types.U8))?
            let b = self.coerce(&fb, b, types.U8, args[1].span)?
            let c = self.expr(&fb, args[2], Some(types.I64))?
            let c = self.coerce(&fb, c, types.I64, args[2].span)?
            let o1 = self.operand(&fb, d, span)?
            let o2 = self.operand(&fb, b, span)?
            let o3 = self.operand(&fb, c, span)?
            return Ok(Some(self.emit_call(&fb, Callee.Intrinsic(Intrinsic.Fill), ops3(o1, o2, o3), types.UNIT, span)?))
        }
        if n == "read" {
            // read(p: *T) -> T: the value at p, which the caller now owns.
            need_unsafe(fb, n, span)?
            arity(args, 1, n, span)?
            let p = self.expr(&fb, args[0], None)?
            let et = match self.raw_pointee(p.ty) {
                Some(t) => t
                None => return Err(Diag.new(args[0].span, "`read` reads through a pointer"))
            }
            let o = self.operand(&fb, p, span)?
            let pet = self.types.ptr(et)
            let pl = self.operand_local(&fb, o, pet, span)
            return Ok(Some(self.rvalue(&fb, Rvalue.Use(Operand.Copy(Place.deref(pl))), et, span)))
        }
        if n == "write" {
            // write(p: *T, v: T): stores v at p without dropping what was there.
            need_unsafe(fb, n, span)?
            arity(args, 2, n, span)?
            let p = self.expr(&fb, args[0], None)?
            let et = match self.raw_pointee(p.ty) {
                Some(t) => t
                None => return Err(Diag.new(args[0].span, "`write` writes through a pointer"))
            }
            let o = self.operand(&fb, p, span)?
            let pt = self.types.ptr(et)
            let pl = self.operand_local(&fb, o, pt, span)
            let v = self.expr(&fb, args[1], Some(et))?
            let v = self.coerce(&fb, v, et, args[1].span)?
            let vo = self.operand(&fb, v, args[1].span)?
            fb.assign(Place.deref(pl), Rvalue.Use(vo), span)
            return Ok(Some(body.val_unit()))
        }
        if n == "forget" {
            // forget(v): v's destructor does not run.
            arity(args, 1, n, span)?
            let v = self.expr(&fb, args[0], None)?
            let t = v.ty
            let o = self.operand(&fb, v, span)?
            let tmp = fb.temp(t, span)
            fb.assign(Place.local(tmp), Rvalue.Use(o), span)
            fb.push(mir.Stmt.Forget(tmp))
            return Ok(Some(body.val_unit()))
        }
        if n == "make_slice" || n == "make_str" {
            // make_slice(p: *T, n: i64) -> [T]: a view of n elements at p.
            need_unsafe(fb, n, span)?
            arity(args, 2, n, span)?
            let is_str = n == "make_str"
            let pu8 = self.types.ptr(types.U8)
            let p = self.expr(&fb, args[0], if is_str { Some(pu8) } else { None })?
            let et = match self.raw_pointee(p.ty) {
                Some(t) => t
                None => return Err(Diag.new(args[0].span, "expected a pointer"))
            }
            if is_str && et != types.U8 {
                return Err(Diag.new(args[0].span, "`make_str` takes a `*u8`"))
            }
            let c = self.expr(&fb, args[1], Some(types.I64))?
            let c = self.coerce(&fb, c, types.I64, args[1].span)?
            let vt = if is_str { self.view_ty(TyKind.Str) } else { self.view_ty(TyKind.Slice(et)) }
            let o1 = self.operand(&fb, p, span)?
            let o2 = self.operand(&fb, c, span)?
            return Ok(Some(self.rvalue(&fb, Rvalue.Aggregate(mir.Agg.View(vt), ops2(o1, o2)), vt, span)))
        }
        if n == "zeroed" {
            need_unsafe(fb, n, span)?
            arity(args, 1, n, span)?
            let t = self.expr_ty(args[0], env)?
            return Ok(Some(body.val_op(Operand.Const(Const.Zeroed(t)), t)))
        }
        if n == "sqrt" || n == "floor" || n == "ceil" || n == "trunc" || n == "round" || n == "abs" {
            arity(args, 1, n, span)?
            let v = self.expr(&fb, args[0], self.float_exp(exp))?
            let t = v.ty
            if !self.types.is_float(t) {
                var signed = false
                match self.types.int(t) {
                    Some(i) => signed = i.signed
                    None => {}
                }
                if n == "abs" && signed {
                    let o = self.operand(&fb, v, span)?
                    return Ok(Some(self.emit_call(&fb, Callee.Intrinsic(Intrinsic.Abs(t)), ops1(o), t, span)?))
                }
                return Err(Diag.new(args[0].span, ("`" + n + "` takes a float").as_str()))
            }
            let o = self.operand(&fb, v, span)?
            let i = if n == "sqrt" {
                Intrinsic.Sqrt(t)
            } else if n == "floor" {
                Intrinsic.Floor(t)
            } else if n == "ceil" {
                Intrinsic.Ceil(t)
            } else if n == "trunc" {
                Intrinsic.Trunc(t)
            } else if n == "round" {
                Intrinsic.Round(t)
            } else {
                Intrinsic.Abs(t)
            }
            return Ok(Some(self.emit_call(&fb, Callee.Intrinsic(i), ops1(o), t, span)?))
        }
        if n == "copysign" {
            arity(args, 2, n, span)?
            let a = self.expr(&fb, args[0], self.float_exp(exp))?
            let t = a.ty
            if !self.types.is_float(t) {
                return Err(Diag.new(args[0].span, "`copysign` takes floats"))
            }
            let b = self.expr(&fb, args[1], Some(t))?
            let b = self.coerce(&fb, b, t, args[1].span)?
            let o1 = self.operand(&fb, a, span)?
            let o2 = self.operand(&fb, b, span)?
            return Ok(Some(self.emit_call(&fb, Callee.Intrinsic(Intrinsic.Copysign(t)), ops2(o1, o2), t, span)?))
        }
        if n == "argc" {
            arity(args, 0, n, span)?
            return Ok(Some(self.emit_call(&fb, Callee.Intrinsic(Intrinsic.Argc), no_ops(), types.I64, span)?))
        }
        if n == "argv" {
            arity(args, 0, n, span)?
            let pu8 = self.types.ptr(types.U8)
            let ppu8 = self.types.ptr(pu8)
            return Ok(Some(self.emit_call(&fb, Callee.Intrinsic(Intrinsic.Argv), no_ops(), ppu8, span)?))
        }
        if n == "atomic_load" || n == "atomic_store" || n == "atomic_swap" || n == "atomic_add" || n == "atomic_sub" || n == "atomic_and" || n == "atomic_or" || n == "atomic_xor" || n == "atomic_cas" {
            need_unsafe(fb, n, span)?
            if args.len() == 0 {
                return Err(Diag.new(span, "missing pointer"))
            }
            let p = self.expr(&fb, args[0], None)?
            let et = match self.raw_pointee(p.ty) {
                Some(t) => t
                None => return Err(Diag.new(args[0].span, "atomics work through a pointer"))
            }
            if !self.types.is_int(et) && !self.types.is_ptr(et) && et != types.BOOL {
                return Err(Diag.new(args[0].span, "atomics work on integers, bools and pointers"))
            }
            var ops = ops1(self.operand(&fb, p, span)?)
            let want = if n == "atomic_load" { 1 } else if n == "atomic_cas" { 3 } else { 2 }
            arity(args, want, n, span)?
            for i in 1..args.len() {
                let a = args[i]
                let v = self.expr(&fb, a, Some(et))?
                let v = self.coerce(&fb, v, et, a.span)?
                ops.push(self.operand(&fb, v, a.span)?)
            }
            var rt = et
            var i = Intrinsic.Fence
            if n == "atomic_load" {
                i = Intrinsic.AtomicLoad(et)
            } else if n == "atomic_store" {
                i = Intrinsic.AtomicStore(et)
                rt = types.UNIT
            } else if n == "atomic_cas" {
                i = Intrinsic.AtomicCas(et)
                rt = types.BOOL
            } else {
                i = Intrinsic.AtomicRmw(String.from(n[7..]), et)
            }
            return Ok(Some(self.emit_call(&fb, Callee.Intrinsic(i), ops, rt, span)?))
        }
        if n == "fence" {
            arity(args, 0, n, span)?
            return Ok(Some(self.emit_call(&fb, Callee.Intrinsic(Intrinsic.Fence), no_ops(), types.UNIT, span)?))
        }
        Ok(None)
    }
}
