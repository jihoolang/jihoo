// Lowering function bodies to MIR, checking types on the way: the Rust
// compiler's `sema/body.rs`.

import std.mem
import fmt
import check
import elab
import interp
import ast
import diag
import lex
import mir
import pat
import sema
import types

type Diag = diag.Diag
type Span = diag.Span
type Op = lex.Op
type Sema = sema.Sema
type Env = sema.Env
type CVal = sema.CVal
type TyKind = types.TyKind
type Place = mir.Place
type Proj = mir.Proj
type Operand = mir.Operand
type Rvalue = mir.Rvalue
type Const = mir.Const
type Stmt = mir.Stmt
type Term = mir.Term
type LocalKind = mir.LocalKind
type BindMode = pat.BindMode

pub enum VarKind {
    // The local holds the value.
    Owned
    // The local holds a borrow; the variable is what it points to.
    Borrow
    // A closure's captured variable: field `i` of its environment.
    Capture(u32)
}

pub struct Var {
    pub local: u32
    pub kind: VarKind
}

struct ScopeVar {
    name: String
    v: Var
}

pub struct Scope {
    vars: Vec(ScopeVar)
    // Locals to drop and end, in the order they were made.
    locals: Vec(u32)
    // A statement's temporaries (not a block).
    temp: bool
}

struct LoopCtx {
    brk: u32
    cont: u32
    depth: i64
}

pub struct Fb {
    pub id: u32
    pub body: mir.Body
    pub cur: u32
    scopes: Vec(Scope)
    loops: Vec(LoopCtx)
    pub env: Env
    pub ret_mode: ast.RetMode
    pub unsafe_depth: u32
    // The environment parameter of a closure body.
    pub env_local: Option(u32)
    // The next block's value stays a place (the body of a function that
    // returns `ref` or `inout`).
    pub keep_place: bool
    // The place being lowered will be changed: indexing and `deref` take
    // their mutable forms.
    pub want_mut: bool
    // A `dyn fn` body: its environment holds the captured values
    // themselves, not borrows of them.
    pub owned_env: bool
    // Scope parameters are joined before the function body's locals die.
    // Parameter, finish function, and the registry length on entry.
    thread_scopes: Vec((u32, u32, u32))
    // The next lambda transfers its capture tuple to a scoped job.
    scoped_work: bool
}

// The result of lowering an expression: a place to read or borrow, or an
// operand already computed.
pub enum VK {
    Place(Place)
    Op(Operand)
}

impl Clone for VK {
    fn clone(self) -> VK {
        match self {
            Place(p) => VK.Place(p.clone())
            Op(o) => VK.Op(o.clone())
        }
    }
}

pub struct Val {
    pub vk: VK
    pub ty: u32
    // A temporary holding a new value: it may be moved out of freely.
    pub temp: bool
}

impl Clone for Val {
    fn clone(self) -> Val {
        Val { vk: self.vk.clone(), ty: self.ty, temp: self.temp }
    }
}

pub fn val_op(sink o: Operand, ty: u32) -> Val {
    Val { vk: VK.Op(o), ty: ty, temp: false }
}

pub fn val_place(sink p: Place, ty: u32) -> Val {
    Val { vk: VK.Place(p), ty: ty, temp: false }
}

pub fn val_unit() -> Val {
    val_op(Operand.Const(Const.Zst(types.UNIT)), types.UNIT)
}

pub fn val_never() -> Val {
    val_op(Operand.Const(Const.Zst(types.NEVER)), types.NEVER)
}

fn copy_of(l: u32) -> Operand {
    Operand.Copy(Place.local(l))
}

fn int_const(v: i128, t: u32) -> Operand {
    Operand.Const(Const.Int(v, t))
}

// `[(v, b)]`: one target of a switch.
fn switch1(v: i128, b: u32) -> Vec(mir.SwitchTarget) {
    var ts = Vec(mir.SwitchTarget).new()
    ts.push(mir.SwitchTarget { value: v, block: b })
    ts
}

fn err(span: Span, msg: str) -> Diag {
    Diag.new(span, msg)
}

fn is_ret_value(m: ast.RetMode) -> bool {
    match m {
        Value => true
        _ => false
    }
}

impl Fb {
    pub fn new(id: u32, sink env: Env, ret: u32, ret_mode: ast.RetMode, span: Span) -> Fb {
        var fb = Fb {
            id: id
            body: mir.Body { locals: Vec(mir.LocalDecl).new(), blocks: Vec(mir.Block).new(), arg_count: 0 }
            cur: 0
            scopes: Vec(Scope).new()
            loops: Vec(LoopCtx).new()
            env: env
            ret_mode: ret_mode
            unsafe_depth: 0
            env_local: None
            keep_place: false
            want_mut: false
            owned_env: false
            thread_scopes: Vec((u32, u32, u32)).new()
            scoped_work: false
        }
        fb.new_local(ret, None, true, LocalKind.Ret, span)
        fb.cur = fb.new_block()
        fb.scopes.push(Scope { vars: Vec(ScopeVar).new(), locals: Vec(u32).new(), temp: false })
        fb
    }

    pub fn new_local(inout self, ty: u32, sink name: Option(String), mutable: bool, kind: LocalKind, span: Span) -> u32 {
        self.body.locals.push(mir.LocalDecl { ty: ty, name: name, span: span, mutable: mutable, kind: kind })
        (self.body.locals.len() - 1) as u32
    }

    pub fn new_block(inout self) -> u32 {
        self.body.blocks.push(mir.Block { stmts: Vec(Stmt).new(), term: Term.Pending })
        (self.body.blocks.len() - 1) as u32
    }

    pub fn push(inout self, sink s: Stmt) {
        let c = self.cur as i64
        self.body.blocks[c].stmts.push(s)
    }

    pub fn assign(inout self, sink p: Place, sink r: Rvalue, span: Span) {
        self.push(Stmt.Assign(p, r, span))
    }

    // Ends the current block; code after it goes in a new (unreachable
    // until something jumps there) block.
    pub fn term(inout self, sink t: Term) {
        let c = self.cur as i64
        let pending = match self.body.blocks[c].term {
            Pending => true
            _ => false
        }
        if pending {
            self.body.blocks[c].term = t
        }
        self.cur = self.new_block()
    }

    pub fn goto(inout self, b: u32) {
        self.term(Term.Goto(b))
        self.cur = b
    }

    pub fn switch_to(inout self, b: u32) {
        self.cur = b
    }

    pub fn ty_of(self, l: u32) -> u32 {
        self.body.locals[l as i64].ty
    }

    // A temporary that lives until the end of the current statement.
    pub fn temp(inout self, ty: u32, span: Span) -> u32 {
        let l = self.new_local(ty, None, true, LocalKind.Temp, span)
        self.push(Stmt.StorageLive(l))
        let n = self.scopes.len()
        self.scopes[n - 1].locals.push(l)
        l
    }

    fn last_block_scope(self) -> i64 {
        var i = self.scopes.len() - 1
        while self.scopes[i].temp {
            i -= 1
        }
        i
    }

    // A temporary that lives until the end of the enclosing block.
    pub fn block_temp(inout self, ty: u32, span: Span) -> u32 {
        let l = self.new_local(ty, None, true, LocalKind.Temp, span)
        self.push(Stmt.StorageLive(l))
        let i = self.last_block_scope()
        self.scopes[i].locals.push(l)
        l
    }

    pub fn declare(inout self, name: str, ty: u32, mutable: bool, kind: VarKind, span: Span) -> u32 {
        let borrow = match kind {
            Borrow => true
            _ => false
        }
        let k = if borrow { false } else { mutable }
        let l = self.new_local(ty, Some(name.to_string()), k, LocalKind.Var, span)
        self.push(Stmt.StorageLive(l))
        let i = self.last_block_scope()
        self.scopes[i].locals.push(l)
        self.scopes[i].vars.push(ScopeVar { name: name.to_string(), v: Var { local: l, kind: kind } })
        l
    }

    pub fn bind_var(inout self, name: str, v: Var) {
        let i = self.last_block_scope()
        self.scopes[i].vars.push(ScopeVar { name: name.to_string(), v: v })
    }

    pub fn lookup(self, name: str) -> Option(Var) {
        var i = self.scopes.len()
        while i > 0 {
            i -= 1
            var j = self.scopes[i].vars.len()
            while j > 0 {
                j -= 1
                if self.scopes[i].vars[j].name == name {
                    return Some(self.scopes[i].vars[j].v)
                }
            }
        }
        None
    }

    pub fn push_scope(inout self, temp: bool) {
        self.scopes.push(Scope { vars: Vec(ScopeVar).new(), locals: Vec(u32).new(), temp: temp })
    }

    // A local of the current scope, live from here.
    fn scope_local(inout self, ty: u32, mutable: bool, span: Span) -> u32 {
        let l = self.new_local(ty, None, mutable, LocalKind.Temp, span)
        self.push(Stmt.StorageLive(l))
        let n = self.scopes.len()
        self.scopes[n - 1].locals.push(l)
        l
    }

    pub fn depth(self) -> i64 {
        self.scopes.len()
    }

    pub fn own_param(inout self, l: u32) {
        self.scopes[0].locals.push(l)
    }

    // Registers a local made earlier as a temporary of the current scope.
    pub fn add_temp_local(inout self, l: u32) {
        let c = self.cur as i64
        self.body.blocks[c].stmts.push(Stmt.StorageLive(l))
        let n = self.scopes.len()
        self.scopes[n - 1].locals.push(l)
    }
}

impl sema.Sema {
    // The place a variable stands for.
    pub fn var_place(self, fb: Fb, v: Var) -> Place {
        match v.kind {
            Owned => Place.local(v.local)
            Borrow => Place.deref(v.local)
            Capture(i) => {
                var p = Place.local(fb.env_local.unwrap())
                p.proj.push(Proj.Deref)
                p.proj.push(Proj.Field(i))
                if !fb.owned_env {
                    p.proj.push(Proj.Deref)
                }
                p
            }
        }
    }

    // The type of a place.
    pub fn place_ty(self, fb: Fb, p: Place) -> u32 {
        var t = fb.ty_of(p.local)
        var variant: Option(u32) = None
        for pr in p.proj {
            match pr {
                Deref => t = self.types.pointee(t).expect("deref of a non-pointer")
                Variant(v) => variant = Some(v)
                Field(i) => {
                    match variant {
                        Some(v) => {
                            t = self.types.variants(t).unwrap()[v as i64].fields[i as i64]
                            variant = None
                        }
                        None => {
                            match self.types.kind(t) {
                                Slice(e) => {
                                    if i == 0 {
                                        return self.types_ptr_lookup(e)
                                    }
                                    t = types.I64
                                }
                                Str => {
                                    if i == 0 {
                                        return self.types_ptr_lookup(types.U8)
                                    }
                                    t = types.I64
                                }
                                _ => t = self.types.field_tys(t)[i as i64]
                            }
                        }
                    }
                }
                Index(_) => match self.types.kind(t) {
                    Array(e, _) => t = e
                    _ => panic("index of a non-array")
                }
            }
        }
        t
    }

    fn types_ptr_lookup(self, e: u32) -> u32 {
        // Pointer types of views' elements are interned when the view type
        // is made (see `view_ty`).
        for i, k in self.types.kinds {
            match k {
                Ptr(x) => {
                    if x == e {
                        return i as u32
                    }
                }
                _ => {}
            }
        }
        panic("pointer type interned")
    }

    pub fn view_ty(inout self, sink k: TyKind) -> u32 {
        match k.clone() {
            Slice(e) => {
                self.types.ptr(e)
            }
            Str => {
                self.types.ptr(types.U8)
            }
            _ => 0
        }
        self.types.intern(k)
    }

    pub fn place_mutable(self, fb: Fb, p: Place) -> bool {
        var m = fb.body.locals[p.local as i64].mutable
        var t = fb.ty_of(p.local)
        var variant: Option(u32) = None
        for pr in p.proj {
            match pr {
                Deref => {
                    m = match self.types.kind(t) {
                        RefMut(_) | Ptr(_) => true
                        _ => false
                    }
                    t = self.types.pointee(t).unwrap()
                }
                Variant(v) => variant = Some(v)
                Field(i) => {
                    match variant {
                        Some(v) => {
                            t = self.types.variants(t).unwrap()[v as i64].fields[i as i64]
                            variant = None
                        }
                        None => match self.types.kind(t) {
                            Slice(_) | Str => return false
                            _ => t = self.types.field_tys(t)[i as i64]
                        }
                    }
                }
                Index(_) => match self.types.kind(t) {
                    Array(e, _) => t = e
                    _ => {}
                }
            }
        }
        m
    }

    // Why a value cannot be moved out of the place (an owned local or its
    // fields can), or `None`.
    pub fn place_movable(self, fb: Fb, p: Place) -> Option(str) {
        for x in p.proj {
            match x {
                Deref => return Some("it is borrowed")
                _ => {}
            }
        }
        for x in p.proj {
            match x {
                Index(_) => return Some("it is an element of an array")
                _ => {}
            }
        }
        if p.proj.len() > 0 {
            return Some("it is part of another value")
        }
        if fb.body.locals[p.local as i64].kind == LocalKind.Arg && self.types.is_ref(fb.ty_of(p.local)) {
            return Some("it is borrowed")
        }
        None
    }

    // ---- scopes ----

    fn emit_scope_exit(inout self, inout fb: Fb, idx: i64) {
        // The function body is inside the root and return-expression scopes.
        // Join before ending closure environments or dropping captured locals,
        // including on early returns. Forget ends the retained loans as well.
        if idx == 2 {
            for (local, finish, checkpoint) in fb.thread_scopes.clone() {
                let span = fb.body.locals[local as i64].span
                var args = Vec(Operand).new()
                args.push(copy_of(local))
                args.push(copy_of(checkpoint))
                let dest = fb.new_local(types.UNIT, None, true, LocalKind.Temp, span)
                let next = fb.new_block()
                fb.term(Term.Call(mir.Callee.Fn(finish), args, Place.local(dest), next, span))
                fb.switch_to(next)
                fb.push(Stmt.Forget(local))
            }
        }
        let locals = fb.scopes[idx].locals.clone()
        var i = locals.len()
        while i > 0 {
            i -= 1
            let l = locals[i]
            let t = fb.ty_of(l)
            if self.types.needs_drop(t) {
                let sp = fb.body.locals[l as i64].span
                fb.push(Stmt.Drop(Place.local(l), sp))
            }
            fb.push(Stmt.StorageDead(l))
        }
    }

    pub fn pop_scope(inout self, inout fb: Fb) {
        let i = fb.scopes.len() - 1
        self.emit_scope_exit(&fb, i)
        fb.scopes.pop()
    }

    // Drops everything in scopes deeper than `depth` (for `break`,
    // `return`), without leaving them.
    fn exit_to(inout self, inout fb: Fb, depth: i64) {
        var i = fb.scopes.len()
        while i > depth {
            i -= 1
            self.emit_scope_exit(&fb, i)
        }
    }

    // ---- functions ----

    pub fn lower_fn(inout self, id: u32, decl: u32, sink env: Env) -> Result((), Diag) {
        let d = sema.at(self.fns[decl as i64].decl)
        let sig = self.out[id as i64].sig.clone()
        let pass = self.out[id as i64].pass.clone()
        var fb = Fb.new(id, env.clone(), sig.ret, d.ret_mode, d.name_span)
        if d.is_unsafe {
            fb.unsafe_depth = 1
        }
        var pi = 0
        var lambdas = Vec(sema.ComptimeClosure).new()
        for p in d.params {
            if p.mode == ast.Mode.Comptime {
                match env.get(p.name.as_str()) {
                    Some(Lambda(lf, _)) => {
                        let l = fb.new_local(sig.params[pi], Some(p.name.clone()), false, LocalKind.Arg, p.span)
                        fb.bind_var(p.name.as_str(), Var { local: l, kind: VarKind.Owned })
                        lambdas.push(sema.ComptimeClosure { id: id, place: Place.local(l), lambda: lf, specialized: true })
                        pi += 1
                    }
                    _ => {}
                }
                continue
            }
            let t = sig.params[pi]
            let borrow = pass[pi] == mir.ParamPass.Borrow
            let kind = if borrow { VarKind.Borrow } else { VarKind.Owned }
            let mutable = p.mode == ast.Mode.Sink
            let l = fb.new_local(t, Some(p.name.clone()), mutable, LocalKind.Arg, p.span)
            fb.bind_var(p.name.as_str(), Var { local: l, kind: kind })
            // An owned parameter is dropped when the function ends.
            if !borrow {
                fb.own_param(l)
            }
            pi += 1
        }
        fb.body.arg_count = pi
        for c in lambdas.into_iter() {
            self.comptime_closures.push(c)
        }
        let ret_val_ty = if is_ret_value(d.ret_mode) { sig.ret } else { self.types.pointee(sig.ret).unwrap() }
        match d.body {
            Some(body) => self.lower_body(&fb, body, ret_val_ty)?
            None => {}
        }
        self.clear_closures(id)
        match fb {
            Fb { body, .. } => self.out[id as i64].body = Some(body)
        }
        Ok(())
    }

    fn prepare_thread_scopes(inout self, inout fb: Fb, span: Span) -> Result((), Diag) {
        // Scope's implementation manages the registry itself. User functions
        // borrowing it must join before their stack frames can disappear.
        if fb.thread_scopes.len() == 0 && self.module_name(fb.env.module) != "std.thread" {
            for i in 1..fb.body.arg_count + 1 {
                match self.types.kind(fb.body.locals[i].ty) {
                    RefMut(t) => match self.types.adt_index(t) {
                        Some(a) => {
                            let d = self.adts[self.types.adts[a as i64].decl as i64]
                            if d.name == "Scope" && self.module_name(d.module) == "std.thread" {
                                let h = self.find_method(t, "finish")?.unwrap()
                                let finish = self.instance(h.imp, h.args.clone(), span)?
                                let h = self.find_method(t, "checkpoint")?.unwrap()
                                let checkpoint = self.instance(h.imp, h.args.clone(), span)?
                                var args = Vec(Operand).new()
                                args.push(copy_of(i as u32))
                                let v = self.emit_call(&fb, mir.Callee.Fn(checkpoint), args, types.I64, span)?
                                let local = self.place_of_val(v).local
                                fb.thread_scopes.push((i as u32, finish, local))
                            }
                        }
                        None => {}
                    }
                    _ => {}
                }
            }
        }
        Ok(())
    }

    // The function's block, its value going to the return place.
    fn lower_body(inout self, inout fb: Fb, body: ast.Block, ret_ty: u32) -> Result((), Diag) {
        self.prepare_thread_scopes(&fb, body.span)?
        fb.push_scope(true)
        fb.keep_place = !is_ret_value(fb.ret_mode)
        let v = self.block(&fb, body, Some(ret_ty), true)?
        if v.ty != types.NEVER {
            let sp = match body.tail {
                Some(t) => t.span
                None => body.span
            }
            self.write_return(&fb, v, ret_ty, sp)?
        }
        self.exit_to(&fb, 0)
        fb.term(Term.Return)
        Ok(())
    }

    fn write_return(inout self, inout fb: Fb, sink v: Val, ret_ty: u32, span: Span) -> Result((), Diag) {
        if is_ret_value(fb.ret_mode) {
            let v = self.coerce(&fb, v, ret_ty, span)?
            let o = self.operand(&fb, v, span)?
            fb.assign(Place.local(mir.RET), Rvalue.Use(o), span)
            return Ok(())
        }
        if v.ty != ret_ty {
            return Err(err(span, self.expected_found(ret_ty, v.ty).as_str()))
        }
        let p = match v.vk.clone() {
            Place(p) => p
            Op(_) => return Err(err(span, "a function returning `ref` or `inout` returns a place, not a new value"))
        }
        if v.temp {
            return Err(err(span, "this returns a borrow of a temporary value"))
        }
        let inout_ret = match fb.ret_mode {
            Inout => true
            _ => false
        }
        if inout_ret {
            if !self.place_mutable(fb, p) {
                return Err(err(span, "this place cannot be changed, so it cannot be returned as `inout`"))
            }
            fb.assign(Place.local(mir.RET), Rvalue.RefMut(p), span)
        } else {
            fb.assign(Place.local(mir.RET), Rvalue.Ref(p), span)
        }
        Ok(())
    }

    // ---- blocks and statements ----

    // A block; `want` says whether its value is used.
    // Whether local `l` belongs to scope `from` or one inside it.
    fn local_in_scopes(self, fb: Fb, l: u32, from: i64) -> bool {
        for i in from..fb.scopes.len() {
            for x in fb.scopes[i].locals {
                if x == l {
                    return true
                }
            }
        }
        false
    }

    pub fn block(inout self, inout fb: Fb, b: ast.Block, exp: Option(u32), want: bool) -> Result(Val, Diag) {
        let keep_place = fb.keep_place
        fb.keep_place = false
        // A block expected to give `()` throws its last value away.
        let want = want && exp != Some(types.UNIT)
        let exp: Option(u32) = if want { exp } else { None }
        fb.push_scope(false)
        var diverged = false
        for s in b.stmts {
            fb.push_scope(true)
            let r = self.stmt(&fb, s)?
            self.pop_scope(&fb)
            if r {
                diverged = true
            }
        }
        var result = val_unit()
        match b.tail {
            Some(t) => {
                fb.push_scope(true)
                if keep_place {
                    // `unsafe { *p }` as a function's `ref` result.
                    match t.kind {
                        Unsafe(_) | Block(_) => fb.keep_place = true
                        _ => {}
                    }
                }
                let texp: Option(u32) = if want { exp } else { None }
                let v = self.expr(&fb, t.deref(), texp)?
                let is_place = match v.vk {
                    Place(_) => true
                    _ => false
                }
                if v.ty == types.NEVER {
                    result = val_never()
                } else if keep_place && is_place && !v.temp {
                    // The place may start at a pointer in a temporary of the
                    // block: keep that pointer in one that outlives it.
                    let p = match v.vk.clone() {
                        Place(p) => p
                        Op(_) => Place.local(0)
                    }
                    let root_kind = fb.body.locals[p.local as i64].kind
                    let rt = fb.body.locals[p.local as i64].ty
                    let through = p.proj.len() > 0 && p.proj[0] == Proj.Deref
                    // A temporary, or a variable of the block (`let p =
                    // ...; *p`); the pointer itself is what must live on.
                    let local_var = root_kind == LocalKind.Var && self.local_in_scopes(fb, p.local, fb.scopes.len() - 2)
                    if local_var && !through {
                        let name = match fb.body.locals[p.local as i64].name {
                            Some(n) => "`" + n.as_str() + "`"
                            None => String.from("a local value")
                        }
                        return Err(err(t.span, ("this would return a borrow of " + name.as_str() + ", which ends with the function; a `ref` or `inout` result must be a part of the first parameter, or what a pointer points to").as_str()))
                    }
                    if (root_kind == LocalKind.Temp || local_var) && through {
                        let n = fb.scopes.len()
                        let tmp = fb.new_local(rt, None, true, LocalKind.Temp, t.span)
                        fb.push(Stmt.StorageLive(tmp))
                        fb.scopes[n - 3].locals.push(tmp)
                        let o = if self.types.has_refmut(rt) { Operand.Move(Place.local(p.local)) } else { copy_of(p.local) }
                        fb.assign(Place.local(tmp), Rvalue.Use(o), t.span)
                        result = Val { vk: VK.Place(Place { local: tmp, proj: p.proj.clone() }), ty: v.ty, temp: false }
                    } else {
                        result = v
                    }
                } else if want && v.ty != types.UNIT {
                    let v = match exp {
                        Some(e) => self.coerce(&fb, v, e, t.span)?
                        None => v
                    }
                    // The value outlives the block's scopes: move it to the
                    // statement around the block.
                    let vt = v.ty
                    let o = self.operand(&fb, v, t.span)?
                    let n = fb.scopes.len()
                    let tmp = fb.new_local(vt, None, true, LocalKind.Temp, t.span)
                    fb.push(Stmt.StorageLive(tmp))
                    fb.scopes[n - 3].locals.push(tmp)
                    fb.assign(Place.local(tmp), Rvalue.Use(o), t.span)
                    result = Val { vk: VK.Place(Place.local(tmp)), ty: vt, temp: true }
                } else {
                    self.discard(&fb, v, t.span)?
                    result = val_unit()
                }
                self.pop_scope(&fb)
            }
            None => {
                if diverged {
                    result = val_never()
                }
            }
        }
        self.pop_scope(&fb)
        Ok(result)
    }

    // Evaluates and throws away a value (an expression statement).
    fn discard(inout self, inout fb: Fb, sink v: Val, span: Span) -> Result((), Diag) {
        match v.vk {
            Op(o) => match o {
                Move(_) => {
                    let t = fb.temp(v.ty, span)
                    fb.assign(Place.local(t), Rvalue.Use(o.clone()), span)
                }
                _ => {}
            }
            _ => {}
        }
        Ok(())
    }

    // One statement; returns whether it never finishes (`return`, ...).
    fn stmt(inout self, inout fb: Fb, s: ast.Stmt) -> Result(bool, Diag) {
        match s.kind {
            Expr(e) => {
                let v = self.expr(&fb, e, None)?
                let never = v.ty == types.NEVER
                self.discard(&fb, v, e.span)?
                Ok(never)
            }
            Let(l) => {
                self.let_stmt(&fb, l.kind, l.pat, l.ty, l.value, s.span)?
                Ok(false)
            }
            Assign(place, value) => {
                // The value first, then the place: `c[i] = c[i] + 1` borrows
                // `c` mutably only once the value is computed.
                let guess = self.peek_type(fb, place)
                let v = self.expr(&fb, value, guess)?
                let v = self.value_operand_val(&fb, v, value.span)?
                let pv = self.expr_mut(&fb, place)?
                let p = match pv.vk.clone() {
                    Place(p) => p
                    Op(_) => return Err(err(place.span, "cannot assign to this"))
                }
                if pv.temp {
                    return Err(err(place.span, "cannot assign to a temporary value"))
                }
                let v = self.coerce(&fb, v, pv.ty, value.span)?
                if !self.place_mutable(fb, p) {
                    return Err(err(place.span, self.not_mutable_msg(fb, p).as_str()))
                }
                let o = self.operand(&fb, v, value.span)?
                if self.types.needs_drop(pv.ty) {
                    fb.push(Stmt.Drop(p.clone(), s.span))
                }
                fb.assign(p, Rvalue.Use(o), s.span)
                Ok(false)
            }
            OpAssign(op, place, value) => {
                if !self.peek_is_adt(fb, place) {
                    // Numbers: the value first, then the place.
                    let guess = self.peek_type(fb, place)
                    let v = self.expr(&fb, value, guess)?
                    let v = self.value_operand_val(&fb, v, value.span)?
                    let pv = self.expr_mut(&fb, place)?
                    let p = match pv.vk.clone() {
                        Place(p) => p
                        Op(_) => return Err(err(place.span, "cannot assign to this"))
                    }
                    if self.types.adt_index(pv.ty).is_some() {
                        return Err(err(place.span, "internal: op-assign on a struct took the number path"))
                    }
                    if !self.place_mutable(fb, p) {
                        return Err(err(place.span, self.not_mutable_msg(fb, p).as_str()))
                    }
                    let lhs = val_op(Operand.Copy(p.clone()), pv.ty)
                    let r = self.binary_vals(&fb, op, lhs, v, s.span)?
                    let o = self.operand(&fb, r, s.span)?
                    fb.assign(p, Rvalue.Use(o), s.span)
                    return Ok(false)
                }
                let pv = self.expr_mut(&fb, place)?
                let p = match pv.vk.clone() {
                    Place(p) => p
                    Op(_) => return Err(err(place.span, "cannot assign to this"))
                }
                if self.types.adt_index(pv.ty).is_some() {
                    // `s += x` calls `add_assign(inout self, x)`.
                    let name = match op {
                        Add => "add_assign"
                        Sub => "sub_assign"
                        _ => return Err(err(s.span, ("`" + op.text() + "=` is not defined for `" + self.types.show(pv.ty).as_str() + "`").as_str()))
                    }
                    let recv = val_place(p, pv.ty)
                    var one = Vec(ast.Expr).new()
                    one.push(value.clone())
                    self.method_call(&fb, recv, name, one, s.span, None)?
                    return Ok(false)
                }
                if !self.place_mutable(fb, p) {
                    return Err(err(place.span, self.not_mutable_msg(fb, p).as_str()))
                }
                let lhs = Operand.Copy(p.clone())
                let r = self.binary_on(&fb, op, val_op(lhs, pv.ty), value, s.span)?
                let o = self.operand(&fb, r, s.span)?
                fb.assign(p, Rvalue.Use(o), s.span)
                Ok(false)
            }
        }
    }

    pub fn not_mutable_msg(self, fb: Fb, p: Place) -> String {
        if fb.owned_env && fb.env_local == Some(p.local) {
            return String.from("a `dyn fn` cannot change what it captured; it may be called from several places, or threads, at once")
        }
        let l = fb.body.locals[p.local as i64]
        match l.name {
            Some(n) => {
                if p.proj.len() == 0 {
                    return "`" + n.as_str() + "` cannot be changed; declare it with `var`"
                }
                if p.proj[0] == Proj.Deref && l.kind == LocalKind.Arg {
                    return "`" + n.as_str() + "` is borrowed read-only; make the parameter `inout` to change it"
                }
                if l.mutable {
                    return "this part of `" + n.as_str() + "` cannot be changed"
                }
                "`" + n.as_str() + "` cannot be changed; declare it with `var`"
            }
            None => "this place cannot be changed".to_string()
        }
    }

    fn let_stmt(inout self, inout fb: Fb, kind: ast.LetKind, pat: ast.Pat, ty: Option(ast.Ty), value: ast.Expr, span: Span) -> Result((), Diag) {
        let env = fb.env.clone()
        var exp: Option(u32) = None
        match ty {
            Some(t) => exp = Some(self.resolve_ty(t, env)?)
            None => {}
        }
        let is_inout = match kind {
            Inout => true
            _ => false
        }
        if is_inout {
            let name = match pat.kind {
                Name(n, _) => n.clone()
                _ => return Err(err(pat.span, "`inout` binds one name"))
            }
            let (p, t) = self.mut_place(&fb, value)?
            match exp {
                Some(e) => {
                    if e != t {
                        return Err(err(value.span, self.expected_found(e, t).as_str()))
                    }
                }
                None => {}
            }
            let rt = self.types.refmut(t)
            let l = fb.declare(name.as_str(), rt, false, VarKind.Borrow, pat.span)
            fb.assign(Place.local(l), Rvalue.RefMut(p), span)
            return Ok(())
        }
        let v = self.expr(&fb, value, exp)?
        let v = match exp {
            Some(e) => self.coerce(&fb, v, e, value.span)?
            None => v
        }
        if v.ty == types.NEVER {
            return Ok(())
        }
        let is_var = match kind {
            Var => true
            _ => false
        }
        match pat.kind {
            Name(name, var_) => {
                if !self.names_variant(fb, name.as_str(), v.ty) {
                    let mutable = is_var || var_
                    self.bind_name(&fb, name.as_str(), v, mutable, pat.span)?
                    return Ok(())
                }
            }
            _ => {}
        }
        let mode = if is_var { BindMode.Owned } else { BindMode.Auto }
        self.destructure(&fb, pat, v, mode, value.span)
    }

    // `let x = v`: a borrow of a place that is not plain, else an owned
    // value.
    pub fn bind_name(inout self, inout fb: Fb, name: str, sink v: Val, mutable: bool, span: Span) -> Result(u32, Diag) {
        let known = match v.vk {
            Place(p) => self.known_closure(fb, p)
            _ => None
        }
        match self.types.kind(v.ty) {
            Type => return Err(err(span, "types exist only while compiling; use `comptime` or a constant"))
            _ => {}
        }
        if self.types.is_ref(v.ty) {
            let t = v.ty
            let o = self.operand(&fb, v, span)?
            let l = fb.declare(name, t, false, VarKind.Borrow, span)
            fb.assign(Place.local(l), Rvalue.Use(o), span)
            return Ok(l)
        }
        match v.vk.clone() {
            Place(p) => {
                if !mutable && !v.temp && !self.types.is_plain(v.ty) {
                    let rt = self.types.refty(v.ty)
                    let l = fb.declare(name, rt, false, VarKind.Borrow, span)
                    fb.assign(Place.local(l), Rvalue.Ref(p), span)
                    return Ok(l)
                }
            }
            Op(_) => {}
        }
        let t = v.ty
        let o = self.operand(&fb, v, span)?
        let l = fb.declare(name, t, mutable, VarKind.Owned, span)
        fb.assign(Place.local(l), Rvalue.Use(o), span)
        if !mutable {
            match known {
                Some((lf, specialized)) => self.comptime_closures.push(sema.ComptimeClosure { id: fb.id, place: Place.local(l), lambda: lf, specialized: specialized })
                None => {}
            }
        }
        Ok(l)
    }

    pub fn names_variant(self, fb: Fb, name: str, t: u32) -> bool {
        if fb.lookup(name).is_some() {
            return false
        }
        match self.types.variants(t) {
            Some(vs) => {
                for v in vs {
                    if v.name == name && v.fields.len() == 0 {
                        return true
                    }
                }
                false
            }
            None => false
        }
    }

    // ---- values ----

    // The operand for a value used up: a copy of a plain place, or a move.
    pub fn operand(inout self, inout fb: Fb, sink v: Val, span: Span) -> Result(Operand, Diag) {
        // A part of a temporary (`pair().1`): it moves out now, and the
        // temporary's other parts are dropped, so that it is never dropped
        // whole with a part missing.
        match v.vk.clone() {
            Place(p) => {
                let whole = fb.ty_of(p.local)
                var fields_only = p.proj.len() > 0
                for x in p.proj {
                    match x {
                        Field(_) | Variant(_) => {}
                        _ => fields_only = false
                    }
                }
                if v.temp && fields_only && fb.body.locals[p.local as i64].kind == LocalKind.Temp && !self.types.is_plain(v.ty) && self.types.needs_drop(whole) {
                    let t = fb.temp(v.ty, span)
                    fb.assign(Place.local(t), Rvalue.Use(Operand.Move(p.clone())), span)
                    self.drop_others(&fb, Place.local(p.local), whole, p.proj, 0, span)?
                    fb.push(Stmt.Forget(p.local))
                    return Ok(Operand.Move(Place.local(t)))
                }
            }
            Op(_) => {}
        }
        self.operand_part(&fb, v, span)
    }

    // The other parts of a temporary than the one at `path[at..]` (below
    // `base`, of type `ty`), dropped.
    fn drop_others(inout self, inout fb: Fb, base: Place, ty: u32, path: Vec(Proj), at: i64, span: Span) -> Result((), Diag) {
        if at < path.len() {
            match self.types.adt_index(ty) {
                Some(a) => {
                    if self.types.adts[a as i64].has_drop {
                        return Err(err(span, ("cannot move a part out of a `" + self.types.show(ty).as_str() + "`: it has a `Drop` impl").as_str()))
                    }
                }
                None => {}
            }
        }
        var parts = Vec(Place).new()
        var fts = Vec(u32).new()
        var here: i64 = 0
        var next = at
        if at + 1 < path.len() {
            match path[at] {
                Variant(v) => match path[at + 1] {
                    Field(i) => {
                        fts = self.types.variants(ty).unwrap()[v as i64].fields.clone()
                        for j in 0..fts.len() {
                            parts.push(base.with(Proj.Variant(v)).with(Proj.Field(j as u32)))
                        }
                        here = i as i64
                        next = at + 2
                    }
                    _ => return Ok(())
                }
                _ => {}
            }
        }
        if next == at {
            if at >= path.len() {
                return Ok(())
            }
            match path[at] {
                Field(i) => {
                    fts = self.types.field_tys(ty)
                    for j in 0..fts.len() {
                        parts.push(base.with(Proj.Field(j as u32)))
                    }
                    here = i as i64
                    next = at + 1
                }
                _ => return Ok(())
            }
        }
        for j, fp in parts {
            let ft = fts[j]
            if j == here {
                self.drop_others(&fb, fp.clone(), ft, path, next, span)?
            } else if self.types.needs_drop(ft) {
                fb.push(Stmt.Drop(fp.clone(), span))
            }
        }
        Ok(())
    }

    // An operand for a value; a part of a temporary moves out alone (for
    // patterns, which drop the other parts themselves).
    pub fn operand_part(inout self, inout fb: Fb, sink v: Val, span: Span) -> Result(Operand, Diag) {
        let p = match v.vk.clone() {
            Op(o) => return Ok(o)
            Place(p) => p
        }
        if self.types.is_plain(v.ty) {
            return Ok(Operand.Copy(p))
        }
        if v.temp {
            return Ok(Operand.Move(p))
        }
        match self.place_movable(fb, p) {
            Some(why) => {
                let what = self.describe_place(fb, p)
                let m = "cannot move " + what.as_str() + " out of its place: " + why + "; use `.clone()` to copy it, or `std.mem.take`/`replace`"
                return Err(err(span, m.as_str()))
            }
            None => {}
        }
        Ok(Operand.Move(p))
    }

    pub fn describe_place(self, fb: Fb, p: Place) -> String {
        match fb.body.locals[p.local as i64].name {
            Some(n) => {
                if p.proj.len() == 0 || (p.proj.len() == 1 && p.proj[0] == Proj.Deref) {
                    return "`" + n.as_str() + "`"
                }
                "a part of `" + n.as_str() + "`"
            }
            None => "this value".to_string()
        }
    }

    // A place holding the value: the place itself, or a temporary.
    pub fn as_place(inout self, inout fb: Fb, sink v: Val, span: Span) -> (Place, bool) {
        match v.vk.clone() {
            Place(p) => (p, v.temp)
            Op(o) => {
                let t = fb.temp(v.ty, span)
                fb.assign(Place.local(t), Rvalue.Use(o), span)
                (Place.local(t), true)
            }
        }
    }

    // Puts an rvalue in a fresh temporary.
    pub fn rvalue(inout self, inout fb: Fb, sink r: Rvalue, ty: u32, span: Span) -> Val {
        let t = fb.temp(ty, span)
        fb.assign(Place.local(t), r, span)
        Val { vk: VK.Place(Place.local(t)), ty: ty, temp: true }
    }

    // A place to change, from `&place`: an `inout` argument, or the value
    // of `inout x = &place`. The `&` is required, so that the reader sees
    // what may change.
    pub fn mut_place(inout self, inout fb: Fb, e: ast.Expr) -> Result((Place, u32), Diag) {
        match e.kind {
            Unary(op, inner) => match op {
                Addr => {
                    let v = self.expr_mut(&fb, inner.deref())?
                    let p = match v.vk.clone() {
                        Place(p) => p
                        Op(_) => return Err(err(e.span, "expected a place (a variable, a field, an element)"))
                    }
                    if !self.place_mutable(fb, p) {
                        return Err(err(e.span, self.not_mutable_msg(fb, p).as_str()))
                    }
                    return Ok((p, v.ty))
                }
                _ => {}
            }
            _ => {}
        }
        Err(err(e.span, "this is changed through an `inout` parameter, so write `&` before it"))
    }

    // Converts a value to the expected type, where the language allows it.
    pub fn coerce(inout self, inout fb: Fb, sink v: Val, to: u32, span: Span) -> Result(Val, Diag) {
        if v.ty == to || v.ty == types.NEVER {
            let t = if v.ty == types.NEVER { types.NEVER } else { to }
            return Ok(Val { vk: v.vk.clone(), ty: t, temp: v.temp })
        }
        let from = v.ty
        // An integer literal typed before its type was known.
        match v.vk.clone() {
            Op(o) => match o {
                Const(c) => match c {
                    Int(x, _) => {
                        if self.types.is_int(to) && self.types.is_int(from) && self.int_fits(x, to) {
                            return Ok(val_op(int_const(x, to), to))
                        }
                        if self.types.is_float(to) && self.types.is_int(from) && (x as f64) as i128 == x {
                            return Ok(val_op(Operand.Const(Const.Float(x as f64, to)), to))
                        }
                    }
                    _ => {}
                }
                _ => {}
            }
            _ => {}
        }
        // A borrow held as a value (`ref T`) where a `T` is expected: what it
        // points to, lent on (moving out of it is still an error).
        if self.types.is_ref(from) && self.types.pointee(from).unwrap() == to {
            return self.auto_deref(&fb, v, span)
        }
        // A place where a borrow of it is expected.
        let tk = self.types.kind(to).clone()
        var to_ref: Option(u32) = None
        var m = false
        match tk.clone() {
            Ref(inner) => to_ref = Some(inner)
            RefMut(inner) => {
                to_ref = Some(inner)
                m = true
            }
            _ => {}
        }
        match to_ref {
            Some(inner) => {
                if inner == from {
                    let (p, temp) = self.as_place(&fb, v, span)
                    if temp {
                        return Err(err(span, "this would borrow a temporary value, which does not live long enough"))
                    }
                    if m && !self.place_mutable(fb, p) {
                        return Err(err(span, self.not_mutable_msg(fb, p).as_str()))
                    }
                    let r = if m { Rvalue.RefMut(p) } else { Rvalue.Ref(p) }
                    return Ok(self.rvalue(&fb, r, to, span))
                }
            }
            None => {}
        }
        // A string literal where a C string is expected: its bytes end
        // with a zero.
        let pu8 = self.types.ptr(types.U8)
        let is_str_lit = match v.vk {
            Op(o) => match o {
                Const(c) => match c {
                    Str(_) => true
                    _ => false
                }
                _ => false
            }
            _ => false
        }
        if from == types.STR && to == pu8 && is_str_lit {
            let (p, _) = self.as_place(&fb, v, span)
            return Ok(val_op(Operand.Copy(p.with(Proj.Field(0))), to))
        }
        // A string literal where a `String` is expected: no allocation.
        if self.string_ty() == Some(to) && from == types.STR && is_str_lit {
            var sargs = Vec(Val).new()
            sargs.push(v)
            return self.call_static(&fb, to, "from_static", sargs, span)
        }
        // `[T; N]` place to `[T]`.
        match self.types.kind(from).clone() {
            Array(e, n) => match tk.clone() {
                Slice(e2) => {
                    if e == e2 {
                        let (p, _) = self.as_place(&fb, v, span)
                        let pt = self.types.ptr(e)
                        var addr = Operand.Const(Const.Null(pt))
                        if n != 0 {
                            let fp = self.types.ptr(from)
                            let a = self.rvalue(&fb, Rvalue.Addr(p), fp, span)
                            let ap = self.place_of_val(a)
                            let c = self.rvalue(&fb, Rvalue.Cast(Operand.Copy(ap), pt, mir.CastKind.Ptr), pt, span)
                            addr = Operand.Copy(self.place_of_val(c))
                        }
                        let vt = self.view_ty(TyKind.Slice(e))
                        var ops = Vec(Operand).new()
                        ops.push(addr)
                        ops.push(int_const(n as i128, types.I64))
                        return Ok(self.rvalue(&fb, Rvalue.Aggregate(mir.Agg.View(vt), ops), vt, span))
                    }
                }
                _ => {}
            }
            _ => {}
        }
        let to_view = match tk.clone() {
            Str | Slice(_) => true
            _ => false
        }
        // A library type to its view: `String` to `str`, `Vec(T)` to `[T]`.
        if to_view && self.types.adt_index(from).is_some() {
            let name = if to == types.STR { "as_str" } else { "as_slice" }
            if self.find_method(from, name)?.is_some() {
                let r = self.method_call_val(&fb, v.clone(), name, Vec(Val).new(), span, Some(to))?
                if r.ty == to {
                    return Ok(r)
                }
            }
        }
        // Through `deref` (a `Box(T)` where a `T` is borrowed).
        if self.types.adt_index(from).is_some() && self.find_method(from, "deref")?.is_some() {
            let d = self.method_call_val(&fb, v.clone(), "deref", Vec(Val).new(), span, None)?
            if d.ty == to {
                return Ok(d)
            }
            if self.types.adt_index(d.ty).is_some() {
                match self.coerce(&fb, d, to, span) {
                    Ok(r) => return Ok(r)
                    Err(_) => {}
                }
            }
        }
        // A value where a `dyn Trait` is expected: moved to the heap.
        match tk.clone() {
            Dyn(tr) => {
                let is_dyn = match self.types.kind(from) {
                    Dyn(_) | DynFn(_) => true
                    _ => false
                }
                if !is_dyn && self.find_impl(tr, from)?.is_some() {
                    return self.to_dyn(&fb, v, tr, to, span)
                }
                return Err(err(span, ("`" + self.types.show(from).as_str() + "` does not implement `" + self.traits[tr as i64].name.as_str() + "`, so it cannot become a `" + self.types.show(to).as_str() + "`").as_str()))
            }
            DynFn(_) => match self.types.kind(from) {
                Closure(_) => return Err(err(span, "a closure that borrows cannot become a `dyn fn`: write the closure where the `dyn fn` is expected, so that it owns what it captures"))
                _ => {}
            }
            _ => {}
        }
        // `null` and integer constants to pointers are done by `expr`.
        // A named function where a closure is expected.
        var named: Option(u32) = None
        match v.vk {
            Op(o) => match o {
                Const(c) => match c {
                    Fn(f) => named = Some(f)
                    _ => {}
                }
                _ => {}
            }
            _ => {}
        }
        match named {
            Some(f) => match tk {
                FnPtr(sig) => {
                    let fsig = self.out[f as i64].sig.clone()
                    if sig.c_abi && !fsig.c_abi && !fsig.variadic && !sig.variadic && sig.ret == fsig.ret && sig.params.len() == fsig.params.len() {
                        var fits = true
                        for i, t in sig.params {
                            let ft = fsig.params[i]
                            let borrowed = match self.types.kind(ft) { Ref(inner) => inner == t, _ => false }
                            if ft != t && !borrowed { fits = false }
                        }
                        if fits {
                            let thunk = self.c_fn_thunk(f, sig, span)
                            return Ok(val_op(Operand.Const(Const.Fn(thunk)), to))
                        }
                    }
                }
                DynFn(sig) => match self.types.kind(from).clone() {
                    FnPtr(fsig) => {
                        if fsig.params == sig.params && fsig.ret == sig.ret && !fsig.variadic {
                            return self.fn_to_dyn(&fb, f, sig, to, span)
                        }
                    }
                    _ => {}
                }
                Closure(sig) => match self.types.kind(from).clone() {
                    FnPtr(fsig) => {
                        if fsig.params == sig.params && fsig.ret == sig.ret && !fsig.variadic {
                            let w = self.closure_thunk(f, sig)?
                            let null = Operand.Const(Const.Null(self.types.ptr(types.U8)))
                            var ops = Vec(Operand).new()
                            ops.push(Operand.Const(Const.Fn(w)))
                            ops.push(null)
                            return Ok(self.rvalue(&fb, Rvalue.Aggregate(mir.Agg.Closure(to), ops), to, span))
                        }
                    }
                    _ => {}
                }
                _ => {}
            }
            None => {}
        }
        Err(err(span, self.expected_found(to, from).as_str()))
    }

    pub fn place_of_val(self, v: Val) -> Place {
        match v.vk {
            Place(p) => p.clone()
            Op(_) => panic("place_of_val on an operand")
        }
    }

    pub fn string_ty(inout self) -> Option(u32) {
        let d = match self.lang.string {
            Some(d) => d
            None => return None
        }
        self.adt_instance(d, Vec(CVal).new(), Span.new(0, 0, 0)).ok()
    }

    // Adapt an ordinary named function's borrows to a C callback's owned
    // argument slots. No environment is captured by a C function pointer.
    fn c_fn_thunk(inout self, f: u32, sig: types.Sig, span: Span) -> u32 {
        let symbol = "c.thunk." + fmt.n(f as i128)
        for i, fun in self.out {
            if fun.symbol == symbol && fun.sig == sig { return i as u32 }
        }
        let fsig = self.out[f as i64].sig.clone()
        let id = self.out.len() as u32
        var fb = Fb.new(id, Env.new(0), sig.ret, ast.RetMode.Value, span)
        var args = Vec(Operand).new()
        var pass = Vec(mir.ParamPass).new()
        for i, t in sig.params {
            let l = fb.new_local(t, None, false, LocalKind.Arg, span)
            pass.push(mir.ParamPass.Value)
            if fsig.params[i] == t { args.push(copy_of(l)) }
            else { args.push(self.borrow_op(&fb, Place.local(l), false, fsig.params[i], span)) }
        }
        fb.body.arg_count = sig.params.len()
        let next = fb.new_block()
        fb.term(Term.Call(mir.Callee.Fn(f), args, Place.local(mir.RET), next, span))
        fb.switch_to(next)
        fb.term(Term.Return)
        let name = "C callback for " + self.out[f as i64].name.as_str()
        let body = match fb { Fb { body, .. } => body }
        self.out.push(mir.Function {
            symbol: symbol
            name: name
            sig: sig.clone()
            pass: pass
            body: Some(body)
            linkage: mir.Linkage.Internal
            variadic: false
            returns_ref: false
            span: span
        })
        self.inst_info.push(None)
        id
    }

    // A function taking an ignored environment first and calling `f`, so
    // a named function can stand where a closure is expected.
    fn closure_thunk(inout self, f: u32, sig: types.Sig) -> Result(u32, Diag) {
        let id = self.out.len() as u32
        let envp = self.types.ptr(types.U8)
        var params = Vec(u32).new()
        params.push(envp)
        for t in sig.params {
            params.push(t)
        }
        var pass = Vec(mir.ParamPass).new()
        pass.push(mir.ParamPass.Value)
        for x in self.out[f as i64].pass {
            pass.push(x)
        }
        let sp = self.out[f as i64].span
        var fb = Fb.new(id, Env.new(0), sig.ret, ast.RetMode.Value, sp)
        var args = Vec(Operand).new()
        for i, t in params {
            let l = fb.new_local(t, None, false, LocalKind.Arg, sp)
            if i > 0 {
                args.push(if self.types.is_plain(t) { copy_of(l) } else { Operand.Move(Place.local(l)) })
            }
        }
        fb.body.arg_count = params.len()
        let next = fb.new_block()
        fb.term(Term.Call(mir.Callee.Fn(f), args, Place.local(mir.RET), next, sp))
        fb.switch_to(next)
        fb.term(Term.Return)
        var symbol = String.from("thunk.")
        id.show(&symbol)
        let name = "thunk for " + self.out[f as i64].name.as_str()
        let body = match fb {
            Fb { body, .. } => body
        }
        self.out.push(mir.Function {
            symbol: symbol
            name: name
            sig: types.Sig { params: params, ret: sig.ret, c_abi: false, variadic: false }
            pass: pass
            body: Some(body)
            linkage: mir.Linkage.Internal
            variadic: false
            returns_ref: false
            span: sp
        })
        self.inst_info.push(None)
        Ok(id)
    }

    // ---- expressions ----

    // Lowers a place that will be changed.
    pub fn expr_mut(inout self, inout fb: Fb, e: ast.Expr) -> Result(Val, Diag) {
        fb.want_mut = true
        self.expr(&fb, e, None)
    }

    pub fn expr(inout self, inout fb: Fb, e: ast.Expr, exp: Option(u32)) -> Result(Val, Diag) {
        let span = e.span
        let wm = fb.want_mut
        fb.want_mut = false
        if wm {
            match e.kind {
                Field(base, name) => {
                    match sema.expr_path(e) {
                        Some(p) => {
                            if fb.lookup(p[0].as_str()).is_none() {
                                return self.field_expr(&fb, e, base.deref(), name.as_str(), exp)
                            }
                        }
                        None => {}
                    }
                    let bv = self.expr_mut(&fb, base.deref())?
                    fb.want_mut = true
                    let r = self.field_of(&fb, bv, name.as_str(), span)
                    fb.want_mut = false
                    return r
                }
                TupleField(base, i) => {
                    let bv = self.expr_mut(&fb, base.deref())?
                    fb.want_mut = true
                    let bv = self.auto_deref(&fb, bv, span)
                    fb.want_mut = false
                    return self.tuple_field(&fb, bv?, i, span)
                }
                Index(base, idx) => return self.index_expr(&fb, base.deref(), idx.deref(), span, true)
                Unary(op, inner) => match op {
                    Deref => {
                        let v = self.expr_mut(&fb, inner.deref())?
                        match self.types.kind(v.ty) {
                            Ptr(_) => return self.auto_deref(&fb, v, span)
                            Adt(_) => {
                                if self.find_method(v.ty, "deref_mut")?.is_some() {
                                    return self.method_call_val(&fb, v, "deref_mut", Vec(Val).new(), span, None)
                                }
                                return self.expr(&fb, e, exp)
                            }
                            _ => return self.expr(&fb, e, exp)
                        }
                    }
                    _ => {}
                }
                _ => {}
            }
        }
        self.expr_plain(&fb, e, exp, span)
    }

    fn tuple_field(inout self, inout fb: Fb, sink bv: Val, i: u32, span: Span) -> Result(Val, Diag) {
        let ts = match self.types.kind(bv.ty) {
            Tuple(ts) => ts.clone()
            _ => {
                var m = String.from("`.")
                i.show(&m)
                m.push_str("` needs a tuple, found `")
                m.push_str(self.types.show(bv.ty).as_str())
                m.push('`')
                return Err(err(span, m.as_str()))
            }
        }
        if i as i64 >= ts.len() {
            var m = String.from("this tuple has ")
            ts.len().show(&m)
            m.push_str(" parts")
            return Err(err(span, m.as_str()))
        }
        let temp = bv.temp
        let (p, _) = self.as_place(&fb, bv, span)
        Ok(Val { vk: VK.Place(p.with(Proj.Field(i))), ty: ts[i as i64], temp: temp })
    }

    fn expr_plain(inout self, inout fb: Fb, e: ast.Expr, exp: Option(u32), span: Span) -> Result(Val, Diag) {
        match e.kind {
            Int(v) => {
                var t = types.I64
                match exp {
                    Some(x) => {
                        if self.types.is_int(x) {
                            t = x
                        } else if self.types.is_float(x) {
                            let f = v as f64
                            if f as u64 != v {
                                return Err(err(span, "this integer is not exact as a float"))
                            }
                            return Ok(val_op(Operand.Const(Const.Float(f, x)), x))
                        }
                    }
                    None => {}
                }
                if !self.int_fits(v as i128, t) {
                    var m = String.new()
                    v.show(&m)
                    m.push_str(" does not fit in `")
                    m.push_str(self.types.show(t).as_str())
                    m.push('`')
                    return Err(err(span, m.as_str()))
                }
                Ok(val_op(int_const(v as i128, t), t))
            }
            Char(c) => {
                var t = types.U8
                match exp {
                    Some(x) => {
                        if self.types.is_int(x) {
                            t = x
                        }
                    }
                    None => {}
                }
                Ok(val_op(int_const(c as i128, t), t))
            }
            Float(f) => {
                var t = types.F64
                match exp {
                    Some(x) => {
                        if self.types.is_float(x) {
                            t = x
                        }
                    }
                    None => {}
                }
                let v = if t == types.F32 { f as f32 as f64 } else { f }
                Ok(val_op(Operand.Const(Const.Float(v, t)), t))
            }
            Bool(b) => Ok(val_op(Operand.Const(Const.Bool(b)), types.BOOL))
            Str(s) => {
                self.view_ty(TyKind.Str)
                Ok(val_op(Operand.Const(Const.Str(s.clone())), types.STR))
            }
            Unit => Ok(val_unit())
            Name(n) => self.name_expr(&fb, n.as_str(), exp, span)
            Field(base, name) => self.field_expr(&fb, e, base.deref(), name.as_str(), exp)
            TupleField(base, i) => {
                let bv = self.expr(&fb, base.deref(), None)?
                let bv = self.auto_deref(&fb, bv, span)?
                self.tuple_field(&fb, bv, i, span)
            }
            Call(callee, args) => self.call_expr(&fb, callee.deref(), args, exp, span)
            Unary(op, inner) => self.unary_expr(&fb, op, inner.deref(), exp, span)
            Binary(op, a, b) => {
                match op {
                    LogAnd | LogOr => return self.logic(&fb, op, a.deref(), b.deref(), span)
                    _ => {}
                }
                // A shift has its left side's type, so `let b: u8 = 1 << 3`
                // makes the `1` a `u8`.
                let ea: Option(u32) = if op.is_compare() { None } else { exp }
                var av = self.expr(&fb, a.deref(), ea)?
                // `1 + x`: let the literal take the other side's type (not for
                // a shift, whose sides may differ).
                let shift = match op {
                    Shl | Shr => true
                    _ => false
                }
                if is_literal(a.deref()) && ea.is_none() && !shift && !is_literal(b.deref()) {
                    match self.peek_type(fb, b.deref()) {
                        Some(bt) => {
                            if self.types.is_int(bt) || self.types.is_float(bt) {
                                av = self.expr(&fb, a.deref(), Some(bt))?
                            }
                        }
                        None => {}
                    }
                }
                self.binary_on(&fb, op, av, b.deref(), span)
            }
            Cast(inner, t) => {
                let env = fb.env.clone()
                let to = self.resolve_ty(t, env)?
                self.cast(&fb, inner.deref(), to, span)
            }
            Move(inner) => {
                let v = self.expr(&fb, inner.deref(), exp)?
                let p = match v.vk.clone() {
                    Place(p) => p
                    Op(_) => return Ok(v)
                }
                if !v.temp {
                    match self.place_movable(fb, p) {
                        Some(why) => return Err(err(span, ("cannot move " + self.describe_place(fb, p).as_str() + ": " + why).as_str()))
                        None => {}
                    }
                }
                Ok(Val { vk: VK.Op(Operand.Move(p)), ty: v.ty, temp: false })
            }
            Tuple(items) => {
                var exps = Vec(Option(u32)).new()
                var known = false
                match exp {
                    Some(t) => match self.types.kind(t) {
                        Tuple(ts) => {
                            if ts.len() == items.len() {
                                for x in ts {
                                    exps.push(Some(x))
                                }
                                known = true
                            }
                        }
                        _ => {}
                    }
                    None => {}
                }
                if !known {
                    for _ in 0..items.len() {
                        exps.push(None)
                    }
                }
                var ops = Vec(Operand).new()
                var tys = Vec(u32).new()
                for i, it in items {
                    let ex = exps[i]
                    let v = self.expr(&fb, it, ex)?
                    let v = match ex {
                        Some(t) => self.coerce(&fb, v, t, it.span)?
                        None => v
                    }
                    tys.push(v.ty)
                    ops.push(self.operand(&fb, v, it.span)?)
                }
                let t = self.types.tuple(tys)
                Ok(self.rvalue(&fb, Rvalue.Aggregate(mir.Agg.Struct(t), ops), t, span))
            }
            Array(items) => {
                var ee: Option(u32) = None
                var exp_slice: Option(u32) = None
                match exp {
                    Some(t) => match self.types.kind(t) {
                        Array(x, _) => ee = Some(x)
                        Slice(x) => {
                            ee = Some(x)
                            exp_slice = Some(x)
                        }
                        _ => {}
                    }
                    None => {}
                }
                // `[]` where a slice is expected: an empty view.
                match exp_slice {
                    Some(x) => {
                        if items.len() == 0 {
                            let vt = self.view_ty(TyKind.Slice(x))
                            let pt = self.types.ptr(x)
                            var ops = Vec(Operand).new()
                            ops.push(Operand.Const(Const.Null(pt)))
                            ops.push(int_const(0, types.I64))
                            return Ok(self.rvalue(&fb, Rvalue.Aggregate(mir.Agg.View(vt), ops), vt, span))
                        }
                    }
                    None => {}
                }
                if items.len() == 0 {
                    let et = match ee {
                        Some(t) => t
                        None => return Err(err(span, "the type of an empty array must be known: write `let a: [T; 0] = []`"))
                    }
                    let t = self.types.intern(TyKind.Array(et, 0))
                    return Ok(val_op(Operand.Const(Const.Zst(t)), t))
                }
                var ops = Vec(Operand).new()
                var et = ee
                for it in items {
                    let v = self.expr(&fb, it, et)?
                    let v = match et {
                        Some(t) => self.coerce(&fb, v, t, it.span)?
                        None => v
                    }
                    et = Some(v.ty)
                    ops.push(self.operand(&fb, v, it.span)?)
                }
                let t = self.types.intern(TyKind.Array(et.unwrap(), items.len() as u64))
                Ok(self.rvalue(&fb, Rvalue.Aggregate(mir.Agg.Array(t), ops), t, span))
            }
            ArrayRepeat(el, n) => {
                var ee: Option(u32) = None
                match exp {
                    Some(t) => match self.types.kind(t) {
                        Array(x, _) => ee = Some(x)
                        _ => {}
                    }
                    None => {}
                }
                let env = fb.env.clone()
                let n = self.const_int(n.deref(), env)?
                if n < 0 {
                    return Err(err(span, "an array's length cannot be negative"))
                }
                let v = self.expr(&fb, el.deref(), ee)?
                let v = match ee {
                    Some(t) => self.coerce(&fb, v, t, el.span)?
                    None => v
                }
                if !self.types.is_plain(v.ty) {
                    return Err(err(el.span, "`[x; n]` copies `x`, so it must be a plain value; build the array with a loop"))
                }
                let et = v.ty
                let o = self.operand(&fb, v, el.span)?
                let t = self.types.intern(TyKind.Array(et, n as u64))
                Ok(self.rvalue(&fb, Rvalue.Repeat(o, n as u64), t, span))
            }
            Block(b) => self.block(&fb, b, exp, true)
            Unsafe(b) => {
                fb.unsafe_depth += 1
                let r = self.block(&fb, b, exp, true)
                fb.unsafe_depth -= 1
                r
            }
            Comptime(inner) => {
                let env = fb.env.clone()
                let r = self.const_expr(inner.deref(), env, exp)?
                Ok(val_op(Operand.Const(r.c.clone()), r.ty))
            }
            If(c, then, els) => self.if_expr(&fb, c.deref(), then, els, exp, span)
            While(c, body) => {
                let head = fb.new_block()
                let exit = fb.new_block()
                fb.goto(head)
                let cv = self.expr(&fb, c.deref(), Some(types.BOOL))?
                let cv = self.coerce(&fb, cv, types.BOOL, c.span)?
                let co = self.operand(&fb, cv, c.span)?
                let bb = fb.new_block()
                fb.term(Term.Switch(co, switch1(0, exit), bb))
                fb.switch_to(bb)
                fb.loops.push(LoopCtx { brk: exit, cont: head, depth: fb.depth() })
                self.block(&fb, body, Some(types.UNIT), false)?
                fb.loops.pop()
                fb.goto(head)
                fb.switch_to(exit)
                Ok(val_unit())
            }
            Loop(body) => {
                let head = fb.new_block()
                let exit = fb.new_block()
                fb.goto(head)
                fb.loops.push(LoopCtx { brk: exit, cont: head, depth: fb.depth() })
                self.block(&fb, body, Some(types.UNIT), false)?
                fb.loops.pop()
                fb.goto(head)
                fb.switch_to(exit)
                // A loop without `break` never ends.
                Ok(if block_reached(fb, exit) { val_unit() } else { val_never() })
            }
            Return(v) => {
                let ret_ty = if is_ret_value(fb.ret_mode) { fb.ty_of(mir.RET) } else { self.types.pointee(fb.ty_of(mir.RET)).unwrap() }
                match v {
                    Some(v) => {
                        let val = self.expr(&fb, v.deref(), Some(ret_ty))?
                        if val.ty == types.NEVER {
                            return Ok(val_never())
                        }
                        self.write_return(&fb, val, ret_ty, v.span)?
                    }
                    None => {
                        if ret_ty != types.UNIT {
                            return Err(err(span, ("this function returns `" + self.types.show(ret_ty).as_str() + "`").as_str()))
                        }
                    }
                }
                self.exit_to(&fb, 0)
                fb.term(Term.Return)
                Ok(val_never())
            }
            Break | Continue => {
                let n = fb.loops.len()
                if n == 0 {
                    return Err(err(span, "`break` and `continue` belong in a loop"))
                }
                let is_break = match e.kind {
                    Break => true
                    _ => false
                }
                let target = if is_break { fb.loops[n - 1].brk } else { fb.loops[n - 1].cont }
                let depth = fb.loops[n - 1].depth
                self.exit_to(&fb, depth)
                fb.term(Term.Goto(target))
                Ok(val_never())
            }
            Range(_, _) => Err(err(span, "a range only goes in a `for` loop or a slice (`xs[a..b]`)"))
            Type(_) => Err(err(span, "a type is not a value here"))
            Index(base, idx) => self.index_expr(&fb, base.deref(), idx.deref(), span, false)
            Try(inner) => self.try_expr(&fb, inner.deref(), span)
            StructLit(path, fields) => self.struct_lit(&fb, path.deref(), fields, exp, span)
            Match(scrut, arms) => self.match_expr(&fb, scrut.deref(), arms, exp, span)
            For(index, pat, it, body) => self.for_expr(&fb, index, pat, it.deref(), body, span)
            InlineFor(name, it, body) => self.inline_for(&fb, name.as_str(), it.deref(), body, span)
            InlineIf(c, then, els) => self.inline_if(&fb, c.deref(), then, els, exp, span)
            Lambda(params, ret, body) => self.lambda(&fb, params, ret, body, exp, None, span)
        }
    }

    // The type an expression would have, for literals beside it; only for
    // simple expressions that can be looked at without lowering.
    fn peek_type(inout self, fb: Fb, e: ast.Expr) -> Option(u32) {
        match e.kind {
            Name(n) => {
                let v = fb.lookup(n.as_str())?
                let p = self.var_place(fb, v)
                Some(self.place_ty(fb, p))
            }
            Cast(_, t) => {
                let env = fb.env.clone()
                self.resolve_ty(t, env).ok()
            }
            Field(b, f) => {
                let bt = self.peek_type(fb, b.deref())?
                var t = bt
                if self.types.is_ref(bt) || self.types.is_ptr(bt) {
                    t = self.types.pointee(bt).unwrap()
                }
                let a = self.types.adt_index(t)?
                match self.types.adts[a as i64].body {
                    Struct(fs) => {
                        for x in fs {
                            if x.name == f {
                                return Some(x.ty)
                            }
                        }
                        None
                    }
                    _ => None
                }
            }
            Binary(op, a, _) => {
                if op.is_compare() {
                    return None
                }
                self.peek_type(fb, a.deref())
            }
            Unary(op, a) => match op {
                Deref => {
                    let t = self.peek_type(fb, a.deref())?
                    self.types.pointee(t)
                }
                Neg => self.peek_type(fb, a.deref())
                _ => None
            }
            Index(b, _) => {
                let bt = self.peek_type(fb, b.deref())?
                match self.types.kind(bt) {
                    Array(x, _) => Some(x)
                    Slice(x) => Some(x)
                    Ptr(x) => Some(x)
                    Str => Some(types.U8)
                    Adt(_) => {
                        let h = self.find_method(bt, "index").ok()??
                        let id = self.instance(h.imp, h.args.clone(), e.span).ok()?
                        let r = self.out[id as i64].sig.ret
                        self.types.pointee(r)
                    }
                    _ => None
                }
            }
            _ => None
        }
    }

    fn name_expr(inout self, inout fb: Fb, n: str, exp: Option(u32), span: Span) -> Result(Val, Diag) {
        match fb.lookup(n) {
            Some(v) => {
                let p = self.var_place(fb, v)
                let t = self.place_ty(fb, p)
                return Ok(val_place(p, t))
            }
            None => {}
        }
        match fb.env.get(n) {
            Some(c) => return match c {
                Int(i) => {
                    var t = types.I64
                    match exp {
                        Some(x) => {
                            if self.types.is_int(x) {
                                t = x
                            }
                        }
                        None => {}
                    }
                    Ok(val_op(int_const(i, t), t))
                }
                Bool(b) => Ok(val_op(Operand.Const(Const.Bool(b)), types.BOOL))
                Type(_) => Err(err(span, ("`" + n + "` is a type, not a value").as_str()))
                Lambda(_, _) => Err(err(span, "a compile-time closure can only be called"))
            }
            None => {}
        }
        if n == "null" {
            match exp {
                Some(t) => {
                    if self.types.is_ptr(t) {
                        return Ok(val_op(Operand.Const(Const.Null(t)), t))
                    }
                }
                None => {}
            }
            return Err(err(span, "the type of `null` must be known: a pointer type is expected here"))
        }
        let module = fb.env.module
        match self.lookup(module, n) {
            Some(s) => match s {
                Const(c) => {
                    let r = self.const_value(c)?
                    Ok(val_op(Operand.Const(r.c.clone()), r.ty))
                }
                Static(i) => self.static_place(&fb, i, span)
                Fn(f) => self.fn_value(f, Vec(CVal).new(), span)
                _ => Err(err(span, ("`" + n + "` is not a value").as_str()))
            }
            None => {
                // A variant named alone: `None`, or one of the expected enum.
                match self.variant_owner(exp, n)? {
                    Some(t) => self.variant_value(&fb, t, n, Vec(ast.Expr).new(), span)
                    None => Err(err(span, ("unknown name `" + n + "`").as_str()))
                }
            }
        }
    }

    // The enum a bare variant name belongs to: the expected type's.
    pub fn variant_owner(inout self, exp: Option(u32), n: str) -> Result(Option(u32), Diag) {
        match exp {
            Some(t) => match self.types.variants(t) {
                Some(vs) => {
                    for v in vs {
                        if v.name == n {
                            return Ok(Some(t))
                        }
                    }
                }
                None => {}
            }
            None => {}
        }
        Ok(None)
    }

    // A `static` as a place, through its address.
    fn static_place(inout self, inout fb: Fb, i: u32, span: Span) -> Result(Val, Diag) {
        if fb.unsafe_depth == 0 {
            return Err(err(span, "a `static` is shared by the whole program, so it is only used in `unsafe` code"))
        }
        let t = self.static_info(i)?.ty
        let pt = self.types.ptr(t)
        let a = fb.temp(pt, span)
        fb.assign(Place.local(a), Rvalue.Use(Operand.Const(Const.Static(i, pt))), span)
        Ok(val_place(Place.deref(a), t))
    }

    pub fn fn_value(inout self, f: u32, args: Vec(CVal), span: Span) -> Result(Val, Diag) {
        let d = sema.at(self.fns[f as i64].decl)
        var generic = false
        for p in d.params {
            if p.mode == ast.Mode.Comptime {
                generic = true
            }
        }
        if generic && args.len() == 0 {
            return Err(err(span, "a generic function cannot be used as a value without its compile-time arguments"))
        }
        let id = self.instance(f, args, span)?
        for p in self.out[id as i64].pass {
            match p {
                Owned => return Err(err(span, "a function with `sink` parameters of non-plain types cannot be used as a `fnptr` yet"))
                _ => {}
            }
        }
        var sig = self.out[id as i64].sig.clone()
        var value_id = id
        // Scalar parameters need no borrow adaptation. Give inferred
        // pointers to these functions the same C convention as an explicit
        // fnptr type, including aggregate or 128-bit return values.
        if !sig.c_abi {
            var compatible = sig.ret == types.UNIT || sig.ret == types.NEVER || self.c_type(sig.ret)
            for p in sig.params { if !self.c_type(p) { compatible = false } }
            if compatible {
                sig.c_abi = true
                value_id = self.c_fn_thunk(id, sig, span)
            }
        }
        let t = self.types.intern(TyKind.FnPtr(sig))
        Ok(val_op(Operand.Const(Const.Fn(value_id)), t))
    }

    pub fn auto_deref(inout self, inout fb: Fb, sink v: Val, span: Span) -> Result(Val, Diag) {
        if self.types.is_ref(v.ty) {
            let inner = self.types.pointee(v.ty).unwrap()
            let (p, _) = self.as_place(&fb, v, span)
            return Ok(val_place(p.with(Proj.Deref), inner))
        }
        match self.types.kind(v.ty).clone() {
            Ptr(inner) => {
                if fb.unsafe_depth == 0 {
                    return Err(err(span, "reading through a pointer is only allowed in `unsafe` code"))
                }
                let o = self.operand(&fb, v, span)?
                var keep: Option(Place) = None
                match o.clone() {
                    Copy(p) => {
                        var has_index = false
                        for x in p.proj {
                            match x {
                                Index(_) => has_index = true
                                _ => {}
                            }
                        }
                        if !has_index {
                            keep = Some(p.clone())
                        }
                    }
                    _ => {}
                }
                let tmp = match keep {
                    Some(p) => p
                    None => {
                        let pt = self.types.ptr(inner)
                        let t = fb.temp(pt, span)
                        fb.assign(Place.local(t), Rvalue.Use(o), span)
                        Place.local(t)
                    }
                }
                Ok(val_place(tmp.with(Proj.Deref), inner))
            }
            _ => Ok(v)
        }
    }

    fn field_expr(inout self, inout fb: Fb, whole: ast.Expr, base: ast.Expr, name: str, exp: Option(u32)) -> Result(Val, Diag) {
        let span = whole.span
        // A path: `module.item`, `Type.Variant`, `Type.CONST`.
        match sema.expr_path(whole) {
            Some(p) => {
                if fb.lookup(p[0].as_str()).is_none() {
                    match self.path_value(&fb, p, exp, span)? {
                        Some(v) => return Ok(v)
                        None => {}
                    }
                }
            }
            None => {}
        }
        match base.kind {
            Call(_, _) => {
                let env = fb.env.clone()
                match self.try_expr_ty(base, env)? {
                    Some(t) => return self.type_member(&fb, t, name, Vec(ast.Expr).new(), exp, span, false)
                    None => {}
                }
            }
            _ => {}
        }
        let bv = self.expr(&fb, base, None)?
        self.field_of(&fb, bv, name, span)
    }

    pub fn field_of(inout self, inout fb: Fb, sink bv: Val, name: str, span: Span) -> Result(Val, Diag) {
        var bv = self.auto_deref(&fb, bv, span)?
        for _ in 0..8 {
            match self.types.adt_index(bv.ty) {
                Some(a) => {
                    var found: Option(i64) = None
                    var ft: u32 = 0
                    var public = false
                    match self.types.adts[a as i64].body {
                        Struct(fs) => {
                            for i, f in fs {
                                if f.name == name {
                                    found = Some(i)
                                    ft = f.ty
                                    public = f.public
                                    break
                                }
                            }
                        }
                        _ => {}
                    }
                    match found {
                        Some(i) => {
                            let decl = self.types.adts[a as i64].decl
                            let decl_mod = self.adts[decl as i64].module
                            if !public && !self.same_package(decl_mod, fb.env.module) {
                                return Err(err(span, ("the field `" + name + "` of `" + self.types.adts[a as i64].name.as_str() + "` is private").as_str()))
                            }
                            let temp = bv.temp
                            let (p, _) = self.as_place(&fb, bv, span)
                            return Ok(Val { vk: VK.Place(p.with(Proj.Field(i as u32))), ty: ft, temp: temp })
                        }
                        None => {}
                    }
                }
                None => {}
            }
            // `len` of views is a field; the rest are methods.
            let elem = match self.types.kind(bv.ty) {
                Slice(e) => Some(e)
                Str => Some(types.U8)
                _ => None
            }
            match elem {
                Some(et) => {
                    if name == "len" || name == "ptr" {
                        let (p, _) = self.as_place(&fb, bv, span)
                        if name == "len" {
                            return Ok(val_op(Operand.Copy(p.with(Proj.Field(1))), types.I64))
                        }
                        let pt = self.types.ptr(et)
                        return Ok(val_op(Operand.Copy(p.with(Proj.Field(0))), pt))
                    }
                }
                None => {}
            }
            // Through `deref` (`deref_mut` for a place being changed).
            let wm = fb.want_mut
            if wm && self.find_method(bv.ty, "deref_mut")?.is_some() {
                let m = match bv.vk {
                    Place(p) => self.place_mutable(fb, p)
                    Op(_) => false
                }
                if m {
                    fb.want_mut = false
                    bv = self.method_call_val(&fb, bv, "deref_mut", Vec(Val).new(), span, None)?
                    fb.want_mut = wm
                    continue
                }
            }
            if self.find_method(bv.ty, "deref")?.is_some() {
                fb.want_mut = false
                bv = self.method_call_val(&fb, bv, "deref", Vec(Val).new(), span, None)?
                fb.want_mut = wm
                continue
            }
            break
        }
        Err(err(span, ("`" + self.types.show(bv.ty).as_str() + "` has no field `" + name + "`").as_str()))
    }

    // A dotted path that names something other than a variable's field.
    fn path_value(inout self, inout fb: Fb, p: Vec(String), exp: Option(u32), span: Span) -> Result(Option(Val), Diag) {
        let env = fb.env.clone()
        let n = p.len()
        var head = Vec(String).new()
        for i in 0..n - 1 {
            head.push(p[i].clone())
        }
        // `Type.member`
        if self.path_is_type(head, env) {
            let t = self.resolve_path_ty_pub(head, env, span)?
            return Ok(Some(self.type_member(&fb, t, p[n - 1].as_str(), Vec(ast.Expr).new(), exp, span, false)?))
        }
        // `Enum.Variant` with the enum's arguments inferred.
        match self.lookup_path(env.module, head) {
            Some((Adt(d), _)) => {
                let t = self.infer_enum(d, exp, span)?
                return Ok(Some(self.variant_value(&fb, t, p[n - 1].as_str(), Vec(ast.Expr).new(), span)?))
            }
            _ => {}
        }
        match self.lookup_path(env.module, p) {
            Some((s, _)) => match s {
                Const(c) => {
                    let r = self.const_value(c)?
                    Ok(Some(val_op(Operand.Const(r.c.clone()), r.ty)))
                }
                Fn(f) => Ok(Some(self.fn_value(f, Vec(CVal).new(), span)?))
                Static(i) => Ok(Some(self.static_place(&fb, i, span)?))
                _ => Err(err(span, ("`" + sema.join_path(p).as_str() + "` is not a value").as_str()))
            }
            None => Ok(None)
        }
    }

    pub fn resolve_path_ty_pub(inout self, p: Vec(String), env: Env, span: Span) -> Result(u32, Diag) {
        let t = ast.Ty { kind: ast.TyKind.Path(p.clone(), None), span: span }
        self.resolve_ty(t, env)
    }

    // The instance of a generic enum named without arguments: from the
    // expected type.
    pub fn infer_enum(inout self, d: u32, exp: Option(u32), span: Span) -> Result(u32, Diag) {
        match exp {
            Some(t) => match self.types.adt_index(t) {
                Some(a) => {
                    if self.types.adts[a as i64].decl == d {
                        return Ok(t)
                    }
                }
                None => {}
            }
            None => {}
        }
        if self.adts[d as i64].params().len() == 0 {
            return self.adt_instance(d, Vec(CVal).new(), span)
        }
        let n = self.adts[d as i64].name.clone()
        Err(err(span, ("the arguments of `" + n.as_str() + "` cannot be inferred here; write them: `" + n.as_str() + "(...)`").as_str()))
    }

    // A copy of an enum's variants. (`self.types.variants(t).unwrap().clone()`
    // would copy the borrow: a `ref` value as a receiver finds the methods
    // of the borrow, which is plain. Named, it is the vector.)
    pub fn variants_of(self, t: u32) -> Vec(types.VariantDef) {
        let vs = self.types.variants(t).unwrap()
        vs.clone()
    }

    // Whether `t` is an enum with a variant of this name.
    fn has_variant(self, t: u32, name: str) -> bool {
        match self.types.variants(t) {
            Some(vs) => {
                for v in vs {
                    if v.name == name {
                        return true
                    }
                }
                false
            }
            None => false
        }
    }

    // `T.name` or `T.name(args)`: a variant, an associated function or a
    // constant of a type.
    pub fn type_member(inout self, inout fb: Fb, t: u32, name: str, args: Vec(ast.Expr), exp: Option(u32), span: Span, call: bool) -> Result(Val, Diag) {
        if self.has_variant(t, name) {
            return self.variant_value(&fb, t, name, args, span)
        }
        match self.find_method(t, name)? {
            Some(h) => {
                if !call {
                    return Err(err(span, ("`" + self.types.show(t).as_str() + "." + name + "` is a function; call it").as_str()))
                }
                return self.call_decl(&fb, h.imp, h.args.clone(), None, args, span, exp)
            }
            None => {}
        }
        let d = err(span, ("`" + self.types.show(t).as_str() + "` has no variant or function `" + name + "`").as_str())
        match self.unmet_bound(t, name)? {
            Some(m) => Err(d.note(None, m.as_str()))
            None => Err(d)
        }
    }

    // `Vec.new()`, `Box.new(x)`, `Option.Some(x)`: a generic type named
    // without arguments, which come from the expected type or the call.
    fn generic_static_call(inout self, inout fb: Fb, d: u32, name: str, args: Vec(ast.Expr), exp: Option(u32), span: Span) -> Result(Val, Diag) {
        match exp {
            Some(e) => match self.types.adt_index(e) {
                Some(a) => {
                    if self.types.adts[a as i64].decl == d {
                        return self.type_member(&fb, e, name, args, exp, span, true)
                    }
                }
                None => {}
            }
            None => {}
        }
        let en = match self.adts[d as i64].kind {
            Enum(en) => Some(en)
            Struct(_) => None
        }
        match en {
            Some(en) => {
                var found = false
                for v in sema.at(en).variants {
                    if v.name == name {
                        found = true
                    }
                }
                if found {
                    let t = self.infer_enum(d, exp, span)?
                    return self.variant_value(&fb, t, name, args, span)
                }
            }
            None => {}
        }
        let impls = self.adts[d as i64].impls.clone()
        for imp in impls {
            let fid = match self.impls[imp as i64].fns.get(name) {
                Some(f) => f
                None => continue
            }
            return self.call_decl(&fb, fid, Vec(CVal).new(), None, args, span, exp)
        }
        Err(err(span, ("`" + self.adts[d as i64].name.as_str() + "` has no function `" + name + "`").as_str()))
    }

    pub fn variant_value(inout self, inout fb: Fb, t: u32, name: str, args: Vec(ast.Expr), span: Span) -> Result(Val, Diag) {
        let vs = self.variants_of(t)
        var vi = 0
        for i, v in vs {
            if v.name == name {
                vi = i
                break
            }
        }
        let fields = vs[vi].fields.clone()
        if fields.len() != args.len() {
            var m = "`" + name + "` takes "
            fields.len().show(&m)
            m.push_str(" value(s), ")
            args.len().show(&m)
            m.push_str(" given")
            return Err(err(span, m.as_str()))
        }
        var ops = Vec(Operand).new()
        for i, a in args {
            let ft = fields[i]
            let v = self.expr(&fb, a, Some(ft))?
            let v = self.coerce(&fb, v, ft, a.span)?
            ops.push(self.operand(&fb, v, a.span)?)
        }
        Ok(self.rvalue(&fb, Rvalue.Aggregate(mir.Agg.Variant(t, vi as u32), ops), t, span))
    }

    fn struct_lit(inout self, inout fb: Fb, path: ast.Expr, fields: Vec(ast.FieldInit), exp: Option(u32), span: Span) -> Result(Val, Diag) {
        let env = fb.env.clone()
        var known: Option(u32) = None
        var first_err: Option(Diag) = None
        match self.try_expr_ty(path, env) {
            Ok(o) => known = o
            Err(e) => first_err = Some(e)
        }
        var t: u32 = 0
        match known {
            Some(x) => t = x
            None => {
                // A generic struct named without arguments: the expected type.
                var d: Option(u32) = None
                match sema.expr_path(path) {
                    Some(p) => match self.lookup_path(env.module, p) {
                        Some((Adt(x), _)) => d = Some(x)
                        _ => {}
                    }
                    None => {}
                }
                var ok = false
                match d {
                    Some(d) => match exp {
                        Some(e) => match self.types.adt_index(e) {
                            Some(a) => {
                                if self.types.adts[a as i64].decl == d {
                                    t = e
                                    ok = true
                                }
                            }
                            None => {}
                        }
                        None => {}
                    }
                    None => {}
                }
                if !ok {
                    match first_err {
                        Some(e) => return Err(e)
                        None => return Err(err(path.span, "expected a struct name"))
                    }
                }
            }
        }
        let not_struct = "`" + self.types.show(t).as_str() + "` is not a struct"
        let a = match self.types.adt_index(t) {
            Some(a) => a
            None => return Err(err(path.span, not_struct.as_str()))
        }
        let fs = match self.types.adts[a as i64].body {
            Struct(fs) => fs.clone()
            _ => return Err(err(path.span, not_struct.as_str()))
        }
        let decl_mod = self.adts[self.types.adts[a as i64].decl as i64].module
        var vals = Vec(Option(Operand)).new()
        for _ in 0..fs.len() {
            vals.push(None)
        }
        for f in fields {
            var idx: Option(i64) = None
            for i, fd in fs {
                if fd.name == f.name {
                    idx = Some(i)
                    break
                }
            }
            let i = match idx {
                Some(i) => i
                None => return Err(err(f.span, ("`" + self.types.show(t).as_str() + "` has no field `" + f.name.as_str() + "`").as_str()))
            }
            if !fs[i].public && !self.same_package(decl_mod, fb.env.module) {
                return Err(err(f.span, ("the field `" + f.name.as_str() + "` is private").as_str()))
            }
            if vals[i].is_some() {
                return Err(err(f.span, ("`" + f.name.as_str() + "` is given twice").as_str()))
            }
            let ft = fs[i].ty
            let v = self.expr(&fb, f.value, Some(ft))?
            let v = self.coerce(&fb, v, ft, f.value.span)?
            vals[i] = Some(self.operand(&fb, v, f.value.span)?)
        }
        var ops = Vec(Operand).new()
        var i = 0
        for v in vals.into_iter() {
            match v {
                Some(o) => ops.push(o)
                None => return Err(err(span, ("the field `" + fs[i].name.as_str() + "` is missing").as_str()))
            }
            i += 1
        }
        Ok(self.rvalue(&fb, Rvalue.Aggregate(mir.Agg.Struct(t), ops), t, span))
    }

    fn index_expr(inout self, inout fb: Fb, base: ast.Expr, idx: ast.Expr, span: Span, write: bool) -> Result(Val, Diag) {
        var bv = if write { self.expr_mut(&fb, base)? } else { self.expr(&fb, base, None)? }
        // A borrow held as a value (`ref Vec(T)`): what it points to.
        if self.types.is_ref(bv.ty) {
            bv = self.auto_deref(&fb, bv, span)?
        }
        // Slicing: `xs[a..b]`.
        match idx.kind {
            Range(lo, hi) => {
                var l: Option(ast.Expr) = None
                var h: Option(ast.Expr) = None
                match lo {
                    Some(x) => l = Some(x.deref().clone())
                    None => {}
                }
                match hi {
                    Some(x) => h = Some(x.deref().clone())
                    None => {}
                }
                return self.slice_expr(&fb, bv, l, h, span)
            }
            _ => {}
        }
        match self.types.kind(bv.ty).clone() {
            Array(et, n) => {
                let il = self.index_local(&fb, idx, span)?
                self.bounds_check(&fb, copy_of(il), int_const(n as i128, types.I64), span)
                let temp = bv.temp
                let (p, _) = self.as_place(&fb, bv, span)
                Ok(Val { vk: VK.Place(p.with(Proj.Index(il))), ty: et, temp: temp })
            }
            Slice(et) => {
                let iv = self.expr(&fb, idx, Some(types.I64))?
                let iv = self.coerce(&fb, iv, types.I64, idx.span)?
                let io = self.operand(&fb, iv, idx.span)?
                let pt = self.types.ptr(et)
                let (bp, _) = self.as_place(&fb, bv, span)
                let data = Operand.Copy(bp.with(Proj.Field(0)))
                let il = self.operand_local(&fb, io, types.I64, span)
                let len = Operand.Copy(bp.with(Proj.Field(1)))
                self.bounds_check(&fb, copy_of(il), len, span)
                let a = self.rvalue(&fb, Rvalue.Offset(data, copy_of(il)), pt, span)
                let ap = self.place_of_val(a)
                Ok(val_place(ap.with(Proj.Deref), et))
            }
            Ptr(et) => {
                if fb.unsafe_depth == 0 {
                    return Err(err(span, "indexing a pointer is only allowed in `unsafe` code"))
                }
                let iv = self.expr(&fb, idx, Some(types.I64))?
                let iv = self.coerce(&fb, iv, types.I64, idx.span)?
                let io = self.operand(&fb, iv, idx.span)?
                let pt = self.types.ptr(et)
                let (bp, _) = self.as_place(&fb, bv, span)
                let a = self.rvalue(&fb, Rvalue.Offset(Operand.Copy(bp), io), pt, span)
                let ap = self.place_of_val(a)
                Ok(val_place(ap.with(Proj.Deref), et))
            }
            Str => {
                let il = self.index_local(&fb, idx, span)?
                let (bp, _) = self.as_place(&fb, bv, span)
                let len = Operand.Copy(bp.with(Proj.Field(1)))
                self.bounds_check(&fb, copy_of(il), len, span)
                let pt = self.types.ptr(types.U8)
                let a = self.rvalue(&fb, Rvalue.Offset(Operand.Copy(bp.with(Proj.Field(0))), copy_of(il)), pt, span)
                let ap = self.place_of_val(a)
                // Bytes of a `str` are read only.
                let v = Operand.Copy(ap.with(Proj.Deref))
                Ok(self.rvalue(&fb, Rvalue.Use(v), types.U8, span))
            }
            Adt(_) => {
                // `index`/`index_mut` projections.
                var mutable = false
                if write && !bv.temp {
                    match bv.vk {
                        Place(p) => mutable = self.place_mutable(fb, p)
                        Op(_) => {}
                    }
                }
                let name = if mutable && self.find_method(bv.ty, "index_mut")?.is_some() { "index_mut" } else { "index" }
                if self.find_method(bv.ty, name)?.is_none() {
                    return Err(err(span, ("`" + self.types.show(bv.ty).as_str() + "` cannot be indexed (it has no `index` method)").as_str()))
                }
                var one = Vec(ast.Expr).new()
                one.push(idx.clone())
                self.method_call(&fb, bv, name, one, span, None)
            }
            _ => Err(err(span, ("`" + self.types.show(bv.ty).as_str() + "` cannot be indexed").as_str()))
        }
    }

    // An index as an `i64` in a local.
    fn index_local(inout self, inout fb: Fb, idx: ast.Expr, span: Span) -> Result(u32, Diag) {
        let iv = self.expr(&fb, idx, Some(types.I64))?
        let iv = self.coerce(&fb, iv, types.I64, idx.span)?
        let io = self.operand(&fb, iv, idx.span)?
        Ok(self.operand_local(&fb, io, types.I64, span))
    }

    pub fn bounds_check(inout self, inout fb: Fb, sink i: Operand, sink len: Operand, span: Span) {
        // An unsigned comparison checks `0 <= i < len` at once.
        let c = fb.temp(types.BOOL, span)
        let ui = fb.temp(types.U64, span)
        let ul = fb.temp(types.U64, span)
        fb.assign(Place.local(ui), Rvalue.Cast(i, types.U64, mir.CastKind.Numeric), span)
        fb.assign(Place.local(ul), Rvalue.Cast(len, types.U64, mir.CastKind.Numeric), span)
        fb.assign(Place.local(c), Rvalue.Bin(Op.Lt, copy_of(ui), copy_of(ul)), span)
        let next = fb.new_block()
        fb.term(Term.Assert(copy_of(c), String.from("index out of bounds"), next, span))
        fb.switch_to(next)
    }

    // A bound of a slice, as an `i64` operand.
    fn slice_bound(inout self, inout fb: Fb, e: ast.Expr) -> Result(Operand, Diag) {
        let v = self.expr(&fb, e, Some(types.I64))?
        let v = self.coerce(&fb, v, types.I64, e.span)?
        self.operand(&fb, v, e.span)
    }

    fn slice_expr(inout self, inout fb: Fb, sink bv: Val, lo: Option(ast.Expr), hi: Option(ast.Expr), span: Span) -> Result(Val, Diag) {
        let bt = bv.ty
        var elem = types.U8
        var view = types.STR
        var is_array = false
        match self.types.kind(bt).clone() {
            Str => {}
            Slice(e) => {
                elem = e
                view = bt
            }
            Array(e, _) => {
                elem = e
                view = self.view_ty(TyKind.Slice(e))
                is_array = true
            }
            Adt(_) => {
                // `as_slice`/`as_str`, then slice that.
                let name = if self.find_method(bt, "as_str")?.is_some() { "as_str" } else { "as_slice" }
                if self.find_method(bt, name)?.is_none() {
                    return Err(err(span, ("`" + self.types.show(bt).as_str() + "` cannot be sliced").as_str()))
                }
                let v = self.method_call_val(&fb, bv, name, Vec(Val).new(), span, None)?
                return self.slice_expr(&fb, v, lo, hi, span)
            }
            _ => return Err(err(span, ("`" + self.types.show(bt).as_str() + "` cannot be sliced").as_str()))
        }
        var bv = bv
        if is_array {
            bv = self.coerce(&fb, bv, view, span)?
        }
        let (bp, _) = self.as_place(&fb, bv, span)
        let len = Operand.Copy(bp.with(Proj.Field(1)))
        let lo_o = match lo {
            Some(e) => self.slice_bound(&fb, e)?
            None => int_const(0, types.I64)
        }
        let hi_o = match hi {
            Some(e) => self.slice_bound(&fb, e)?
            None => len.clone()
        }
        let lo_l = self.operand_local(&fb, lo_o, types.I64, span)
        let hi_l = self.operand_local(&fb, hi_o, types.I64, span)
        // 0 <= lo <= hi <= len
        let lenp1 = fb.temp(types.I64, span)
        fb.assign(Place.local(lenp1), Rvalue.Bin(Op.Add, len.clone(), int_const(1, types.I64)), span)
        self.bounds_check(&fb, copy_of(hi_l), copy_of(lenp1), span)
        let hip1 = fb.temp(types.I64, span)
        fb.assign(Place.local(hip1), Rvalue.Bin(Op.Add, copy_of(hi_l), int_const(1, types.I64)), span)
        self.bounds_check(&fb, copy_of(lo_l), copy_of(hip1), span)
        let pt = self.types.ptr(elem)
        let data = self.rvalue(&fb, Rvalue.Offset(Operand.Copy(bp.with(Proj.Field(0))), copy_of(lo_l)), pt, span)
        let n = fb.temp(types.I64, span)
        fb.assign(Place.local(n), Rvalue.Bin(Op.Sub, copy_of(hi_l), copy_of(lo_l)), span)
        let dp = self.place_of_val(data)
        var ops = Vec(Operand).new()
        ops.push(Operand.Copy(dp))
        ops.push(copy_of(n))
        Ok(self.rvalue(&fb, Rvalue.Aggregate(mir.Agg.View(view), ops), view, span))
    }

    fn unary_expr(inout self, inout fb: Fb, op: ast.UnOp, inner: ast.Expr, exp: Option(u32), span: Span) -> Result(Val, Diag) {
        match op {
            Neg => {
                match inner.kind {
                    Int(v) => {
                        // `-128` fits in an i8 although 128 does not.
                        var t = types.I64
                        match exp {
                            Some(x) => {
                                if self.types.is_int(x) || self.types.is_float(x) {
                                    t = x
                                }
                            }
                            None => {}
                        }
                        if self.types.is_float(t) {
                            return Ok(val_op(Operand.Const(Const.Float(0.0 - v as f64, t)), t))
                        }
                        let n = 0 - (v as i128)
                        if !self.int_fits(n, t) {
                            var m = String.from("-")
                            v.show(&m)
                            m.push_str(" does not fit in `")
                            m.push_str(self.types.show(t).as_str())
                            m.push('`')
                            return Err(err(span, m.as_str()))
                        }
                        return Ok(val_op(int_const(n, t), t))
                    }
                    _ => {}
                }
                let v = self.expr(&fb, inner, exp)?
                let t = v.ty
                var ok = self.types.is_float(t)
                match self.types.int(t) {
                    Some(i) => ok = i.signed
                    None => {}
                }
                if !ok {
                    return Err(err(span, ("`-` needs a signed integer or a float, found `" + self.types.show(t).as_str() + "`").as_str()))
                }
                let o = self.operand(&fb, v, span)?
                Ok(self.rvalue(&fb, Rvalue.Un(mir.UnOp.Neg, o), t, span))
            }
            Not => {
                let v = self.expr(&fb, inner, exp)?
                let t = v.ty
                if t != types.BOOL && !self.types.is_int(t) {
                    return Err(err(span, ("`!` needs a bool or an integer, found `" + self.types.show(t).as_str() + "`").as_str()))
                }
                let o = self.operand(&fb, v, span)?
                Ok(self.rvalue(&fb, Rvalue.Un(mir.UnOp.Not, o), t, span))
            }
            Deref => {
                let v = self.expr(&fb, inner, None)?
                match self.types.kind(v.ty) {
                    Ptr(_) => self.auto_deref(&fb, v, span)
                    Adt(_) => {
                        if self.find_method(v.ty, "deref")?.is_some() {
                            return self.method_call_val(&fb, v, "deref", Vec(Val).new(), span, None)
                        }
                        Err(err(span, ("`*` needs a pointer, found `" + self.types.show(v.ty).as_str() + "`").as_str()))
                    }
                    _ => Err(err(span, ("`*` needs a pointer, found `" + self.types.show(v.ty).as_str() + "`").as_str()))
                }
            }
            Addr => {
                // The address of a place, as a raw pointer.
                let v = self.expr(&fb, inner, None)?
                let t = v.ty
                match v.vk.clone() {
                    Place(p) => {
                        if !v.temp {
                            let pt = self.types.ptr(t)
                            return Ok(self.rvalue(&fb, Rvalue.Addr(p), pt, span))
                        }
                    }
                    Op(_) => {}
                }
                Err(err(span, "`&` takes the address of a place (a variable, a field, an element)"))
            }
        }
    }

    fn logic(inout self, inout fb: Fb, op: Op, a: ast.Expr, b: ast.Expr, span: Span) -> Result(Val, Diag) {
        let r = fb.temp(types.BOOL, span)
        let av = self.expr(&fb, a, Some(types.BOOL))?
        let av = self.coerce(&fb, av, types.BOOL, a.span)?
        let ao = self.operand(&fb, av, a.span)?
        fb.assign(Place.local(r), Rvalue.Use(ao.clone()), span)
        let rhs = fb.new_block()
        let done = fb.new_block()
        let and = op == Op.LogAnd
        let t = if and { rhs } else { done }
        let f = if and { done } else { rhs }
        fb.term(Term.Switch(ao, switch1(0, f), t))
        fb.switch_to(rhs)
        fb.push_scope(true)
        let bv = self.expr(&fb, b, Some(types.BOOL))?
        let bv = self.coerce(&fb, bv, types.BOOL, b.span)?
        let bo = self.operand(&fb, bv, b.span)?
        fb.assign(Place.local(r), Rvalue.Use(bo), span)
        self.pop_scope(&fb)
        fb.goto(done)
        Ok(val_op(copy_of(r), types.BOOL))
    }

    // A value as an operand in a temporary, so that what is lowered next
    // cannot change it.
    fn value_operand_val(inout self, inout fb: Fb, sink v: Val, span: Span) -> Result(Val, Diag) {
        match v.vk.clone() {
            Op(o) => match o {
                Const(_) => return Ok(v)
                _ => {}
            }
            Place(_) => {
                if v.temp {
                    return Ok(v)
                }
            }
        }
        let t = v.ty
        let o = self.operand(&fb, v, span)?
        let l = fb.temp(t, span)
        fb.assign(Place.local(l), Rvalue.Use(o), span)
        Ok(Val { vk: VK.Place(Place.local(l)), ty: t, temp: true })
    }

    fn peek_is_adt(inout self, fb: Fb, e: ast.Expr) -> bool {
        match self.peek_type(fb, e) {
            Some(t) => self.types.adt_index(t).is_some()
            // Unknown: take the general path.
            None => true
        }
    }

    // A binary operation on two values already lowered (numbers).
    fn binary_vals(inout self, inout fb: Fb, op: Op, sink av: Val, sink bv: Val, span: Span) -> Result(Val, Diag) {
        let at = av.ty
        let shift = match op {
            Shl | Shr => true
            _ => false
        }
        var bv = bv
        if bv.ty != at && !shift {
            match bv.vk.clone() {
                Op(o) => match o {
                    Const(c) => match c {
                        Int(v, _) => {
                            if self.types.is_int(at) && self.int_fits(v, at) {
                                bv = val_op(int_const(v, at), at)
                            } else if self.types.is_float(at) {
                                bv = val_op(Operand.Const(Const.Float(v as f64, at)), at)
                            }
                        }
                        _ => {}
                    }
                    _ => {}
                }
                _ => {}
            }
        }
        let bt = bv.ty
        let num = self.types.is_int(at) || self.types.is_float(at)
        var ok = num && (at == bt || (shift && self.types.is_int(bt)))
        let bitwise = match op {
            And | Or | Xor => true
            _ => false
        }
        ok = ok || (at == types.BOOL && bt == types.BOOL && bitwise)
        if !ok {
            return Err(self.op_err(op, at, bt, span))
        }
        let int_only = match op {
            And | Or | Xor | Shl | Shr | AddWrap | SubWrap | MulWrap => true
            _ => false
        }
        if self.types.is_float(at) && int_only {
            return Err(self.op_err(op, at, bt, span))
        }
        let ao = self.operand(&fb, av, span)?
        var bo = self.operand(&fb, bv, span)?
        if shift && bt != at {
            let c = self.rvalue(&fb, Rvalue.Cast(bo, at, mir.CastKind.Numeric), at, span)
            bo = Operand.Copy(self.place_of_val(c))
        }
        Ok(self.rvalue(&fb, Rvalue.Bin(op, ao, bo), at, span))
    }

    pub fn binary_on(inout self, inout fb: Fb, op: Op, sink av: Val, b: ast.Expr, span: Span) -> Result(Val, Diag) {
        let at = av.ty
        // Operators on library types call their methods.
        let compound = match self.types.kind(at) {
            Slice(_) | Tuple(_) => true
            _ => false
        }
        if self.types.adt_index(at).is_some() || at == types.STR || compound && at != types.UNIT {
            return self.operator_method(&fb, op, av, b, span)
        }
        let shift = match op {
            Shl | Shr => true
            _ => false
        }
        let bexp: Option(u32) = if shift { None } else { Some(at) }
        let bv = self.expr(&fb, b, bexp)?
        let bt = bv.ty
        let num_at = self.types.is_int(at) || self.types.is_float(at)
        var rt = at
        match op {
            Add | Sub | Mul | Div | Rem => {
                let ptr_arith = match op {
                    Add | Sub => self.types.is_ptr(at) && self.types.is_int(bt)
                    _ => false
                }
                if ptr_arith {
                    if fb.unsafe_depth == 0 {
                        return Err(err(span, "pointer arithmetic is only allowed in `unsafe` code"))
                    }
                    let ao = self.operand(&fb, av, span)?
                    var bo = self.operand(&fb, bv, span)?
                    if bt != types.I64 {
                        let c = self.rvalue(&fb, Rvalue.Cast(bo, types.I64, mir.CastKind.Numeric), types.I64, span)
                        bo = Operand.Copy(self.place_of_val(c))
                    }
                    if op == Op.Sub {
                        let n = self.rvalue(&fb, Rvalue.Un(mir.UnOp.Neg, bo), types.I64, span)
                        bo = Operand.Copy(self.place_of_val(n))
                    }
                    return Ok(self.rvalue(&fb, Rvalue.Offset(ao, bo), at, span))
                }
                if !num_at || at != bt {
                    return Err(self.op_err(op, at, bt, span))
                }
            }
            AddWrap | SubWrap | MulWrap | And | Or | Xor => {
                let bitwise = match op {
                    And | Or | Xor => true
                    _ => false
                }
                let bools = at == types.BOOL && bitwise && bt == types.BOOL
                if !bools && (!self.types.is_int(at) || at != bt) {
                    return Err(self.op_err(op, at, bt, span))
                }
            }
            Shl | Shr => {
                if !self.types.is_int(at) || !self.types.is_int(bt) {
                    return Err(self.op_err(op, at, bt, span))
                }
            }
            Eq | Ne | Lt | Le | Gt | Ge => {
                let fnptr = match self.types.kind(at) {
                    FnPtr(_) => true
                    _ => false
                }
                let comparable = num_at || at == types.BOOL || self.types.is_ptr(at) || fnptr
                if !comparable || at != bt {
                    return Err(self.op_err(op, at, bt, span))
                }
                let eq = match op {
                    Eq | Ne => true
                    _ => false
                }
                if at == types.BOOL && !eq {
                    return Err(self.op_err(op, at, bt, span))
                }
                rt = types.BOOL
            }
            LogAnd | LogOr => panic("unreachable")
        }
        let ao = self.operand(&fb, av, span)?
        var bo = self.operand(&fb, bv, b.span)?
        if shift && bt != at {
            let c = self.rvalue(&fb, Rvalue.Cast(bo, at, mir.CastKind.Numeric), at, span)
            bo = Operand.Copy(self.place_of_val(c))
        }
        Ok(self.rvalue(&fb, Rvalue.Bin(op, ao, bo), rt, span))
    }

    fn op_err(self, op: Op, a: u32, b: u32, span: Span) -> Diag {
        if a == b {
            return err(span, ("`" + op.text() + "` is not defined for `" + self.types.show(a).as_str() + "`").as_str())
        }
        err(span, ("`" + op.text() + "` needs both sides of the same type, found `" + self.types.show(a).as_str() + "` and `" + self.types.show(b).as_str() + "`").as_str())
    }

    fn cast(inout self, inout fb: Fb, inner: ast.Expr, to: u32, span: Span) -> Result(Val, Diag) {
        let num_to = self.types.is_int(to) || self.types.is_float(to)
        let ex: Option(u32) = if num_to { None } else { Some(to) }
        let v = self.expr(&fb, inner, ex)?
        let from = v.ty
        if from == to {
            return Ok(v)
        }
        let fk = self.types.kind(from).clone()
        let tk = self.types.kind(to).clone()
        let fnum = match fk.clone() {
            Int(_) | Float(_) => true
            _ => false
        }
        let tnum = match tk.clone() {
            Int(_) | Float(_) => true
            _ => false
        }
        let fptr = match fk.clone() {
            Ptr(_) => true
            _ => false
        }
        let tptr = match tk.clone() {
            Ptr(_) => true
            _ => false
        }
        let ffn = match fk.clone() {
            FnPtr(_) => true
            _ => false
        }
        let tfn = match tk.clone() {
            FnPtr(_) => true
            _ => false
        }
        let fint64 = match fk.clone() {
            Int(i) => i.bits == 64
            _ => false
        }
        let tint64 = match tk.clone() {
            Int(i) => i.bits == 64
            _ => false
        }
        let tint = match tk.clone() {
            Int(_) => true
            _ => false
        }
        var kind = mir.CastKind.Numeric
        if fnum && tnum {
            kind = mir.CastKind.Numeric
        } else if from == types.BOOL && tint {
            kind = mir.CastKind.Numeric
        } else if fptr && tptr {
            kind = mir.CastKind.Ptr
        } else if ((fptr || ffn) && tint64) || (fint64 && (tptr || tfn)) {
            kind = mir.CastKind.Numeric
        } else if (fptr && tfn) || (ffn && tptr) {
            kind = mir.CastKind.Ptr
        } else {
            var unit_enum = false
            match self.types.variants(from) {
                Some(vs) => {
                    unit_enum = true
                    for x in vs {
                        if x.fields.len() > 0 {
                            unit_enum = false
                        }
                    }
                }
                None => {}
            }
            if unit_enum && tint {
                let (p, _) = self.as_place(&fb, v, span)
                let d = self.rvalue(&fb, Rvalue.Discriminant(p), types.I64, span)
                let dp = self.place_of_val(d)
                return Ok(self.rvalue(&fb, Rvalue.Cast(Operand.Copy(dp), to, mir.CastKind.Numeric), to, span))
            }
            return Err(err(span, ("cannot convert `" + self.types.show(from).as_str() + "` to `" + self.types.show(to).as_str() + "` with `as`").as_str()))
        }
        let o = self.operand(&fb, v, span)?
        Ok(self.rvalue(&fb, Rvalue.Cast(o, to, kind), to, span))
    }

    fn if_expr(inout self, inout fb: Fb, c: ast.Expr, then: ast.Block, els: Option(Box(ast.Expr)), exp: Option(u32), span: Span) -> Result(Val, Diag) {
        let cv = self.expr(&fb, c, Some(types.BOOL))?
        let cv = self.coerce(&fb, cv, types.BOOL, c.span)?
        let co = self.operand(&fb, cv, c.span)?
        let tb = fb.new_block()
        let eb = fb.new_block()
        let done = fb.new_block()
        let want = els.is_some() && exp != Some(types.UNIT)
        // The result goes in a temporary of the statement around the `if`.
        var result: Option(u32) = None
        if want {
            let r = fb.new_local(types.UNIT, None, true, LocalKind.Temp, span)
            fb.add_temp_local(r)
            result = Some(r)
        }
        fb.term(Term.Switch(co, switch1(0, eb), tb))
        fb.switch_to(tb)
        let then_exp: Option(u32) = if want { exp } else { Some(types.UNIT) }
        let tv = self.block(&fb, then, then_exp, want)?
        var rty: Option(u32) = if tv.ty == types.NEVER { None } else { Some(tv.ty) }
        match result {
            Some(r) => {
                if tv.ty != types.NEVER && tv.ty != types.UNIT {
                    fb.body.locals[r as i64].ty = tv.ty
                    let o = self.operand(&fb, tv, then.span)?
                    fb.assign(Place.local(r), Rvalue.Use(o), span)
                }
            }
            None => {}
        }
        fb.goto(done)
        fb.switch_to(eb)
        var ety: Option(u32) = None
        match els {
            Some(e) => {
                var else_exp: Option(u32) = Some(types.UNIT)
                if want {
                    else_exp = match rty {
                        Some(t) => Some(t)
                        None => exp
                    }
                }
                let ev = self.expr(&fb, e.deref(), else_exp)?
                var ev = ev
                if want {
                    match rty {
                        Some(t) => ev = self.coerce(&fb, ev, t, e.span)?
                        None => {}
                    }
                }
                ety = if ev.ty == types.NEVER { None } else { Some(ev.ty) }
                match result {
                    Some(r) => {
                        if ev.ty != types.NEVER && ev.ty != types.UNIT {
                            fb.body.locals[r as i64].ty = ev.ty
                            let o = self.operand(&fb, ev, e.span)?
                            fb.assign(Place.local(r), Rvalue.Use(o), span)
                        }
                    }
                    None => self.discard(&fb, ev, e.span)?
                }
            }
            None => {}
        }
        fb.goto(done)
        if rty.is_none() {
            rty = ety
        }
        let r = match result {
            Some(r) => r
            None => {
                if els.is_some() && rty.is_none() {
                    return Ok(val_never())
                }
                return Ok(val_unit())
            }
        }
        let t = match rty {
            Some(t) => t
            None => return Ok(val_never())
        }
        if t == types.UNIT {
            return Ok(val_unit())
        }
        // Register the result where the statement's temporaries are.
        fb.body.locals[r as i64].ty = t
        Ok(Val { vk: VK.Place(Place.local(r)), ty: t, temp: true })
    }

    // `inline if`: only the selected branch is checked and lowered.
    fn inline_if(inout self, inout fb: Fb, c: ast.Expr, then: ast.Block, els: Option(Box(ast.Expr)), exp: Option(u32), span: Span) -> Result(Val, Diag) {
        let env = fb.env.clone()
        let r = self.const_expr(c, env, Some(types.BOOL))?
        let b = match r.c {
            Bool(b) => b
            _ => return Err(err(c.span, "the condition of `inline if` is a compile-time `bool`"))
        }
        match els {
            Some(e) => {
                if b {
                    self.block(&fb, then, exp, true)
                } else {
                    self.expr(&fb, e.deref(), exp)
                }
            }
            None => {
                if !b {
                    return Ok(val_unit())
                }
                let v = self.block(&fb, then, Some(types.UNIT), false)?
                Ok(if v.ty == types.NEVER { val_never() } else { val_unit() })
            }
        }
    }

    // `inline for i in a..b`: the body once for each `i`, which is a
    // compile-time constant there, as a `comptime` parameter is.
    fn inline_for(inout self, inout fb: Fb, name: str, it: ast.Expr, body: ast.Block, span: Span) -> Result(Val, Diag) {
        let bad = "`inline for` goes over a range with both ends, `a..b`"
        let (lo, hi) = match it.kind {
            Range(a, b) => match a {
                Some(a) => match b {
                    Some(b) => (a.deref().clone(), b.deref().clone())
                    None => return Err(err(it.span, bad))
                }
                None => return Err(err(it.span, bad))
            }
            _ => return Err(err(it.span, bad))
        }
        if fb.lookup(name).is_some() {
            return Err(err(span, ("`" + name + "` is already a variable here; name the `inline for` index differently").as_str()))
        }
        let env = fb.env.clone()
        let a = self.const_int(lo, env)?
        let b = self.const_int(hi, env)?
        if b - a > 65536 {
            return Err(err(it.span, "`inline for` repeats its body at most 65536 times"))
        }
        let n = fb.env.names.len()
        var diverged = false
        var i = a
        while i < b {
            fb.env.push(name, CVal.Int(i))
            let v = self.block(&fb, body, Some(types.UNIT), false)
            fb.env.names.truncate(n)
            if v?.ty == types.NEVER {
                diverged = true
            }
            i += 1
        }
        Ok(if diverged { val_never() } else { val_unit() })
    }

    // `==` calls `eq`, `<` and friends call `compare`, `+` calls `add`.
    fn operator_method(inout self, inout fb: Fb, op: Op, sink av: Val, b: ast.Expr, span: Span) -> Result(Val, Diag) {
        let at = av.ty
        var post = 0
        let name = match op {
            Eq => "eq"
            Ne => {
                post = 1
                "eq"
            }
            Lt => {
                post = 2
                "compare"
            }
            Le => {
                post = 3
                "compare"
            }
            Gt => {
                post = 4
                "compare"
            }
            Ge => {
                post = 5
                "compare"
            }
            Add => "add"
            Sub => "sub"
            Mul => "mul"
            _ => return Err(err(span, ("`" + op.text() + "` is not defined for `" + self.types.show(at).as_str() + "`").as_str()))
        }
        var one = Vec(ast.Expr).new()
        one.push(b.clone())
        // `s + "x"` with `s` a `String` that cannot be moved (it is borrowed,
        // or used again): add to its text instead, making a new `String`.
        if op == Op.Add {
            var movable = true
            match av.vk {
                Place(p) => movable = av.temp || self.place_movable(fb, p).is_none()
                Op(_) => {}
            }
            if !movable && self.find_method(at, "as_str")?.is_some() {
                let s = self.method_call_val(&fb, av, "as_str", Vec(Val).new(), span, None)?
                return self.method_call(&fb, s, "add", one, span, None)
            }
        }
        if self.find_method(at, name)?.is_none() {
            let tr = if name == "eq" { "Eq" } else if name == "compare" { "Ord" } else { name }
            return Err(err(span, ("`" + op.text() + "` needs `" + self.types.show(at).as_str() + "` to implement `" + tr + "`").as_str()))
        }
        let r = self.method_call(&fb, av, name, one, span, None)?
        if post == 0 {
            return Ok(r)
        }
        if post == 1 {
            let o = self.operand(&fb, r, span)?
            return Ok(self.rvalue(&fb, Rvalue.Un(mir.UnOp.Not, o), types.BOOL, span))
        }
        // `compare` returns an `Ordering`: Less, Equal, Greater.
        let (p, _) = self.as_place(&fb, r, span)
        let d = self.rvalue(&fb, Rvalue.Discriminant(p), types.I64, span)
        let dp = self.place_of_val(d)
        let bop = if post == 2 || post == 4 { Op.Eq } else { Op.Ne }
        let k: i128 = if post == 3 || post == 4 { 2 } else { 0 }
        Ok(self.rvalue(&fb, Rvalue.Bin(bop, Operand.Copy(dp), int_const(k, types.I64)), types.BOOL, span))
    }

    fn try_expr(inout self, inout fb: Fb, inner: ast.Expr, span: Span) -> Result(Val, Diag) {
        let v = self.expr(&fb, inner, None)?
        let t = v.ty
        let needs = "`?` needs an `Option` or a `Result`, found `" + self.types.show(t).as_str() + "`"
        let a = match self.types.adt_index(t) {
            Some(a) => a
            None => return Err(err(span, needs.as_str()))
        }
        let decl = self.types.adts[a as i64].decl
        let is_opt = self.lang.option == Some(decl)
        let is_res = self.lang.result == Some(decl)
        if !is_opt && !is_res {
            return Err(err(span, needs.as_str()))
        }
        let vs = self.variants_of(t)
        let ok_name = if is_opt { "Some" } else { "Ok" }
        let err_name = if is_opt { "None" } else { "Err" }
        let ok = variant_index(vs, ok_name)
        let errv = variant_index(vs, err_name)
        let ret_ty = fb.ty_of(mir.RET)
        var rd: Option(u32) = None
        match self.types.adt_index(ret_ty) {
            Some(ra) => rd = Some(self.types.adts[ra as i64].decl)
            None => {}
        }
        if rd != Some(decl) || !is_ret_value(fb.ret_mode) {
            return Err(err(span, ("`?` returns early with the `" + err_name + "`, so the function must return an `" + (if is_opt { "Option" } else { "Result" }) + "`").as_str()))
        }
        // Own the value, then switch on it.
        let o = self.operand(&fb, v, span)?
        let tmp = fb.temp(t, span)
        fb.assign(Place.local(tmp), Rvalue.Use(o), span)
        let d = self.rvalue(&fb, Rvalue.Discriminant(Place.local(tmp)), types.I64, span)
        let dp = self.place_of_val(d)
        let okb = fb.new_block()
        let errb = fb.new_block()
        fb.term(Term.Switch(Operand.Copy(dp), switch1(ok as i128, okb), errb))
        fb.switch_to(errb)
        let rvs = self.variants_of(ret_ty)
        let rerr = variant_index(rvs, err_name)
        var payload = Vec(Operand).new()
        if is_res {
            let et = vs[errv].fields[0]
            let rt = rvs[rerr].fields[0]
            if et != rt {
                return Err(err(span, ("the error is `" + self.types.show(et).as_str() + "` but the function returns errors of type `" + self.types.show(rt).as_str() + "`").as_str()))
            }
            payload.push(Operand.Move(Place.local(tmp).with(Proj.Variant(errv as u32)).with(Proj.Field(0))))
        }
        fb.assign(Place.local(mir.RET), Rvalue.Aggregate(mir.Agg.Variant(ret_ty, rerr as u32), payload), span)
        fb.push(Stmt.Forget(tmp))
        self.exit_to(&fb, 0)
        fb.term(Term.Return)
        fb.switch_to(okb)
        let has = vs[ok].fields.len() > 0
        let pt = if has { vs[ok].fields[0] } else { types.UNIT }
        let out = fb.temp(pt, span)
        if has {
            fb.assign(Place.local(out), Rvalue.Use(Operand.Move(Place.local(tmp).with(Proj.Variant(ok as u32)).with(Proj.Field(0)))), span)
        }
        fb.push(Stmt.Forget(tmp))
        Ok(Val { vk: VK.Place(Place.local(out)), ty: pt, temp: true })
    }

    // ---- loops ----

    fn for_expr(inout self, inout fb: Fb, index: Option(ast.ForIndex), pat: ast.Pat, it: ast.Expr, body: ast.Block, span: Span) -> Result(Val, Diag) {
        fb.push_scope(false)
        // `for i in a..b`
        match it.kind {
            Range(lo, hi) => match lo {
                Some(lo) => match hi {
                    Some(hi) => return self.for_range(&fb, index, pat, lo.deref(), hi.deref(), it.span, body, span)
                    None => return Err(err(it.span, "a `for` range needs both ends"))
                }
                None => return Err(err(it.span, "a `for` range needs both ends"))
            }
            _ => {}
        }
        self.for_iter(&fb, index, pat, it, body, span)
    }

    fn for_range(inout self, inout fb: Fb, index: Option(ast.ForIndex), pat: ast.Pat, lo: ast.Expr, hi: ast.Expr, it_span: Span, body: ast.Block, span: Span) -> Result(Val, Diag) {
        var lv = self.expr(&fb, lo, None)?
        let hv = self.expr(&fb, hi, Some(lv.ty))?
        let is_int_lit = match lo.kind {
            Int(_) => true
            _ => false
        }
        if is_int_lit && hv.ty != lv.ty {
            lv = self.expr(&fb, lo, Some(hv.ty))?
        }
        let t = lv.ty
        if !self.types.is_int(t) || hv.ty != t {
            return Err(err(it_span, ("a range needs two integers of the same type, found `" + self.types.show(t).as_str() + "` and `" + self.types.show(hv.ty).as_str() + "`").as_str()))
        }
        let lo_o = self.operand(&fb, lv, lo.span)?
        let hi_o = self.operand(&fb, hv, hi.span)?
        let i = fb.scope_local(t, true, span)
        let end = fb.scope_local(t, false, span)
        fb.assign(Place.local(i), Rvalue.Use(lo_o), span)
        fb.assign(Place.local(end), Rvalue.Use(hi_o), span)
        let head = fb.new_block()
        let step = fb.new_block()
        let exit = fb.new_block()
        fb.goto(head)
        let c = fb.temp(types.BOOL, span)
        fb.assign(Place.local(c), Rvalue.Bin(Op.Lt, copy_of(i), copy_of(end)), span)
        let bb = fb.new_block()
        fb.term(Term.Switch(copy_of(c), switch1(0, exit), bb))
        fb.switch_to(bb)
        fb.push_scope(false)
        match pat.kind {
            Name(n, _) => {
                let x = fb.declare(n.as_str(), t, false, VarKind.Owned, pat.span)
                fb.assign(Place.local(x), Rvalue.Use(copy_of(i)), span)
            }
            Wild => {}
            _ => return Err(err(pat.span, "a range loop binds one name"))
        }
        if index.is_some() {
            return Err(err(span, "a range loop has no separate index"))
        }
        fb.loops.push(LoopCtx { brk: exit, cont: step, depth: fb.depth() - 1 })
        self.block(&fb, body, Some(types.UNIT), false)?
        fb.loops.pop()
        self.pop_scope(&fb)
        fb.goto(step)
        fb.assign(Place.local(i), Rvalue.Bin(Op.AddWrap, copy_of(i), int_const(1, t)), span)
        fb.goto(head)
        fb.switch_to(exit)
        self.pop_scope(&fb)
        Ok(val_unit())
    }

    // A loop over an iterator, or what gives one or a view.
    fn for_iter(inout self, inout fb: Fb, index: Option(ast.ForIndex), pat: ast.Pat, it: ast.Expr, body: ast.Block, span: Span) -> Result(Val, Diag) {
        var v = self.expr(&fb, it, None)?
        // A borrow held as a value (a `ref Vec(T)` field): what it points to.
        if self.types.is_ref(v.ty) {
            v = self.auto_deref(&fb, v, it.span)?
        }
        // Arrays, slices and strings: by index.
        match self.types.kind(v.ty).clone() {
            Array(e, _) => {
                let st = self.view_ty(TyKind.Slice(e))
                v = self.coerce(&fb, v, st, it.span)?
            }
            _ => {}
        }
        let is_view = match self.types.kind(v.ty) {
            Slice(_) | Str => true
            _ => false
        }
        if is_view {
            let r = self.for_view(&fb, index, pat, v, body, span)
            self.pop_scope(&fb)
            return r
        }
        if self.types.adt_index(v.ty).is_none() {
            return Err(err(it.span, ("cannot loop over `" + self.types.show(v.ty).as_str() + "`").as_str()))
        }
        // An iterator (`next`), or something with `iter()`.
        var iter_v = val_unit()
        if self.find_method(v.ty, "next")?.is_some() {
            iter_v = v
        } else if self.find_method(v.ty, "iter")?.is_some() {
            iter_v = self.method_call_val(&fb, v, "iter", Vec(Val).new(), it.span, None)?
        } else if self.find_method(v.ty, "as_slice")?.is_some() || self.find_method(v.ty, "as_str")?.is_some() {
            let name = if self.find_method(v.ty, "as_slice")?.is_some() { "as_slice" } else { "as_str" }
            let sv = self.method_call_val(&fb, v, name, Vec(Val).new(), it.span, None)?
            let r = self.for_view(&fb, index, pat, sv, body, span)
            self.pop_scope(&fb)
            return r
        } else {
            return Err(err(it.span, ("cannot loop over `" + self.types.show(v.ty).as_str() + "`: it has no `next` or `iter` method").as_str()))
        }
        let it_t = iter_v.ty
        let o = self.operand(&fb, iter_v, it.span)?
        let itl = fb.scope_local(it_t, true, span)
        fb.assign(Place.local(itl), Rvalue.Use(o), span)
        var idx: Option(u32) = None
        if index.is_some() {
            let l = fb.scope_local(types.I64, true, span)
            fb.assign(Place.local(l), Rvalue.Use(int_const(0, types.I64)), span)
            idx = Some(l)
        }
        let head = fb.new_block()
        let step = fb.new_block()
        let exit = fb.new_block()
        fb.goto(head)
        fb.push_scope(true)
        let nv = self.method_call_val(&fb, val_place(Place.local(itl), it_t), "next", Vec(Val).new(), it.span, None)?
        let nt = nv.ty
        var ok = false
        match self.types.adt_index(nt) {
            Some(a) => ok = self.lang.option == Some(self.types.adts[a as i64].decl)
            None => {}
        }
        if !ok {
            return Err(err(it.span, ("`next` must return an `Option`, found `" + self.types.show(nt).as_str() + "`").as_str()))
        }
        let o = self.operand(&fb, nv, it.span)?
        let cur = fb.new_local(nt, None, true, LocalKind.Temp, span)
        fb.push(Stmt.StorageLive(cur))
        fb.assign(Place.local(cur), Rvalue.Use(o), span)
        let vs = self.variants_of(nt)
        let some = variant_index(vs, "Some") as u32
        self.pop_scope(&fb)
        let d = fb.new_local(types.I64, None, true, LocalKind.Temp, span)
        fb.assign(Place.local(d), Rvalue.Discriminant(Place.local(cur)), span)
        let bb = fb.new_block()
        let none_b = fb.new_block()
        fb.term(Term.Switch(copy_of(d), switch1(some as i128, bb), none_b))
        fb.switch_to(none_b)
        fb.push(Stmt.Forget(cur))
        fb.push(Stmt.StorageDead(cur))
        fb.goto(exit)
        fb.switch_to(bb)
        fb.push_scope(false)
        let et = vs[some as i64].fields[0]
        let item = Val { vk: VK.Op(Operand.Move(Place.local(cur).with(Proj.Variant(some)).with(Proj.Field(0)))), ty: et, temp: false }
        match index {
            Some(ix) => {
                let il = fb.declare(ix.name.as_str(), types.I64, false, VarKind.Owned, ix.span)
                fb.assign(Place.local(il), Rvalue.Use(copy_of(idx.unwrap())), span)
            }
            None => {}
        }
        self.destructure(&fb, pat, item, BindMode.Owned, span)?
        fb.push(Stmt.Forget(cur))
        fb.push(Stmt.StorageDead(cur))
        fb.loops.push(LoopCtx { brk: exit, cont: step, depth: fb.depth() - 1 })
        self.block(&fb, body, Some(types.UNIT), false)?
        fb.loops.pop()
        self.pop_scope(&fb)
        fb.goto(step)
        match idx {
            Some(l) => fb.assign(Place.local(l), Rvalue.Bin(Op.AddWrap, copy_of(l), int_const(1, types.I64)), span)
            None => {}
        }
        fb.goto(head)
        fb.switch_to(exit)
        self.pop_scope(&fb)
        Ok(val_unit())
    }

    // A loop over a slice or `str`, by index; elements are borrowed (or
    // copied, if plain).
    fn for_view(inout self, inout fb: Fb, index: Option(ast.ForIndex), pat: ast.Pat, sink v: Val, body: ast.Block, span: Span) -> Result(Val, Diag) {
        let vt = v.ty
        let et = match self.types.kind(vt) {
            Slice(e) => e
            _ => types.U8
        }
        let o = self.operand(&fb, v, span)?
        let view = fb.scope_local(vt, false, span)
        fb.assign(Place.local(view), Rvalue.Use(o), span)
        let i = fb.scope_local(types.I64, true, span)
        fb.assign(Place.local(i), Rvalue.Use(int_const(0, types.I64)), span)
        let head = fb.new_block()
        let step = fb.new_block()
        let exit = fb.new_block()
        fb.goto(head)
        let c = fb.temp(types.BOOL, span)
        fb.assign(Place.local(c), Rvalue.Bin(Op.Lt, copy_of(i), Operand.Copy(Place.local(view).with(Proj.Field(1)))), span)
        let bb = fb.new_block()
        fb.term(Term.Switch(copy_of(c), switch1(0, exit), bb))
        fb.switch_to(bb)
        fb.push_scope(false)
        let pt = self.types.ptr(et)
        let a = fb.temp(pt, span)
        fb.assign(Place.local(a), Rvalue.Offset(Operand.Copy(Place.local(view).with(Proj.Field(0))), copy_of(i)), span)
        match index {
            Some(ix) => {
                let il = fb.declare(ix.name.as_str(), types.I64, false, VarKind.Owned, ix.span)
                fb.assign(Place.local(il), Rvalue.Use(copy_of(i)), span)
            }
            None => {}
        }
        let elem = val_place(Place.local(a).with(Proj.Deref), et)
        self.destructure(&fb, pat, elem, BindMode.Auto, span)?
        fb.loops.push(LoopCtx { brk: exit, cont: step, depth: fb.depth() - 1 })
        self.block(&fb, body, Some(types.UNIT), false)?
        fb.loops.pop()
        self.pop_scope(&fb)
        fb.goto(step)
        fb.assign(Place.local(i), Rvalue.Bin(Op.AddWrap, copy_of(i), int_const(1, types.I64)), span)
        fb.goto(head)
        fb.switch_to(exit)
        Ok(val_unit())
    }

    // ---- closures ----

    fn known_closure(self, fb: Fb, p: Place) -> Option((u32, bool)) {
        for c in self.comptime_closures {
            if c.id == fb.id && c.place == p { return Some((c.lambda, c.specialized)) }
        }
        None
    }

    fn clear_closures(inout self, id: u32) {
        var kept = Vec(sema.ComptimeClosure).new()
        for c in mem.replace(&self.comptime_closures, Vec(sema.ComptimeClosure).new()).into_iter() {
            if c.id != id { kept.push(c) }
        }
        self.comptime_closures = kept
    }

    fn lambda(inout self, inout fb: Fb, params: Vec(ast.LambdaParam), ret: Option(ast.Ty), body: ast.Block, exp: Option(u32), expected_params: Option(Vec(u32)), span: Span) -> Result(Val, Diag) {
        let scoped_work = fb.scoped_work
        fb.scoped_work = false
        let env = fb.env.clone()
        var exp_sig: Option(types.Sig) = None
        var want_ptr = false
        var owned = false
        match exp {
            Some(t) => match self.types.kind(t).clone() {
                Closure(sg) => exp_sig = Some(sg)
                DynFn(sg) => {
                    exp_sig = Some(sg)
                    owned = true
                }
                FnPtr(sg) => {
                    exp_sig = Some(sg)
                    want_ptr = true
                }
                _ => {}
            }
            None => {}
        }
        match exp_sig.clone() {
            Some(sg) => {
                if sg.variadic { return Err(err(span, "a variadic C function pointer needs an extern function, not a closure")) }
                if sg.params.len() != params.len() {
                    var m = String.from("a closure with ")
                    sg.params.len().show(&m)
                    m.push_str(" parameter(s) is expected")
                    return Err(err(span, m.as_str()))
                }
            }
            None => {}
        }
        match expected_params {
            Some(ps) => {
                if ps.len() != params.len() {
                    return Err(err(span, "the closure has the wrong number of parameters"))
                }
            }
            None => {}
        }
        // Parameter types: written, or the expected ones (already lowered:
        // borrows for non-plain values).
        var ptys = Vec(u32).new()
        for i, p in params {
            match p.ty {
                Some(t) => {
                    let t = self.resolve_ty(t, env)?
                    let c_value = match exp_sig.clone() { Some(sg) => want_ptr && sg.c_abi, None => false }
                    ptys.push(if c_value { t } else { self.param_local_ty(ast.Mode.Let, t).0 })
                }
                None => match exp_sig.clone() {
                    Some(sg) => ptys.push(sg.params[i])
                    None => match expected_params {
                        Some(ps) => ptys.push(ps[i])
                        None => return Err(err(p.span, "the type of this closure parameter must be written"))
                    }
                }
            }
        }
        // Captures: names used inside that are variables outside.
        var used = Vec(String).new()
        collect_names_block(body, &used)
        var caps = Vec(Capture).new()
        for n in used {
            var skip = false
            for p in params {
                if p.name == n {
                    skip = true
                }
            }
            for c in caps {
                if c.name == n {
                    skip = true
                }
            }
            if skip {
                continue
            }
            match fb.lookup(n.as_str()) {
                Some(v) => {
                    let p = self.var_place(fb, v)
                    let t = self.place_ty(fb, p)
                    let m = self.place_mutable(fb, p)
                    let known = self.known_closure(fb, p)
                    caps.push(Capture { name: n.clone(), place: p, ty: t, mutable: m, closure: known })
                }
                None => {}
            }
        }
        if want_ptr && caps.len() > 0 {
            return Err(err(span, ("a `fnptr` cannot capture variables, and this closure uses `" + caps[0].name.as_str() + "`").as_str()))
        }
        // A `dyn fn` owns what it captures: the values themselves, which
        // its body only reads.
        var env_fields = Vec(u32).new()
        for c in caps {
            if scoped_work && self.may_hold_closure(c.ty, 0) {
                return Err(err(span, "a scoped thread cannot capture a borrowed closure; call a function or capture an owning `dyn fn` instead"))
            }
            if scoped_work && ((c.mutable && self.types.is_view(c.ty)) || self.may_hold_writable_view(c.ty, 0)) {
                return Err(err(span, "a scoped thread cannot capture a mutable or interior value that holds borrows; store owned values instead"))
            }
            if owned {
                if self.types.is_view(c.ty) {
                    return Err(err(span, ("a `dyn fn` owns what it captures, so it cannot capture `" + c.name.as_str() + "`, which holds a borrow (`" + self.types.show(c.ty).as_str() + "`)").as_str()))
                }
                env_fields.push(c.ty)
            } else {
                env_fields.push(if c.mutable { self.types.refmut(c.ty) } else { self.types.refty(c.ty) })
            }
        }
        let env_t = self.types.tuple(env_fields.clone())
        let env_ref = self.types.refty(env_t)
        // The lifted function.
        let id = self.out.len() as u32
        var ret_t: Option(u32) = None
        match ret {
            Some(r) => ret_t = Some(self.resolve_ty(r, env)?)
            None => match exp_sig.clone() {
                Some(sg) => ret_t = Some(sg.ret)
                None => {}
            }
        }
        var lparams = Vec(u32).new()
        if !want_ptr {
            lparams.push(env_ref)
        }
        for t in ptys {
            lparams.push(t)
        }
        let n = self.next_lambda()
        var fname = if fb.id as i64 < self.out.len() { self.out[fb.id as i64].name.clone() } else { String.from("comptime") }
        fname.push_str(".closure")
        n.show(&fname)
        var symbol = String.from("closure.")
        n.show(&symbol)
        symbol.push('.')
        id.show(&symbol)
        var pass = Vec(mir.ParamPass).new()
        for t in lparams {
            pass.push(if self.types.is_ref(t) { mir.ParamPass.Borrow } else { mir.ParamPass.Value })
        }
        let r0 = match ret_t {
            Some(t) => t
            None => types.UNIT
        }
        self.out.push(mir.Function {
            symbol: symbol
            name: fname
            sig: types.Sig { params: lparams.clone(), ret: r0, c_abi: false, variadic: false }
            pass: pass
            body: None
            linkage: mir.Linkage.Internal
            variadic: false
            returns_ref: false
            span: span
        })
        self.inst_info.push(None)
        var lfb = self.lambda_fb(fb, id, env, r0, want_ptr, env_ref, caps, params, ptys, lparams.len(), span)
        lfb.owned_env = owned
        // The return type, if not known, is the body's.
        var rt = r0
        if ret_t.is_none() {
            self.prepare_thread_scopes(&lfb, body.span)?
            lfb.push_scope(true)
            let probe = self.block(&lfb, body, None, true)?
            rt = if probe.ty == types.NEVER { types.UNIT } else { probe.ty }
            // Lower again with the type known.
            self.clear_closures(id)
            lfb = self.lambda_fb(fb, id, env, rt, want_ptr, env_ref, caps, params, ptys, lparams.len(), span)
            lfb.owned_env = owned
            self.out[id as i64].sig.ret = rt
        }
        lfb.body.locals[0].ty = rt
        self.lower_body(&lfb, body, rt)?
        match lfb {
            Fb { body, .. } => self.out[id as i64].body = Some(body)
        }
        self.clear_closures(id)
        let c_abi = match exp_sig.clone() { Some(sg) => want_ptr && sg.c_abi, None => false }
        self.out[id as i64].sig.c_abi = c_abi
        let sig = types.Sig { params: ptys, ret: rt, c_abi: c_abi, variadic: false }
        self.last_lambda = Some((id, env_ref))
        if want_ptr {
            let t = self.types.intern(TyKind.FnPtr(sig))
            return Ok(val_op(Operand.Const(Const.Fn(id)), t))
        }
        if owned {
            // The captured values move (or copy) into the environment,
            // which moves to the heap.
            var ops = Vec(Operand).new()
            for c in caps {
                ops.push(self.operand(&fb, val_place(c.place.clone(), c.ty), span)?)
            }
            let envl = fb.temp(env_t, span)
            fb.assign(Place.local(envl), Rvalue.Aggregate(mir.Agg.Struct(env_t), ops), span)
            let data = self.box_dyn(&fb, val_place(Place.local(envl), env_t), span)?
            var fns = Vec(u32).new()
            fns.push(self.dyn_destroy(env_t, span)?)
            fns.push(self.dyn_fn_thunk(id, env_ref, sig.clone(), span))
            let dt = self.types.intern(TyKind.DynFn(sig))
            var dops = Vec(Operand).new()
            dops.push(data)
            dops.push(Operand.Const(Const.Vtable(fns)))
            return Ok(self.rvalue(&fb, Rvalue.Aggregate(mir.Agg.Struct(dt), dops), dt, span))
        }
        // The environment lives as long as the block around the closure.
        let envl = if scoped_work { fb.temp(env_t, span) } else { fb.block_temp(env_t, span) }
        var ops = Vec(Operand).new()
        for i, c in caps {
            let r = if scoped_work { fb.temp(env_fields[i], span) } else { fb.block_temp(env_fields[i], span) }
            fb.assign(Place.local(r), if c.mutable { Rvalue.RefMut(c.place.clone()) } else { Rvalue.Ref(c.place.clone()) }, span)
            ops.push(Operand.Move(Place.local(r)))
        }
        fb.assign(Place.local(envl), Rvalue.Aggregate(mir.Agg.Struct(env_t), ops), span)
        if scoped_work {
            return Ok(Val { vk: VK.Place(Place.local(envl)), ty: env_t, temp: true })
        }
        let er = fb.block_temp(env_ref, span)
        fb.assign(Place.local(er), Rvalue.Ref(Place.local(envl)), span)
        let ct = self.types.intern(TyKind.Closure(sig))
        var cops = Vec(Operand).new()
        cops.push(Operand.Const(Const.Fn(id)))
        cops.push(copy_of(er))
        let result = self.rvalue(&fb, Rvalue.Aggregate(mir.Agg.Closure(ct), cops), ct, span)
        match result.vk {
            Place(p) => self.comptime_closures.push(sema.ComptimeClosure { id: fb.id, place: p.clone(), lambda: id, specialized: false })
            _ => {}
        }
        Ok(result)
    }

    // The builder of a closure's body: its environment's captures and its
    // parameters bound.
    fn lambda_fb(inout self, fb: Fb, id: u32, env: Env, ret: u32, want_ptr: bool, env_ref: u32, caps: Vec(Capture), params: Vec(ast.LambdaParam), ptys: Vec(u32), nparams: i64, span: Span) -> Fb {
        var lfb = Fb.new(id, env.clone(), ret, ast.RetMode.Value, span)
        lfb.unsafe_depth = fb.unsafe_depth
        if !want_ptr {
            let el = lfb.new_local(env_ref, Some(String.from("env")), false, LocalKind.Arg, span)
            lfb.env_local = Some(el)
            for i, c in caps {
                let v = Var { local: el, kind: VarKind.Capture(i as u32) }
                lfb.bind_var(c.name.as_str(), v)
                match c.closure {
                    Some((lf, specialized)) => {
                        let p = self.var_place(lfb, v)
                        self.comptime_closures.push(sema.ComptimeClosure { id: id, place: p, lambda: lf, specialized: specialized })
                    }
                    None => {}
                }
            }
        }
        for i, p in params {
            let t = ptys[i]
            let kind = if self.types.is_ref(t) { VarKind.Borrow } else { VarKind.Owned }
            let l = lfb.new_local(t, Some(p.name.clone()), false, LocalKind.Arg, p.span)
            lfb.bind_var(p.name.as_str(), Var { local: l, kind: kind })
        }
        lfb.body.arg_count = nparams
        lfb
    }

    // ---- calls ----

    // A generic callback can have known inputs but an unknown result type.
    // Use those inputs to check the lambda, then infer the result from its
    // body and feed its full signature back into ordinary generic matching.
    fn callback_params(inout self, ty: ast.Ty, env: Env) -> Option(Vec(u32)) {
        match ty.kind {
            Fn(ps, _) => {
                var out = Vec(u32).new()
                for p in ps {
                    let t = self.resolve_ty(p.ty, env).ok()?
                    out.push(self.param_local_ty(p.mode, t).0)
                }
                Some(out)
            }
            _ => None
        }
    }

    fn callback_arg(inout self, inout fb: Fb, a: ast.Expr, expected: Option(u32), pattern: Option(ast.Ty), env: Env) -> Result(Val, Diag) {
        if expected.is_none() {
            match a.kind {
                Lambda(ps, ret, body) => match pattern {
                    Some(t) => match self.callback_params(t, env) {
                        Some(inputs) => return self.lambda(&fb, ps.clone(), ret.clone(), body.clone(), None, Some(inputs), a.span)
                        None => {}
                    }
                    None => {}
                }
                _ => {}
            }
        }
        self.expr(&fb, a, expected)
    }

    fn call_expr(inout self, inout fb: Fb, callee: ast.Expr, args: Vec(ast.Expr), exp: Option(u32), span: Span) -> Result(Val, Diag) {
        let env = fb.env.clone()
        match callee.kind {
            Name(n) => {
                match fb.lookup(n.as_str()) {
                    Some(v) => {
                        let p = self.var_place(fb, v)
                        let t = self.place_ty(fb, p)
                        match self.known_closure(fb, p) {
                            Some((lf, true)) => return self.call_comptime_closure(&fb, p, lf, args, span)
                            _ => {}
                        }
                        return self.call_value(&fb, val_place(p, t), args, span)
                    }
                    None => {}
                }
                if env.get(n.as_str()).is_some() {
                    return Err(err(callee.span, ("`" + n.as_str() + "` is not a function").as_str()))
                }
                match self.lookup(env.module, n.as_str()) {
                    Some(s) => match s {
                        Fn(f) => return self.call_decl(&fb, f, Vec(CVal).new(), None, args, span, exp)
                        Adt(_) => return Err(err(span, ("`" + n.as_str() + "(...)` is a type; build a value with `" + n.as_str() + " { ... }` or call one of its functions").as_str()))
                        _ => return Err(err(callee.span, ("`" + n.as_str() + "` is not a function").as_str()))
                    }
                    None => {}
                }
                match self.builtin_call(&fb, n.as_str(), args, exp, span)? {
                    Some(v) => return Ok(v)
                    None => {}
                }
                match self.variant_owner(exp, n.as_str())? {
                    Some(t) => return self.variant_value(&fb, t, n.as_str(), args, span)
                    None => {}
                }
                // `Some(x)`, `Ok(x)` without an expected type: infer from x.
                match self.prelude_variant(&fb, n.as_str(), args, span)? {
                    Some(v) => return Ok(v)
                    None => {}
                }
                Err(err(callee.span, ("unknown function `" + n.as_str() + "`").as_str()))
            }
            Field(base, name) => {
                // `module.f(...)`, `Type.f(...)`, `Enum.Variant(...)`
                match sema.expr_path(callee) {
                    Some(p) => {
                        // `T.f(...)`, with `T` a compile-time type parameter.
                        var ct_type = false
                        if p.len() == 2 && fb.lookup(p[0].as_str()).is_none() {
                            match env.get(p[0].as_str()) {
                                Some(Type(_)) => ct_type = true
                                _ => {}
                            }
                        }
                        if ct_type {
                            var one = Vec(String).new()
                            one.push(p[0].clone())
                            let t = self.resolve_path_ty_pub(one, env, span)?
                            return self.type_member(&fb, t, name.as_str(), args, exp, span, true)
                        }
                        if fb.lookup(p[0].as_str()).is_none() && env.get(p[0].as_str()).is_none() {
                            var head = Vec(String).new()
                            for i in 0..p.len() - 1 {
                                head.push(p[i].clone())
                            }
                            if p.len() > 1 {
                                match self.lookup_path(env.module, p) {
                                    Some((Fn(f), _)) => return self.call_decl(&fb, f, Vec(CVal).new(), None, args, span, exp)
                                    _ => {}
                                }
                            }
                            match self.lookup_path(env.module, head) {
                                Some((Adt(d), _)) => {
                                    let shadowed = head.len() == 1 && env.get(head[0].as_str()).is_some()
                                    if self.adts[d as i64].params().len() > 0 && !shadowed {
                                        return self.generic_static_call(&fb, d, name.as_str(), args, exp, span)
                                    }
                                }
                                _ => {}
                            }
                            if self.path_is_type(head, env) {
                                let t = self.resolve_path_ty_pub(head, env, span)?
                                return self.type_member(&fb, t, name.as_str(), args, exp, span, true)
                            }
                            match self.lookup_path(env.module, head) {
                                Some((Adt(d), _)) => {
                                    let t = self.infer_enum(d, exp, span)?
                                    return self.type_member(&fb, t, name.as_str(), args, exp, span, true)
                                }
                                _ => {}
                            }
                        }
                    }
                    None => {}
                }
                if p_is_type_call(base.deref()) {
                    match self.try_expr_ty(base.deref(), env)? {
                        Some(t) => return self.type_member(&fb, t, name.as_str(), args, exp, span, true)
                        None => {}
                    }
                }
                // A method call; a receiver passed `inout` is lowered as a
                // place to change.
                let recv = if self.method_name_inout(name.as_str()) { self.expr_mut(&fb, base.deref())? } else { self.expr(&fb, base.deref(), None)? }
                // A field holding a function value is called as one.
                match self.types.adt_index(recv.ty) {
                    Some(a) => {
                        var has_field = false
                        match self.types.adts[a as i64].body {
                            Struct(fs) => {
                                for f in fs {
                                    if f.name == name {
                                        has_field = true
                                    }
                                }
                            }
                            _ => {}
                        }
                        if has_field && self.find_method(recv.ty, name.as_str())?.is_none() {
                            let fv = self.field_of(&fb, recv, name.as_str(), span)?
                            return self.call_value(&fb, fv, args, span)
                        }
                    }
                    None => {}
                }
                self.method_call(&fb, recv, name.as_str(), args, span, exp)
            }
            _ => {
                if self.try_expr_ty(callee, env)?.is_some() {
                    let t = self.try_expr_ty(callee, env)?.unwrap()
                    return Err(err(span, ("`" + self.types.show(t).as_str() + "` is a type, not a function").as_str()))
                }
                let v = self.expr(&fb, callee, None)?
                self.call_value(&fb, v, args, span)
            }
        }
    }

    fn prelude_variant(inout self, inout fb: Fb, n: str, args: Vec(ast.Expr), span: Span) -> Result(Option(Val), Diag) {
        let decl = if n == "Some" || n == "None" {
            self.lang.option
        } else if n == "Ok" || n == "Err" {
            self.lang.result
        } else {
            None
        }
        let d = match decl {
            Some(d) => d
            None => return Ok(None)
        }
        if n == "Some" && args.len() == 1 {
            let v = self.expr(&fb, args[0], None)?
            var targs = Vec(CVal).new()
            targs.push(CVal.Type(v.ty))
            let t = self.adt_instance(d, targs, span)?
            let o = self.operand(&fb, v, span)?
            let vi = variant_index(self.types.variants(t).unwrap(), "Some")
            var ops = Vec(Operand).new()
            ops.push(o)
            return Ok(Some(self.rvalue(&fb, Rvalue.Aggregate(mir.Agg.Variant(t, vi as u32), ops), t, span)))
        }
        Err(err(span, ("the type of `" + n + "` must be known here; write its type").as_str()))
    }

    // Calls a value: a `fnptr` or a closure.
    fn call_value(inout self, inout fb: Fb, sink v: Val, args: Vec(ast.Expr), span: Span) -> Result(Val, Diag) {
        var closure = false
        let sig = match self.types.kind(v.ty) {
            DynFn(s) => {
                let s = s.clone()
                return self.call_dyn(&fb, v, 1, false, s, args, span)
            }
            FnPtr(s) => s.clone()
            Closure(s) => {
                closure = true
                s.clone()
            }
            _ => return Err(err(span, ("`" + self.types.show(v.ty).as_str() + "` is not a function").as_str()))
        }
        if (!sig.variadic && sig.params.len() != args.len()) || args.len() < sig.params.len() {
            var m = String.from("this function takes ")
            sig.params.len().show(&m)
            m.push_str(" argument(s), ")
            args.len().show(&m)
            m.push_str(" given")
            return Err(err(span, m.as_str()))
        }
        var ops = Vec(Operand).new()
        let callee_op = self.operand(&fb, v, span)?
        let ct = self.types.intern(if closure { TyKind.Closure(sig.clone()) } else { TyKind.FnPtr(sig.clone()) })
        let cl = self.operand_local(&fb, callee_op, ct, span)
        for i, a in args {
            if i < sig.params.len() { ops.push(self.arg_for_local_ty(&fb, a, sig.params[i])?) }
            else { ops.push(self.c_vararg(&fb, a)?) }
        }
        let callee = if closure { mir.Callee.Closure(copy_of(cl)) } else { mir.Callee.Ptr(copy_of(cl)) }
        self.emit_call(&fb, callee, ops, sig.ret, span)
    }

    fn c_vararg(inout self, inout fb: Fb, a: ast.Expr) -> Result(Operand, Diag) {
        var v = self.expr(&fb, a, None)?
        if v.ty == types.STR {
            let pu8 = self.types.ptr(types.U8)
            v = self.coerce(&fb, v, pu8, a.span)?
        }
        let t = v.ty
        if !self.c_type(t) {
            return Err(err(a.span, "only C-compatible value types can be passed to a C function's `...`"))
        }
        let o = self.operand(&fb, v, a.span)?
        var to: Option(u32) = None
        match self.types.kind(t).clone() {
            Int(it) => {
                if it.bits < 32 {
                    to = Some(types.I32)
                }
            }
            Float(b) => {
                if b == 32 {
                    to = Some(types.F64)
                }
            }
            Bool => to = Some(types.I32)
            _ => {}
        }
        match to {
            Some(to) => {
                let c = self.rvalue(&fb, Rvalue.Cast(o, to, mir.CastKind.Numeric), to, a.span)
                return Ok(Operand.Copy(self.place_of_val(c)))
            }
            None => return Ok(o)
        }
    }

    // An argument for a parameter whose lowered type is known (closures).
    fn arg_for_local_ty(inout self, inout fb: Fb, a: ast.Expr, pt: u32) -> Result(Operand, Diag) {
        match self.types.kind(pt).clone() {
            RefMut(inner) => {
                let (p, t) = self.mut_place(&fb, a)?
                if t != inner {
                    return Err(err(a.span, self.expected_found(inner, t).as_str()))
                }
                Ok(self.borrow_op(&fb, p, true, pt, a.span))
            }
            Ref(inner) => {
                let v = self.expr(&fb, a, Some(inner))?
                let v = self.coerce(&fb, v, inner, a.span)?
                let (p, _) = self.as_place(&fb, v, a.span)
                Ok(self.borrow_op(&fb, p, false, pt, a.span))
            }
            _ => {
                let v = self.expr(&fb, a, Some(pt))?
                let v = self.coerce(&fb, v, pt, a.span)?
                self.operand(&fb, v, a.span)
            }
        }
    }

    // Puts an operand in a local, so it can be used twice.
    pub fn operand_local(inout self, inout fb: Fb, sink o: Operand, t: u32, span: Span) -> u32 {
        match o.clone() {
            Copy(p) => {
                if p.proj.len() == 0 && !fb.body.locals[p.local as i64].mutable {
                    return p.local
                }
            }
            _ => {}
        }
        let l = fb.temp(t, span)
        fb.assign(Place.local(l), Rvalue.Use(o), span)
        l
    }

    pub fn borrow_op(inout self, inout fb: Fb, sink p: Place, mutable: bool, rt: u32, span: Span) -> Operand {
        // Borrowing through a borrow local hands on the same reference.
        if p.proj.len() == 1 && p.proj[0] == Proj.Deref && fb.ty_of(p.local) == rt && !mutable {
            return copy_of(p.local)
        }
        let t = fb.temp(rt, span)
        fb.assign(Place.local(t), if mutable { Rvalue.RefMut(p) } else { Rvalue.Ref(p) }, span)
        if mutable { Operand.Move(Place.local(t)) } else { copy_of(t) }
    }

    pub fn emit_call(inout self, inout fb: Fb, sink callee: mir.Callee, sink args: Vec(Operand), ret: u32, span: Span) -> Result(Val, Diag) {
        var projection = true
        match callee.clone() {
            Fn(f) => projection = self.out[f as i64].returns_ref
            _ => {}
        }
        let dest = fb.temp(ret, span)
        let next = fb.new_block()
        fb.term(Term.Call(callee, args, Place.local(dest), next, span))
        fb.switch_to(next)
        if ret == types.NEVER {
            fb.term(Term.Unreachable)
            return Ok(val_never())
        }
        // A function declared `-> ref T` or `-> inout T` returns a place; one
        // whose type parameter is a borrow returns that borrow as a value.
        if projection && self.types.is_ref(ret) {
            return Ok(val_place(Place.deref(dest), self.types.pointee(ret).unwrap()))
        }
        Ok(Val { vk: VK.Place(Place.local(dest)), ty: ret, temp: true })
    }

    fn call_comptime_closure(inout self, inout fb: Fb, p: Place, lf: u32, args: Vec(ast.Expr), span: Span) -> Result(Val, Diag) {
        let sig = self.out[lf as i64].sig.clone()
        if sig.params.len() != args.len() + 1 {
            var m = String.from("this closure takes ")
            (sig.params.len() - 1).show(&m)
            m.push_str(" argument(s), ")
            args.len().show(&m)
            m.push_str(" given")
            return Err(err(span, m.as_str()))
        }
        let envt = sig.params[0]
        var ops = Vec(Operand).new()
        let raw = self.types.ptr(types.U8)
        let e = fb.temp(raw, span)
        fb.assign(Place.local(e), Rvalue.Use(Operand.Copy(p.with(Proj.Field(1)))), span)
        let ec = fb.temp(envt, span)
        fb.assign(Place.local(ec), Rvalue.Cast(copy_of(e), envt, mir.CastKind.Ptr), span)
        ops.push(copy_of(ec))
        for i, a in args {
            ops.push(self.arg_for_local_ty(&fb, a, sig.params[i + 1])?)
        }
        self.emit_call(&fb, mir.Callee.Fn(lf), ops, sig.ret, span)
    }

    // A method call `recv.name(args)`.
    pub fn method_call(inout self, inout fb: Fb, sink recv: Val, name: str, args: Vec(ast.Expr), span: Span, exp: Option(u32)) -> Result(Val, Diag) {
        var recv = recv
        for _ in 0..8 {
            if self.types.is_ptr(recv.ty) {
                recv = self.auto_deref(&fb, recv, span)?
            }
            match self.types.kind(recv.ty) {
                Dyn(tr) => return self.dyn_method_call(&fb, recv, tr, name, args, span)
                _ => {}
            }
            // A borrow held as a value (`map.get(k).unwrap()`): the method
            // of what it points to, which takes it borrowed anyway, before
            // the borrow's own (`clone` would copy the borrow).
            if self.types.is_ref(recv.ty) && self.find_method(self.types.pointee(recv.ty).unwrap(), name)?.is_some() {
                recv = self.auto_deref(&fb, recv, span)?
                continue
            }
            match self.find_method(recv.ty, name)? {
                Some(h) => return self.call_decl(&fb, h.imp, h.args.clone(), Some(recv), args, span, exp)
                None => {}
            }
            if self.types.is_ref(recv.ty) {
                recv = self.auto_deref(&fb, recv, span)?
                continue
            }
            if name != "deref" && self.find_method(recv.ty, "deref")?.is_some() {
                recv = self.method_call_val(&fb, recv, "deref", Vec(Val).new(), span, None)?
                continue
            }
            break
        }
        let d = err(span, ("`" + self.types.show(recv.ty).as_str() + "` has no method `" + name + "`").as_str())
        match self.unmet_bound(recv.ty, name)? {
            Some(m) => Err(d.note(None, m.as_str()))
            None => Err(d)
        }
    }

    // A method call whose arguments are already values.
    pub fn method_call_val(inout self, inout fb: Fb, sink recv: Val, name: str, sink args: Vec(Val), span: Span, exp: Option(u32)) -> Result(Val, Diag) {
        let h = match self.find_method(recv.ty, name)? {
            Some(h) => h
            None => return Err(err(span, ("`" + self.types.show(recv.ty).as_str() + "` has no method `" + name + "`").as_str()))
        }
        self.call_decl_vals(&fb, h.imp, h.args.clone(), Some(recv), args, span, exp)
    }

    pub fn call_static(inout self, inout fb: Fb, t: u32, name: str, sink args: Vec(Val), span: Span) -> Result(Val, Diag) {
        let h = match self.find_method(t, name)? {
            Some(h) => h
            None => return Err(err(span, ("`" + self.types.show(t).as_str() + "` has no function `" + name + "`").as_str()))
        }
        self.call_decl_vals(&fb, h.imp, h.args.clone(), None, args, span, None)
    }

    // Whether a method of this name takes `inout self` (in any impl).
    pub fn method_name_inout(self, name: str) -> bool {
        for f in self.fns {
            let d = sema.at(f.decl)
            let free = match f.owner {
                Free => true
                _ => false
            }
            if d.name == name && !free && d.params.len() > 0 && d.params[0].name == "self" && d.params[0].mode == ast.Mode.Inout {
                return true
            }
        }
        false
    }

    // A call of a declared function: infers its compile-time arguments,
    // makes the instance, and passes each argument as its parameter
    // says.
    pub fn call_decl(inout self, inout fb: Fb, fid: u32, iargs: Vec(CVal), sink recv: Option(Val), args: Vec(ast.Expr), span: Span, exp: Option(u32)) -> Result(Val, Diag) {
        self.call_decl_inner(&fb, fid, iargs, recv, args, Vec(Val).new(), span, exp)
    }

    pub fn call_decl_vals(inout self, inout fb: Fb, fid: u32, iargs: Vec(CVal), sink recv: Option(Val), sink vargs: Vec(Val), span: Span, exp: Option(u32)) -> Result(Val, Diag) {
        self.call_decl_inner(&fb, fid, iargs, recv, Vec(ast.Expr).new(), vargs, span, exp)
    }

    // Follow local reborrows to a Scope parameter whose frame has a join
    // epilogue. A scope hidden in a captured environment or another struct
    // cannot keep this frame alive: lend it to a helper as `inout Scope`.
    fn scope_receiver(self, fb: Fb, p: Place, depth: i64) -> bool {
        if depth > fb.body.locals.len() { return false }
        for (local, _, _) in fb.thread_scopes {
            if p.local == local && p.proj.len() == 1 && p.proj[0] == Proj.Deref {
                return true
            }
        }
        var found = false
        for blk in fb.body.blocks {
            for s in blk.stmts {
                match s {
                    Assign(d, r, _) => if d.local == p.local && d.proj.len() == 0 {
                        found = true
                        match r {
                            RefMut(q) => {
                                if p.proj.len() == 0 || p.proj[0] != Proj.Deref { return false }
                                var q = q.clone()
                                for i in 1..p.proj.len() { q.proj.push(p.proj[i].clone()) }
                                if !self.scope_receiver(fb, q, depth + 1) { return false }
                            }
                            Use(o) => {
                                let source: Option(Place) = match o {
                                    Copy(q) => Some(q.clone())
                                    Move(q) => Some(q.clone())
                                    _ => None
                                }
                                match source {
                                    Some(q) => {
                                        var q = q
                                        for pr in p.proj { q.proj.push(pr.clone()) }
                                        if !self.scope_receiver(fb, q, depth + 1) { return false }
                                    }
                                    None => return false
                                }
                            }
                            _ => return false
                        }
                    }
                    _ => {}
                }
            }
        }
        found
    }

    // Move a fresh lambda's capture tuple into the job, rather than keeping
    // a pointer to a temporary closure environment on this thread's stack.
    fn scoped_spawn(inout self, inout fb: Fb, sink recv: Option(Val), args: Vec(ast.Expr), span: Span, exp: Option(u32)) -> Result(Val, Diag) {
        let has_recv = recv.is_some()
        let base = if has_recv { 1 } else { 2 }
        if args.len() != base && args.len() != base + 1 {
            return Err(err(span, "`Scope.spawn` takes one closure argument"))
        }
        var expected: Option(u32) = None
        if args.len() == base + 1 {
            expected = Some(self.expr_ty(args[args.len() - 2], fb.env)?)
        } else {
            match exp {
                Some(t) => match self.adt_args_of.get(t) {
                    Some(xs) => if xs.len() == 1 {
                        match xs[0] { Type(t) => expected = Some(t), _ => {} }
                    }
                    None => {}
                }
                None => {}
            }
        }
        let closure_ty: Option(u32) = match expected {
            Some(t) => Some(self.types.intern(TyKind.Closure(types.Sig { params: Vec(u32).new(), ret: t, c_abi: false, variadic: false })))
            None => None
        }
        let recv = match recv {
            Some(v) => v
            None => {
                let (p, t) = self.mut_place(&fb, args[0])?
                val_place(p, t)
            }
        }
        let p = match recv.vk {
            Place(p) => p.clone()
            _ => return Err(err(span, "`Scope.spawn` needs a mutable scope"))
        }
        if !self.scope_receiver(fb, p, 0) {
            return Err(err(span, "`Scope.spawn` needs a scope borrowed as an `inout Scope` parameter; pass captured or stored scopes to a helper first"))
        }
        let a = args[args.len() - 1]
        let (ps, ret, body) = match a.kind {
            Lambda(ps, ret, body) => (ps.clone(), ret.clone(), body.clone())
            _ => return Err(err(a.span, "`Scope.spawn` takes a closure written here (`fn() { ... }`)"))
        }
        if ps.len() != 0 { return Err(err(a.span, "a scoped thread's closure takes no parameters")) }
        fb.scoped_work = true
        let captures = self.lambda(&fb, ps, ret, body, closure_ty, None, a.span)?
        let (lf, _) = self.last_lambda.unwrap()
        let result = self.out[lf as i64].sig.ret
        let env = captures.ty
        let h = self.find_method(recv.ty, "spawn_env")?.unwrap()
        var cargs = Vec(CVal).new()
        cargs.push(CVal.Type(env))
        cargs.push(CVal.Type(result))
        let id = self.instance(h.imp, cargs, span)?
        let sig = self.out[id as i64].sig.clone()
        var ops = Vec(Operand).new()
        ops.push(self.borrow_op(&fb, p, true, sig.params[0], span))
        ops.push(self.operand(&fb, captures, a.span)?)
        ops.push(Operand.Const(Const.Fn(lf)))
        // Results may not outlive this frame's join epilogue, even when
        // the worker captures nothing. A shared loan of the checkpoint
        // anchors every handle (and any borrowed result) to this frame.
        let checkpoint = fb.thread_scopes[0].2
        ops.push(self.borrow_op(&fb, Place.local(checkpoint), false, sig.params[3], span))
        // The entry has the same pointer ABI as the lifted closure's env.
        let v = self.emit_call(&fb, mir.Callee.Fn(id), ops, sig.ret, span)?
        match exp {
            Some(t) => self.coerce(&fb, v, t, span)
            None => Ok(v)
        }
    }

    // Rust's `Args` (expressions or values already lowered) is the pair
    // `args`, `vargs`: one of them is empty.
    fn call_decl_inner(inout self, inout fb: Fb, fid: u32, iargs: Vec(CVal), sink recv: Option(Val), args: Vec(ast.Expr), sink vargs: Vec(Val), span: Span, exp: Option(u32)) -> Result(Val, Diag) {
        let info_module = self.fns[fid as i64].module
        let decl = sema.at(self.fns[fid as i64].decl)
        let module = info_module
        if self.module_name(module) == "std.thread" && decl.name == "spawn" {
            return self.scoped_spawn(&fb, recv, args, span, exp)
        }
        if !self.fns[fid as i64].public && !self.same_package(module, fb.env.module) && !self.same_owner_module(fid, fb.env.module) {
            return Err(err(span, ("`" + decl.name.as_str() + "` is private").as_str()))
        }
        if decl.is_unsafe && fb.unsafe_depth == 0 {
            return Err(err(span, ("`" + decl.name.as_str() + "` is an unsafe function; call it in `unsafe` code").as_str()))
        }
        let is_extern = match decl.kind {
            Extern => true
            _ => false
        }
        if is_extern && fb.unsafe_depth == 0 {
            return Err(err(span, ("`" + decl.name.as_str() + "` is a C function; call it in `unsafe` code").as_str()))
        }
        let params = decl.params
        let has_self = params.len() > 0 && params[0].name == "self"
        let has_recv = recv.is_some()
        let nrecv = if has_recv { 1 } else { 0 }
        let nargs0 = args.len() + vargs.len() + nrecv
        if has_recv && !has_self {
            return Err(err(span, ("`" + decl.name.as_str() + "` is not a method (it has no `self`); call it as `Type." + decl.name.as_str() + "(...)`").as_str()))
        }
        var ncomptime = 0
        var nct_all = 0
        for p in params {
            if p.mode == ast.Mode.Comptime {
                nct_all += 1
                if !self.is_closure_param(p) {
                    ncomptime += 1
                }
            }
        }
        let explicit_ct = nargs0 == params.len() && ncomptime > 0
        // The variable arguments of a C function.
        var nextra = 0
        if decl.variadic && nargs0 > params.len() && vargs.len() == 0 {
            nextra = nargs0 - params.len()
        }
        let nargs = nargs0 - nextra
        if nargs != params.len() && nargs != params.len() - ncomptime {
            let want = params.len() - ncomptime - nrecv
            var m = "`" + decl.name.as_str() + "` takes "
            want.show(&m)
            m.push_str(" argument(s), ")
            (nargs - nrecv).show(&m)
            m.push_str(" given")
            return Err(err(span, m.as_str()))
        }
        // A function of a generic type named without its arguments
        // (`Vec.new()`, `Box.new(x)`): the impl's parameters are inferred
        // with the function's own.
        let owner = self.fns[fid as i64].owner
        var impl_params = Vec(ast.Param).new()
        var impl_self: Option(ast.Ty) = None
        match owner {
            Impl(imp) => {
                if iargs.len() == 0 {
                    impl_params = sema.at(self.impls[imp as i64].decl).params.clone()
                    if impl_params.len() > 0 {
                        impl_self = Some(sema.at(self.impls[imp as i64].decl).self_ty.clone())
                    }
                }
            }
            _ => {}
        }
        let nimpl = impl_params.len()
        var env = Env.new(module)
        if nimpl == 0 {
            let (var e, _) = self.fn_env(fid, iargs)
            self.fn_self_ty(fid, &e)?
            env = e
        }
        var cargs = Vec(Option(CVal)).new()
        for _ in 0..nimpl + nct_all {
            cargs.push(None)
        }
        var ct_names = Vec(String).new()
        var ct_params = Vec(ast.Param).new()
        for p in impl_params {
            ct_names.push(p.name.clone())
            ct_params.push(p.clone())
        }
        for p in params {
            if p.mode == ast.Mode.Comptime {
                ct_names.push(p.name.clone())
                ct_params.push(p.clone())
            }
        }
        // The expected result can decide the impl's parameters first.
        if nimpl > 0 {
            match exp {
                Some(e) => match decl.ret {
                    Some(rt) => {
                        var pat = rt.clone()
                        if is_self_path(rt) {
                            pat = impl_self.clone().unwrap()
                        }
                        var binds = cargs.clone()
                        if self.match_ty_env(pat, e, ct_params, env, &binds)? {
                            cargs = binds
                        }
                    }
                    None => {}
                }
                None => {}
            }
        }
        // Lower the runtime arguments, in order, binding compile-time
        // parameters as their types are seen.
        var vals = Vec(Option(Val)).new()
        var spans = Vec(Span).new()
        var ai = 0
        var vi = 0
        var ci = nimpl
        var recv = recv
        for p in params {
            if p.mode == ast.Mode.Comptime && self.is_closure_param(p) {
                // A closure for a compile-time closure parameter: one instance
                // per closure.
                if ai >= args.len() {
                    return Err(err(span, "a closure argument is missing"))
                }
                let a = args[ai]
                ai += 1
                let known = self.partial_env_self(env, ct_names, cargs, nimpl, impl_self)
                let pty = self.resolve_ty(p.ty.clone().unwrap(), known).ok()
                var cv = CVal.Bool(false)
                var given = false
                match a.kind {
                    Name(n) => {
                        match fb.lookup(n.as_str()) {
                            Some(v) => {
                                let p = self.var_place(fb, v)
                                let lf = match self.known_closure(fb, p) {
                                    Some((lf, _)) => lf
                                    None => return Err(err(a.span, "a compile-time closure argument must have a statically known function"))
                                }
                                let lt = self.place_ty(fb, p)
                                let envt = self.out[lf as i64].sig.params[0]
                                vals.push(Some(val_place(p, lt)))
                                spans.push(a.span)
                                cv = CVal.Lambda(lf, envt)
                                given = true
                            }
                            None => {}
                        }
                    }
                    Lambda(_, _, _) => {
                        self.last_lambda = None
                        let v = self.callback_arg(&fb, a, pty, p.ty.clone(), known)?
                        let (lf, envt) = match self.last_lambda {
                            Some(x) => x
                            None => return Err(err(a.span, "expected a closure"))
                        }
                        self.last_lambda = None
                        vals.push(Some(v))
                        spans.push(a.span)
                        cv = CVal.Lambda(lf, envt)
                        given = true
                    }
                    _ => {}
                }
                if !given {
                    return Err(err(a.span, "a compile-time closure parameter takes a closure written here (`fn(x) { ... }`)"))
                }
                if pty.is_none() {
                    let v = vals[vals.len() - 1].clone().unwrap()
                    var binds = cargs.clone()
                    if !self.match_ty_env(p.ty.clone().unwrap(), v.ty, ct_params, env, &binds)? {
                        return Err(err(a.span, "this closure does not fit the compile-time parameter's type"))
                    }
                    cargs = binds
                }
                env.push(p.name.as_str(), cv.clone())
                cargs[ci] = Some(cv)
                ci += 1
                continue
            }
            if p.mode == ast.Mode.Comptime {
                if explicit_ct {
                    if ai >= args.len() {
                        return Err(err(span, "compile-time arguments must be written"))
                    }
                    let fenv = fb.env.clone()
                    let cv = self.comptime_arg(p, module, args[ai], fenv)?
                    ai += 1
                    env.push(p.name.as_str(), cv.clone())
                    cargs[ci] = Some(cv)
                }
                ci += 1
                vals.push(None)
                spans.push(span)
                continue
            }
            if p.name == "self" && recv.is_some() {
                match recv {
                    Some(r) => vals.push(Some(r.clone()))
                    None => {}
                }
                recv = None
                spans.push(span)
                continue
            }
            // The parameter's type, if the compile-time arguments so far
            // decide it.
            let known = self.partial_env_self(env, ct_names, cargs, nimpl, impl_self)
            var pty: Option(u32) = None
            match p.ty {
                Some(t) => pty = self.resolve_ty(t, known).ok()
                None => pty = known.self_ty
            }
            if ai >= args.len() {
                var v = vargs[vi].clone()
                vi += 1
                match pty {
                    Some(t) => v = self.coerce(&fb, v, t, span)?
                    None => {}
                }
                if pty.is_none() {
                    match p.ty {
                        Some(t) => {
                            var binds = cargs.clone()
                            var pat = t.clone()
                            if is_self_path(t) && impl_self.is_some() {
                                pat = impl_self.clone().unwrap()
                            }
                            if !self.match_ty_env(pat, v.ty, ct_params, env, &binds)? {
                                return Err(err(span, ("this argument has type `" + self.types.show(v.ty).as_str() + "`, which does not fit the parameter's type").as_str()))
                            }
                            cargs = binds
                        }
                        None => {}
                    }
                }
                vals.push(Some(v))
                spans.push(span)
                continue
            }
            let a = args[ai]
            ai += 1
            let sp = a.span
            var v = val_unit()
            if p.mode == ast.Mode.Inout {
                let (pl, t) = self.mut_place(&fb, a)?
                v = val_place(pl, t)
            } else {
                v = self.callback_arg(&fb, a, pty, p.ty.clone(), known)?
                var lent_str = false
                if p.mode == ast.Mode.Let && v.ty == types.STR && pty.is_some() {
                    lent_str = pty == self.string_ty()
                }
                match pty {
                    Some(t) => {
                        if !lent_str {
                            v = self.coerce(&fb, v, t, sp)?
                        }
                    }
                    None => {}
                }
            }
            if pty.is_none() {
                match p.ty {
                    Some(t) => {
                        var binds = cargs.clone()
                        var pat = t.clone()
                        if is_self_path(t) && impl_self.is_some() {
                            pat = impl_self.clone().unwrap()
                        }
                        if !self.match_ty_env(pat, v.ty, ct_params, env, &binds)? {
                            return Err(err(sp, ("this argument has type `" + self.types.show(v.ty).as_str() + "`, which does not fit the parameter's type").as_str()))
                        }
                        cargs = binds
                    }
                    None => {}
                }
            }
            vals.push(Some(v))
            spans.push(sp)
        }
        for i, p in impl_params {
            if cargs[i].is_none() {
                return Err(err(span, ("cannot infer `" + p.name.as_str() + "` of `" + decl.name.as_str() + "`; write the type's arguments").as_str()))
            }
        }
        var ci = nimpl
        for p in params {
            if p.mode != ast.Mode.Comptime {
                continue
            }
            if cargs[ci].is_none() {
                // Not inferable: maybe from the expected result type.
                match decl.ret {
                    Some(rt) => match exp {
                        Some(e) => {
                            var binds = cargs.clone()
                            if self.match_ty_env(rt, e, ct_params, env, &binds)? {
                                cargs = binds
                            }
                        }
                        None => {}
                    }
                    None => {}
                }
            }
            if cargs[ci].is_none() {
                return Err(err(span, ("cannot infer the compile-time argument `" + p.name.as_str() + "` of `" + decl.name.as_str() + "`; pass it explicitly").as_str()))
            }
            ci += 1
        }
        var all = iargs.clone()
        if nimpl > 0 {
            var ia = Vec(CVal).new()
            for i in 0..nimpl {
                ia.push(cargs[i].clone().unwrap())
            }
            let imp = match owner {
                Impl(i) => i
                _ => 0
            }
            let imodule = self.impls[imp as i64].module
            for i, p in impl_params {
                match ia[i] {
                    Type(t) => {
                        for bnd in self.param_bounds(p, imodule)? {
                            if !self.implements(bnd, t)? {
                                return Err(err(span, ("`" + self.types.show(t).as_str() + "` does not implement `" + self.traits[bnd as i64].name.as_str() + "`").as_str()))
                            }
                        }
                    }
                    _ => {}
                }
            }
            all = ia
        }
        let trait_owned = match owner {
            Trait(_) => true
            _ => false
        }
        if trait_owned && all.len() == 0 {
            all.push(CVal.Type(env.self_ty.unwrap()))
        }
        // Bounds.
        var ci = nimpl
        for p in params {
            if p.mode != ast.Mode.Comptime {
                continue
            }
            let cv = cargs[ci].clone().unwrap()
            match cv {
                Type(t) => {
                    for b in self.param_bounds(p, module)? {
                        if !self.implements(b, t)? {
                            return Err(err(span, ("`" + self.types.show(t).as_str() + "` does not implement `" + self.traits[b as i64].name.as_str() + "`, which `" + decl.name.as_str() + "` requires of `" + p.name.as_str() + "`").as_str()))
                        }
                    }
                }
                _ => {}
            }
            all.push(cv)
            ci += 1
        }
        let id = self.instance(fid, all, span)?
        let fsig = self.out[id as i64].sig.clone()
        let pass = self.out[id as i64].pass.clone()
        // Pass each argument.
        var ops = Vec(Operand).new()
        var li = 0
        for pi, p in params {
            if p.mode == ast.Mode.Comptime {
                match self.inst_env_get(id, p.name.as_str()) {
                    Some(Lambda(_, _)) => {
                        let v = self.coerce(&fb, vals[pi].clone().unwrap(), fsig.params[li], spans[pi])?
                        let o = self.operand(&fb, v, spans[pi])?
                        ops.push(o)
                        li += 1
                    }
                    _ => {}
                }
                continue
            }
            let sp = spans[pi]
            var v = vals[pi].clone().unwrap()
            let lt = fsig.params[li]
            let borrow = pass[li] == mir.ParamPass.Borrow
            // Now that the parameter's type is known, convert to it.
            if p.mode != ast.Mode.Inout {
                let vt = if borrow { self.types.pointee(lt).unwrap() } else { lt }
                // A `str` lent where a `String` is borrowed: a `String`
                // over the same bytes, without copying (`map.get("key")`).
                if borrow && v.ty == types.STR && self.string_ty() == Some(vt) {
                    var sargs = Vec(Val).new()
                    sargs.push(v)
                    v = self.call_static(&fb, vt, "from_static", sargs, sp)?
                } else {
                    v = self.coerce(&fb, v, vt, sp)?
                }
            }
            var op = copy_of(0)
            if p.mode == ast.Mode.Inout {
                let pl = match v.vk.clone() {
                    Place(pl) => pl
                    Op(_) => return Err(err(sp, "expected a place"))
                }
                if !self.place_mutable(fb, pl) {
                    return Err(err(sp, self.not_mutable_msg(fb, pl).as_str()))
                }
                if v.temp && p.name != "self" {
                    return Err(err(sp, "an `inout` argument must be a place, not a temporary value"))
                }
                op = self.borrow_op(&fb, pl, true, lt, sp)
            } else if borrow {
                let (pl, _) = self.as_place(&fb, v, sp)
                op = self.borrow_op(&fb, pl, false, lt, sp)
            } else if p.mode == ast.Mode.Let {
                // By value: plain. A view of a non-plain place: copy the bits.
                var done = false
                match v.vk.clone() {
                    Place(pl) => {
                        if !self.types.is_plain(v.ty) {
                            op = Operand.Copy(pl)
                            done = true
                        }
                    }
                    Op(_) => {}
                }
                if !done {
                    op = self.operand(&fb, v, sp)?
                }
            } else {
                op = self.operand(&fb, v, sp)?
            }
            ops.push(op)
            li += 1
        }
        // The variable arguments use the same promotions as fnptr calls.
        for i in args.len() - nextra..args.len() { ops.push(self.c_vararg(&fb, args[i])?) }
        self.emit_call(&fb, mir.Callee.Fn(id), ops, fsig.ret, span)
    }

    fn inst_env_get(self, id: u32, name: str) -> Option(CVal) {
        if id as i64 >= self.inst_info.len() {
            return None
        }
        match self.inst_info[id as i64] {
            Some(info) => match info.env.get(name) {
                Some(c) => Some(c.clone())
                None => None
            }
            None => None
        }
    }

    fn same_owner_module(self, fid: u32, module: u32) -> bool {
        // Impl functions are visible where the type is.
        match self.fns[fid as i64].owner {
            Impl(i) => self.impls[i as i64].module == module
            _ => false
        }
    }

    fn partial_env_self(inout self, env: Env, names: Vec(String), vals: Vec(Option(CVal)), nimpl: i64, impl_self: Option(ast.Ty)) -> Env {
        var e = partial_env(env, names, vals)
        if nimpl > 0 && e.self_ty.is_none() {
            var all = true
            for i in 0..nimpl {
                if vals[i].is_none() {
                    all = false
                }
            }
            if all {
                match impl_self {
                    Some(t) => match self.resolve_ty(t, e) {
                        Ok(st) => e.self_ty = Some(st)
                        Err(_) => {}
                    }
                    None => {}
                }
            }
        }
        e
    }

    // Matches a parameter type against an argument's type, binding the
    // compile-time parameters it mentions.
    fn match_ty_env(inout self, pat: ast.Ty, t: u32, params: Vec(ast.Param), env: Env, inout binds: Vec(Option(CVal))) -> Result(bool, Diag) {
        let k = self.types.kind(t).clone()
        match pat.kind {
            Path(p, None) => {
                if p.len() == 1 {
                    for i, q in params {
                        if q.name == p[0] {
                            let v = CVal.Type(t)
                            match binds[i] {
                                Some(old) => return Ok(old == v)
                                None => {}
                            }
                            binds[i] = Some(v)
                            return Ok(true)
                        }
                    }
                }
            }
            _ => {}
        }
        match pat.kind {
            Ptr(inner) => match k {
                Ptr(x) => return self.match_ty_env(inner.deref(), x, params, env, &binds)
                _ => {}
            }
            Ref(inner, m) => match k {
                Ref(x) => {
                    if !m {
                        return self.match_ty_env(inner.deref(), x, params, env, &binds)
                    }
                }
                RefMut(x) => {
                    if m {
                        return self.match_ty_env(inner.deref(), x, params, env, &binds)
                    }
                }
                _ => {}
            }
            Slice(inner) => match k {
                Slice(x) => return self.match_ty_env(inner.deref(), x, params, env, &binds)
                // What coerces to a slice: arrays, and types with `as_slice`.
                Array(x, _) => return self.match_ty_env(inner.deref(), x, params, env, &binds)
                Adt(_) => {
                    let h = match self.find_method(t, "as_slice")? {
                        Some(h) => h
                        None => return Ok(false)
                    }
                    let id = self.instance(h.imp, h.args.clone(), pat.span)?
                    let r = self.out[id as i64].sig.ret
                    return match self.types.kind(r).clone() {
                        Slice(x) => self.match_ty_env(inner.deref(), x, params, env, &binds)
                        _ => Ok(false)
                    }
                }
                _ => {}
            }
            Array(inner, n) => match k {
                Array(x, len) => {
                    if !self.match_ty_env(inner.deref(), x, params, env, &binds)? {
                        return Ok(false)
                    }
                    match n.kind {
                        Name(nm) => {
                            for i, q in params {
                                if q.name == nm {
                                    let v = CVal.Int(len as i128)
                                    match binds[i] {
                                        Some(old) => return Ok(old == v)
                                        None => {}
                                    }
                                    binds[i] = Some(v)
                                    return Ok(true)
                                }
                            }
                        }
                        _ => {}
                    }
                    return Ok(true)
                }
                _ => {}
            }
            Tuple(ps) => match k {
                Tuple(xs) => {
                    if ps.len() != xs.len() {
                        return Ok(false)
                    }
                    for i, p in ps {
                        if !self.match_ty_env(p, xs[i], params, env, &binds)? {
                            return Ok(false)
                        }
                    }
                    return Ok(true)
                }
                _ => {}
            }
            Fn(ps, r) => match k {
                Closure(sig) => return self.match_fn_ty(ps, r, sig, params, env, &binds)
                _ => {}
            }
            FnPtr(ps, r, variadic) => match k {
                FnPtr(sig) => {
                    if sig.variadic != variadic { return Ok(false) }
                    return self.match_fn_ty(ps, r, sig, params, env, &binds)
                }
                _ => {}
            }
            Dyn(inner) => match inner.kind.clone() {
                Fn(ps, r) => match k {
                    DynFn(sig) => return self.match_fn_ty(ps, r, sig, params, env, &binds)
                    _ => {}
                }
                _ => {}
            }
            Path(p, args) => match args {
                Some(args) => match k {
                    Adt(i) => {
                        let decl = self.types.adts[i as i64].decl
                        match self.lookup_path(env.module, p) {
                            Some((Adt(d), _)) => {
                                if d != decl {
                                    return Ok(false)
                                }
                            }
                            _ => return Ok(false)
                        }
                        let concrete = self.adt_args(t)
                        if args.len() != concrete.len() {
                            return Ok(false)
                        }
                        for ai, a in args {
                            match concrete[ai] {
                                Type(ct) => {
                                    let at = match sema.expr_as_ty(a) {
                                        Some(at) => at
                                        None => return Ok(false)
                                    }
                                    if !self.match_ty_env(at, ct, params, env, &binds)? {
                                        return Ok(false)
                                    }
                                }
                                _ => {
                                    let v = concrete[ai].clone()
                                    match a.kind {
                                        Name(nm) => {
                                            for i, q in params {
                                                if q.name == nm {
                                                    match binds[i] {
                                                        Some(old) => {
                                                            if old != v {
                                                                return Ok(false)
                                                            }
                                                        }
                                                        None => {}
                                                    }
                                                    binds[i] = Some(v.clone())
                                                    break
                                                }
                                            }
                                        }
                                        _ => {}
                                    }
                                }
                            }
                        }
                        return Ok(true)
                    }
                    _ => {}
                }
                None => {}
            }
        }
        // No unknown inside: resolve it and compare.
        var known = env.clone()
        for i, q in params {
            match binds[i] {
                Some(b) => known.push(q.name.as_str(), b.clone())
                None => {}
            }
        }
        match self.resolve_ty(pat, known) {
            Ok(pt) => Ok(pt == t || self.coercible(t, pt))
            Err(_) => Ok(false)
        }
    }

    // A function type pattern against a closure's or `fnptr`'s signature.
    fn match_fn_ty(inout self, ps: Vec(ast.FnTyParam), r: Option(Box(ast.Ty)), sig: types.Sig, params: Vec(ast.Param), env: Env, inout binds: Vec(Option(CVal))) -> Result(bool, Diag) {
        if ps.len() != sig.params.len() {
            return Ok(false)
        }
        for i, p in ps {
            var x = sig.params[i]
            var known = env.clone()
            for j, prm in params {
                match binds[j] {
                    Some(v) => known.push(prm.name.as_str(), v.clone())
                    None => {}
                }
            }
            match self.resolve_ty(p.ty, known) {
                Ok(t) => {
                    let expected = if sig.c_abi { t } else { self.param_local_ty(p.mode, t).0 }
                    if expected != x { return Ok(false) }
                }
                Err(_) => {
                    let explicit_ref = match p.ty.kind { Ref(_, _) => true, _ => false }
                    if p.mode != ast.Mode.Sink && self.types.is_ref(x) && (p.mode == ast.Mode.Inout || !explicit_ref) {
                        x = self.types.pointee(x).unwrap()
                    }
                    if !self.match_ty_env(p.ty, x, params, env, &binds)? { return Ok(false) }
                }
            }
        }
        match r {
            Some(r) => self.match_ty_env(r.deref(), sig.ret, params, env, &binds)
            None => Ok(sig.ret == types.UNIT)
        }
    }

    pub fn adt_args(self, t: u32) -> Vec(CVal) {
        match self.adt_args_of.get(t) {
            Some(a) => a.clone()
            None => Vec(CVal).new()
        }
    }

    fn coercible(inout self, from: u32, to: u32) -> bool {
        if from == types.NEVER {
            return true
        }
        if self.string_ty() == Some(to) && from == types.STR {
            return true
        }
        match self.types.kind(from) {
            Array(a, _) => match self.types.kind(to) {
                Slice(b) => a == b
                _ => false
            }
            _ => false
        }
    }

    pub fn is_closure_param(self, p: ast.Param) -> bool {
        match p.ty {
            Some(t) => match t.kind {
                Fn(_, _) => true
                _ => false
            }
            None => false
        }
    }
}

fn partial_env(env: Env, names: Vec(String), vals: Vec(Option(CVal))) -> Env {
    var e = env.clone()
    for i, n in names {
        match vals[i] {
            Some(v) => e.push(n.as_str(), v.clone())
            None => {}
        }
    }
    e
}

fn is_self_path(t: ast.Ty) -> bool {
    match t.kind {
        Path(p, None) => p.len() == 1 && p[0] == "Self"
        _ => false
    }
}

fn is_literal(e: ast.Expr) -> bool {
    match e.kind {
        Int(_) | Float(_) | Char(_) => true
        _ => false
    }
}

fn block_reached(fb: Fb, b: u32) -> bool {
    for blk in fb.body.blocks {
        match blk.term {
            Goto(t) => {
                if t == b {
                    return true
                }
            }
            Switch(_, targets, otherwise) => {
                if otherwise == b {
                    return true
                }
                for x in targets {
                    if x.block == b {
                        return true
                    }
                }
            }
            Call(_, _, _, next, _) => {
                if next == b {
                    return true
                }
            }
            Assert(_, _, next, _) => {
                if next == b {
                    return true
                }
            }
            _ => {}
        }
    }
    false
}

// A variable a closure captures: borrowed into its environment.
struct Capture {
    name: String
    place: Place
    ty: u32
    mutable: bool
    closure: Option((u32, bool))
}

// Every name an expression mentions (for closure captures).
pub fn collect_names_block(b: ast.Block, inout out: Vec(String)) {
    for s in b.stmts {
        match s.kind {
            Let(l) => collect_names(l.value, &out)
            Assign(a, v) => {
                collect_names(a, &out)
                collect_names(v, &out)
            }
            OpAssign(_, a, v) => {
                collect_names(a, &out)
                collect_names(v, &out)
            }
            Expr(e) => collect_names(e, &out)
        }
    }
    match b.tail {
        Some(t) => collect_names(t.deref(), &out)
        None => {}
    }
}

pub fn collect_names(e: ast.Expr, inout out: Vec(String)) {
    match e.kind {
        Name(n) => out.push(n.clone())
        Field(b, _) => collect_names(b.deref(), &out)
        TupleField(b, _) => collect_names(b.deref(), &out)
        Unary(_, b) => collect_names(b.deref(), &out)
        Cast(b, _) => collect_names(b.deref(), &out)
        Try(b) => collect_names(b.deref(), &out)
        Move(b) => collect_names(b.deref(), &out)
        Comptime(b) => collect_names(b.deref(), &out)
        Call(c, args) => {
            collect_names(c.deref(), &out)
            for a in args {
                collect_names(a, &out)
            }
        }
        Index(a, b) => {
            collect_names(a.deref(), &out)
            collect_names(b.deref(), &out)
        }
        Binary(_, a, b) => {
            collect_names(a.deref(), &out)
            collect_names(b.deref(), &out)
        }
        ArrayRepeat(a, b) => {
            collect_names(a.deref(), &out)
            collect_names(b.deref(), &out)
        }
        StructLit(_, fs) => {
            for f in fs {
                collect_names(f.value, &out)
            }
        }
        Tuple(xs) => {
            for x in xs {
                collect_names(x, &out)
            }
        }
        Array(xs) => {
            for x in xs {
                collect_names(x, &out)
            }
        }
        Block(b) => collect_names_block(b, &out)
        Unsafe(b) => collect_names_block(b, &out)
        Loop(b) => collect_names_block(b, &out)
        If(c, t, e2) => {
            collect_names(c.deref(), &out)
            collect_names_block(t, &out)
            match e2 {
                Some(e2) => collect_names(e2.deref(), &out)
                None => {}
            }
        }
        Match(sc, arms) => {
            collect_names(sc.deref(), &out)
            for a in arms {
                match a.guard {
                    Some(g) => collect_names(g, &out)
                    None => {}
                }
                collect_names(a.body, &out)
            }
        }
        While(c, b) => {
            collect_names(c.deref(), &out)
            collect_names_block(b, &out)
        }
        For(_, _, it, b) => {
            collect_names(it.deref(), &out)
            collect_names_block(b, &out)
        }
        InlineFor(_, it, b) => {
            collect_names(it.deref(), &out)
            collect_names_block(b, &out)
        }
        InlineIf(c, t, e2) => {
            collect_names(c.deref(), &out)
            collect_names_block(t, &out)
            match e2 {
                Some(e2) => collect_names(e2.deref(), &out)
                None => {}
            }
        }
        Lambda(_, _, b) => collect_names_block(b, &out)
        Return(v) => match v {
            Some(v) => collect_names(v.deref(), &out)
            None => {}
        }
        Range(a, b) => {
            match a {
                Some(a) => collect_names(a.deref(), &out)
                None => {}
            }
            match b {
                Some(b) => collect_names(b.deref(), &out)
                None => {}
            }
        }
        _ => {}
    }
}

fn p_is_type_call(e: ast.Expr) -> bool {
    match e.kind {
        Call(c, _) => sema.expr_path(c.deref()).is_some()
        _ => false
    }
}

// The index of the variant of this name.
fn variant_index(vs: Vec(types.VariantDef), name: str) -> i64 {
    for i, v in vs {
        if v.name == name {
            return i
        }
    }
    panic("no such variant")
}

// Compile-time expressions use the ordinary expression lowerer, including
// its coercions, generic instantiation and ownership rules. Runtime locals
// are intentionally absent: only the compile-time environment is copied.
impl sema.Sema {
    pub fn eval_const_expr(inout self, e: ast.Expr, env: Env, exp: Option(u32)) -> Result(sema.TypedConst, Diag) {
        if self.eval_depth >= 128 {
            return Err(err(e.span, "compile-time evaluation exceeded its dependency depth limit"))
        }
        self.eval_depth += 1
        let result = self.eval_const_inner(e, env, exp)
        self.eval_depth -= 1
        result
    }

    // Where a `String` or `Vec(T)` keeps its elements.
    fn const_buffer(inout self, t: u32) -> Option(interp.Buffer) {
        let a = match self.types.kind(t) {
            Adt(a) => a
            _ => return None
        }
        let decl = self.types.adts[a as i64].decl
        if Some(decl) == self.lang.string {
            let v = self.types.field_tys(t)[0]
            let at = self.types.field_offsets(t)[0]
            let offs = self.types.field_offsets(v)
            return Some(interp.Buffer { ptr: at + offs[0], len: at + offs[1], elem: types.U8, view: types.STR })
        }
        if Some(decl) == self.lang.vec {
            let el = self.types.pointee(self.types.field_tys(t)[0]).unwrap()
            let offs = self.types.field_offsets(t)
            let view = self.types.intern(TyKind.Slice(el))
            return Some(interp.Buffer { ptr: offs[0], len: offs[1], elem: el, view: view })
        }
        None
    }

    // The `Drop` impls that a body's drops run, made into instances.
    fn const_drops(inout self, body: mir.Body, inout drops: Map(u32, u32), inout ids: Vec(u32), span: Span) -> Result((), Diag) {
        let dr = match self.lang.drop {
            Some(dr) => dr
            None => return Ok(())
        }
        for t in interp.drop_types(&self.types, body) {
            if drops.contains(t) { continue }
            let hit = match self.find_impl(dr, t)? {
                Some(h) => h
                None => continue
            }
            let fid = match self.impls[hit.imp as i64].fns.get("drop") {
                Some(f) => f
                None => continue
            }
            let id = self.instance(fid, hit.args, span)?
            drops.insert(t, id)
            ids.push(id)
        }
        Ok(())
    }

    fn eval_const_inner(inout self, e: ast.Expr, env: Env, exp: Option(u32)) -> Result(sema.TypedConst, Diag) {
        var fb = Fb.new(4294967295, env.clone(), exp.unwrap_or(types.UNIT), ast.RetMode.Value, e.span)
        fb.push_scope(true)
        let v = self.expr(&fb, e, exp)?
        // A `String` or `Vec(T)` result becomes a `str` or `[T]` constant.
        let buffer = self.const_buffer(v.ty)
        var view: Option(u32) = None
        match buffer { Some(b) => view = Some(b.view), None => {} }
        let v = match exp {
            Some(t) => if view == Some(t) { v } else { self.coerce(&fb, v, t, e.span)? }
            None => v
        }
        let ty = if v.ty == types.NEVER { exp.unwrap_or(types.UNIT) } else { v.ty }
        fb.body.locals[0].ty = ty
        if v.ty != types.NEVER {
            let operand = self.operand(&fb, v, e.span)?
            fb.assign(Place.local(mir.RET), Rvalue.Use(operand), e.span)
        }
        self.exit_to(&fb, 0)
        fb.term(Term.Return)
        var root = mir.Function {
            symbol: String.from("comptime")
            name: String.from("comptime")
            sig: types.Sig { params: Vec(u32).new(), ret: ty, c_abi: false, variadic: false }
            pass: Vec(mir.ParamPass).new()
            body: Some(fb.body.clone())
            linkage: mir.Linkage.Internal
            variadic: false
            returns_ref: false
            span: e.span
        }
        // Lower only the functions reachable from this expression. Draining
        // the global queue here could try to lower its enclosing function
        // a second time, or falsely make an unrelated constant cyclic.
        // Destructors the evaluation may run are reachable too.
        var ids = Vec(u32).new()
        var drops = Map(u32, u32).new()
        match root.body {
            Some(body) => {
                ids = interp.function_ids(body)
                self.const_drops(body, &drops, &ids, e.span)?
            }
            None => {}
        }
        var seen = Map(u32, bool).new()
        var i = 0
        while i < ids.len() {
            let id = ids[i]
            i += 1
            if seen.contains(id) { continue }
            seen.insert(id, true)
            self.prepare_const_fn(id, e.span)?
            let lowered = self.out[id as i64].body.clone()
            match lowered {
                Some(body) => {
                    for f in interp.function_ids(body) { ids.push(f) }
                    self.const_drops(body, &drops, &ids, e.span)?
                }
                None => {}
            }
        }
        // Check snapshots: the normal compilation pipeline must still see
        // the original MIR, including when JIHOO_NO_ELAB is requested.
        elab.run(&root)?
        var functions = Vec(mir.Function).new()
        for id, f in self.out {
            var copy = f.clone()
            if seen.contains(id as u32) {
                elab.run(&copy)?
            } else {
                // Unprepared functions may still be under construction.
                // They are unreachable from this evaluation.
                copy.body = None
            }
            functions.push(copy)
        }
        let effects = check.infer_effects(self.types, functions)
        check.run_with_effects(self.types, root, effects)?
        for id, f in functions {
            if seen.contains(id as u32) { check.run_with_effects(self.types, f, effects)? }
        }
        var interpreter = interp.Interpreter.new()
        match root.body {
            Some(body) => interpreter.evaluate(&self.types, functions, drops, buffer, body, self.checked, e.span)
            None => Err(err(e.span, "compile-time expression has no body"))
        }
    }

}

// ---- dyn values ----
//
// A `dyn Trait` or `dyn fn` is a pointer to a value on the heap and a
// pointer to a table of functions: first one that drops the value and
// frees it, then one per method. A call makes an ordinary closure of the
// method's function and a borrow of the `dyn` value, and calls that, so
// the borrow checker sees the call as it sees any closure's.
impl sema.Sema {
    // Moves a value of a type with the trait into a `dyn Trait`.
    fn to_dyn(inout self, inout fb: Fb, sink v: Val, tr: u32, to: u32, span: Span) -> Result(Val, Diag) {
        let from = v.ty
        if self.types.is_view(from) {
            return Err(err(span, ("a `" + self.types.show(to).as_str() + "` owns its value, and `" + self.types.show(from).as_str() + "` holds a borrow").as_str()))
        }
        let fns = self.vtable(tr, from, span)?
        let data = self.box_dyn(&fb, v, span)?
        var ops = Vec(Operand).new()
        ops.push(data)
        ops.push(Operand.Const(Const.Vtable(fns)))
        Ok(self.rvalue(&fb, Rvalue.Aggregate(mir.Agg.Struct(to), ops), to, span))
    }

    // A named function where a `dyn fn` is expected: nothing to own.
    fn fn_to_dyn(inout self, inout fb: Fb, f: u32, sig: types.Sig, to: u32, span: Span) -> Result(Val, Diag) {
        var fns = Vec(u32).new()
        fns.push(self.dyn_destroy(types.UNIT, span)?)
        fns.push(self.closure_thunk(f, sig)?)
        var ops = Vec(Operand).new()
        ops.push(Operand.Const(Const.Null(types.BYTES)))
        ops.push(Operand.Const(Const.Vtable(fns)))
        Ok(self.rvalue(&fb, Rvalue.Aggregate(mir.Agg.Struct(to), ops), to, span))
    }

    // `std.mem.dyn_box(T, v)`: the value moved to the heap, as a `*u8`.
    fn box_dyn(inout self, inout fb: Fb, sink v: Val, span: Span) -> Result(Operand, Diag) {
        let fid = match self.lang.dyn_box {
            Some(f) => f
            None => return Err(err(span, "`dyn` values need `std.mem.dyn_box`"))
        }
        var iargs = Vec(CVal).new()
        iargs.push(CVal.Type(v.ty))
        var args = Vec(Val).new()
        args.push(v)
        let r = self.call_decl_vals(&fb, fid, iargs, None, args, span, None)?
        self.operand(&fb, r, span)
    }

    // `std.mem.dyn_drop(T)`: drops the value behind a `*u8` and frees it.
    fn dyn_destroy(inout self, t: u32, span: Span) -> Result(u32, Diag) {
        let fid = match self.lang.dyn_drop {
            Some(f) => f
            None => return Err(err(span, "`dyn` values need `std.mem.dyn_drop`"))
        }
        var iargs = Vec(CVal).new()
        iargs.push(CVal.Type(t))
        self.instance(fid, iargs, span)
    }

    // The table of a type's functions for a trait.
    fn vtable(inout self, tr: u32, t: u32, span: Span) -> Result(Vec(u32), Diag) {
        var key = String.new()
        tr.show(&key)
        key.push(',')
        t.show(&key)
        match self.vtables.get(key.clone()) {
            Some(fs) => return Ok(fs.clone())
            None => {}
        }
        let ms = self.dyn_methods(tr, span)?
        var fns = Vec(u32).new()
        fns.push(self.dyn_destroy(t, span)?)
        for m in ms {
            let hit = match self.trait_method(tr, t, m.name.as_str(), m.fid)? {
                Some(h) => h
                None => return Err(err(span, ("`" + self.types.show(t).as_str() + "` has no method `" + m.name.as_str() + "`").as_str()))
            }
            let f = self.instance(hit.imp, hit.args, span)?
            fns.push(self.method_thunk(f, t, m, span)?)
        }
        self.vtables.insert(key, fns.clone())
        Ok(fns)
    }

    // A function for a table: it takes the `dyn` value's address (as a
    // closure takes its environment) and calls method `f` of `t` with the
    // value it points to as `self`.
    fn method_thunk(inout self, f: u32, t: u32, m: sema.DynMethod, span: Span) -> Result(u32, Diag) {
        let fsig = self.out[f as i64].sig.clone()
        let fpass = self.out[f as i64].pass.clone()
        var same = fsig.ret == m.sig.ret && fsig.params.len() == m.sig.params.len() + 1
        if same {
            for i, pt in m.sig.params {
                if fsig.params[i + 1] != pt {
                    same = false
                }
            }
        }
        if !same {
            return Err(err(span, ("`" + self.out[f as i64].name.as_str() + "` has another signature than the trait's `" + m.name.as_str() + "`").as_str()))
        }
        var params = Vec(u32).new()
        var pass = Vec(mir.ParamPass).new()
        params.push(types.BYTES)
        pass.push(mir.ParamPass.Value)
        for i in 1..fsig.params.len() {
            params.push(fsig.params[i])
            pass.push(fpass[i])
        }
        let id = self.out.len() as u32
        var fb = Fb.new(id, Env.new(0), fsig.ret, ast.RetMode.Value, span)
        var locals = Vec(u32).new()
        for t in params {
            locals.push(fb.new_local(t, None, false, LocalKind.Arg, span))
        }
        fb.body.arg_count = params.len()
        let tp = self.types.ptr(t)
        let p = self.dyn_data(&fb, locals[0], tp, span)
        var args = Vec(Operand).new()
        let st = fsig.params[0]
        match fpass[0] {
            Borrow => {
                let mutable = match self.types.kind(st) {
                    RefMut(_) => true
                    _ => false
                }
                let r = fb.temp(st, span)
                fb.assign(Place.local(r), if mutable { Rvalue.RefMut(Place.deref(p)) } else { Rvalue.Ref(Place.deref(p)) }, span)
                args.push(if mutable { Operand.Move(Place.local(r)) } else { copy_of(r) })
            }
            Value => args.push(Operand.Copy(Place.deref(p)))
            Owned => return Err(err(span, "a method that takes `sink self` cannot be called through `dyn`"))
        }
        for i in 1..locals.len() {
            let l = locals[i]
            args.push(if self.types.is_plain(params[i]) { copy_of(l) } else { Operand.Move(Place.local(l)) })
        }
        let next = fb.new_block()
        fb.term(Term.Call(mir.Callee.Fn(f), args, Place.local(mir.RET), next, span))
        fb.switch_to(next)
        fb.term(Term.Return)
        let name = "dyn thunk for " + self.out[f as i64].name.as_str()
        self.push_thunk(fb, name, types.Sig { params: params, ret: fsig.ret, c_abi: false, variadic: false }, pass, span)
        Ok(id)
    }

    // The table function of a `dyn fn`: calls the closure's function with
    // its environment on the heap.
    fn dyn_fn_thunk(inout self, f: u32, env_ref: u32, sig: types.Sig, span: Span) -> u32 {
        let fpass = self.out[f as i64].pass.clone()
        var params = Vec(u32).new()
        var pass = Vec(mir.ParamPass).new()
        params.push(types.BYTES)
        pass.push(mir.ParamPass.Value)
        for i, t in sig.params {
            params.push(t)
            pass.push(fpass[i + 1])
        }
        let id = self.out.len() as u32
        var fb = Fb.new(id, Env.new(0), sig.ret, ast.RetMode.Value, span)
        var locals = Vec(u32).new()
        for t in params {
            locals.push(fb.new_local(t, None, false, LocalKind.Arg, span))
        }
        fb.body.arg_count = params.len()
        let e = self.dyn_data(&fb, locals[0], env_ref, span)
        var args = Vec(Operand).new()
        args.push(copy_of(e))
        for i in 1..locals.len() {
            let l = locals[i]
            args.push(if self.types.is_plain(params[i]) { copy_of(l) } else { Operand.Move(Place.local(l)) })
        }
        let next = fb.new_block()
        fb.term(Term.Call(mir.Callee.Fn(f), args, Place.local(mir.RET), next, span))
        fb.switch_to(next)
        fb.term(Term.Return)
        let name = "dyn thunk for " + self.out[f as i64].name.as_str()
        self.push_thunk(fb, name, types.Sig { params: params, ret: sig.ret, c_abi: false, variadic: false }, pass, span)
        id
    }

    // The data pointer of the `dyn` value that local `v` (a `*u8`) points
    // to, as type `t`.
    fn dyn_data(inout self, inout fb: Fb, v: u32, t: u32, span: Span) -> u32 {
        let pp = self.types.ptr(types.BYTES)
        let a = fb.temp(pp, span)
        fb.assign(Place.local(a), Rvalue.Cast(copy_of(v), pp, mir.CastKind.Ptr), span)
        let d = fb.temp(types.BYTES, span)
        fb.assign(Place.local(d), Rvalue.Use(Operand.Copy(Place.deref(a))), span)
        let p = fb.temp(t, span)
        fb.assign(Place.local(p), Rvalue.Cast(copy_of(d), t, mir.CastKind.Ptr), span)
        p
    }

    fn push_thunk(inout self, sink fb: Fb, sink name: String, sink sig: types.Sig, sink pass: Vec(mir.ParamPass), span: Span) {
        let id = fb.id
        var symbol = String.from("dyn.")
        id.show(&symbol)
        let body = match fb {
            Fb { body, .. } => body
        }
        self.out.push(mir.Function {
            symbol: symbol
            name: name
            sig: sig.clone()
            pass: pass
            body: Some(body)
            linkage: mir.Linkage.Internal
            variadic: false
            returns_ref: false
            span: span
        })
        self.inst_info.push(None)
    }

    // `x.name(args)` on a `dyn Trait`.
    fn dyn_method_call(inout self, inout fb: Fb, sink recv: Val, tr: u32, name: str, args: Vec(ast.Expr), span: Span) -> Result(Val, Diag) {
        let ms = self.dyn_methods(tr, span)?
        for m in ms {
            if m.name == name {
                if args.len() != m.sig.params.len() {
                    var msg = "`" + name + "` takes "
                    m.sig.params.len().show(&msg)
                    msg.push_str(" argument(s), ")
                    args.len().show(&msg)
                    msg.push_str(" given")
                    return Err(err(span, msg.as_str()))
                }
                return self.call_dyn(&fb, recv, m.slot, m.mutable, m.sig.clone(), args, span)
            }
        }
        let tn = self.types.show(recv.ty)
        if self.traits[tr as i64].fns.get(name).is_some() {
            return Err(err(span, ("`" + tn.as_str() + "` cannot call `" + name + "`: only methods that take `self` or `inout self` can be called through `dyn`").as_str()))
        }
        Err(err(span, ("`" + tn.as_str() + "` has no method `" + name + "`").as_str()))
    }

    // Calls function `slot` of a `dyn` value's table, with a borrow of the
    // value (mutable for `inout self`) as the closure's environment.
    fn call_dyn(inout self, inout fb: Fb, sink v: Val, slot: i64, mutable: bool, sig: types.Sig, args: Vec(ast.Expr), span: Span) -> Result(Val, Diag) {
        if sig.params.len() != args.len() {
            var m = String.from("this function takes ")
            sig.params.len().show(&m)
            m.push_str(" argument(s), ")
            args.len().show(&m)
            m.push_str(" given")
            return Err(err(span, m.as_str()))
        }
        let dt = v.ty
        let (p, temp) = self.as_place(&fb, v, span)
        if mutable && !temp && !self.place_mutable(fb, p) {
            return Err(err(span, self.not_mutable_msg(fb, p).as_str()))
        }
        // The table first: the borrow below is the last use of the place
        // before the call.
        let pp = self.types.ptr(types.BYTES)
        let a = fb.temp(pp, span)
        fb.assign(Place.local(a), Rvalue.Cast(Operand.Copy(p.with(Proj.Field(1))), pp, mir.CastKind.Ptr), span)
        let s = fb.temp(pp, span)
        fb.assign(Place.local(s), Rvalue.Offset(copy_of(a), int_const(slot as i128, types.I64)), span)
        let code = fb.temp(types.BYTES, span)
        fb.assign(Place.local(code), Rvalue.Use(Operand.Copy(Place.deref(s))), span)
        let rt = if mutable { self.types.refmut(dt) } else { self.types.refty(dt) }
        let r = fb.temp(rt, span)
        fb.assign(Place.local(r), if mutable { Rvalue.RefMut(p.clone()) } else { Rvalue.Ref(p.clone()) }, span)
        let ct = self.types.intern(TyKind.Closure(sig.clone()))
        let c = fb.temp(ct, span)
        var cops = Vec(Operand).new()
        cops.push(copy_of(code))
        cops.push(if mutable { Operand.Move(Place.local(r)) } else { copy_of(r) })
        fb.assign(Place.local(c), Rvalue.Aggregate(mir.Agg.Closure(ct), cops), span)
        var ops = Vec(Operand).new()
        for i, x in args {
            ops.push(self.arg_for_local_ty(&fb, x, sig.params[i])?)
        }
        self.emit_call(&fb, mir.Callee.Closure(copy_of(c)), ops, sig.ret, span)
    }
}
