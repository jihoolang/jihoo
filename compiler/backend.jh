// LLVM 21's C API. Keep the prototypes and options in step with the
// bootstrap's crates/jihoo/src/backend.rs. No C or C++ shim is needed.
import std.env
import std.ffi
import std.fs
import std.thread
import target
import timing

struct Api {
    LLVMGetVersion: fnptr(*u32, *u32, *u32)
    LLVMContextCreate: fnptr() -> *u8
    LLVMContextDispose: fnptr(*u8)
    LLVMCreateMemoryBufferWithMemoryRangeCopy: fnptr(*u8, u64, *u8) -> *u8
    LLVMParseIRInContext: fnptr(*u8, *u8, **u8, **u8) -> i32
    LLVMDisposeModule: fnptr(*u8)
    LLVMDisposeMessage: fnptr(*u8)
    LLVMVerifyModule: fnptr(*u8, i32, **u8) -> i32
    LLVMGetTargetFromTriple: fnptr(*u8, **u8, **u8) -> i32
    LLVMCreateTargetMachine: fnptr(*u8, *u8, *u8, *u8, i32, i32, i32) -> *u8
    LLVMDisposeTargetMachine: fnptr(*u8)
    LLVMCreateTargetDataLayout: fnptr(*u8) -> *u8
    LLVMSetModuleDataLayout: fnptr(*u8, *u8)
    LLVMDisposeTargetData: fnptr(*u8)
    LLVMCreatePassBuilderOptions: fnptr() -> *u8
    LLVMDisposePassBuilderOptions: fnptr(*u8)
    LLVMPassBuilderOptionsSetLoopVectorization: fnptr(*u8, i32)
    LLVMPassBuilderOptionsSetSLPVectorization: fnptr(*u8, i32)
    LLVMRunPasses: fnptr(*u8, *u8, *u8, *u8) -> *u8
    LLVMGetErrorMessage: fnptr(*u8) -> *u8
    LLVMDisposeErrorMessage: fnptr(*u8)
    LLVMTargetMachineEmitToFile: fnptr(*u8, *u8, *u8, i32, **u8) -> i32
    LLVMGetFirstFunction: fnptr(*u8) -> *u8
    LLVMGetNextFunction: fnptr(*u8) -> *u8
    LLVMSetSection: fnptr(*u8, *u8)
    LLVMWriteBitcodeToMemoryBuffer: fnptr(*u8) -> *u8
    LLVMGetBufferStart: fnptr(*u8) -> *u8
    LLVMGetBufferSize: fnptr(*u8) -> u64
    LLVMDisposeMemoryBuffer: fnptr(*u8)
    LLVMCreateMemoryBufferWithMemoryRange: fnptr(*u8, u64, *u8, i32) -> *u8
    LLVMParseBitcodeInContext2: fnptr(*u8, *u8, **u8) -> i32
    LLVMIsDeclaration: fnptr(*u8) -> i32
    LLVMGetLinkage: fnptr(*u8) -> i32
    LLVMSetLinkage: fnptr(*u8, i32)
    LLVMSetVisibility: fnptr(*u8, i32)
    LLVMIsGlobalConstant: fnptr(*u8) -> i32
    LLVMGetUnnamedAddress: fnptr(*u8) -> i32
    LLVMGetFirstGlobal: fnptr(*u8) -> *u8
    LLVMGetNextGlobal: fnptr(*u8) -> *u8
    LLVMGetFirstBasicBlock: fnptr(*u8) -> *u8
    LLVMGetNextBasicBlock: fnptr(*u8) -> *u8
    LLVMGetFirstInstruction: fnptr(*u8) -> *u8
    LLVMGetNextInstruction: fnptr(*u8) -> *u8
    LLVMSetModuleInlineAsm2: fnptr(*u8, *u8, u64)
    LLVMContextSetDiscardValueNames: fnptr(*u8, i32)
}

unsafe fn load_api(lib: ffi.Library) -> Result(Api, String) {
    Ok(Api {
        LLVMGetVersion: lib.symbol("LLVMGetVersion")? as fnptr(*u32, *u32, *u32)
        LLVMContextCreate: lib.symbol("LLVMContextCreate")? as fnptr() -> *u8
        LLVMContextDispose: lib.symbol("LLVMContextDispose")? as fnptr(*u8)
        LLVMCreateMemoryBufferWithMemoryRangeCopy:
            lib.symbol("LLVMCreateMemoryBufferWithMemoryRangeCopy")? as fnptr(*u8, u64, *u8) -> *u8
        LLVMParseIRInContext:
            lib.symbol("LLVMParseIRInContext")? as fnptr(*u8, *u8, **u8, **u8) -> i32
        LLVMDisposeModule: lib.symbol("LLVMDisposeModule")? as fnptr(*u8)
        LLVMDisposeMessage: lib.symbol("LLVMDisposeMessage")? as fnptr(*u8)
        LLVMVerifyModule: lib.symbol("LLVMVerifyModule")? as fnptr(*u8, i32, **u8) -> i32
        LLVMGetTargetFromTriple:
            lib.symbol("LLVMGetTargetFromTriple")? as fnptr(*u8, **u8, **u8) -> i32
        LLVMCreateTargetMachine: lib.symbol("LLVMCreateTargetMachine")? as
            fnptr(*u8, *u8, *u8, *u8, i32, i32, i32) -> *u8
        LLVMDisposeTargetMachine: lib.symbol("LLVMDisposeTargetMachine")? as fnptr(*u8)
        LLVMCreateTargetDataLayout: lib.symbol("LLVMCreateTargetDataLayout")? as fnptr(*u8) -> *u8
        LLVMSetModuleDataLayout: lib.symbol("LLVMSetModuleDataLayout")? as fnptr(*u8, *u8)
        LLVMDisposeTargetData: lib.symbol("LLVMDisposeTargetData")? as fnptr(*u8)
        LLVMCreatePassBuilderOptions: lib.symbol("LLVMCreatePassBuilderOptions")? as fnptr() -> *u8
        LLVMDisposePassBuilderOptions: lib.symbol("LLVMDisposePassBuilderOptions")? as fnptr(*u8)
        LLVMPassBuilderOptionsSetLoopVectorization:
            lib.symbol("LLVMPassBuilderOptionsSetLoopVectorization")? as fnptr(*u8, i32)
        LLVMPassBuilderOptionsSetSLPVectorization:
            lib.symbol("LLVMPassBuilderOptionsSetSLPVectorization")? as fnptr(*u8, i32)
        LLVMRunPasses: lib.symbol("LLVMRunPasses")? as fnptr(*u8, *u8, *u8, *u8) -> *u8
        LLVMGetErrorMessage: lib.symbol("LLVMGetErrorMessage")? as fnptr(*u8) -> *u8
        LLVMDisposeErrorMessage: lib.symbol("LLVMDisposeErrorMessage")? as fnptr(*u8)
        LLVMTargetMachineEmitToFile: lib.symbol("LLVMTargetMachineEmitToFile")? as fnptr(
            *u8,
            *u8,
            *u8,
            i32,
            **u8
        ) -> i32
        LLVMGetFirstFunction: lib.symbol("LLVMGetFirstFunction")? as fnptr(*u8) -> *u8
        LLVMGetNextFunction: lib.symbol("LLVMGetNextFunction")? as fnptr(*u8) -> *u8
        LLVMSetSection: lib.symbol("LLVMSetSection")? as fnptr(*u8, *u8)
        LLVMWriteBitcodeToMemoryBuffer:
            lib.symbol("LLVMWriteBitcodeToMemoryBuffer")? as fnptr(*u8) -> *u8
        LLVMGetBufferStart: lib.symbol("LLVMGetBufferStart")? as fnptr(*u8) -> *u8
        LLVMGetBufferSize: lib.symbol("LLVMGetBufferSize")? as fnptr(*u8) -> u64
        LLVMDisposeMemoryBuffer: lib.symbol("LLVMDisposeMemoryBuffer")? as fnptr(*u8)
        LLVMCreateMemoryBufferWithMemoryRange:
            lib.symbol("LLVMCreateMemoryBufferWithMemoryRange")? as fnptr(*u8, u64, *u8, i32) -> *u8
        LLVMParseBitcodeInContext2:
            lib.symbol("LLVMParseBitcodeInContext2")? as fnptr(*u8, *u8, **u8) -> i32
        LLVMIsDeclaration: lib.symbol("LLVMIsDeclaration")? as fnptr(*u8) -> i32
        LLVMGetLinkage: lib.symbol("LLVMGetLinkage")? as fnptr(*u8) -> i32
        LLVMSetLinkage: lib.symbol("LLVMSetLinkage")? as fnptr(*u8, i32)
        LLVMSetVisibility: lib.symbol("LLVMSetVisibility")? as fnptr(*u8, i32)
        LLVMIsGlobalConstant: lib.symbol("LLVMIsGlobalConstant")? as fnptr(*u8) -> i32
        LLVMGetUnnamedAddress: lib.symbol("LLVMGetUnnamedAddress")? as fnptr(*u8) -> i32
        LLVMGetFirstGlobal: lib.symbol("LLVMGetFirstGlobal")? as fnptr(*u8) -> *u8
        LLVMGetNextGlobal: lib.symbol("LLVMGetNextGlobal")? as fnptr(*u8) -> *u8
        LLVMGetFirstBasicBlock: lib.symbol("LLVMGetFirstBasicBlock")? as fnptr(*u8) -> *u8
        LLVMGetNextBasicBlock: lib.symbol("LLVMGetNextBasicBlock")? as fnptr(*u8) -> *u8
        LLVMGetFirstInstruction: lib.symbol("LLVMGetFirstInstruction")? as fnptr(*u8) -> *u8
        LLVMGetNextInstruction: lib.symbol("LLVMGetNextInstruction")? as fnptr(*u8) -> *u8
        LLVMSetModuleInlineAsm2: lib.symbol("LLVMSetModuleInlineAsm2")? as fnptr(*u8, *u8, u64)
        LLVMContextSetDiscardValueNames:
            lib.symbol("LLVMContextSetDiscardValueNames")? as fnptr(*u8, i32)
    })
}

unsafe fn open_llvm() -> Result(ffi.Library, String) {
    match env.get("JIHOO_LLVM") {
        Some(path) => return ffi.Library.open(path)
        None => {}
    }
    var last = String.new()
    for name in ["libLLVM-21.so", "libLLVM.so.21.1", "libLLVM.so"] {
        match ffi.Library.open(name) {
            Ok(lib) => return Ok(lib)
            Err(e) => last = e
        }
    }
    Err("cannot load LLVM 21: " + last.as_str() + " (set JIHOO_LLVM to its shared library)")
}

// Reverse destruction order: module and machine before context, all before
// the Library. This also covers every early error return.
struct Resources {
    api: Api
    ctx: *u8
    module: *u8
    machine: *u8
}

impl Drop for Resources {
    fn drop(inout self) {
        unsafe {
            if self.machine != null { self.api.LLVMDisposeTargetMachine(self.machine) }
            if self.module != null { self.api.LLVMDisposeModule(self.module) }
            if self.ctx != null { self.api.LLVMContextDispose(self.ctx) }
        }
    }
}

impl Resources {
    // Frees the module and its context before its parts are emitted.
    unsafe fn release(inout self) {
        self.api.LLVMDisposeModule(self.module)
        self.module = null
        self.api.LLVMContextDispose(self.ctx)
        self.ctx = null
    }
}

unsafe fn message(api: Api, p: *u8) -> String {
    if p == null { return String.from("unknown LLVM error") }
    let text = ffi.copy_c_string(p)
    api.LLVMDisposeMessage(p)
    text
}

// One object for the whole module, at `path` (`emit-obj`). Reading the IR,
// optimizing and emitting each end a phase of `timer`.
pub fn object(
    ir: str,
    path: str,
    opt: str,
    tgt: target.Target,
    freestanding: bool,
    inout timer: timing.Timer
) -> Result((), String) {
    unsafe { emit_objects(ir, path, false, opt, tgt, freestanding, &timer)? }
    Ok(())
}

// The objects of a program, to be linked in the returned order: `stem`
// followed by the unit number and `.o`. A large module, once optimized
// whole, is emitted in several units on separate threads.
pub fn objects(
    ir: str,
    stem: str,
    opt: str,
    tgt: target.Target,
    freestanding: bool,
    inout timer: timing.Timer
) -> Result(Vec(String), String) {
    unsafe { emit_objects(ir, stem, true, opt, tgt, freestanding, &timer) }
}

// Instructions per code generation unit, and at most this many units. The
// count depends on the module only, never on the host, so every host
// writes the same objects.
const UNIT_SIZE: i64 = 20000
const MAX_UNITS: i64 = 8

const EXTERNAL: i32 = 0
const AVAILABLE_EXTERNALLY: i32 = 1
const INTERNAL: i32 = 8
const PRIVATE: i32 = 9
const HIDDEN: i32 = 1

unsafe fn emit_objects(
    ir: str,
    out: str,
    split: bool,
    opt: str,
    tgt: target.Target,
    freestanding: bool,
    inout timer: timing.Timer
) -> Result(Vec(String), String) {
    let lib = open_llvm()?
    let api = load_api(lib)?
    var major: u32 = 0
    api.LLVMGetVersion(&major, null, null)
    if major != 21 {
        return Err("expected LLVM 21, found LLVM " + major.to_string())
    }
    let arch = match tgt {
        X86_64 => "X86"
        Aarch64 => "AArch64"
    }
    for suffix in ["TargetInfo", "Target", "TargetMC", "AsmPrinter", "AsmParser"] {
        let init = lib.symbol(("LLVMInitialize" + arch + suffix).as_str())? as fnptr()
        init()
    }
    var r = Resources { api: api, ctx: api.LLVMContextCreate(), module: null, machine: null }
    var msg: *u8 = null
    let buffer = api.LLVMCreateMemoryBufferWithMemoryRangeCopy(ir.ptr, ir.len as u64, "jihoo")
    // LLVMParseIRInContext consumes the buffer, including on failure.
    if api.LLVMParseIRInContext(r.ctx, buffer, &r.module, &msg) != 0 {
        return Err("LLVM IR: " + message(api, msg).as_str())
    }
    if api.LLVMVerifyModule(r.module, 2, &msg) != 0 {
        return Err("LLVM verification: " + message(api, msg).as_str())
    }
    if msg != null { api.LLVMDisposeMessage(msg) }
    msg = null
    timer.lap("LLVM parse")
    let triple = ffi.c_string(tgt.triple())?
    var llvm_target: *u8 = null
    if api.LLVMGetTargetFromTriple(triple.as_str().ptr, &llvm_target, &msg) != 0 {
        return Err("LLVM target: " + message(api, msg).as_str())
    }
    let cpu = match tgt {
        X86_64 => "x86-64"
        Aarch64 => "generic"
    }
    let level = (opt[2] - '0') as i32
    let machine = Machine { target: llvm_target, triple: triple.as_str().ptr, cpu, level }
    r.machine = machine.create(api)
    if r.machine == null { return Err(String.from("LLVM cannot create target machine")) }
    let data = api.LLVMCreateTargetDataLayout(r.machine)
    api.LLVMSetModuleDataLayout(r.module, data)
    api.LLVMDisposeTargetData(data)
    let pipeline = "default<" + opt[1..opt.len] + ">"
    run_passes(api, r.module, pipeline.as_str(), r.machine, level >= 2)?
    timer.lap("LLVM optimize")
    if freestanding {
        var f = api.LLVMGetFirstFunction(r.module)
        var i = 0
        while f != null {
            let section = ffi.c_string((".text.jihoo." + i.to_string()).as_str())?
            api.LLVMSetSection(f, section.as_str().ptr)
            f = api.LLVMGetNextFunction(f)
            i += 1
        }
    }
    var paths = Vec(String).new()
    let starts = if split { unit_starts(api, r.module) } else { Vec(i64).filled(1, 0) }
    if starts.len() == 1 {
        let path = if split { out + "0.o" } else { String.from(out) }
        emit(api, r.machine, r.module, path.as_str())?
        timer.lap("LLVM emit")
        paths.push(path)
        return Ok(paths)
    }
    // Every unit reads the optimized module into its own context: a context
    // belongs to one thread.
    let bitcode = api.LLVMWriteBitcodeToMemoryBuffer(r.module)
    r.release()
    return_free_memory()
    for k in 0..starts.len() {
        paths.push(out + k.to_string().as_str() + ".o")
    }
    let count = starts.len()
    let s = Split { api, machine, starts, paths }
    let result = s.halves(
        api.LLVMGetBufferStart(bitcode),
        api.LLVMGetBufferSize(bitcode),
        0,
        0,
        count
    )
    api.LLVMDisposeMemoryBuffer(bitcode)
    timer.lap("LLVM emit")
    match result {
        Ok(_) => Ok(s.paths.clone())
        Err(e) => {
            for p in s.paths { fs.remove_file(p.as_str()) }
            Err(e)
        }
    }
}

// Gives memory freed so far back to the system, where glibc has
// `malloc_trim`. New threads allocate from arenas of their own, which
// cannot reuse what the front end and the optimizer freed in this one.
unsafe fn return_free_memory() {
    match ffi.Library.open("libc.so.6") {
        Ok(libc) => match libc.symbol("malloc_trim") {
            Ok(p) => {
                let trim = p as fnptr(u64) -> i32
                let _ = trim(0)
            }
            Err(_) => {}
        }
        Err(_) => {}
    }
}

// What creates a target machine; each thread needs its own.
struct Machine {
    target: *u8
    triple: *u8
    cpu: str
    level: i32
}

impl Machine {
    unsafe fn create(self, api: Api) -> *u8 {
        api.LLVMCreateTargetMachine(
            self.target,
            self.triple,
            self.cpu.ptr,
            "".ptr,
            self.level,
            2,
            0
        )
    }
}

unsafe fn run_passes(
    api: Api,
    module: *u8,
    pipeline: str,
    machine: *u8,
    vectorize: bool
) -> Result((), String) {
    let options = api.LLVMCreatePassBuilderOptions()
    // Explicitly enable clang's vectorizers at O2/O3.
    api.LLVMPassBuilderOptionsSetLoopVectorization(options, vectorize as i32)
    api.LLVMPassBuilderOptionsSetSLPVectorization(options, vectorize as i32)
    let text = ffi.c_string(pipeline)?
    let error = api.LLVMRunPasses(module, text.as_str().ptr, machine, options)
    api.LLVMDisposePassBuilderOptions(options)
    if error != null {
        let p = api.LLVMGetErrorMessage(error)
        let text = ffi.copy_c_string(p)
        api.LLVMDisposeErrorMessage(p)
        return Err("LLVM optimization: " + text.as_str())
    }
    Ok(())
}

unsafe fn emit(api: Api, machine: *u8, module: *u8, path: str) -> Result((), String) {
    let output = ffi.c_string(path)?
    var msg: *u8 = null
    if api.LLVMTargetMachineEmitToFile(machine, module, output.as_str().ptr, 1, &msg) != 0 {
        return Err("LLVM object: " + message(api, msg).as_str())
    }
    Ok(())
}

// The index, among the defined functions in module order, of the first
// function of each unit. Units are runs of consecutive functions of about
// the same number of instructions, so that the linked program keeps the
// order of a single object.
unsafe fn unit_starts(api: Api, module: *u8) -> Vec(i64) {
    var sizes = Vec(i64).new()
    var total = 0
    var f = api.LLVMGetFirstFunction(module)
    while f != null {
        if api.LLVMIsDeclaration(f) == 0 {
            var n = 0
            var b = api.LLVMGetFirstBasicBlock(f)
            while b != null {
                var i = api.LLVMGetFirstInstruction(b)
                while i != null {
                    n += 1
                    i = api.LLVMGetNextInstruction(i)
                }
                b = api.LLVMGetNextBasicBlock(b)
            }
            sizes.push(n)
            total += n
        }
        f = api.LLVMGetNextFunction(f)
    }
    var count = min(max(total / UNIT_SIZE, 1), MAX_UNITS)
    match env.get("JIHOO_CODEGEN_UNITS") {
        Some(s) => match s.parse_int() {
            Some(n) => count = max(n, 1)
            None => {}
        }
        None => {}
    }
    var starts = Vec(i64).filled(1, 0)
    var before = 0
    for i, n in sizes {
        if i > 0 && starts.len() < count && before * count >= total * starts.len() {
            starts.push(i)
        }
        before += n
    }
    starts
}

fn is_local(linkage: i32) -> bool {
    linkage == INTERNAL || linkage == PRIVATE
}

// Keeps a definition or leaves it to other units: a local one becomes
// hidden so that the other units can refer to it, and where it is not kept
// the definition is dropped.
unsafe fn give(api: Api, value: *u8, owned: bool) {
    let local = is_local(api.LLVMGetLinkage(value))
    if owned {
        if local { api.LLVMSetLinkage(value, EXTERNAL) }
    } else {
        api.LLVMSetLinkage(value, AVAILABLE_EXTERNALLY)
    }
    if local { api.LLVMSetVisibility(value, HIDDEN) }
}

// Units are emitted by halving: each half reads its parent's module, keeps
// its own functions and writes them for its two halves, so that only a
// couple of modules' worth of memory is in use at any level. Global
// variables and module assembly (a freestanding `_start`) belong to unit 0;
// unnamed local constants are copied into every unit that uses one.
struct Split {
    api: Api
    machine: Machine
    starts: Vec(i64)
    paths: Vec(String)
}

impl Split {
    // Units `lo..hi` of the module in `bc`, which defines the functions of
    // the units from `from` on (`from <= lo`), each half on a thread.
    unsafe fn halves(
        self,
        bc: *u8,
        bc_len: u64,
        from: i64,
        lo: i64,
        hi: i64
    ) -> Result((), String) {
        let mid = lo + (hi - lo) / 2
        let (a, b) = thread.join(
            fn() { unsafe { self.units(bc, bc_len, from, lo, mid) } },
            fn() { unsafe { self.units(bc, bc_len, from, mid, hi) } }
        )
        a?
        b
    }

    unsafe fn units(self, bc: *u8, bc_len: u64, from: i64, lo: i64, hi: i64) -> Result((), String) {
        let api = self.api
        var r = Resources { api: api, ctx: api.LLVMContextCreate(), module: null, machine: null }
        // Names of instructions and arguments do not reach the object.
        api.LLVMContextSetDiscardValueNames(r.ctx, 1)
        let buffer = api.LLVMCreateMemoryBufferWithMemoryRange(bc, bc_len, "jihoo".ptr, 0)
        let failed = api.LLVMParseBitcodeInContext2(r.ctx, buffer, &r.module)
        api.LLVMDisposeMemoryBuffer(buffer)
        if failed != 0 { return Err(String.from("LLVM cannot read the optimized module")) }
        let first = self.starts[lo]
        let end = if hi < self.starts.len() { self.starts[hi] } else { -1 }
        var i = self.starts[from]
        var f = api.LLVMGetFirstFunction(r.module)
        while f != null {
            if api.LLVMIsDeclaration(f) == 0 {
                give(api, f, i >= first && (end < 0 || i < end))
                i += 1
            }
            f = api.LLVMGetNextFunction(f)
        }
        var g = api.LLVMGetFirstGlobal(r.module)
        while g != null {
            if api.LLVMIsDeclaration(g) == 0 {
                let copied = is_local(api.LLVMGetLinkage(g)) && api.LLVMIsGlobalConstant(g) != 0 &&
                    api.LLVMGetUnnamedAddress(g) != 0
                if !copied { give(api, g, lo == 0) }
            }
            g = api.LLVMGetNextGlobal(g)
        }
        if lo > 0 { api.LLVMSetModuleInlineAsm2(r.module, "".ptr, 0) }
        r.machine = self.machine.create(api)
        if r.machine == null { return Err(String.from("LLVM cannot create target machine")) }
        // Only removes what other units define and what nothing here uses.
        run_passes(api, r.module, "elim-avail-extern,globaldce", r.machine, false)?
        if hi - lo == 1 {
            return emit(api, r.machine, r.module, self.paths[lo].as_str())
        }
        let part = api.LLVMWriteBitcodeToMemoryBuffer(r.module)
        r.release()
        let result = self.halves(
            api.LLVMGetBufferStart(part),
            api.LLVMGetBufferSize(part),
            lo,
            lo,
            hi
        )
        api.LLVMDisposeMemoryBuffer(part)
        result
    }
}
