// Experimental dependent core. Programs and proofs share this syntax;
// core_lower emits MIR from the checked terms themselves. No Horn model
// or external proof checker participates in this path.
//
// This finite fragment has levelled universes, dependent functions,
// immutable I64 arrays indexed by U64 lengths, Lt, U64 equality and
// declared U64-indexed inductive propositions, and refinements {x : U64 |
// P x}, a U64 with erased evidence, data types, and owned heap buffers,
// which the kernel checks are used exactly once, and borrows of them,
// which cannot outlive the lend that made them. Equality and structural
// induction eliminate only into Prop. Runtime code has I64 arithmetic,
// which traps on overflow, and bounded loops whose body has evidence of
// its index's bound. U64 terms denote natural numbers: their addition
// traps at run time rather than wrap, so every computed value is its
// meaning, and Lt has the rules of the order of the naturals.
// There is no general recursion, axiom,
// unsafe operation or elimination of evidence into runtime data.
// Erased binders must be propositions and cannot occur in runtime terms.
import diag

pub const LIMIT: i64 = 200000
const STEPS: i64 = 1000000
pub const DEPTH: u32 = 128

#[derive(Clone, Eq)]
pub enum Arith {
    Add
    Sub
    Mul
}

#[derive(Clone, Eq)]
pub enum Term {
    Var(u32)
    Global(u32)
    Universe(u32)
    Prop
    U64
    I64
    Array(u32)
    Lt(u32, u32)
    Eq(u32, u32)
    Refl(u32)
    // P : U64 -> Prop, e : Eq a b, p : P a yields evidence of P b.
    Transport(u32, u32, u32)
    // A declared inductive proposition applied to its U64 indices.
    Ind(u32, Vec(u32))
    // Family, constructor and all of the constructor's fields.
    Con(u32, u32, Vec(u32))
    // Family, motive (U64 -> ... -> Prop), one case per constructor and
    // the evidence eliminated. Only into propositions.
    Elim(u32, u32, Vec(u32), u32)
    // I64 arithmetic. Overflow traps at runtime and is never folded.
    Arith(Arith, u32, u32)
    // fold(n, init, body): body(i, erased Lt(i, n), acc) for i in 0..n.
    Fold(u32, u32, u32)
    // Evaluate the first term for its traps, then the second. Only beta
    // reduction makes these, so call-by-value overflow traps survive
    // substitution; source and textual core cannot write them.
    Strict(u32, u32)
    // U64 addition in the naturals. Overflow traps at run time; sums are
    // compared in a canonical order, and only folded when they fit.
    UAdd(u32, u32)
    // a, b, c and evidence of Lt(a, b), for Lt(a + c, b + c).
    LtAdd(u32, u32, u32, u32)
    // a, b, c and evidence of Lt(a + c, b + c), for Lt(a, b).
    LtCancel(u32, u32, u32, u32)
    // x, y, z, Lt(x, y) and Lt(y, z + 1) (y <= z), for Lt(x, z): the
    // naturals are discrete. Not derivable from the other rules.
    LtLe(u32, u32, u32, u32, u32)
    // a, b and evidence of Lt(b, a + 1) (b <= a): a - b in the naturals,
    // which never underflows. Conversion ignores the evidence.
    USub(u32, u32, u32)
    // Lt(0, a + 1): every natural is at least 0.
    ZeroLe(u32)
    // {x : U64 | P x} for P : U64 -> Prop: a U64 with erased evidence. Its
    // runtime representation is the U64 alone.
    Refine(u32)
    // P, a : U64 and evidence of P a, of type Refine(P).
    Pack(u32, u32, u32)
    // The U64 of a refinement, and its evidence, of P (Witness(s)).
    Witness(u32)
    Proof(u32)
    // An owned heap buffer of n I64 values. Owned values are used exactly
    // once at run time; uses in types and evidence do not count.
    Buffer(u32)
    // n and x: a new buffer of n copies of x.
    Alloc(u32, u32)
    // b, i, evidence of Lt(i, n) and k: k(b[i], b), b given back to k.
    Load(u32, u32, u32, u32)
    // b, i, v and evidence of Lt(i, n): b with v at i, in place.
    Store(u32, u32, u32, u32)
    // Free b, then the rest.
    Free(u32, u32)
    // Family, a value of that boxed data type and the rest: the value and
    // every node it owns are freed, then the rest runs.
    Drop(u32, u32, u32)
    // A borrow of an owned value of type T: read any number of times, never
    // consumed or freed. It is the owner's pointer at run time.
    Ref(u32)
    // Owner x : T, f : Ref(T) -> A and g : A -> T -> R: f reads x through a
    // borrow, then g receives f's result and x back. A holds no borrow and
    // is not a function, so no borrow outlives f.
    Lend(u32, u32, u32)
    // A borrow of an owned value x : T, of type Ref(T), in types and
    // evidence only: nothing is lent at run time. Conversion reads it
    // through views, and a lend computes to its continuations on one.
    Borrow(u32)
    // Reading borrowed heap data of a family with no true indices: whether
    // it is a recursion, the family, the result type, one case per
    // constructor and the borrow. Nothing is freed; each case receives the
    // fields, those on the heap as borrows, then, in a recursion, the
    // result for each recursive field.
    View(bool, u32, u32, Vec(u32), u32)
    // Family, motive, one case per constructor and a value of a boxed data
    // type: one level of case analysis. The node is freed and each case
    // receives all of its fields, recursive ones as owned values. Elim on a
    // boxed type is structural recursion instead.
    Case(u32, u32, Vec(u32), u32)
    Pi(bool, u32, u32)
    Lam(bool, u32, u32)
    App(u32, u32)
    Natural(u64)
    Integer(i64)
    Elements(Vec(u32))
    Index(u32, u32, u32)
    Decide(u32, u32)
    // The true branch binds erased evidence of Lt a b at de Bruijn 0.
    IfLt(u32, u32, u32, u32)
    IfEq(u32, u32, u32, u32)
}

pub struct Node {
    pub term: Term
    pub span: diag.Span
}

pub struct Definition {
    pub name: String
    pub ty: u32
    pub value: u32
    pub exported: bool
    pub span: diag.Span
}

pub struct Constructor {
    pub name: String
    // A closed Pi telescope of U64 data and erased proof fields, ending
    // in its own family. Checked by the kernel, never trusted.
    pub ty: u32
}

// Families and definitions form one sequence: a family follows the first
// `globals` definitions and may use them and earlier families.
pub struct Family {
    pub name: String
    // A data type, of Type 0, rather than a proposition. Data types have
    // no recursive fields yet.
    pub data: bool
    // The first `params` of a data type's indices are parameters: each
    // constructor binds them first, erased, and returns them unchanged, so
    // case analysis fixes them from the value's type. Propositions have none.
    pub params: u32
    pub arity: u32
    pub constructors: Vec(Constructor)
    pub globals: u32
    pub span: diag.Span
}

// Computed by the kernel from a checked constructor type.
struct Field {
    erased: bool
    domain: u32
    // Indices of a recursive field, the only place its family may occur.
    recursive: Option(Vec(u32))
}

struct Signature {
    fields: Vec(Field)
    result: Vec(u32)
}

pub struct Binding {
    pub ty: u32
    pub erased: bool
}

pub struct Core {
    pub nodes: Vec(Node)
    pub definitions: Vec(Definition)
    pub families: Vec(Family)
    signatures: Vec(Vec(Signature))
    // Per checked family: a data type whose values live on the heap, because
    // a field is recursive or itself on the heap. Computed by the kernel.
    boxed: Vec(bool)
    steps: i64
    visible: u32
    visible_families: u32
    // Set while inferring the function of an application, so that only
    // the top of an application spine checks for a partial application.
    spine: bool
    // Set by lowering. Conversion computes in the pure model, where any
    // argument may be substituted; code to run binds an argument that
    // touches memory once instead.
    pub runtime: bool
    // The owners being lent, each a variable with the context length where
    // its lend is checked: inside the lend's reader, a borrow of one is the
    // reader's own borrow, which code may use.
    lent: Vec((i64, u32))
}

impl Core {
    pub fn new() -> Core {
        Core {
            nodes: Vec(Node).new(),
            definitions: Vec(Definition).new(),
            families: Vec(Family).new(),
            signatures: Vec(Vec(Signature)).new(),
            boxed: Vec(bool).new(),
            steps: 0,
            visible: 0,
            visible_families: 0,
            spine: false,
            runtime: false,
            lent: Vec((i64, u32)).new()
        }
    }

    pub fn error(self, id: u32, message: str) -> diag.Diag {
        let span = if id as i64 < self.nodes.len() { self.nodes[id as i64].span }
        else { diag.Span.nowhere() }
        diag.Diag.new(span, ("core: " + message).as_str())
    }

    pub fn add(inout self, sink term: Term, span: diag.Span) -> Result(u32, diag.Diag) {
        if self.nodes.len() >= LIMIT { return Err(diag.Diag.new(span, "core: term limit reached")) }
        let id = self.nodes.len() as u32
        self.nodes.push(Node { term, span })
        Ok(id)
    }

    pub fn term(self, id: u32) -> Term { self.nodes[id as i64].term.clone() }

    fn tick(inout self, id: u32, depth: u32) -> Result((), diag.Diag) {
        self.steps += 1
        if self.steps > STEPS { return Err(self.error(id, "checking step limit reached")) }
        if depth == 0 { return Err(self.error(id, "nesting limit reached")) }
        if id as i64 >= self.nodes.len() { return Err(self.error(id, "invalid term reference")) }
        Ok(())
    }

    // Binder-aware traversal implements weakening and capture-avoiding
    // substitution. Removing a binder rejects a reference that escapes.
    fn transform(
        inout self, id: u32, cutoff: u32, delta: i64, replacement: Option(u32), depth: u32
    ) -> Result(u32, diag.Diag) {
        self.tick(id, depth)?
        let sp = self.nodes[id as i64].span
        let term = match self.term(id) {
            Var(k) => {
                match replacement {
                    Some(value) => {
                        if k == cutoff { return self.shift(value, cutoff as i64, 0, depth - 1) }
                        Term.Var(if k > cutoff { k - 1 } else { k })
                    }
                    None => {
                        if k < cutoff { return Ok(id) }
                        let next = k as i64 + delta
                        if next < cutoff as i64 { return Err(self.error(
                            id,
                            "branch evidence escapes its scope"
                        )) }
                        Term.Var(next as u32)
                    }
                }
            }
            Pi(e, a, b) => Term.Pi(e,
                self.transform(a, cutoff, delta, replacement, depth - 1)?,
                self.transform(b, cutoff + 1, delta, replacement, depth - 1)?)
            Lam(e, a, b) => Term.Lam(e,
                self.transform(a, cutoff, delta, replacement, depth - 1)?,
                self.transform(b, cutoff + 1, delta, replacement, depth - 1)?)
            IfLt(a, b, yes, no) => Term.IfLt(
                self.transform(a, cutoff, delta, replacement, depth - 1)?,
                self.transform(b, cutoff, delta, replacement, depth - 1)?,
                self.transform(yes, cutoff + 1, delta, replacement, depth - 1)?,
                self.transform(no, cutoff, delta, replacement, depth - 1)?)
            IfEq(a, b, yes, no) => Term.IfEq(
                self.transform(a, cutoff, delta, replacement, depth - 1)?,
                self.transform(b, cutoff, delta, replacement, depth - 1)?,
                self.transform(yes, cutoff + 1, delta, replacement, depth - 1)?,
                self.transform(no, cutoff, delta, replacement, depth - 1)?)
            Eq(a, b) => Term.Eq(self.transform(a, cutoff, delta, replacement, depth - 1)?,
                self.transform(b, cutoff, delta, replacement, depth - 1)?)
            Refl(a) => Term.Refl(self.transform(a, cutoff, delta, replacement, depth - 1)?)
            Transport(f, e, p) => Term.Transport(
                self.transform(f, cutoff, delta, replacement, depth - 1)?,
                self.transform(e, cutoff, delta, replacement, depth - 1)?,
                self.transform(p, cutoff, delta, replacement, depth - 1)?)
            Ind(f, xs) => Term.Ind(
                f,
                self.transform_all(xs.as_slice(), cutoff, delta, replacement, depth)?
            )
            Con(f, k, xs) => Term.Con(
                f,
                k,
                self.transform_all(xs.as_slice(), cutoff, delta, replacement, depth)?
            )
            Elim(f, p, cases, x) => Term.Elim(f,
                self.transform(p, cutoff, delta, replacement, depth - 1)?,
                self.transform_all(cases.as_slice(), cutoff, delta, replacement, depth)?,
                self.transform(x, cutoff, delta, replacement, depth - 1)?)
            Case(f, p, cases, x) => Term.Case(f,
                self.transform(p, cutoff, delta, replacement, depth - 1)?,
                self.transform_all(cases.as_slice(), cutoff, delta, replacement, depth)?,
                self.transform(x, cutoff, delta, replacement, depth - 1)?)
            Array(n) => Term.Array(self.transform(n, cutoff, delta, replacement, depth - 1)?)
            Lt(a, b) => Term.Lt(self.transform(a, cutoff, delta, replacement, depth - 1)?,
                self.transform(b, cutoff, delta, replacement, depth - 1)?)
            App(f, a) => Term.App(self.transform(f, cutoff, delta, replacement, depth - 1)?,
                self.transform(a, cutoff, delta, replacement, depth - 1)?)
            Decide(a, b) => Term.Decide(self.transform(a, cutoff, delta, replacement, depth - 1)?,
                self.transform(b, cutoff, delta, replacement, depth - 1)?)
            Index(a, i, p) => Term.Index(self.transform(a, cutoff, delta, replacement, depth - 1)?,
                self.transform(i, cutoff, delta, replacement, depth - 1)?,
                self.transform(p, cutoff, delta, replacement, depth - 1)?)
            Arith(op, a, b) => Term.Arith(op,
                self.transform(a, cutoff, delta, replacement, depth - 1)?,
                self.transform(b, cutoff, delta, replacement, depth - 1)?)
            Strict(a, b) => Term.Strict(self.transform(a, cutoff, delta, replacement, depth - 1)?,
                self.transform(b, cutoff, delta, replacement, depth - 1)?)
            UAdd(a, b) => Term.UAdd(self.transform(a, cutoff, delta, replacement, depth - 1)?,
                self.transform(b, cutoff, delta, replacement, depth - 1)?)
            USub(a, b, p) => Term.USub(self.transform(a, cutoff, delta, replacement, depth - 1)?,
                self.transform(b, cutoff, delta, replacement, depth - 1)?,
                self.transform(p, cutoff, delta, replacement, depth - 1)?)
            ZeroLe(a) => Term.ZeroLe(self.transform(a, cutoff, delta, replacement, depth - 1)?)
            Refine(p) => Term.Refine(self.transform(p, cutoff, delta, replacement, depth - 1)?)
            Pack(p, a, q) => Term.Pack(self.transform(p, cutoff, delta, replacement, depth - 1)?,
                self.transform(a, cutoff, delta, replacement, depth - 1)?,
                self.transform(q, cutoff, delta, replacement, depth - 1)?)
            Witness(s) => Term.Witness(self.transform(s, cutoff, delta, replacement, depth - 1)?)
            Proof(s) => Term.Proof(self.transform(s, cutoff, delta, replacement, depth - 1)?)
            Buffer(n) => Term.Buffer(self.transform(n, cutoff, delta, replacement, depth - 1)?)
            Alloc(n, x) => Term.Alloc(self.transform(n, cutoff, delta, replacement, depth - 1)?,
                self.transform(x, cutoff, delta, replacement, depth - 1)?)
            Load(b, i, p, k) => Term.Load(self.transform(b, cutoff, delta, replacement, depth - 1)?,
                self.transform(i, cutoff, delta, replacement, depth - 1)?,
                self.transform(p, cutoff, delta, replacement, depth - 1)?,
                self.transform(k, cutoff, delta, replacement, depth - 1)?)
            Store(b, i, v, p) => Term.Store(
                self.transform(b, cutoff, delta, replacement, depth - 1)?,
                self.transform(i, cutoff, delta, replacement, depth - 1)?,
                self.transform(v, cutoff, delta, replacement, depth - 1)?,
                self.transform(p, cutoff, delta, replacement, depth - 1)?
            )
            Free(b, rest) => Term.Free(self.transform(b, cutoff, delta, replacement, depth - 1)?,
                self.transform(rest, cutoff, delta, replacement, depth - 1)?)
            Drop(f, x, rest) => Term.Drop(
                f,
                self.transform(x, cutoff, delta, replacement, depth - 1)?,
                self.transform(rest, cutoff, delta, replacement, depth - 1)?
            )
            Ref(t) => Term.Ref(self.transform(t, cutoff, delta, replacement, depth - 1)?)
            Borrow(x) => Term.Borrow(self.transform(x, cutoff, delta, replacement, depth - 1)?)
            Lend(x, f, g) => Term.Lend(self.transform(x, cutoff, delta, replacement, depth - 1)?,
                self.transform(f, cutoff, delta, replacement, depth - 1)?,
                self.transform(g, cutoff, delta, replacement, depth - 1)?)
            View(r, f, t, cases, x) => Term.View(r, f,
                self.transform(t, cutoff, delta, replacement, depth - 1)?,
                self.transform_all(cases.as_slice(), cutoff, delta, replacement, depth)?,
                self.transform(x, cutoff, delta, replacement, depth - 1)?)
            LtAdd(a, b, c, p) => Term.LtAdd(
                self.transform(a, cutoff, delta, replacement, depth - 1)?,
                self.transform(b, cutoff, delta, replacement, depth - 1)?,
                self.transform(c, cutoff, delta, replacement, depth - 1)?,
                self.transform(p, cutoff, delta, replacement, depth - 1)?)
            LtCancel(a, b, c, p) => Term.LtCancel(
                self.transform(a, cutoff, delta, replacement, depth - 1)?,
                self.transform(b, cutoff, delta, replacement, depth - 1)?,
                self.transform(c, cutoff, delta, replacement, depth - 1)?,
                self.transform(p, cutoff, delta, replacement, depth - 1)?)
            LtLe(x, y, z, p, q) => Term.LtLe(
                self.transform(x, cutoff, delta, replacement, depth - 1)?,
                self.transform(y, cutoff, delta, replacement, depth - 1)?,
                self.transform(z, cutoff, delta, replacement, depth - 1)?,
                self.transform(p, cutoff, delta, replacement, depth - 1)?,
                self.transform(q, cutoff, delta, replacement, depth - 1)?)
            Fold(n, init, body) => Term.Fold(
                self.transform(n, cutoff, delta, replacement, depth - 1)?,
                self.transform(init, cutoff, delta, replacement, depth - 1)?,
                self.transform(body, cutoff, delta, replacement, depth - 1)?)
            Elements(xs) => Term.Elements(self.transform_all(
                xs.as_slice(),
                cutoff,
                delta,
                replacement,
                depth
            )?)
            t => t
        }
        self.add(term, sp)
    }

    fn transform_all(
        inout self,
        xs: [u32],
        cutoff: u32,
        delta: i64,
        replacement: Option(u32),
        depth: u32
    ) -> Result(Vec(u32), diag.Diag) {
        var out = Vec(u32).new()
        for x in xs { out.push(self.transform(x, cutoff, delta, replacement, depth - 1)?) }
        Ok(out)
    }

    fn normal_all(inout self, xs: [u32], depth: u32) -> Result(Vec(u32), diag.Diag) {
        var out = Vec(u32).new()
        for x in xs { out.push(self.normal(x, depth - 1)?) }
        Ok(out)
    }

    pub fn shift(
        inout self,
        id: u32,
        delta: i64,
        cutoff: u32,
        depth: u32
    ) -> Result(u32, diag.Diag) {
        self.transform(id, cutoff, delta, None, depth)
    }

    pub fn substitute(inout self, body: u32, value: u32, depth: u32) -> Result(u32, diag.Diag) {
        self.transform(body, 0, 0, Some(value), depth)
    }

    // Normalization is computation in the finite core, including beta
    // reduction. Resource exhaustion is rejection, never proof acceptance.
    pub fn normal(inout self, id: u32, depth: u32) -> Result(u32, diag.Diag) {
        self.tick(id, depth)?
        let sp = self.nodes[id as i64].span
        let term = match self.term(id) {
            Global(g) => {
                if g >= self.visible { return Err(self.error(id, "recursive or forward definition")) }
                let body = self.definitions[g as i64].value
                return self.normal(body, depth - 1)
            }
            App(f, a) => {
                let f = self.normal(f, depth - 1)?
                let a = self.normal(a, depth - 1)?
                match self.term(f) {
                    // An argument that allocates, frees or touches memory is
                    // not substituted: the redex binds it, evaluated once.
                    Lam(false, domain, body) if self.runtime && self.effectful(a, depth - 1) => {
                        let body = self.normal(body, depth - 1)?
                        let lam = self.add(Term.Lam(false, domain, body), sp)?
                        return self.add(Term.App(lam, a), sp)
                    }
                    Lam(erased, _, body) => {
                        let body = self.substitute(body, a, depth - 1)?
                        let result = self.normal(body, depth - 1)?
                        // The body may not use a runtime argument, or only
                        // in one branch; its traps still happen first.
                        // Only code that runs needs the traps; conversion
                        // ignores Strict.
                        if self.runtime && !erased && self.may_trap(a, depth - 1) {
                            return self.add(Term.Strict(a, result), sp)
                        }
                        return Ok(result)
                    }
                    // Applying a branch applies each of its alternatives;
                    // the true branch has the evidence binder.
                    IfLt(x, y, yes, no) | IfEq(x, y, yes, no) => {
                        let equality = match self.term(f) { IfEq(_, _, _, _) => true, _ => false }
                        let shifted = self.shift(a, 1, 0, depth - 1)?
                        let yes = self.add(Term.App(yes, shifted), sp)?
                        let no = self.add(Term.App(no, a), sp)?
                        let branch = if equality { Term.IfEq(x, y, yes, no) }
                        else { Term.IfLt(x, y, yes, no) }
                        let branch = self.add(branch, sp)?
                        return self.normal(branch, depth - 1)
                    }
                    Strict(first, g) => {
                        let applied = self.add(Term.App(g, a), sp)?
                        let applied = self.normal(applied, depth - 1)?
                        return self.add(Term.Strict(first, applied), sp)
                    }
                    // A kept redex binds its effectful argument once; the
                    // application moves inside it. The order is the same:
                    // that argument, the function, then this argument.
                    App(g, e) if self.binders(g, 1) => {
                        let Lam(false, domain, body) = self.term(g) else { return self.add(
                            Term.App(f, a),
                            sp
                        ) }
                        let shifted = self.shift(a, 1, 0, depth - 1)?
                        let inner = self.add(Term.App(body, shifted), sp)?
                        let inner = self.normal(inner, depth - 1)?
                        let lam = self.add(Term.Lam(false, domain, inner), sp)?
                        return self.add(Term.App(lam, e), sp)
                    }
                    _ => Term.App(f, a)
                }
            }
            Pi(e, a, b) => Term.Pi(e, self.normal(a, depth - 1)?, self.normal(b, depth - 1)?)
            Lam(e, a, b) => Term.Lam(e, self.normal(a, depth - 1)?, self.normal(b, depth - 1)?)
            Array(n) => Term.Array(self.normal(n, depth - 1)?)
            Lt(a, b) => Term.Lt(self.normal(a, depth - 1)?, self.normal(b, depth - 1)?)
            Eq(a, b) => Term.Eq(self.normal(a, depth - 1)?, self.normal(b, depth - 1)?)
            Refl(a) => Term.Refl(self.normal(a, depth - 1)?)
            Ind(f, xs) => Term.Ind(f, self.normal_all(xs.as_slice(), depth)?)
            Con(f, k, xs) => Term.Con(f, k, self.normal_all(xs.as_slice(), depth)?)
            Elim(f, p, cases, x) => {
                let p = self.normal(p, depth - 1)?
                let cases = self.normal_all(cases.as_slice(), depth)?
                let x = self.normal(x, depth - 1)?
                // Iota reduction applies the constructor's case to its
                // fields, then to induction on each recursive field: the
                // strictly positive subterms. User code chooses no recursion.
                // Ill-formed terms stay neutral; infer rejects them.
                if self.is_data(f) {
                    // A case on a branch is the branch of the cases, and a
                    // case on Strict(t, y) evaluates t, then the case on y.
                    // Evaluation still goes the scrutinee, then the case.
                    match self.term(x) {
                        IfLt(a, b, yes, no) | IfEq(a, b, yes, no) => {
                            let equality = match self.term(x) { IfEq(_, _, _, _) => true, _ => false }
                            // The true branch has the evidence binder.
                            let inner = self.shift(p, 1, 0, depth - 1)?
                            var shifted = Vec(u32).new()
                            for c in cases { shifted.push(self.shift(c, 1, 0, depth - 1)?) }
                            let yes = self.add(Term.Elim(f, inner, shifted, yes), sp)?
                            let no = self.add(Term.Elim(f, p, cases.clone(), no), sp)?
                            let branch = if equality { Term.IfEq(a, b, yes, no) }
                            else { Term.IfLt(a, b, yes, no) }
                            let branch = self.add(branch, sp)?
                            return self.normal(branch, depth - 1)
                        }
                        Strict(t, y) => {
                            let e = self.add(Term.Elim(f, p, cases.clone(), y), sp)?
                            let e = self.normal(e, depth - 1)?
                            return self.add(Term.Strict(t, e), sp)
                        }
                        _ => {}
                    }
                }
                let Con(g, k, fields) = self.term(x) else { return self.add(
                    Term.Elim(f, p, cases, x),
                    sp
                ) }
                if g != f || f as i64 >= self.signatures.len() || k as i64 >= cases.len() ||
                    cases.len() != self.signatures[f as i64].len() {
                    return self.add(Term.Elim(f, p, cases, x), sp)
                }
                let count = self.signatures[f as i64][k as i64].fields.len()
                if fields.len() != count { return self.add(Term.Elim(f, p, cases, x), sp) }
                var result = cases[k as i64]
                // A data type's parameters are fixed, not given to the case.
                let skip = if self.is_data(f) { self.families[f as i64].params as i64 } else { 0 }
                for j, field in fields {
                    if j >= skip { result = self.add(Term.App(result, field), sp)? }
                }
                for j in 0..count {
                    if self.signatures[f as i64][k as i64].fields[j].recursive.is_none() { continue }
                    let ih = self.add(Term.Elim(f, p, cases.clone(), fields[j]), sp)?
                    result = self.add(Term.App(result, ih), sp)?
                }
                return self.normal(result, depth - 1)
            }
            Case(f, p, cases, x) => {
                let p = self.normal(p, depth - 1)?
                let cases = self.normal_all(cases.as_slice(), depth)?
                let x = self.normal(x, depth - 1)?
                match self.term(x) {
                    // As for Elim: a case on a branch is a branch of cases.
                    IfLt(a, b, yes, no) | IfEq(a, b, yes, no) => {
                        let equality = match self.term(x) { IfEq(_, _, _, _) => true, _ => false }
                        let inner = self.shift(p, 1, 0, depth - 1)?
                        var shifted = Vec(u32).new()
                        for c in cases { shifted.push(self.shift(c, 1, 0, depth - 1)?) }
                        let yes = self.add(Term.Case(f, inner, shifted, yes), sp)?
                        let no = self.add(Term.Case(f, p, cases.clone(), no), sp)?
                        let branch = if equality { Term.IfEq(a, b, yes, no) }
                        else { Term.IfLt(a, b, yes, no) }
                        let branch = self.add(branch, sp)?
                        return self.normal(branch, depth - 1)
                    }
                    Strict(t, y) => {
                        let e = self.add(Term.Case(f, p, cases.clone(), y), sp)?
                        let e = self.normal(e, depth - 1)?
                        return self.add(Term.Strict(t, e), sp)
                    }
                    // A known node is taken apart without being built.
                    Con(g, k, fields) if g == f && (k as i64) < cases.len() => {
                        let skip = self.families[f as i64].params as i64
                        var result = cases[k as i64]
                        for j, field in fields {
                            if j >= skip { result = self.add(Term.App(result, field), sp)? }
                        }
                        return self.normal(result, depth - 1)
                    }
                    _ => Term.Case(f, p, cases, x)
                }
            }
            Transport(f, e, p) => {
                let f = self.normal(f, depth - 1)?
                let e = self.normal(e, depth - 1)?
                let p = self.normal(p, depth - 1)?
                match self.term(e) {
                    Refl(_) => return Ok(p)
                    _ => Term.Transport(f, e, p)
                }
            }
            IfLt(a, b, yes, no) | IfEq(a, b, yes, no) => {
                let equality = match self.term(id) { IfEq(_, _, _, _) => true, _ => false }
                let a = self.normal(a, depth - 1)?
                let b = self.normal(b, depth - 1)?
                match (self.term(a), self.term(b)) {
                    (Natural(x), Natural(y)) => {
                        let holds = if equality { x == y } else { x < y }
                        if holds {
                            let proof = if equality { Term.Refl(a) } else { Term.Decide(a, b) }
                            let p = self.add(proof, sp)?
                            let body = self.substitute(yes, p, depth - 1)?
                            return self.normal(body, depth - 1)
                        }
                        return self.normal(no, depth - 1)
                    }
                    _ => {
                        let yes = self.normal(yes, depth - 1)?
                        let no = self.normal(no, depth - 1)?
                        if equality { Term.IfEq(a, b, yes, no) } else { Term.IfLt(a, b, yes, no) }
                    }
                }
            }
            Decide(a, b) => Term.Decide(self.normal(a, depth - 1)?, self.normal(b, depth - 1)?)
            Index(a, i, p) => Term.Index(self.normal(a, depth - 1)?, self.normal(i, depth - 1)?,
                self.normal(p, depth - 1)?)
            Arith(op, a, b) => {
                let a = self.normal(a, depth - 1)?
                let b = self.normal(b, depth - 1)?
                match (self.term(a), self.term(b)) {
                    (Integer(x), Integer(y)) => {
                        let (x, y) = (x as i128, y as i128)
                        let v = match op { Add => x + y, Sub => x - y, Mul => x * y }
                        // An overflowing operation stays a runtime trap.
                        if v >= -9223372036854775807 - 1 && v <= 9223372036854775807 {
                            Term.Integer(v as i64)
                        } else { Term.Arith(op, a, b) }
                    }
                    _ => Term.Arith(op, a, b)
                }
            }
            Fold(n, init, body) => {
                let n = self.normal(n, depth - 1)?
                let init = self.normal(init, depth - 1)?
                // Loops are not unrolled; only the empty loop computes. Its
                // body never runs, so neither do the body's traps.
                if self.term(n) == Term.Natural(0) { return Ok(init) }
                let normal_body = self.normal(body, depth - 1)?
                if self.binders(normal_body, 3) {
                    return self.add(Term.Fold(n, init, normal_body), sp)
                }
                // Eta-expand the body, so that lowering finds its binders.
                // Its annotations are not used after checking.
                let u = self.add(Term.U64, sp)?
                let i = self.add(Term.I64, sp)?
                let x0 = self.add(Term.Var(0), sp)?
                let x1 = self.add(Term.Var(1), sp)?
                let x2 = self.add(Term.Var(2), sp)?
                let bound = self.shift(n, 1, 0, depth - 1)?
                let lt = self.add(Term.Lt(x0, bound), sp)?
                var applied = self.shift(body, 3, 0, depth - 1)?
                for x in [x2, x1, x0] { applied = self.add(Term.App(applied, x), sp)? }
                let eta = self.add(Term.Lam(false, i, applied), sp)?
                let eta = self.add(Term.Lam(true, lt, eta), sp)?
                let eta = self.add(Term.Lam(false, u, eta), sp)?
                Term.Fold(n, init, self.normal(eta, depth - 1)?)
            }
            Strict(a, b) => {
                let a = self.normal(a, depth - 1)?
                let b = self.normal(b, depth - 1)?
                if !self.may_trap(a, depth - 1) { return Ok(b) }
                Term.Strict(a, b)
            }
            UAdd(a, b) => {
                let a = self.normal(a, depth - 1)?
                let b = self.normal(b, depth - 1)?
                return self.sum(a, b, sp, depth - 1)
            }
            USub(a, b, p) => {
                let a = self.normal(a, depth - 1)?
                let b = self.normal(b, depth - 1)?
                let p = self.normal(p, depth - 1)?
                // (r + b) - b is r when b's parts are among a's.
                var atoms = Vec(u32).new()
                var constant: u128 = 0
                var pending = Vec(u32).new()
                self.collect(a, &atoms, &constant, &pending, depth - 1)
                var minus = Vec(u32).new()
                var less: u128 = 0
                self.collect(b, &minus, &less, &pending, depth - 1)
                // Operands that touch memory are evaluated exactly once, so
                // they are neither cancelled nor kept twice.
                let effects = self.effectful(a, depth - 1) || self.effectful(b, depth - 1)
                if less <= constant && !effects {
                    match self.without(atoms.as_slice(), minus.as_slice(), depth - 1) {
                        Some(rest) => {
                            match self.canonical(rest.as_slice(), constant - less, sp)? {
                                Some(id) => {
                                    // The operands are still evaluated for
                                    // their traps, as the subtraction would.
                                    var result = id
                                    for x in [b, a] {
                                        if self.may_trap(x, depth - 1) {
                                            result = self.add(Term.Strict(x, result), sp)?
                                        }
                                    }
                                    return Ok(result)
                                }
                                None => {}
                            }
                        }
                        None => {}
                    }
                }
                Term.USub(a, b, p)
            }
            ZeroLe(a) => Term.ZeroLe(self.normal(a, depth - 1)?)
            Refine(p) => Term.Refine(self.normal(p, depth - 1)?)
            // Memory operations are not computed: they happen at run time.
            Buffer(n) => Term.Buffer(self.normal(n, depth - 1)?)
            Alloc(n, x) => Term.Alloc(self.normal(n, depth - 1)?, self.normal(x, depth - 1)?)
            Load(b, i, p, k) => Term.Load(self.normal(b, depth - 1)?, self.normal(i, depth - 1)?,
                self.normal(p, depth - 1)?, self.normal(k, depth - 1)?)
            Store(b, i, v, p) => Term.Store(self.normal(b, depth - 1)?, self.normal(i, depth - 1)?,
                self.normal(v, depth - 1)?, self.normal(p, depth - 1)?)
            // In the pure model freeing is no computation: the rest's value.
            Free(_, rest) | Drop(_, _, rest) if !self.runtime => return self.normal(rest, depth - 1)
            Free(b, rest) => Term.Free(self.normal(b, depth - 1)?, self.normal(rest, depth - 1)?)
            Drop(f, x, rest) => Term.Drop(
                f,
                self.normal(x, depth - 1)?,
                self.normal(rest, depth - 1)?
            )
            Ref(t) => Term.Ref(self.normal(t, depth - 1)?)
            Borrow(x) => Term.Borrow(self.normal(x, depth - 1)?)
            // In the pure model a lend is g(f(borrow of x), x): the borrow
            // reads the value x has. Code to run keeps it.
            Lend(x, f, g) if !self.runtime => {
                let borrow = self.add(Term.Borrow(x), sp)?
                let read = self.add(Term.App(f, borrow), sp)?
                let rest = self.add(Term.App(g, read), sp)?
                let rest = self.add(Term.App(rest, x), sp)?
                return self.normal(rest, depth - 1)
            }
            Lend(x, f, g) => Term.Lend(self.normal(x, depth - 1)?, self.normal(f, depth - 1)?,
                self.normal(g, depth - 1)?)
            View(r, f, t, cases, x) => {
                let t = self.normal(t, depth - 1)?
                let cases = self.normal_all(cases.as_slice(), depth)?
                let x = self.normal(x, depth - 1)?
                if !self.runtime {
                    match self.term(x) {
                        Borrow(v) => match self.view_value(r, f, t, cases, v, sp, depth)? {
                            Some(result) => return Ok(result)
                            None => {}
                        }
                        _ => {}
                    }
                }
                Term.View(r, f, t, cases, x)
            }
            Pack(p, a, q) => Term.Pack(self.normal(p, depth - 1)?, self.normal(a, depth - 1)?,
                self.normal(q, depth - 1)?)
            Witness(s) => {
                let s = self.normal(s, depth - 1)?
                return self.witness(s, sp, depth - 1)
            }
            Proof(s) => {
                let s = self.normal(s, depth - 1)?
                match self.term(s) {
                    Pack(_, _, q) => return Ok(q)
                    // Traps order runtime evaluation; evidence has none.
                    Strict(_, x) => {
                        let proof = self.add(Term.Proof(x), sp)?
                        return self.normal(proof, depth - 1)
                    }
                    _ => Term.Proof(s)
                }
            }
            LtAdd(a, b, c, p) => Term.LtAdd(self.normal(a, depth - 1)?, self.normal(b, depth - 1)?,
                self.normal(c, depth - 1)?, self.normal(p, depth - 1)?)
            LtCancel(a, b, c, p) => Term.LtCancel(self.normal(a, depth - 1)?,
                self.normal(b, depth - 1)?, self.normal(c, depth - 1)?, self.normal(p, depth - 1)?)
            LtLe(x, y, z, p, q) => Term.LtLe(self.normal(x, depth - 1)?, self.normal(y, depth - 1)?,
                self.normal(z, depth - 1)?, self.normal(p, depth - 1)?, self.normal(q, depth - 1)?)
            Elements(xs) => Term.Elements(self.normal_all(xs.as_slice(), depth)?)
            t => return Ok(id)
        }
        self.add(term, sp)
    }

    // A view of a borrow of v, normal, in the pure model: a known node is
    // read without being taken apart. Its case receives the fields, those
    // on the heap borrowed, then, in a recursion, the view of each recursive
    // field; a branch is the branch of the views, and Strict keeps its
    // traps first. None when v is neutral.
    fn view_value(
        inout self,
        recursion: bool,
        f: u32,
        t: u32,
        cases: Vec(u32),
        v: u32,
        sp: diag.Span,
        depth: u32
    ) -> Result(Option(u32), diag.Diag) {
        if depth == 0 { return Err(self.error(v, "nesting limit reached")) }
        match self.term(v) {
            Con(g, k, fields) => {
                if g != f || !self.is_boxed(f) || f as i64 >= self.signatures.len() ||
                    k as i64 >= cases.len() || cases.len() != self.signatures[f as i64].len() {
                    return Ok(None)
                }
                let params = self.families[f as i64].params as i64
                let shape = self.view_shape(f, k, depth - 1)?
                if fields.len() != params + shape.len() { return Ok(None) }
                var result = cases[k as i64]
                for j, entry in shape {
                    let (heap, _) = entry
                    let field = fields[params + j]
                    let arg = if heap { self.add(Term.Borrow(field), sp)? } else { field }
                    result = self.add(Term.App(result, arg), sp)?
                }
                if recursion {
                    for j, entry in shape {
                        let (_, own) = entry
                        if !own { continue }
                        let borrow = self.add(Term.Borrow(fields[params + j]), sp)?
                        let ih = self.add(
                            Term.View(true, f, t, cases.clone(), borrow),
                            sp
                        )?
                        result = self.add(Term.App(result, ih), sp)?
                    }
                }
                Ok(Some(self.normal(result, depth - 1)?))
            }
            IfLt(a, b, yes, no) | IfEq(a, b, yes, no) => {
                let equality = match self.term(v) { IfEq(_, _, _, _) => true, _ => false }
                // The true branch has the evidence binder.
                let inner = self.shift(t, 1, 0, depth - 1)?
                var shifted = Vec(u32).new()
                for c in cases { shifted.push(self.shift(c, 1, 0, depth - 1)?) }
                let y = self.add(Term.Borrow(yes), sp)?
                let y = self.add(Term.View(recursion, f, inner, shifted, y), sp)?
                let n = self.add(Term.Borrow(no), sp)?
                let n = self.add(Term.View(recursion, f, t, cases.clone(), n), sp)?
                let branch = if equality { Term.IfEq(a, b, y, n) } else { Term.IfLt(a, b, y, n) }
                let branch = self.add(branch, sp)?
                Ok(Some(self.normal(branch, depth - 1)?))
            }
            Strict(trap, y) => {
                let y = self.add(Term.Borrow(y), sp)?
                let view = self.add(Term.View(recursion, f, t, cases.clone(), y), sp)?
                let view = self.normal(view, depth - 1)?
                Ok(Some(self.add(Term.Strict(trap, view), sp)?))
            }
            _ => Ok(None)
        }
    }

    // The fields of constructor k of a boxed family f, its parameters
    // left out, as a view reads them: whether each is on the heap (a
    // runtime field of heap data, read through a borrow) and whether it
    // is recursive (of f itself).
    fn view_shape(inout self, f: u32, k: u32, depth: u32) -> Result(Vec((bool, bool)), diag.Diag) {
        var ty = self.families[f as i64].constructors[k as i64].ty
        for _ in 0..self.families[f as i64].params {
            let Pi(_, _, rest) = self.term(ty) else { break }
            ty = rest
        }
        var shape = Vec((bool, bool)).new()
        loop {
            let Pi(erased, domain, rest) = self.term(ty) else { break }
            let normal = self.normal(domain, depth)?
            let (heap, own) = match self.term(normal) {
                Ind(g, _) => (g == f || self.is_boxed(g), g == f)
                _ => (false, false)
            }
            shape.push((heap && !erased, own && !erased))
            ty = rest
        }
        Ok(shape)
    }

    // The U64 of a normal refinement: a packed value is its witness, and
    // the witness of a branch is the branch of its alternatives' witnesses.
    // A trap kept by Strict still happens first.
    fn witness(inout self, s: u32, sp: diag.Span, depth: u32) -> Result(u32, diag.Diag) {
        if depth == 0 { return Err(self.error(s, "nesting limit reached")) }
        match self.term(s) {
            Pack(_, a, _) => Ok(a)
            Strict(t, x) => {
                let x = self.witness(x, sp, depth - 1)?
                if !self.may_trap(t, depth - 1) { return Ok(x) }
                self.add(Term.Strict(t, x), sp)
            }
            IfLt(a, b, yes, no) | IfEq(a, b, yes, no) => {
                let equality = match self.term(s) { IfEq(_, _, _, _) => true, _ => false }
                let yes = self.witness(yes, sp, depth - 1)?
                let no = self.witness(no, sp, depth - 1)?
                self.add(
                    if equality { Term.IfEq(a, b, yes, no) } else { Term.IfLt(a, b, yes, no) },
                    sp
                )
            }
            _ => self.add(Term.Witness(s), sp)
        }
    }

    // The canonical sum of two normal U64 terms: variables in index order,
    // then other terms in their order, then the constant, without zero.
    // These are equations of the naturals. A constant that does not fit
    // a U64 leaves the sum as it is.
    fn sum(inout self, a: u32, b: u32, sp: diag.Span, depth: u32) -> Result(u32, diag.Diag) {
        var atoms = Vec(u32).new()
        var constant: u128 = 0
        // Traps of Strict terms in the sum, evaluated before the result.
        var pending = Vec(u32).new()
        self.collect(a, &atoms, &constant, &pending, depth)
        self.collect(b, &atoms, &constant, &pending, depth)
        // (x - y) + y is x when the sum has all of y's parts.
        var changed = true
        var rounds = 0
        // Terms that touch memory are evaluated exactly once: no cancellation.
        for x in atoms { if self.effectful(x, depth) { changed = false } }
        while changed && rounds < 64 {
            changed = false
            rounds += 1
            for k in 0..atoms.len() {
                let USub(x, y, _) = self.term(atoms[k]) else { continue }
                var minus = Vec(u32).new()
                var less: u128 = 0
                var traps = Vec(u32).new()
                self.collect(y, &minus, &less, &traps, depth)
                if less > constant || traps.len() != 0 { continue }
                var others = Vec(u32).new()
                for j in 0..atoms.len() { if j != k { others.push(atoms[j]) } }
                let Some(rest) = self.without(others.as_slice(), minus.as_slice(), depth) else {
                    continue
                }
                atoms = rest
                constant -= less
                // y is no longer evaluated; its traps still happen.
                if self.may_trap(y, depth) { pending.push(y) }
                self.collect(x, &atoms, &constant, &pending, depth)
                changed = true
                break
            }
        }
        match self.canonical(atoms.as_slice(), constant, sp)? {
            Some(id) => {
                var result = id
                for x in pending { result = self.add(Term.Strict(x, result), sp)? }
                Ok(result)
            }
            None => self.add(Term.UAdd(a, b), sp)
        }
    }

    // Variables in index order, then other terms in their order, then the
    // constant; None when the constant does not fit a U64.
    fn canonical(
        inout self,
        atoms: [u32],
        constant: u128,
        sp: diag.Span
    ) -> Result(Option(u32), diag.Diag) {
        if constant > 0xffffffffffffffff { return Ok(None) }
        var vars = Vec((u32, u32)).new()
        var others = Vec(u32).new()
        for x in atoms {
            match self.term(x) {
                Var(k) => {
                    var at = vars.len()
                    while at > 0 && vars[at - 1].0 > k { at -= 1 }
                    vars.insert(at, (k, x))
                }
                _ => others.push(x)
            }
        }
        // In the pure model a sum's order is immaterial: other terms are
        // sorted by their structure, so sums that differ only in order
        // convert. Code that runs keeps its operands' evaluation order.
        if !self.runtime {
            var sorted = Vec(u32).new()
            for x in others {
                var at = sorted.len()
                while at > 0 && self.compare(sorted[at - 1], x, DEPTH) > 0 { at -= 1 }
                sorted.insert(at, x)
            }
            others = sorted
        }
        var ordered = Vec(u32).new()
        for v in vars { ordered.push(v.1) }
        for x in others { ordered.push(x) }
        if constant > 0 || ordered.len() == 0 { ordered.push(self.add(
            Term.Natural(constant as u64),
            sp
        )?) }
        var result: Option(u32) = None
        for x in ordered {
            result = Some(match result { Some(r) => self.add(Term.UAdd(r, x), sp)?, None => x })
        }
        Ok(result)
    }

    // A total order on terms by structure, for sorting sums; 0 for
    // identical terms, ignoring Strict as `identical` does.
    fn compare(self, a: u32, b: u32, depth: u32) -> i64 {
        if depth == 0 || a == b { return 0 }
        match self.term(a) { Strict(_, y) => return self.compare(y, b, depth - 1), _ => {} }
        match self.term(b) { Strict(_, y) => return self.compare(a, y, depth - 1), _ => {} }
        let (x, y) = (self.term(a), self.term(b))
        let (rx, ry) = (rank(x.clone()), rank(y.clone()))
        if rx != ry { return if rx < ry { -1 } else { 1 } }
        let (px, py) = (payload(x.clone()), payload(y.clone()))
        for i in 0..px.len() {
            if i >= py.len() { return 1 }
            if px[i] != py[i] { return if px[i] < py[i] { -1 } else { 1 } }
        }
        if px.len() < py.len() { return -1 }
        let (cx, cy) = (children(x), children(y))
        for i in 0..cx.len() {
            if i >= cy.len() { return 1 }
            let c = self.compare(cx[i], cy[i], depth - 1)
            if c != 0 { return c }
        }
        if cx.len() < cy.len() { -1 } else { 0 }
    }

    // The pool without one identical occurrence of each item, if it has them.
    fn without(self, pool: [u32], items: [u32], depth: u32) -> Option(Vec(u32)) {
        var rest = Vec(u32).new()
        for x in pool { rest.push(x) }
        for item in items {
            var found = -1
            for k in 0..rest.len() {
                if self.identical(rest[k], item, depth) { found = k; break }
            }
            if found < 0 { return None }
            rest.remove(found)
        }
        Some(rest)
    }

    fn collect(
        self,
        id: u32,
        inout atoms: Vec(u32),
        inout constant: u128,
        inout pending: Vec(u32),
        depth: u32
    ) {
        match self.term(id) {
            UAdd(a, b) if depth > 0 => {
                self.collect(a, &atoms, &constant, &pending, depth - 1)
                self.collect(b, &atoms, &constant, &pending, depth - 1)
            }
            // Strict(t, r) is r in the naturals; t is evaluated first.
            Strict(t, r) if depth > 0 => {
                pending.push(t)
                self.collect(r, &atoms, &constant, &pending, depth - 1)
            }
            Natural(n) => constant += n as u128
            _ => atoms.push(id)
        }
    }

    // Whether evaluating a runtime term can trap: it contains arithmetic,
    // which overflow could stop. Conservative at the depth limit.
    fn may_trap(self, id: u32, depth: u32) -> bool {
        if depth == 0 { return true }
        match self.term(id) {
            Arith(_, _, _) | Strict(_, _) | UAdd(_, _) => true
            // Allocation can fail; memory effects are kept like traps.
            Alloc(_, _) | Load(_, _, _, _) | Store(_, _, _, _) | Free(_, _) | Drop(_, _, _) | Case(
                _,
                _,
                _,
                _
            ) => true
            Con(f, _, _) | Elim(f, _, _, _) if self.is_boxed(f) => true
            // Only a refinement's witness is evaluated; its predicate and
            // evidence are erased.
            Pack(_, a, _) => self.may_trap(a, depth - 1)
            Refine(_) | Proof(_) => false
            t => {
                for child in children(t) { if self.may_trap(child, depth - 1) { return true } }
                false
            }
        }
    }

    // Whether evaluating a term allocates, frees or touches memory.
    // Conservative at the depth limit.
    fn effectful(self, id: u32, depth: u32) -> bool {
        if depth == 0 { return true }
        match self.term(id) {
            Alloc(_, _) | Load(_, _, _, _) | Store(_, _, _, _) | Free(_, _) | Drop(_, _, _) | Case(
                _,
                _,
                _,
                _
            ) => true
            // Building a heap node allocates; recursion over one frees it.
            Con(f, _, _) | Elim(f, _, _, _) if self.is_boxed(f) => true
            t => {
                for child in children(t) { if self.effectful(child, depth - 1) { return true } }
                false
            }
        }
    }

    // Whether a term is at least `count` nested lambdas.
    fn binders(self, id: u32, count: u32) -> bool {
        if count == 0 { return true }
        match self.term(id) { Lam(_, _, body) => self.binders(body, count - 1), _ => false }
    }

    fn identical(self, a: u32, b: u32, depth: u32) -> bool {
        if depth == 0 { return false }
        // Strict(x, y) means y: it only orders the evaluation of x's traps.
        match self.term(a) { Strict(_, y) => return self.identical(y, b, depth - 1), _ => {} }
        match self.term(b) { Strict(_, y) => return self.identical(a, y, depth - 1), _ => {} }
        match (self.term(a), self.term(b)) {
            (Array(x), Array(y)) | (Refl(x), Refl(y)) => self.identical(x, y, depth - 1)
            (Eq(a, b), Eq(c, d)) | (Lt(a, b), Lt(c, d)) | (
                App(a, b),
                App(c, d)
            ) | (
                Decide(a, b),
                Decide(c, d)
            ) =>
                self.identical(a, c, depth - 1) && self.identical(b, d, depth - 1)
            (Pi(e, a, b), Pi(f, c, d)) | (Lam(e, a, b), Lam(f, c, d)) =>
                e == f && self.identical(a, c, depth - 1) && self.identical(b, d, depth - 1)
            (Index(a, i, p), Index(b, j, q)) | (Transport(a, i, p), Transport(b, j, q)) => self.identical(
                a,
                b,
                depth - 1
            ) &&
                self.identical(i, j, depth - 1) && self.identical(p, q, depth - 1)
            // Proof irrelevance: any evidence of b <= a gives the same a - b.
            (USub(a, b, _), USub(c, d, _)) =>
                self.identical(a, c, depth - 1) && self.identical(b, d, depth - 1)
            (Buffer(a), Buffer(b)) => self.identical(a, b, depth - 1)
            (Alloc(a, b), Alloc(c, d)) | (Free(a, b), Free(c, d)) =>
                self.identical(a, c, depth - 1) && self.identical(b, d, depth - 1)
            (Drop(f, a, b), Drop(g, c, d)) =>
                f == g && self.identical(a, c, depth - 1) && self.identical(b, d, depth - 1)
            (Ref(a), Ref(b)) | (Borrow(a), Borrow(b)) => self.identical(a, b, depth - 1)
            (Lend(a, b, c), Lend(x, y, z)) => self.identical(a, x, depth - 1) &&
                self.identical(b, y, depth - 1) && self.identical(c, z, depth - 1)
            (View(r, f, t, xs, a), View(q, g, u, ys, b)) => r == q && f == g &&
                self.identical(t, u, depth - 1) &&
                self.identical_all(xs.as_slice(), ys.as_slice(), depth) &&
                self.identical(a, b, depth - 1)
            (Load(a, b, c, d), Load(w, x, y, z)) | (Store(a, b, c, d), Store(w, x, y, z)) =>
                self.identical(a, w, depth - 1) && self.identical(b, x, depth - 1) &&
                self.identical(c, y, depth - 1) && self.identical(d, z, depth - 1)
            (ZeroLe(a), ZeroLe(b)) | (Refine(a), Refine(b)) | (Witness(a), Witness(b)) | (
                Proof(a),
                Proof(b)
            ) => self.identical(a, b, depth - 1)
            // Proof irrelevance: the evidence does not change the value.
            (Pack(p, a, _), Pack(q, b, _)) =>
                self.identical(p, q, depth - 1) && self.identical(a, b, depth - 1)
            (UAdd(a, b), UAdd(c, d)) => self.identical(a, c, depth - 1) && self.identical(
                b,
                d,
                depth - 1
            )
            (LtAdd(a, b, c, p), LtAdd(x, y, z, q)) | (LtCancel(a, b, c, p), LtCancel(x, y, z, q)) =>
                self.identical(a, x, depth - 1) && self.identical(b, y, depth - 1) &&
                self.identical(c, z, depth - 1) && self.identical(p, q, depth - 1)
            (LtLe(a, b, c, p, q), LtLe(x, y, z, r, t)) =>
                self.identical(a, x, depth - 1) && self.identical(b, y, depth - 1) &&
                self.identical(c, z, depth - 1) && self.identical(p, r, depth - 1) &&
                self.identical(q, t, depth - 1)
            (Arith(o, a, b), Arith(p, c, d)) =>
                o == p && self.identical(a, c, depth - 1) && self.identical(b, d, depth - 1)
            (Fold(a, b, y), Fold(c, d, z)) => self.identical(a, c, depth - 1) &&
                self.identical(b, d, depth - 1) && self.identical(y, z, depth - 1)
            (Ind(f, xs), Ind(g, ys)) => f == g && self.identical_all(
                xs.as_slice(),
                ys.as_slice(),
                depth
            )
            (Con(f, k, xs), Con(g, l, ys)) =>
                f == g && k == l && self.identical_all(xs.as_slice(), ys.as_slice(), depth)
            (Case(f, p, xs, a), Case(g, q, ys, b)) => f == g && self.identical(p, q, depth - 1) &&
                self.identical_all(xs.as_slice(), ys.as_slice(), depth) && self.identical(
                a,
                b,
                depth - 1
            )
            (Elim(f, p, xs, a), Elim(g, q, ys, b)) => f == g && self.identical(p, q, depth - 1) &&
                self.identical_all(xs.as_slice(), ys.as_slice(), depth) && self.identical(
                a,
                b,
                depth - 1
            )
            (IfLt(a, b, y, n), IfLt(c, d, z, m)) |
                (IfEq(a, b, y, n), IfEq(c, d, z, m)) => self.identical(a, c, depth - 1) &&
                self.identical(b, d, depth - 1) && self.identical(y, z, depth - 1) && self.identical(
                n,
                m,
                depth - 1
            )
            (Elements(xs), Elements(ys)) => self.identical_all(xs.as_slice(), ys.as_slice(), depth)
            (x, y) => x == y
        }
    }

    fn identical_all(self, xs: [u32], ys: [u32], depth: u32) -> bool {
        if xs.len != ys.len { return false }
        for i in 0..xs.len { if !self.identical(xs[i], ys[i], depth - 1) { return false } }
        true
    }

    pub fn equal(inout self, a: u32, b: u32, depth: u32) -> Result(bool, diag.Diag) {
        let a = self.normal(a, depth)?
        let b = self.normal(b, depth)?
        Ok(self.identical(a, b, depth))
    }

    fn sort(inout self, ty: u32, depth: u32) -> Result(i64, diag.Diag) {
        let n = self.normal(ty, depth)?
        match self.term(n) {
            Prop => Ok(-1)
            Universe(level) => Ok(level as i64)
            _ => Err(self.error(ty, "expected a type or proposition"))
        }
    }

    fn binder(
        inout self,
        domain: u32,
        erased: bool,
        ctx: [Binding],
        depth: u32
    ) -> Result(i64, diag.Diag) {
        let ty = self.infer(domain, ctx, true, depth)?
        let level = self.sort(ty, depth)?
        // An erased u64 is an index: used in types and evidence only.
        if erased && level != -1 {
            let d = self.normal(domain, depth)?
            // A u64 index, or a data value known only to types and evidence.
            let ghost = match self.term(d) {
                U64 => true
                Ind(g, _) => self.is_data(g)
                _ => false
            }
            if !ghost { return Err(self.error(
                domain,
                "erased binders must be propositions, u64 or data"
            )) }
        }
        if !erased && level == -1 { return Err(self.error(domain, "proof binders must be erased")) }
        Ok(level)
    }

    pub fn require(
        inout self,
        id: u32,
        expected: u32,
        ctx: [Binding],
        ghost: bool,
        depth: u32
    ) -> Result((), diag.Diag) {
        let actual = self.infer(id, ctx, ghost, depth)?
        if !self.equal(actual, expected, depth)? { return Err(self.error(id, "type mismatch")) }
        Ok(())
    }

    fn apply2(inout self, f: u32, a: u32, b: u32, sp: diag.Span) -> Result(u32, diag.Diag) {
        let f = self.add(Term.App(f, a), sp)?
        self.add(Term.App(f, b), sp)
    }

    fn family_ref(self, id: u32, f: u32) -> Result((), diag.Diag) {
        if f >= self.visible_families || f as i64 >= self.signatures.len() {
            return Err(self.error(id, "inductive family used before its declaration is checked"))
        }
        Ok(())
    }

    // U64 -> Prop, the type of a refinement's predicate.
    fn predicate(inout self, sp: diag.Span) -> Result(u32, diag.Diag) {
        let u = self.add(Term.U64, sp)?
        let prop = self.add(Term.Prop, sp)?
        self.add(Term.Pi(false, u, prop), sp)
    }

    // U64 -> ... -> Prop, one binder per index: elimination is into
    // propositions only, so evidence never determines runtime data.
    pub fn is_data(self, f: u32) -> bool {
        f as i64 < self.families.len() && self.families[f as i64].data
    }

    pub fn is_boxed(self, f: u32) -> bool { f as i64 < self.boxed.len() && self.boxed[f as i64] }

    pub fn motive_type(inout self, f: u32, sp: diag.Span) -> Result(u32, diag.Diag) {
        let u = self.add(Term.U64, sp)?
        var ty = self.add(Term.Prop, sp)?
        for _ in 0..self.families[f as i64].arity { ty = self.add(Term.Pi(false, u, ty), sp)? }
        Ok(ty)
    }

    // The case for constructor k with fields x and recursive fields
    // r1..rn: (x...) -> (erased ih_i : P(indices of r_i))... -> P(result).
    // Hypotheses follow all fields. P comes from the outer context and is
    // weakened under the new binders. Also used to elaborate source lambdas;
    // infer checks those elaborated terms independently.
    pub fn case_type(
        inout self,
        f: u32,
        k: u32,
        p: u32,
        sp: diag.Span,
        depth: u32
    ) -> Result(u32, diag.Diag) {
        if f as i64 >= self.signatures.len() || k as i64 >= self.signatures[f as i64].len() {
            return Err(diag.Diag.new(sp, "core: unchecked inductive family or constructor"))
        }
        var erased = Vec(bool).new()
        var domains = Vec(u32).new()
        var positions = Vec(i64).new()
        var recursive = Vec(Vec(u32)).new()
        for j, field in self.signatures[f as i64][k as i64].fields {
            erased.push(field.erased)
            domains.push(field.domain)
            match field.recursive {
                Some(xs) => { positions.push(j); recursive.push(xs.clone()) }
                None => {}
            }
        }
        let indices = self.signatures[f as i64][k as i64].result.clone()
        let m = domains.len()
        let r = positions.len()
        var result = self.shift(p, m + r, 0, depth)?
        for x in indices {
            let x = self.shift(x, r, 0, depth)?
            result = self.add(Term.App(result, x), sp)?
        }
        var t = r
        while t > 0 {
            t -= 1
            // Field j's indices live under its j preceding fields.
            var ih = self.shift(p, m + t, 0, depth)?
            for x in recursive[t] {
                let x = self.shift(x, m + t - positions[t], 0, depth)?
                ih = self.add(Term.App(ih, x), sp)?
            }
            result = self.add(Term.Pi(true, ih, result), sp)?
        }
        var j = m
        while j > 0 {
            j -= 1
            result = self.add(Term.Pi(erased[j], domains[j], result), sp)?
        }
        Ok(result)
    }

    // The case for constructor k of a data type, its parameters ps from
    // the outer context: (fields...) -> P(indices..., c(ps, fields...)),
    // with the parameters substituted into the fields and the indices.
    pub fn data_case_type(
        inout self,
        f: u32,
        k: u32,
        p: u32,
        ps: [u32],
        sp: diag.Span,
        depth: u32
    ) -> Result(u32, diag.Diag) {
        if !self.is_data(f) || f as i64 >= self.signatures.len() ||
            k as i64 >= self.signatures[f as i64].len() {
            return Err(diag.Diag.new(sp, "core: unchecked data type or constructor"))
        }
        let params = self.families[f as i64].params as i64
        if ps.len != params { return Err(diag.Diag.new(sp, "core: wrong number of parameters")) }
        // The constructor's closed telescope, as the kernel checked it.
        var ty = self.families[f as i64].constructors[k as i64].ty
        for q in ps {
            let Pi(_, _, rest) = self.term(ty) else {
                return Err(diag.Diag.new(sp, "core: malformed constructor"))
            }
            ty = self.substitute(rest, q, depth)?
        }
        var fields = Vec((bool, u32)).new()
        loop {
            match self.term(ty) {
                Pi(erased, domain, rest) => { fields.push((erased, domain)); ty = rest }
                _ => break
            }
        }
        let Ind(_, indices) = self.term(ty) else {
            return Err(diag.Diag.new(sp, "core: malformed constructor"))
        }
        let m = fields.len()
        var result = self.shift(p, m, 0, depth)?
        for j in params..indices.len() { result = self.add(Term.App(result, indices[j]), sp)? }
        var xs = Vec(u32).new()
        for q in ps { xs.push(self.shift(q, m, 0, depth)?) }
        for j in 0..m { xs.push(self.add(Term.Var((m - 1 - j) as u32), sp)?) }
        let value = self.add(Term.Con(f, k, xs), sp)?
        result = self.add(Term.App(result, value), sp)?
        var j = m
        while j > 0 {
            j -= 1
            let (erased, domain) = fields[j]
            result = self.add(Term.Pi(erased, domain, result), sp)?
        }
        Ok(result)
    }

    // The case for constructor k of a view of borrowed data with parameters
    // ps: (fields..., heap ones borrowed) -> [in a recursion, (ih : T) per
    // recursive field] -> T.
    pub fn view_case_type(
        inout self,
        f: u32,
        k: u32,
        ps: [u32],
        t: u32,
        recursion: bool,
        sp: diag.Span,
        depth: u32
    ) -> Result(u32, diag.Diag) {
        if !self.is_boxed(f) || f as i64 >= self.signatures.len() ||
            k as i64 >= self.signatures[f as i64].len() {
            return Err(diag.Diag.new(sp, "core: unchecked data type or constructor"))
        }
        let params = self.families[f as i64].params as i64
        if ps.len != params { return Err(diag.Diag.new(sp, "core: wrong number of parameters")) }
        var ty = self.families[f as i64].constructors[k as i64].ty
        for q in ps {
            let Pi(_, _, rest) = self.term(ty) else {
                return Err(diag.Diag.new(sp, "core: malformed constructor"))
            }
            ty = self.substitute(rest, q, depth)?
        }
        var fields = Vec((bool, u32)).new()
        var recursive: i64 = 0
        loop {
            let Pi(erased, domain, rest) = self.term(ty) else { break }
            let normal = self.normal(domain, depth)?
            let (heap, own) = match self.term(normal) {
                Ind(g, _) => (g == f || self.is_boxed(g), g == f)
                _ => (false, false)
            }
            if heap && !erased {
                if own { recursive += 1 }
                fields.push((false, self.add(Term.Ref(domain), sp)?))
            } else { fields.push((erased, domain)) }
            ty = rest
        }
        let m = fields.len()
        let extra = if recursion { recursive } else { 0 }
        var result = self.shift(t, m + extra, 0, depth)?
        var j = extra
        while j > 0 {
            j -= 1
            let ih = self.shift(t, m + j, 0, depth)?
            result = self.add(Term.Pi(false, ih, result), sp)?
        }
        var i = m
        while i > 0 {
            i -= 1
            let (erased, domain) = fields[i]
            result = self.add(Term.Pi(erased, domain, result), sp)?
        }
        Ok(result)
    }

    // The case for constructor k of structural recursion on a heap data
    // type: (fields..., recursive ones erased) -> (ih_i : P(indices of r_i,
    // r_i))... -> P(indices..., c(ps, fields...)). The recursion consumes
    // the recursive fields, so the case sees them only in types and
    // evidence; the results ih are runtime values unless P is a proposition.
    pub fn recursion_case_type(
        inout self,
        f: u32,
        k: u32,
        p: u32,
        ps: [u32],
        proof: bool,
        sp: diag.Span,
        depth: u32
    ) -> Result(u32, diag.Diag) {
        let base = self.data_case_type(f, k, p, ps, sp, depth)?
        // Peel the fields, marking recursive ones erased.
        var fields = Vec((bool, u32)).new()
        var recursive = Vec(i64).new()
        var t = base
        loop {
            let Pi(erased, domain, rest) = self.term(t) else { break }
            match self.term(domain) {
                Ind(g, _) if g == f => { recursive.push(fields.len()); fields.push((true, domain)) }
                _ => fields.push((erased, domain))
            }
            t = rest
        }
        let m = fields.len()
        let r = recursive.len()
        var result = self.shift(t, r, 0, depth)?
        var q = r
        while q > 0 {
            q -= 1
            // Field j's type lives under its j preceding fields; ih_q is
            // under all m fields and the q hypotheses before it.
            let j = recursive[q]
            let Ind(_, indices) = self.term(fields[j].1) else {
                return Err(diag.Diag.new(sp, "core: malformed recursive field"))
            }
            let params = self.families[f as i64].params as i64
            var ih = self.shift(p, m + q, 0, depth)?
            for x in params..indices.len() {
                let index = self.shift(indices[x], m + q - j, 0, depth)?
                ih = self.add(Term.App(ih, index), sp)?
            }
            let field = self.add(Term.Var((m - 1 - j + q) as u32), sp)?
            ih = self.add(Term.App(ih, field), sp)?
            result = self.add(Term.Pi(proof, ih, result), sp)?
        }
        var j = m
        while j > 0 {
            j -= 1
            let (erased, domain) = fields[j]
            result = self.add(Term.Pi(erased, domain, result), sp)?
        }
        Ok(result)
    }

    // (i : U64) -> (erased p : Lt(i, n)) -> (acc : T) -> T, with n and the
    // accumulator's type T from the outer context. Also used to elaborate
    // source loop bodies.
    pub fn fold_body_type(
        inout self,
        n: u32,
        acc: u32,
        sp: diag.Span,
        depth: u32
    ) -> Result(u32, diag.Diag) {
        let u = self.add(Term.U64, sp)?
        let x0 = self.add(Term.Var(0), sp)?
        let bound = self.shift(n, 1, 0, depth)?
        let lt = self.add(Term.Lt(x0, bound), sp)?
        // The accumulator's type, under the index and the bound, and under
        // the accumulator itself for the result.
        let domain = self.shift(acc, 2, 0, depth)?
        let result = self.shift(acc, 3, 0, depth)?
        let ty = self.add(Term.Pi(false, domain, result), sp)?
        let ty = self.add(Term.Pi(true, lt, ty), sp)?
        self.add(Term.Pi(false, u, ty), sp)
    }

    fn indices(inout self, xs: [u32], f: u32, ctx: [Binding], at: u32) -> Result((), diag.Diag) {
        if xs.len != self.families[f as i64].arity as i64 {
            return Err(self.error(at, "wrong number of family indices"))
        }
        let sp = self.nodes[at as i64].span
        let u = self.add(Term.U64, sp)?
        for x in xs { self.require(x, u, ctx, true, DEPTH)? }
        Ok(())
    }

    // Strict positivity: while family f is checked it is not yet visible,
    // so infer rejects it everywhere except as a whole recursive field
    // F(indices) or the constructor's result, which are matched here.
    fn signature(inout self, f: u32, ty: u32) -> Result(Signature, diag.Diag) {
        // The telescope is checked as written, before any normalization,
        // so evidence inside it is checked even where reduction removes it.
        var ty = ty
        var ctx = Vec(Binding).new()
        var fields = Vec(Field).new()
        loop {
            if (ty as i64) >= self.nodes.len() { return Err(self.error(
                ty,
                "invalid term reference"
            )) }
            match self.term(ty) {
                Pi(erased, domain, rest) => {
                    let recursive = match self.term(domain) {
                        Ind(g, xs) if g == f => Some(xs)
                        _ => None
                    }
                    let recursive = match recursive {
                        // A data type's recursive field is a runtime value
                        // with the same parameters: the type is boxed.
                        Some(xs) if self.is_data(f) => {
                            if erased { return Err(self.error(
                                domain,
                                "a recursive field of a data type is a value"
                            )) }
                            self.indices(xs.as_slice(), f, ctx.as_slice(), domain)?
                            let params = self.families[f as i64].params as i64
                            for j in 0..params {
                                let at = (ctx.len() - 1 - j) as u32
                                if self.term(xs[j]) != Term.Var(at) { return Err(self.error(
                                    domain,
                                    "a recursive field has its type's parameters"
                                )) }
                            }
                            Some(self.normal_all(xs.as_slice(), DEPTH)?)
                        }
                        Some(xs) => {
                            if !erased { return Err(self.error(
                                domain,
                                "recursive constructor fields must be erased"
                            )) }
                            self.indices(xs.as_slice(), f, ctx.as_slice(), domain)?
                            Some(self.normal_all(xs.as_slice(), DEPTH)?)
                        }
                        None => {
                            self.binder(domain, erased, ctx.as_slice(), DEPTH)?
                            None
                        }
                    }
                    let domain = self.normal(domain, DEPTH)?
                    if !erased && !self.is_data(f) && self.term(domain) != Term.U64 {
                        return Err(self.error(domain, "constructor data fields must be u64"))
                    }
                    // Data types hold first-order values: scalars,
                    // refinements and earlier data types.
                    let first_order = match self.term(domain) {
                        U64 | I64 | Refine(_) => true
                        Ind(g, _) => self.is_data(g)
                        _ => false
                    } || recursive.is_some()
                    if !erased && !first_order { return Err(self.error(
                        domain,
                        "data fields are u64, i64, refinements or data types"
                    )) }
                    fields.push(Field { erased, domain, recursive })
                    ctx.push(Binding { ty: domain, erased })
                    ty = rest
                }
                Ind(g, xs) if g == f => {
                    self.indices(xs.as_slice(), f, ctx.as_slice(), ty)?
                    // Parameters are bound first, erased u64, and returned
                    // unchanged, as written.
                    let params = self.families[f as i64].params as i64
                    let m = fields.len()
                    for j in 0..params {
                        let bound = j < m && fields[j].erased && fields[j].recursive.is_none() &&
                            self.term(fields[j].domain) == Term.U64
                        if !bound || xs.len() <= j ||
                            self.term(xs[j]) != Term.Var((m - 1 - j) as u32) {
                            return Err(self.error(
                                ty,
                                "a constructor binds its type's parameters first and returns them"
                            ))
                        }
                    }
                    let result = self.normal_all(xs.as_slice(), DEPTH)?
                    return Ok(Signature { fields, result })
                }
                _ => return Err(self.error(
                    ty,
                    "a constructor type is a telescope ending in its own family"
                ))
            }
        }
    }

    fn declare(inout self, f: u32) -> Result((), diag.Diag) {
        let sp = self.families[f as i64].span
        if self.families[f as i64].arity > 16 {
            return Err(diag.Diag.new(sp, "core: inductive families have at most 16 indices"))
        }
        let params = self.families[f as i64].params
        if params > self.families[f as i64].arity || (params != 0 && !self.families[f as i64].data) {
            return Err(diag.Diag.new(sp, "core: parameters are leading indices of a data type"))
        }
        var signatures = Vec(Signature).new()
        for k in 0..self.families[f as i64].constructors.len() {
            let ty = self.families[f as i64].constructors[k].ty
            signatures.push(self.signature(f, ty)?)
        }
        // On the heap: a recursive field, or a field that is on the heap.
        var boxed = false
        var flat = false
        for sig in signatures {
            for field in sig.fields {
                if field.erased { continue }
                if field.recursive.is_some() { boxed = true; continue }
                match self.term(field.domain) {
                    Ind(g, _) => if self.is_boxed(g) { boxed = true } else { flat = true }
                    _ => {}
                }
            }
        }
        // A heap node stores its fields; a data value without a
        // representation cannot be one of them.
        if boxed && flat { return Err(diag.Diag.new(
            sp,
            "core: a heap data type cannot hold a data value without a representation"
        )) }
        self.signatures.push(signatures)
        self.boxed.push(boxed && self.families[f as i64].data)
        Ok(())
    }

    pub fn infer(
        inout self,
        id: u32,
        ctx: [Binding],
        ghost: bool,
        depth: u32
    ) -> Result(u32, diag.Diag) {
        let head = self.spine
        self.spine = false
        self.tick(id, depth)?
        let sp = self.nodes[id as i64].span
        let ty = match self.term(id) {
            Var(k) => {
                if k as i64 >= ctx.len { return Err(self.error(id, "unbound variable")) }
                let b = ctx[ctx.len - 1 - k as i64]
                if b.erased && !ghost { return Err(self.error(
                    id,
                    "erased value used at runtime"
                )) }
                return self.shift(b.ty, k as i64 + 1, 0, depth - 1)
            }
            Global(g) => {
                if g >= self.visible { return Err(self.error(id, "recursive or forward definition")) }
                let ty = self.definitions[g as i64].ty
                return self.shift(ty, ctx.len, 0, depth - 1)
            }
            Universe(level) => {
                if level >= 32 { return Err(self.error(id, "universe level limit reached")) }
                Term.Universe(level + 1)
            }
            Prop | U64 | I64 => Term.Universe(0)
            Natural(_) => Term.U64
            Integer(_) => Term.I64
            Array(n) => {
                let u = self.add(Term.U64, sp)?
                self.require(n, u, ctx, true, depth - 1)?
                Term.Universe(0)
            }
            Eq(a, b) | Lt(a, b) => {
                let u = self.add(Term.U64, sp)?
                self.require(a, u, ctx, true, depth - 1)?
                self.require(b, u, ctx, true, depth - 1)?
                Term.Prop
            }
            Refl(a) => {
                let u = self.add(Term.U64, sp)?
                self.require(a, u, ctx, true, depth - 1)?
                Term.Eq(a, a)
            }
            Ind(f, xs) => {
                self.family_ref(id, f)?
                self.indices(xs.as_slice(), f, ctx, id)?
                if self.is_data(f) { Term.Universe(0) } else { Term.Prop }
            }
            Con(f, k, xs) => {
                self.family_ref(id, f)?
                if k as i64 >= self.families[f as i64].constructors.len() {
                    return Err(self.error(id, "unknown constructor"))
                }
                // Instantiate the closed constructor telescope field by field.
                let closed = self.families[f as i64].constructors[k as i64].ty
                var ty = self.shift(closed, ctx.len, 0, depth - 1)?
                for x in xs {
                    let normal = self.normal(ty, depth - 1)?
                    let Pi(erased, domain, result) = self.term(normal) else {
                        return Err(self.error(x, "too many constructor fields"))
                    }
                    // Data fields of a data value are runtime data.
                    let relevant = self.is_data(f) && !erased
                    self.require(x, domain, ctx, ghost || !relevant, depth - 1)?
                    ty = self.substitute(result, x, depth - 1)?
                }
                let ty = self.normal(ty, depth - 1)?
                let Ind(_, _) = self.term(ty) else { return Err(self.error(
                    id,
                    "a constructor needs all of its fields"
                )) }
                return Ok(ty)
            }
            Elim(f, p, cases, x) => {
                self.family_ref(id, f)?
                if cases.len() != self.families[f as i64].constructors.len() {
                    return Err(self.error(id, "induction needs one case per constructor"))
                }
                if self.is_data(f) { return self.eliminate(false,
                    id,
                    f,
                    p,
                    cases.as_slice(),
                    x,
                    ctx,
                    ghost,
                    depth
                ) }
                let motive = self.motive_type(f, sp)?
                self.require(p, motive, ctx, true, depth - 1)?
                for k, case in cases {
                    let expected = self.case_type(f, k as u32, p, sp, depth - 1)?
                    self.require(case, expected, ctx, true, depth - 1)?
                }
                let ty = self.infer(x, ctx, true, depth - 1)?
                let ty = self.normal(ty, depth - 1)?
                let Ind(g, indices) = self.term(ty) else {
                    return Err(self.error(x, "induction requires evidence of its family"))
                }
                if g != f { return Err(self.error(x, "induction requires evidence of its family")) }
                var result = p
                for i in indices { result = self.add(Term.App(result, i), sp)? }
                return Ok(result)
            }
            Case(f, p, cases, x) => {
                self.family_ref(id, f)?
                if !self.is_boxed(f) { return Err(self.error(
                    id,
                    "one-level case analysis is for heap data"
                )) }
                if cases.len() != self.families[f as i64].constructors.len() {
                    return Err(self.error(id, "case analysis needs one case per constructor"))
                }
                return self.eliminate(true, id, f, p, cases.as_slice(), x, ctx, ghost, depth)
            }
            Arith(_, a, b) => {
                let i = self.add(Term.I64, sp)?
                self.require(a, i, ctx, ghost, depth - 1)?
                self.require(b, i, ctx, ghost, depth - 1)?
                Term.I64
            }
            Strict(a, b) => {
                self.infer(a, ctx, ghost, depth - 1)?
                return self.infer(b, ctx, ghost, depth - 1)
            }
            UAdd(a, b) => {
                let u = self.add(Term.U64, sp)?
                self.require(a, u, ctx, ghost, depth - 1)?
                self.require(b, u, ctx, ghost, depth - 1)?
                Term.U64
            }
            USub(a, b, p) => {
                let u = self.add(Term.U64, sp)?
                self.require(a, u, ctx, ghost, depth - 1)?
                self.require(b, u, ctx, ghost, depth - 1)?
                let one = self.add(Term.Natural(1), sp)?
                let a1 = self.add(Term.UAdd(a, one), sp)?
                let le = self.add(Term.Lt(b, a1), sp)?
                self.require(p, le, ctx, true, depth - 1)?
                Term.U64
            }
            ZeroLe(a) => {
                let u = self.add(Term.U64, sp)?
                self.require(a, u, ctx, true, depth - 1)?
                let zero = self.add(Term.Natural(0), sp)?
                let one = self.add(Term.Natural(1), sp)?
                let a1 = self.add(Term.UAdd(a, one), sp)?
                Term.Lt(zero, a1)
            }
            Refine(p) => {
                let family = self.predicate(sp)?
                self.require(p, family, ctx, true, depth - 1)?
                Term.Universe(0)
            }
            Pack(p, a, q) => {
                let family = self.predicate(sp)?
                self.require(p, family, ctx, true, depth - 1)?
                let u = self.add(Term.U64, sp)?
                self.require(a, u, ctx, ghost, depth - 1)?
                let holds = self.add(Term.App(p, a), sp)?
                self.require(q, holds, ctx, true, depth - 1)?
                Term.Refine(p)
            }
            Buffer(n) => {
                let u = self.add(Term.U64, sp)?
                self.require(n, u, ctx, true, depth - 1)?
                Term.Universe(0)
            }
            Alloc(n, x) => {
                let u = self.add(Term.U64, sp)?
                self.require(n, u, ctx, ghost, depth - 1)?
                let i = self.add(Term.I64, sp)?
                self.require(x, i, ctx, ghost, depth - 1)?
                Term.Buffer(n)
            }
            Store(b, i, v, p) => {
                let n = self.buffer_length(b, ctx, ghost, depth)?
                let u = self.add(Term.U64, sp)?
                self.require(i, u, ctx, ghost, depth - 1)?
                let t = self.add(Term.I64, sp)?
                self.require(v, t, ctx, ghost, depth - 1)?
                let lt = self.add(Term.Lt(i, n), sp)?
                self.require(p, lt, ctx, true, depth - 1)?
                Term.Buffer(n)
            }
            Load(b, i, p, k) => {
                let n = self.buffer_length(b, ctx, ghost, depth)?
                let u = self.add(Term.U64, sp)?
                self.require(i, u, ctx, ghost, depth - 1)?
                let lt = self.add(Term.Lt(i, n), sp)?
                self.require(p, lt, ctx, true, depth - 1)?
                // k : (x : I64) -> (b : Buffer(n)) -> T, T independent of both.
                let ty = self.infer(k, ctx, ghost, depth - 1)?
                let ty = self.normal(ty, depth - 1)?
                let Pi(false, x, rest) = self.term(ty) else {
                    return Err(self.error(k, "load continues with fn(x, b) { ... }"))
                }
                let Pi(false, again, result) = self.term(rest) else {
                    return Err(self.error(k, "load continues with fn(x, b) { ... }"))
                }
                let i64 = self.add(Term.I64, sp)?
                let n2 = self.shift(n, 1, 0, depth - 1)?
                let same = self.add(Term.Buffer(n2), sp)?
                if !self.equal(x, i64, depth - 1)? || !self.equal(again, same, depth - 1)? {
                    return Err(self.error(k, "load continues with the value and the same buffer"))
                }
                let result = self.normal(result, depth - 1)?
                let result = self.shift(result, -2, 0, depth - 1)?
                self.not_function(k, result, depth - 1)?
                return Ok(result)
            }
            Free(b, rest) => {
                self.buffer_length(b, ctx, ghost, depth)?
                return self.infer(rest, ctx, ghost, depth - 1)
            }
            Drop(f, x, rest) => {
                self.family_ref(id, f)?
                if !self.is_boxed(f) { return Err(self.error(id, "drop frees heap data")) }
                let ty = self.infer(x, ctx, ghost, depth - 1)?
                let ty = self.normal(ty, depth - 1)?
                let Ind(g, _) = self.term(ty) else {
                    return Err(self.error(x, "drop requires a value of its type"))
                }
                if g != f { return Err(self.error(x, "drop requires a value of its type")) }
                return self.infer(rest, ctx, ghost, depth - 1)
            }
            Ref(t) => {
                let sort = self.infer(t, ctx, true, depth - 1)?
                if self.sort(sort, depth - 1)? != 0 || !self.owned(t, depth - 1)? {
                    return Err(self.error(id, "a borrow is of a buffer or heap data"))
                }
                Term.Universe(0)
            }
            // In types and evidence, which never run, nothing is lent. In code,
            // a borrow is of an owner a lend is lending, inside its reader.
            Borrow(x) => {
                if !ghost && !self.lending(x, ctx.len, depth - 1)? {
                    return Err(self.error(id, "a borrow of a value is evidence only"))
                }
                let t = self.infer(x, ctx, true, depth - 1)?
                if !self.owned(t, depth - 1)? {
                    return Err(self.error(x, "a borrow is of a buffer or heap data"))
                }
                Term.Ref(t)
            }
            Lend(x, f, g) => {
                let t = self.infer(x, ctx, ghost, depth - 1)?
                if !self.owned(t, depth - 1)? {
                    return Err(self.error(x, "only an owned value is lent"))
                }
                let borrow = self.add(Term.Ref(t), sp)?
                match self.dependent_lend(x, f, g, sp, depth - 1)? {
                    Some((domain, read, rest)) => {
                        self.binder(domain, false, ctx, depth - 1)?
                        if !self.equal(domain, borrow, depth - 1)? {
                            return Err(self.error(f, "a lend reads through a borrow of its owner"))
                        }
                        self.lent.push((ctx.len, x))
                        let a = self.infer(read, ctx, ghost, depth - 1)
                        self.lent.pop()
                        let a = self.normal(a?, depth - 1)?
                        self.outlived(f, a)?
                        let Lam(false, first, inner) = self.term(g) else {
                            return Err(self.error(g, "a lend continues with fn(a, x) { ... }"))
                        }
                        let Lam(false, again, _) = self.term(inner) else {
                            return Err(self.error(g, "a lend continues with fn(a, x) { ... }"))
                        }
                        let back = self.shift(t, 1, 0, depth - 1)?
                        self.binder(first, false, ctx, depth - 1)?
                        if !self.equal(first, a, depth - 1)? || !self.equal(again, back, depth - 1)? {
                            return Err(self.error(
                                g,
                                "a lend continues with the result and the owner"
                            ))
                        }
                        // The continuation, with the owner given back as x
                        // itself, uses x exactly once.
                        let ty = self.infer(rest, ctx, ghost, depth - 1)?
                        let ty = self.normal(ty, depth - 1)?
                        let Pi(false, _, result) = self.term(ty) else {
                            return Err(self.error(g, "a lend continues with fn(a, x) { ... }"))
                        }
                        if !ghost {
                            let Var(k) = self.term(x) else { return Err(self.error(
                                x,
                                "unreachable"
                            )) }
                            if self.uses_case(rest, 1, k, ctx, depth)? != 1 {
                                return Err(self.error(
                                    g,
                                    "a lent owner is used exactly once after its lend"
                                ))
                            }
                        }
                        let result = self.normal(result, depth - 1)?
                        let result = self.shift(result, -1, 0, depth - 1)?
                        self.not_function(g, result, depth - 1)?
                        return Ok(result)
                    }
                    None => {}
                }
                // f : Ref(T) -> A, A independent of the borrow.
                let ty = self.infer(f, ctx, ghost, depth - 1)?
                let ty = self.normal(ty, depth - 1)?
                let Pi(false, domain, a) = self.term(ty) else {
                    return Err(self.error(f, "a lend reads with fn(r) { ... }"))
                }
                if !self.equal(domain, borrow, depth - 1)? {
                    return Err(self.error(f, "a lend reads through a borrow of its owner"))
                }
                let a = self.shift(a, -1, 0, depth - 1)?
                let a = self.normal(a, depth - 1)?
                self.outlived(f, a)?
                // g : A -> T -> R, R independent of both.
                let ty = self.infer(g, ctx, ghost, depth - 1)?
                let ty = self.normal(ty, depth - 1)?
                let Pi(false, first, rest) = self.term(ty) else {
                    return Err(self.error(g, "a lend continues with fn(a, x) { ... }"))
                }
                let Pi(false, again, result) = self.term(rest) else {
                    return Err(self.error(g, "a lend continues with fn(a, x) { ... }"))
                }
                let back = self.shift(t, 1, 0, depth - 1)?
                if !self.equal(first, a, depth - 1)? || !self.equal(again, back, depth - 1)? {
                    return Err(self.error(g, "a lend continues with the result and the owner"))
                }
                let result = self.normal(result, depth - 1)?
                let result = self.shift(result, -2, 0, depth - 1)?
                self.not_function(g, result, depth - 1)?
                return Ok(result)
            }
            View(recursion, f, t, cases, x) => {
                self.family_ref(id, f)?
                if !self.is_boxed(f) ||
                    self.families[f as i64].arity != self.families[f as i64].params {
                    return Err(self.error(id, "a view reads heap data without indices"))
                }
                if cases.len() != self.families[f as i64].constructors.len() {
                    return Err(self.error(id, "a view needs one case per constructor"))
                }
                let ty = self.infer(x, ctx, ghost, depth - 1)?
                let ty = self.normal(ty, depth - 1)?
                let Ref(inner) = self.term(ty) else {
                    return Err(self.error(x, "a view reads a borrow"))
                }
                let inner = self.normal(inner, depth - 1)?
                let Ind(g, xs) = self.term(inner) else {
                    return Err(self.error(x, "a view reads a borrow of its type"))
                }
                if g != f { return Err(self.error(x, "a view reads a borrow of its type")) }
                let sort = self.infer(t, ctx, true, depth - 1)?
                if self.sort(sort, depth - 1)? != 0 {
                    return Err(self.error(t, "a view's result is runtime data"))
                }
                self.not_function(t, t, depth - 1)?
                for k, case in cases {
                    let expected = self.view_case_type(
                        f,
                        k as u32,
                        xs.as_slice(),
                        t,
                        recursion,
                        sp,
                        depth - 1
                    )?
                    self.require(case, expected, ctx, ghost, depth - 1)?
                }
                return Ok(t)
            }
            Witness(s) | Proof(s) => {
                let proof = match self.term(id) { Proof(_) => true, _ => false }
                // The evidence is erased: only the witness is runtime data.
                let ty = self.infer(s, ctx, ghost || proof, depth - 1)?
                let ty = self.normal(ty, depth - 1)?
                let Refine(p) = self.term(ty) else {
                    return Err(self.error(s, "expected a refinement"))
                }
                if !proof { return self.add(Term.U64, sp) }
                let w = self.add(Term.Witness(s), sp)?
                Term.App(p, w)
            }
            LtAdd(a, b, c, p) | LtCancel(a, b, c, p) => {
                let forward = match self.term(id) { LtAdd(_, _, _, _) => true, _ => false }
                let u = self.add(Term.U64, sp)?
                for x in [a, b, c] { self.require(x, u, ctx, true, depth - 1)? }
                let ac = self.add(Term.UAdd(a, c), sp)?
                let bc = self.add(Term.UAdd(b, c), sp)?
                let plain = self.add(Term.Lt(a, b), sp)?
                let shifted = self.add(Term.Lt(ac, bc), sp)?
                self.require(p, if forward { plain } else { shifted }, ctx, true, depth - 1)?
                return Ok(if forward { shifted } else { plain })
            }
            LtLe(x, y, z, p, q) => {
                let u = self.add(Term.U64, sp)?
                for v in [x, y, z] { self.require(v, u, ctx, true, depth - 1)? }
                let one = self.add(Term.Natural(1), sp)?
                let z1 = self.add(Term.UAdd(z, one), sp)?
                let first = self.add(Term.Lt(x, y), sp)?
                let second = self.add(Term.Lt(y, z1), sp)?
                self.require(p, first, ctx, true, depth - 1)?
                self.require(q, second, ctx, true, depth - 1)?
                Term.Lt(x, z)
            }
            Fold(n, init, body) => {
                let u = self.add(Term.U64, sp)?
                self.require(n, u, ctx, ghost, depth - 1)?
                // The accumulator is an I64 or an owned buffer.
                let acc = self.infer(init, ctx, ghost, depth - 1)?
                let acc = self.normal(acc, depth - 1)?
                let owned = self.owned(acc, depth - 1)?
                match self.term(acc) {
                    I64 => {}
                    _ => if !owned { return Err(self.error(
                        init,
                        "a loop accumulator is an i64 or an owned value"
                    )) }
                }
                let ty = self.fold_body_type(n, acc, sp, depth - 1)?
                self.require(body, ty, ctx, ghost, depth - 1)?
                // The body is evaluated each iteration: an expression that
                // touches memory to produce it would be repeated.
                if !self.binders(body, 3) && self.effectful(body, depth - 1) {
                    return Err(self.error(
                        body,
                        "a loop body that touches memory is fn(i, p, acc) { ... }"
                    ))
                }
                return Ok(acc)
            }
            Transport(family, evidence, proof) => {
                // Restrict equality elimination to propositions. In
                // particular this cannot cast an array's runtime layout.
                let u = self.add(Term.U64, sp)?
                let prop = self.add(Term.Prop, sp)?
                let family_ty = self.add(Term.Pi(false, u, prop), sp)?
                self.require(family, family_ty, ctx, true, depth - 1)?
                let eq_ty = self.infer(evidence, ctx, true, depth - 1)?
                let eq_ty = self.normal(eq_ty, depth - 1)?
                let Eq(a, b) = self.term(eq_ty) else {
                    return Err(self.error(evidence, "transport requires U64 equality evidence"))
                }
                let from = self.add(Term.App(family, a), sp)?
                self.require(proof, from, ctx, true, depth - 1)?
                return self.add(Term.App(family, b), sp)
            }
            Pi(erased, a, b) => {
                let level = self.binder(a, erased, ctx, depth - 1)?
                var inner = Vec(Binding).new()
                for x in ctx { inner.push(x) }
                inner.push(Binding { ty: a, erased })
                let ty = self.infer(b, inner.as_slice(), true, depth - 1)?
                let result = self.sort(ty, depth - 1)?
                if result == -1 { Term.Prop } else { Term.Universe(
                    max(max(level, 0), result) as u32
                ) }
            }
            Lam(erased, a, body) => {
                self.binder(a, erased, ctx, depth - 1)?
                var inner = Vec(Binding).new()
                for x in ctx { inner.push(x) }
                inner.push(Binding { ty: a, erased })
                let result = self.infer(body, inner.as_slice(), ghost, depth - 1)?
                if !ghost && !erased && self.owned(a, depth - 1)? {
                    let n = self.uses_function(body, 0, inner.as_slice(), depth - 1)?
                    if n == 0 { return Err(self.error(
                        id,
                        "an owned value must be used: freed, moved or returned"
                    )) }
                    if n > 1 { return Err(self.error(id, "an owned value is used more than once")) }
                }
                Term.Pi(erased, a, result)
            }
            App(f, a) => {
                self.spine = true
                let ty = self.infer(f, ctx, ghost, depth - 1)?
                self.spine = false
                let ty = self.normal(ty, depth - 1)?
                let Pi(erased, domain, result) = self.term(ty) else {
                    return Err(self.error(f, "application needs a dependent function"))
                }
                self.require(a, domain, ctx, ghost || erased, depth - 1)?
                // A type argument at run time is first order: a type
                // variable is used without linearity and may be returned
                // from a lend, so it cannot stand for an owned type, a
                // borrow or a function.
                if !ghost && self.kind_of(domain, depth - 1)? && !self.first_order(a, depth - 1)? {
                    return Err(self.error(
                        a,
                        "a type argument holds no buffer, heap data, borrow or function"
                    ))
                }
                let result = self.substitute(result, a, depth - 1)?
                // The top of a spine whose value is still a function is a
                // partial application, a function value that could run any
                // number of times: it cannot hold an owned value.
                if !head && !ghost {
                    let normal = self.normal(result, depth - 1)?
                    match self.term(normal) {
                        Pi(_, _, _) => self.unsaturated(id, ctx, depth)?
                        _ => {}
                    }
                }
                return Ok(result)
            }
            Elements(xs) => {
                let i = self.add(Term.I64, sp)?
                for x in xs { self.require(x, i, ctx, ghost, depth - 1)? }
                let n = self.add(Term.Natural(xs.len() as u64), sp)?
                Term.Array(n)
            }
            Index(array, index, proof) => {
                let ty = self.infer(array, ctx, ghost, depth - 1)?
                let ty = self.normal(ty, depth - 1)?
                // An array, or a borrowed buffer, which is read in place.
                let n = match self.term(ty) {
                    Array(n) => n
                    Ref(t) => {
                        let t = self.normal(t, depth - 1)?
                        let Buffer(n) = self.term(t) else { return Err(self.error(
                            array,
                            "index needs an indexed array or a borrowed buffer"
                        )) }
                        n
                    }
                    _ => return Err(self.error(array, "index needs an indexed array"))
                }
                let u = self.add(Term.U64, sp)?
                self.require(index, u, ctx, ghost, depth - 1)?
                let p = self.add(Term.Lt(index, n), sp)?
                self.require(proof, p, ctx, true, depth - 1)?
                Term.I64
            }
            Decide(a, b) => {
                let u = self.add(Term.U64, sp)?
                self.require(a, u, ctx, true, depth - 1)?
                self.require(b, u, ctx, true, depth - 1)?
                let x = self.normal(a, depth - 1)?
                let y = self.normal(b, depth - 1)?
                let valid = match (self.term(x), self.term(y)) {
                    (Natural(i), Natural(n)) => i < n
                    _ => false
                }
                if !valid { return Err(self.error(id, "decide-lt needs a true closed inequality")) }
                Term.Lt(a, b)
            }
            IfLt(a, b, yes, no) | IfEq(a, b, yes, no) => {
                let equality = match self.term(id) { IfEq(_, _, _, _) => true, _ => false }
                let u = self.add(Term.U64, sp)?
                self.require(a, u, ctx, ghost, depth - 1)?
                self.require(b, u, ctx, ghost, depth - 1)?
                let proposition = if equality { Term.Eq(a, b) } else { Term.Lt(a, b) }
                let p = self.add(proposition, sp)?
                var inner = Vec(Binding).new()
                for x in ctx { inner.push(x) }
                inner.push(Binding { ty: p, erased: true })
                let yes_ty = self.infer(yes, inner.as_slice(), ghost, depth - 1)?
                let yes_ty = self.normal(yes_ty, depth - 1)?
                let result = self.shift(yes_ty, -1, 0, depth - 1)?
                self.require(no, result, ctx, ghost, depth - 1)?
                return Ok(result)
            }
        }
        self.add(ty, sp)
    }

    // Whether a type's values are types or type families: an argument of
    // that type is a type argument.
    fn kind_of(inout self, domain: u32, depth: u32) -> Result(bool, diag.Diag) {
        var t = self.normal(domain, depth)?
        loop {
            match self.term(t) {
                Pi(_, _, rest) => t = rest
                Universe(_) => return Ok(true)
                _ => return Ok(false)
            }
        }
    }

    // Whether a type (or type family) is first order: it mentions no
    // buffer, heap data, borrow or function type anywhere.
    fn first_order(inout self, t: u32, depth: u32) -> Result(bool, diag.Diag) {
        let t = self.normal(t, depth)?
        self.plain(t, depth)
    }

    fn plain(inout self, t: u32, depth: u32) -> Result(bool, diag.Diag) {
        self.tick(t, depth)?
        match self.term(t) {
            Buffer(_) | Ref(_) | Pi(_, _, _) => return Ok(false)
            Ind(g, _) if self.is_boxed(g) => return Ok(false)
            // A type family's binders are its indices, not its values.
            Lam(_, _, body) => return self.plain(body, depth - 1)
            _ => {}
        }
        for child in children(self.term(t)) {
            if !self.plain(child, depth - 1)? { return Ok(false) }
        }
        Ok(true)
    }

    // A continuation that receives owned values (a load's, a lend's, a
    // case's) runs once with the arguments it is given: if its result were
    // a function, it could hold those values and run any number of times.
    fn not_function(inout self, at: u32, ty: u32, depth: u32) -> Result((), diag.Diag) {
        let t = self.normal(ty, depth)?
        match self.term(t) {
            Pi(_, _, _) => Err(self.error(at, "a continuation's result is not a function")),
            _ => Ok(())
        }
    }

    // The length n of a buffer b : Buffer(n), a runtime term.
    fn buffer_length(
        inout self,
        b: u32,
        ctx: [Binding],
        ghost: bool,
        depth: u32
    ) -> Result(u32, diag.Diag) {
        let ty = self.infer(b, ctx, ghost, depth - 1)?
        let ty = self.normal(ty, depth - 1)?
        let Buffer(n) = self.term(ty) else { return Err(self.error(b, "expected a buffer")) }
        Ok(n)
    }

    // Whether values of a type are owned: used exactly once at run time.
    pub fn owned(inout self, ty: u32, depth: u32) -> Result(bool, diag.Diag) {
        let ty = self.normal(ty, depth)?
        Ok(match self.term(ty) {
            Buffer(_) => true
            Ind(f, _) => self.is_boxed(f)
            _ => false
        })
    }

    // How many times evaluating a checked runtime term uses variable v at
    // run time. Types and evidence are not visited: their uses are not at
    // run time. Alternatives must use it equally, and a function other
    // than a redex's, a load's continuation or a case cannot capture it,
    // since it could run any number of times.
    fn uses(inout self, id: u32, v: u32, ctx: [Binding], depth: u32) -> Result(u32, diag.Diag) {
        self.tick(id, depth)?
        match self.term(id) {
            Var(k) => Ok(if k == v { 1 } else { 0 })
            App(_, _) => {
                // The whole spine: a head applied to its arguments.
                var nodes = Vec(u32).new()
                var args = Vec(u32).new()
                var head = id
                loop {
                    let App(f, a) = self.term(head) else { break }
                    nodes.insert(0, head)
                    args.insert(0, a)
                    head = f
                }
                var total: u32 = 0
                // A lambda head runs its body once, given its arguments.
                var binders = Vec((u32, bool)).new()
                var body = head
                var j = 0
                while j < args.len() {
                    let Lam(erased, domain, rest) = self.term(body) else { break }
                    binders.push((domain, erased))
                    if !erased { total += self.uses(args[j], v, ctx, depth - 1)? }
                    body = rest
                    j += 1
                }
                if j > 0 { total += self.uses_under(body, v, ctx, binders.as_slice(), depth)? }
                else { total += self.uses(head, v, ctx, depth - 1)? }
                if j < args.len() {
                    var ty = if j == 0 { self.infer(head, ctx, true, depth - 1)? }
                    else { self.infer(nodes[j - 1], ctx, true, depth - 1)? }
                    for k in j..args.len() {
                        let normal = self.normal(ty, depth - 1)?
                        let Pi(erased, _, result) = self.term(normal) else { return Err(self.error(
                            nodes[k],
                            "application needs a dependent function"
                        )) }
                        if !erased { total += self.uses(args[k], v, ctx, depth - 1)? }
                        ty = self.substitute(result, args[k], depth - 1)?
                    }
                }
                // A spine whose value is a function could be called any
                // number of times: it cannot capture an owned value.
                if total > 0 {
                    let ty = self.infer(id, ctx, true, depth - 1)?
                    let ty = self.normal(ty, depth - 1)?
                    match self.term(ty) {
                        Pi(_, _, _) => return Err(self.error(
                            id,
                            "a partial application cannot capture an owned value"
                        ))
                        _ => {}
                    }
                }
                Ok(total)
            }
            Lam(erased, domain, body) => {
                if self.uses_under(body, v, ctx, [(domain, erased)], depth)? > 0 {
                    return Err(self.error(id, "a function cannot capture an owned value"))
                }
                Ok(0)
            }
            IfLt(a, b, yes, no) | IfEq(a, b, yes, no) => {
                let equality = match self.term(id) { IfEq(_, _, _, _) => true, _ => false }
                let first = self.uses(a, v, ctx, depth - 1)? + self.uses(b, v, ctx, depth - 1)?
                let p = self.add(
                    if equality { Term.Eq(a, b) } else { Term.Lt(a, b) },
                    diag.Span.nowhere()
                )?
                let y = self.uses_under(yes, v, ctx, [(p, true)], depth)?
                let n = self.uses(no, v, ctx, depth - 1)?
                if y != n { return Err(self.error(
                    id,
                    "both branches must use an owned value alike"
                )) }
                Ok(first + y)
            }
            Elim(f, _, cases, x) | Case(f, _, cases, x) => {
                var total = self.uses(x, v, ctx, depth - 1)?
                if !self.is_data(f) { return Ok(0) }
                let recursion = self.is_boxed(f) && match self.term(id) { Elim(_, _, _, _) => true, _ => false }
                // Exactly one case runs; each must use the value alike. A
                // recursion's cases run once per node: they capture nothing.
                let params = self.families[f as i64].params as i64
                var common: Option(u32) = None
                for k, case in cases {
                    var count = self.signatures[f as i64][k].fields.len() - params
                    if recursion {
                        for field in self.signatures[f as i64][k].fields {
                            if field.recursive.is_some() { count += 1 }
                        }
                    }
                    let n = self.uses_case(case, count, v, ctx, depth)?
                    if recursion && n > 0 { return Err(self.error(
                        id,
                        "a recursion's cases run once per node: they cannot use an outer owned value"
                    )) }
                    match common {
                        Some(m) => if m != n { return Err(self.error(
                            id,
                            "every case must use an owned value alike"
                        )) }
                        None => common = Some(n)
                    }
                }
                match common { Some(m) => total += m, None => {} }
                Ok(total)
            }
            Load(b, i, _, k) => {
                let first = self.uses(b, v, ctx, depth - 1)? + self.uses(i, v, ctx, depth - 1)?
                Ok(first + self.uses_case(k, 2, v, ctx, depth)?)
            }
            // f and g each run once. A dependent lend is counted as it is
            // checked: its reader with r = Borrow(x), which uses nothing, and
            // its continuation with y = x, where x is used.
            Lend(x, f, g) => {
                let sp = self.nodes[id as i64].span
                match self.dependent_lend(x, f, g, sp, depth - 1)? {
                    Some((_, read, rest)) => {
                        self.lent.push((ctx.len, x))
                        let n = self.uses(read, v, ctx, depth - 1)
                        self.lent.pop()
                        Ok(n? + self.uses_case(rest, 1, v, ctx, depth)?)
                    }
                    None => Ok(
                        self.uses(x, v, ctx, depth - 1)? + self.uses_case(f, 1, v, ctx, depth)? +
                            self.uses_case(g, 2, v, ctx, depth)?
                    )
                }
            }
            View(recursion, f, _, cases, x) => {
                let total = self.uses(x, v, ctx, depth - 1)?
                // One case runs, or, in a recursion, each once per node.
                var common: Option(u32) = None
                for k, case in cases {
                    var count = self.signatures[f as i64][k].fields.len() -
                        self.families[f as i64].params as i64
                    if recursion {
                        for field in self.signatures[f as i64][k].fields {
                            if field.recursive.is_some() { count += 1 }
                        }
                    }
                    let n = self.uses_case(case, count, v, ctx, depth)?
                    if recursion && n > 0 { return Err(self.error(
                        id,
                        "a recursion's cases run once per node: they cannot use an outer owned value"
                    )) }
                    match common {
                        Some(m) => if m != n { return Err(self.error(
                            id,
                            "every case must use an owned value alike"
                        )) }
                        None => common = Some(n)
                    }
                }
                match common { Some(m) => Ok(total + m), None => Ok(total) }
            }
            Fold(n, init, body) => {
                let first = self.uses(n, v, ctx, depth - 1)? + self.uses(init, v, ctx, depth - 1)?
                if self.uses_case(body, 3, v, ctx, depth)? > 0 { return Err(self.error(
                    body,
                    "a loop body runs many times: pass an owned value as the accumulator"
                )) }
                Ok(first)
            }
            Con(f, k, fields) => {
                var ty = self.families[f as i64].constructors[k as i64].ty
                var total: u32 = 0
                for x in fields {
                    let Pi(erased, _, rest) = self.term(ty) else { break }
                    if !erased { total += self.uses(x, v, ctx, depth - 1)? }
                    ty = rest
                }
                Ok(total)
            }
            Pack(_, a, _) | Witness(a) => self.uses(a, v, ctx, depth - 1)
            Index(a, b, _) | USub(a, b, _) | Arith(_, a, b) | UAdd(a, b) | Strict(a, b) | Alloc(
                a,
                b
            ) | Free(a, b) | Drop(_, a, b) => Ok(
                self.uses(a, v, ctx, depth - 1)? + self.uses(b, v, ctx, depth - 1)?
            )
            Store(b, i, x, _) => Ok(
                self.uses(b, v, ctx, depth - 1)? + self.uses(i, v, ctx, depth - 1)? +
                    self.uses(x, v, ctx, depth - 1)?
            )
            Elements(xs) => {
                var total: u32 = 0
                for x in xs { total += self.uses(x, v, ctx, depth - 1)? }
                Ok(total)
            }
            _ => Ok(0)
        }
    }

    // A dependent lend: x a variable, f = fn(r) { body } and g = fn(a, y)
    // { rest }. f's body is checked with r = Borrow(x), so facts about x
    // hold of r and f's result type may mention Borrow(x); g's with y = x,
    // the same owner given back, so facts about x hold after the lend. Gives
    // f's domain, its body with r = Borrow(x), and fn(a) { rest } with y = x.
    // Lowering runs f and g themselves: r is x's pointer and y is x.
    fn dependent_lend(
        inout self,
        x: u32,
        f: u32,
        g: u32,
        sp: diag.Span,
        depth: u32
    ) -> Result(Option((u32, u32, u32)), diag.Diag) {
        let Var(_) = self.term(x) else { return Ok(None) }
        let Lam(false, domain, body) = self.term(f) else { return Ok(None) }
        let Lam(false, first, inner) = self.term(g) else { return Ok(None) }
        let Lam(false, _, rest) = self.term(inner) else { return Ok(None) }
        let lent = self.add(Term.Borrow(x), sp)?
        let read = self.substitute(body, lent, depth)?
        let owner = self.shift(x, 1, 0, depth)?
        let rest = self.substitute(rest, owner, depth)?
        let rest = self.add(Term.Lam(false, first, rest), sp)?
        Ok(Some((domain, read, rest)))
    }

    // No borrow outlives a lend's reader: its result a is a scalar, a
    // refinement, an array, a buffer or data, none of which holds a borrow;
    // not a borrow, a function or a type variable, which could stand for
    // either.
    fn outlived(inout self, f: u32, a: u32) -> Result((), diag.Diag) {
        let known = match self.term(a) {
            U64 | I64 | Refine(_) | Array(_) | Buffer(_) => true
            Ind(g, _) => self.is_data(g)
            _ => false
        }
        if !known { return Err(self.error(f, "a borrow cannot outlive its lend")) }
        Ok(())
    }

    // A lend's reader read = f's body with r = Borrow(x), inferred as the
    // kernel checks it: x, a variable, may be borrowed in code there.
    pub fn infer_reading(
        inout self,
        read: u32,
        x: u32,
        ctx: [Binding]
    ) -> Result(u32, diag.Diag) {
        self.lent.push((ctx.len, x))
        let a = self.infer(read, ctx, true, DEPTH)
        self.lent.pop()
        a
    }

    // Whether x, in a context of the given length, is an owner whose lend's
    // reader is being checked.
    fn lending(inout self, x: u32, len: i64, depth: u32) -> Result(bool, diag.Diag) {
        let Var(_) = self.term(x) else { return Ok(false) }
        var i = self.lent.len()
        while i > 0 {
            i -= 1
            let (at, y) = self.lent[i]
            if at > len { continue }
            let shifted = self.shift(y, len - at, 0, depth)?
            if self.identical(shifted, x, depth) { return Ok(true) }
        }
        Ok(false)
    }

    // A partial application's runtime arguments cannot be owned values.
    fn unsaturated(inout self, id: u32, ctx: [Binding], depth: u32) -> Result((), diag.Diag) {
        var at = id
        loop {
            let App(f, a) = self.term(at) else { break }
            let ty = self.infer(f, ctx, true, depth - 1)?
            let ty = self.normal(ty, depth - 1)?
            let Pi(erased, domain, _) = self.term(ty) else { break }
            if !erased && self.owned(domain, depth - 1)? {
                return Err(self.error(id, "a partial application cannot take an owned value"))
            }
            at = f
        }
        Ok(())
    }

    // Uses of v in the rest of a function: its later parameters' lambdas
    // are the same function, which runs once each time it is fully applied;
    // a partial application that captures v is rejected where it is made.
    fn uses_function(
        inout self,
        body: u32,
        v: u32,
        ctx: [Binding],
        depth: u32
    ) -> Result(u32, diag.Diag) {
        var inner = body
        var binders = Vec((u32, bool)).new()
        loop {
            let Lam(erased, domain, rest) = self.term(inner) else { break }
            binders.push((domain, erased))
            inner = rest
        }
        if binders.len() == 0 { return self.uses(body, v, ctx, depth) }
        self.uses_under(inner, v, ctx, binders.as_slice(), depth)
    }

    // Uses of v in a term under new binders (outermost first).
    fn uses_under(
        inout self,
        body: u32,
        v: u32,
        ctx: [Binding],
        binders: [(u32, bool)],
        depth: u32
    ) -> Result(u32, diag.Diag) {
        var inner = Vec(Binding).new()
        for x in ctx { inner.push(x) }
        for (ty, erased) in binders { inner.push(Binding { ty, erased }) }
        self.uses(body, v + binders.len as u32, inner.as_slice(), depth - 1)
    }

    // Uses at run time of variable v in a term under new binders
    // (outermost first), for the source elaborator, which inserts the frees
    // that are missing. Like every elaborator query, the answer is not
    // trusted: the kernel checks the result.
    pub fn runtime_uses(
        inout self,
        body: u32,
        v: u32,
        ctx: [Binding],
        binders: [(u32, bool)]
    ) -> Result(u32, diag.Diag) {
        self.uses_under(body, v, ctx, binders, DEPTH)
    }

    // Uses of v in a function that runs once, given `count` arguments: a
    // case or a load's continuation, which may capture owned values.
    fn uses_case(
        inout self,
        f: u32,
        count: i64,
        v: u32,
        ctx: [Binding],
        depth: u32
    ) -> Result(u32, diag.Diag) {
        var body = f
        var binders = Vec((u32, bool)).new()
        for _ in 0..count {
            let Lam(erased, domain, rest) = self.term(body) else { break }
            binders.push((domain, erased))
            body = rest
        }
        if binders.len() as i64 != count { return self.uses(f, v, ctx, depth - 1) }
        self.uses_under(body, v, ctx, binders.as_slice(), depth)
    }

    // Case analysis of a data value. The motive P : F -> Prop or F -> Type 0
    // depends on the value; each case gives P(c(x...)) from c's fields. Into
    // Prop the whole elimination is evidence; into Type 0 it is runtime
    // code, the cases functions of the fields and the value runtime data.
    fn eliminate(
        inout self,
        analysis: bool,
        id: u32,
        f: u32,
        p: u32,
        cases: [u32],
        x: u32,
        ctx: [Binding],
        ghost: bool,
        depth: u32
    ) -> Result(u32, diag.Diag) {
        let sp = self.nodes[id as i64].span
        // The value's type gives the parameters and the indices.
        let ty = self.infer(x, ctx, true, depth - 1)?
        let ty = self.normal(ty, depth - 1)?
        let Ind(g, xs) = self.term(ty) else {
            return Err(self.error(x, "case analysis requires a value of its type"))
        }
        if g != f { return Err(self.error(x, "case analysis requires a value of its type")) }
        let params = self.families[f as i64].params as i64
        let r = self.families[f as i64].arity as i64 - params
        var ps = Vec(u32).new()
        for j in 0..params { ps.push(xs[j]) }
        // P : (indices) -> F(ps, indices) -> Prop or Type 0.
        let ty = self.infer(p, ctx, true, depth - 1)?
        var t = self.normal(ty, depth - 1)?
        for _ in 0..r {
            let Pi(false, index, rest) = self.term(t) else {
                return Err(self.error(
                    p,
                    "a data motive is a function of the indices and the value"
                ))
            }
            if self.term(index) != Term.U64 {
                return Err(self.error(
                    p,
                    "a data motive is a function of the indices and the value"
                ))
            }
            t = rest
        }
        let Pi(false, domain, sort) = self.term(t) else {
            return Err(self.error(p, "a data motive is a function of the indices and the value"))
        }
        var expected = Vec(u32).new()
        for q in ps { expected.push(self.shift(q, r, 0, depth - 1)?) }
        for j in 0..r { expected.push(self.add(Term.Var((r - 1 - j) as u32), sp)?) }
        let family = self.add(Term.Ind(f, expected), sp)?
        if !self.equal(domain, family, depth - 1)? {
            return Err(self.error(p, "a data motive is a function of the indices and the value"))
        }
        let sort = self.normal(sort, depth - 1)?
        let proof = match self.term(sort) {
            Prop => true
            Universe(0) => false
            _ => return Err(self.error(p, "data elimination is into Prop or Type 0"))
        }
        for k, case in cases {
            // Recursion on a heap type gives each case the results for its
            // recursive fields; one-level analysis gives the fields.
            let expected = if self.is_boxed(f) && !analysis {
                self.recursion_case_type(f, k as u32, p, ps.as_slice(), proof, sp, depth - 1)?
            } else { self.data_case_type(f, k as u32, p, ps.as_slice(), sp, depth - 1)? }
            self.require(case, expected, ctx, ghost || proof, depth - 1)?
        }
        // Into Type 0 the value is runtime data.
        self.infer(x, ctx, ghost || proof, depth - 1)?
        var result = p
        for j in params..xs.len() { result = self.add(Term.App(result, xs[j]), sp)? }
        let result = self.add(Term.App(result, x), sp)?
        if !proof { self.not_function(p, result, depth - 1)? }
        Ok(result)
    }

    // Check graph integrity independently of the parser. Definitions are
    // checked in order; no definition can use itself or a later one.
    pub fn check(inout self) -> Result((), diag.Diag) {
        self.steps = 0
        self.signatures = Vec(Vec(Signature)).new()
        self.boxed = Vec(bool).new()
        if self.nodes.len() > LIMIT { return Err(self.error(0, "term limit reached")) }
        for i in 0..self.nodes.len() {
            for child in children(self.nodes[i].term) {
                if child as i64 >= i { return Err(self.error(
                    i as u32,
                    "cyclic or invalid term graph"
                )) }
            }
        }
        let count = self.definitions.len()
        var f = 0
        for i in 0..count + 1 {
            while f < self.families.len() && self.families[f].globals as i64 == i {
                self.visible = i as u32
                self.visible_families = f as u32
                self.declare(f as u32)?
                f += 1
            }
            if i == count { break }
            self.visible = i as u32
            self.visible_families = f as u32
            let ty = self.definitions[i].ty
            let value = self.definitions[i].value
            let sort = self.infer(ty, [], true, DEPTH)?
            let ghost = self.sort(sort, DEPTH)? == -1
            self.require(value, ty, [], ghost, DEPTH)?
        }
        if f != self.families.len() { return Err(diag.Diag.new(
            self.families[f].span,
            "core: inductive families must follow the definitions they use, in order"
        )) }
        self.visible = count as u32
        self.visible_families = f as u32
        Ok(())
    }
}

// The position of a term's constructor, for ordering terms.
fn rank(term: Term) -> u32 {
    match term {
        Var(_) => 0, Global(_) => 1, Universe(_) => 2, Prop => 3, U64 => 4, I64 => 5,
        Array(_) => 6, Lt(_, _) => 7, Eq(_, _) => 8, Refl(_) => 9, Transport(_, _, _) => 10,
        Ind(_, _) => 11, Con(_, _, _) => 12, Elim(_, _, _, _) => 13, Arith(_, _, _) => 14,
        Fold(_, _, _) => 15, Strict(_, _) => 16, UAdd(_, _) => 17, LtAdd(_, _, _, _) => 18,
        LtCancel(_, _, _, _) => 19, LtLe(_, _, _, _, _) => 20, USub(_, _, _) => 21,
        ZeroLe(_) => 22, Refine(_) => 23, Pack(_, _, _) => 24, Witness(_) => 25, Proof(_) => 26,
        Buffer(_) => 27, Alloc(_, _) => 28, Load(_, _, _, _) => 29, Store(_, _, _, _) => 30,
        Free(_, _) => 31, Case(_, _, _, _) => 32, Pi(_, _, _) => 33, Lam(_, _, _) => 34,
        App(_, _) => 35, Natural(_) => 36, Integer(_) => 37, Elements(_) => 38,
        Index(_, _, _) => 39, Decide(_, _) => 40, IfLt(_, _, _, _) => 41, IfEq(_, _, _, _) => 42,
        Drop(_, _, _) => 43, Ref(_) => 44, Lend(_, _, _) => 45, View(_, _, _, _, _) => 46,
        Borrow(_) => 47
    }
}

// What distinguishes terms with the same constructor besides children.
fn payload(term: Term) -> Vec(i128) {
    var out = Vec(i128).new()
    match term {
        Var(k) | Global(k) | Universe(k) | Ind(k, _) | Elim(k, _, _, _) | Case(k, _, _, _) | Drop(
            k,
            _,
            _
        ) => out.push(k as i128)
        Natural(n) => out.push(n as i128)
        Integer(n) => out.push(n as i128)
        Con(f, k, _) => { out.push(f as i128); out.push(k as i128) }
        Arith(op, _, _) => out.push(match op { Add => 0, Sub => 1, Mul => 2 })
        Pi(e, _, _) | Lam(e, _, _) => out.push(if e { 1 } else { 0 })
        View(r, f, _, _, _) => { out.push(if r { 1 } else { 0 }); out.push(f as i128) }
        _ => {}
    }
    out
}

pub fn children(term: Term) -> Vec(u32) {
    var out = Vec(u32).new()
    match term {
        Array(n) | Refl(n) => out.push(n)
        Eq(a, b) | Lt(a, b) | App(a, b) | Decide(a, b) | Pi(_, a, b) | Lam(_, a, b) => {
            out.push(a)
            out.push(b)
        }
        Arith(_, a, b) | Strict(a, b) | UAdd(a, b) => { out.push(a); out.push(b) }
        LtAdd(a, b, c, p) | LtCancel(a, b, c, p) => { out.push(a); out.push(b); out.push(c); out.push(
            p
        ) }
        LtLe(a, b, c, p, q) => { out.push(a); out.push(b); out.push(c); out.push(p); out.push(q) }
        USub(a, b, p) => { out.push(a); out.push(b); out.push(p) }
        ZeroLe(a) | Refine(a) | Witness(a) | Proof(a) | Buffer(a) => out.push(a)
        Alloc(a, b) | Free(a, b) | Drop(_, a, b) => { out.push(a); out.push(b) }
        Ref(a) | Borrow(a) => out.push(a)
        Lend(a, b, c) => { out.push(a); out.push(b); out.push(c) }
        View(_, _, t, cases, x) => {
            out.push(t)
            for c in cases { out.push(c) }
            out.push(x)
        }
        Load(a, b, c, d) | Store(a, b, c, d) => { out.push(a); out.push(b); out.push(c); out.push(d) }
        Pack(p, a, q) => { out.push(p); out.push(a); out.push(q) }
        Index(a, i, p) | Transport(a, i, p) | Fold(a, i, p) => { out.push(a); out.push(i); out.push(
            p
        ) }
        Ind(_, xs) | Con(_, _, xs) | Elements(xs) => for x in xs { out.push(x) }
        Elim(_, p, cases, x) | Case(_, p, cases, x) => {
            out.push(p)
            for c in cases { out.push(c) }
            out.push(x)
        }
        IfLt(a, b, y, n) | IfEq(a, b, y, n) => { out.push(a); out.push(b); out.push(
            y
        ); out.push(n) }
        _ => {}
    }
    out
}

#[test]
fn rejects_graphs_without_trusting_the_parser() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    c.add(Term.Array(0), sp).unwrap()
    assert(c.check().is_err(), "self-referential term graph")
    var c = Core.new()
    let u = c.add(Term.U64, sp).unwrap()
    c.definitions.push(Definition { name: "bad".to_string(), ty: u,
        value: 999, exported: false, span: sp })
    assert(c.check().is_err(), "out-of-range definition body")
}

#[test]
fn rejects_false_proofs_without_trusting_the_parser() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let ty = c.add(Term.Lt(one, zero), sp).unwrap()
    let value = c.add(Term.Decide(one, zero), sp).unwrap()
    c.definitions.push(Definition { name: "false".to_string(), ty,
        value, exported: false, span: sp })
    assert(c.check().is_err(), "a false closed proposition has no evidence")
}

#[test]
fn rejects_type_in_type_without_trusting_the_parser() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let universe = c.add(Term.Universe(0), sp).unwrap()
    c.definitions.push(Definition { name: "bad".to_string(), ty: universe,
        value: universe, exported: false, span: sp })
    assert(c.check().is_err(), "Type 0 has type Type 1")
}

#[test]
fn rejects_false_equality_without_trusting_the_parser() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let ty = c.add(Term.Eq(zero, one), sp).unwrap()
    let value = c.add(Term.Refl(zero), sp).unwrap()
    c.definitions.push(Definition { name: "false".to_string(), ty,
        value, exported: false, span: sp })
    assert(c.check().is_err(), "reflexivity cannot prove unequal U64 values")
}

#[test]
fn restricts_transport_to_propositions_without_trusting_the_parser() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let u = c.add(Term.U64, sp).unwrap()
    let var0 = c.add(Term.Var(0), sp).unwrap()
    let family = c.add(Term.Lam(false, u, var0), sp).unwrap()
    let equality = c.add(Term.Refl(zero), sp).unwrap()
    let value = c.add(Term.Transport(family, equality, zero), sp).unwrap()
    c.definitions.push(Definition { name: "bad".to_string(), ty: u,
        value, exported: false, span: sp })
    assert(c.check().is_err(), "transport cannot produce runtime data")
}

#[test]
fn transport_checks_and_computes_reflexivity() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let u = c.add(Term.U64, sp).unwrap()
    let var0 = c.add(Term.Var(0), sp).unwrap()
    let proposition = c.add(Term.Lt(var0, one), sp).unwrap()
    let family = c.add(Term.Lam(false, u, proposition), sp).unwrap()
    let equality = c.add(Term.Refl(zero), sp).unwrap()
    let proof = c.add(Term.Decide(zero, one), sp).unwrap()
    let value = c.add(Term.Transport(family, equality, proof), sp).unwrap()
    let ty = c.add(Term.Lt(zero, one), sp).unwrap()
    c.definitions.push(Definition { name: "valid".to_string(), ty,
        value, exported: false, span: sp })
    c.check().unwrap()
    assert(c.equal(value, proof, DEPTH).unwrap(), "transport over refl reduces to its proof")
}

#[test]
fn rejects_cycles_in_equality_graphs() {
    let sp = diag.Span.nowhere()
    for term in [Term.Eq(0, 0), Term.Refl(0), Term.Transport(0, 0, 0), Term.IfEq(0, 0, 0, 0)] {
        var c = Core.new()
        c.add(term.clone(), sp).unwrap()
        assert(c.check().is_err(), "new equality nodes must obey term graph integrity")
    }
}

fn ids(xs: [u32]) -> Vec(u32) {
    var out = Vec(u32).new()
    for x in xs { out.push(x) }
    out
}

// EqChain(a, b), declared through the raw kernel interface:
// refl(a) : EqChain(a, a) and
// step(a, b, c, erased Eq(a, b), erased EqChain(b, c)) : EqChain(a, c).
fn chain_family(inout c: Core) {
    let sp = diag.Span.nowhere()
    let u = c.add(Term.U64, sp).unwrap()
    let x0 = c.add(Term.Var(0), sp).unwrap()
    let x1 = c.add(Term.Var(1), sp).unwrap()
    let x2 = c.add(Term.Var(2), sp).unwrap()
    let x4 = c.add(Term.Var(4), sp).unwrap()
    let refl = c.add(Term.Ind(0, ids([x0, x0])), sp).unwrap()
    let refl = c.add(Term.Pi(false, u, refl), sp).unwrap()
    var step = c.add(Term.Ind(0, ids([x4, x2])), sp).unwrap()
    let tail = c.add(Term.Ind(0, ids([x2, x1])), sp).unwrap()
    let edge = c.add(Term.Eq(x2, x1), sp).unwrap()
    step = c.add(Term.Pi(true, tail, step), sp).unwrap()
    step = c.add(Term.Pi(true, edge, step), sp).unwrap()
    for _ in 0..3 { step = c.add(Term.Pi(false, u, step), sp).unwrap() }
    var constructors = Vec(Constructor).new()
    constructors.push(Constructor { name: "refl".to_string(), ty: refl })
    constructors.push(Constructor { name: "step".to_string(), ty: step })
    c.families.push(Family {
        name: "EqChain".to_string(),
        data: false,
        params: 0,
        arity: 2,
        constructors,
        globals: c.definitions.len() as u32,
        span: sp
    })
}

#[test]
fn rejects_false_chain_constructors_without_frontends() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    chain_family(&c)
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let edge = c.add(Term.Refl(zero), sp).unwrap()
    let tail = c.add(Term.Con(0, 0, ids([one])), sp).unwrap()
    let value = c.add(Term.Con(0, 1, ids([zero, one, one, edge, tail])), sp).unwrap()
    let ty = c.add(Term.Ind(0, ids([zero, one])), sp).unwrap()
    c.definitions.push(Definition { name: "bad".to_string(), ty, value, exported: false, span: sp })
    assert(c.check().is_err(), "chain edges must prove their exact endpoints")
}

// A raw, independently constructed case signature for the constant
// proposition Eq 0 0. This bypasses parser/elaboration and case generation.
fn induction_fixture(inout c: Core, bad_step: bool) -> (u32, u32, u32) {
    let sp = diag.Span.nowhere()
    chain_family(&c)
    let u = c.add(Term.U64, sp).unwrap()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let ty = c.add(Term.Eq(zero, zero), sp).unwrap()
    let proof = c.add(Term.Refl(zero), sp).unwrap()
    let wrong = c.add(Term.Refl(one), sp).unwrap()
    let p = c.add(Term.Lam(false, u, ty), sp).unwrap()
    let p = c.add(Term.Lam(false, u, p), sp).unwrap()
    let base = c.add(Term.Lam(false, u, proof), sp).unwrap()
    let x1 = c.add(Term.Var(1), sp).unwrap()
    let x0 = c.add(Term.Var(0), sp).unwrap()
    let x2 = c.add(Term.Var(2), sp).unwrap()
    let edge_ty = c.add(Term.Eq(x2, x1), sp).unwrap()
    let tail_ty = c.add(Term.Ind(0, ids([x2, x1])), sp).unwrap()
    let step = c.add(Term.Lam(true, ty, if bad_step { wrong } else { x0 }), sp).unwrap()
    let step = c.add(Term.Lam(true, tail_ty, step), sp).unwrap()
    let step = c.add(Term.Lam(true, edge_ty, step), sp).unwrap()
    let step = c.add(Term.Lam(false, u, step), sp).unwrap()
    let step = c.add(Term.Lam(false, u, step), sp).unwrap()
    let step = c.add(Term.Lam(false, u, step), sp).unwrap()
    var chain = c.add(Term.Con(0, 0, ids([zero])), sp).unwrap()
    if !bad_step {
        for _ in 0..2 {
            chain = c.add(Term.Con(0, 1, ids([zero, zero, zero, proof, chain])), sp).unwrap()
        }
    }
    let value = c.add(Term.Elim(0, p, ids([base, step]), chain), sp).unwrap()
    (ty, value, proof)
}

#[test]
fn structural_induction_computes_on_the_tail() {
    var c = Core.new()
    let (ty, value, expected) = induction_fixture(&c, false)
    c.definitions.push(Definition { name: "valid".to_string(), ty, value,
        exported: false, span: diag.Span.nowhere() })
    c.check().unwrap()
    let normal = c.normal(value, DEPTH).unwrap()
    c.require(normal, ty, [], true, DEPTH).unwrap()
    assert(
        c.equal(normal, expected, DEPTH).unwrap(),
        "two induction steps compute the recursive hypothesis"
    )
}

#[test]
fn induction_checks_unused_step_without_frontends() {
    var c = Core.new()
    let (ty, value, _) = induction_fixture(&c, true)
    c.definitions.push(Definition { name: "bad".to_string(), ty, value,
        exported: false, span: diag.Span.nowhere() })
    assert(c.check().is_err(), "a reflexive chain cannot hide an invalid step")
}

#[test]
fn induction_requires_every_case_without_frontends() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let (ty, value, _) = induction_fixture(&c, false)
    let Elim(f, p, cases, x) = c.term(value) else { panic("fixture") }
    let value = c.add(Term.Elim(f, p, ids([cases[0]]), x), sp).unwrap()
    c.definitions.push(Definition { name: "bad".to_string(), ty, value, exported: false, span: sp })
    assert(c.check().is_err(), "a missing step case is rejected")
}

#[test]
fn rejects_cycles_in_inductive_graphs() {
    let sp = diag.Span.nowhere()
    for term in [
        Term.Ind(0, ids([1])),
        Term.Con(0, 0, ids([0, 1])),
        Term.Elim(0, 1, Vec(u32).new(), 0),
        Term.Elim(0, 0, ids([1]), 0),
        Term.Elim(0, 0, Vec(u32).new(), 1)
    ] {
        var c = Core.new()
        c.add(Term.U64, sp).unwrap()
        c.add(term.clone(), sp).unwrap()
        assert(c.check().is_err(), "inductive terms obey the same graph integrity checks")
    }
}

// One family F(i) with a single constructor of the given type.
fn single(inout c: Core, ty: u32) {
    var constructors = Vec(Constructor).new()
    constructors.push(Constructor { name: "make".to_string(), ty })
    c.families.push(Family { name: "F".to_string(), data: false, params: 0, arity: 1, constructors,
        globals: c.definitions.len() as u32, span: diag.Span.nowhere() })
}

#[test]
fn rejects_non_positive_and_relevant_fields() {
    let sp = diag.Span.nowhere()
    // make(erased h : F(0) -> Lt(0, 1)) : F(0) is not strictly positive.
    var c = Core.new()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let f0 = c.add(Term.Ind(0, ids([zero])), sp).unwrap()
    let lt = c.add(Term.Lt(zero, one), sp).unwrap()
    let negative = c.add(Term.Pi(true, f0, lt), sp).unwrap()
    let ty = c.add(Term.Pi(true, negative, f0), sp).unwrap()
    single(&c, ty)
    assert(c.check().is_err(), "a family under an arrow is rejected")
    // make(x : I64) : F(0) has runtime data other than indices.
    var c = Core.new()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let i = c.add(Term.I64, sp).unwrap()
    let f0 = c.add(Term.Ind(0, ids([zero])), sp).unwrap()
    let ty = c.add(Term.Pi(false, i, f0), sp).unwrap()
    single(&c, ty)
    assert(c.check().is_err(), "constructor data fields are U64")
    // make(h : F(0)) : F(0), recursive but not erased.
    var c = Core.new()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let f0 = c.add(Term.Ind(0, ids([zero])), sp).unwrap()
    let ty = c.add(Term.Pi(false, f0, f0), sp).unwrap()
    single(&c, ty)
    assert(c.check().is_err(), "recursive fields are erased")
    // make : Lt(0, 1) produces another proposition.
    var c = Core.new()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let lt = c.add(Term.Lt(zero, one), sp).unwrap()
    single(&c, lt)
    assert(c.check().is_err(), "a constructor produces its own family")
    // make : F(0, 0) has the wrong number of indices.
    var c = Core.new()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let f00 = c.add(Term.Ind(0, ids([zero, zero])), sp).unwrap()
    single(&c, f00)
    assert(c.check().is_err(), "family arity is checked")
}

#[test]
fn families_are_ordered_with_definitions() {
    let sp = diag.Span.nowhere()
    // A definition before the family's declaration cannot use it.
    var c = Core.new()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let f0 = c.add(Term.Ind(0, ids([zero])), sp).unwrap()
    let value = c.add(Term.Con(0, 0, Vec(u32).new()), sp).unwrap()
    c.definitions.push(Definition { name: "early".to_string(), ty: f0, value,
        exported: false, span: sp })
    var constructors = Vec(Constructor).new()
    constructors.push(Constructor { name: "make".to_string(), ty: f0 })
    c.families.push(Family {
        name: "F".to_string(),
        data: false,
        params: 0,
        arity: 1,
        constructors,
        globals: 1,
        span: sp
    })
    assert(c.check().is_err(), "families are not visible to earlier definitions")
    c.families[0].globals = 0
    c.check().unwrap()
    c.families[0].globals = 2
    assert(c.check().is_err(), "a family after every definition is still in range")
}

#[test]
fn induction_eliminates_only_into_propositions() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let u = c.add(Term.U64, sp).unwrap()
    let f0 = c.add(Term.Ind(0, ids([zero])), sp).unwrap()
    single(&c, f0)
    let motive = c.add(Term.Lam(false, u, u), sp).unwrap()
    let evidence = c.add(Term.Con(0, 0, Vec(u32).new()), sp).unwrap()
    let value = c.add(Term.Elim(0, motive, ids([zero]), evidence), sp).unwrap()
    c.definitions.push(Definition {
        name: "bad".to_string(),
        ty: u,
        value,
        exported: false,
        span: sp
    })
    assert(c.check().is_err(), "a data motive is rejected")
}

#[test]
fn overflowing_arithmetic_is_not_folded() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let max = c.add(Term.Integer(9223372036854775807), sp).unwrap()
    let one = c.add(Term.Integer(1), sp).unwrap()
    let two = c.add(Term.Integer(2), sp).unwrap()
    let over = c.add(Term.Arith(Arith.Add, max, one), sp).unwrap()
    let normal = c.normal(over, DEPTH).unwrap()
    assert(c.term(normal) != Term.Integer(-9223372036854775807 - 1), "no wrapping")
    let sum = c.add(Term.Arith(Arith.Mul, two, two), sp).unwrap()
    let normal = c.normal(sum, DEPTH).unwrap()
    assert(c.term(normal) == Term.Integer(4), "closed arithmetic computes")
}

// fold(3, 0, fn(i, erased p : Lt(i, bound), acc) { load [1, 2, 3] at i }).
fn loop_fixture(inout c: Core, bound: u64, erased: bool) -> u32 {
    let sp = diag.Span.nowhere()
    let u = c.add(Term.U64, sp).unwrap()
    let i = c.add(Term.I64, sp).unwrap()
    let three = c.add(Term.Natural(3), sp).unwrap()
    let b = c.add(Term.Natural(bound), sp).unwrap()
    let zero = c.add(Term.Integer(0), sp).unwrap()
    var xs = Vec(u32).new()
    for v in [1, 2, 3] { xs.push(c.add(Term.Integer(v), sp).unwrap()) }
    let array = c.add(Term.Elements(xs), sp).unwrap()
    let x0 = c.add(Term.Var(0), sp).unwrap()
    let x1 = c.add(Term.Var(1), sp).unwrap()
    let x2 = c.add(Term.Var(2), sp).unwrap()
    let load = c.add(Term.Index(array, x2, x1), sp).unwrap()
    let body = c.add(Term.Arith(Arith.Add, x0, load), sp).unwrap()
    let lt = c.add(Term.Lt(x0, b), sp).unwrap()
    let body = c.add(Term.Lam(false, i, body), sp).unwrap()
    let body = c.add(Term.Lam(erased, lt, body), sp).unwrap()
    let body = c.add(Term.Lam(false, u, body), sp).unwrap()
    let value = c.add(Term.Fold(three, zero, body), sp).unwrap()
    c.definitions.push(Definition {
        name: "loop".to_string(),
        ty: i,
        value,
        exported: false,
        span: sp
    })
    value
}

#[test]
fn loop_bodies_have_exactly_their_bound() {
    var c = Core.new()
    loop_fixture(&c, 3, true)
    c.check().unwrap()
    var c = Core.new()
    loop_fixture(&c, 4, true)
    assert(c.check().is_err(), "a bound above the array length is rejected")
    var c = Core.new()
    loop_fixture(&c, 3, false)
    assert(c.check().is_err(), "the bound is erased evidence")
}

#[test]
fn loops_are_not_unrolled() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let value = loop_fixture(&c, 3, true)
    c.check().unwrap()
    let normal = c.normal(value, DEPTH).unwrap()
    let Fold(_, _, _) = c.term(normal) else { panic("a loop stays a loop") }
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let init = c.add(Term.Integer(5), sp).unwrap()
    let Fold(_, _, body) = c.term(value) else { panic("fixture") }
    let empty = c.add(Term.Fold(zero, init, body), sp).unwrap()
    let normal = c.normal(empty, DEPTH).unwrap()
    assert(c.term(normal) == Term.Integer(5), "an empty loop is its initial value")
}

#[test]
fn rejects_cycles_in_loop_graphs() {
    let sp = diag.Span.nowhere()
    for term in [Term.Arith(Arith.Add, 0, 1), Term.Fold(0, 0, 1)] {
        var c = Core.new()
        c.add(Term.I64, sp).unwrap()
        c.add(term.clone(), sp).unwrap()
        assert(c.check().is_err(), "loop terms obey graph integrity")
    }
}

#[test]
fn substitution_keeps_overflow_traps() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    c.runtime = true
    let i = c.add(Term.I64, sp).unwrap()
    let max = c.add(Term.Integer(9223372036854775807), sp).unwrap()
    let one = c.add(Term.Integer(1), sp).unwrap()
    let seven = c.add(Term.Integer(7), sp).unwrap()
    let over = c.add(Term.Arith(Arith.Add, max, one), sp).unwrap()
    let ignore = c.add(Term.Lam(false, i, seven), sp).unwrap()
    let dropped = c.add(Term.App(ignore, over), sp).unwrap()
    let normal = c.normal(dropped, DEPTH).unwrap()
    let Strict(_, rest) = c.term(normal) else { panic("an unused trapping argument is kept") }
    assert(c.term(rest) == Term.Integer(7), "after it, the body")
    let safe = c.add(Term.App(ignore, one), sp).unwrap()
    let normal = c.normal(safe, DEPTH).unwrap()
    assert(c.term(normal) == Term.Integer(7), "an argument that cannot trap is dropped")
}

#[test]
fn sums_are_compared_in_the_naturals() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let x = c.add(Term.Var(0), sp).unwrap()
    let y = c.add(Term.Var(1), sp).unwrap()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let two = c.add(Term.Natural(2), sp).unwrap()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let max = c.add(Term.Natural(0xffffffffffffffff), sp).unwrap()
    // ((x + 1) + y) + 1 and (2 + y) + x
    let a = c.add(Term.UAdd(x, one), sp).unwrap()
    let a = c.add(Term.UAdd(a, y), sp).unwrap()
    let a = c.add(Term.UAdd(a, one), sp).unwrap()
    let b = c.add(Term.UAdd(two, y), sp).unwrap()
    let b = c.add(Term.UAdd(b, x), sp).unwrap()
    assert(c.equal(a, b, DEPTH).unwrap(), "associativity, commutativity and constants")
    let x0 = c.add(Term.UAdd(x, zero), sp).unwrap()
    assert(c.equal(x0, x, DEPTH).unwrap(), "adding zero")
    let three = c.add(Term.Natural(3), sp).unwrap()
    let closed = c.add(Term.UAdd(one, two), sp).unwrap()
    assert(c.equal(closed, three, DEPTH).unwrap(), "closed sums compute")
    let over = c.add(Term.UAdd(max, one), sp).unwrap()
    assert(!c.equal(over, zero, DEPTH).unwrap(), "no wrapping")
    let ty = c.add(Term.Eq(over, zero), sp).unwrap()
    let value = c.add(Term.Refl(zero), sp).unwrap()
    c.definitions.push(Definition {
        name: "wrap".to_string(),
        ty,
        value,
        exported: false,
        span: sp
    })
    assert(c.check().is_err(), "2^64 is not 0 in the naturals")
}

#[test]
fn order_rules_need_their_exact_premises() {
    let sp = diag.Span.nowhere()
    let rules = [0, 1, 2, 3]
    for rule in rules {
        var c = Core.new()
        let zero = c.add(Term.Natural(0), sp).unwrap()
        let one = c.add(Term.Natural(1), sp).unwrap()
        let lt01 = c.add(Term.Decide(zero, one), sp).unwrap()
        let lt11 = c.add(Term.Decide(one, one), sp).unwrap()
        // Each claims Lt(1, 0) or another false inequality.
        let (ty, value) = match rule {
            0 => (Term.Lt(one, zero), Term.LtLe(zero, one, zero, lt01, lt11))
            1 => (Term.Lt(one, one), Term.LtAdd(one, zero, one, lt01))
            2 => (Term.Lt(one, zero), Term.LtCancel(one, zero, one, lt01))
            _ => (Term.Lt(one, zero), Term.LtLe(one, zero, zero, lt01, lt01))
        }
        let ty = c.add(ty, sp).unwrap()
        let value = c.add(value, sp).unwrap()
        c.definitions.push(Definition {
            name: "bad".to_string(),
            ty,
            value,
            exported: false,
            span: sp
        })
        assert(c.check().is_err(), "an order rule with wrong premises is rejected")
    }
    // x < y <= z gives x < z: 0 < 1 <= 1.
    var c = Core.new()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let two = c.add(Term.Natural(2), sp).unwrap()
    let lt01 = c.add(Term.Decide(zero, one), sp).unwrap()
    let lt12 = c.add(Term.Decide(one, two), sp).unwrap()
    let value = c.add(Term.LtLe(zero, one, one, lt01, lt12), sp).unwrap()
    let ty = c.add(Term.Lt(zero, one), sp).unwrap()
    c.definitions.push(Definition {
        name: "good".to_string(),
        ty,
        value,
        exported: false,
        span: sp
    })
    c.check().unwrap()
}

#[test]
fn rejects_cycles_in_order_graphs() {
    let sp = diag.Span.nowhere()
    for term in [
        Term.UAdd(0, 1),
        Term.LtAdd(0, 0, 0, 1),
        Term.LtCancel(1, 0, 0, 0),
        Term.LtLe(0, 0, 0, 0, 1)
    ] {
        var c = Core.new()
        c.add(Term.U64, sp).unwrap()
        c.add(term.clone(), sp).unwrap()
        assert(c.check().is_err(), "order terms obey graph integrity")
    }
}

#[test]
fn subtraction_cancels_in_the_naturals() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let k = c.add(Term.Var(0), sp).unwrap()
    let m = c.add(Term.Var(1), sp).unwrap()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let two = c.add(Term.Natural(2), sp).unwrap()
    let p = c.add(Term.Var(2), sp).unwrap()
    let q = c.add(Term.Var(3), sp).unwrap()
    // (k - 1) + 1 is k; (k + 2) - 1 is k + 1; (k - 1) + m is not k + m - 1.
    let pred = c.add(Term.USub(k, one, p), sp).unwrap()
    let back = c.add(Term.UAdd(pred, one), sp).unwrap()
    assert(c.equal(back, k, DEPTH).unwrap(), "(k - 1) + 1 is k")
    let k2 = c.add(Term.UAdd(k, two), sp).unwrap()
    let k1 = c.add(Term.UAdd(k, one), sp).unwrap()
    let less = c.add(Term.USub(k2, one, p), sp).unwrap()
    assert(c.equal(less, k1, DEPTH).unwrap(), "(k + 2) - 1 is k + 1")
    let other = c.add(Term.UAdd(pred, m), sp).unwrap()
    assert(!c.equal(other, k, DEPTH).unwrap(), "no cancellation without the subtrahend")
    let again = c.add(Term.USub(k, one, q), sp).unwrap()
    assert(c.equal(pred, again, DEPTH).unwrap(), "evidence is irrelevant")
    let three = c.add(Term.Natural(3), sp).unwrap()
    let closed = c.add(Term.USub(three, two, p), sp).unwrap()
    assert(c.equal(closed, one, DEPTH).unwrap(), "closed subtraction computes")
}

#[test]
fn subtraction_needs_evidence_of_its_bound() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let two = c.add(Term.Natural(2), sp).unwrap()
    let u = c.add(Term.U64, sp).unwrap()
    // 0 - 1 with evidence of Lt(0, 1) instead of Lt(1, 0 + 1).
    let wrong = c.add(Term.Decide(zero, one), sp).unwrap()
    let value = c.add(Term.USub(zero, one, wrong), sp).unwrap()
    c.definitions.push(Definition {
        name: "bad".to_string(),
        ty: u,
        value,
        exported: false,
        span: sp
    })
    assert(c.check().is_err(), "0 - 1 has no evidence")
    var c = Core.new()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let two = c.add(Term.Natural(2), sp).unwrap()
    let u = c.add(Term.U64, sp).unwrap()
    let ok = c.add(Term.Decide(one, two), sp).unwrap()
    let value = c.add(Term.USub(one, one, ok), sp).unwrap()
    c.definitions.push(Definition {
        name: "good".to_string(),
        ty: u,
        value,
        exported: false,
        span: sp
    })
    c.check().unwrap()
    assert(c.equal(value, zero, DEPTH).unwrap(), "1 - 1 is 0")
}

#[test]
fn zero_is_least() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let value = c.add(Term.ZeroLe(zero), sp).unwrap()
    let ty = c.add(Term.Lt(zero, one), sp).unwrap()
    c.definitions.push(Definition { name: "z".to_string(), ty, value, exported: false, span: sp })
    c.check().unwrap()
    for term in [Term.USub(0, 0, 1), Term.ZeroLe(0)] {
        var c = Core.new()
        c.add(term.clone(), sp).unwrap()
        assert(c.check().is_err(), "subtraction terms obey graph integrity")
    }
}

#[test]
fn cancellation_keeps_the_evaluation_it_removes() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let k = c.add(Term.Var(0), sp).unwrap()
    let p = c.add(Term.Var(1), sp).unwrap()
    let one = c.add(Term.Natural(1), sp).unwrap()
    // (k + 1) - 1 is k, but k + 1 can overflow: it is still evaluated.
    let k1 = c.add(Term.UAdd(k, one), sp).unwrap()
    let value = c.add(Term.USub(k1, one, p), sp).unwrap()
    let normal = c.normal(value, DEPTH).unwrap()
    let Strict(first, rest) = c.term(normal) else { panic("the cancelled sum is kept") }
    assert(c.equal(first, k1, DEPTH).unwrap() && c.term(rest) == Term.Var(0), "then k")
    assert(c.equal(normal, k, DEPTH).unwrap(), "and it is k")
    // (k - 1) + 1 removes only the literal 1, which cannot trap.
    let pred = c.add(Term.USub(k, one, p), sp).unwrap()
    let back = c.add(Term.UAdd(pred, one), sp).unwrap()
    let normal = c.normal(back, DEPTH).unwrap()
    assert(c.term(normal) == Term.Var(0), "nothing to keep")
}

// Refine(fn(j) { Lt(j, 3) }), a closed predicate.
fn below_three(inout c: Core) -> (u32, u32) {
    let sp = diag.Span.nowhere()
    let u = c.add(Term.U64, sp).unwrap()
    let j = c.add(Term.Var(0), sp).unwrap()
    let three = c.add(Term.Natural(3), sp).unwrap()
    let lt = c.add(Term.Lt(j, three), sp).unwrap()
    let p = c.add(Term.Lam(false, u, lt), sp).unwrap()
    (p, c.add(Term.Refine(p), sp).unwrap())
}

#[test]
fn refinements_need_evidence_at_their_witness() {
    let sp = diag.Span.nowhere()
    for witness in [0 as u64, 2, 3, 5] {
        var c = Core.new()
        let (p, ty) = below_three(&c)
        let a = c.add(Term.Natural(witness), sp).unwrap()
        let three = c.add(Term.Natural(3), sp).unwrap()
        let evidence = c.add(Term.Decide(a, three), sp).unwrap()
        let value = c.add(Term.Pack(p, a, evidence), sp).unwrap()
        c.definitions.push(Definition { name: "r".to_string(), ty, value, exported: false,
            span: sp })
        assert(c.check().is_ok() == (witness < 3), "evidence is of P at the witness")
    }
    // Evidence of P at another value does not make a refinement.
    var c = Core.new()
    let (p, ty) = below_three(&c)
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let five = c.add(Term.Natural(5), sp).unwrap()
    let three = c.add(Term.Natural(3), sp).unwrap()
    let evidence = c.add(Term.Decide(zero, three), sp).unwrap()
    let value = c.add(Term.Pack(p, five, evidence), sp).unwrap()
    c.definitions.push(Definition { name: "r".to_string(), ty, value, exported: false, span: sp })
    assert(c.check().is_err(), "evidence at 0 is not evidence at 5")
}

#[test]
fn refinements_project_and_erase() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let (p, ty) = below_three(&c)
    let two = c.add(Term.Natural(2), sp).unwrap()
    let three = c.add(Term.Natural(3), sp).unwrap()
    let evidence = c.add(Term.Decide(two, three), sp).unwrap()
    let packed = c.add(Term.Pack(p, two, evidence), sp).unwrap()
    let witness = c.add(Term.Witness(packed), sp).unwrap()
    let proof = c.add(Term.Proof(packed), sp).unwrap()
    assert(c.term(c.normal(witness, DEPTH).unwrap()) == Term.Natural(2), "the witness computes")
    assert(c.equal(proof, evidence, DEPTH).unwrap(), "and so does the proof")
    // An erased refinement is not a proposition; a proof binder of one is
    // rejected, as is the proof of a refinement used as runtime data.
    let erased = c.add(Term.Lam(true, ty, two), sp).unwrap()
    let erased_ty = c.add(Term.Pi(true, ty, ty), sp).unwrap()
    c.definitions.push(Definition { name: "e".to_string(), ty: erased_ty, value: erased,
        exported: false, span: sp })
    assert(c.check().is_err(), "refinements are data")
    var c = Core.new()
    let (_, ty) = below_three(&c)
    let s = c.add(Term.Var(0), sp).unwrap()
    let proof = c.add(Term.Proof(s), sp).unwrap()
    let u = c.add(Term.U64, sp).unwrap()
    let value = c.add(Term.Lam(false, ty, proof), sp).unwrap()
    let fty = c.add(Term.Pi(false, ty, u), sp).unwrap()
    c.definitions.push(Definition { name: "f".to_string(), ty: fty, value, exported: false,
        span: sp })
    assert(c.check().is_err(), "the proof is not the witness")
    for term in [Term.Refine(0), Term.Pack(0, 0, 0), Term.Witness(0), Term.Proof(0)] {
        var c = Core.new()
        c.add(term.clone(), sp).unwrap()
        assert(c.check().is_err(), "refinement terms obey graph integrity")
    }
}

#[test]
fn the_witness_of_a_branch_is_a_branch() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let (p, _) = below_three(&c)
    let i = c.add(Term.Var(0), sp).unwrap()
    let three = c.add(Term.Natural(3), sp).unwrap()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let evidence = c.add(Term.Var(0), sp).unwrap()
    let inner = c.add(Term.Var(1), sp).unwrap()
    let yes = c.add(Term.Pack(p, inner, evidence), sp).unwrap()
    let none = c.add(Term.Decide(zero, three), sp).unwrap()
    let no = c.add(Term.Pack(p, zero, none), sp).unwrap()
    let branch = c.add(Term.IfLt(i, three, yes, no), sp).unwrap()
    let witness = c.add(Term.Witness(branch), sp).unwrap()
    let normal = c.normal(witness, DEPTH).unwrap()
    let IfLt(_, _, y, n) = c.term(normal) else { panic("a branch of witnesses") }
    assert(c.term(y) == Term.Var(1) && c.term(n) == Term.Natural(0), "each alternative's witness")
}

// data B { No, Yes(U64) }, declared without either frontend.
fn bit_family(inout c: Core, arity: u32, recursive: bool) {
    let sp = diag.Span.nowhere()
    let none = Vec(u32).new()
    let b = c.add(Term.Ind(0, none.clone()), sp).unwrap()
    let u = c.add(Term.U64, sp).unwrap()
    let field = if recursive { b } else { u }
    let shifted = c.add(Term.Ind(0, none), sp).unwrap()
    let yes = c.add(Term.Pi(false, field, shifted), sp).unwrap()
    var constructors = Vec(Constructor).new()
    constructors.push(Constructor { name: "No".to_string(), ty: b })
    constructors.push(Constructor { name: "Yes".to_string(), ty: yes })
    c.families.push(Family { name: "B".to_string(), data: true, params: 0, arity, constructors,
        globals: 0, span: sp })
}

#[test]
fn recursive_data_types_live_on_the_heap() {
    var c = Core.new()
    bit_family(&c, 0, false)
    c.check().unwrap()
    assert(!c.is_boxed(0), "a flat data type has no representation")
    var c = Core.new()
    bit_family(&c, 0, true)
    c.check().unwrap()
    assert(c.is_boxed(0), "a recursive data type is on the heap")
    var c = Core.new()
    bit_family(&c, 1, false)
    assert(c.check().is_err(), "no indexed data yet")
}

#[test]
fn case_analysis_of_a_branch_is_a_branch() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    bit_family(&c, 0, false)
    c.check().unwrap()
    let none = Vec(u32).new()
    let b = c.add(Term.Ind(0, none.clone()), sp).unwrap()
    let u = c.add(Term.U64, sp).unwrap()
    let p = c.add(Term.Lam(false, b, u), sp).unwrap()
    let seven = c.add(Term.Natural(7), sp).unwrap()
    let x = c.add(Term.Var(0), sp).unwrap()
    let yes_case = c.add(Term.Lam(false, u, x), sp).unwrap()
    let i = c.add(Term.Var(0), sp).unwrap()
    let three = c.add(Term.Natural(3), sp).unwrap()
    let inner = c.add(Term.Var(1), sp).unwrap()
    var fields = Vec(u32).new()
    fields.push(inner)
    let yes = c.add(Term.Con(0, 1, fields), sp).unwrap()
    let no = c.add(Term.Con(0, 0, none), sp).unwrap()
    let branch = c.add(Term.IfLt(i, three, yes, no), sp).unwrap()
    var cases = Vec(u32).new()
    cases.push(seven)
    cases.push(yes_case)
    let elim = c.add(Term.Elim(0, p, cases, branch), sp).unwrap()
    let normal = c.normal(elim, DEPTH).unwrap()
    let IfLt(_, _, y, n) = c.term(normal) else { panic("a branch of cases") }
    assert(c.term(y) == Term.Var(1) && c.term(n) == Term.Natural(7), "each case on its value")
}

#[test]
fn data_motives_are_small_and_depend_on_the_value() {
    let sp = diag.Span.nowhere()
    // P : U64 -> Type 0 is not a motive of B, and P : B -> Type 1 is large.
    for wrong_domain in [true, false] {
        var c = Core.new()
        bit_family(&c, 0, false)
        let none = Vec(u32).new()
        let b = c.add(Term.Ind(0, none.clone()), sp).unwrap()
        let u = c.add(Term.U64, sp).unwrap()
        let ty0 = c.add(Term.Universe(0), sp).unwrap()
        let motive = if wrong_domain { c.add(Term.Lam(false, u, u), sp).unwrap() }
        else { c.add(Term.Lam(false, b, ty0), sp).unwrap() }
        let zero = c.add(Term.Natural(0), sp).unwrap()
        let x = c.add(Term.Var(0), sp).unwrap()
        let case = c.add(Term.Lam(false, u, if wrong_domain { x } else { u }), sp).unwrap()
        let first = if wrong_domain { zero } else { u }
        let value = c.add(Term.Con(0, 0, none), sp).unwrap()
        var cases = Vec(u32).new()
        cases.push(first)
        cases.push(case)
        let elim = c.add(Term.Elim(0, motive, cases, value), sp).unwrap()
        let ty = if wrong_domain { u } else { ty0 }
        c.definitions.push(Definition { name: "m".to_string(), ty, value: elim, exported: false,
            span: sp })
        assert(c.check().is_err(), "data motives are B -> Prop or B -> Type 0")
    }
}

// data P(n) { C } with one parameter: C binds n, erased, and returns P(n).
fn parameter_family(inout c: Core, erased: bool, sink result: Term) {
    let sp = diag.Span.nowhere()
    let u = c.add(Term.U64, sp).unwrap()
    let index = c.add(result, sp).unwrap()
    var xs = Vec(u32).new()
    xs.push(index)
    let back = c.add(Term.Ind(0, xs), sp).unwrap()
    let ty = c.add(Term.Pi(erased, u, back), sp).unwrap()
    var constructors = Vec(Constructor).new()
    constructors.push(Constructor { name: "C".to_string(), ty })
    c.families.push(Family { name: "P".to_string(), data: true, params: 1, arity: 1, constructors,
        globals: 0, span: sp })
}

#[test]
fn parameters_are_bound_first_and_returned() {
    var c = Core.new()
    parameter_family(&c, true, Term.Var(0))
    c.check().unwrap()
    var c = Core.new()
    parameter_family(&c, false, Term.Var(0))
    assert(c.check().is_err(), "a parameter is erased")
    var c = Core.new()
    parameter_family(&c, true, Term.Natural(3))
    assert(c.check().is_err(), "a parameter is returned unchanged")
}

#[test]
fn erased_indices_stay_out_of_runtime_terms() {
    let sp = diag.Span.nowhere()
    // fn(erased n: U64) -> U64 { n } is rejected; with Lt(0, n + 1) it is evidence.
    var c = Core.new()
    let u = c.add(Term.U64, sp).unwrap()
    let n = c.add(Term.Var(0), sp).unwrap()
    let value = c.add(Term.Lam(true, u, n), sp).unwrap()
    let ty = c.add(Term.Pi(true, u, u), sp).unwrap()
    c.definitions.push(Definition { name: "n".to_string(), ty, value, exported: false, span: sp })
    assert(c.check().is_err(), "an erased u64 is not runtime data")
    var c = Core.new()
    let u = c.add(Term.U64, sp).unwrap()
    let n = c.add(Term.Var(0), sp).unwrap()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let n1 = c.add(Term.UAdd(n, one), sp).unwrap()
    let lt = c.add(Term.Lt(zero, n1), sp).unwrap()
    let proof = c.add(Term.ZeroLe(n), sp).unwrap()
    let value = c.add(Term.Lam(true, u, proof), sp).unwrap()
    let ty = c.add(Term.Pi(true, u, lt), sp).unwrap()
    c.definitions.push(Definition { name: "z".to_string(), ty, value, exported: false, span: sp })
    c.check().unwrap()
    // An erased I64 is neither evidence nor an index.
    var c = Core.new()
    let i = c.add(Term.I64, sp).unwrap()
    let zero = c.add(Term.Integer(0), sp).unwrap()
    let value = c.add(Term.Lam(true, i, zero), sp).unwrap()
    let ty = c.add(Term.Pi(true, i, i), sp).unwrap()
    c.definitions.push(Definition { name: "i".to_string(), ty, value, exported: false, span: sp })
    assert(c.check().is_err(), "only u64 indices are erased data")
}

// fn(b: Buffer(1)) -> I64 { body }: body frees b `frees` times.
fn consumer(inout c: Core, frees: u32) {
    let sp = diag.Span.nowhere()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let buffer = c.add(Term.Buffer(one), sp).unwrap()
    let i = c.add(Term.I64, sp).unwrap()
    let b = c.add(Term.Var(0), sp).unwrap()
    var value = c.add(Term.Integer(0), sp).unwrap()
    for _ in 0..frees { value = c.add(Term.Free(b, value), sp).unwrap() }
    let value = c.add(Term.Lam(false, buffer, value), sp).unwrap()
    let ty = c.add(Term.Pi(false, buffer, i), sp).unwrap()
    c.definitions.push(Definition { name: "f".to_string(), ty, value, exported: false, span: sp })
}

#[test]
fn owned_values_are_used_exactly_once() {
    for frees in [0 as u32, 1, 2] {
        var c = Core.new()
        consumer(&c, frees)
        assert(c.check().is_ok() == (frees == 1), "a buffer is freed exactly once")
    }
    for term in [Term.Buffer(0), Term.Alloc(0, 0), Term.Load(0, 0, 0, 0), Term.Store(0, 0, 0, 0),
        Term.Free(0, 0)] {
            var c = Core.new()
            c.add(term.clone(), diag.Span.nowhere()).unwrap()
            assert(c.check().is_err(), "memory terms obey graph integrity")
        }
}

#[test]
fn effectful_arguments_are_bound_once() {
    // (fn(b) { free(b, 0) })(alloc(1, 0)) keeps the redex instead of
    // substituting the allocation, and memory terms are not computed.
    let sp = diag.Span.nowhere()
    var c = Core.new()
    c.runtime = true
    let one = c.add(Term.Natural(1), sp).unwrap()
    let buffer = c.add(Term.Buffer(one), sp).unwrap()
    let zero = c.add(Term.Integer(0), sp).unwrap()
    let b = c.add(Term.Var(0), sp).unwrap()
    let body = c.add(Term.Free(b, zero), sp).unwrap()
    let f = c.add(Term.Lam(false, buffer, body), sp).unwrap()
    let made = c.add(Term.Alloc(one, zero), sp).unwrap()
    let call = c.add(Term.App(f, made), sp).unwrap()
    let normal = c.normal(call, DEPTH).unwrap()
    let App(g, a) = c.term(normal) else { panic("the redex is kept") }
    let Lam(false, _, _) = c.term(g) else { panic("binding the allocation") }
    let Alloc(_, _) = c.term(a) else { panic("evaluated once") }
}

#[test]
fn sums_convert_in_any_order_but_run_in_theirs() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let x = c.add(Term.Var(0), sp).unwrap()
    let y = c.add(Term.Var(1), sp).unwrap()
    let a = c.add(Term.Witness(x), sp).unwrap()
    let b = c.add(Term.Witness(y), sp).unwrap()
    let ab = c.add(Term.UAdd(a, b), sp).unwrap()
    let ba = c.add(Term.UAdd(b, a), sp).unwrap()
    assert(c.equal(ab, ba, DEPTH).unwrap(), "addition commutes in the pure model")
    c.runtime = true
    let left = c.normal(ab, DEPTH).unwrap()
    let right = c.normal(ba, DEPTH).unwrap()
    assert(!c.identical(left, right, DEPTH), "code to run keeps its operands' order")
}

#[test]
fn one_level_case_analysis_is_for_heap_data() {
    let sp = diag.Span.nowhere()
    for recursive in [false, true] {
        var c = Core.new()
        bit_family(&c, 0, recursive)
        let none = Vec(u32).new()
        let b = c.add(Term.Ind(0, none.clone()), sp).unwrap()
        let u = c.add(Term.U64, sp).unwrap()
        let p = c.add(Term.Lam(false, b, u), sp).unwrap()
        let zero = c.add(Term.Natural(0), sp).unwrap()
        // Yes(x): x is a u64 or, when recursive, a B that must be used.
        let field = if recursive { b } else { u }
        let x = c.add(Term.Var(0), sp).unwrap()
        let body = if recursive {
            let q = c.add(Term.Lam(false, b, u), sp).unwrap()
            let one = c.add(Term.Natural(1), sp).unwrap()
            // (erased rest: B) -> (ih: U64) -> 1
            let ones = c.add(Term.Lam(false, u, one), sp).unwrap()
            let ones = c.add(Term.Lam(true, b, ones), sp).unwrap()
            var cases = Vec(u32).new()
            cases.push(zero)
            cases.push(ones)
            // The rest is consumed by a recursion that counts it.
            let counted = c.add(Term.Elim(0, q, cases, x), sp).unwrap()
            counted
        } else { x }
        let yes = c.add(Term.Lam(false, field, body), sp).unwrap()
        var cases = Vec(u32).new()
        cases.push(zero)
        cases.push(yes)
        let v = c.add(Term.Var(0), sp).unwrap()
        let analysis = c.add(Term.Case(0, p, cases, v), sp).unwrap()
        let value = c.add(Term.Lam(false, b, analysis), sp).unwrap()
        let ty = c.add(Term.Pi(false, b, u), sp).unwrap()
        c.definitions.push(Definition {
            name: "f".to_string(),
            ty,
            value,
            exported: false,
            span: sp
        })
        assert(c.check().is_ok() == recursive, "flat data is taken apart by Elim")
    }
}

// fn(x: B) -> U64 { body }: body drops x `drops` times, as family `of`.
fn dropper(recursive: bool, drops: u32, of: u32) -> Core {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    bit_family(&c, 0, recursive)
    let none = Vec(u32).new()
    let b = c.add(Term.Ind(0, none), sp).unwrap()
    let u = c.add(Term.U64, sp).unwrap()
    let x = c.add(Term.Var(0), sp).unwrap()
    var value = c.add(Term.Natural(0), sp).unwrap()
    for _ in 0..drops { value = c.add(Term.Drop(of, x, value), sp).unwrap() }
    let value = c.add(Term.Lam(false, b, value), sp).unwrap()
    let ty = c.add(Term.Pi(false, b, u), sp).unwrap()
    c.definitions.push(Definition { name: "f".to_string(), ty, value, exported: false, span: sp })
    c
}

#[test]
fn drops_free_heap_data_of_their_family_once() {
    for drops in [0 as u32, 1, 2] {
        var c = dropper(true, drops, 0)
        assert(c.check().is_ok() == (drops == 1), "heap data is dropped exactly once")
    }
    // Flat data has no node to free, and a drop names its value's family.
    var flat = dropper(false, 1, 0)
    assert(flat.check().is_err(), "flat data is not dropped")
    var other = dropper(true, 1, 1)
    assert(other.check().is_err(), "a drop names a declared family")
    var c = Core.new()
    c.add(Term.Drop(0, 0, 0), diag.Span.nowhere()).unwrap()
    assert(c.check().is_err(), "drops obey graph integrity")
}

#[test]
fn freeing_is_no_computation_in_the_pure_model() {
    // free(b, 1) converts with 1, but code to run keeps the free.
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let b = c.add(Term.Var(0), sp).unwrap()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let freed = c.add(Term.Free(b, one), sp).unwrap()
    let dropped = c.add(Term.Drop(0, b, one), sp).unwrap()
    assert(c.equal(freed, one, DEPTH).unwrap(), "free is its rest in conversion")
    assert(c.equal(dropped, one, DEPTH).unwrap(), "drop is its rest in conversion")
    c.runtime = true
    let kept = c.normal(freed, DEPTH).unwrap()
    let Free(_, _) = c.term(kept) else { panic("code to run keeps the free") }
    let kept = c.normal(dropped, DEPTH).unwrap()
    let Drop(_, _, _) = c.term(kept) else { panic("code to run keeps the drop") }
}

// fn(x: B) -> U64 { lend(x, fn(r) { f }, fn(a, y) { drop(y, a) }) }, B a
// heap type, f either 0 or the borrow itself.
fn lending(escape: bool) -> Core {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    bit_family(&c, 0, true)
    let none = Vec(u32).new()
    let b = c.add(Term.Ind(0, none), sp).unwrap()
    let u = c.add(Term.U64, sp).unwrap()
    let borrow = c.add(Term.Ref(b), sp).unwrap()
    let read = if escape { c.add(Term.Var(0), sp).unwrap() } else { c.add(
        Term.Natural(0),
        sp
    ).unwrap() }
    let f = c.add(Term.Lam(false, borrow, read), sp).unwrap()
    let a = if escape { borrow } else { u }
    let y = c.add(Term.Var(0), sp).unwrap()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let result = if escape { zero } else { c.add(Term.Var(1), sp).unwrap() }
    let dropped = c.add(Term.Drop(0, y, result), sp).unwrap()
    let inner = c.add(Term.Lam(false, b, dropped), sp).unwrap()
    let g = c.add(Term.Lam(false, a, inner), sp).unwrap()
    let x = c.add(Term.Var(0), sp).unwrap()
    let lend = c.add(Term.Lend(x, f, g), sp).unwrap()
    let value = c.add(Term.Lam(false, b, lend), sp).unwrap()
    let ty = c.add(Term.Pi(false, b, u), sp).unwrap()
    c.definitions.push(Definition { name: "f".to_string(), ty, value, exported: false, span: sp })
    c
}

#[test]
fn no_borrow_outlives_its_lend() {
    var c = lending(false)
    assert(c.check().is_ok(), "a lend reads, then gives the owner back")
    var c = lending(true)
    assert(c.check().is_err(), "a lend's result holds no borrow")
    for term in [Term.Ref(0), Term.Lend(0, 0, 0), Term.View(false, 0, 0, Vec(u32).new(), 0)] {
        var c = Core.new()
        c.add(term.clone(), diag.Span.nowhere()).unwrap()
        assert(c.check().is_err(), "borrow terms obey graph integrity")
    }
}

// fn(x: Ref(B) or B) -> U64 { view(B, U64, 0, fn(rest) { 1 }, x) }.
fn viewing(borrowed: bool, field: bool) -> Core {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    bit_family(&c, 0, true)
    let none = Vec(u32).new()
    let b = c.add(Term.Ind(0, none), sp).unwrap()
    let u = c.add(Term.U64, sp).unwrap()
    let borrow = c.add(Term.Ref(b), sp).unwrap()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let one = c.add(Term.Natural(1), sp).unwrap()
    // Yes's field arrives borrowed; an owned binder does not match.
    let yes = c.add(Term.Lam(false, if field { borrow } else { b }, one), sp).unwrap()
    var cases = Vec(u32).new()
    cases.push(zero)
    cases.push(yes)
    let x = c.add(Term.Var(0), sp).unwrap()
    let view = c.add(Term.View(false, 0, u, cases, x), sp).unwrap()
    let domain = if borrowed { borrow } else { b }
    let value = c.add(Term.Lam(false, domain, view), sp).unwrap()
    let ty = c.add(Term.Pi(false, domain, u), sp).unwrap()
    c.definitions.push(Definition { name: "f".to_string(), ty, value, exported: false, span: sp })
    c
}

#[test]
fn views_read_borrows_and_give_borrowed_fields() {
    var c = viewing(true, true)
    assert(c.check().is_ok(), "a view reads a borrow")
    var c = viewing(false, true)
    assert(c.check().is_err(), "a view does not take an owner")
    var c = viewing(true, false)
    assert(c.check().is_err(), "a view's heap fields are borrowed")
}

// B with count: Ref(B) -> U64, the number of Yes nodes, by a recursive
// view, and a definition of type ty with value value from the given terms.
fn counting(inout c: Core) -> u32 {
    let sp = diag.Span.nowhere()
    bit_family(&c, 0, true)
    let none = Vec(u32).new()
    let b = c.add(Term.Ind(0, none), sp).unwrap()
    let u = c.add(Term.U64, sp).unwrap()
    let borrow = c.add(Term.Ref(b), sp).unwrap()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let ih = c.add(Term.Var(0), sp).unwrap()
    let more = c.add(Term.UAdd(ih, one), sp).unwrap()
    let more = c.add(Term.Lam(false, u, more), sp).unwrap()
    let yes = c.add(Term.Lam(false, borrow, more), sp).unwrap()
    var cases = Vec(u32).new()
    cases.push(zero)
    cases.push(yes)
    let x = c.add(Term.Var(0), sp).unwrap()
    let view = c.add(Term.View(true, 0, u, cases, x), sp).unwrap()
    let value = c.add(Term.Lam(false, borrow, view), sp).unwrap()
    let ty = c.add(Term.Pi(false, borrow, u), sp).unwrap()
    c.definitions.push(Definition {
        name: "count".to_string(),
        ty,
        value,
        exported: false,
        span: sp
    })
    c.add(Term.Global(0), sp).unwrap()
}

// Yes(Yes(No)), a value of B built in place.
fn two_yes(inout c: Core) -> u32 {
    let sp = diag.Span.nowhere()
    let no = c.add(Term.Con(0, 0, Vec(u32).new()), sp).unwrap()
    var one = Vec(u32).new()
    one.push(no)
    let one = c.add(Term.Con(0, 1, one), sp).unwrap()
    var two = Vec(u32).new()
    two.push(one)
    c.add(Term.Con(0, 1, two), sp).unwrap()
}

#[test]
fn borrows_compute_in_the_pure_model() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let count = counting(&c)
    assert(c.check().is_ok(), "a recursive view counts")
    let two = c.add(Term.Natural(2), sp).unwrap()
    // count(borrow(Yes(Yes(No)))) is 2: the view reads the known nodes.
    let value = two_yes(&c)
    let borrow = c.add(Term.Borrow(value), sp).unwrap()
    let counted = c.add(Term.App(count, borrow), sp).unwrap()
    assert(c.equal(counted, two, DEPTH).unwrap(), "a view of a known node computes")
    // lend(v, fn(r) { count(r) }, fn(a, y) { drop(y, a) }) is 2 as well.
    let none = Vec(u32).new()
    let b = c.add(Term.Ind(0, none), sp).unwrap()
    let u = c.add(Term.U64, sp).unwrap()
    let r = c.add(Term.Ref(b), sp).unwrap()
    let global = c.add(Term.Global(0), sp).unwrap()
    let v0 = c.add(Term.Var(0), sp).unwrap()
    let v1 = c.add(Term.Var(1), sp).unwrap()
    let read = c.add(Term.App(global, v0), sp).unwrap()
    let f = c.add(Term.Lam(false, r, read), sp).unwrap()
    let dropped = c.add(Term.Drop(0, v0, v1), sp).unwrap()
    let g = c.add(Term.Lam(false, b, dropped), sp).unwrap()
    let g = c.add(Term.Lam(false, u, g), sp).unwrap()
    let value = two_yes(&c)
    let lend = c.add(Term.Lend(value, f, g), sp).unwrap()
    assert(c.equal(lend, two, DEPTH).unwrap(), "a lend computes to its continuations")
    // Code to run keeps both: they read memory.
    c.runtime = true
    let kept = c.normal(lend, DEPTH).unwrap()
    let Lend(_, _, _) = c.term(kept) else { panic("code to run keeps the lend") }
    let kept = c.normal(counted, DEPTH).unwrap()
    assert(c.term(kept) != Term.Natural(2), "code to run does not compute views")
    // A neutral borrow stays a view.
    c.runtime = false
    let x = c.add(Term.Var(0), sp).unwrap()
    let neutral = c.add(Term.App(count, x), sp).unwrap()
    let normal = c.normal(neutral, DEPTH).unwrap()
    let View(true, _, _, _, _) = c.term(normal) else { panic("a neutral borrow is not read") }
}

#[test]
fn borrows_of_values_are_evidence_only() {
    let sp = diag.Span.nowhere()
    for (proof, claimed) in [(true, 2), (true, 1), (false, 2)] {
        var c = Core.new()
        let count = counting(&c)
        let value = two_yes(&c)
        let borrow = c.add(Term.Borrow(value), sp).unwrap()
        let counted = c.add(Term.App(count, borrow), sp).unwrap()
        let n = c.add(Term.Natural(claimed as u64), sp).unwrap()
        // Eq(count(borrow(v)), n) by refl(n), or count(borrow(v)) at run time.
        let (ty, value) = if proof {
            (c.add(Term.Eq(counted, n), sp).unwrap(), c.add(Term.Refl(n), sp).unwrap())
        } else { (c.add(Term.U64, sp).unwrap(), counted) }
        c.definitions.push(Definition {
            name: "p".to_string(),
            ty,
            value,
            exported: false,
            span: sp
        })
        let ok = c.check().is_ok()
        assert(ok == (proof && claimed == 2), "evidence of the count, never a runtime borrow")
    }
    // Only an owned value is borrowed.
    var c = Core.new()
    let count = counting(&c)
    let n = c.add(Term.Natural(0), sp).unwrap()
    let borrow = c.add(Term.Borrow(n), sp).unwrap()
    let counted = c.add(Term.App(count, borrow), sp).unwrap()
    let ty = c.add(Term.Eq(counted, n), sp).unwrap()
    let value = c.add(Term.Refl(n), sp).unwrap()
    c.definitions.push(Definition { name: "p".to_string(), ty, value, exported: false, span: sp })
    assert(c.check().is_err(), "a borrow is of a buffer or heap data")
}

// fn(x: B) -> U64 { lend(x, fn(r) { read }, fn(a, y) { drop(back, a) }) }
// with B, count; read is count(r) or count(borrow(x)), and back is y, x or
// neither (a leak: the result alone).
fn dependent(by_name: bool, back: i64) -> Core {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    counting(&c)
    let none = Vec(u32).new()
    let b = c.add(Term.Ind(0, none), sp).unwrap()
    let u = c.add(Term.U64, sp).unwrap()
    let r = c.add(Term.Ref(b), sp).unwrap()
    let global = c.add(Term.Global(0), sp).unwrap()
    let v0 = c.add(Term.Var(0), sp).unwrap()
    let v1 = c.add(Term.Var(1), sp).unwrap()
    let v2 = c.add(Term.Var(2), sp).unwrap()
    // Under r: r is 0 and x is 1.
    let borrowed = if by_name { c.add(Term.Borrow(v1), sp).unwrap() } else { v0 }
    let read = c.add(Term.App(global, borrowed), sp).unwrap()
    let f = c.add(Term.Lam(false, r, read), sp).unwrap()
    // Under a and y: y is 0, a is 1 and x is 2.
    let rest = if back == 0 { c.add(Term.Drop(0, v0, v1), sp).unwrap() }
    else if back == 1 { c.add(Term.Drop(0, v2, v1), sp).unwrap() } else { v1 }
    let g = c.add(Term.Lam(false, b, rest), sp).unwrap()
    let g = c.add(Term.Lam(false, u, g), sp).unwrap()
    let lend = c.add(Term.Lend(v0, f, g), sp).unwrap()
    let value = c.add(Term.Lam(false, b, lend), sp).unwrap()
    let ty = c.add(Term.Pi(false, b, u), sp).unwrap()
    c.definitions.push(Definition { name: "f".to_string(), ty, value, exported: false, span: sp })
    c
}

#[test]
fn a_dependent_lend_gives_back_its_owner_itself() {
    for by_name in [false, true] {
        for back in [0, 1, 2] {
            var c = dependent(by_name, back)
            let ok = c.check().is_ok()
            // The owner given back is used once, as y or as x; the reader
            // may borrow x by name.
            assert(ok == (back != 2), "the owner is used exactly once after its lend")
        }
    }
}
