// Experimental dependent core. Programs and proofs share this syntax;
// core_lower emits MIR from the checked terms themselves. No Horn model
// or external proof checker participates in this path.
//
// This finite fragment has levelled universes, dependent functions,
// immutable I64 arrays indexed by U64 lengths, Lt, U64 equality and
// declared U64-indexed inductive propositions. Equality and structural
// induction eliminate only into Prop. Runtime code has I64 arithmetic,
// which traps on overflow, and bounded loops whose body has evidence of
// its index's bound. U64 terms denote natural numbers: their addition
// traps at run time rather than wrap, so every computed value is its
// meaning, and Lt has the rules of the order of the naturals.
// There is no general recursion, axiom,
// unsafe operation or elimination of evidence into runtime data.
// Erased binders must be propositions and cannot occur in runtime terms.
import diag

pub const LIMIT: i64 = 200000
const STEPS: i64 = 1000000
pub const DEPTH: u32 = 128

#[derive(Clone, Eq)]
pub enum Arith {
    Add
    Sub
    Mul
}

#[derive(Clone, Eq)]
pub enum Term {
    Var(u32)
    Global(u32)
    Universe(u32)
    Prop
    U64
    I64
    Array(u32)
    Lt(u32, u32)
    Eq(u32, u32)
    Refl(u32)
    // P : U64 -> Prop, e : Eq a b, p : P a yields evidence of P b.
    Transport(u32, u32, u32)
    // A declared inductive proposition applied to its U64 indices.
    Ind(u32, Vec(u32))
    // Family, constructor and all of the constructor's fields.
    Con(u32, u32, Vec(u32))
    // Family, motive (U64 -> ... -> Prop), one case per constructor and
    // the evidence eliminated. Only into propositions.
    Elim(u32, u32, Vec(u32), u32)
    // I64 arithmetic. Overflow traps at runtime and is never folded.
    Arith(Arith, u32, u32)
    // fold(n, init, body): body(i, erased Lt(i, n), acc) for i in 0..n.
    Fold(u32, u32, u32)
    // Evaluate the first term for its traps, then the second. Only beta
    // reduction makes these, so call-by-value overflow traps survive
    // substitution; source and textual core cannot write them.
    Strict(u32, u32)
    // U64 addition in the naturals. Overflow traps at run time; sums are
    // compared in a canonical order, and only folded when they fit.
    UAdd(u32, u32)
    // a, b, c and evidence of Lt(a, b), for Lt(a + c, b + c).
    LtAdd(u32, u32, u32, u32)
    // a, b, c and evidence of Lt(a + c, b + c), for Lt(a, b).
    LtCancel(u32, u32, u32, u32)
    // x, y, z, Lt(x, y) and Lt(y, z + 1) (y <= z), for Lt(x, z): the
    // naturals are discrete. Not derivable from the other rules.
    LtLe(u32, u32, u32, u32, u32)
    // a, b and evidence of Lt(b, a + 1) (b <= a): a - b in the naturals,
    // which never underflows. Conversion ignores the evidence.
    USub(u32, u32, u32)
    // Lt(0, a + 1): every natural is at least 0.
    ZeroLe(u32)
    Pi(bool, u32, u32)
    Lam(bool, u32, u32)
    App(u32, u32)
    Natural(u64)
    Integer(i64)
    Elements(Vec(u32))
    Index(u32, u32, u32)
    Decide(u32, u32)
    // The true branch binds erased evidence of Lt a b at de Bruijn 0.
    IfLt(u32, u32, u32, u32)
    IfEq(u32, u32, u32, u32)
}

pub struct Node {
    pub term: Term
    pub span: diag.Span
}

pub struct Definition {
    pub name: String
    pub ty: u32
    pub value: u32
    pub exported: bool
    pub span: diag.Span
}

pub struct Constructor {
    pub name: String
    // A closed Pi telescope of U64 data and erased proof fields, ending
    // in its own family. Checked by the kernel, never trusted.
    pub ty: u32
}

// Families and definitions form one sequence: a family follows the first
// `globals` definitions and may use them and earlier families.
pub struct Family {
    pub name: String
    pub arity: u32
    pub constructors: Vec(Constructor)
    pub globals: u32
    pub span: diag.Span
}

// Computed by the kernel from a checked constructor type.
struct Field {
    erased: bool
    domain: u32
    // Indices of a recursive field, the only place its family may occur.
    recursive: Option(Vec(u32))
}

struct Signature {
    fields: Vec(Field)
    result: Vec(u32)
}

pub struct Binding {
    pub ty: u32
    pub erased: bool
}

pub struct Core {
    pub nodes: Vec(Node)
    pub definitions: Vec(Definition)
    pub families: Vec(Family)
    signatures: Vec(Vec(Signature))
    steps: i64
    visible: u32
    visible_families: u32
}

impl Core {
    pub fn new() -> Core {
        Core {
            nodes: Vec(Node).new(),
            definitions: Vec(Definition).new(),
            families: Vec(Family).new(),
            signatures: Vec(Vec(Signature)).new(),
            steps: 0,
            visible: 0,
            visible_families: 0
        }
    }

    pub fn error(self, id: u32, message: str) -> diag.Diag {
        let span = if id as i64 < self.nodes.len() { self.nodes[id as i64].span }
        else { diag.Span.nowhere() }
        diag.Diag.new(span, ("core: " + message).as_str())
    }

    pub fn add(inout self, sink term: Term, span: diag.Span) -> Result(u32, diag.Diag) {
        if self.nodes.len() >= LIMIT { return Err(diag.Diag.new(span, "core: term limit reached")) }
        let id = self.nodes.len() as u32
        self.nodes.push(Node { term, span })
        Ok(id)
    }

    pub fn term(self, id: u32) -> Term { self.nodes[id as i64].term.clone() }

    fn tick(inout self, id: u32, depth: u32) -> Result((), diag.Diag) {
        self.steps += 1
        if self.steps > STEPS { return Err(self.error(id, "checking step limit reached")) }
        if depth == 0 { return Err(self.error(id, "nesting limit reached")) }
        if id as i64 >= self.nodes.len() { return Err(self.error(id, "invalid term reference")) }
        Ok(())
    }

    // Binder-aware traversal implements weakening and capture-avoiding
    // substitution. Removing a binder rejects a reference that escapes.
    fn transform(
        inout self, id: u32, cutoff: u32, delta: i64, replacement: Option(u32), depth: u32
    ) -> Result(u32, diag.Diag) {
        self.tick(id, depth)?
        let sp = self.nodes[id as i64].span
        let term = match self.term(id) {
            Var(k) => {
                match replacement {
                    Some(value) => {
                        if k == cutoff { return self.shift(value, cutoff as i64, 0, depth - 1) }
                        Term.Var(if k > cutoff { k - 1 } else { k })
                    }
                    None => {
                        if k < cutoff { return Ok(id) }
                        let next = k as i64 + delta
                        if next < cutoff as i64 { return Err(self.error(
                            id,
                            "branch evidence escapes its scope"
                        )) }
                        Term.Var(next as u32)
                    }
                }
            }
            Pi(e, a, b) => Term.Pi(e,
                self.transform(a, cutoff, delta, replacement, depth - 1)?,
                self.transform(b, cutoff + 1, delta, replacement, depth - 1)?)
            Lam(e, a, b) => Term.Lam(e,
                self.transform(a, cutoff, delta, replacement, depth - 1)?,
                self.transform(b, cutoff + 1, delta, replacement, depth - 1)?)
            IfLt(a, b, yes, no) => Term.IfLt(
                self.transform(a, cutoff, delta, replacement, depth - 1)?,
                self.transform(b, cutoff, delta, replacement, depth - 1)?,
                self.transform(yes, cutoff + 1, delta, replacement, depth - 1)?,
                self.transform(no, cutoff, delta, replacement, depth - 1)?)
            IfEq(a, b, yes, no) => Term.IfEq(
                self.transform(a, cutoff, delta, replacement, depth - 1)?,
                self.transform(b, cutoff, delta, replacement, depth - 1)?,
                self.transform(yes, cutoff + 1, delta, replacement, depth - 1)?,
                self.transform(no, cutoff, delta, replacement, depth - 1)?)
            Eq(a, b) => Term.Eq(self.transform(a, cutoff, delta, replacement, depth - 1)?,
                self.transform(b, cutoff, delta, replacement, depth - 1)?)
            Refl(a) => Term.Refl(self.transform(a, cutoff, delta, replacement, depth - 1)?)
            Transport(f, e, p) => Term.Transport(
                self.transform(f, cutoff, delta, replacement, depth - 1)?,
                self.transform(e, cutoff, delta, replacement, depth - 1)?,
                self.transform(p, cutoff, delta, replacement, depth - 1)?)
            Ind(f, xs) => Term.Ind(
                f,
                self.transform_all(xs.as_slice(), cutoff, delta, replacement, depth)?
            )
            Con(f, k, xs) => Term.Con(
                f,
                k,
                self.transform_all(xs.as_slice(), cutoff, delta, replacement, depth)?
            )
            Elim(f, p, cases, x) => Term.Elim(f,
                self.transform(p, cutoff, delta, replacement, depth - 1)?,
                self.transform_all(cases.as_slice(), cutoff, delta, replacement, depth)?,
                self.transform(x, cutoff, delta, replacement, depth - 1)?)
            Array(n) => Term.Array(self.transform(n, cutoff, delta, replacement, depth - 1)?)
            Lt(a, b) => Term.Lt(self.transform(a, cutoff, delta, replacement, depth - 1)?,
                self.transform(b, cutoff, delta, replacement, depth - 1)?)
            App(f, a) => Term.App(self.transform(f, cutoff, delta, replacement, depth - 1)?,
                self.transform(a, cutoff, delta, replacement, depth - 1)?)
            Decide(a, b) => Term.Decide(self.transform(a, cutoff, delta, replacement, depth - 1)?,
                self.transform(b, cutoff, delta, replacement, depth - 1)?)
            Index(a, i, p) => Term.Index(self.transform(a, cutoff, delta, replacement, depth - 1)?,
                self.transform(i, cutoff, delta, replacement, depth - 1)?,
                self.transform(p, cutoff, delta, replacement, depth - 1)?)
            Arith(op, a, b) => Term.Arith(op,
                self.transform(a, cutoff, delta, replacement, depth - 1)?,
                self.transform(b, cutoff, delta, replacement, depth - 1)?)
            Strict(a, b) => Term.Strict(self.transform(a, cutoff, delta, replacement, depth - 1)?,
                self.transform(b, cutoff, delta, replacement, depth - 1)?)
            UAdd(a, b) => Term.UAdd(self.transform(a, cutoff, delta, replacement, depth - 1)?,
                self.transform(b, cutoff, delta, replacement, depth - 1)?)
            USub(a, b, p) => Term.USub(self.transform(a, cutoff, delta, replacement, depth - 1)?,
                self.transform(b, cutoff, delta, replacement, depth - 1)?,
                self.transform(p, cutoff, delta, replacement, depth - 1)?)
            ZeroLe(a) => Term.ZeroLe(self.transform(a, cutoff, delta, replacement, depth - 1)?)
            LtAdd(a, b, c, p) => Term.LtAdd(
                self.transform(a, cutoff, delta, replacement, depth - 1)?,
                self.transform(b, cutoff, delta, replacement, depth - 1)?,
                self.transform(c, cutoff, delta, replacement, depth - 1)?,
                self.transform(p, cutoff, delta, replacement, depth - 1)?)
            LtCancel(a, b, c, p) => Term.LtCancel(
                self.transform(a, cutoff, delta, replacement, depth - 1)?,
                self.transform(b, cutoff, delta, replacement, depth - 1)?,
                self.transform(c, cutoff, delta, replacement, depth - 1)?,
                self.transform(p, cutoff, delta, replacement, depth - 1)?)
            LtLe(x, y, z, p, q) => Term.LtLe(
                self.transform(x, cutoff, delta, replacement, depth - 1)?,
                self.transform(y, cutoff, delta, replacement, depth - 1)?,
                self.transform(z, cutoff, delta, replacement, depth - 1)?,
                self.transform(p, cutoff, delta, replacement, depth - 1)?,
                self.transform(q, cutoff, delta, replacement, depth - 1)?)
            Fold(n, init, body) => Term.Fold(
                self.transform(n, cutoff, delta, replacement, depth - 1)?,
                self.transform(init, cutoff, delta, replacement, depth - 1)?,
                self.transform(body, cutoff, delta, replacement, depth - 1)?)
            Elements(xs) => Term.Elements(self.transform_all(
                xs.as_slice(),
                cutoff,
                delta,
                replacement,
                depth
            )?)
            t => t
        }
        self.add(term, sp)
    }

    fn transform_all(
        inout self,
        xs: [u32],
        cutoff: u32,
        delta: i64,
        replacement: Option(u32),
        depth: u32
    ) -> Result(Vec(u32), diag.Diag) {
        var out = Vec(u32).new()
        for x in xs { out.push(self.transform(x, cutoff, delta, replacement, depth - 1)?) }
        Ok(out)
    }

    fn normal_all(inout self, xs: [u32], depth: u32) -> Result(Vec(u32), diag.Diag) {
        var out = Vec(u32).new()
        for x in xs { out.push(self.normal(x, depth - 1)?) }
        Ok(out)
    }

    pub fn shift(
        inout self,
        id: u32,
        delta: i64,
        cutoff: u32,
        depth: u32
    ) -> Result(u32, diag.Diag) {
        self.transform(id, cutoff, delta, None, depth)
    }

    pub fn substitute(inout self, body: u32, value: u32, depth: u32) -> Result(u32, diag.Diag) {
        self.transform(body, 0, 0, Some(value), depth)
    }

    // Normalization is computation in the finite core, including beta
    // reduction. Resource exhaustion is rejection, never proof acceptance.
    pub fn normal(inout self, id: u32, depth: u32) -> Result(u32, diag.Diag) {
        self.tick(id, depth)?
        let sp = self.nodes[id as i64].span
        let term = match self.term(id) {
            Global(g) => {
                if g >= self.visible { return Err(self.error(id, "recursive or forward definition")) }
                let body = self.definitions[g as i64].value
                return self.normal(body, depth - 1)
            }
            App(f, a) => {
                let f = self.normal(f, depth - 1)?
                let a = self.normal(a, depth - 1)?
                match self.term(f) {
                    Lam(erased, _, body) => {
                        let body = self.substitute(body, a, depth - 1)?
                        let result = self.normal(body, depth - 1)?
                        // The body may not use a runtime argument, or only
                        // in one branch; its traps still happen first.
                        if !erased && self.may_trap(a, depth - 1) {
                            return self.add(Term.Strict(a, result), sp)
                        }
                        return Ok(result)
                    }
                    // Applying a branch applies each of its alternatives;
                    // the true branch has the evidence binder.
                    IfLt(x, y, yes, no) | IfEq(x, y, yes, no) => {
                        let equality = match self.term(f) { IfEq(_, _, _, _) => true, _ => false }
                        let shifted = self.shift(a, 1, 0, depth - 1)?
                        let yes = self.add(Term.App(yes, shifted), sp)?
                        let no = self.add(Term.App(no, a), sp)?
                        let branch = if equality { Term.IfEq(x, y, yes, no) }
                        else { Term.IfLt(x, y, yes, no) }
                        let branch = self.add(branch, sp)?
                        return self.normal(branch, depth - 1)
                    }
                    Strict(first, g) => {
                        let applied = self.add(Term.App(g, a), sp)?
                        let applied = self.normal(applied, depth - 1)?
                        return self.add(Term.Strict(first, applied), sp)
                    }
                    _ => Term.App(f, a)
                }
            }
            Pi(e, a, b) => Term.Pi(e, self.normal(a, depth - 1)?, self.normal(b, depth - 1)?)
            Lam(e, a, b) => Term.Lam(e, self.normal(a, depth - 1)?, self.normal(b, depth - 1)?)
            Array(n) => Term.Array(self.normal(n, depth - 1)?)
            Lt(a, b) => Term.Lt(self.normal(a, depth - 1)?, self.normal(b, depth - 1)?)
            Eq(a, b) => Term.Eq(self.normal(a, depth - 1)?, self.normal(b, depth - 1)?)
            Refl(a) => Term.Refl(self.normal(a, depth - 1)?)
            Ind(f, xs) => Term.Ind(f, self.normal_all(xs.as_slice(), depth)?)
            Con(f, k, xs) => Term.Con(f, k, self.normal_all(xs.as_slice(), depth)?)
            Elim(f, p, cases, x) => {
                let p = self.normal(p, depth - 1)?
                let cases = self.normal_all(cases.as_slice(), depth)?
                let x = self.normal(x, depth - 1)?
                // Iota reduction applies the constructor's case to its
                // fields, then to induction on each recursive field: the
                // strictly positive subterms. User code chooses no recursion.
                // Ill-formed terms stay neutral; infer rejects them.
                let Con(g, k, fields) = self.term(x) else { return self.add(
                    Term.Elim(f, p, cases, x),
                    sp
                ) }
                if g != f || f as i64 >= self.signatures.len() || k as i64 >= cases.len() ||
                    cases.len() != self.signatures[f as i64].len() {
                    return self.add(Term.Elim(f, p, cases, x), sp)
                }
                let count = self.signatures[f as i64][k as i64].fields.len()
                if fields.len() != count { return self.add(Term.Elim(f, p, cases, x), sp) }
                var result = cases[k as i64]
                for field in fields { result = self.add(Term.App(result, field), sp)? }
                for j in 0..count {
                    if self.signatures[f as i64][k as i64].fields[j].recursive.is_none() { continue }
                    let ih = self.add(Term.Elim(f, p, cases.clone(), fields[j]), sp)?
                    result = self.add(Term.App(result, ih), sp)?
                }
                return self.normal(result, depth - 1)
            }
            Transport(f, e, p) => {
                let f = self.normal(f, depth - 1)?
                let e = self.normal(e, depth - 1)?
                let p = self.normal(p, depth - 1)?
                match self.term(e) {
                    Refl(_) => return Ok(p)
                    _ => Term.Transport(f, e, p)
                }
            }
            IfLt(a, b, yes, no) | IfEq(a, b, yes, no) => {
                let equality = match self.term(id) { IfEq(_, _, _, _) => true, _ => false }
                let a = self.normal(a, depth - 1)?
                let b = self.normal(b, depth - 1)?
                match (self.term(a), self.term(b)) {
                    (Natural(x), Natural(y)) => {
                        let holds = if equality { x == y } else { x < y }
                        if holds {
                            let proof = if equality { Term.Refl(a) } else { Term.Decide(a, b) }
                            let p = self.add(proof, sp)?
                            let body = self.substitute(yes, p, depth - 1)?
                            return self.normal(body, depth - 1)
                        }
                        return self.normal(no, depth - 1)
                    }
                    _ => {
                        let yes = self.normal(yes, depth - 1)?
                        let no = self.normal(no, depth - 1)?
                        if equality { Term.IfEq(a, b, yes, no) } else { Term.IfLt(a, b, yes, no) }
                    }
                }
            }
            Decide(a, b) => Term.Decide(self.normal(a, depth - 1)?, self.normal(b, depth - 1)?)
            Index(a, i, p) => Term.Index(self.normal(a, depth - 1)?, self.normal(i, depth - 1)?,
                self.normal(p, depth - 1)?)
            Arith(op, a, b) => {
                let a = self.normal(a, depth - 1)?
                let b = self.normal(b, depth - 1)?
                match (self.term(a), self.term(b)) {
                    (Integer(x), Integer(y)) => {
                        let (x, y) = (x as i128, y as i128)
                        let v = match op { Add => x + y, Sub => x - y, Mul => x * y }
                        // An overflowing operation stays a runtime trap.
                        if v >= -9223372036854775807 - 1 && v <= 9223372036854775807 {
                            Term.Integer(v as i64)
                        } else { Term.Arith(op, a, b) }
                    }
                    _ => Term.Arith(op, a, b)
                }
            }
            Fold(n, init, body) => {
                let n = self.normal(n, depth - 1)?
                let init = self.normal(init, depth - 1)?
                // Loops are not unrolled; only the empty loop computes. Its
                // body never runs, so neither do the body's traps.
                if self.term(n) == Term.Natural(0) { return Ok(init) }
                // Eta-expand the body, so that lowering finds its binders.
                let u = self.add(Term.U64, sp)?
                let i = self.add(Term.I64, sp)?
                let x0 = self.add(Term.Var(0), sp)?
                let x1 = self.add(Term.Var(1), sp)?
                let x2 = self.add(Term.Var(2), sp)?
                let bound = self.shift(n, 1, 0, depth - 1)?
                let lt = self.add(Term.Lt(x0, bound), sp)?
                var applied = self.shift(body, 3, 0, depth - 1)?
                for x in [x2, x1, x0] { applied = self.add(Term.App(applied, x), sp)? }
                let eta = self.add(Term.Lam(false, i, applied), sp)?
                let eta = self.add(Term.Lam(true, lt, eta), sp)?
                let eta = self.add(Term.Lam(false, u, eta), sp)?
                Term.Fold(n, init, self.normal(eta, depth - 1)?)
            }
            Strict(a, b) => {
                let a = self.normal(a, depth - 1)?
                let b = self.normal(b, depth - 1)?
                if !self.may_trap(a, depth - 1) { return Ok(b) }
                Term.Strict(a, b)
            }
            UAdd(a, b) => {
                let a = self.normal(a, depth - 1)?
                let b = self.normal(b, depth - 1)?
                return self.sum(a, b, sp, depth - 1)
            }
            USub(a, b, p) => {
                let a = self.normal(a, depth - 1)?
                let b = self.normal(b, depth - 1)?
                let p = self.normal(p, depth - 1)?
                // (r + b) - b is r when b's parts are among a's.
                var atoms = Vec(u32).new()
                var constant: u128 = 0
                var pending = Vec(u32).new()
                self.collect(a, &atoms, &constant, &pending, depth - 1)
                var minus = Vec(u32).new()
                var less: u128 = 0
                self.collect(b, &minus, &less, &pending, depth - 1)
                if less <= constant {
                    match self.without(atoms.as_slice(), minus.as_slice(), depth - 1) {
                        Some(rest) => {
                            match self.canonical(rest.as_slice(), constant - less, sp)? {
                                Some(id) => {
                                    // The operands are still evaluated for
                                    // their traps, as the subtraction would.
                                    var result = id
                                    for x in [b, a] {
                                        if self.may_trap(x, depth - 1) {
                                            result = self.add(Term.Strict(x, result), sp)?
                                        }
                                    }
                                    return Ok(result)
                                }
                                None => {}
                            }
                        }
                        None => {}
                    }
                }
                Term.USub(a, b, p)
            }
            ZeroLe(a) => Term.ZeroLe(self.normal(a, depth - 1)?)
            LtAdd(a, b, c, p) => Term.LtAdd(self.normal(a, depth - 1)?, self.normal(b, depth - 1)?,
                self.normal(c, depth - 1)?, self.normal(p, depth - 1)?)
            LtCancel(a, b, c, p) => Term.LtCancel(self.normal(a, depth - 1)?,
                self.normal(b, depth - 1)?, self.normal(c, depth - 1)?, self.normal(p, depth - 1)?)
            LtLe(x, y, z, p, q) => Term.LtLe(self.normal(x, depth - 1)?, self.normal(y, depth - 1)?,
                self.normal(z, depth - 1)?, self.normal(p, depth - 1)?, self.normal(q, depth - 1)?)
            Elements(xs) => Term.Elements(self.normal_all(xs.as_slice(), depth)?)
            t => return Ok(id)
        }
        self.add(term, sp)
    }

    // The canonical sum of two normal U64 terms: variables in index order,
    // then other terms in their order, then the constant, without zero.
    // These are equations of the naturals. A constant that does not fit
    // a U64 leaves the sum as it is.
    fn sum(inout self, a: u32, b: u32, sp: diag.Span, depth: u32) -> Result(u32, diag.Diag) {
        var atoms = Vec(u32).new()
        var constant: u128 = 0
        // Traps of Strict terms in the sum, evaluated before the result.
        var pending = Vec(u32).new()
        self.collect(a, &atoms, &constant, &pending, depth)
        self.collect(b, &atoms, &constant, &pending, depth)
        // (x - y) + y is x when the sum has all of y's parts.
        var changed = true
        var rounds = 0
        while changed && rounds < 64 {
            changed = false
            rounds += 1
            for k in 0..atoms.len() {
                let USub(x, y, _) = self.term(atoms[k]) else { continue }
                var minus = Vec(u32).new()
                var less: u128 = 0
                var traps = Vec(u32).new()
                self.collect(y, &minus, &less, &traps, depth)
                if less > constant || traps.len() != 0 { continue }
                var others = Vec(u32).new()
                for j in 0..atoms.len() { if j != k { others.push(atoms[j]) } }
                let Some(rest) = self.without(others.as_slice(), minus.as_slice(), depth) else {
                    continue
                }
                atoms = rest
                constant -= less
                // y is no longer evaluated; its traps still happen.
                if self.may_trap(y, depth) { pending.push(y) }
                self.collect(x, &atoms, &constant, &pending, depth)
                changed = true
                break
            }
        }
        match self.canonical(atoms.as_slice(), constant, sp)? {
            Some(id) => {
                var result = id
                for x in pending { result = self.add(Term.Strict(x, result), sp)? }
                Ok(result)
            }
            None => self.add(Term.UAdd(a, b), sp)
        }
    }

    // Variables in index order, then other terms in their order, then the
    // constant; None when the constant does not fit a U64.
    fn canonical(
        inout self,
        atoms: [u32],
        constant: u128,
        sp: diag.Span
    ) -> Result(Option(u32), diag.Diag) {
        if constant > 0xffffffffffffffff { return Ok(None) }
        var vars = Vec((u32, u32)).new()
        var others = Vec(u32).new()
        for x in atoms {
            match self.term(x) {
                Var(k) => {
                    var at = vars.len()
                    while at > 0 && vars[at - 1].0 > k { at -= 1 }
                    vars.insert(at, (k, x))
                }
                _ => others.push(x)
            }
        }
        var ordered = Vec(u32).new()
        for v in vars { ordered.push(v.1) }
        for x in others { ordered.push(x) }
        if constant > 0 || ordered.len() == 0 { ordered.push(self.add(
            Term.Natural(constant as u64),
            sp
        )?) }
        var result: Option(u32) = None
        for x in ordered {
            result = Some(match result { Some(r) => self.add(Term.UAdd(r, x), sp)?, None => x })
        }
        Ok(result)
    }

    // The pool without one identical occurrence of each item, if it has them.
    fn without(self, pool: [u32], items: [u32], depth: u32) -> Option(Vec(u32)) {
        var rest = Vec(u32).new()
        for x in pool { rest.push(x) }
        for item in items {
            var found = -1
            for k in 0..rest.len() {
                if self.identical(rest[k], item, depth) { found = k; break }
            }
            if found < 0 { return None }
            rest.remove(found)
        }
        Some(rest)
    }

    fn collect(
        self,
        id: u32,
        inout atoms: Vec(u32),
        inout constant: u128,
        inout pending: Vec(u32),
        depth: u32
    ) {
        match self.term(id) {
            UAdd(a, b) if depth > 0 => {
                self.collect(a, &atoms, &constant, &pending, depth - 1)
                self.collect(b, &atoms, &constant, &pending, depth - 1)
            }
            // Strict(t, r) is r in the naturals; t is evaluated first.
            Strict(t, r) if depth > 0 => {
                pending.push(t)
                self.collect(r, &atoms, &constant, &pending, depth - 1)
            }
            Natural(n) => constant += n as u128
            _ => atoms.push(id)
        }
    }

    // Whether evaluating a runtime term can trap: it contains arithmetic,
    // which overflow could stop. Conservative at the depth limit.
    fn may_trap(self, id: u32, depth: u32) -> bool {
        if depth == 0 { return true }
        match self.term(id) {
            Arith(_, _, _) | Strict(_, _) | UAdd(_, _) => true
            t => {
                for child in children(t) { if self.may_trap(child, depth - 1) { return true } }
                false
            }
        }
    }

    fn identical(self, a: u32, b: u32, depth: u32) -> bool {
        if depth == 0 { return false }
        // Strict(x, y) means y: it only orders the evaluation of x's traps.
        match self.term(a) { Strict(_, y) => return self.identical(y, b, depth - 1), _ => {} }
        match self.term(b) { Strict(_, y) => return self.identical(a, y, depth - 1), _ => {} }
        match (self.term(a), self.term(b)) {
            (Array(x), Array(y)) | (Refl(x), Refl(y)) => self.identical(x, y, depth - 1)
            (Eq(a, b), Eq(c, d)) | (Lt(a, b), Lt(c, d)) | (
                App(a, b),
                App(c, d)
            ) | (
                Decide(a, b),
                Decide(c, d)
            ) =>
                self.identical(a, c, depth - 1) && self.identical(b, d, depth - 1)
            (Pi(e, a, b), Pi(f, c, d)) | (Lam(e, a, b), Lam(f, c, d)) =>
                e == f && self.identical(a, c, depth - 1) && self.identical(b, d, depth - 1)
            (Index(a, i, p), Index(b, j, q)) | (Transport(a, i, p), Transport(b, j, q)) => self.identical(
                a,
                b,
                depth - 1
            ) &&
                self.identical(i, j, depth - 1) && self.identical(p, q, depth - 1)
            // Proof irrelevance: any evidence of b <= a gives the same a - b.
            (USub(a, b, _), USub(c, d, _)) =>
                self.identical(a, c, depth - 1) && self.identical(b, d, depth - 1)
            (ZeroLe(a), ZeroLe(b)) => self.identical(a, b, depth - 1)
            (UAdd(a, b), UAdd(c, d)) => self.identical(a, c, depth - 1) && self.identical(
                b,
                d,
                depth - 1
            )
            (LtAdd(a, b, c, p), LtAdd(x, y, z, q)) | (LtCancel(a, b, c, p), LtCancel(x, y, z, q)) =>
                self.identical(a, x, depth - 1) && self.identical(b, y, depth - 1) &&
                self.identical(c, z, depth - 1) && self.identical(p, q, depth - 1)
            (LtLe(a, b, c, p, q), LtLe(x, y, z, r, t)) =>
                self.identical(a, x, depth - 1) && self.identical(b, y, depth - 1) &&
                self.identical(c, z, depth - 1) && self.identical(p, r, depth - 1) &&
                self.identical(q, t, depth - 1)
            (Arith(o, a, b), Arith(p, c, d)) =>
                o == p && self.identical(a, c, depth - 1) && self.identical(b, d, depth - 1)
            (Fold(a, b, y), Fold(c, d, z)) => self.identical(a, c, depth - 1) &&
                self.identical(b, d, depth - 1) && self.identical(y, z, depth - 1)
            (Ind(f, xs), Ind(g, ys)) => f == g && self.identical_all(
                xs.as_slice(),
                ys.as_slice(),
                depth
            )
            (Con(f, k, xs), Con(g, l, ys)) =>
                f == g && k == l && self.identical_all(xs.as_slice(), ys.as_slice(), depth)
            (Elim(f, p, xs, a), Elim(g, q, ys, b)) => f == g && self.identical(p, q, depth - 1) &&
                self.identical_all(xs.as_slice(), ys.as_slice(), depth) && self.identical(
                a,
                b,
                depth - 1
            )
            (IfLt(a, b, y, n), IfLt(c, d, z, m)) |
                (IfEq(a, b, y, n), IfEq(c, d, z, m)) => self.identical(a, c, depth - 1) &&
                self.identical(b, d, depth - 1) && self.identical(y, z, depth - 1) && self.identical(
                n,
                m,
                depth - 1
            )
            (Elements(xs), Elements(ys)) => self.identical_all(xs.as_slice(), ys.as_slice(), depth)
            (x, y) => x == y
        }
    }

    fn identical_all(self, xs: [u32], ys: [u32], depth: u32) -> bool {
        if xs.len != ys.len { return false }
        for i in 0..xs.len { if !self.identical(xs[i], ys[i], depth - 1) { return false } }
        true
    }

    pub fn equal(inout self, a: u32, b: u32, depth: u32) -> Result(bool, diag.Diag) {
        let a = self.normal(a, depth)?
        let b = self.normal(b, depth)?
        Ok(self.identical(a, b, depth))
    }

    fn sort(inout self, ty: u32, depth: u32) -> Result(i64, diag.Diag) {
        let n = self.normal(ty, depth)?
        match self.term(n) {
            Prop => Ok(-1)
            Universe(level) => Ok(level as i64)
            _ => Err(self.error(ty, "expected a type or proposition"))
        }
    }

    fn binder(
        inout self,
        domain: u32,
        erased: bool,
        ctx: [Binding],
        depth: u32
    ) -> Result(i64, diag.Diag) {
        let ty = self.infer(domain, ctx, true, depth)?
        let level = self.sort(ty, depth)?
        if erased && level != -1 { return Err(self.error(
            domain,
            "erased binders must be propositions"
        )) }
        if !erased && level == -1 { return Err(self.error(domain, "proof binders must be erased")) }
        Ok(level)
    }

    pub fn require(
        inout self,
        id: u32,
        expected: u32,
        ctx: [Binding],
        ghost: bool,
        depth: u32
    ) -> Result((), diag.Diag) {
        let actual = self.infer(id, ctx, ghost, depth)?
        if !self.equal(actual, expected, depth)? { return Err(self.error(id, "type mismatch")) }
        Ok(())
    }

    fn apply2(inout self, f: u32, a: u32, b: u32, sp: diag.Span) -> Result(u32, diag.Diag) {
        let f = self.add(Term.App(f, a), sp)?
        self.add(Term.App(f, b), sp)
    }

    fn family_ref(self, id: u32, f: u32) -> Result((), diag.Diag) {
        if f >= self.visible_families || f as i64 >= self.signatures.len() {
            return Err(self.error(id, "inductive family used before its declaration is checked"))
        }
        Ok(())
    }

    // U64 -> ... -> Prop, one binder per index: elimination is into
    // propositions only, so evidence never determines runtime data.
    pub fn motive_type(inout self, f: u32, sp: diag.Span) -> Result(u32, diag.Diag) {
        let u = self.add(Term.U64, sp)?
        var ty = self.add(Term.Prop, sp)?
        for _ in 0..self.families[f as i64].arity { ty = self.add(Term.Pi(false, u, ty), sp)? }
        Ok(ty)
    }

    // The case for constructor k with fields x and recursive fields
    // r1..rn: (x...) -> (erased ih_i : P(indices of r_i))... -> P(result).
    // Hypotheses follow all fields. P comes from the outer context and is
    // weakened under the new binders. Also used to elaborate source lambdas;
    // infer checks those elaborated terms independently.
    pub fn case_type(
        inout self,
        f: u32,
        k: u32,
        p: u32,
        sp: diag.Span,
        depth: u32
    ) -> Result(u32, diag.Diag) {
        if f as i64 >= self.signatures.len() || k as i64 >= self.signatures[f as i64].len() {
            return Err(diag.Diag.new(sp, "core: unchecked inductive family or constructor"))
        }
        var erased = Vec(bool).new()
        var domains = Vec(u32).new()
        var positions = Vec(i64).new()
        var recursive = Vec(Vec(u32)).new()
        for j, field in self.signatures[f as i64][k as i64].fields {
            erased.push(field.erased)
            domains.push(field.domain)
            match field.recursive {
                Some(xs) => { positions.push(j); recursive.push(xs.clone()) }
                None => {}
            }
        }
        let indices = self.signatures[f as i64][k as i64].result.clone()
        let m = domains.len()
        let r = positions.len()
        var result = self.shift(p, m + r, 0, depth)?
        for x in indices {
            let x = self.shift(x, r, 0, depth)?
            result = self.add(Term.App(result, x), sp)?
        }
        var t = r
        while t > 0 {
            t -= 1
            // Field j's indices live under its j preceding fields.
            var ih = self.shift(p, m + t, 0, depth)?
            for x in recursive[t] {
                let x = self.shift(x, m + t - positions[t], 0, depth)?
                ih = self.add(Term.App(ih, x), sp)?
            }
            result = self.add(Term.Pi(true, ih, result), sp)?
        }
        var j = m
        while j > 0 {
            j -= 1
            result = self.add(Term.Pi(erased[j], domains[j], result), sp)?
        }
        Ok(result)
    }

    // (i : U64) -> (erased p : Lt(i, n)) -> (acc : I64) -> I64, with n
    // from the outer context. Also used to elaborate source loop bodies.
    pub fn fold_body_type(inout self, n: u32, sp: diag.Span, depth: u32) -> Result(u32, diag.Diag) {
        let u = self.add(Term.U64, sp)?
        let i = self.add(Term.I64, sp)?
        let x0 = self.add(Term.Var(0), sp)?
        let bound = self.shift(n, 1, 0, depth)?
        let lt = self.add(Term.Lt(x0, bound), sp)?
        let ty = self.add(Term.Pi(false, i, i), sp)?
        let ty = self.add(Term.Pi(true, lt, ty), sp)?
        self.add(Term.Pi(false, u, ty), sp)
    }

    fn indices(inout self, xs: [u32], f: u32, ctx: [Binding], at: u32) -> Result((), diag.Diag) {
        if xs.len != self.families[f as i64].arity as i64 {
            return Err(self.error(at, "wrong number of family indices"))
        }
        let sp = self.nodes[at as i64].span
        let u = self.add(Term.U64, sp)?
        for x in xs { self.require(x, u, ctx, true, DEPTH)? }
        Ok(())
    }

    // Strict positivity: while family f is checked it is not yet visible,
    // so infer rejects it everywhere except as a whole recursive field
    // F(indices) or the constructor's result, which are matched here.
    fn signature(inout self, f: u32, ty: u32) -> Result(Signature, diag.Diag) {
        // The telescope is checked as written, before any normalization,
        // so evidence inside it is checked even where reduction removes it.
        var ty = ty
        var ctx = Vec(Binding).new()
        var fields = Vec(Field).new()
        loop {
            if (ty as i64) >= self.nodes.len() { return Err(self.error(
                ty,
                "invalid term reference"
            )) }
            match self.term(ty) {
                Pi(erased, domain, rest) => {
                    let recursive = match self.term(domain) {
                        Ind(g, xs) if g == f => Some(xs)
                        _ => None
                    }
                    let recursive = match recursive {
                        Some(xs) => {
                            if !erased { return Err(self.error(
                                domain,
                                "recursive constructor fields must be erased"
                            )) }
                            self.indices(xs.as_slice(), f, ctx.as_slice(), domain)?
                            Some(self.normal_all(xs.as_slice(), DEPTH)?)
                        }
                        None => {
                            self.binder(domain, erased, ctx.as_slice(), DEPTH)?
                            None
                        }
                    }
                    let domain = self.normal(domain, DEPTH)?
                    if !erased && self.term(domain) != Term.U64 { return Err(self.error(
                        domain,
                        "constructor data fields must be u64"
                    )) }
                    fields.push(Field { erased, domain, recursive })
                    ctx.push(Binding { ty: domain, erased })
                    ty = rest
                }
                Ind(g, xs) if g == f => {
                    self.indices(xs.as_slice(), f, ctx.as_slice(), ty)?
                    let result = self.normal_all(xs.as_slice(), DEPTH)?
                    return Ok(Signature { fields, result })
                }
                _ => return Err(self.error(
                    ty,
                    "a constructor type is a telescope ending in its own family"
                ))
            }
        }
    }

    fn declare(inout self, f: u32) -> Result((), diag.Diag) {
        let sp = self.families[f as i64].span
        if self.families[f as i64].arity > 16 {
            return Err(diag.Diag.new(sp, "core: inductive families have at most 16 indices"))
        }
        var signatures = Vec(Signature).new()
        for k in 0..self.families[f as i64].constructors.len() {
            let ty = self.families[f as i64].constructors[k].ty
            signatures.push(self.signature(f, ty)?)
        }
        self.signatures.push(signatures)
        Ok(())
    }

    pub fn infer(
        inout self,
        id: u32,
        ctx: [Binding],
        ghost: bool,
        depth: u32
    ) -> Result(u32, diag.Diag) {
        self.tick(id, depth)?
        let sp = self.nodes[id as i64].span
        let ty = match self.term(id) {
            Var(k) => {
                if k as i64 >= ctx.len { return Err(self.error(id, "unbound variable")) }
                let b = ctx[ctx.len - 1 - k as i64]
                if b.erased && !ghost { return Err(self.error(
                    id,
                    "erased evidence used at runtime"
                )) }
                return self.shift(b.ty, k as i64 + 1, 0, depth - 1)
            }
            Global(g) => {
                if g >= self.visible { return Err(self.error(id, "recursive or forward definition")) }
                let ty = self.definitions[g as i64].ty
                return self.shift(ty, ctx.len, 0, depth - 1)
            }
            Universe(level) => {
                if level >= 32 { return Err(self.error(id, "universe level limit reached")) }
                Term.Universe(level + 1)
            }
            Prop | U64 | I64 => Term.Universe(0)
            Natural(_) => Term.U64
            Integer(_) => Term.I64
            Array(n) => {
                let u = self.add(Term.U64, sp)?
                self.require(n, u, ctx, true, depth - 1)?
                Term.Universe(0)
            }
            Eq(a, b) | Lt(a, b) => {
                let u = self.add(Term.U64, sp)?
                self.require(a, u, ctx, true, depth - 1)?
                self.require(b, u, ctx, true, depth - 1)?
                Term.Prop
            }
            Refl(a) => {
                let u = self.add(Term.U64, sp)?
                self.require(a, u, ctx, true, depth - 1)?
                Term.Eq(a, a)
            }
            Ind(f, xs) => {
                self.family_ref(id, f)?
                self.indices(xs.as_slice(), f, ctx, id)?
                Term.Prop
            }
            Con(f, k, xs) => {
                self.family_ref(id, f)?
                if k as i64 >= self.families[f as i64].constructors.len() {
                    return Err(self.error(id, "unknown constructor"))
                }
                // Instantiate the closed constructor telescope field by field.
                let closed = self.families[f as i64].constructors[k as i64].ty
                var ty = self.shift(closed, ctx.len, 0, depth - 1)?
                for x in xs {
                    let normal = self.normal(ty, depth - 1)?
                    let Pi(_, domain, result) = self.term(normal) else {
                        return Err(self.error(x, "too many constructor fields"))
                    }
                    self.require(x, domain, ctx, true, depth - 1)?
                    ty = self.substitute(result, x, depth - 1)?
                }
                let ty = self.normal(ty, depth - 1)?
                let Ind(_, _) = self.term(ty) else { return Err(self.error(
                    id,
                    "a constructor needs all of its fields"
                )) }
                return Ok(ty)
            }
            Elim(f, p, cases, x) => {
                self.family_ref(id, f)?
                if cases.len() != self.families[f as i64].constructors.len() {
                    return Err(self.error(id, "induction needs one case per constructor"))
                }
                let motive = self.motive_type(f, sp)?
                self.require(p, motive, ctx, true, depth - 1)?
                for k, case in cases {
                    let expected = self.case_type(f, k as u32, p, sp, depth - 1)?
                    self.require(case, expected, ctx, true, depth - 1)?
                }
                let ty = self.infer(x, ctx, true, depth - 1)?
                let ty = self.normal(ty, depth - 1)?
                let Ind(g, indices) = self.term(ty) else {
                    return Err(self.error(x, "induction requires evidence of its family"))
                }
                if g != f { return Err(self.error(x, "induction requires evidence of its family")) }
                var result = p
                for i in indices { result = self.add(Term.App(result, i), sp)? }
                return Ok(result)
            }
            Arith(_, a, b) => {
                let i = self.add(Term.I64, sp)?
                self.require(a, i, ctx, ghost, depth - 1)?
                self.require(b, i, ctx, ghost, depth - 1)?
                Term.I64
            }
            Strict(a, b) => {
                self.infer(a, ctx, ghost, depth - 1)?
                return self.infer(b, ctx, ghost, depth - 1)
            }
            UAdd(a, b) => {
                let u = self.add(Term.U64, sp)?
                self.require(a, u, ctx, ghost, depth - 1)?
                self.require(b, u, ctx, ghost, depth - 1)?
                Term.U64
            }
            USub(a, b, p) => {
                let u = self.add(Term.U64, sp)?
                self.require(a, u, ctx, ghost, depth - 1)?
                self.require(b, u, ctx, ghost, depth - 1)?
                let one = self.add(Term.Natural(1), sp)?
                let a1 = self.add(Term.UAdd(a, one), sp)?
                let le = self.add(Term.Lt(b, a1), sp)?
                self.require(p, le, ctx, true, depth - 1)?
                Term.U64
            }
            ZeroLe(a) => {
                let u = self.add(Term.U64, sp)?
                self.require(a, u, ctx, true, depth - 1)?
                let zero = self.add(Term.Natural(0), sp)?
                let one = self.add(Term.Natural(1), sp)?
                let a1 = self.add(Term.UAdd(a, one), sp)?
                Term.Lt(zero, a1)
            }
            LtAdd(a, b, c, p) | LtCancel(a, b, c, p) => {
                let forward = match self.term(id) { LtAdd(_, _, _, _) => true, _ => false }
                let u = self.add(Term.U64, sp)?
                for x in [a, b, c] { self.require(x, u, ctx, true, depth - 1)? }
                let ac = self.add(Term.UAdd(a, c), sp)?
                let bc = self.add(Term.UAdd(b, c), sp)?
                let plain = self.add(Term.Lt(a, b), sp)?
                let shifted = self.add(Term.Lt(ac, bc), sp)?
                self.require(p, if forward { plain } else { shifted }, ctx, true, depth - 1)?
                return Ok(if forward { shifted } else { plain })
            }
            LtLe(x, y, z, p, q) => {
                let u = self.add(Term.U64, sp)?
                for v in [x, y, z] { self.require(v, u, ctx, true, depth - 1)? }
                let one = self.add(Term.Natural(1), sp)?
                let z1 = self.add(Term.UAdd(z, one), sp)?
                let first = self.add(Term.Lt(x, y), sp)?
                let second = self.add(Term.Lt(y, z1), sp)?
                self.require(p, first, ctx, true, depth - 1)?
                self.require(q, second, ctx, true, depth - 1)?
                Term.Lt(x, z)
            }
            Fold(n, init, body) => {
                let u = self.add(Term.U64, sp)?
                self.require(n, u, ctx, ghost, depth - 1)?
                let i = self.add(Term.I64, sp)?
                self.require(init, i, ctx, ghost, depth - 1)?
                let ty = self.fold_body_type(n, sp, depth - 1)?
                self.require(body, ty, ctx, ghost, depth - 1)?
                Term.I64
            }
            Transport(family, evidence, proof) => {
                // Restrict equality elimination to propositions. In
                // particular this cannot cast an array's runtime layout.
                let u = self.add(Term.U64, sp)?
                let prop = self.add(Term.Prop, sp)?
                let family_ty = self.add(Term.Pi(false, u, prop), sp)?
                self.require(family, family_ty, ctx, true, depth - 1)?
                let eq_ty = self.infer(evidence, ctx, true, depth - 1)?
                let eq_ty = self.normal(eq_ty, depth - 1)?
                let Eq(a, b) = self.term(eq_ty) else {
                    return Err(self.error(evidence, "transport requires U64 equality evidence"))
                }
                let from = self.add(Term.App(family, a), sp)?
                self.require(proof, from, ctx, true, depth - 1)?
                return self.add(Term.App(family, b), sp)
            }
            Pi(erased, a, b) => {
                let level = self.binder(a, erased, ctx, depth - 1)?
                var inner = Vec(Binding).new()
                for x in ctx { inner.push(x) }
                inner.push(Binding { ty: a, erased })
                let ty = self.infer(b, inner.as_slice(), true, depth - 1)?
                let result = self.sort(ty, depth - 1)?
                if result == -1 { Term.Prop } else { Term.Universe(
                    max(max(level, 0), result) as u32
                ) }
            }
            Lam(erased, a, body) => {
                self.binder(a, erased, ctx, depth - 1)?
                var inner = Vec(Binding).new()
                for x in ctx { inner.push(x) }
                inner.push(Binding { ty: a, erased })
                let result = self.infer(body, inner.as_slice(), ghost, depth - 1)?
                Term.Pi(erased, a, result)
            }
            App(f, a) => {
                let ty = self.infer(f, ctx, ghost, depth - 1)?
                let ty = self.normal(ty, depth - 1)?
                let Pi(erased, domain, result) = self.term(ty) else {
                    return Err(self.error(f, "application needs a dependent function"))
                }
                self.require(a, domain, ctx, ghost || erased, depth - 1)?
                return self.substitute(result, a, depth - 1)
            }
            Elements(xs) => {
                let i = self.add(Term.I64, sp)?
                for x in xs { self.require(x, i, ctx, ghost, depth - 1)? }
                let n = self.add(Term.Natural(xs.len() as u64), sp)?
                Term.Array(n)
            }
            Index(array, index, proof) => {
                let ty = self.infer(array, ctx, ghost, depth - 1)?
                let ty = self.normal(ty, depth - 1)?
                let Array(n) = self.term(ty) else { return Err(self.error(
                    array,
                    "index needs an indexed array"
                )) }
                let u = self.add(Term.U64, sp)?
                self.require(index, u, ctx, ghost, depth - 1)?
                let p = self.add(Term.Lt(index, n), sp)?
                self.require(proof, p, ctx, true, depth - 1)?
                Term.I64
            }
            Decide(a, b) => {
                let u = self.add(Term.U64, sp)?
                self.require(a, u, ctx, true, depth - 1)?
                self.require(b, u, ctx, true, depth - 1)?
                let x = self.normal(a, depth - 1)?
                let y = self.normal(b, depth - 1)?
                let valid = match (self.term(x), self.term(y)) {
                    (Natural(i), Natural(n)) => i < n
                    _ => false
                }
                if !valid { return Err(self.error(id, "decide-lt needs a true closed inequality")) }
                Term.Lt(a, b)
            }
            IfLt(a, b, yes, no) | IfEq(a, b, yes, no) => {
                let equality = match self.term(id) { IfEq(_, _, _, _) => true, _ => false }
                let u = self.add(Term.U64, sp)?
                self.require(a, u, ctx, ghost, depth - 1)?
                self.require(b, u, ctx, ghost, depth - 1)?
                let proposition = if equality { Term.Eq(a, b) } else { Term.Lt(a, b) }
                let p = self.add(proposition, sp)?
                var inner = Vec(Binding).new()
                for x in ctx { inner.push(x) }
                inner.push(Binding { ty: p, erased: true })
                let yes_ty = self.infer(yes, inner.as_slice(), ghost, depth - 1)?
                let yes_ty = self.normal(yes_ty, depth - 1)?
                let result = self.shift(yes_ty, -1, 0, depth - 1)?
                self.require(no, result, ctx, ghost, depth - 1)?
                return Ok(result)
            }
        }
        self.add(ty, sp)
    }

    // Check graph integrity independently of the parser. Definitions are
    // checked in order; no definition can use itself or a later one.
    pub fn check(inout self) -> Result((), diag.Diag) {
        self.steps = 0
        self.signatures = Vec(Vec(Signature)).new()
        if self.nodes.len() > LIMIT { return Err(self.error(0, "term limit reached")) }
        for i in 0..self.nodes.len() {
            for child in children(self.nodes[i].term) {
                if child as i64 >= i { return Err(self.error(
                    i as u32,
                    "cyclic or invalid term graph"
                )) }
            }
        }
        let count = self.definitions.len()
        var f = 0
        for i in 0..count + 1 {
            while f < self.families.len() && self.families[f].globals as i64 == i {
                self.visible = i as u32
                self.visible_families = f as u32
                self.declare(f as u32)?
                f += 1
            }
            if i == count { break }
            self.visible = i as u32
            self.visible_families = f as u32
            let ty = self.definitions[i].ty
            let value = self.definitions[i].value
            let sort = self.infer(ty, [], true, DEPTH)?
            let ghost = self.sort(sort, DEPTH)? == -1
            self.require(value, ty, [], ghost, DEPTH)?
        }
        if f != self.families.len() { return Err(diag.Diag.new(
            self.families[f].span,
            "core: inductive families must follow the definitions they use, in order"
        )) }
        self.visible = count as u32
        self.visible_families = f as u32
        Ok(())
    }
}

pub fn children(term: Term) -> Vec(u32) {
    var out = Vec(u32).new()
    match term {
        Array(n) | Refl(n) => out.push(n)
        Eq(a, b) | Lt(a, b) | App(a, b) | Decide(a, b) | Pi(_, a, b) | Lam(_, a, b) => {
            out.push(a)
            out.push(b)
        }
        Arith(_, a, b) | Strict(a, b) | UAdd(a, b) => { out.push(a); out.push(b) }
        LtAdd(a, b, c, p) | LtCancel(a, b, c, p) => { out.push(a); out.push(b); out.push(c); out.push(
            p
        ) }
        LtLe(a, b, c, p, q) => { out.push(a); out.push(b); out.push(c); out.push(p); out.push(q) }
        USub(a, b, p) => { out.push(a); out.push(b); out.push(p) }
        ZeroLe(a) => out.push(a)
        Index(a, i, p) | Transport(a, i, p) | Fold(a, i, p) => { out.push(a); out.push(i); out.push(
            p
        ) }
        Ind(_, xs) | Con(_, _, xs) | Elements(xs) => for x in xs { out.push(x) }
        Elim(_, p, cases, x) => {
            out.push(p)
            for c in cases { out.push(c) }
            out.push(x)
        }
        IfLt(a, b, y, n) | IfEq(a, b, y, n) => { out.push(a); out.push(b); out.push(
            y
        ); out.push(n) }
        _ => {}
    }
    out
}

#[test]
fn rejects_graphs_without_trusting_the_parser() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    c.add(Term.Array(0), sp).unwrap()
    assert(c.check().is_err(), "self-referential term graph")
    var c = Core.new()
    let u = c.add(Term.U64, sp).unwrap()
    c.definitions.push(Definition { name: "bad".to_string(), ty: u,
        value: 999, exported: false, span: sp })
    assert(c.check().is_err(), "out-of-range definition body")
}

#[test]
fn rejects_false_proofs_without_trusting_the_parser() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let ty = c.add(Term.Lt(one, zero), sp).unwrap()
    let value = c.add(Term.Decide(one, zero), sp).unwrap()
    c.definitions.push(Definition { name: "false".to_string(), ty,
        value, exported: false, span: sp })
    assert(c.check().is_err(), "a false closed proposition has no evidence")
}

#[test]
fn rejects_type_in_type_without_trusting_the_parser() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let universe = c.add(Term.Universe(0), sp).unwrap()
    c.definitions.push(Definition { name: "bad".to_string(), ty: universe,
        value: universe, exported: false, span: sp })
    assert(c.check().is_err(), "Type 0 has type Type 1")
}

#[test]
fn rejects_false_equality_without_trusting_the_parser() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let ty = c.add(Term.Eq(zero, one), sp).unwrap()
    let value = c.add(Term.Refl(zero), sp).unwrap()
    c.definitions.push(Definition { name: "false".to_string(), ty,
        value, exported: false, span: sp })
    assert(c.check().is_err(), "reflexivity cannot prove unequal U64 values")
}

#[test]
fn restricts_transport_to_propositions_without_trusting_the_parser() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let u = c.add(Term.U64, sp).unwrap()
    let var0 = c.add(Term.Var(0), sp).unwrap()
    let family = c.add(Term.Lam(false, u, var0), sp).unwrap()
    let equality = c.add(Term.Refl(zero), sp).unwrap()
    let value = c.add(Term.Transport(family, equality, zero), sp).unwrap()
    c.definitions.push(Definition { name: "bad".to_string(), ty: u,
        value, exported: false, span: sp })
    assert(c.check().is_err(), "transport cannot produce runtime data")
}

#[test]
fn transport_checks_and_computes_reflexivity() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let u = c.add(Term.U64, sp).unwrap()
    let var0 = c.add(Term.Var(0), sp).unwrap()
    let proposition = c.add(Term.Lt(var0, one), sp).unwrap()
    let family = c.add(Term.Lam(false, u, proposition), sp).unwrap()
    let equality = c.add(Term.Refl(zero), sp).unwrap()
    let proof = c.add(Term.Decide(zero, one), sp).unwrap()
    let value = c.add(Term.Transport(family, equality, proof), sp).unwrap()
    let ty = c.add(Term.Lt(zero, one), sp).unwrap()
    c.definitions.push(Definition { name: "valid".to_string(), ty,
        value, exported: false, span: sp })
    c.check().unwrap()
    assert(c.equal(value, proof, DEPTH).unwrap(), "transport over refl reduces to its proof")
}

#[test]
fn rejects_cycles_in_equality_graphs() {
    let sp = diag.Span.nowhere()
    for term in [Term.Eq(0, 0), Term.Refl(0), Term.Transport(0, 0, 0), Term.IfEq(0, 0, 0, 0)] {
        var c = Core.new()
        c.add(term.clone(), sp).unwrap()
        assert(c.check().is_err(), "new equality nodes must obey term graph integrity")
    }
}

fn ids(xs: [u32]) -> Vec(u32) {
    var out = Vec(u32).new()
    for x in xs { out.push(x) }
    out
}

// EqChain(a, b), declared through the raw kernel interface:
// refl(a) : EqChain(a, a) and
// step(a, b, c, erased Eq(a, b), erased EqChain(b, c)) : EqChain(a, c).
fn chain_family(inout c: Core) {
    let sp = diag.Span.nowhere()
    let u = c.add(Term.U64, sp).unwrap()
    let x0 = c.add(Term.Var(0), sp).unwrap()
    let x1 = c.add(Term.Var(1), sp).unwrap()
    let x2 = c.add(Term.Var(2), sp).unwrap()
    let x4 = c.add(Term.Var(4), sp).unwrap()
    let refl = c.add(Term.Ind(0, ids([x0, x0])), sp).unwrap()
    let refl = c.add(Term.Pi(false, u, refl), sp).unwrap()
    var step = c.add(Term.Ind(0, ids([x4, x2])), sp).unwrap()
    let tail = c.add(Term.Ind(0, ids([x2, x1])), sp).unwrap()
    let edge = c.add(Term.Eq(x2, x1), sp).unwrap()
    step = c.add(Term.Pi(true, tail, step), sp).unwrap()
    step = c.add(Term.Pi(true, edge, step), sp).unwrap()
    for _ in 0..3 { step = c.add(Term.Pi(false, u, step), sp).unwrap() }
    var constructors = Vec(Constructor).new()
    constructors.push(Constructor { name: "refl".to_string(), ty: refl })
    constructors.push(Constructor { name: "step".to_string(), ty: step })
    c.families.push(Family { name: "EqChain".to_string(), arity: 2, constructors,
        globals: c.definitions.len() as u32, span: sp })
}

#[test]
fn rejects_false_chain_constructors_without_frontends() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    chain_family(&c)
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let edge = c.add(Term.Refl(zero), sp).unwrap()
    let tail = c.add(Term.Con(0, 0, ids([one])), sp).unwrap()
    let value = c.add(Term.Con(0, 1, ids([zero, one, one, edge, tail])), sp).unwrap()
    let ty = c.add(Term.Ind(0, ids([zero, one])), sp).unwrap()
    c.definitions.push(Definition { name: "bad".to_string(), ty, value, exported: false, span: sp })
    assert(c.check().is_err(), "chain edges must prove their exact endpoints")
}

// A raw, independently constructed case signature for the constant
// proposition Eq 0 0. This bypasses parser/elaboration and case generation.
fn induction_fixture(inout c: Core, bad_step: bool) -> (u32, u32, u32) {
    let sp = diag.Span.nowhere()
    chain_family(&c)
    let u = c.add(Term.U64, sp).unwrap()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let ty = c.add(Term.Eq(zero, zero), sp).unwrap()
    let proof = c.add(Term.Refl(zero), sp).unwrap()
    let wrong = c.add(Term.Refl(one), sp).unwrap()
    let p = c.add(Term.Lam(false, u, ty), sp).unwrap()
    let p = c.add(Term.Lam(false, u, p), sp).unwrap()
    let base = c.add(Term.Lam(false, u, proof), sp).unwrap()
    let x1 = c.add(Term.Var(1), sp).unwrap()
    let x0 = c.add(Term.Var(0), sp).unwrap()
    let x2 = c.add(Term.Var(2), sp).unwrap()
    let edge_ty = c.add(Term.Eq(x2, x1), sp).unwrap()
    let tail_ty = c.add(Term.Ind(0, ids([x2, x1])), sp).unwrap()
    let step = c.add(Term.Lam(true, ty, if bad_step { wrong } else { x0 }), sp).unwrap()
    let step = c.add(Term.Lam(true, tail_ty, step), sp).unwrap()
    let step = c.add(Term.Lam(true, edge_ty, step), sp).unwrap()
    let step = c.add(Term.Lam(false, u, step), sp).unwrap()
    let step = c.add(Term.Lam(false, u, step), sp).unwrap()
    let step = c.add(Term.Lam(false, u, step), sp).unwrap()
    var chain = c.add(Term.Con(0, 0, ids([zero])), sp).unwrap()
    if !bad_step {
        for _ in 0..2 {
            chain = c.add(Term.Con(0, 1, ids([zero, zero, zero, proof, chain])), sp).unwrap()
        }
    }
    let value = c.add(Term.Elim(0, p, ids([base, step]), chain), sp).unwrap()
    (ty, value, proof)
}

#[test]
fn structural_induction_computes_on_the_tail() {
    var c = Core.new()
    let (ty, value, expected) = induction_fixture(&c, false)
    c.definitions.push(Definition { name: "valid".to_string(), ty, value,
        exported: false, span: diag.Span.nowhere() })
    c.check().unwrap()
    let normal = c.normal(value, DEPTH).unwrap()
    c.require(normal, ty, [], true, DEPTH).unwrap()
    assert(
        c.equal(normal, expected, DEPTH).unwrap(),
        "two induction steps compute the recursive hypothesis"
    )
}

#[test]
fn induction_checks_unused_step_without_frontends() {
    var c = Core.new()
    let (ty, value, _) = induction_fixture(&c, true)
    c.definitions.push(Definition { name: "bad".to_string(), ty, value,
        exported: false, span: diag.Span.nowhere() })
    assert(c.check().is_err(), "a reflexive chain cannot hide an invalid step")
}

#[test]
fn induction_requires_every_case_without_frontends() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let (ty, value, _) = induction_fixture(&c, false)
    let Elim(f, p, cases, x) = c.term(value) else { panic("fixture") }
    let value = c.add(Term.Elim(f, p, ids([cases[0]]), x), sp).unwrap()
    c.definitions.push(Definition { name: "bad".to_string(), ty, value, exported: false, span: sp })
    assert(c.check().is_err(), "a missing step case is rejected")
}

#[test]
fn rejects_cycles_in_inductive_graphs() {
    let sp = diag.Span.nowhere()
    for term in [
        Term.Ind(0, ids([1])),
        Term.Con(0, 0, ids([0, 1])),
        Term.Elim(0, 1, Vec(u32).new(), 0),
        Term.Elim(0, 0, ids([1]), 0),
        Term.Elim(0, 0, Vec(u32).new(), 1)
    ] {
        var c = Core.new()
        c.add(Term.U64, sp).unwrap()
        c.add(term.clone(), sp).unwrap()
        assert(c.check().is_err(), "inductive terms obey the same graph integrity checks")
    }
}

// One family F(i) with a single constructor of the given type.
fn single(inout c: Core, ty: u32) {
    var constructors = Vec(Constructor).new()
    constructors.push(Constructor { name: "make".to_string(), ty })
    c.families.push(Family { name: "F".to_string(), arity: 1, constructors,
        globals: c.definitions.len() as u32, span: diag.Span.nowhere() })
}

#[test]
fn rejects_non_positive_and_relevant_fields() {
    let sp = diag.Span.nowhere()
    // make(erased h : F(0) -> Lt(0, 1)) : F(0) is not strictly positive.
    var c = Core.new()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let f0 = c.add(Term.Ind(0, ids([zero])), sp).unwrap()
    let lt = c.add(Term.Lt(zero, one), sp).unwrap()
    let negative = c.add(Term.Pi(true, f0, lt), sp).unwrap()
    let ty = c.add(Term.Pi(true, negative, f0), sp).unwrap()
    single(&c, ty)
    assert(c.check().is_err(), "a family under an arrow is rejected")
    // make(x : I64) : F(0) has runtime data other than indices.
    var c = Core.new()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let i = c.add(Term.I64, sp).unwrap()
    let f0 = c.add(Term.Ind(0, ids([zero])), sp).unwrap()
    let ty = c.add(Term.Pi(false, i, f0), sp).unwrap()
    single(&c, ty)
    assert(c.check().is_err(), "constructor data fields are U64")
    // make(h : F(0)) : F(0), recursive but not erased.
    var c = Core.new()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let f0 = c.add(Term.Ind(0, ids([zero])), sp).unwrap()
    let ty = c.add(Term.Pi(false, f0, f0), sp).unwrap()
    single(&c, ty)
    assert(c.check().is_err(), "recursive fields are erased")
    // make : Lt(0, 1) produces another proposition.
    var c = Core.new()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let lt = c.add(Term.Lt(zero, one), sp).unwrap()
    single(&c, lt)
    assert(c.check().is_err(), "a constructor produces its own family")
    // make : F(0, 0) has the wrong number of indices.
    var c = Core.new()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let f00 = c.add(Term.Ind(0, ids([zero, zero])), sp).unwrap()
    single(&c, f00)
    assert(c.check().is_err(), "family arity is checked")
}

#[test]
fn families_are_ordered_with_definitions() {
    let sp = diag.Span.nowhere()
    // A definition before the family's declaration cannot use it.
    var c = Core.new()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let f0 = c.add(Term.Ind(0, ids([zero])), sp).unwrap()
    let value = c.add(Term.Con(0, 0, Vec(u32).new()), sp).unwrap()
    c.definitions.push(Definition { name: "early".to_string(), ty: f0, value,
        exported: false, span: sp })
    var constructors = Vec(Constructor).new()
    constructors.push(Constructor { name: "make".to_string(), ty: f0 })
    c.families.push(Family { name: "F".to_string(), arity: 1, constructors, globals: 1, span: sp })
    assert(c.check().is_err(), "families are not visible to earlier definitions")
    c.families[0].globals = 0
    c.check().unwrap()
    c.families[0].globals = 2
    assert(c.check().is_err(), "a family after every definition is still in range")
}

#[test]
fn induction_eliminates_only_into_propositions() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let u = c.add(Term.U64, sp).unwrap()
    let f0 = c.add(Term.Ind(0, ids([zero])), sp).unwrap()
    single(&c, f0)
    let motive = c.add(Term.Lam(false, u, u), sp).unwrap()
    let evidence = c.add(Term.Con(0, 0, Vec(u32).new()), sp).unwrap()
    let value = c.add(Term.Elim(0, motive, ids([zero]), evidence), sp).unwrap()
    c.definitions.push(Definition {
        name: "bad".to_string(),
        ty: u,
        value,
        exported: false,
        span: sp
    })
    assert(c.check().is_err(), "a data motive is rejected")
}

#[test]
fn overflowing_arithmetic_is_not_folded() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let max = c.add(Term.Integer(9223372036854775807), sp).unwrap()
    let one = c.add(Term.Integer(1), sp).unwrap()
    let two = c.add(Term.Integer(2), sp).unwrap()
    let over = c.add(Term.Arith(Arith.Add, max, one), sp).unwrap()
    let normal = c.normal(over, DEPTH).unwrap()
    assert(c.term(normal) != Term.Integer(-9223372036854775807 - 1), "no wrapping")
    let sum = c.add(Term.Arith(Arith.Mul, two, two), sp).unwrap()
    let normal = c.normal(sum, DEPTH).unwrap()
    assert(c.term(normal) == Term.Integer(4), "closed arithmetic computes")
}

// fold(3, 0, fn(i, erased p : Lt(i, bound), acc) { load [1, 2, 3] at i }).
fn loop_fixture(inout c: Core, bound: u64, erased: bool) -> u32 {
    let sp = diag.Span.nowhere()
    let u = c.add(Term.U64, sp).unwrap()
    let i = c.add(Term.I64, sp).unwrap()
    let three = c.add(Term.Natural(3), sp).unwrap()
    let b = c.add(Term.Natural(bound), sp).unwrap()
    let zero = c.add(Term.Integer(0), sp).unwrap()
    var xs = Vec(u32).new()
    for v in [1, 2, 3] { xs.push(c.add(Term.Integer(v), sp).unwrap()) }
    let array = c.add(Term.Elements(xs), sp).unwrap()
    let x0 = c.add(Term.Var(0), sp).unwrap()
    let x1 = c.add(Term.Var(1), sp).unwrap()
    let x2 = c.add(Term.Var(2), sp).unwrap()
    let load = c.add(Term.Index(array, x2, x1), sp).unwrap()
    let body = c.add(Term.Arith(Arith.Add, x0, load), sp).unwrap()
    let lt = c.add(Term.Lt(x0, b), sp).unwrap()
    let body = c.add(Term.Lam(false, i, body), sp).unwrap()
    let body = c.add(Term.Lam(erased, lt, body), sp).unwrap()
    let body = c.add(Term.Lam(false, u, body), sp).unwrap()
    let value = c.add(Term.Fold(three, zero, body), sp).unwrap()
    c.definitions.push(Definition {
        name: "loop".to_string(),
        ty: i,
        value,
        exported: false,
        span: sp
    })
    value
}

#[test]
fn loop_bodies_have_exactly_their_bound() {
    var c = Core.new()
    loop_fixture(&c, 3, true)
    c.check().unwrap()
    var c = Core.new()
    loop_fixture(&c, 4, true)
    assert(c.check().is_err(), "a bound above the array length is rejected")
    var c = Core.new()
    loop_fixture(&c, 3, false)
    assert(c.check().is_err(), "the bound is erased evidence")
}

#[test]
fn loops_are_not_unrolled() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let value = loop_fixture(&c, 3, true)
    c.check().unwrap()
    let normal = c.normal(value, DEPTH).unwrap()
    let Fold(_, _, _) = c.term(normal) else { panic("a loop stays a loop") }
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let init = c.add(Term.Integer(5), sp).unwrap()
    let Fold(_, _, body) = c.term(value) else { panic("fixture") }
    let empty = c.add(Term.Fold(zero, init, body), sp).unwrap()
    let normal = c.normal(empty, DEPTH).unwrap()
    assert(c.term(normal) == Term.Integer(5), "an empty loop is its initial value")
}

#[test]
fn rejects_cycles_in_loop_graphs() {
    let sp = diag.Span.nowhere()
    for term in [Term.Arith(Arith.Add, 0, 1), Term.Fold(0, 0, 1)] {
        var c = Core.new()
        c.add(Term.I64, sp).unwrap()
        c.add(term.clone(), sp).unwrap()
        assert(c.check().is_err(), "loop terms obey graph integrity")
    }
}

#[test]
fn substitution_keeps_overflow_traps() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let i = c.add(Term.I64, sp).unwrap()
    let max = c.add(Term.Integer(9223372036854775807), sp).unwrap()
    let one = c.add(Term.Integer(1), sp).unwrap()
    let seven = c.add(Term.Integer(7), sp).unwrap()
    let over = c.add(Term.Arith(Arith.Add, max, one), sp).unwrap()
    let ignore = c.add(Term.Lam(false, i, seven), sp).unwrap()
    let dropped = c.add(Term.App(ignore, over), sp).unwrap()
    let normal = c.normal(dropped, DEPTH).unwrap()
    let Strict(_, rest) = c.term(normal) else { panic("an unused trapping argument is kept") }
    assert(c.term(rest) == Term.Integer(7), "after it, the body")
    let safe = c.add(Term.App(ignore, one), sp).unwrap()
    let normal = c.normal(safe, DEPTH).unwrap()
    assert(c.term(normal) == Term.Integer(7), "an argument that cannot trap is dropped")
}

#[test]
fn sums_are_compared_in_the_naturals() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let x = c.add(Term.Var(0), sp).unwrap()
    let y = c.add(Term.Var(1), sp).unwrap()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let two = c.add(Term.Natural(2), sp).unwrap()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let max = c.add(Term.Natural(0xffffffffffffffff), sp).unwrap()
    // ((x + 1) + y) + 1 and (2 + y) + x
    let a = c.add(Term.UAdd(x, one), sp).unwrap()
    let a = c.add(Term.UAdd(a, y), sp).unwrap()
    let a = c.add(Term.UAdd(a, one), sp).unwrap()
    let b = c.add(Term.UAdd(two, y), sp).unwrap()
    let b = c.add(Term.UAdd(b, x), sp).unwrap()
    assert(c.equal(a, b, DEPTH).unwrap(), "associativity, commutativity and constants")
    let x0 = c.add(Term.UAdd(x, zero), sp).unwrap()
    assert(c.equal(x0, x, DEPTH).unwrap(), "adding zero")
    let three = c.add(Term.Natural(3), sp).unwrap()
    let closed = c.add(Term.UAdd(one, two), sp).unwrap()
    assert(c.equal(closed, three, DEPTH).unwrap(), "closed sums compute")
    let over = c.add(Term.UAdd(max, one), sp).unwrap()
    assert(!c.equal(over, zero, DEPTH).unwrap(), "no wrapping")
    let ty = c.add(Term.Eq(over, zero), sp).unwrap()
    let value = c.add(Term.Refl(zero), sp).unwrap()
    c.definitions.push(Definition {
        name: "wrap".to_string(),
        ty,
        value,
        exported: false,
        span: sp
    })
    assert(c.check().is_err(), "2^64 is not 0 in the naturals")
}

#[test]
fn order_rules_need_their_exact_premises() {
    let sp = diag.Span.nowhere()
    let rules = [0, 1, 2, 3]
    for rule in rules {
        var c = Core.new()
        let zero = c.add(Term.Natural(0), sp).unwrap()
        let one = c.add(Term.Natural(1), sp).unwrap()
        let lt01 = c.add(Term.Decide(zero, one), sp).unwrap()
        let lt11 = c.add(Term.Decide(one, one), sp).unwrap()
        // Each claims Lt(1, 0) or another false inequality.
        let (ty, value) = match rule {
            0 => (Term.Lt(one, zero), Term.LtLe(zero, one, zero, lt01, lt11))
            1 => (Term.Lt(one, one), Term.LtAdd(one, zero, one, lt01))
            2 => (Term.Lt(one, zero), Term.LtCancel(one, zero, one, lt01))
            _ => (Term.Lt(one, zero), Term.LtLe(one, zero, zero, lt01, lt01))
        }
        let ty = c.add(ty, sp).unwrap()
        let value = c.add(value, sp).unwrap()
        c.definitions.push(Definition {
            name: "bad".to_string(),
            ty,
            value,
            exported: false,
            span: sp
        })
        assert(c.check().is_err(), "an order rule with wrong premises is rejected")
    }
    // x < y <= z gives x < z: 0 < 1 <= 1.
    var c = Core.new()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let two = c.add(Term.Natural(2), sp).unwrap()
    let lt01 = c.add(Term.Decide(zero, one), sp).unwrap()
    let lt12 = c.add(Term.Decide(one, two), sp).unwrap()
    let value = c.add(Term.LtLe(zero, one, one, lt01, lt12), sp).unwrap()
    let ty = c.add(Term.Lt(zero, one), sp).unwrap()
    c.definitions.push(Definition {
        name: "good".to_string(),
        ty,
        value,
        exported: false,
        span: sp
    })
    c.check().unwrap()
}

#[test]
fn rejects_cycles_in_order_graphs() {
    let sp = diag.Span.nowhere()
    for term in [
        Term.UAdd(0, 1),
        Term.LtAdd(0, 0, 0, 1),
        Term.LtCancel(1, 0, 0, 0),
        Term.LtLe(0, 0, 0, 0, 1)
    ] {
        var c = Core.new()
        c.add(Term.U64, sp).unwrap()
        c.add(term.clone(), sp).unwrap()
        assert(c.check().is_err(), "order terms obey graph integrity")
    }
}

#[test]
fn subtraction_cancels_in_the_naturals() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let k = c.add(Term.Var(0), sp).unwrap()
    let m = c.add(Term.Var(1), sp).unwrap()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let two = c.add(Term.Natural(2), sp).unwrap()
    let p = c.add(Term.Var(2), sp).unwrap()
    let q = c.add(Term.Var(3), sp).unwrap()
    // (k - 1) + 1 is k; (k + 2) - 1 is k + 1; (k - 1) + m is not k + m - 1.
    let pred = c.add(Term.USub(k, one, p), sp).unwrap()
    let back = c.add(Term.UAdd(pred, one), sp).unwrap()
    assert(c.equal(back, k, DEPTH).unwrap(), "(k - 1) + 1 is k")
    let k2 = c.add(Term.UAdd(k, two), sp).unwrap()
    let k1 = c.add(Term.UAdd(k, one), sp).unwrap()
    let less = c.add(Term.USub(k2, one, p), sp).unwrap()
    assert(c.equal(less, k1, DEPTH).unwrap(), "(k + 2) - 1 is k + 1")
    let other = c.add(Term.UAdd(pred, m), sp).unwrap()
    assert(!c.equal(other, k, DEPTH).unwrap(), "no cancellation without the subtrahend")
    let again = c.add(Term.USub(k, one, q), sp).unwrap()
    assert(c.equal(pred, again, DEPTH).unwrap(), "evidence is irrelevant")
    let three = c.add(Term.Natural(3), sp).unwrap()
    let closed = c.add(Term.USub(three, two, p), sp).unwrap()
    assert(c.equal(closed, one, DEPTH).unwrap(), "closed subtraction computes")
}

#[test]
fn subtraction_needs_evidence_of_its_bound() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let two = c.add(Term.Natural(2), sp).unwrap()
    let u = c.add(Term.U64, sp).unwrap()
    // 0 - 1 with evidence of Lt(0, 1) instead of Lt(1, 0 + 1).
    let wrong = c.add(Term.Decide(zero, one), sp).unwrap()
    let value = c.add(Term.USub(zero, one, wrong), sp).unwrap()
    c.definitions.push(Definition {
        name: "bad".to_string(),
        ty: u,
        value,
        exported: false,
        span: sp
    })
    assert(c.check().is_err(), "0 - 1 has no evidence")
    var c = Core.new()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let two = c.add(Term.Natural(2), sp).unwrap()
    let u = c.add(Term.U64, sp).unwrap()
    let ok = c.add(Term.Decide(one, two), sp).unwrap()
    let value = c.add(Term.USub(one, one, ok), sp).unwrap()
    c.definitions.push(Definition {
        name: "good".to_string(),
        ty: u,
        value,
        exported: false,
        span: sp
    })
    c.check().unwrap()
    assert(c.equal(value, zero, DEPTH).unwrap(), "1 - 1 is 0")
}

#[test]
fn zero_is_least() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let one = c.add(Term.Natural(1), sp).unwrap()
    let zero = c.add(Term.Natural(0), sp).unwrap()
    let value = c.add(Term.ZeroLe(zero), sp).unwrap()
    let ty = c.add(Term.Lt(zero, one), sp).unwrap()
    c.definitions.push(Definition { name: "z".to_string(), ty, value, exported: false, span: sp })
    c.check().unwrap()
    for term in [Term.USub(0, 0, 1), Term.ZeroLe(0)] {
        var c = Core.new()
        c.add(term.clone(), sp).unwrap()
        assert(c.check().is_err(), "subtraction terms obey graph integrity")
    }
}

#[test]
fn cancellation_keeps_the_evaluation_it_removes() {
    let sp = diag.Span.nowhere()
    var c = Core.new()
    let k = c.add(Term.Var(0), sp).unwrap()
    let p = c.add(Term.Var(1), sp).unwrap()
    let one = c.add(Term.Natural(1), sp).unwrap()
    // (k + 1) - 1 is k, but k + 1 can overflow: it is still evaluated.
    let k1 = c.add(Term.UAdd(k, one), sp).unwrap()
    let value = c.add(Term.USub(k1, one, p), sp).unwrap()
    let normal = c.normal(value, DEPTH).unwrap()
    let Strict(first, rest) = c.term(normal) else { panic("the cancelled sum is kept") }
    assert(c.equal(first, k1, DEPTH).unwrap() && c.term(rest) == Term.Var(0), "then k")
    assert(c.equal(normal, k, DEPTH).unwrap(), "and it is k")
    // (k - 1) + 1 removes only the literal 1, which cannot trap.
    let pred = c.add(Term.USub(k, one, p), sp).unwrap()
    let back = c.add(Term.UAdd(pred, one), sp).unwrap()
    let normal = c.normal(back, DEPTH).unwrap()
    assert(c.term(normal) == Term.Var(0), "nothing to keep")
}
