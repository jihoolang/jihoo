// The machines jihoo compiles for, and what a program runs on there.

import host

pub enum Target {
    X86_64
    Aarch64
}

impl Target {
    // The machine this compiler was built for: `host.<target>.jh` says.
    pub fn host() -> Target {
        Target.parse(host.NAME).unwrap()
    }

    pub fn parse(s: str) -> Option(Target) {
        if s == "x86_64" || s == "x86_64-linux" {
            Some(Target.X86_64)
        } else if s == "aarch64" || s == "aarch64-linux" || s == "arm64" {
            Some(Target.Aarch64)
        } else {
            None
        }
    }

    pub fn name(self) -> str {
        match self {
            X86_64 => "x86_64"
            Aarch64 => "aarch64"
        }
    }

    pub fn triple(self) -> str {
        match self {
            X86_64 => "x86_64-unknown-linux-gnu"
            Aarch64 => "aarch64-unknown-linux-gnu"
        }
    }

    // The LLVM triple of a program of `profile`: UEFI applications are
    // PE/COFF images with the Windows calling convention.
    pub fn triple_in(self, profile: Profile) -> str {
        match profile {
            Uefi => match self {
                X86_64 => "x86_64-unknown-windows"
                Aarch64 => "aarch64-unknown-windows"
            }
            _ => self.triple()
        }
    }
}

// What a program runs on, chosen by its root file's attributes: Linux with
// the C library, Linux through system calls (`#![freestanding]`), or UEFI
// firmware (`#![uefi]`).
pub enum Profile {
    Native
    Freestanding
    Uefi
}

impl Profile {
    // The attribute that selects a profile, which is also the suffix of its
    // files (`std/sys.uefi.jh`).
    pub fn parse(s: str) -> Option(Profile) {
        if s == "freestanding" {
            Some(Profile.Freestanding)
        } else if s == "uefi" {
            Some(Profile.Uefi)
        } else {
            None
        }
    }

    pub fn name(self) -> str {
        match self {
            Native => "native"
            Freestanding => "freestanding"
            Uefi => "uefi"
        }
    }

    // Without the C library: the compiler writes the entry point and the
    // memory functions.
    pub fn bare(self) -> bool {
        match self {
            Native => false
            _ => true
        }
    }
}

// Code generation for a kernel, beyond what the target's Linux ABI allows
// by default: no red zone (`-mno-red-zone`), since an interrupt on the same
// stack writes below the stack pointer, and only general registers
// (`-mgeneral-regs-only`), for code that runs where the floating-point and
// vector registers are neither enabled nor saved. Each is an attribute of
// every function the compiler writes.
pub struct Codegen {
    pub no_red_zone: bool
    pub general_regs_only: bool
}

impl Codegen {
    pub fn default() -> Codegen {
        Codegen { no_red_zone: false, general_regs_only: false }
    }

    // The LLVM function attributes, or "" for the Linux ABI's defaults.
    pub fn attributes(self, t: Target) -> String {
        var a = String.new()
        if self.no_red_zone { a.push_str("noredzone") }
        if self.general_regs_only {
            if a.len() > 0 { a.push(' ') }
            // What Rust's x86_64-unknown-none and aarch64-unknown-none-softfloat
            // turn off. Programs have no floats here (sema rejects them), so
            // soft-float only keeps x87 out.
            a.push_str(match t {
                X86_64 => "\"target-features\"=\"-mmx,-sse,-sse2,-sse3,-ssse3,-sse4.1,-sse4.2,-avx,-avx2,-avx512f,+soft-float\""
                Aarch64 => "\"target-features\"=\"-neon,-fp-armv8\""
            })
        }
        a
    }
}
