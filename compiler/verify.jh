// Verification (docs/internals/verification.md): each function's checks
// and contracts as obligations (`vc.jh`, from `obligations.jh`'s model),
// proved by an untrusted prover (`fm.jh`, invariants from `infer.jh`) and
// accepted only when the trusted checker (`linear.jh`) accepts. A check
// counts as proved only when everything its proof assumed is proved too:
// the function's cut points, the `requires` it was proved under, and the
// `ensures` of the functions it calls. Proved checks can then be removed.

import std.env
import std.io
import std.mem
import std.sort
import std.thread
import diag
import fm
import forms
import infer
import lex
import linear
import mir
import obligations
import timing
import vc

// A check in MIR: an `assert` terminator (`stmt` -1) or an overflow check.
pub struct Check {
    pub function: u32
    pub block: i64
    pub stmt: i64
    pub what: String
    pub span: diag.Span
    // Every obligation of the check was proved.
    pub proved: bool
    // Where the values of an unproved claim come from (`vc.why_code`s).
    pub depends: Vec(i64)
    // For a call that proves a callee's panics away, the callee: once
    // proved, the call goes to a copy without them. -1 otherwise.
    pub retarget: i64
    // CHECK, PANIC or CALL.
    pub kind: i64
}

// What a check is: a bounds or overflow check, a call that never returns
// (or a trap), or a call that may reach a callee's panic.
pub const CHECK: i64 = 0
pub const PANIC: i64 = 1
pub const CALL: i64 = 2

pub struct Report {
    pub checks: Vec(Check)
    // Per function, the sites of its calls that never return which calls
    // may prove away, and that it does not prove itself.
    pub lifted: Vec(Vec(vc.Site))
    // Per function: its `ensures` is proved, and so is all it rests on.
    pub ensures: Vec(bool)
    // Per function, the contract clauses that are not proved, and why.
    pub contract_errors: Vec(Vec((diag.Span, String)))
    pub functions: i64
    pub incomplete: i64
}

impl Report {
    pub fn proved(self) -> i64 {
        var n = 0
        for c in self.checks {
            if c.proved { n += 1 }
        }
        n
    }

    // The checks of a kind, and how many are proved.
    pub fn count(self, kind: i64) -> (i64, i64) {
        var all = 0
        var proved = 0
        for c in self.checks {
            if c.kind == kind {
                all += 1
                if c.proved { proved += 1 }
            }
        }
        (proved, all)
    }
}

// One obligation, proved or not.
struct Result1 {
    proved: bool
    source: vc.Source
    // Where the claim's values come from (`vc.why_code`s).
    depends: Vec(i64)
    // What the facts its certificate uses rest on.
    used: Vec(vc.Tag)
    // The check's span, `vc.nowhere()` for a contract's clauses.
    at: (i64, i64)
}

// What one function's obligations came to.
struct Outcome {
    // Generation followed every path.
    whole: bool
    results: Vec(Result1)
    // The cut points, of which the invariants the source states come first.
    cuts: i64
    written: i64
    // The functions it calls directly, whether or not a path reached them.
    callees: Vec(i64)
    // The types with an invariant it is a writer of.
    writes: Vec(i64)
}

fn prove_all(f: vc.Function, contracts: [Option(vc.Callee)], lifts: [Option(vc.Lift)]) -> Outcome {
    let obs = vc.generate(f, contracts, lifts, vc.PROVE, Vec(Vec(bool)).new())
    var results = Vec(Result1).new()
    for o in obs.list {
        results.push(Result1 {
            proved: o.proved,
            source: copy_source(o.source),
            depends: o.depends.clone(),
            used: o.used.clone(),
            at: o.at
        })
    }
    var callees = Vec(i64).new()
    for b in f.blocks {
        match b.term {
            Call(_, _, site) => if site.callee >= 0 { callees.push(site.callee) }
            _ => {}
        }
    }
    Outcome {
        whole: obs.errors.len() == 0, results, cuts: f.invariants.len(), written: 0, callees,
        writes: f.writes.clone()
    }
}

// What the program's assumptions came to: per function, its `requires`
// (proved by every call), its `ensures` and each cut point's facts.
struct Assumptions {
    requires: Vec(bool)
    ensures: Vec(bool)
    cuts: Vec(Vec(bool))
    // The types whose invariant some writer does not prove.
    broken: Vec(i64)
}

impl Assumptions {
    fn holds(self, ty: i64) -> bool {
        for t in self.broken {
            if t == ty { return false }
        }
        true
    }

    // Whether the type's invariant was taken to hold until now.
    fn break_type(inout self, ty: i64) -> bool {
        if !self.holds(ty) { return false }
        self.broken.push(ty)
        true
    }
}

// The obligation is proved, and so is everything its proof rests on.
fn valid(a: Assumptions, f: i64, o: Outcome, r: Result1) -> bool {
    if !r.proved || !o.whole { return false }
    for t in r.used {
        let ok = match t {
            Path => true
            Requires => a.requires[f]
            Cut(k) => a.cuts[f][k]
            Ensures(g) => a.ensures[g]
            TypeInvariant(ty) => a.holds(ty)
        }
        if !ok { return false }
    }
    true
}

// What the message of a clause proved under an unproved assumption adds.
const RESTS: str = ": it rests on "

// The message of a contract error in the function `name`.
fn message(msg: str, name: str) -> String {
    match msg.find(RESTS) {
        Some(k) => msg[..k] + " in " + name + msg[k..]
        None => msg + " in " + name
    }
}

// What a proved obligation rests on that is not proved, for its message.
fn rests_on(p: mir.Program, a: Assumptions, f: i64, r: Result1) -> String {
    for t in r.used {
        match t {
            Requires => if !a.requires[f] {
                return ": it rests on this function's `requires`, which some call does not meet".to_string()
            }
            Cut(k) => if !a.cuts[f][k] {
                return ": it rests on a loop's invariant that is not proved".to_string()
            }
            Ensures(g) => if !a.ensures[g] {
                return ": it rests on the unproved `ensures` of " + p.fns[g].name.as_str()
            }
            TypeInvariant(ty) => if !a.holds(ty) {
                return ": it rests on the invariant of `" + p.types.show(ty as u32).as_str() +
                    "`, which some writer does not prove"
            }
            Path => {}
        }
    }
    ": it rests on what is not proved".to_string()
}

fn copy_source(s: vc.Source) -> vc.Source {
    match s {
        Check(x) => vc.Source.Check(x)
        Requires(b, f) => vc.Source.Requires(b, f)
        Invariant(i, j) => vc.Source.Invariant(i, j)
        Ensures(j) => vc.Source.Ensures(j)
        Lift(b, f, s) => vc.Source.Lift(b, f, s)
        TypeInvariant(t) => vc.Source.TypeInvariant(t)
    }
}

// Generates and proves, with inferred invariants at loop heads, and cut
// points where too many paths would meet.
fn outcome(
    sink f: vc.Function,
    contracts: [Option(vc.Callee)],
    lifts: [Option(vc.Lift)]
) -> Outcome {
    var g = f
    let written = g.invariants.len()
    let heads = infer.loop_heads(g)
    infer.cut(&g, heads.as_slice())
    let more = infer.bounded(g, heads.as_slice())
    infer.cut(&g, more.as_slice())
    infer.infer(&g, heads.as_slice(), more.as_slice(), contracts)
    var o = prove_all(g, contracts, lifts)
    o.written = written
    o
}

// The functions that may be called other than by a direct call the
// program verifies: exported ones, the entry, those whose address is
// taken (`fnptr` values, `dyn` tables) and destructors.
fn escaping(p: mir.Program) -> Vec(bool) {
    var out = Vec(bool).filled(p.fns.len(), false)
    for i, f in p.fns {
        match f.linkage {
            Internal => {}
            _ => out[i] = true
        }
    }
    match p.entry {
        Some(e) => out[e as i64] = true
        None => {}
    }
    match p.panic_handler {
        Some(e) => out[e as i64] = true
        None => {}
    }
    for st in p.statics { const_fns(st.value, &out) }
    // Drop glue calls the `drop` of each type that has one.
    for k in p.drop_impls.keys() { out[p.drop_impls[k] as i64] = true }
    for f in p.fns {
        let Some(b) = f.body else { continue }
        for bl in b.blocks {
            for st in bl.stmts {
                match st {
                    Assign(_, rv, _) => rvalue_fns(rv, &out)
                    _ => {}
                }
            }
            match bl.term {
                Switch(o, _, _) | Assert(o, _, _, _) => operand_fns(o, &out)
                Call(callee, args, _, _, _) => {
                    match callee {
                        Ptr(o) | Closure(o) => operand_fns(o, &out)
                        _ => {}
                    }
                    for a in args { operand_fns(a, &out) }
                }
                _ => {}
            }
        }
    }
    out
}

fn const_fns(c: mir.Const, inout out: Vec(bool)) {
    match c {
        Fn(f) => out[f as i64] = true
        Vtable(fs) => {
            for f in fs { out[f as i64] = true }
        }
        _ => {}
    }
}

fn operand_fns(o: mir.Operand, inout out: Vec(bool)) {
    match o {
        Const(c) => const_fns(c, &out)
        _ => {}
    }
}

fn rvalue_fns(rv: mir.Rvalue, inout out: Vec(bool)) {
    match rv {
        Use(o) | Un(_, o) | Cast(o, _, _) | Repeat(o, _) => operand_fns(o, &out)
        Bin(_, x, y) | Offset(x, y) => {
            operand_fns(x, &out)
            operand_fns(y, &out)
        }
        Aggregate(_, os) => {
            for o in os { operand_fns(o, &out) }
        }
        _ => {}
    }
}

// Every obligation of the check at the site is proved, and there is one.
fn site_valid(a: Assumptions, f: i64, o: Outcome, s: vc.Site) -> bool {
    var any = false
    for r in o.results {
        match r.source {
            Check(x) => if x.0 == s.0 && x.1 == s.1 {
                any = true
                if !valid(a, f, o, r) { return false }
            }
            _ => {}
        }
    }
    any
}

// What a lifted panic is: the message the callee panics with, `trap`, or
// the function it calls.
fn panic_what(p: mir.Program, g: i64, s: vc.Site) -> String {
    let Some(b) = p.fns[g].body else { return "panic".to_string() }
    match b.blocks[s.0].term {
        Call(callee, args, _, _, _) => {
            if args.len() > 0 {
                match args[0] {
                    Const(c) => match c {
                        Str(m) => return m.clone()
                        _ => {}
                    }
                    _ => {}
                }
            }
            match callee {
                Fn(h) => p.fns[h as i64].name.clone()
                Intrinsic(_) => "trap".to_string()
                _ => "panic".to_string()
            }
        }
        _ => "panic".to_string()
    }
}

fn site_span(b: mir.Body, block: i64, stmt: i64) -> diag.Span {
    let bl = b.blocks[block]
    if stmt < 0 {
        return match bl.term {
            Assert(_, _, _, span) | Call(_, _, _, _, span) => span
            _ => diag.Span.nowhere()
        }
    }
    match bl.stmts[stmt] {
        Assign(_, _, span) => span
        _ => diag.Span.nowhere()
    }
}

fn site_what(p: mir.Program, b: mir.Body, block: i64, stmt: i64) -> String {
    if stmt < 0 {
        return match b.blocks[block].term {
            Assert(_, msg, _, _) => msg.clone()
            // A call that never returns, which must be unreachable.
            Call(callee, _, _, _, _) => match callee {
                Fn(f) => p.fns[f as i64].name.clone()
                Intrinsic(_) => "trap".to_string()
                _ => "call".to_string()
            }
            _ => "check".to_string()
        }
    }
    "integer overflow".to_string()
}

// The checks in MIR that the model states: every `assert`, and every
// checked `+ - *` whose result the model follows.
fn sites(p: mir.Program, f: vc.Function) -> Vec((i64, i64)) {
    var out = Vec((i64, i64)).new()
    for i, b in f.blocks {
        for s in b.stmts {
            match s {
                Assign(_, rv, at, site) => match rv {
                    Add(_, _) | Sub(_, _) | Mul(_, _) => if at.0 >= 0 { out.push(site) }
                    _ => {}
                }
                Check(_, _) => {}
            }
        }
        match b.term {
            Assert(_, _, _, _) | Trap(_) => out.push((i, -1))
            Call(_, _, site) => if site.never { out.push((i, -1)) }
            _ => {}
        }
    }
    out
}

// One function to prove, on whichever thread takes it.
struct Job {
    index: i64
    cost: i64
    model: Option(vc.Function)
    outcome: Option(Outcome)
    ms: i64
}

// About how long a function's proofs take: its statements times its
// variables, enough to start the largest first.
fn job_cost(f: vc.Function) -> i64 {
    var stmts = 0
    for b in f.blocks { stmts +%= b.stmts.len() + 1 }
    stmts *% f.kinds.len()
}

pub fn verify(p: mir.Program) -> Report {
    let n = p.fns.len()
    let trace = env.get("JIHOO_VERIFY_TRACE").is_some()
    var models = Vec(Option(vc.Function)).new()
    var contracts = Vec(Option(vc.Callee)).new()
    let ifaces = obligations.interfaces(p)
    for f in p.fns {
        let m = obligations.model_of(p, f, ifaces.as_slice())
        match &m {
            Some(x) => {
                if x.callee.requires.len() > 0 || x.callee.ensures.len() > 0 {
                    contracts.push(Some(x.callee.clone()))
                } else { contracts.push(None) }
            }
            None => contracts.push(None)
        }
        models.push(m)
    }
    // What calls need to prove a small function's panics away: its paths
    // to them from its entry, with cut points at its loops.
    var lifts = Vec(Option(vc.Lift)).new()
    for i in 0..n {
        var lift: Option(vc.Lift) = None
        match models[i] {
            Some(f) => if f.liftable {
                var g = obligations.model_of(p, p.fns[i], ifaces.as_slice()).unwrap()
                let heads = infer.loop_heads(g)
                infer.cut(&g, heads.as_slice())
                let more = infer.bounded(g, heads.as_slice())
                infer.cut(&g, more.as_slice())
                lift = vc.generate(
                    g,
                    contracts.as_slice(),
                    Vec(Option(vc.Lift)).new().as_slice(),
                    vc.LIFT,
                    Vec(Vec(bool)).new()
                ).lift
            }
            None => {}
        }
        lifts.push(lift)
    }
    var report = Report {
        checks: Vec(Check).new(),
        lifted: Vec(Vec(vc.Site)).new(),
        ensures: Vec(bool).filled(n, false),
        contract_errors: Vec(Vec((diag.Span, String))).new(),
        functions: 0,
        incomplete: 0
    }
    // Each function's obligations are proved independently of the others'
    // (what they rest on is decided below), on several threads, the
    // costliest first: a few large functions take most of the time.
    var jobs = Vec(Job).new()
    for i in 0..n {
        report.contract_errors.push(Vec((diag.Span, String)).new())
        let m = mem.replace(&models[i], None)
        match m {
            Some(f) => {
                report.functions += 1
                let cost = job_cost(f)
                jobs.push(Job { index: i, cost, model: Some(f), outcome: None, ms: 0 })
            }
            None => {}
        }
    }
    sort.sort_by(&jobs, fn(a, b) { a.cost > b.cost })
    let cs = contracts.as_slice()
    let ls = lifts.as_slice()
    thread.each_mut_uneven(&jobs, fn(j) {
        let begin = timing.now()
        let Some(f) = mem.replace(&j.model, None) else { return }
        j.outcome = Some(outcome(f, cs, ls))
        j.ms = (timing.now() - begin) / 1000000
    })
    sort.sort_by(&jobs, fn(a, b) { a.index < b.index })
    var outcomes = Vec(Option(Outcome)).new()
    for _ in 0..n { outcomes.push(None) }
    for Job { index, cost: _, model: _, outcome, ms } in jobs.into_iter() {
        // `JIHOO_VERIFY_TRACE=1`: the time each function took.
        if trace { io.eprintln(p.fns[index].name.as_str() + " " + ms.to_string() + " ms") }
        match outcome {
            Some(o) => {
                if !o.whole { report.incomplete += 1 }
                outcomes[index] = Some(o)
            }
            None => {}
        }
    }
    // The greatest set of assumptions that hold: a function's `requires`
    // when every call proves it (and nothing else calls it), its `ensures`
    // and its cut points' facts when every path proves them, each proof
    // resting only on assumptions in the set. Recursion assumes a
    // function's own contract, which is induction on the depth of calls.
    let escapes = escaping(p)
    var a = Assumptions {
        requires: Vec(bool).filled(n, true), ensures: Vec(bool).filled(n, true),
        cuts: Vec(Vec(bool)).new(), broken: Vec(i64).new()
    }
    for i in 0..n {
        match contracts[i] {
            Some(c) => if c.requires.len() > 0 && escapes[i] { a.requires[i] = false }
            None => {}
        }
        match outcomes[i] {
            Some(o) => {
                a.cuts.push(Vec(bool).filled(o.cuts, o.whole))
                if !o.whole { a.ensures[i] = false }
            }
            None => a.cuts.push(Vec(bool).new())
        }
    }
    // A function not followed everywhere may call one in a way no
    // obligation states: none of its callees' `requires` holds.
    for i in 0..n {
        let Some(o) = outcomes[i] else { continue }
        if !o.whole {
            for g in o.callees { a.requires[g] = false }
            // Nor do the invariants of the types it writes: some
            // obligation may be missing.
            for ty in o.writes {
                let _ = a.break_type(ty)
            }
        }
    }
    var changed = true
    while changed {
        changed = false
        for i in 0..n {
            let Some(o) = outcomes[i] else { continue }
            for r in o.results {
                if valid(a, i, o, r) { continue }
                match r.source {
                    Invariant(k, _) => if a.cuts[i][k] {
                        a.cuts[i][k] = false
                        changed = true
                    }
                    Ensures(_) => if a.ensures[i] {
                        a.ensures[i] = false
                        changed = true
                    }
                    Requires(_, g) => if a.requires[g] {
                        a.requires[g] = false
                        changed = true
                    }
                    TypeInvariant(ty) => if a.break_type(ty) { changed = true }
                    _ => {}
                }
            }
        }
    }
    // The panics of each liftable function that it does not prove away
    // itself: calls may.
    for g in 0..n {
        var left = Vec(vc.Site).new()
        match lifts[g] {
            Some(l) => match outcomes[g] {
                Some(o) => {
                    for s in l.sites {
                        if !site_valid(a, g, o, s) { left.push(s) }
                    }
                }
                None => {}
            }
            None => {}
        }
        report.lifted.push(left)
    }
    for i in 0..n {
        let Some(o) = outcomes[i] else { continue }
        let f = p.fns[i]
        let Some(b) = f.body else { continue }
        report.ensures[i] = o.whole && a.ensures[i]
        // Per check site: every obligation proved, and why one is not.
        let model = obligations.model_of(p, f, ifaces.as_slice()).unwrap()
        for s in sites(p, model) {
            var all = true
            var any = false
            var depends = Vec(i64).new()
            for r in o.results {
                match r.source {
                    Check(x) => if x.0 == s.0 && x.1 == s.1 {
                        any = true
                        if !valid(a, i, o, r) {
                            all = false
                            for d in r.depends {
                                var have = false
                                for e in depends {
                                    if e == d { have = true }
                                }
                                if !have { depends.push(d) }
                            }
                        }
                    }
                    _ => {}
                }
            }
            report.checks.push(Check {
                function: i as u32,
                block: s.0,
                stmt: s.1,
                what: site_what(p, b, s.0, s.1),
                span: site_span(b, s.0, s.1),
                proved: all && any,
                depends,
                retarget: -1,
                kind: if s.1 >= 0 { CHECK } else { match b.blocks[s.0].term {
                    Call(_, _, _, _, _) => PANIC
                    _ => CHECK
                } }
            })
        }
        // Each call to a function with panics left for its callers: the
        // call proves them away when no path to them is possible from it.
        for c, bl in model.blocks {
            let Call(_, _, site) = bl.term else { continue }
            let g = site.callee
            if g < 0 || site.never || report.lifted[g].len() == 0 { continue }
            var proved = o.whole
            var depends = Vec(i64).new()
            for s in report.lifted[g] {
                var any = false
                for r in o.results {
                    match r.source {
                        Lift(x, h, t) => if x == c && h == g && t.0 == s.0 && t.1 == s.1 {
                            any = true
                            if !valid(a, i, o, r) {
                                proved = false
                                for d in r.depends {
                                    var have = false
                                    for e in depends {
                                        if e == d { have = true }
                                    }
                                    if !have { depends.push(d) }
                                }
                            }
                        }
                        _ => {}
                    }
                }
                if !any { proved = false }
            }
            report.checks.push(Check {
                function: i as u32,
                block: c,
                stmt: -1,
                what: panic_what(p, g, report.lifted[g][0]),
                span: site_span(b, c, -1),
                proved,
                depends,
                retarget: g,
                kind: CALL
            })
        }
        // The contract's own clauses: an `ensures` or a written invariant
        // that is not proved, or a `requires` some call does not meet. The
        // invariants are grouped by block as `model_of` groups them.
        var groups = Vec((u32, Vec(diag.Span))).new()
        for x in b.contract.invariants {
            var found = false
            for k in 0..groups.len() {
                if groups[k].0 == x.0 {
                    groups[k].1.push(x.1.span)
                    found = true
                }
            }
            if !found {
                var spans = Vec(diag.Span).new()
                spans.push(x.1.span)
                groups.push((x.0, spans))
            }
        }
        var reported = Vec(String).new()
        // A clause is unproved when its own proof fails, and also when it
        // rests on something that is not proved, which the message names.
        if escapes[i] && b.contract.requires.len() > 0 {
            reported.push("requires".to_string())
            report.contract_errors[i].push((
                b.contract.requires[0].span,
                "`requires` of a function that code outside the program may call (exported, the entry, a destructor or used as a value), where no call proves it".to_string()
            ))
        }
        for r in o.results {
            if valid(a, i, o, r) { continue }
            let why = if r.proved && o.whole { rests_on(p, a, i, r) } else { "".to_string() }
            let error = match r.source {
                Ensures(j) => Some((b.contract.ensures[j].span, "unproved `ensures`".to_string()))
                Invariant(k, j) => if k < o.written && j < groups[k].1.len() {
                    Some((groups[k].1[j], "unproved invariant".to_string()))
                } else { None }
                Requires(block, callee) => Some((
                    site_span(b, block, -1),
                    "unproved `requires` of " + p.fns[callee].name.as_str()
                ))
                TypeInvariant(ty) => Some((
                    if r.at.0 >= 0 {
                        diag.Span.new(f.span.file, r.at.0, r.at.1)
                    } else { f.span },
                    "unproved invariant of `" + p.types.show(ty as u32).as_str() + "`"
                ))
                _ => None
            }
            match error {
                Some(x) => {
                    // Once per clause and place, though several paths reach
                    // it; a failure of its own before one through what it
                    // rests on.
                    let key = x.0.lo.to_string() + " " + x.1.as_str()
                    var seen = false
                    for k in 0..reported.len() {
                        if reported[k] == key {
                            seen = true
                            if why.len() == 0 { report.contract_errors[i][k] = (x.0, x.1.clone()) }
                        }
                    }
                    if !seen {
                        reported.push(key)
                        report.contract_errors[i].push((x.0, x.1 + why.as_str()))
                    }
                }
                None => {}
            }
        }
    }
    // A clause unproved only because what it rests on is unproved is
    // reported only when nothing else is: proving the others may prove it.
    var direct = false
    for es in report.contract_errors {
        for e in es {
            if !e.1.as_str().contains(RESTS) { direct = true }
        }
    }
    if direct {
        for i in 0..report.contract_errors.len() {
            var kept = Vec((diag.Span, String)).new()
            for k, e in report.contract_errors[i] {
                if !e.1.as_str().contains(RESTS) { kept.push((e.0, e.1.clone())) }
            }
            report.contract_errors[i] = kept
        }
    }
    report
}

// MIR without the checks the report proved: an `assert` becomes a jump,
// and a checked `+ - *` its wrapping form, which cannot overflow there.
//
// A call that proved a callee's panics away goes to a copy of the callee
// without them (the panics it does not prove itself, `r.lifted`).
pub fn erase(inout p: mir.Program, r: Report) {
    let n = p.fns.len()
    var by_fn = Vec(Vec((i64, i64))).filled(n, Vec((i64, i64)).new())
    var calls = Vec(Vec((i64, i64))).filled(n, Vec((i64, i64)).new())
    for c in r.checks {
        if !c.proved { continue }
        if c.retarget >= 0 {
            calls[c.function as i64].push((c.block, c.retarget))
        } else { by_fn[c.function as i64].push((c.block, c.stmt)) }
    }
    for i in 0..n {
        if by_fn[i].len() == 0 { continue }
        let Some(b) = mem.replace(&p.fns[i].body, None) else { continue }
        var body = b
        for s in by_fn[i] { erase_one(&body, s.0, s.1) }
        p.fns[i].body = Some(body)
    }
    // The copies' functions, after the program's.
    var copies = Vec(i64).filled(n, -1)
    var order = Vec(i64).new()
    for i in 0..n {
        for x in calls[i] {
            if copies[x.1] < 0 {
                copies[x.1] = n + order.len()
                order.push(x.1)
            }
        }
    }
    for i in 0..n {
        if calls[i].len() == 0 { continue }
        let Some(b) = mem.replace(&p.fns[i].body, None) else { continue }
        var body = b
        for x in calls[i] {
            match body.blocks[x.0].term {
                Call(callee, args, dest, next, span) => {
                    let to = mir.Callee.Fn(copies[x.1] as u32)
                    body.blocks[x.0].term = mir.Term.Call(
                        to,
                        args.clone(),
                        dest.clone(),
                        next,
                        span
                    )
                }
                _ => {}
            }
        }
        p.fns[i].body = Some(body)
    }
    for g in order {
        var f = p.fns[g].clone()
        f.symbol.push_str(".proved")
        f.linkage = mir.Linkage.Internal
        let Some(b) = mem.replace(&f.body, None) else { continue }
        var body = b
        for s in r.lifted[g] {
            match body.blocks[s.0].term {
                Call(_, _, _, _, _) => body.blocks[s.0].term = mir.Term.Unreachable
                _ => {}
            }
        }
        f.body = Some(body)
        p.fns.push(f)
    }
}

fn erase_one(inout body: mir.Body, block: i64, stmt: i64) {
    if stmt < 0 {
        match body.blocks[block].term {
            Assert(_, _, next, _) => body.blocks[block].term = mir.Term.Goto(next)
            // A call that never returns, proved not to be reached.
            Call(_, _, _, _, _) => body.blocks[block].term = mir.Term.Unreachable
            _ => {}
        }
        return
    }
    var replacement: Option(mir.Stmt) = None
    match body.blocks[block].stmts[stmt] {
        Assign(place, rv, span) => match rv {
            Bin(op, x, y) => {
                let wrap = match op {
                    Add => Some(lex.Op.AddWrap)
                    Sub => Some(lex.Op.SubWrap)
                    Mul => Some(lex.Op.MulWrap)
                    _ => None
                }
                match wrap {
                    Some(w) => replacement = Some(mir.Stmt.Assign(
                        place.clone(),
                        mir.Rvalue.Bin(w, x.clone(), y.clone()),
                        span
                    ))
                    None => {}
                }
            }
            _ => {}
        }
        _ => {}
    }
    match replacement {
        Some(st) => body.blocks[block].stmts[stmt] = st
        None => {}
    }
}

// The contract clauses that are not proved, as errors in the order of
// the functions.
pub fn errors(p: mir.Program, r: Report) -> Vec(diag.Diag) {
    var out = Vec(diag.Diag).new()
    for i, es in r.contract_errors {
        for e in es {
            out.push(diag.Diag.new(e.0, message(e.1.as_str(), p.fns[i].name.as_str()).as_str()))
        }
    }
    out
}

// One line per check, then a summary.
pub fn text(p: mir.Program, sources: diag.Sources, r: Report, all: bool) -> String {
    var out = String.new()
    for c in r.checks {
        if !all && c.proved { continue }
        out.push_str(sources.where_(c.span).as_str())
        out.push_str(if c.proved { ": proved " } else { ": kept " })
        out.push_str(c.what.as_str())
        out.push_str(" in ")
        out.push_str(p.fns[c.function as i64].name.as_str())
        if !c.proved && c.depends.len() > 0 {
            out.push_str(" (")
            for i, d in c.depends {
                if i > 0 { out.push_str(", ") }
                out.push_str(vc.why_name(d))
            }
            out.push(')')
        }
        out.push('\n')
    }
    for i, es in r.contract_errors {
        for e in es {
            out.push_str(sources.where_(e.0).as_str())
            out.push_str(": ")
            out.push_str(message(e.1.as_str(), p.fns[i].name.as_str()).as_str())
            out.push('\n')
        }
    }
    out.push_str(r.proved().to_string().as_str())
    out.push_str(" of ")
    out.push_str(r.checks.len().to_string().as_str())
    out.push_str(" checks proved in ")
    out.push_str(r.functions.to_string().as_str())
    out.push_str(" functions (")
    out.push_str(r.incomplete.to_string().as_str())
    out.push_str(" not followed everywhere)\n")
    // By kind: bounds and overflow checks, calls that never return, and
    // calls that may reach a callee's panic.
    let names = ["bounds and overflow checks", "panics", "calls that may panic"]
    for k in 0..3 {
        let (proved, all) = r.count(k)
        out.push_str("  ")
        out.push_str(proved.to_string().as_str())
        out.push_str(" of ")
        out.push_str(all.to_string().as_str())
        out.push(' ')
        out.push_str(names[k])
        out.push('\n')
    }
    out
}

// The verdicts of the functions defined in file 0 (the program's root), as
// jihoo-proofs' `emitted.jh --machine` prints them for its differential
// test: `check NAME LO HI proved|unproved` per check, `requires NAME LO HI
// CALLEE proved|unproved` per call to a function with a `requires`, and
// `ensures NAME proved|unproved`. Proved means that nothing it rests on is
// unproved.
pub fn machine(p: mir.Program, r: Report) -> String {
    var out = String.new()
    for c in r.checks {
        if c.span.file != 0 || c.span.lo == c.span.hi { continue }
        out.push_str("check ")
        obligations.atom(&out, p.fns[c.function as i64].name.as_str())
        out.push(' ')
        out.push_str(c.span.lo.to_string().as_str())
        out.push(' ')
        out.push_str(c.span.hi.to_string().as_str())
        out.push_str(if c.proved { " proved\n" } else { " unproved\n" })
    }
    for i, f in p.fns {
        if f.span.file != 0 || f.body.is_none() || i >= r.ensures.len() { continue }
        let Some(b) = f.body else { continue }
        if b.contract.ensures.len() == 0 { continue }
        out.push_str("ensures ")
        obligations.atom(&out, f.name.as_str())
        out.push_str(if r.ensures[i] { " proved\n" } else { " unproved\n" })
    }
    out
}
