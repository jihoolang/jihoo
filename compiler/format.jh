// Source formatting without moving syntax across significant newlines.
// Tokens and comment bodies retain their original bytes. The output is
// re-lexed before returning: token spelling and newline flags must agree.
import diag
import lex
import parse

type Tok = lex.Tok
type Token = lex.Token
type Diag = diag.Diag

struct Layout {
    out: String
    depth: i64
    line_start: bool
}

pub fn source(file: u32, text: str) -> Result(String, Diag) {
    let tokens = lex.lex(file, text)?
    let parsed = parse.parse_module(file, tokens.clone())?
    var f = Layout { out: String.with_capacity(text.len), depth: 0, line_start: true }
    var end = 0
    var previous = Tok.Eof
    var previous_prefix = false
    for i, token in tokens {
        let kind = token.tok
        let prefix = is_prefix(kind, previous, token.nl_before)
        let comment = f.trivia(text[end..token.span.lo as i64])
        if kind == Tok.Eof { break }
        var indent = f.depth
        if f.line_start {
            var j = i
            while j < tokens.len() && is_close(tokens[j].tok) && (j == i || !tokens[j].nl_before) {
                indent -= 1
                j += 1
            }
            if !is_close(kind) && (kind == Tok.Dot || continues(previous)) {
                indent += 1
            }
        }
        let range_end = i >= 2 && previous == Tok.Assign && tokens[i - 2].tok == Tok.DotDot
        var spaced = comment || (!range_end && needs_space(previous, kind, previous_prefix))
        if !spaced && !f.line_start && i > 0 {
            // Removing a gap must not turn two operators into one, make a
            // comment, or turn a tuple field followed by a dot into a float.
            let prev = tokens[i - 1].span
            let pair = text[prev.lo as i64..prev.hi as i64] + text[token.span.lo as i64..token.span.hi as i64]
            match lex.lex(file, pair.as_str()) {
                Ok(joined) => {
                    if joined.len() != 3 || joined[0].tok != previous || joined[1].tok != kind ||
                        joined[0].span.hi - joined[0].span.lo != prev.hi - prev.lo {
                        spaced = true
                    }
                }
                Err(_) => spaced = true
            }
        }
        f.start(indent, spaced)
        f.out.push_str(text[token.span.lo as i64..token.span.hi as i64])
        if is_open(kind) { f.depth += 1 }
        if is_close(kind) { f.depth -= 1 }
        end = token.span.hi as i64
        previous = kind
        previous_prefix = prefix
    }
    // One final LF, including for an empty file. No trailing blank lines.
    var last = f.out.len()
    while last > 0 && f.out.as_str()[last - 1] == '\n' { last -= 1 }
    var normalized = String.from(f.out.as_str()[0..last])
    normalized.push('\n')
    f.out = normalized
    let checked = lex.lex(file, f.out.as_str())?
    if checked.len() != tokens.len() {
        return Err(Diag.new(diag.Span.new(file, 0, 0), "formatter changed the token sequence"))
    }
    for i, token in tokens {
        let other = checked[i]
        if token.tok != other.tok || token.nl_before != other.nl_before ||
            text[token.span.lo as i64..token.span.hi as i64] != f.out.as_str()[other.span.lo as i64..other.span.hi as i64] {
            return Err(Diag.new(token.span, "formatter changed a token or a significant newline"))
        }
    }
    match f { Layout { out, .. } => Ok(out) }
}

impl Layout {
    fn start(inout self, indent: i64, spaced: bool) {
        if self.line_start {
            for _ in 0..max(0, indent) * 4 { self.out.push(' ') }
            self.line_start = false
        } else if spaced {
            self.out.push(' ')
        }
    }

    fn newline(inout self, count: i64) {
        if self.out.is_empty() { return }
        for _ in 0..min(count, 2) { self.out.push('\n') }
        self.line_start = true
    }

    // The lexer has already validated these gaps. Only whitespace and
    // comments can occur here. Nested block comments are copied as units.
    fn trivia(inout self, text: str) -> bool {
        var i = 0
        var lines = 0
        var comment = false
        while i < text.len {
            if text[i] == '\n' { lines += 1; i += 1 }
            else if is_space(text[i]) { i += 1 }
            else {
                if lines > 0 { self.newline(lines) }
                self.start(self.depth, !self.out.is_empty())
                lines = 0
                let start = i
                if text[i + 1] == '/' {
                    while i < text.len && text[i] != '\n' { i += 1 }
                } else {
                    var depth = 1
                    i += 2
                    while depth > 0 {
                        if i + 1 < text.len && text[i] == '/' && text[i + 1] == '*' { depth += 1; i += 2 }
                        else if i + 1 < text.len && text[i] == '*' && text[i + 1] == '/' { depth -= 1; i += 2 }
                        else { i += 1 }
                    }
                }
                self.out.push_str(text[start..i])
                comment = true
            }
        }
        if lines > 0 { self.newline(lines) }
        comment
    }
}

fn is_open(t: Tok) -> bool { t == Tok.LParen || t == Tok.LBracket || t == Tok.LBrace }
fn is_close(t: Tok) -> bool { t == Tok.RParen || t == Tok.RBracket || t == Tok.RBrace }

fn ends_value(t: Tok) -> bool {
    match t {
        Ident | Int | Float | Str | Char | True | False | RParen | RBracket | RBrace | Question => true
        _ => false
    }
}

fn is_prefix(t: Tok, prev: Tok, newline: bool) -> bool {
    t == Tok.Bang || ((t == Tok.Minus || t == Tok.Star || t == Tok.Amp) && (newline || !ends_value(prev)))
}

fn continues(t: Tok) -> bool {
    match t {
        Assign | OpAssign | Arrow | FatArrow | Colon | Plus | Minus | Star | Slash | Percent |
        PlusWrap | MinusWrap | StarWrap | Amp | Pipe | Caret | Shl | Shr | EqEq | NotEq |
        Lt | Le | Gt | Ge | AndAnd | OrOr | As => true
        _ => false
    }
}

fn needs_space(prev: Tok, next: Tok, prefix: bool) -> bool {
    if prev == Tok.Eof { return false }
    match next {
        RParen | RBracket | Comma | Colon | Semi | Question | Dot | DotDot => return false
        _ => {}
    }
    match prev {
        LParen | LBracket | Hash | HashBang | Dot | DotDot => return false
        _ => {}
    }
    if next == Tok.LParen {
        return !(ends_value(prev) || prev == Tok.Fn || prev == Tok.Impl)
    }
    if next == Tok.LBracket { return !ends_value(prev) }
    if prev == Tok.LBrace && next == Tok.RBrace { return false }
    if prev == Tok.LBrace || next == Tok.LBrace || next == Tok.RBrace { return true }
    if prefix { return false }
    true
}
