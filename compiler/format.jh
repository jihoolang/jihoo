// Source layout with grammar-selected list wrapping. Preserve token and
// comment bytes, keep existing newlines, and verify syntax after new breaks.
import diag
import astdump
import lex
import parse

type Tok = lex.Tok
type Token = lex.Token
type Diag = diag.Diag

struct Layout {
    out: String
    depth: i64
    line_start: bool
}

pub const DEFAULT_WIDTH: i64 = 100

// An open delimiter. Only the first one still open on its line adds an
// indentation level, so `f(match x {` indents its arms once; a line that
// starts by closing it returns to the indentation of the line it opened on.
struct Open {
    counted: bool
    line: i64
    // The indentation of the line it opened on, and of the lines inside it.
    outer: i64
    inner: i64
    after_impl: bool
}

struct Group {
    open: i64
    close: i64
    separators: Vec(i64)
}

pub fn source(file: u32, text: str, width: i64) -> Result(String, Diag) {
    let tokens = lex.lex(file, text)?
    let parsed = parse.format_module(file, tokens.clone())?
    let groups = list_groups(tokens, parsed.lists, parsed.separators)
    var breaks = Vec(bool).filled(tokens.len(), false)
    var formatted = layout(file, text, tokens, breaks)
    loop {
        let current = lex.lex(file, formatted.as_str())?
        if !same_tokens(text, tokens, formatted.as_str(), current) {
            return Err(Diag.new(diag.Span.new(file, 0, 0), "formatter changed a token or removed a newline"))
        }
        let selected = overflowing(formatted.as_str(), current, groups, breaks, width)
        if selected.is_empty() { break }
        for index in selected {
            let g = groups[index]
            breaks[g.open + 1] = true
            for separator in g.separators { breaks[separator + 1] = true }
            breaks[g.close] = true
        }
        formatted = layout(file, text, tokens, breaks)
    }
    let checked = lex.lex(file, formatted.as_str())?
    let after = match parse.parse_module(file, checked) {
        Ok(m) => m
        Err(_) => return Err(Diag.new(diag.Span.new(file, 0, 0), "formatter produced invalid syntax"))
    }
    if astdump.syntax(parsed.module) != astdump.syntax(after).as_str() {
        return Err(Diag.new(diag.Span.new(file, 0, 0), "formatter changed the syntax tree"))
    }
    Ok(formatted)
}

fn layout(file: u32, text: str, tokens: Vec(Token), breaks: Vec(bool)) -> String {
    var f = Layout { out: String.with_capacity(text.len), depth: 0, line_start: true }
    var end = 0
    var previous = Tok.Eof
    var previous_prefix = false
    var opens = Vec(Open).new()
    var line = 0
    var line_indent = 0
    // The previous token closed `impl(...)`, as in `impl(T: type) [T]`.
    var closed_impl = false
    for i, token in tokens {
        let kind = token.tok
        let prefix = is_prefix(kind, previous, token.nl_before || breaks[i])
        let comment = f.trivia(text[end..token.span.lo as i64])
        if kind == Tok.Eof { break }
        if breaks[i] && !f.line_start { f.newline(1) }
        var indent = f.depth
        if f.line_start {
            line += 1
            var j = i
            var k = opens.len()
            while j < tokens.len() && is_close(tokens[j].tok) && (j == i || (!tokens[j].nl_before && !breaks[j])) {
                if k > 0 {
                    k -= 1
                    indent = opens[k].outer
                }
                j += 1
            }
            // A continuation line is indented once more, but what opens on
            // it nests from the statement's level.
            line_indent = indent
            if !is_close(kind) && (kind == Tok.Dot || continues(previous)) {
                indent += 1
            }
        }
        let range_end = i >= 2 && previous == Tok.Assign && tokens[i - 2].tok == Tok.DotDot
        var spaced = comment || (!range_end && needs_space(previous, kind, previous_prefix))
        if closed_impl && kind == Tok.LBracket { spaced = true }
        if !spaced && !f.line_start && i > 0 {
            // Removing a gap must not turn two operators into one, make a
            // comment, or turn a tuple field followed by a dot into a float.
            let prev = tokens[i - 1].span
            let pair = text[prev.lo as i64..prev.hi as i64] + text[token.span.lo as i64..token.span.hi as i64]
            match lex.lex(file, pair.as_str()) {
                Ok(joined) => {
                    if joined.len() != 3 || joined[0].tok != previous || joined[1].tok != kind ||
                        joined[0].span.hi - joined[0].span.lo != prev.hi - prev.lo {
                        spaced = true
                    }
                }
                Err(_) => spaced = true
            }
        }
        f.start(indent, spaced)
        f.out.push_str(text[token.span.lo as i64..token.span.hi as i64])
        closed_impl = false
        if is_open(kind) {
            var counted = true
            var k = opens.len()
            while k > 0 && opens[k - 1].line == line {
                if opens[k - 1].counted { counted = false }
                k -= 1
            }
            let inner = if counted { line_indent + 1 } else { f.depth }
            opens.push(Open { counted, line, outer: line_indent, inner, after_impl: previous == Tok.Impl })
            f.depth = inner
        }
        if is_close(kind) {
            match opens.pop() {
                Some(o) => closed_impl = o.after_impl
                None => {}
            }
            f.depth = if opens.is_empty() { 0 } else { opens[opens.len() - 1].inner }
        }
        end = token.span.hi as i64
        previous = kind
        previous_prefix = prefix
    }
    // One final LF, including for an empty file. No trailing blank lines.
    var last = f.out.len()
    while last > 0 && f.out.as_str()[last - 1] == '\n' { last -= 1 }
    var normalized = String.from(f.out.as_str()[0..last])
    normalized.push('\n')
    f.out = normalized
    match f { Layout { out, .. } => out }
}

fn same_tokens(before: str, tokens: Vec(Token), after: str, checked: Vec(Token)) -> bool {
    if checked.len() != tokens.len() { return false }
    for i, token in tokens {
        let other = checked[i]
        if token.tok != other.tok || (token.nl_before && !other.nl_before) ||
            before[token.span.lo as i64..token.span.hi as i64] != after[other.span.lo as i64..other.span.hi as i64] {
            return false
        }
    }
    true
}

// Pair all delimiters, but only expand lists identified by the parser.
// A for-loop index comma and a match-arm separator are not list boundaries.
fn list_groups(tokens: Vec(Token), starts: Vec(u32), separators: Vec(u32)) -> Vec(Group) {
    var known = Map(u32, bool).new()
    var seps = Map(u32, bool).new()
    for start in starts { known.insert(start, true) }
    for sep in separators { seps.insert(sep, true) }
    var stack = Vec(i64).new()
    var closes = Vec(i64).filled(tokens.len(), -1)
    var owners = Vec(i64).filled(tokens.len(), -1)
    for i, token in tokens {
        if !stack.is_empty() { owners[i] = stack[stack.len() - 1] }
        if is_open(token.tok) { stack.push(i) }
        if is_close(token.tok) {
            let open = stack.pop().unwrap()
            closes[open] = i
        }
    }
    var groups = Vec(Group).new()
    var indices = Vec(i64).filled(tokens.len(), -1)
    for i, token in tokens {
        if known.get(token.span.lo).is_some() && closes[i] > i + 1 {
            indices[i] = groups.len()
            groups.push(Group { open: i, close: closes[i], separators: Vec(i64).new() })
        }
    }
    for i, token in tokens {
        let owner = owners[i]
        if owner >= 0 && indices[owner] >= 0 && seps.get(token.span.lo).is_some() {
            groups[indices[owner]].separators.push(i)
        }
    }
    groups
}

// Expand outer lists first, then reconsider children at their new columns.
// Breaks are only added, so each pass expands at least one remaining group.
fn overflowing(text: str, tokens: Vec(Token), groups: Vec(Group), breaks: Vec(bool), width: i64) -> Vec(i64) {
    var lines = Vec(i64).filled(tokens.len(), 0)
    var columns = Vec(i64).filled(tokens.len(), 0)
    var widths = Vec(i64).new()
    var cursor = 0
    var line = 0
    var column = 0
    for i, token in tokens {
        while cursor < token.span.lo as i64 {
            if text[cursor] == '\n' { widths.push(column); column = 0; line += 1 }
            else { column += 1 }
            cursor += 1
        }
        lines[i] = line
        columns[i] = column
    }
    widths.push(column)
    var selected = Vec(i64).new()
    var covered = -1
    var covered_line = -1
    for i, g in groups {
        // A later list on a line that an expansion splits is measured
        // again at its new column, as a child is: `) -> Result((), E) {`
        // fits once the parameters are on their own lines.
        if g.open < covered || lines[g.open] <= covered_line { continue }
        var needed = !(tokens[g.open + 1].nl_before || breaks[g.open + 1]) ||
            !(tokens[g.close].nl_before || breaks[g.close])
        for sep in g.separators {
            if !(tokens[sep + 1].nl_before || breaks[sep + 1]) { needed = true }
        }
        if !needed { continue }
        // Only the rows that hold this list's own delimiters and separators
        // get shorter when it expands; longer rows inside it belong to an
        // element, and a nested list there is measured on its own.
        let close_end = columns[g.close] + (tokens[g.close].span.hi - tokens[g.close].span.lo) as i64
        var wide = close_end > width
        if lines[g.open] != lines[g.close] && widths[lines[g.open]] > width { wide = true }
        for sep in g.separators {
            if lines[sep] != lines[g.close] && widths[lines[sep]] > width { wide = true }
        }
        if wide { selected.push(i); covered = g.close; covered_line = lines[g.close] }
    }
    selected
}

impl Layout {
    fn start(inout self, indent: i64, spaced: bool) {
        if self.line_start {
            for _ in 0..max(0, indent) * 4 { self.out.push(' ') }
            self.line_start = false
        } else if spaced {
            self.out.push(' ')
        }
    }

    fn newline(inout self, count: i64) {
        if self.out.is_empty() { return }
        for _ in 0..min(count, 2) { self.out.push('\n') }
        self.line_start = true
    }

    // The lexer has already validated these gaps. Only whitespace and
    // comments can occur here. Nested block comments are copied as units.
    fn trivia(inout self, text: str) -> bool {
        var i = 0
        var lines = 0
        var comment = false
        while i < text.len {
            if text[i] == '\n' { lines += 1; i += 1 }
            else if is_space(text[i]) { i += 1 }
            else {
                if lines > 0 { self.newline(lines) }
                self.start(self.depth, !self.out.is_empty())
                lines = 0
                let start = i
                if text[i + 1] == '/' {
                    while i < text.len && text[i] != '\n' { i += 1 }
                } else {
                    var depth = 1
                    i += 2
                    while depth > 0 {
                        if i + 1 < text.len && text[i] == '/' && text[i + 1] == '*' { depth += 1; i += 2 }
                        else if i + 1 < text.len && text[i] == '*' && text[i + 1] == '/' { depth -= 1; i += 2 }
                        else { i += 1 }
                    }
                }
                self.out.push_str(text[start..i])
                comment = true
            }
        }
        if lines > 0 { self.newline(lines) }
        comment
    }
}

fn is_open(t: Tok) -> bool { t == Tok.LParen || t == Tok.LBracket || t == Tok.LBrace }
fn is_close(t: Tok) -> bool { t == Tok.RParen || t == Tok.RBracket || t == Tok.RBrace }

fn ends_value(t: Tok) -> bool {
    match t {
        Ident | Int | Float | Str | Char | True | False | RParen | RBracket | RBrace | Question => true
        _ => false
    }
}

fn is_prefix(t: Tok, prev: Tok, newline: bool) -> bool {
    t == Tok.Bang || ((t == Tok.Minus || t == Tok.Star || t == Tok.Amp) && (newline || !ends_value(prev)))
}

fn continues(t: Tok) -> bool {
    match t {
        Assign | OpAssign | Arrow | FatArrow | Colon | Plus | Minus | Star | Slash | Percent |
        PlusWrap | MinusWrap | StarWrap | Amp | Pipe | Caret | Shl | Shr | EqEq | NotEq |
        Lt | Le | Gt | Ge | AndAnd | OrOr | As => true
        _ => false
    }
}

fn needs_space(prev: Tok, next: Tok, prefix: bool) -> bool {
    if prev == Tok.Eof { return false }
    // The rest of a pattern: `S { a, .. }`, `(a, ..)`.
    if prev == Tok.Comma && next == Tok.DotDot { return true }
    if prev == Tok.DotDot && next == Tok.RBrace { return true }
    match next {
        RParen | RBracket | Comma | Colon | Semi | Question | Dot | DotDot => return false
        _ => {}
    }
    match prev {
        LParen | LBracket | Hash | HashBang | Dot | DotDot => return false
        _ => {}
    }
    // A prefix operator binds to its parenthesized or bracketed operand:
    // `*(p as *u64)`, `&[1, 2]`.
    if prefix && (next == Tok.LParen || next == Tok.LBracket) { return false }
    if next == Tok.LParen {
        return !(ends_value(prev) || prev == Tok.Fn || prev == Tok.Impl)
    }
    if next == Tok.LBracket { return !ends_value(prev) }
    if prev == Tok.LBrace && next == Tok.RBrace { return false }
    if prev == Tok.LBrace || next == Tok.LBrace || next == Tok.RBrace { return true }
    if prefix { return false }
    true
}
