// Loading a program: the root file and every module it imports, each parsed
// once. `import a.b` looks for `a/b.<target>.<profile>.jh`,
// `a/b.<profile>.jh`, `a/b.<target>.jh`, then `a/b.jh`, next to the
// importing file, then in each search directory. Every module also sees the
// prelude (`std/prelude.jh`).

import std.env
import std.mem
import ast
import diag
import lex
import os
import parse
import target

type Diag = diag.Diag
type Span = diag.Span

pub struct ModImport {
    // The name it binds.
    pub alias: String
    pub module: u32
    // `pub import`: the prelude's way of putting a module's names in every
    // scope.
    pub public: bool
    pub span: Span
}

pub struct ModuleAst {
    // The dotted name it was imported by (the root is `main`).
    pub name: String
    pub path: String
    pub ast: ast.Module
    pub imports: Vec(ModImport)
}

pub struct Ast {
    pub modules: Vec(ModuleAst)
    pub root: u32
    pub prelude: Option(u32)
    // std.derive, loaded when some item has `#[derive(...)]`.
    pub derive: Option(u32)
    // The function the program starts in: `main`, or for `jihoo test` the
    // harness `load_tests` adds.
    pub entry: String
    // For `jihoo test`, the root's `#[test]` functions, in order.
    pub tests: Vec(String)
}

// The name of the harness `jihoo test` adds to the root module.
pub const TEST_ENTRY = "__jihoo_tests"

struct Loader {
    search: Vec(String)
    target: String
    // `native`, `freestanding` or `uefi`.
    profile: String
    // By canonical path.
    by_path: Map(String, u32)
    modules: Vec(ModuleAst)
}

// An import a module asks for, before it is loaded.
struct Wanted {
    path: Vec(String)
    alias: Option(String)
    public: bool
    span: Span
}

pub fn default_search(extra: Vec(String)) -> Vec(String) {
    var s = extra.clone()
    match env.get("JIHOO_PATH") {
        Some(p) => {
            for d in p.split(":") {
                if d.len > 0 {
                    s.push(d.to_string())
                }
            }
        }
        None => {}
    }
    // The checkout's (or the installed) standard library, above the
    // compiler's own file.
    match os.current_exe() {
        Some(exe) => {
            var anc = os.parent(exe.as_str()).to_string()
            loop {
                let lib = os.join(anc.as_str(), "lib")
                if os.exists(os.join(lib.as_str(), "std/prelude.jh").as_str()) {
                    s.push(lib)
                    break
                }
                let share = os.join(anc.as_str(), "share/jihoo/lib")
                if os.exists(os.join(share.as_str(), "std/prelude.jh").as_str()) {
                    s.push(share)
                    break
                }
                let up = os.parent(anc.as_str()).to_string()
                if up == anc || anc.len() == 0 {
                    break
                }
                anc = up
            }
        }
        None => {}
    }
    s
}

pub fn load(
    root: str,
    sink search: Vec(String),
    target: str,
    inout sources: diag.Sources,
    no_prelude: bool
) -> Result(Ast, Diag) {
    load_with(root, search, target, &sources, no_prelude, Map(String, String).new())
}

// Loads a program for `jihoo test`: its root module also gets a harness,
// the entry, that runs the `#[test]` function its argument names and
// returns 0, or returns 2 for a name it does not know.
pub fn load_tests(
    root: str,
    sink search: Vec(String),
    target: str,
    inout sources: diag.Sources
) -> Result(Ast, Diag) {
    load_all(root, search, target, &sources, false, Map(String, String).new(), true)
}

// The key of a file in an overlay: its canonical path, or the path itself
// if it does not exist.
pub fn file_key(path: str) -> String {
    match os.canonical(path) {
        Some(k) => k
        None => path.to_string()
    }
}

// Loads with some files' text given by `overlay`, by `file_key`, instead
// of read: an editor's unsaved buffers.
pub fn load_with(
    root: str,
    sink search: Vec(String),
    target: str,
    inout sources: diag.Sources,
    no_prelude: bool,
    overlay: Map(String, String)
) -> Result(Ast, Diag) {
    load_all(root, search, target, &sources, no_prelude, overlay, false)
}

fn load_all(
    root: str,
    sink search: Vec(String),
    target: str,
    inout sources: diag.Sources,
    no_prelude: bool,
    overlay: Map(String, String),
    tests: bool
) -> Result(Ast, Diag) {
    // The profile decides which files the standard library's modules come
    // from, so it is read from the root's attributes first.
    let profile = match read(root, overlay) {
        Ok(text) => profile_of(text.as_str())
        Err(_) => "native"
    }
    var l = Loader {
        search: search,
        target: target.to_string(),
        profile: profile.to_string(),
        by_path: Map(String, u32).new(),
        modules: Vec(ModuleAst).new()
    }
    let name = l.root_name(root)
    let root_idx = l.load_file(root, name.as_str(), Span.new(0, 0, 0), &sources, overlay)?
    var prelude: Option(u32) = None
    if !no_prelude {
        var p = Vec(String).new()
        p.push("std".to_string())
        p.push("prelude".to_string())
        match l.find(p, root) {
            Some(f) => prelude = Some(l.load_file(
                f.as_str(),
                "std.prelude",
                Span.new(0, 0, 0),
                &sources,
                overlay
            )?)
            None => return Err(Diag.new(
                Span.new(0, 0, 0),
                "cannot find the standard library (std/prelude.jh); set JIHOO_PATH or pass -I"
            ))
        }
    }
    var derive: Option(u32) = None
    if !no_prelude && l.any_derive() {
        var p = Vec(String).new()
        p.push("std".to_string())
        p.push("derive".to_string())
        match l.find(p, root) {
            Some(f) => derive = Some(l.load_file(
                f.as_str(),
                "std.derive",
                Span.new(0, 0, 0),
                &sources,
                overlay
            )?)
            None => return Err(Diag.new(
                Span.new(0, 0, 0),
                "cannot find std/derive.jh, which `#[derive(...)]` needs"
            ))
        }
    }
    var entry = String.from("main")
    var names = Vec(String).new()
    if tests {
        names = l.add_tests(root_idx, root, &sources, overlay)?
        entry = String.from(TEST_ENTRY)
    }
    match l {
        Loader { modules, .. } => Ok(Ast {
            modules: modules,
            root: root_idx,
            prelude: prelude,
            derive: derive,
            entry: entry,
            tests: names
        })
    }
}

// Read module attributes as tokens, just as the parser does. Whitespace
// inside an attribute and leading block comments must not change profiles.
fn profile_of(text: str) -> str {
    let tokens = match lex.lex(0, text) {
        Ok(t) => t
        Err(_) => return "native"
    }
    var i = 0
    while i + 3 < tokens.len() && tokens[i].tok == lex.Tok.HashBang {
        if tokens[i + 1].tok != lex.Tok.LBracket || tokens[i + 2].tok != lex.Tok.Ident ||
            tokens[i + 3].tok != lex.Tok.RBracket { return "native" }
        match target.Profile.parse(tokens[i + 2].text.as_str()) {
            Some(p) => return p.name()
            None => {}
        }
        i += 4
    }
    "native"
}

impl Loader {
    // Adds the test harness and returns the names of the tests it runs:
    // the free functions with `#[test]` that take nothing and return nothing
    // (sema reports the others) of the root and of every module it loads
    // outside the standard library, named with their module but for the
    // root's. Each module with tests gets `__jihoo_run_test(name)`, which
    // can call its private functions, and the root the entry, which asks
    // each module in turn.
    fn add_tests(
        inout self,
        root_idx: u32,
        root: str,
        inout sources: diag.Sources,
        overlay: Map(String, String)
    ) -> Result(Vec(String), Diag) {
        var names = Vec(String).new()
        // `__jihoo_run_test` calls: the root's, then `__jihoo_m<i>.`'s.
        var calls = Vec(String).new()
        for i in 0..self.modules.len() {
            let own = i == root_idx as i64
            if !own && self.modules[i].name.as_str().starts_with("std.") { continue }
            var prefix = String.new()
            if !own {
                prefix = self.modules[i].name.clone()
                prefix.push('.')
            }
            var text = String.from("pub fn __jihoo_run_test(__jihoo_name: str) -> bool {\n")
            var any = false
            for it in self.modules[i].ast.items {
                let Fn(f) = it.kind else { continue }
                var test = false
                for a in it.attrs {
                    if a.name == "test" { test = true }
                }
                let plain = match f.kind { Normal => true, _ => false }
                if !test || !plain || f.is_unsafe || f.params.len() > 0 || f.ret.is_some() {
                    continue
                }
                let name = prefix.as_str() + f.name.as_str()
                text.push_str("    if __jihoo_name == \"")
                text.push_str(name.as_str())
                text.push_str("\" {\n        ")
                text.push_str(f.name.as_str())
                text.push_str("()\n        return true\n    }\n")
                names.push(name)
                any = true
            }
            if !any { continue }
            text.push_str("    false\n}\n")
            self.add_items(i, text, &sources)?
            if own {
                calls.push(String.from("__jihoo_run_test"))
            } else {
                let alias = "__jihoo_m" + i.to_string().as_str()
                let span = Span.new(self.modules[root_idx as i64].ast.file, 0, 0)
                self.modules[root_idx as i64].imports.push(ModImport {
                    alias: alias.clone(),
                    module: i as u32,
                    public: false,
                    span: span
                })
                calls.push(alias + ".__jihoo_run_test")
            }
        }
        // The entry sees std.env as `__jihoo_env`.
        var path = Vec(String).new()
        path.push(String.from("std"))
        path.push(String.from("env"))
        let at = Span.new(self.modules[root_idx as i64].ast.file, 0, 0)
        let p = match self.find(path, root) {
            Some(p) => p
            None => return Err(Diag.new(at, "cannot find module `std.env`, which tests need"))
        }
        let m = self.load_file(p.as_str(), "std.env", at, &sources, overlay)?
        self.modules[root_idx as i64].imports.push(ModImport {
            alias: String.from("__jihoo_env"),
            module: m,
            public: false,
            span: at
        })
        var text = String.from("fn ")
        text.push_str(TEST_ENTRY)
        text.push_str(
            "() -> i32 {\n    let __jihoo_args = __jihoo_env.args()\n    if __jihoo_args.len() != 2 { return 2 }\n    let __jihoo_name = __jihoo_args[1]\n"
        )
        for c in calls {
            text.push_str("    if ")
            text.push_str(c.as_str())
            text.push_str("(__jihoo_name) { return 0 }\n")
        }
        text.push_str("    2\n}\n")
        self.add_items(root_idx as i64, text, &sources)?
        Ok(names)
    }

    // Parses generated source into a module's items.
    fn add_items(
        inout self,
        module: i64,
        sink text: String,
        inout sources: diag.Sources
    ) -> Result((), Diag) {
        let file = sources.add(String.from("<tests>"), text)
        let toks = lex.lex(file, sources.files[file as i64].text.as_str())?
        var parsed = parse.parse_module(file, toks)?
        for it in mem.take(&parsed.items).into_iter() {
            self.modules[module].ast.items.push(it)
        }
        Ok(())
    }

    // The root module's name: `main`, or for a file of the standard library
    // its module's, such as `std.map` for `std/map.x86_64.jh`, so that it
    // sees the library's private items and is not loaded twice.
    fn root_name(self, root: str) -> String {
        let Some(file) = os.canonical(root) else { return String.from("main") }
        for d in self.search {
            let Some(dir) = os.canonical(os.join(d.as_str(), "std").as_str()) else { continue }
            let prefix = dir + "/"
            let f = file.as_str()
            if !f.starts_with(prefix.as_str()) { continue }
            var name = String.from("std.")
            var i = prefix.len()
            while i < f.len && f[i] != '.' {
                name.push(if f[i] == '/' { '.' } else { f[i] })
                i += 1
            }
            return name
        }
        String.from("main")
    }

    // Whether an item of a loaded module derives a trait.
    fn any_derive(self) -> bool {
        for m in self.modules {
            for it in m.ast.items {
                for a in it.attrs {
                    if a.name == "derive" && a.args.len() > 0 {
                        return true
                    }
                }
            }
        }
        false
    }

    fn find(self, path: Vec(String), from: str) -> Option(String) {
        var dirs = Vec(String).new()
        dirs.push(os.parent(from).to_string())
        for d in self.search {
            dirs.push(d.clone())
        }
        var rel = String.new()
        for i, p in path {
            if i > 0 {
                rel.push('/')
            }
            rel.push_str(p.as_str())
        }
        for d in dirs {
            let base = os.join(d.as_str(), rel.as_str())
            // `a.x86_64.freestanding.jh`, `a.freestanding.jh`, `a.x86_64.jh`, `a.jh`
            let both = base.as_str() + "." + self.target.as_str() + "." +
                self.profile.as_str() + ".jh"
            let profile = base.as_str() + "." + self.profile.as_str() + ".jh"
            let target = base.as_str() + "." + self.target.as_str() + ".jh"
            let plain = base.as_str() + ".jh"
            for p in [both, profile, target, plain] {
                if os.exists(p.as_str()) {
                    return Some(p.clone())
                }
            }
        }
        None
    }

    fn load_file(
        inout self,
        path: str,
        name: str,
        at: Span,
        inout sources: diag.Sources,
        overlay: Map(String, String)
    ) -> Result(u32, Diag) {
        let key = file_key(path)
        match self.by_path.get(key) {
            Some(i) => return Ok(i)
            None => {}
        }
        let text = match read(path, overlay) {
            Ok(t) => t
            Err(e) => return Err(Diag.new(at, ("cannot read " + path + ": " + e.as_str()).as_str()))
        }
        let file = sources.add(path.to_string(), text)
        let toks = lex.lex(file, sources.files[file as i64].text.as_str())?
        let module = parse.parse_module(file, toks)?
        let idx = self.modules.len() as u32
        self.by_path.insert(key, idx)
        var wanted = Vec(Wanted).new()
        for it in module.items {
            match it.kind {
                Import(imp) => wanted.push(Wanted {
                    path: imp.path.clone(),
                    alias: imp.alias.clone(),
                    public: it.public,
                    span: it.span
                })
                _ => {}
            }
        }
        self.modules.push(ModuleAst {
            name: name.to_string(),
            path: path.to_string(),
            ast: module,
            imports: Vec(ModImport).new()
        })
        var imports = Vec(ModImport).new()
        for w in wanted {
            let dotted = dots(w.path)
            let p = match self.find(w.path, path) {
                Some(p) => p
                None => return Err(Diag.new(w.span, ("cannot find module `" + dotted.as_str() +
                    "`").as_str()))
            }
            let m = self.load_file(p.as_str(), dotted.as_str(), w.span, &sources, overlay)?
            let alias = match w.alias {
                Some(a) => a.clone()
                None => w.path[w.path.len() - 1].clone()
            }
            imports.push(ModImport { alias: alias, module: m, public: w.public, span: w.span })
        }
        self.modules[idx as i64].imports = imports
        Ok(idx)
    }
}

fn read(path: str, overlay: Map(String, String)) -> Result(String, String) {
    if overlay.len() > 0 {
        match overlay.get(file_key(path)) {
            Some(t) => return Ok(t.clone())
            None => {}
        }
    }
    os.read_file(path)
}

fn dots(path: Vec(String)) -> String {
    var s = String.new()
    for i, p in path {
        if i > 0 {
            s.push('.')
        }
        s.push_str(p.as_str())
    }
    s
}
