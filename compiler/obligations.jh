// `emit-obligations`: each function's MIR as the integer model that
// jihoo-proofs/obligations proves things about (docs/internals/verification.md).
// What the model cannot follow becomes `(opaque why)`, a value known only
// to be in its type's range, so the output never claims more than MIR says.

import diag
import forms
import lex
import linear
import mir
import types
import vc

type Body = mir.Body
type Operand = mir.Operand
type Place = mir.Place
type Program = mir.Program
type Types = types.Types

// What the model knows about each local, and the extra variables that stand
// for slice lengths, `inout` parameters' values and parameters on entry.
struct Model {
    // Per local: tracked as an integer or bool (not escaped).
    tracked: Vec(bool)
    // Per local: the variable of its length, for a `str` or slice local.
    lengths: Vec(Option(i64))
    // Per local: the variable of `*local`, for an `inout` integer parameter
    // used only to reach that integer.
    derefs: Vec(Option(i64))
    // Per local: a temporary holding `&mut x` for one call, and the place
    // it lends; the call may change `x`, and nothing else can.
    lent: Vec(Option(Place))
    // Per local: its address is taken.
    escaped: Vec(bool)
    // Integer fields followed as variables, and per local the indices of
    // its own in `fields`.
    fields: Vec(FieldVar)
    by_local: Vec(Vec(i64))
    // The parameters' variables and the variables of their values on entry.
    entries: Vec((i64, i64))
    // The ranges of the variables after the locals, in order, as text and
    // for the verifier.
    kinds: Vec(String)
    vkinds: Vec(vc.Kind)
    count: i64
}

fn range(inout s: String, i: types.IntTy) {
    s.push_str("(int ")
    if i.signed && i.bits == 128 {
        // 2^127 itself does not fit an i128.
        s.push_str(
            "-170141183460469231731687303715884105728 170141183460469231731687303715884105727"
        )
    } else if i.signed {
        let one: i128 = 1
        let limit = one << (i.bits - 1) as i128
        (0 - limit).show(&s)
        s.push(' ')
        (limit - 1).show(&s)
    } else {
        s.push_str("0 ")
        if i.bits == 128 {
            s.push_str("340282366920938463463374607431768211455")
        } else {
            let one: u128 = 1
            ((one << i.bits as u128) - 1).show(&s)
        }
    }
    s.push(')')
}

fn is_view(t: Types, ty: u32) -> bool {
    match t.kind(ty) {
        Slice(_) | Str => true
        _ => false
    }
}

// How often each local appears, and how.
struct Uses {
    // As a whole operand, outside a call's arguments.
    whole: Vec(i64)
    // As a whole call argument.
    args: Vec(i64)
    // As `(*l)` exactly, read or written.
    deref: Vec(i64)
    // Assigned whole.
    dest: Vec(i64)
    // In any other way: a part, a borrow, an index.
    other: Vec(i64)
}

fn use_place(inout u: Uses, p: Place, borrowed: bool) {
    let l = p.local as i64
    for pr in p.proj {
        match pr {
            Index(i) => u.whole[i as i64] += 1
            _ => {}
        }
    }
    if borrowed {
        u.other[l] += 1
    } else if p.proj.len() == 0 {
        u.whole[l] += 1
    } else if p.proj.len() == 1 && p.proj[0] == mir.Proj.Deref {
        u.deref[l] += 1
    } else { u.other[l] += 1 }
}

fn use_operand(inout u: Uses, o: Operand) {
    match o {
        Copy(p) | Move(p) => use_place(&u, p, false)
        Const(_) => {}
    }
}

fn use_dest(inout u: Uses, p: Place) {
    if p.proj.len() == 0 { u.dest[p.local as i64] += 1 } else { use_place(&u, p, false) }
}

// The temporaries `t = &mut x` that are only passed to one call whose
// result holds no borrow: the call may change `x`, and the borrow ends
// with it.
fn lendings(t: Types, b: Body) -> Vec(Option(Place)) {
    var out = Vec(Option(Place)).filled(b.locals.len(), None)
    var u = Uses {
        whole: Vec(i64).filled(b.locals.len(), 0), args: Vec(i64).filled(b.locals.len(), 0),
        deref: Vec(i64).filled(b.locals.len(), 0), dest: Vec(i64).filled(b.locals.len(), 0),
        other: Vec(i64).filled(b.locals.len(), 0)
    }
    for bl in b.blocks {
        for st in bl.stmts {
            match st {
                Assign(p, rv, _) => {
                    use_dest(&u, p)
                    rvalue_uses(&u, rv)
                }
                Drop(p, _) => use_place(&u, p, true)
                _ => {}
            }
        }
        term_uses(&u, bl.term)
    }
    var candidate = Vec(Option(Place)).filled(b.locals.len(), None)
    for bl in b.blocks {
        for st in bl.stmts {
            match st {
                Assign(p, rv, _) => match rv {
                    RefMut(q) => if p.proj.len() == 0 { candidate[p.local as i64] = Some(q.clone()) }
                    _ => {}
                }
                _ => {}
            }
        }
    }
    for bl in b.blocks {
        match bl.term {
            Call(_, args, dest, _, _) => {
                let ty = b.locals[dest.local as i64].ty
                let keeps = t.is_view(ty) || match t.kind(ty) {
                    Ref(_) | RefMut(_) | Ptr(_) => true
                    _ => false
                }
                for a in args {
                    match a {
                        Copy(p) | Move(p) => {
                            let l = p.local as i64
                            if p.proj.len() == 0 && !keeps && u.dest[l] == 1 && u.args[l] == 1 &&
                                u.whole[l] == 0 && u.deref[l] == 0 && u.other[l] == 0 {
                                out[l] = candidate[l].clone()
                            }
                        }
                        _ => {}
                    }
                }
            }
            _ => {}
        }
    }
    out
}

fn rvalue_uses(inout u: Uses, rv: mir.Rvalue) {
    match rv {
        Use(o) | Un(_, o) | Cast(o, _, _) | Repeat(o, _) => use_operand(&u, o)
        Bin(_, x, y) | Offset(x, y) => {
            use_operand(&u, x)
            use_operand(&u, y)
        }
        Aggregate(_, os) => {
            for o in os { use_operand(&u, o) }
        }
        Ref(p) | RefMut(p) | Addr(p) | Discriminant(p) => use_place(&u, p, true)
    }
}

fn term_uses(inout u: Uses, term: mir.Term) {
    match term {
        Switch(o, _, _) | Assert(o, _, _, _) => use_operand(&u, o)
        Call(callee, args, dest, _, _) => {
            match callee {
                Ptr(o) | Closure(o) => use_operand(&u, o)
                _ => {}
            }
            for a in args {
                match a {
                    Copy(p) | Move(p) => if p.proj.len() == 0 {
                        u.args[p.local as i64] += 1
                    } else { use_place(&u, p, false) }
                    _ => {}
                }
            }
            use_dest(&u, dest)
        }
        _ => {}
    }
}

// A local whose address is taken (`&x` for `inout`, `&raw`) may change
// through that pointer; the model does not follow it, unless the borrow is
// only lent to one call and lends an integer or bool local, or the integer
// an `inout` parameter points to: a call gives those a new value. A view
// lent that way escapes, since the call may change its length.
fn escapes(t: Types, b: Body, lent: [Option(Place)]) -> Vec(bool) {
    var out = Vec(bool).filled(b.locals.len(), false)
    for bl in b.blocks {
        for st in bl.stmts {
            match st {
                Assign(dst, rv, _) => match rv {
                    RefMut(p) => {
                        let scalar = p.proj.len() == 0 && match t.kind(b.locals[p.local as i64].ty) {
                            Int(_) | Bool => true
                            _ => false
                        }
                        let lending = dst.proj.len() == 0 && lent[dst.local as i64].is_some() &&
                            (scalar || plain_deref(p, p.local))
                        if !lending { out[p.local as i64] = true }
                    }
                    Addr(p) => out[p.local as i64] = true
                    _ => {}
                }
                _ => {}
            }
        }
    }
    out
}

// Whether `l`, an `inout` parameter, is used only to read and write the
// integer it points to: as `(*l)`, or lent whole to a call as `&mut (*l)`.
fn only_deref(b: Body, lent: [Option(Place)], l: u32) -> bool {
    for bl in b.blocks {
        for st in bl.stmts {
            match st {
                Assign(dst, rv, _) => {
                    if !place_derefs(dst, l) { return false }
                    let lending = dst.proj.len() == 0 && lent[dst.local as i64].is_some()
                    if !rvalue_derefs(rv, l, lending) { return false }
                }
                Drop(p, _) => if p.local == l { return false }
                _ => {}
            }
        }
        match bl.term {
            Switch(o, _, _) | Assert(o, _, _, _) => if !operand_derefs(o, l) { return false }
            Call(callee, args, dest, _, _) => {
                match callee {
                    Ptr(o) | Closure(o) => if !operand_derefs(o, l) { return false }
                    _ => {}
                }
                for a in args {
                    if !operand_derefs(a, l) { return false }
                }
                if !place_derefs(dest, l) { return false }
            }
            _ => {}
        }
    }
    true
}

fn plain_deref(p: Place, l: u32) -> bool {
    p.local == l && p.proj.len() == 1 && p.proj[0] == mir.Proj.Deref
}

// The place does not use `l` other than as `(*l)`.
fn place_derefs(p: Place, l: u32) -> bool {
    for pr in p.proj {
        match pr {
            Index(i) => if i == l { return false }
            _ => {}
        }
    }
    p.local != l || plain_deref(p, l)
}

fn operand_derefs(o: Operand, l: u32) -> bool {
    match o {
        Copy(p) | Move(p) => place_derefs(p, l)
        Const(_) => true
    }
}

fn rvalue_derefs(rv: mir.Rvalue, l: u32, lending: bool) -> bool {
    match rv {
        Use(o) | Un(_, o) | Cast(o, _, _) | Repeat(o, _) => operand_derefs(o, l)
        Bin(_, x, y) | Offset(x, y) => operand_derefs(x, l) && operand_derefs(y, l)
        Aggregate(_, os) => {
            for o in os {
                if !operand_derefs(o, l) { return false }
            }
            true
        }
        RefMut(p) => p.local != l || (lending && plain_deref(p, l))
        Ref(p) | Addr(p) | Discriminant(p) => p.local != l
    }
}

// ---- Fields as variables ----
//
// An integer field of a local (`x.f.g`), or of what a borrowed local points
// to (`(*p).f.g`), is a variable while the model can see everything that
// changes it: an assignment to it or to a place that contains it, a drop
// of such a place, a call that is lent such a place or writes its result
// there, and for `(*p).f`, an assignment to `p`. That needs the local's
// address never taken (`&raw`), and every mutable borrow of it or its parts
// lent to one call (`lendings`). Nothing else changes such a field: the
// borrow kernel lets no other borrow change what a borrow reaches while it
// lives, a shared borrow promises no change (so no type with an
// `#[interior]` part is followed), and a raw pointer write is assumed not to
// reach a place held under a borrow or a local whose address it was not
// given, as `noalias` on borrowed parameters already assumes.

struct FieldVar {
    local: u32
    // Through `*local`: the local is a borrow.
    deref: bool
    path: Vec(u32)
    v: i64
}

impl Clone for FieldVar {
    fn clone(self) -> FieldVar {
        FieldVar { local: self.local, deref: self.deref, path: self.path.clone(), v: self.v }
    }
}

fn field_place(f: FieldVar) -> Place {
    var p = Place.local(f.local)
    if f.deref { p.proj.push(mir.Proj.Deref) }
    for k in f.path { p.proj.push(mir.Proj.Field(k)) }
    p
}

// Fields deeper than this are not followed.
const MAX_FIELD_DEPTH: i64 = 6
// Nor more field variables than this in one function.
const MAX_FIELDS: i64 = 400

fn has_fields(t: Types, ty: u32) -> bool {
    match t.kind(ty) {
        Tuple(ts) => ts.len() > 0
        Adt(_) => t.field_tys(ty).len() > 0
        _ => false
    }
}

// How a local's fields can be variables: `Some(true)` those of what it
// borrows, `Some(false)` its own, None when they cannot.
fn field_base(t: Types, ty: u32) -> Option(bool) {
    match t.kind(ty) {
        Ref(inner) | RefMut(inner) => {
            let view = match t.kind(inner) {
                Slice(_) | Str => true
                _ => false
            }
            if (view || has_fields(t, inner)) && !t.is_interior(inner) { Some(true) } else { None }
        }
        _ => if has_fields(t, ty) && !t.is_interior(ty) { Some(false) } else { None }
    }
}

// The type of field `k` of a value of type `ty`, and whether it is a
// view's length (never negative).
fn field_step(t: Types, ty: u32, k: u32) -> Option((u32, bool)) {
    match t.kind(ty) {
        Slice(_) | Str => if k == 1 { Some((types.I64, true)) } else { None }
        Tuple(_) | Adt(_) => {
            let fs = t.field_tys(ty)
            if (k as i64) < fs.len() { Some((fs[k as i64], false)) } else { None }
        }
        _ => None
    }
}

// Per local: its fields may be variables. Its type has fields and no
// `#[interior]` part, it is not itself a borrow lent to one call, no raw
// address of it or its parts is taken, and each mutable borrow of it or
// its parts is lent to one call.
fn fields_ok(t: Types, b: Body, lent: [Option(Place)]) -> Vec(bool) {
    var out = Vec(bool).new()
    for i, l in b.locals { out.push(lent[i].is_none() && field_base(t, l.ty).is_some()) }
    for bl in b.blocks {
        for st in bl.stmts {
            match st {
                Assign(dst, rv, _) => match rv {
                    RefMut(p) => if !(dst.proj.len() == 0 && lent[dst.local as i64].is_some()) {
                        out[p.local as i64] = false
                    }
                    Addr(p) => out[p.local as i64] = false
                    _ => {}
                }
                _ => {}
            }
        }
    }
    out
}

// The field variable a place would be: through the local's borrow or not,
// the fields, and the range.
fn field_of(
    t: Types,
    b: Body,
    ok: [bool],
    p: Place
) -> Option((bool, Vec(u32), types.IntTy, bool)) {
    let l = p.local as i64
    if !ok[l] { return None }
    let Some(deref) = field_base(t, b.locals[l].ty) else { return None }
    var ty = b.locals[l].ty
    var i = 0
    if deref {
        if p.proj.len() == 0 || p.proj[0] != mir.Proj.Deref { return None }
        ty = t.pointee(ty).unwrap()
        i = 1
    }
    if p.proj.len() - i < 1 || p.proj.len() - i > MAX_FIELD_DEPTH { return None }
    var path = Vec(u32).new()
    var length = false
    while i < p.proj.len() {
        let Field(k) = p.proj[i] else { return None }
        if length { return None }
        let Some(step) = field_step(t, ty, k) else { return None }
        ty = step.0
        length = step.1
        path.push(k)
        i += 1
    }
    let Some(n) = t.int(ty) else { return None }
    Some((deref, path, n, length))
}

// One place is a prefix of the other: writing one may change the other.
// Places of different locals, or that part at different fields, are
// disjoint.
fn overlaps(a: Place, b: Place) -> bool {
    if a.local != b.local { return false }
    var i = 0
    while i < a.proj.len() && i < b.proj.len() {
        if a.proj[i] != b.proj[i] {
            match a.proj[i] {
                Field(_) => match b.proj[i] {
                    Field(_) => return false
                    _ => {}
                }
                _ => {}
            }
            return true
        }
        i += 1
    }
    true
}

// `a` is a prefix of `b`, or equal to it.
fn prefix(a: Place, b: Place) -> bool {
    if a.local != b.local || a.proj.len() > b.proj.len() { return false }
    for i in 0..a.proj.len() {
        if a.proj[i] != b.proj[i] { return false }
    }
    true
}

fn below(p: Place, rest: [mir.Proj]) -> Place {
    var q = p.clone()
    for x in rest { q.proj.push(x) }
    q
}

// The place whose value is `rest` below what `rv` gives, if it is one.
fn source_place(rv: mir.Rvalue, rest: [mir.Proj]) -> Option(Place) {
    if rest.len == 0 { return None }
    match rv {
        Use(o) => match o {
            Copy(q) | Move(q) => Some(below(q, rest))
            Const(_) => None
        }
        Ref(q) | RefMut(q) => if rest[0] == mir.Proj.Deref { Some(below(q, rest[1..])) } else { None }
        Aggregate(agg, os) => match agg {
            Struct(_) => {
                let Field(k) = rest[0] else { return None }
                if rest.len < 2 || k as i64 >= os.len() { return None }
                match os[k as i64] {
                    Copy(q) | Move(q) => Some(below(q, rest[1..]))
                    Const(_) => None
                }
            }
            _ => None
        }
        _ => None
    }
}

// Every place the function reads or writes.
fn places(b: Body) -> Vec(Place) {
    var out = Vec(Place).new()
    for bl in b.blocks {
        for st in bl.stmts {
            match st {
                Assign(p, rv, _) => {
                    out.push(p.clone())
                    rvalue_places(rv, &out)
                }
                _ => {}
            }
        }
        match bl.term {
            Switch(o, _, _) | Assert(o, _, _, _) => operand_place(o, &out)
            Call(_, args, dest, _, _) => {
                for a in args { operand_place(a, &out) }
                out.push(dest.clone())
            }
            _ => {}
        }
    }
    out
}

fn operand_place(o: Operand, inout out: Vec(Place)) {
    match o {
        Copy(p) | Move(p) => out.push(p.clone())
        Const(_) => {}
    }
}

fn rvalue_places(rv: mir.Rvalue, inout out: Vec(Place)) {
    match rv {
        Use(o) | Un(_, o) | Cast(o, _, _) | Repeat(o, _) => operand_place(o, &out)
        Bin(_, x, y) | Offset(x, y) => {
            operand_place(x, &out)
            operand_place(y, &out)
        }
        Aggregate(_, os) => {
            for o in os { operand_place(o, &out) }
        }
        _ => {}
    }
}

// The fields that are variables: those the function reads or writes, then
// those whose values the first ones are copied from, until no more are
// needed. `wanted` are more places to follow (a callee's contract).
fn find_fields(t: Types, b: Body, lent: [Option(Place)], wanted: [Place]) -> Vec(FieldVar) {
    let ok = fields_ok(t, b, lent)
    var out = Vec(FieldVar).new()
    var work = places(b)
    for p in wanted { work.push(p.clone()) }
    // A view local copied from a field: its length is that field's.
    for bl in b.blocks {
        for st in bl.stmts {
            match st {
                Assign(dst, rv, _) => if dst.proj.len() == 0 && is_view(
                    t,
                    b.locals[dst.local as i64].ty
                ) {
                    match rv {
                        Use(o) => match o {
                            Copy(q) | Move(q) => if q.proj.len() > 0 { work.push(q.with(mir.Proj.Field(
                                1
                            ))) }
                            Const(_) => {}
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
    }
    var k = 0
    while k < work.len() && out.len() < MAX_FIELDS {
        let p = work[k].clone()
        k += 1
        let Some(f) = field_of(t, b, ok.as_slice(), p) else { continue }
        var seen = false
        for x in out {
            if x.local == p.local && x.path == f.1 { seen = true }
        }
        if seen { continue }
        // Where an assignment to a place that contains this one copies it from.
        for bl in b.blocks {
            for st in bl.stmts {
                match st {
                    Assign(dst, rv, _) => if dst.proj.len() < p.proj.len() && prefix(dst, p) {
                        match source_place(rv, p.proj[dst.proj.len()..]) {
                            Some(q) => work.push(q)
                            None => {}
                        }
                    }
                    _ => {}
                }
            }
        }
        out.push(FieldVar { local: p.local, deref: f.0, path: f.1.clone(), v: -1 })
    }
    out
}

fn field_kind(t: Types, b: Body, f: FieldVar) -> (String, vc.Kind) {
    let ok = Vec(bool).filled(b.locals.len(), true)
    let (_, _, n, length) = field_of(t, b, ok.as_slice(), field_place(f)).unwrap()
    if length { return ("(int 0 9223372036854775807)".to_string(), vc.len_range()) }
    var s = String.new()
    range(&s, n)
    (s, int_kind(n))
}

// The variables of the fields inside a place, except the place's own.
fn fields_in(m: Model, p: Place) -> Vec(i64) {
    var out = Vec(i64).new()
    for i in m.by_local[p.local as i64] {
        let f = m.fields[i]
        let q = field_place(f)
        if overlaps(p, q) && q != p { out.push(f.v) }
    }
    out
}

// What an assignment of `rv` to `dst` gives each field variable inside
// `dst` but not `dst` itself: the value it copies, or an opaque one.
fn field_writes(t: Types, m: Model, dst: Place, rv: mir.Rvalue) -> Vec((i64, vc.Rvalue)) {
    var out = Vec((i64, vc.Rvalue)).new()
    for i in m.by_local[dst.local as i64] {
        let f = m.fields[i]
        let q = field_place(f)
        if !overlaps(dst, q) || q == dst { continue }
        var value = opaque_rv("field")
        if prefix(dst, q) {
            let rest = q.proj[dst.proj.len()..]
            var done = false
            if rest.len == 1 {
                match rv {
                    Aggregate(agg, os) => match agg {
                        Struct(_) | View(_) => match rest[0] {
                            Field(k) => if (k as i64) < os.len() {
                                value = vc.Rvalue.Use(model_operand(t, m, os[k as i64]))
                                done = true
                            }
                            _ => {}
                        }
                        _ => {}
                    }
                    _ => {}
                }
            }
            if !done {
                match source_place(rv, rest) {
                    Some(s) => match variable(m, s) {
                        Some(v) => value = vc.Rvalue.Use(vc.Operand.Local(v))
                        None => value = opaque_rv(place_reason(m, s))
                    }
                    None => {}
                }
            }
        }
        out.push((f.v, value))
    }
    // Values read from variables this assignment also writes would be read
    // after they change: such a value is not followed.
    if out.len() > 1 {
        for i in 0..out.len() {
            let reads = match out[i].1 {
                Use(o) => match o {
                    Local(v) => {
                        var hit = false
                        for w in out {
                            if w.0 == v { hit = true }
                        }
                        hit
                    }
                    _ => false
                }
                _ => false
            }
            if reads { out[i].1 = opaque_rv("field") }
        }
    }
    out
}

// The variables a call may change besides its result's: the fields inside
// what it is lent, behind a mutable borrow it is given, and inside the
// place its result goes to.
fn call_changes(t: Types, b: Body, m: Model, args: [Operand], dest: Place) -> Vec(i64) {
    var out = Vec(i64).new()
    for a in args {
        match a {
            Copy(q) | Move(q) => if q.proj.len() == 0 {
                match m.lent[q.local as i64] {
                    // The lent place's own variable, if any, is the call's `Lent`.
                    Some(x) => {
                        for v in fields_in(m, x) { out.push(v) }
                    }
                    None => match t.kind(b.locals[q.local as i64].ty) {
                        RefMut(_) => {
                            for v in fields_in(m, q.with(mir.Proj.Deref)) { out.push(v) }
                            match variable(m, q.with(mir.Proj.Deref)) {
                                Some(v) => out.push(v)
                                None => {}
                            }
                        }
                        _ => {}
                    }
                }
            }
            Const(_) => {}
        }
    }
    for v in fields_in(m, dest) { out.push(v) }
    // A view result's length.
    if dest.proj.len() == 0 {
        match m.lengths[dest.local as i64] {
            Some(n) => out.push(n)
            None => {}
        }
    }
    out
}

// The variable of the call's result's length, when it is a view; -1 if not.
fn result_length(m: Model, dest: Place) -> i64 {
    if dest.proj.len() > 0 { return -1 }
    match m.lengths[dest.local as i64] {
        Some(n) => n
        None => -1
    }
}

// ---- Type invariants ----
//
// A struct's `invariant` (docs/language/contracts.md) holds of every value
// of the type a function is given: on entry, of what its parameters hold,
// and after a call, of the result and of what the call is lent. Only a
// function that writes the type's fields or builds one (a writer of the
// type) can break it, so a writer proves it wherever another function
// could see the value: at each call, of what the call is given; at a drop,
// which runs destructors; and on return, of the result and what its
// `inout` parameters hold. A proof that assumes the invariant counts only
// when every writer's obligations of the type are proved.

// Struct fields followed to find invariants, at most this deep.
const MAX_INVARIANT_DEPTH: i64 = 3

// The paths inside a value of type `ty`, through fields but not through
// borrows or pointers, to the places whose types have an invariant, with
// those types.
fn invariant_paths(p: Program, ty: u32) -> Vec((Vec(u32), u32)) {
    var out = Vec((Vec(u32), u32)).new()
    if p.invariants.len() > 0 { invariant_paths_in(p, ty, Vec(u32).new(), &out) }
    out
}

fn invariant_paths_in(p: Program, ty: u32, path: Vec(u32), inout out: Vec((Vec(u32), u32))) {
    if p.invariants.contains(ty) { out.push((path.clone(), ty)) }
    if path.len() >= MAX_INVARIANT_DEPTH { return }
    match p.types.kind(ty) {
        Tuple(_) | Adt(_) => {}
        _ => return
    }
    for k, f in p.types.field_tys(ty) {
        var q = path.clone()
        q.push(k as u32)
        invariant_paths_in(p, f, q, &out)
    }
}

fn has(xs: [u32], x: u32) -> bool {
    for y in xs {
        if y == x { return true }
    }
    false
}

// The type of a place, through fields and borrows; None through a variant
// or an index.
fn place_type(t: Types, b: Body, pl: Place) -> Option(u32) {
    var ty = b.locals[pl.local as i64].ty
    for x in pl.proj {
        match x {
            Deref => match t.pointee(ty) {
                Some(y) => ty = y
                None => return None
            }
            Field(k) => {
                let fs = t.field_tys(ty)
                if (k as i64) >= fs.len() { return None }
                ty = fs[k as i64]
            }
            _ => return None
        }
    }
    Some(ty)
}

// A field of a place whose type has an invariant is written through it.
fn writes_through(p: Program, b: Body, pl: Place, inout out: Vec(u32)) {
    var q = Place.local(pl.local)
    for x in pl.proj {
        match x {
            Field(_) => match place_type(p.types, b, q) {
                Some(ty) => if p.invariants.contains(ty) && !has(out.as_slice(), ty) { out.push(ty) }
                None => {}
            }
            _ => {}
        }
        q.proj.push(x)
    }
}

// The types with an invariant of which the function is a writer: it
// assigns, lends or takes the address of one of their fields, or builds
// one.
fn invariant_writes(p: Program, b: Body) -> Vec(u32) {
    var out = Vec(u32).new()
    if p.invariants.len() == 0 { return out }
    for bl in b.blocks {
        for st in bl.stmts {
            match st {
                Assign(dst, rv, _) => {
                    writes_through(p, b, dst, &out)
                    match rv {
                        RefMut(q) | Addr(q) => writes_through(p, b, q, &out)
                        Aggregate(agg, _) => match agg {
                            Struct(ty) => if p.invariants.contains(ty) && !has(out.as_slice(), ty) {
                                out.push(ty)
                            }
                            _ => {}
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
    }
    out
}

// What a parameter holds: the place it borrows, or itself.
fn param_base(t: Types, b: Body, i: i64) -> Place {
    match t.kind(b.locals[i].ty) {
        Ref(_) | RefMut(_) => Place.local(i as u32).with(mir.Proj.Deref)
        _ => Place.local(i as u32)
    }
}

// What a call is given in an argument: the place a borrow lends, or the
// argument itself.
fn arg_base(t: Types, b: Body, lent: [Option(Place)], a: Operand) -> Option(Place) {
    let Copy(q) | Move(q) = a else { return None }
    if q.proj.len() == 0 {
        match lent[q.local as i64] {
            Some(x) => return Some(x.clone())
            None => {}
        }
    }
    let Some(ty) = place_type(t, b, q) else { return None }
    match t.kind(ty) {
        Ref(_) | RefMut(_) => Some(q.with(mir.Proj.Deref))
        _ => Some(q.clone())
    }
}

// What a call may change in an argument: the place it lends mutably.
fn lent_base(t: Types, b: Body, lent: [Option(Place)], a: Operand) -> Option(Place) {
    let Copy(q) | Move(q) = a else { return None }
    if q.proj.len() == 0 {
        match lent[q.local as i64] {
            Some(x) => return Some(x.clone())
            None => {}
        }
    }
    let Some(ty) = place_type(t, b, q) else { return None }
    match t.kind(ty) {
        RefMut(_) => Some(q.with(mir.Proj.Deref))
        _ => None
    }
}

// The places inside `base` whose fields its invariants name.
fn invariant_places(p: Program, b: Body, base: Place, inout out: Vec(Place)) {
    let Some(ty) = place_type(p.types, b, base) else { return }
    for (path, it) in invariant_paths(p, ty).into_iter() {
        let at = below_fields(base.clone(), path.as_slice())
        for c in p.invariants[it] {
            for x in c.atoms() {
                for term in x.a.terms { invariant_term_place(at, term, &out) }
                for term in x.b.terms { invariant_term_place(at, term, &out) }
            }
        }
    }
}

fn invariant_term_place(at: Place, term: mir.SpecTerm, inout out: Vec(Place)) {
    match term.name {
        Field(_, q) => out.push(below_fields(at.clone(), q.as_slice()))
        _ => {}
    }
}

// The invariants inside `base` as facts over the function's variables,
// of the types in `only`, or of all.
fn invariant_facts(
    p: Program,
    b: Body,
    m: Model,
    base: Place,
    only: Option([u32])
) -> Vec(vc.Holds) {
    var out = Vec(vc.Holds).new()
    let Some(ty) = place_type(p.types, b, base) else { return out }
    for (path, it) in invariant_paths(p, ty).into_iter() {
        match only {
            Some(xs) => if !has(xs, it) { continue }
            None => {}
        }
        let at = below_fields(base.clone(), path.as_slice())
        for c in p.invariants[it] {
            out.push(vc.Holds { ty: it as i64, fact: invariant_clause(m, at, c) })
        }
    }
    out
}

fn invariant_spec(m: Model, at: Place, x: mir.Spec) -> Option(linear.Lin) {
    if !small(x.constant) { return None }
    var out = linear.Lin.num(x.constant)
    for term in x.terms {
        let Field(_, q) = term.name else { return None }
        let Some(v) = variable(m, below_fields(at.clone(), q.as_slice())) else { return None }
        if term.coef != 0 {
            if !small(term.coef) { return None }
            out = out.plus(linear.Lin.of(v).scale(term.coef))
        }
    }
    Some(out)
}

fn invariant_clause(m: Model, at: Place, c: mir.Clause) -> vc.Fact {
    if c.ors.len() == 1 && c.ors[0].len() == 1 {
        let x = c.ors[0][0]
        let op = model_cmp(x.op).unwrap()
        return match (invariant_spec(m, at, x.a), invariant_spec(m, at, x.b)) {
            (Some(a), Some(b)) => vc.Fact.compare(op, a, b)
            _ => vc.unstated(op)
        }
    }
    var ors = Vec(Vec(vc.Cond)).new()
    var partial = false
    for alt in c.ors {
        var conj = Vec(vc.Cond).new()
        var known = true
        for x in alt {
            match (invariant_spec(m, at, x.a), invariant_spec(m, at, x.b)) {
                (Some(a), Some(b)) => conj.push(vc.Cond { op: model_cmp(x.op).unwrap(), a, b })
                _ => known = false
            }
        }
        if known { ors.push(conj) } else { partial = true }
    }
    vc.disjunction(ors, partial)
}

// The places the invariants need as variables: what the parameters hold,
// what calls give back or are lent, and in a writer, what calls are given,
// what is dropped, and the result.
fn invariant_wanted(p: Program, b: Body, lent: [Option(Place)], writes: [u32]) -> Vec(Place) {
    let t = p.types
    var out = Vec(Place).new()
    if p.invariants.len() == 0 { return out }
    for i in 1..b.arg_count + 1 { invariant_places(p, b, param_base(t, b, i), &out) }
    for bl in b.blocks {
        match bl.term {
            Call(_, args, dest, _, _) => {
                invariant_places(p, b, dest, &out)
                for a in args {
                    let base = if writes.len > 0 {
                        arg_base(t, b, lent, a)
                    } else { lent_base(t, b, lent, a) }
                    match base {
                        Some(x) => invariant_places(p, b, x, &out)
                        None => {}
                    }
                }
            }
            _ => {}
        }
        if writes.len > 0 {
            for st in bl.stmts {
                match st {
                    Drop(pl, _) => invariant_places(p, b, pl, &out)
                    _ => {}
                }
            }
        }
    }
    if writes.len > 0 { invariant_places(p, b, Place.local(mir.RET), &out) }
    out
}

// A function's invariants: assumed on entry, proved on return, and the
// types it is a writer of.
struct Invariants {
    holds_in: Vec(vc.Holds)
    holds_out: Vec(vc.Holds)
    writes: Vec(u32)
}

fn function_invariants(p: Program, f: mir.Function, b: Body, m: Model) -> Invariants {
    let t = p.types
    let writes = invariant_writes(p, b)
    var holds_in = Vec(vc.Holds).new()
    // A function called from outside the program may be given anything.
    let internal = match f.linkage {
        Internal => true
        _ => false
    }
    if internal {
        for i in 1..b.arg_count + 1 {
            for h in invariant_facts(p, b, m, param_base(t, b, i), None).into_iter() {
                holds_in.push(h)
            }
        }
    }
    var holds_out = Vec(vc.Holds).new()
    if writes.len() > 0 {
        let only = Some(writes.as_slice())
        for h in invariant_facts(p, b, m, Place.local(mir.RET), only).into_iter() {
            holds_out.push(h)
        }
        for i in 1..b.arg_count + 1 {
            match t.kind(b.locals[i].ty) {
                RefMut(_) => {
                    for h in invariant_facts(p, b, m, param_base(t, b, i), only).into_iter() {
                        holds_out.push(h)
                    }
                }
                _ => {}
            }
        }
    }
    Invariants { holds_in, holds_out, writes }
}

// At a call: a writer's obligations of what it is given, and what holds
// after it of what it gives back and is lent.
fn call_invariants(
    p: Program,
    b: Body,
    m: Model,
    writes: [u32],
    args: [Operand],
    dest: Place
) -> (Vec(vc.Holds), Vec(vc.Holds)) {
    let t = p.types
    var before = Vec(vc.Holds).new()
    var after = invariant_facts(p, b, m, dest, None)
    for a in args {
        if writes.len > 0 {
            match arg_base(t, b, m.lent.as_slice(), a) {
                Some(x) => {
                    for h in invariant_facts(p, b, m, x, Some(writes)).into_iter() { before.push(h) }
                }
                None => {}
            }
        }
        match lent_base(t, b, m.lent.as_slice(), a) {
            Some(x) => {
                for h in invariant_facts(p, b, m, x, None).into_iter() { after.push(h) }
            }
            None => {}
        }
    }
    (before, after)
}

// At a drop in a writer: the destructors' invariants.
fn drop_invariants(p: Program, b: Body, m: Model, writes: [u32], place: Place) -> Vec(vc.Holds) {
    if writes.len == 0 { return Vec(vc.Holds).new() }
    invariant_facts(p, b, m, place, Some(writes))
}

fn cmp_name(op: vc.Cmp) -> str {
    match op {
        Lt => "lt"
        Le => "le"
        Gt => "gt"
        Ge => "ge"
        Eq => "eq"
        Ne => "ne"
    }
}

// `(lin c (v k)...)`.
fn show_lin(inout s: String, x: linear.Lin) {
    s.push_str("(lin ")
    x.constant.show(&s)
    for t in x.terms {
        s.push_str(" (")
        t.0.show(&s)
        s.push(' ')
        t.1.show(&s)
        s.push(')')
    }
    s.push(')')
}

fn show_cond(inout s: String, op: vc.Cmp, a: linear.Lin, b: linear.Lin) {
    s.push('(')
    s.push_str(cmp_name(op))
    s.push(' ')
    show_lin(&s, a)
    s.push(' ')
    show_lin(&s, b)
    s.push(')')
}

// `(TYPE (op A B))`, or `(TYPE (or (and (op A B)...)...))`; a side over
// what the model does not follow is `(opaque escaped)`, and so is a case.
fn show_holds(inout s: String, h: vc.Holds) {
    s.push('(')
    h.ty.show(&s)
    s.push(' ')
    let x = h.fact
    if x.stated {
        show_cond(&s, x.op, x.a, x.b)
    } else if x.is_or() {
        s.push_str("(or")
        for alt in x.ors {
            s.push_str(" (and")
            for c in alt {
                s.push(' ')
                show_cond(&s, c.op, c.a, c.b)
            }
            s.push(')')
        }
        if x.partial {
            s.push(' ')
            opaque(&s, "escaped")
        }
        s.push(')')
    } else {
        s.push('(')
        s.push_str(cmp_name(x.op))
        s.push(' ')
        opaque(&s, "escaped")
        s.push(' ')
        opaque(&s, "escaped")
        s.push(')')
    }
    s.push(')')
}

// ` (WORD (TYPE FACT)...)`, nothing when there are none.
fn show_holds_list(inout s: String, word: str, hs: [vc.Holds]) {
    if hs.len == 0 { return }
    s.push_str(" (")
    s.push_str(word)
    for h in hs {
        s.push(' ')
        show_holds(&s, h)
    }
    s.push(')')
}

// ---- What a call needs of its caller's fields ----

// A function's interface: (parameter, fields) for each field of a
// parameter (0 for the result) that its contract names, or, in a function
// whose panics a call may prove away (`liftable`), that it reads.
pub type Interface = Vec((i64, Vec(u32)))

// Blocks in a function whose panics calls may prove away, at most.
pub const MAX_LIFT_BLOCKS: i64 = 32

// The function is small and has a call that never returns, or a trap.
pub fn liftable(b: Body) -> bool {
    if b.blocks.len() > MAX_LIFT_BLOCKS { return false }
    for bl in b.blocks {
        match bl.term {
            Call(callee, _, dest, _, _) => {
                match callee {
                    Intrinsic(i) => match i {
                        Trap => return true
                        _ => {}
                    }
                    _ => {}
                }
                if b.locals[dest.local as i64].ty == types.NEVER { return true }
            }
            _ => {}
        }
    }
    false
}

// The places of the fields the function's own contract names.
fn contract_places(t: Types, b: Body) -> Vec(Place) {
    var out = Vec(Place).new()
    var clauses = Vec(mir.Clause).new()
    for c in b.contract.requires { clauses.push(c.clone()) }
    for c in b.contract.ensures { clauses.push(c.clone()) }
    for x in b.contract.invariants { clauses.push(x.1.clone()) }
    for c in clauses {
        for x in c.atoms() {
            for term in x.a.terms { spec_field_place(t, b, term, &out) }
            for term in x.b.terms { spec_field_place(t, b, term, &out) }
        }
    }
    out
}

fn spec_field_place(t: Types, b: Body, term: mir.SpecTerm, inout out: Vec(Place)) {
    match term.name {
        Field(l, path) => out.push(spec_place(t, b, l, path.as_slice()))
        _ => {}
    }
}

pub fn interfaces(p: Program) -> Vec(Interface) {
    let t = p.types
    var out = Vec(Interface).new()
    for f in p.fns {
        var iface = Vec((i64, Vec(u32))).new()
        match f.body {
            Some(b) => {
                let places = contract_places(t, b)
                let lent = lendings(t, b)
                let fields = if liftable(b) {
                    find_fields(t, b, lent.as_slice(), places.as_slice())
                } else { find_fields_of(t, b, lent.as_slice(), places.as_slice()) }
                for x in fields {
                    if x.local as i64 <= b.arg_count { iface.push((x.local as i64, x.path.clone())) }
                }
            }
            None => {}
        }
        out.push(iface)
    }
    out
}

// The field variables of the places alone, not of what the body reads.
fn find_fields_of(t: Types, b: Body, lent: [Option(Place)], places: [Place]) -> Vec(FieldVar) {
    let ok = fields_ok(t, b, lent)
    var out = Vec(FieldVar).new()
    for p in places {
        let Some(f) = field_of(t, b, ok.as_slice(), p) else { continue }
        var seen = false
        for x in out {
            if x.local == p.local && x.path == f.1 { seen = true }
        }
        if !seen { out.push(FieldVar { local: p.local, deref: f.0, path: f.1.clone(), v: -1 }) }
    }
    out
}

// The caller's place of a callee's field: below the argument (through it
// when the parameter is a borrow; the place lent to it when the argument
// lends one), or below where the result goes.
fn caller_place(
    p: Program,
    lent: [Option(Place)],
    g: u32,
    args: [Operand],
    dest: Place,
    param: i64,
    path: [u32]
) -> Option(Place) {
    if param == 0 { return Some(below_fields(dest.clone(), path)) }
    if param - 1 >= args.len { return None }
    let Some(gb) = p.fns[g as i64].body else { return None }
    let borrowed = match p.types.kind(gb.locals[param].ty) {
        Ref(_) | RefMut(_) => true
        _ => false
    }
    match args[param - 1] {
        Copy(q) | Move(q) => {
            if borrowed {
                if q.proj.len() == 0 {
                    match lent[q.local as i64] {
                        Some(x) => return Some(below_fields(x.clone(), path))
                        None => {}
                    }
                }
                return Some(below_fields(q.with(mir.Proj.Deref), path))
            }
            Some(below_fields(q.clone(), path))
        }
        Const(_) => None
    }
}

fn below_fields(sink p: Place, path: [u32]) -> Place {
    var q = p
    for k in path { q.proj.push(mir.Proj.Field(k)) }
    q
}

// The places the function's calls need as variables, for the callees'
// interfaces.
fn call_places(p: Program, b: Body, lent: [Option(Place)], ifaces: [Interface]) -> Vec(Place) {
    var out = Vec(Place).new()
    for bl in b.blocks {
        match bl.term {
            Call(callee, args, dest, _, _) => match callee {
                Fn(g) => if (g as i64) < ifaces.len {
                    for x in ifaces[g as i64] {
                        match caller_place(p, lent, g, args.as_slice(), dest, x.0, x.1.as_slice()) {
                            Some(q) => out.push(q)
                            None => {}
                        }
                    }
                }
                _ => {}
            }
            _ => {}
        }
    }
    out
}

// The callee's fields at a call, as the caller's variables.
fn call_fields(
    p: Program,
    m: Model,
    callee: mir.Callee,
    args: [Operand],
    dest: Place,
    ifaces: [Interface]
) -> Vec(vc.FieldOf) {
    var out = Vec(vc.FieldOf).new()
    let Fn(g) = callee else { return out }
    if g as i64 >= ifaces.len { return out }
    for x in ifaces[g as i64] {
        let Some(q) = caller_place(p, m.lent.as_slice(), g, args, dest, x.0, x.1.as_slice()) else {
            continue
        }
        match variable(m, q) {
            Some(v) => out.push(vc.FieldOf { param: x.0, path: x.1.clone(), v })
            None => {}
        }
    }
    out
}

fn wanted(p: Program, b: Body, ifaces: [Interface]) -> Vec(Place) {
    let t = p.types
    var out = contract_places(t, b)
    let lent = lendings(t, b)
    for q in call_places(p, b, lent.as_slice(), ifaces).into_iter() { out.push(q) }
    let writes = invariant_writes(p, b)
    for q in invariant_wanted(p, b, lent.as_slice(), writes.as_slice()).into_iter() { out.push(q) }
    out
}

fn kind_text(t: Types, ty: u32) -> String {
    var s = String.new()
    match t.int(ty) {
        Some(n) => range(&s, n)
        None => s.push_str("bool")
    }
    s
}

fn model(t: Types, b: Body, wanted: [Place]) -> Model {
    let lent = lendings(t, b)
    let escaped = escapes(t, b, lent.as_slice())
    var m = Model {
        tracked: Vec(bool).new(), lengths: Vec(Option(i64)).new(),
        derefs: Vec(Option(i64)).filled(b.locals.len(), None), lent: lent.clone(),
        escaped: escaped.clone(), fields: find_fields(t, b, lent.as_slice(), wanted),
        by_local: Vec(Vec(i64)).filled(b.locals.len(), Vec(i64).new()),
        entries: Vec((i64, i64)).new(), kinds: Vec(String).new(), vkinds: Vec(vc.Kind).new(),
        count: b.locals.len()
    }
    for i, l in b.locals {
        let scalar = match t.kind(l.ty) {
            Int(_) | Bool => true
            _ => false
        }
        m.tracked.push(scalar && !escaped[i])
        if is_view(t, l.ty) && !escaped[i] {
            m.lengths.push(Some(m.count))
            m.count += 1
            m.kinds.push("(int 0 9223372036854775807)".to_string())
            m.vkinds.push(vc.len_range())
        } else { m.lengths.push(None) }
    }
    for i in 1..b.arg_count + 1 {
        match t.kind(b.locals[i].ty) {
            RefMut(inner) => if t.is_int(inner) && only_deref(b, lent.as_slice(), i as u32) {
                m.derefs[i] = Some(m.count)
                m.count += 1
                m.kinds.push(kind_text(t, inner))
                m.vkinds.push(ty_kind(t, inner))
            }
            _ => {}
        }
    }
    for i in 0..m.fields.len() {
        let (k, vk) = field_kind(t, b, m.fields[i])
        m.fields[i].v = m.count
        m.count += 1
        m.kinds.push(k)
        m.vkinds.push(vk)
        m.by_local[m.fields[i].local as i64].push(i)
    }
    // Each parameter's variables, as they were on entry.
    for i in 1..b.arg_count + 1 {
        var vars = Vec((i64, String, vc.Kind)).new()
        if m.tracked[i] && t.is_int(b.locals[i].ty) {
            vars.push((i, kind_text(t, b.locals[i].ty), ty_kind(t, b.locals[i].ty)))
        }
        match m.lengths[i] {
            Some(n) => vars.push((n, "(int 0 9223372036854775807)".to_string(), vc.len_range()))
            None => {}
        }
        match m.derefs[i] {
            Some(d) => vars.push((
                d,
                m.kinds[d - b.locals.len()].clone(),
                m.vkinds[d - b.locals.len()].clone()
            ))
            None => {}
        }
        for f in m.fields {
            if f.local as i64 == i {
                let d = f.v - b.locals.len()
                vars.push((f.v, m.kinds[d].clone(), m.vkinds[d].clone()))
            }
        }
        for (v, k, vk) in vars.into_iter() {
            m.entries.push((v, m.count))
            m.count += 1
            m.kinds.push(k)
            m.vkinds.push(vk)
        }
    }
    m
}

// The model variable a place is, if it is one: a tracked local, or the
// length (field 1) of a view local.
fn variable(m: Model, p: Place) -> Option(i64) {
    let l = p.local as i64
    if p.proj.len() == 0 {
        if m.tracked[l] { return Some(l) }
        return None
    }
    if p.proj.len() == 1 {
        match p.proj[0] {
            Field(1) => if m.lengths[l].is_some() { return m.lengths[l] }
            Deref => return m.derefs[l]
            _ => {}
        }
    }
    for i in m.by_local[l] {
        if field_place(m.fields[i]) == p { return Some(m.fields[i].v) }
    }
    None
}

// A value the model does not follow, and why: `(opaque why)`.
fn opaque(inout s: String, why: str) {
    s.push_str("(opaque ")
    s.push_str(why)
    s.push(')')
}

// Why a place is not a variable of the model.
fn place_reason(m: Model, p: Place) -> str {
    if p.proj.len() == 0 {
        return if m.escaped[p.local as i64] { "escaped" } else { "aggregate" }
    }
    for pr in p.proj {
        match pr {
            Deref => return "load"
            _ => {}
        }
    }
    match p.proj[0] {
        Field(_) => "field"
        Variant(_) => "variant"
        Index(_) => "element"
        Deref => "load"
    }
}

fn operand(inout s: String, t: Types, m: Model, o: Operand) {
    match o {
        Copy(p) | Move(p) => match variable(m, p) {
            Some(v) => {
                s.push_str("(local ")
                v.show(&s)
                s.push(')')
            }
            None => opaque(&s, place_reason(m, p))
        }
        Const(c) => match c {
            Int(v, ty) => {
                // The constant's value, not its sign-extended bits.
                var x = v
                match t.int(ty) {
                    Some(i) => if !i.signed && x < 0 && i.bits < 128 {
                        let one: i128 = 1
                        x = x + (one << i.bits as i128)
                    }
                    None => {}
                }
                s.push_str("(const ")
                x.show(&s)
                s.push(')')
            }
            Bool(b) => s.push_str(if b { "(const 1)" } else { "(const 0)" })
            _ => opaque(&s, "constant")
        }
    }
}

fn compare(op: lex.Op) -> Option(str) {
    match op {
        Lt => Some("lt")
        Le => Some("le")
        Gt => Some("gt")
        Ge => Some("ge")
        Eq => Some("eq")
        Ne => Some("ne")
        _ => None
    }
}

fn binary(inout s: String, t: Types, m: Model, name: str, a: Operand, b: Operand) {
    s.push('(')
    s.push_str(name)
    s.push(' ')
    operand(&s, t, m, a)
    s.push(' ')
    operand(&s, t, m, b)
    s.push(')')
}

// The value of an rvalue assigned to an integer or bool variable.
fn rvalue(inout s: String, p: Program, b: Body, m: Model, rv: mir.Rvalue) {
    let t = p.types
    match rv {
        Use(o) => {
            s.push_str("(use ")
            operand(&s, t, m, o)
            s.push(')')
        }
        // Without overflow checks `+` wraps, modulo the type's size; `*`
        // then is not followed.
        Bin(op, x, y) => match op {
            Add => binary(&s, t, m, if p.checked { "add" } else { "add-wrap" }, x, y)
            Sub => binary(&s, t, m, if p.checked { "sub" } else { "sub-wrap" }, x, y)
            Mul => if p.checked { binary(&s, t, m, "mul", x, y) } else { opaque(&s, "wrap") }
            AddWrap => binary(&s, t, m, "add-wrap", x, y)
            SubWrap => binary(&s, t, m, "sub-wrap", x, y)
            And | LogAnd => {
                if is_bool(t, b, x) { binary(&s, t, m, "and", x, y) } else { opaque(&s, "bits") }
            }
            _ => match compare(op) {
                Some(c) => if is_bool(t, b, x) {
                    opaque(&s, "bool")
                } else {
                    s.push_str("(cmp ")
                    s.push_str(c)
                    s.push(' ')
                    operand(&s, t, m, x)
                    s.push(' ')
                    operand(&s, t, m, y)
                    s.push(')')
                }
                None => opaque(&s, match op {
                    Div => "div"
                    Rem => "rem"
                    MulWrap => "wrap"
                    Shl | Shr => "shift"
                    LogOr => "bool"
                    _ => "bits"
                })
            }
        }
        Un(op, x) => match op {
            Not => if is_bool(t, b, x) {
                s.push_str("(not ")
                operand(&s, t, m, x)
                s.push(')')
            } else { opaque(&s, "bits") }
            Neg => opaque(&s, "neg")
        }
        Cast(x, _, kind) => match kind {
            Numeric => {
                s.push_str("(cast ")
                operand(&s, t, m, x)
                s.push(')')
            }
            Ptr => opaque(&s, "pointer")
        }
        Discriminant(_) => opaque(&s, "tag")
        _ => opaque(&s, "aggregate")
    }
}

fn is_bool(t: Types, b: Body, o: Operand) -> bool {
    match o {
        Copy(p) | Move(p) => p.proj.len() == 0 && b.locals[p.local as i64].ty == types.BOOL
        Const(c) => match c {
            Bool(_) => true
            _ => false
        }
    }
}

fn set(inout s: String, v: i64) {
    s.push_str("\n    (set ")
    v.show(&s)
    s.push(' ')
}

fn statement(inout s: String, p: Program, b: Body, m: Model, writes: [u32], st: mir.Stmt) {
    let t = p.types
    match st {
        Assign(place, rv, span) => {
            let l = place.local as i64
            match variable(m, place) {
                Some(v) => {
                    set(&s, v)
                    rvalue(&s, p, b, m, rv)
                    // Where an overflow check fails, as the interpreter reports it.
                    match rv {
                        Bin(op, _, _) => match op {
                            Add | Sub | Mul => if p.checked { at(&s, span) }
                            _ => {}
                        }
                        _ => {}
                    }
                    s.push(')')
                }
                None => {}
            }
            // A view assigned whole has a new length; a part written
            // through the view's local leaves the length unknown.
            match m.lengths[l] {
                Some(n) => {
                    set(&s, n)
                    var known = false
                    if place.proj.len() == 0 {
                        match rv {
                            Use(o) => match o {
                                Copy(q) | Move(q) => match variable(m, q.with(mir.Proj.Field(1))) {
                                    Some(k) => {
                                        s.push_str("(use (local ")
                                        k.show(&s)
                                        s.push_str("))")
                                        known = true
                                    }
                                    None => {}
                                }
                                _ => {}
                            }
                            Aggregate(agg, os) => match agg {
                                View(_) => if os.len() == 2 {
                                    s.push_str("(use ")
                                    operand(&s, t, m, os[1])
                                    s.push(')')
                                    known = true
                                }
                                _ => {}
                            }
                            _ => {}
                        }
                    }
                    if !known { opaque(&s, "length") }
                    s.push(')')
                }
                None => {}
            }
            for w in field_writes(t, m, place, rv) {
                set(&s, w.0)
                show_copy(&s, w.1)
                s.push(')')
            }
        }
        Drop(place, span) => {
            // `(check TYPE FACT (at lo hi))`: a destructor's invariant, in a writer.
            for h in drop_invariants(p, b, m, writes, place).into_iter() {
                s.push_str("\n    (check ")
                show_holds(&s, h)
                at(&s, span)
                s.push(')')
            }
            for v in fields_in(m, place) {
                set(&s, v)
                opaque(&s, "field")
                s.push(')')
            }
            match variable(m, place) {
                Some(v) => {
                    set(&s, v)
                    opaque(&s, "field")
                    s.push(')')
                }
                None => {}
            }
        }
        _ => {}
    }
}

// A value `field_writes` gives: a copy of an operand, or an opaque value.
fn show_copy(inout s: String, rv: vc.Rvalue) {
    match rv {
        Use(o) => {
            s.push_str("(use ")
            match o {
                Local(v) => {
                    s.push_str("(local ")
                    v.show(&s)
                    s.push(')')
                }
                Const(c) => {
                    s.push_str("(const ")
                    c.show(&s)
                    s.push(')')
                }
                Opaque(w) => opaque(&s, vc.why_name(w))
            }
            s.push(')')
        }
        Opaque(w) => opaque(&s, vc.why_name(w))
        _ => opaque(&s, "other")
    }
}

// A source span as byte offsets: ` (at lo hi)`.
fn at(inout s: String, span: diag.Span) {
    s.push_str(" (at ")
    span.lo.show(&s)
    s.push(' ')
    span.hi.show(&s)
    s.push(')')
}

// Text as one atom: what would end it or open a list becomes `-`.
pub fn atom(inout s: String, text: str) {
    for c in text.as_bytes() {
        if c == ' ' || c == '(' || c == ')' || c == ';' || c == '\n' || c == '\t' {
            s.push('-')
        } else { s.push(c) }
    }
}

// A call's argument: an integer, a view by its length, a variable lent to
// an `inout` parameter (`(lent v)`), or what the model does not follow.
fn argument(inout s: String, t: Types, m: Model, a: Operand) {
    match a {
        Copy(q) | Move(q) => if q.proj.len() == 0 {
            let l = q.local as i64
            match m.lent[l] {
                Some(x) => {
                    match variable(m, x) {
                        Some(v) => {
                            s.push_str("(lent ")
                            v.show(&s)
                            s.push(')')
                        }
                        None => opaque(&s, "escaped")
                    }
                    return
                }
                None => {}
            }
            match m.lengths[l] {
                Some(n) => {
                    s.push_str("(view ")
                    n.show(&s)
                    s.push(')')
                    return
                }
                None => {}
            }
        }
        _ => {}
    }
    operand(&s, t, m, a)
}

// The place of a contract's field term: through the local if it is a borrow.
fn spec_place(t: Types, b: Body, l: u32, path: [u32]) -> Place {
    var p = Place.local(l)
    match t.kind(b.locals[l as i64].ty) {
        Ref(_) | RefMut(_) => p.proj.push(mir.Proj.Deref)
        _ => {}
    }
    for k in path { p.proj.push(mir.Proj.Field(k)) }
    p
}

// The variable a contract's term names, if the model has one.
fn spec_variable(t: Types, b: Body, m: Model, x: mir.SpecTerm) -> Option(i64) {
    let v = match x.name {
        Local(l) => if m.tracked[l as i64] { Some(l as i64) } else { None }
        Deref(l) => m.derefs[l as i64]
        Len(l) => m.lengths[l as i64]
        Field(l, path) => variable(m, spec_place(t, b, l, path.as_slice()))
    }
    if !x.old { return v }
    let Some(v) = v else { return None }
    for e in m.entries {
        if e.0 == v { return Some(e.1) }
    }
    None
}

// `(lin c (v k)...)`: `c` plus `k` times each variable `v`.
fn spec(inout s: String, t: Types, b: Body, m: Model, x: mir.Spec) {
    for term in x.terms {
        if spec_variable(t, b, m, term).is_none() {
            opaque(&s, "escaped")
            return
        }
    }
    s.push_str("(lin ")
    x.constant.show(&s)
    for term in x.terms {
        if term.coef != 0 {
            s.push_str(" (")
            spec_variable(t, b, m, term).unwrap().show(&s)
            s.push(' ')
            term.coef.show(&s)
            s.push(')')
        }
    }
    s.push(')')
}

// `(requires (le A B) (at lo hi))`, and `(invariant BLOCK (le A B) (at lo hi))`;
// a clause with `||` is `(or (and (le A B)...)...)` in place of `(le A B)`.
fn clause(
    inout s: String,
    t: Types,
    b: Body,
    m: Model,
    word: str,
    block: Option(u32),
    c: mir.Clause
) {
    s.push_str("\n  (")
    s.push_str(word)
    match block {
        Some(b) => {
            s.push(' ')
            b.show(&s)
        }
        None => {}
    }
    s.push(' ')
    if c.ors.len() == 1 && c.ors[0].len() == 1 {
        comparison(&s, t, b, m, c.ors[0][0])
    } else {
        s.push_str("(or")
        for alt in c.ors {
            s.push_str(" (and")
            for x in alt {
                s.push(' ')
                comparison(&s, t, b, m, x)
            }
            s.push(')')
        }
        s.push(')')
    }
    at(&s, c.span)
    s.push(')')
}

// `(le A B)`.
fn comparison(inout s: String, t: Types, b: Body, m: Model, c: mir.Compare) {
    s.push('(')
    s.push_str(compare(c.op).unwrap())
    s.push(' ')
    spec(&s, t, b, m, c.a)
    s.push(' ')
    spec(&s, t, b, m, c.b)
    s.push(')')
}

fn terminator(
    inout s: String,
    p: Program,
    b: Body,
    m: Model,
    writes: [u32],
    term: mir.Term,
    ifaces: [Interface]
) {
    let t = p.types
    s.push_str("\n    ")
    match term {
        Goto(x) => {
            s.push_str("(goto ")
            x.show(&s)
            s.push(')')
        }
        Switch(o, targets, other) => {
            var done = false
            if targets.len() == 1 && targets[0].value == 0 {
                match o {
                    Copy(q) | Move(q) => match variable(m, q) {
                        Some(v) => {
                            s.push_str("(switch ")
                            v.show(&s)
                            s.push(' ')
                            targets[0].block.show(&s)
                            s.push(' ')
                            other.show(&s)
                            s.push(')')
                            done = true
                        }
                        None => {}
                    }
                    _ => {}
                }
            }
            // Any of the targets, without knowing which.
            if !done {
                s.push_str("(any")
                for x in targets {
                    s.push(' ')
                    x.block.show(&s)
                }
                s.push(' ')
                other.show(&s)
                s.push(')')
            }
        }
        Return => s.push_str("(return)")
        Unreachable | Pending => s.push_str("(unreachable)")
        Call(callee, args, dest, next, span) => {
            match callee {
                Intrinsic(i) => match i {
                    Trap => {
                        s.push_str("(trap")
                        at(&s, span)
                        s.push(')')
                        return
                    }
                    _ => {}
                }
                _ => {}
            }
            s.push_str("(call ")
            match variable(m, dest) {
                Some(v) => v.show(&s)
                None => s.push('_')
            }
            s.push(' ')
            next.show(&s)
            // The callee, whose contract the call proves and assumes, and
            // the arguments as the contract sees them.
            match callee {
                Fn(f) => {
                    s.push_str(" (fn ")
                    atom(&s, p.fns[f as i64].symbol.as_str())
                    s.push(')')
                }
                _ => {}
            }
            s.push_str(" (args")
            for a in args {
                s.push(' ')
                argument(&s, t, m, a)
            }
            s.push(')')
            // A callee that never returns: the call must not be reached.
            if b.locals[dest.local as i64].ty == types.NEVER { s.push_str(" (never)") }
            // The fields the call may change, besides its result.
            let changes = call_changes(t, b, m, args.as_slice(), dest)
            if changes.len() > 0 {
                s.push_str(" (changes")
                for v in changes {
                    s.push(' ')
                    v.show(&s)
                }
                s.push(')')
            }
            // The callee's fields as variables here: `(PARAM VAR FIELD...)`.
            let fields = call_fields(p, m, callee, args.as_slice(), dest, ifaces)
            if fields.len() > 0 {
                s.push_str(" (fields")
                for x in fields {
                    s.push_str(" (")
                    x.param.show(&s)
                    s.push(' ')
                    x.v.show(&s)
                    for k in x.path {
                        s.push(' ')
                        k.show(&s)
                    }
                    s.push(')')
                }
                s.push(')')
            }
            // Types' invariants: a writer's obligations, and what holds after.
            let (before, after) = call_invariants(p, b, m, writes, args.as_slice(), dest)
            show_holds_list(&s, "before", before.as_slice())
            show_holds_list(&s, "after", after.as_slice())
            at(&s, span)
            s.push(')')
        }
        Assert(o, msg, next, span) => {
            s.push_str("(assert ")
            operand(&s, t, m, o)
            s.push(' ')
            atom(&s, msg.as_str())
            s.push(' ')
            next.show(&s)
            at(&s, span)
            s.push(')')
        }
    }
}

pub fn show_function(p: Program, f: mir.Function, ifaces: [Interface]) -> String {
    let t = p.types
    var s = String.new()
    let Some(b) = f.body else { return s }
    let m = model(t, b, wanted(p, b, ifaces).as_slice())
    s.push_str("(function ")
    atom(&s, f.name.as_str())
    s.push(' ')
    atom(&s, f.symbol.as_str())
    s.push_str("\n  (args ")
    b.arg_count.show(&s)
    s.push_str(")\n  (locals")
    for i, l in b.locals {
        s.push(' ')
        if !m.tracked[i] {
            s.push_str("other")
        } else {
            match t.int(l.ty) {
                Some(n) => range(&s, n)
                None => s.push_str("bool")
            }
        }
    }
    // The lengths (never negative), the `inout` integers and the values on
    // entry, after the locals.
    for k in m.kinds {
        s.push(' ')
        s.push_str(k.as_str())
    }
    s.push_str(")\n  (lengths")
    for i in 0..b.locals.len() {
        match m.lengths[i] {
            Some(n) => {
                s.push_str(" (")
                i.show(&s)
                s.push(' ')
                n.show(&s)
                s.push(')')
            }
            None => {}
        }
    }
    s.push_str(")\n  (derefs")
    for i in 0..b.locals.len() {
        match m.derefs[i] {
            Some(d) => {
                s.push_str(" (")
                i.show(&s)
                s.push(' ')
                d.show(&s)
                s.push(')')
            }
            None => {}
        }
    }
    s.push_str(")\n  (fields")
    for f in m.fields {
        s.push_str(" (")
        f.v.show(&s)
        s.push(' ')
        f.local.show(&s)
        if f.deref { s.push_str(" *") }
        for k in f.path {
            s.push(' ')
            k.show(&s)
        }
        s.push(')')
    }
    s.push_str(")\n  (entries")
    for e in m.entries {
        s.push_str(" (")
        e.0.show(&s)
        s.push(' ')
        e.1.show(&s)
        s.push(')')
    }
    s.push(')')
    for c in b.contract.requires { clause(&s, t, b, m, "requires", None, c) }
    for c in b.contract.ensures { clause(&s, t, b, m, "ensures", None, c) }
    for x in b.contract.invariants { clause(&s, t, b, m, "invariant", Some(x.0), x.1) }
    // Types' invariants: of what the parameters hold, and in a writer, of
    // what it gives back.
    let inv = function_invariants(p, f, b, m)
    if inv.holds_in.len() > 0 {
        s.push_str("\n ")
        show_holds_list(&s, "holds-in", inv.holds_in.as_slice())
    }
    if inv.holds_out.len() > 0 {
        s.push_str("\n ")
        show_holds_list(&s, "holds-out", inv.holds_out.as_slice())
    }
    for i, bl in b.blocks {
        s.push_str("\n  (block ")
        i.show(&s)
        for st in bl.stmts { statement(&s, p, b, m, inv.writes.as_slice(), st) }
        terminator(&s, p, b, m, inv.writes.as_slice(), bl.term, ifaces)
        s.push(')')
    }
    s.push_str(")\n")
    s
}

// The same model as data, for the verifier (`vc.jh`): what `show_function`
// prints, read as jihoo-proofs' `load.jh` reads it. Numbers beyond 64 bits
// are not followed, since the checker keeps its numbers below 2^65.

fn small(v: i128) -> bool {
    let one: i128 = 1
    v >= 0 - (one << 63) && v < (one << 64)
}

fn int_kind(i: types.IntTy) -> vc.Kind {
    if i.bits >= 128 { return vc.Kind.Other }
    let one: i128 = 1
    if i.signed {
        let limit = one << (i.bits - 1) as i128
        vc.Kind.Int(0 - limit, limit - 1)
    } else { vc.Kind.Int(0, (one << i.bits as i128) - 1) }
}

fn ty_kind(t: Types, ty: u32) -> vc.Kind {
    match t.int(ty) {
        Some(n) => int_kind(n)
        None => vc.Kind.Other
    }
}

fn model_operand(t: Types, m: Model, o: Operand) -> vc.Operand {
    match o {
        Copy(p) | Move(p) => match variable(m, p) {
            Some(v) => vc.Operand.Local(v)
            None => vc.Operand.Opaque(vc.why_code(place_reason(m, p)))
        }
        Const(c) => match c {
            Int(v, ty) => {
                var x = v
                match t.int(ty) {
                    Some(i) => if !i.signed && x < 0 && i.bits < 128 {
                        let one: i128 = 1
                        x = x + (one << i.bits as i128)
                    }
                    None => {}
                }
                if small(x) { vc.Operand.Const(x) } else { vc.Operand.Opaque(vc.why_code(
                    "constant"
                )) }
            }
            Bool(b) => vc.Operand.Const(if b { 1 } else { 0 })
            _ => vc.Operand.Opaque(vc.why_code("constant"))
        }
    }
}

fn model_cmp(op: lex.Op) -> Option(vc.Cmp) {
    match op {
        Lt => Some(vc.Cmp.Lt)
        Le => Some(vc.Cmp.Le)
        Gt => Some(vc.Cmp.Gt)
        Ge => Some(vc.Cmp.Ge)
        Eq => Some(vc.Cmp.Eq)
        Ne => Some(vc.Cmp.Ne)
        _ => None
    }
}

fn opaque_rv(why: str) -> vc.Rvalue { vc.Rvalue.Opaque(vc.why_code(why)) }

fn model_rvalue(p: Program, b: Body, m: Model, rv: mir.Rvalue) -> vc.Rvalue {
    let t = p.types
    match rv {
        Use(o) => vc.Rvalue.Use(model_operand(t, m, o))
        Bin(op, x, y) => {
            let a = model_operand(t, m, x)
            let c = model_operand(t, m, y)
            match op {
                Add => if p.checked { vc.Rvalue.Add(a, c) } else { vc.Rvalue.AddWrap(a, c) }
                Sub => if p.checked { vc.Rvalue.Sub(a, c) } else { vc.Rvalue.SubWrap(a, c) }
                Mul => if p.checked { vc.Rvalue.Mul(a, c) } else { opaque_rv("wrap") }
                AddWrap => vc.Rvalue.AddWrap(a, c)
                SubWrap => vc.Rvalue.SubWrap(a, c)
                And | LogAnd => if is_bool(t, b, x) { vc.Rvalue.And(a, c) } else { opaque_rv("bits") }
                _ => match model_cmp(op) {
                    Some(k) => if is_bool(t, b, x) { opaque_rv("bool") } else { vc.Rvalue.Compare(
                        k,
                        a,
                        c
                    ) }
                    None => opaque_rv(match op {
                        Div => "div"
                        Rem => "rem"
                        MulWrap => "wrap"
                        Shl | Shr => "shift"
                        LogOr => "bool"
                        _ => "bits"
                    })
                }
            }
        }
        Un(op, x) => match op {
            Not => if is_bool(t, b, x) { vc.Rvalue.Not(model_operand(t, m, x)) } else { opaque_rv(
                "bits"
            ) }
            Neg => opaque_rv("neg")
        }
        Cast(x, _, kind) => match kind {
            Numeric => vc.Rvalue.Cast(model_operand(t, m, x))
            Ptr => opaque_rv("pointer")
        }
        Discriminant(_) => opaque_rv("tag")
        _ => opaque_rv("aggregate")
    }
}

fn span_of(s: diag.Span) -> (i64, i64) { (s.lo as i64, s.hi as i64) }

fn model_stmts(
    p: Program,
    b: Body,
    m: Model,
    writes: [u32],
    block: i64,
    bl: mir.Block
) -> Vec(vc.Stmt) {
    let t = p.types
    var out = Vec(vc.Stmt).new()
    for i, st in bl.stmts {
        match st {
            Assign(place, rv, span) => {
                let l = place.local as i64
                match variable(m, place) {
                    Some(v) => {
                        let checked = match rv {
                            Bin(op, _, _) => match op {
                                Add | Sub | Mul => p.checked
                                _ => false
                            }
                            _ => false
                        }
                        let at = if checked { span_of(span) } else { vc.nowhere() }
                        out.push(vc.Stmt.Assign(v, model_rvalue(p, b, m, rv), at, (block, i)))
                    }
                    None => {}
                }
                match m.lengths[l] {
                    Some(n) => {
                        var value = opaque_rv("length")
                        if place.proj.len() == 0 {
                            match rv {
                                Use(o) => match o {
                                    Copy(q) | Move(q) => match variable(
                                        m,
                                        q.with(mir.Proj.Field(1))
                                    ) {
                                        Some(k) => value = vc.Rvalue.Use(vc.Operand.Local(k))
                                        None => {}
                                    }
                                    _ => {}
                                }
                                Aggregate(agg, os) => match agg {
                                    View(_) => if os.len() == 2 {
                                        value = vc.Rvalue.Use(model_operand(t, m, os[1]))
                                    }
                                    _ => {}
                                }
                                _ => {}
                            }
                        }
                        out.push(vc.Stmt.Assign(n, value, vc.nowhere(), (block, i)))
                    }
                    None => {}
                }
                for w in field_writes(t, m, place, rv).into_iter() {
                    out.push(vc.Stmt.Assign(w.0, w.1, vc.nowhere(), (block, i)))
                }
            }
            // What a destructor leaves is not followed. In a writer, the
            // destructors' invariants must hold.
            Drop(place, span) => {
                for h in drop_invariants(p, b, m, writes, place).into_iter() {
                    out.push(vc.Stmt.Check(h, span_of(span)))
                }
                for v in fields_in(m, place) {
                    out.push(vc.Stmt.Assign(v, opaque_rv("field"), vc.nowhere(), (block, i)))
                }
                match variable(m, place) {
                    Some(v) => out.push(vc.Stmt.Assign(
                        v,
                        opaque_rv("field"),
                        vc.nowhere(),
                        (block, i)
                    ))
                    None => {}
                }
            }
            _ => {}
        }
    }
    out
}

fn model_argument(t: Types, m: Model, a: Operand) -> vc.Arg {
    match a {
        Copy(q) | Move(q) => if q.proj.len() == 0 {
            let l = q.local as i64
            match m.lent[l] {
                Some(x) => return match variable(m, x) {
                    Some(v) => vc.Arg.Lent(v)
                    None => vc.Arg.Value(vc.Operand.Opaque(vc.why_code("escaped")))
                }
                None => {}
            }
            match m.lengths[l] {
                Some(n) => return vc.Arg.View(n)
                None => {}
            }
        }
        _ => {}
    }
    vc.Arg.Value(model_operand(t, m, a))
}

fn model_term(
    p: Program,
    b: Body,
    m: Model,
    writes: [u32],
    term: mir.Term,
    ifaces: [Interface]
) -> vc.Term {
    let t = p.types
    match term {
        Goto(x) => vc.Term.Goto(x as i64)
        Switch(o, targets, other) => {
            if targets.len() == 1 && targets[0].value == 0 {
                match o {
                    Copy(q) | Move(q) => match variable(m, q) {
                        Some(v) => return vc.Term.Switch(v, targets[0].block as i64, other as i64)
                        None => {}
                    }
                    _ => {}
                }
            }
            var bs = Vec(i64).new()
            for x in targets { bs.push(x.block as i64) }
            bs.push(other as i64)
            vc.Term.Any(bs)
        }
        Return => vc.Term.Return
        Unreachable | Pending => vc.Term.Unreachable
        Call(callee, args, dest, next, span) => {
            match callee {
                Intrinsic(i) => match i {
                    Trap => return vc.Term.Trap(span_of(span))
                    _ => {}
                }
                _ => {}
            }
            let dst = match variable(m, dest) {
                Some(v) => v
                None => -1
            }
            var site = vc.CallSite {
                callee: match callee {
                    Fn(f) => f as i64
                    _ => -1
                },
                args: Vec(vc.Arg).new(),
                at: span_of(span),
                changes: call_changes(t, b, m, args.as_slice(), dest),
                never: b.locals[dest.local as i64].ty == types.NEVER,
                result_len: result_length(m, dest),
                fields: call_fields(p, m, callee, args.as_slice(), dest, ifaces),
                before: Vec(vc.Holds).new(),
                after: Vec(vc.Holds).new()
            }
            let (before, after) = call_invariants(p, b, m, writes, args.as_slice(), dest)
            site.before = before
            site.after = after
            for a in args { site.args.push(model_argument(t, m, a)) }
            vc.Term.Call(dst, next as i64, site)
        }
        Assert(o, msg, next, span) => {
            let c = match model_operand(t, m, o) {
                Local(l) => l
                _ => -1
            }
            vc.Term.Assert(c, msg.clone(), next as i64, span_of(span))
        }
    }
}

fn model_spec(t: Types, b: Body, m: Model, x: mir.Spec) -> Option(linear.Lin) {
    if !small(x.constant) { return None }
    var out = linear.Lin.num(x.constant)
    for term in x.terms {
        let Some(v) = spec_variable(t, b, m, term) else { return None }
        if term.coef != 0 {
            if !small(term.coef) { return None }
            out = out.plus(linear.Lin.of(v).scale(term.coef))
        }
    }
    Some(out)
}

fn model_clause(t: Types, b: Body, m: Model, c: mir.Clause) -> vc.Fact {
    if c.ors.len() == 1 && c.ors[0].len() == 1 {
        let x = c.ors[0][0]
        let op = model_cmp(x.op).unwrap()
        return match (model_spec(t, b, m, x.a), model_spec(t, b, m, x.b)) {
            (Some(a), Some(b)) => vc.Fact.compare(op, a, b)
            _ => vc.unstated(op)
        }
    }
    // An alternative over what the model does not follow is left out.
    var ors = Vec(Vec(vc.Cond)).new()
    var partial = false
    for alt in c.ors {
        var conj = Vec(vc.Cond).new()
        var known = true
        for x in alt {
            match (model_spec(t, b, m, x.a), model_spec(t, b, m, x.b)) {
                (Some(a), Some(b)) => conj.push(vc.Cond { op: model_cmp(x.op).unwrap(), a, b })
                _ => known = false
            }
        }
        if known { ors.push(conj) } else { partial = true }
    }
    vc.disjunction(ors, partial)
}

// The model of a function with a body, as the verifier reads it.
pub fn model_of(p: Program, f: mir.Function, ifaces: [Interface]) -> Option(vc.Function) {
    let t = p.types
    let Some(b) = f.body else { return None }
    let m = model(t, b, wanted(p, b, ifaces).as_slice())
    var kinds = Vec(vc.Kind).new()
    for i, l in b.locals {
        kinds.push(if m.tracked[i] { ty_kind(t, l.ty) } else { vc.Kind.Other })
    }
    for k in m.vkinds { kinds.push(k.clone()) }
    var lengths = Vec((i64, i64)).new()
    var derefs = Vec((i64, i64)).new()
    for i in 0..b.locals.len() {
        match m.lengths[i] {
            Some(n) => lengths.push((i, n))
            None => {}
        }
        match m.derefs[i] {
            Some(d) => derefs.push((i, d))
            None => {}
        }
    }
    // The parameters' fields and the result's, for the callers.
    var fields = Vec(vc.FieldOf).new()
    for x in m.fields {
        if x.local as i64 <= b.arg_count {
            fields.push(vc.FieldOf { param: x.local as i64, path: x.path.clone(), v: x.v })
        }
    }
    var requires = Vec(vc.Fact).new()
    for c in b.contract.requires { requires.push(model_clause(t, b, m, c)) }
    var ensures = Vec(vc.Fact).new()
    for c in b.contract.ensures { ensures.push(model_clause(t, b, m, c)) }
    var invariants = Vec((i64, Vec(vc.Fact))).new()
    for x in b.contract.invariants {
        let c = model_clause(t, b, m, x.1)
        var found = false
        for i in 0..invariants.len() {
            if invariants[i].0 == x.0 as i64 {
                invariants[i].1.push(c.clone())
                found = true
            }
        }
        if !found {
            var cs = Vec(vc.Fact).new()
            cs.push(c)
            invariants.push((x.0 as i64, cs))
        }
    }
    let inv = function_invariants(p, f, b, m)
    let writes = inv.writes.clone()
    var written = Vec(i64).new()
    for ty in writes { written.push(ty as i64) }
    var blocks = Vec(vc.Block).new()
    for i, bl in b.blocks {
        blocks.push(vc.Block {
            stmts: model_stmts(p, b, m, writes.as_slice(), i, bl),
            term: model_term(p, b, m, writes.as_slice(), bl.term, ifaces)
        })
    }
    Some(vc.Function {
        name: f.name.clone(),
        kinds: kinds.clone(),
        blocks,
        invariants,
        callee: vc.Callee {
            symbol: f.symbol.clone(), kinds, args: b.arg_count, lengths, derefs, fields,
            entries: m.entries.clone(), requires, ensures
        },
        liftable: liftable(b),
        holds_in: inv.holds_in.clone(),
        holds_out: inv.holds_out.clone(),
        writes: written
    })
}
