// A small textual input for the dependent core. This is an experimental
// core format, not an alternate semantics for ordinary .jh programs.
import core
import diag
import std.mem

fn natural(s: str) -> Option(u64) {
    if s.len == 0 { return None }
    var n: u64 = 0
    let maximum: u64 = 0xffffffffffffffff
    for c in s {
        if c < '0' || c > '9' { return None }
        let digit = (c - '0') as u64
        if n > (maximum - digit) / 10 { return None }
        n = n * 10 + digit
    }
    Some(n)
}

fn signed(s: str) -> Option(i64) {
    if s.len == 0 { return None }
    let negative = s[0] == '-'
    let start = if negative || s[0] == '+' { 1 } else { 0 }
    let Some(n) = natural(s[start..s.len]) else { return None }
    let bound: u64 = if negative { 0x8000000000000000 } else { 0x7fffffffffffffff }
    if n > bound { return None }
    let v = n as i128
    Some((if negative { 0 - v } else { v }) as i64)
}

struct Token {
    text: String
    span: diag.Span
}

fn ident(s: str) -> bool {
    if s.len == 0 { return false }
    for i, c in s {
        if c == '_' || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') { continue }
        if i > 0 && c >= '0' && c <= '9' { continue }
        return false
    }
    s != "U64" && s != "I64" && s != "Prop"
}

fn form_head(s: str) -> bool {
    s == "pi" || s == "pi0" || s == "lam" || s == "lam0" || s == "app" ||
        s == "Array" || s == "refl" || s == "transport" || s == "Eq" || s == "Lt" ||
        s == "Type" || s == "int" || s == "array" || s == "index" || s == "induct" ||
        s == "inductive" || s == "def" || s == "export" || s == "if-lt" ||
        s == "if-eq" || s == "decide-lt" || s == "add" || s == "sub" || s == "mul" ||
        s == "fold" || s == "uadd" || s == "lt-add" || s == "lt-cancel" || s == "lt-le" ||
        s == "usub" || s == "zero-le" || s == "Refine" || s == "pack" || s == "witness" ||
        s == "proof" || s == "data" || s == "Buffer" || s == "alloc" || s == "load" ||
        s == "store" || s == "free" || s == "case" || s == "drop" ||
        s == "Ref" || s == "lend" || s == "view" || s == "view-rec"
}

struct Parser {
    tokens: Vec(Token)
    pos: i64
    end: diag.Span
    core: core.Core
    names: Vec(String)
}

impl Parser {
    fn error(self, msg: str) -> diag.Diag {
        let span = if self.pos < self.tokens.len() { self.tokens[self.pos].span } else { self.end }
        diag.Diag.new(span, ("core: " + msg).as_str())
    }

    fn at(self, word: str) -> bool {
        self.pos < self.tokens.len() && self.tokens[self.pos].text == word
    }

    fn take(inout self) -> Result(Token, diag.Diag) {
        if self.pos >= self.tokens.len() { return Err(self.error("unexpected end of core input")) }
        let token = Token {
            text: self.tokens[self.pos].text.clone(),
            span: self.tokens[self.pos].span
        }
        self.pos += 1
        Ok(token)
    }

    fn expect(inout self, word: str) -> Result((), diag.Diag) {
        if !self.at(word) { return Err(self.error(("expected `" + word + "`").as_str())) }
        self.pos += 1
        Ok(())
    }

    fn name(inout self) -> Result(String, diag.Diag) {
        let token = self.take()?
        if !ident(token.text.as_str()) { return Err(diag.Diag.new(
            token.span,
            "core: expected an identifier"
        )) }
        Ok(token.text.clone())
    }

    fn resolve(self, word: str) -> Option(core.Term) {
        var i = self.names.len()
        while i > 0 {
            i -= 1
            if self.names[i] == word {
                return Some(core.Term.Var((self.names.len() - 1 - i) as u32))
            }
        }
        for i, d in self.core.definitions {
            if d.name == word { return Some(core.Term.Global(i as u32)) }
        }
        for f, family in self.core.families {
            if family.name == word { return Some(core.Term.Ind(f as u32, Vec(u32).new())) }
            for k, constructor in family.constructors {
                if constructor.name == word {
                    return Some(core.Term.Con(f as u32, k as u32, Vec(u32).new()))
                }
            }
        }
        None
    }

    fn unique(self, name: str, span: diag.Span) -> Result((), diag.Diag) {
        if self.resolve(name).is_some() {
            return Err(diag.Diag.new(span, "core: duplicate name"))
        }
        Ok(())
    }

    fn declaration_name(inout self) -> Result(String, diag.Diag) {
        let span = if self.pos < self.tokens.len() { self.tokens[self.pos].span } else { self.end }
        let name = self.name()?
        if form_head(name.as_str()) { return Err(diag.Diag.new(span, "core: reserved form name")) }
        self.unique(name.as_str(), span)?
        Ok(name)
    }

    fn expr(inout self, depth: u32) -> Result(u32, diag.Diag) {
        if depth == 0 { return Err(self.error("nesting limit reached")) }
        let token = self.take()?
        let sp = token.span
        let word = token.text.as_str()
        if word != "(" {
            let term = if word == "U64" { core.Term.U64 }
            else if word == "I64" { core.Term.I64 }
            else if word == "Prop" { core.Term.Prop }
            else {
                match self.resolve(word) {
                    Some(t) => t
                    None => {
                        let n = natural(word)
                        let Some(n) = n else { return Err(diag.Diag.new(sp,
                            ("core: unknown name or invalid U64 literal: " + word).as_str())) }
                        core.Term.Natural(n)
                    }
                }
            }
            return self.core.add(term, sp)
        }
        let head = self.take()?
        let kind = head.text.as_str()
        let term = if kind == "pi" || kind == "pi0" || kind == "lam" || kind == "lam0" {
            let name = self.name()?
            let domain = self.expr(depth - 1)?
            self.names.push(name)
            let body = self.expr(depth - 1)?
            self.names.pop()
            let erased = kind == "pi0" || kind == "lam0"
            if kind == "pi" || kind == "pi0" { core.Term.Pi(erased, domain, body) }
            else { core.Term.Lam(erased, domain, body) }
        } else if kind == "app" {
            var f = self.expr(depth - 1)?
            var count = 0
            while !self.at(")") {
                let arg = self.expr(depth - 1)?
                f = self.core.add(core.Term.App(f, arg), sp)?
                count += 1
            }
            if count == 0 { return Err(diag.Diag.new(sp, "core: app needs an argument")) }
            self.expect(")")?
            return Ok(f)
        } else if kind == "Array" {
            core.Term.Array(self.expr(depth - 1)?)
        } else if kind == "induct" {
            let name = self.name()?
            var family: Option(u32) = None
            for f, declared in self.core.families {
                if declared.name == name { family = Some(f as u32); break }
            }
            let Some(f) = family else { return Err(self.error("unknown inductive family")) }
            let motive = self.expr(depth - 1)?
            var arguments = Vec(u32).new()
            while !self.at(")") { arguments.push(self.expr(depth - 1)?) }
            let Some(evidence) = arguments.pop() else {
                return Err(self.error("induct needs evidence"))
            }
            core.Term.Elim(f, motive, arguments, evidence)
        } else if kind == "case" {
            // (case F P case... v): one level of case analysis of heap data.
            let name = self.name()?
            var family: Option(u32) = None
            for f, declared in self.core.families {
                if declared.name == name { family = Some(f as u32); break }
            }
            let Some(f) = family else { return Err(self.error("unknown data type")) }
            let motive = self.expr(depth - 1)?
            var arguments = Vec(u32).new()
            while !self.at(")") { arguments.push(self.expr(depth - 1)?) }
            let Some(value) = arguments.pop() else { return Err(self.error("case needs a value")) }
            core.Term.Case(f, motive, arguments, value)
        } else if kind == "Ref" {
            core.Term.Ref(self.expr(depth - 1)?)
        } else if kind == "borrow" {
            // (borrow x): a borrow of x in types and evidence only.
            core.Term.Borrow(self.expr(depth - 1)?)
        } else if kind == "loop" {
            // (loop n T init body): T(k) is the accumulator's type after k steps.
            let n = self.expr(depth - 1)?
            let t = self.expr(depth - 1)?
            let init = self.expr(depth - 1)?
            core.Term.Loop(n, t, init, self.expr(depth - 1)?)
        } else if kind == "absurd" {
            // (absurd T p): code with evidence of Lt(i, 0), of any type.
            let t = self.expr(depth - 1)?
            core.Term.Absurd(t, self.expr(depth - 1)?)
        } else if kind == "deref" {
            // (deref r): the value the borrow r reads, in types and evidence only.
            core.Term.Deref(self.expr(depth - 1)?)
        } else if kind == "lend" {
            // (lend x f g): f reads x through a borrow; g gets the result and x.
            let x = self.expr(depth - 1)?
            let f = self.expr(depth - 1)?
            let g = self.expr(depth - 1)?
            core.Term.Lend(x, f, g)
        } else if kind == "view" || kind == "view-rec" {
            // (view F T case... r): reading borrowed heap data; view-rec recurses.
            let name = self.name()?
            var family: Option(u32) = None
            for f, declared in self.core.families {
                if declared.name == name { family = Some(f as u32); break }
            }
            let Some(f) = family else { return Err(self.error("unknown data type")) }
            let t = self.expr(depth - 1)?
            var arguments = Vec(u32).new()
            while !self.at(")") { arguments.push(self.expr(depth - 1)?) }
            let Some(value) = arguments.pop() else { return Err(self.error("a view needs a borrow")) }
            core.Term.View(kind == "view-rec", f, t, arguments, value)
        } else if kind == "drop" {
            // (drop F v rest): free heap data v of type F, then the rest.
            let name = self.name()?
            var family: Option(u32) = None
            for f, declared in self.core.families {
                if declared.name == name { family = Some(f as u32); break }
            }
            let Some(f) = family else { return Err(self.error("unknown data type")) }
            let value = self.expr(depth - 1)?
            let rest = self.expr(depth - 1)?
            core.Term.Drop(f, value, rest)
        } else if kind == "add" || kind == "sub" || kind == "mul" {
            let a = self.expr(depth - 1)?
            let b = self.expr(depth - 1)?
            let op = if kind == "add" { core.Arith.Add }
            else if kind == "sub" { core.Arith.Sub } else { core.Arith.Mul }
            core.Term.Arith(op, a, b)
        } else if kind == "usub" {
            let a = self.expr(depth - 1)?
            let b = self.expr(depth - 1)?
            let p = self.expr(depth - 1)?
            core.Term.USub(a, b, p)
        } else if kind == "zero-le" {
            core.Term.ZeroLe(self.expr(depth - 1)?)
        } else if kind == "Buffer" {
            core.Term.Buffer(self.expr(depth - 1)?)
        } else if kind == "alloc" || kind == "free" {
            let a = self.expr(depth - 1)?
            let b = self.expr(depth - 1)?
            if kind == "alloc" { core.Term.Alloc(a, b) } else { core.Term.Free(a, b) }
        } else if kind == "load" || kind == "store" {
            var xs = Vec(u32).new()
            for _ in 0..4 { xs.push(self.expr(depth - 1)?) }
            if kind == "load" { core.Term.Load(xs[0], xs[1], xs[2], xs[3]) }
            else { core.Term.Store(xs[0], xs[1], xs[2], xs[3]) }
        } else if kind == "Refine" {
            core.Term.Refine(self.expr(depth - 1)?)
        } else if kind == "pack" {
            let family = self.expr(depth - 1)?
            let a = self.expr(depth - 1)?
            let p = self.expr(depth - 1)?
            core.Term.Pack(family, a, p)
        } else if kind == "witness" {
            core.Term.Witness(self.expr(depth - 1)?)
        } else if kind == "proof" {
            core.Term.Proof(self.expr(depth - 1)?)
        } else if kind == "uadd" {
            let a = self.expr(depth - 1)?
            let b = self.expr(depth - 1)?
            core.Term.UAdd(a, b)
        } else if kind == "lt-add" || kind == "lt-cancel" || kind == "lt-le" {
            var xs = Vec(u32).new()
            for _ in 0..(if kind == "lt-le" { 5 } else { 4 }) { xs.push(self.expr(depth - 1)?) }
            if kind == "lt-add" { core.Term.LtAdd(xs[0], xs[1], xs[2], xs[3]) }
            else if kind == "lt-cancel" { core.Term.LtCancel(xs[0], xs[1], xs[2], xs[3]) }
            else { core.Term.LtLe(xs[0], xs[1], xs[2], xs[3], xs[4]) }
        } else if kind == "fold" {
            let n = self.expr(depth - 1)?
            let init = self.expr(depth - 1)?
            let body = self.expr(depth - 1)?
            core.Term.Fold(n, init, body)
        } else if kind == "refl" {
            core.Term.Refl(self.expr(depth - 1)?)
        } else if kind == "transport" {
            let family = self.expr(depth - 1)?
            let e = self.expr(depth - 1)?
            let p = self.expr(depth - 1)?
            core.Term.Transport(family, e, p)
        } else if kind == "Eq" || kind == "Lt" || kind == "decide-lt" {
            let a = self.expr(depth - 1)?
            let b = self.expr(depth - 1)?
            if kind == "Eq" { core.Term.Eq(a, b) }
            else if kind == "Lt" { core.Term.Lt(a, b) } else { core.Term.Decide(a, b) }
        } else if kind == "Type" {
            let n = self.take()?
            let level = natural(n.text.as_str())
            let Some(level) = level else { return Err(diag.Diag.new(
                n.span,
                "core: invalid universe level"
            )) }
            if level >= 32 { return Err(diag.Diag.new(n.span, "core: universe level limit reached")) }
            core.Term.Universe(level as u32)
        } else if kind == "int" {
            let n = self.take()?
            let value = signed(n.text.as_str())
            let Some(value) = value else { return Err(diag.Diag.new(
                n.span,
                "core: invalid I64 literal"
            )) }
            core.Term.Integer(value)
        } else if kind == "array" {
            var xs = Vec(u32).new()
            while !self.at(")") { xs.push(self.expr(depth - 1)?) }
            core.Term.Elements(xs)
        } else if kind == "index" {
            let array = self.expr(depth - 1)?
            let i = self.expr(depth - 1)?
            let proof = self.expr(depth - 1)?
            core.Term.Index(array, i, proof)
        } else if kind == "if-lt" || kind == "if-eq" {
            let a = self.expr(depth - 1)?
            let b = self.expr(depth - 1)?
            let name = self.name()?
            self.names.push(name)
            let yes = self.expr(depth - 1)?
            self.names.pop()
            let no = self.expr(depth - 1)?
            if kind == "if-eq" { core.Term.IfEq(a, b, yes, no) }
            else { core.Term.IfLt(a, b, yes, no) }
        } else {
            let Some(named) = self.resolve(kind) else {
                return Err(diag.Diag.new(head.span, "core: unknown term constructor"))
            }
            var arguments = Vec(u32).new()
            while !self.at(")") { arguments.push(self.expr(depth - 1)?) }
            match named {
                Ind(f, _) => core.Term.Ind(f, arguments)
                Con(f, k, _) => core.Term.Con(f, k, arguments)
                _ => return Err(diag.Diag.new(
                    head.span,
                    "core: use (app f x ...) to apply a function"
                ))
            }
        }
        self.expect(")")?
        self.core.add(term, sp)
    }

    fn definition(inout self) -> Result((), diag.Diag) {
        self.expect("(")?
        let mode = self.take()?
        if mode.text == "inductive" || mode.text == "data" {
            // (data F (c TYPE) ...) declares a data type without indices;
            // (data F N P (c TYPE) ...) one with N indices, the first P of
            // them parameters.
            let data = mode.text == "data"
            let name = self.declaration_name()?
            var n: u64 = 0
            var params: u64 = 0
            if data && !self.at("(") {
                for i in 0..2 {
                    let count = self.take()?
                    let Some(value) = natural(count.text.as_str()) else {
                        return Err(diag.Diag.new(count.span, "core: invalid data arity"))
                    }
                    if value > 16 { return Err(diag.Diag.new(
                        count.span,
                        "core: invalid data arity"
                    )) }
                    if i == 0 { n = value } else { params = value }
                }
            }
            if !data {
                let arity = self.take()?
                let Some(count) = natural(arity.text.as_str()) else {
                    return Err(diag.Diag.new(arity.span, "core: invalid inductive arity"))
                }
                if count > 0xffffffff { return Err(diag.Diag.new(
                    arity.span,
                    "core: invalid inductive arity"
                )) }
                n = count
            }
            let f = self.core.families.len()
            self.core.families.push(core.Family {
                name,
                data,
                params: params as u32,
                arity: n as u32,
                constructors: Vec(core.Constructor).new(),
                globals: self.core.definitions.len() as u32,
                span: mode.span
            })
            while !self.at(")") {
                self.expect("(")?
                let name = self.declaration_name()?
                let ty = self.expr(core.DEPTH)?
                self.expect(")")?
                self.core.families[f].constructors.push(core.Constructor { name, ty })
            }
            self.expect(")")?
            return Ok(())
        }
        let exported = mode.text == "export"
        if !exported && mode.text != "def" { return Err(diag.Diag.new(
            mode.span,
            "core: expected def, export, inductive or data"
        )) }
        let name = self.name()?
        self.unique(name.as_str(), mode.span)?
        let ty = self.expr(core.DEPTH)?
        let value = self.expr(core.DEPTH)?
        self.expect(")")?
        self.core.definitions.push(core.Definition { name, ty, value, exported, span: mode.span })
        Ok(())
    }
}

pub fn parse(text: str, file: u32) -> Result(core.Core, diag.Diag) {
    if text.len > 1048576 { return Err(diag.Diag.new(
        diag.Span.new(file, 0, 0),
        "core: input limit reached"
    )) }
    var tokens = Vec(Token).new()
    var i = 0
    while i < text.len {
        let c = text[i]
        if c == ' ' || c == '\t' || c == '\n' || c == '\r' { i += 1; continue }
        if c == ';' {
            while i < text.len && text[i] != '\n' { i += 1 }
            continue
        }
        let start = i
        i += 1
        if c != '(' && c != ')' {
            while i < text.len {
                let c = text[i]
                if c == '(' || c == ')' || c == ';' || c == ' ' || c == '\t' || c == '\n' || c == '\r' { break }
                i += 1
            }
        }
        tokens.push(Token { text: text[start..i].to_string(), span: diag.Span.new(file, start, i) })
        if tokens.len() > 50000 { return Err(diag.Diag.new(
            diag.Span.new(file, start, i),
            "core: token limit reached"
        )) }
    }
    var parser = Parser { tokens, pos: 0, end: diag.Span.new(file, text.len, text.len),
        core: core.Core.new(), names: Vec(String).new() }
    while parser.pos < parser.tokens.len() { parser.definition()? }
    Ok(mem.replace(&parser.core, core.Core.new()))
}
