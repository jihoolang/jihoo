// Explicit .jh subset -> the existing dependent core, directly from AST.
// Contextual forms use the ordinary parser: erased(P), if_lt(a, b,
// fn(p) { yes }, no), index(xs, i, p), decide_lt(a, b), Eq, refl,
// if_eq, proposition-only transport, inductive propositions declared as
// `trait Name(i: u64, ...) { fn ctor(...) -> Name(...) }` and their
// structural induction, `induct(P, case..., evidence)`, i64 `+ - *` and
// bounded loops, `fold(n, init, fn(i, p, acc) { body })`, and refinements
// `refine(fn(x) { P })` with `pack(a, p)`, `witness(s)` and `proof(s)`,
// and data types declared as `enum`, built with `E.V(...)` and taken apart
// with `match` or, into a proposition, `induct(fn(x) { P(x) }, ..., v)`,
// data types that are recursive live on the heap: `match` takes one node
// apart and `induct(fn(x) { T }, case..., v)` is structural recursion,
// and owned buffers `buffer(n)`: `alloc(n, x)`, `load(b, i, p, fn(x, b)
// { ... })`, `store(b, i, v, p)` and `free(b, rest)`, each used once.
// Owned values are freed where their scope ends: a buffer or heap data
// that a scope or one of its alternatives does not use is freed there.
// `ref T` parameters borrow: an owned local passed where a borrow is
// expected is lent for the expression or `let` value that borrows it,
// while types and evidence, which never run, borrow any value in place.
// `inout` parameters change a buffer or heap data: a function takes the owner
// and gives it back with its result, `f(&x)` rebinds x, and `old(x)`, in types
// and evidence, is the value x started with.
// No source text or independent execution model is generated here.
import ast
import core
import core_lower
import diag
import load
import mir
import target
import std.mem

fn error(sp: diag.Span, message: str) -> diag.Diag {
    diag.Diag.new(sp, ("core: " + message).as_str())
}

fn reserved(name: str) -> bool {
    name == "erased" || name == "Lt" || name == "Eq" || name == "induct" || name == "fold" ||
        name == "lt_add" || name == "lt_cancel" || name == "lt_le" || name == "sub" ||
        name == "zero_le" || name == "refine" || name == "pack" || name == "witness" ||
        name == "proof" || name == "buffer" || name == "alloc" || name == "load" ||
        name == "store" || name == "free" || name == "absurd" || name == "old" ||
        name == "if_lt" ||
        name == "if_eq" || name == "refl" || name == "transport" || name == "index" ||
        name == "decide_lt" || name == "u64" || name == "i64" ||
        name == "__jihoo_dependent_main"
}

// An expression that may borrow the owned values of its context: while it
// is elaborated, a borrow binder for each follows the context at `base`.
struct Frame {
    base: i64
    owners: Vec(i64)
    used: Vec(bool)
}

struct Elaborator {
    c: core.Core
    names: Vec(String)
    ctx: Vec(core.Binding)
    arities: Vec(i64)
    frames: Vec(Frame)
    // Above zero while elaborating types and evidence, which never run:
    // an owned value there is borrowed in place rather than lent.
    ghost: u32
    // Per context entry, whether `&name` may change it: a `var` or an
    // `inout` parameter, and what they are rebound to.
    mutable: Vec(bool)
    // Per definition, whether each parameter is inout.
    inouts: Vec(Vec(bool))
    // The current function's inout parameters, in order.
    givers: Vec(String)
    // Context entries below this one cannot change here: they belong to the
    // code after a let's value or a loop body being elaborated.
    barrier: i64
    // Set for the one call that may take `&x`: a let's value, a statement or
    // a block's value.
    allowed: bool
    // Assignments to inout parameters at the end of a block: the name, the
    // context length there and the value. The value is what is given back, so
    // the block's value can prove facts about it by computing.
    aliases: Vec((String, i64, u32))
    // Per struct, its family and the names of its fields in order.
    structs: Vec((u32, Vec(String), Vec(bool)))
    // Declaration provenance is separate from core names: core references
    // are indices, so independent modules may reuse helper and family names.
    module: u32
    definitions: Vec((u32, bool))
    families: Vec((u32, bool))
    // Only direct imports are in scope, each with its actual module identity.
    imports: Vec((String, u32))
    // The current function has inout parameters and no result: a block
    // without a value ends it.
    unit: bool
}

impl Elaborator {
    fn push(inout self, name: str, ty: u32, erased: bool) {
        // Wildcards and compiler-inserted discarded fields cannot be
        // recovered by spelling `_` in an expression, borrow or old(_).
        self.names.push(if name == "_" { "<discard>".to_string() } else { name.to_string() })
        self.ctx.push(core.Binding { ty, erased })
        self.mutable.push(false)
    }

    fn pop(inout self) { self.names.pop(); self.ctx.pop(); self.mutable.pop() }

    // Whether t, a type in the current context, is a proposition: its
    // values are evidence, which owns nothing at run time.
    fn proposition(inout self, t: u32) -> bool {
        let Ok(sort) = self.c.infer(t, self.ctx.as_slice(), true, core.DEPTH) else { return false }
        let Ok(sort) = self.c.normal(sort, core.DEPTH) else { return false }
        self.c.term(sort) == core.Term.Prop
    }

    // The type of context entry i, if it is an owned runtime value: a
    // buffer or heap data.
    fn owner(inout self, i: i64) -> Option(u32) {
        if self.ctx[i].erased { return None }
        let ty = self.ctx[i].ty
        match self.c.owned(ty, core.DEPTH) { Ok(true) => Some(ty), _ => None }
    }

    // free(Var(v), body): a buffer is freed, heap data with every node it owns.
    fn release(inout self, v: u32, ty: u32, body: u32) -> Result(u32, diag.Diag) {
        let sp = self.c.nodes[body as i64].span
        let x = self.c.add(core.Term.Var(v), sp)?
        let ty = self.c.normal(ty, core.DEPTH)?
        match self.c.term(ty) {
            Buffer(_) => self.c.add(core.Term.Free(x, body), sp)
            Ind(f, _) => self.c.add(core.Term.Drop(f, x, body), sp)
            _ => Err(error(sp, "free requires a buffer or heap data"))
        }
    }

    // The scope of the last n context entries ends after body: each owned
    // one that body does not use at run time is freed before it. This is
    // the same program as freeing at the scope's end, since freeing has no
    // other effect, and holds the memory for less time. A use the kernel
    // rejects (such as a capture) is left for the kernel to report.
    fn settle(inout self, body: u32, n: i64) -> Result(u32, diag.Diag) {
        var value = body
        for j in 0..n {
            let i = self.ctx.len() - n + j
            let Some(ty) = self.owner(i) else { continue }
            let v = (self.ctx.len() - 1 - i) as u32
            match self.c.runtime_uses(value, v, self.ctx.as_slice(), []) {
                Ok(0) => value = self.release(v, ty, value)?
                _ => {}
            }
        }
        Ok(value)
    }

    // Alternatives of which exactly one runs, each a body under its own
    // binders (erased, domain): an owned value of the context that some
    // use is freed at the start of those that do not.
    fn balance(
        inout self,
        binders: [Vec((bool, u32))],
        bodies: [u32]
    ) -> Result(Vec(u32), diag.Diag) {
        var out = Vec(u32).new()
        for b in bodies { out.push(b) }
        for i in 0..self.ctx.len() {
            let Some(ty) = self.owner(i) else { continue }
            let v = (self.ctx.len() - 1 - i) as u32
            var counts = Vec(u32).new()
            var known = true
            for k, body in out {
                var inner = Vec((u32, bool)).new()
                for (erased, domain) in binders[k] { inner.push((domain, erased)) }
                match self.c.runtime_uses(body, v, self.ctx.as_slice(), inner.as_slice()) {
                    Ok(n) => counts.push(n)
                    Err(_) => known = false
                }
            }
            if !known { continue }
            var used = false
            for n in counts { if n > 0 { used = true } }
            if !used { continue }
            for k in 0..out.len() {
                if counts[k] == 0 {
                    out[k] = self.release(v + binders[k].len() as u32, ty, out[k])?
                }
            }
        }
        Ok(out)
    }

    // The type of context entry i, valid at the end of the context.
    fn type_at(inout self, i: i64) -> Result(u32, diag.Diag) {
        let ty = self.ctx[i].ty
        self.c.shift(ty, self.ctx.len() - i, 0, core.DEPTH)
    }

    // A borrow of the owned local `name`, through the innermost frame that
    // lends it; None if `name` is not an owned local.
    fn borrow(inout self, name: str, sp: diag.Span) -> Result(Option(u32), diag.Diag) {
        if self.assigned(name).is_some() { return Err(error(
            sp,
            ("cannot read " + name + " after assigning it as a block's last statement").as_str()
        )) }
        var i = self.names.len()
        var found: Option(i64) = None
        while i > 0 {
            i -= 1
            if self.names[i] == name { found = Some(i); break }
        }
        let Some(i) = found else { return Ok(None) }
        if self.owner(i).is_none() { return Ok(None) }
        var f = self.frames.len()
        while f > 0 {
            f -= 1
            for j, o in self.frames[f].owners {
                if o == i {
                    self.frames[f].used[j] = true
                    let at = self.frames[f].base + j
                    return Ok(Some(self.c.add(
                        core.Term.Var((self.ctx.len() - 1 - at) as u32),
                        sp
                    )?))
                }
            }
        }
        Err(error(sp, ("cannot borrow " + name + " here").as_str()))
    }

    // Elaborate e where it may borrow an owned value of the context: e
    // sees a borrow binder for each, and those it does not use are
    // removed. Returns e, and if it borrows, the owner and e's type (e then
    // has the borrow at de Bruijn 0); it borrows at most one owner.
    fn frame(
        inout self,
        e: ast.Expr,
        expected: Option(u32),
        depth: u32
    ) -> Result((u32, Option((i64, u32))), diag.Diag) {
        let base = self.ctx.len()
        var owners = Vec(i64).new()
        for i in 0..base { if self.owner(i).is_some() { owners.push(i) } }
        if owners.len() == 0 { return Ok((self.expr(e, expected, depth)?, None)) }
        let k = owners.len()
        for o in owners {
            let ty = self.type_at(o)?
            let r = self.c.add(core.Term.Ref(ty), e.span)?
            self.push("&", r, false)
        }
        var used = Vec(bool).new()
        for _ in 0..k { used.push(false) }
        self.frames.push(Frame { base, owners: owners.clone(), used })
        let inner = match expected {
            Some(t) => Some(self.c.shift(t, k, 0, core.DEPTH)?)
            None => None
        }
        let result = self.expr(e, inner, depth)
        let Some(frame) = self.frames.pop() else { return Err(error(e.span, "unreachable")) }
        for _ in 0..k { self.pop() }
        let value = result?
        var value = value
        var count = 0
        for u in frame.used { if u { count += 1 } }
        if count > 1 { return Err(error(
            e.span,
            "an expression borrows one owned value; borrow the others in a let before it"
        )) }
        // Remove the unused borrow binders, innermost first.
        var kept: u32 = 0
        var owner: Option(i64) = None
        var j = k
        while j > 0 {
            j -= 1
            if frame.used[j] { kept += 1; owner = Some(frame.owners[j]); continue }
            value = self.c.shift(value, -1, kept, core.DEPTH)?
        }
        let Some(o) = owner else { return Ok((value, None)) }
        // The type of a borrowing e, inferred as the kernel checks its
        // lend: with the borrow reading its owner, Borrow(owner), so the
        // type may depend on it.
        let a = match expected {
            Some(t) => t
            None => {
                let x = self.c.add(core.Term.Var((base - 1 - o) as u32), e.span)?
                let lent = self.c.add(core.Term.Borrow(x), e.span)?
                let read = self.c.substitute(value, lent, core.DEPTH)?
                match self.c.infer_reading(read, x, self.ctx.as_slice()) {
                    Ok(t) => t
                    Err(_) => return Err(error(
                        e.span,
                        "a borrowing expression needs a known type"
                    ))
                }
            }
        }
        Ok((value, Some((o, a))))
    }

    // An expression whose borrow, if any, ends with it: lent, then the
    // owner, given back, is freed.
    fn scope_expr(
        inout self,
        e: ast.Expr,
        expected: Option(u32),
        depth: u32
    ) -> Result(u32, diag.Diag) {
        // A branch's value may change what it was given.
        if is_changing(e) { return self.lets([], e, expected, depth) }
        match self.giving(e, expected)? {
            Some(t) => return self.give(e, t, depth)
            None => {}
        }
        let (value, info) = self.frame(e, expected, depth)?
        let Some((o, a)) = info else { return Ok(value) }
        let sp = e.span
        let t = self.type_at(o)?
        let r = self.c.add(core.Term.Ref(t), sp)?
        let f = self.c.add(core.Term.Lam(false, r, value), sp)?
        let back = self.c.shift(t, 1, 0, core.DEPTH)?
        let result = self.c.add(core.Term.Var(1), sp)?
        let freed = self.release(0, back, result)?
        let inner = self.c.add(core.Term.Lam(false, back, freed), sp)?
        let g = self.c.add(core.Term.Lam(false, a, inner), sp)?
        let x = self.c.add(core.Term.Var((self.ctx.len() - 1 - o) as u32), sp)?
        self.c.add(core.Term.Lend(x, f, g), sp)
    }

    // Whether an expected type gives owners back and e is a value rather than
    // a form that passes the expected type on to its own values: the type.
    fn giving(inout self, e: ast.Expr, expected: Option(u32)) -> Result(Option(u32), diag.Diag) {
        let Some(t) = expected else { return Ok(None) }
        let normal = self.c.normal(t, core.DEPTH)?
        let core.Term.Back(_, _, _) = self.c.term(normal) else { return Ok(None) }
        let passes = match e.kind {
            Block(_) | Match(_, _) => true
            Call(f, _) => match f.kind {
                Name(n) => n == "if_lt" || n == "if_eq" || n == "load" || n == "free"
                _ => false
            }
            _ => false
        }
        Ok(if passes { None } else { Some(normal) })
    }

    // The value e with the current inout parameters given back: Give(M, x,
    // ...) around it. e is evaluated first; if it borrows, it is lent around
    // them, so it may read the owners it gives back.
    fn give(inout self, e: ast.Expr, expected: u32, depth: u32) -> Result(u32, diag.Diag) {
        let sp = e.span
        var flags = Vec(bool).new()
        var motives = Vec(u32).new()
        var names = Vec(String).new()
        var ty = expected
        loop {
            let normal = self.c.normal(ty, core.DEPTH)?
            let core.Term.Back(erased, _, m) = self.c.term(normal) else { break }
            if flags.len() >= self.givers.len() { return Err(error(sp, "unreachable")) }
            let name = self.givers[flags.len()].clone()
            let x = self.name(name.as_str(), sp)?
            flags.push(erased)
            motives.push(m)
            names.push(name)
            let applied = self.c.add(core.Term.App(m, x), sp)?
            ty = self.c.normal(applied, core.DEPTH)?
        }
        let (value, info) = self.frame(e, Some(ty), depth)?
        let Some((o, a)) = info else { return self.gave(
            flags.as_slice(),
            motives.as_slice(),
            names.as_slice(),
            value,
            0
        ) }
        // Under fn(a, y), where the owner is given back as itself.
        let t = self.type_at(o)?
        let r = self.c.add(core.Term.Ref(t), sp)?
        let f = self.c.add(core.Term.Lam(false, r, value), sp)?
        let back = self.c.shift(t, 1, 0, core.DEPTH)?
        self.push("&", a, false)
        let inner = self.c.shift(back, 1, 0, core.DEPTH)?
        self.push("&", inner, false)
        let result = self.c.add(core.Term.Var(1), sp)?
        var rest = self.gave(flags.as_slice(), motives.as_slice(), names.as_slice(), result, 2)
        // An owner that is not given back ends here.
        let own = names.as_slice()
        var kept = false
        for n in own { if self.names[o] == n.as_str() { kept = true } }
        if !kept {
            rest = match rest {
                Ok(x) => self.release(0, inner, x)
                Err(d) => Err(d)
            }
        }
        self.pop()
        self.pop()
        let g = self.c.add(core.Term.Lam(false, back, rest?), sp)?
        let g = self.c.add(core.Term.Lam(false, a, g), sp)?
        let x = self.c.add(core.Term.Var((self.ctx.len() - 1 - o) as u32), sp)?
        self.c.add(core.Term.Lend(x, f, g), sp)
    }

    // Give(M, x, ...) around a value, for each owner by name; the motives are
    // `shift` binders out.
    fn gave(
        inout self,
        flags: [bool],
        motives: [u32],
        names: [String],
        value: u32,
        shift: i64
    ) -> Result(u32, diag.Diag) {
        let sp = self.c.nodes[value as i64].span
        var out = value
        var j = flags.len
        while j > 0 {
            j -= 1
            let x = self.name(names[j].as_str(), sp)?
            let m = self.c.shift(motives[j], shift, 0, core.DEPTH)?
            out = self.c.add(core.Term.Give(flags[j], m, x, out), sp)?
        }
        Ok(out)
    }

    // The value of a call that changes its arguments, then the rest: the
    // owners come back under their names, then the result under `name`.
    fn taking(
        inout self,
        value: u32,
        ty: u32,
        names: [String],
        result: str,
        annotation: Option(u32),
        stmts: [ast.Stmt],
        tail: ast.Expr,
        expected: Option(u32),
        depth: u32
    ) -> Result(u32, diag.Diag) {
        let sp = self.c.nodes[value as i64].span
        let normal = self.c.normal(ty, core.DEPTH)?
        let core.Term.Back(erased, t, m) = self.c.term(normal) else {
            return Err(error(sp, "only an inout parameter takes &x"))
        }
        if names.len == 0 { return Err(error(sp, "unreachable")) }
        self.push(names[0].as_str(), t, false)
        self.mutable[self.mutable.len() - 1] = true
        let shifted = self.c.shift(m, 1, 0, core.DEPTH)?
        let v = self.c.add(core.Term.Var(0), sp)?
        let applied = self.c.add(core.Term.App(shifted, v), sp)?
        let body = self.c.normal(applied, core.DEPTH)?
        let last = names.len == 1
        // The result's name binds a value whose annotation the kernel compares.
        let domain = match annotation {
            Some(a) if last => self.c.shift(a, 1, 0, core.DEPTH)?
            _ => body
        }
        self.push(if last { result } else { "&" }, domain, erased)
        let inner = match expected {
            Some(e) => Some(self.c.shift(e, 2, 0, core.DEPTH)?)
            None => None
        }
        let r = if last { self.lets(stmts, tail, inner, depth - 1) } else {
            let x = self.c.add(core.Term.Var(0), sp)?
            let a = match annotation {
                Some(a) => Some(self.c.shift(a, 2, 0, core.DEPTH)?)
                None => None
            }
            self.taking(x, body, names[1..], result, a, stmts, tail, inner, depth - 1)
        }
        // The result's binder and the owner, if the rest does not use them.
        let r: Result(u32, diag.Diag) = match r {
            Ok(b) => {
                let ghost = match inner { Some(t) => self.proposition(t), None => false }
                if ghost { Ok(b) } else { self.settle(b, 2) }
            }
            Err(d) => Err(d)
        }
        self.pop()
        self.pop()
        let k = self.c.add(core.Term.Lam(erased, domain, r?), sp)?
        let k = self.c.add(core.Term.Lam(false, t, k), sp)?
        self.c.add(core.Term.Take(value, k), sp)
    }

    // The names of `&x` arguments, which must be able to change here.
    fn changed(inout self, args: [ast.Expr]) -> Result(Vec(String), diag.Diag) {
        var names = Vec(String).new()
        for a in args {
            let Some(inner) = addressed(a) else { continue }
            let ast.ExprKind.Name(n) = inner.kind else {
                return Err(error(a.span, "&x takes a named variable"))
            }
            if self.ghost > 0 { return Err(error(a.span, "types and evidence change nothing")) }
            for m in names { if m == n { return Err(error(
                a.span,
                "an owner is passed as &x once in a call"
            )) } }
            var i = self.names.len()
            var found: Option(i64) = None
            while i > 0 {
                i -= 1
                if self.names[i] == n { found = Some(i); break }
            }
            let Some(i) = found else { return Err(error(
                a.span,
                ("unknown name: " + n).as_str()
            )) }
            if !self.mutable[i] { return Err(error(
                a.span,
                ("&" + n + " needs a var or an inout parameter").as_str()
            )) }
            if i < self.barrier { return Err(error(
                a.span,
                ("cannot change " + n + " here: only a let statement or a block's value can, outside a let's value or a loop").as_str()
            )) }
            names.push(n.clone())
        }
        Ok(names)
    }

    // `let name = v` statements and calls that change their arguments, then
    // the tail. A let whose value borrows an owned local lends it, and the
    // rest sees the owner again.
    fn lets(
        inout self,
        stmts: [ast.Stmt],
        tail: ast.Expr,
        expected: Option(u32),
        depth: u32
    ) -> Result(u32, diag.Diag) {
        if depth == 0 { return Err(error(tail.span, "elaboration nesting limit reached")) }
        if stmts.len == 0 {
            if !is_changing(tail) { return self.scope_expr(tail, expected, depth) }
            // `store(&b, ...)` or `f(&x)` as a block's value.
            let synthetic = if is_store(tail) { unit_value(tail.span) } else {
                ast.Expr { kind: ast.ExprKind.Name("&result".to_string()), span: tail.span }
            }
            return self.statement(
                "&result",
                None,
                tail,
                [],
                synthetic,
                expected,
                tail.span,
                false,
                depth
            )
        }
        let stmt = stmts[0]
        match stmt.kind {
            Assign(place, value) => return self.assignment(
                place,
                value,
                stmts[1..],
                tail,
                expected,
                stmt.span,
                depth
            )
            Expr(e) => {
                if !is_changing(e) { return Err(error(
                    stmt.span,
                    "dependent_core blocks contain let statements, calls that change an argument and a value"
                )) }
                return self.statement(
                    "_",
                    None,
                    e,
                    stmts[1..],
                    tail,
                    expected,
                    stmt.span,
                    false,
                    depth
                )
            }
            _ => {}
        }
        let ast.StmtKind.Let(l) = stmt.kind else { return Err(error(
            stmt.span,
            "dependent_core blocks contain let statements and a value"
        )) }
        let is_var = match l.kind { Var => true, _ => false }
        let plain = match l.kind { Let | Var => true, _ => false }
        if l.els.is_some() || !plain { return Err(error(
            stmt.span,
            "dependent_core has plain let statements"
        )) }
        let name = match l.pat.kind {
            Name(n, false) if !reserved(n.as_str()) => n.clone()
            Wild => "_".to_string()
            _ => return Err(error(l.pat.span, "a let binds a name"))
        }
        let annotation = match l.ty {
            Some(t) => Some(self.ty(t, core.DEPTH)?)
            None => None
        }
        self.statement(
            name.as_str(),
            annotation,
            l.value,
            stmts[1..],
            tail,
            expected,
            stmt.span,
            is_var,
            depth
        )
    }

    // `x = v`: x is rebound, and its old value freed if nothing uses it. As an
    // inout parameter's last assignment in a block, x is v itself for the rest,
    // so evidence there can compute with it; only the Give that ends the
    // function evaluates v.
    fn assignment(
        inout self,
        place: ast.Expr,
        value: ast.Expr,
        stmts: [ast.Stmt],
        tail: ast.Expr,
        expected: Option(u32),
        sp: diag.Span,
        depth: u32
    ) -> Result(u32, diag.Diag) {
        let ast.ExprKind.Name(n) = place.kind else { return Err(error(
            place.span,
            "dependent_core assigns to a variable"
        )) }
        var i = self.names.len()
        var found: Option(i64) = None
        while i > 0 {
            i -= 1
            if self.names[i] == n { found = Some(i); break }
        }
        let Some(i) = found else { return Err(error(
            place.span,
            ("unknown name: " + n).as_str()
        )) }
        if !self.mutable[i] { return Err(error(
            place.span,
            (n + " needs a var or an inout parameter to be assigned").as_str()
        )) }
        if i < self.barrier { return Err(error(
            place.span,
            ("cannot change " + n + " here: only a let statement or a block's value can, outside a let's value or a loop").as_str()
        )) }
        let ty = self.type_at(i)?
        var giver = false
        for g in self.givers { if g == n { giver = true } }
        if stmts.len == 0 && giver {
            let saved = mem.replace(&self.barrier, self.ctx.len())
            let framed = self.frame(value, Some(ty), depth - 1)
            self.barrier = saved
            let (term, info) = framed?
            if info.is_none() {
                self.aliases.push((n.clone(), self.ctx.len(), term))
                let result = self.lets(stmts, tail, expected, depth - 1)
                self.aliases.pop()
                return result
            }
        }
        self.statement(n.as_str(), Some(ty), value, stmts, tail, expected, sp, true, depth)
    }

    // A let of `name` to `value` (or a statement, whose value is named `_`),
    // then the rest.
    fn statement(
        inout self,
        name: str,
        annotation: Option(u32),
        value_expr: ast.Expr,
        stmts: [ast.Stmt],
        tail: ast.Expr,
        expected: Option(u32),
        sp: diag.Span,
        is_var: bool,
        depth: u32
    ) -> Result(u32, diag.Diag) {
        let changing = is_changing(value_expr)
        let ghost = match expected { Some(t) => self.proposition(t), None => false }
        // store(&b, ...) gives the buffer itself, rebound to its name.
        let store_name = if is_store(value_expr) {
            let ast.ExprKind.Call(_, args) = value_expr.kind else { return Err(error(
                sp,
                "unreachable"
            )) }
            let names = self.changed(args.as_slice())?
            if names.len() != 1 { return Err(error(sp, "store(&b, ...) changes one buffer")) }
            Some(names[0].clone())
        } else { None }
        let rebound = store_name.is_some()
        if rebound && (is_var || annotation.is_some()) { return Err(error(
            sp,
            "store(&b, ...) changes b and has no value to bind"
        )) }
        let bound: String = match store_name {
            Some(n) => n.clone()
            None => name.to_string()
        }
        let name = bound.as_str()
        var names = Vec(String).new()
        if changing && !rebound {
            let ast.ExprKind.Call(_, args) = value_expr.kind else { return Err(error(
                sp,
                "unreachable"
            )) }
            names = self.changed(args.as_slice())?
        }
        let saved = self.barrier
        if !changing { self.barrier = self.ctx.len() }
        self.allowed = changing
        let framed = self.frame(
            value_expr,
            if changing && !rebound { None } else { annotation },
            depth - 1
        )
        self.allowed = false
        self.barrier = saved
        let (value, info) = framed?
        if changing && !rebound {
            return match info {
                None => {
                    let ty = self.c.infer(value, self.ctx.as_slice(), true, core.DEPTH)?
                    self.taking(
                        value,
                        ty,
                        names.as_slice(),
                        name,
                        annotation,
                        stmts,
                        tail,
                        expected,
                        depth
                    )
                }
                Some((o, a)) => {
                    let t = self.type_at(o)?
                    let r = self.c.add(core.Term.Ref(t), sp)?
                    let f = self.c.add(core.Term.Lam(false, r, value), sp)?
                    let back = self.c.shift(t, 1, 0, core.DEPTH)?
                    self.push("&", a, false)
                    let inner = match expected {
                        Some(t) => Some(self.c.shift(t, 1, 0, core.DEPTH)?)
                        None => None
                    }
                    let x = self.c.add(core.Term.Var(0), sp)?
                    let shifted = self.c.shift(a, 1, 0, core.DEPTH)?
                    let note = match annotation {
                        Some(n) => Some(self.c.shift(n, 1, 0, core.DEPTH)?)
                        None => None
                    }
                    let taken = self.taking(
                        x,
                        shifted,
                        names.as_slice(),
                        name,
                        note,
                        stmts,
                        tail,
                        inner,
                        depth
                    )
                    let taken: Result(u32, diag.Diag) = match taken {
                        Ok(b) => if ghost { Ok(b) } else {
                            let v = (self.ctx.len() - 1 - o) as u32
                            match self.c.runtime_uses(b, v, self.ctx.as_slice(), []) {
                                Ok(0) => {
                                    let ty = self.type_at(o)?
                                    self.release(v, ty, b)
                                }
                                _ => Ok(b)
                            }
                        }
                        Err(d) => Err(d)
                    }
                    self.pop()
                    let g = self.c.shift(taken?, 1, 0, core.DEPTH)?
                    let g = self.c.add(core.Term.Lam(false, back, g), sp)?
                    let g = self.c.add(core.Term.Lam(false, a, g), sp)?
                    let x = self.c.add(core.Term.Var((self.ctx.len() - 1 - o) as u32), sp)?
                    self.c.add(core.Term.Lend(x, f, g), sp)
                }
            }
        }
        match info {
            None => {
                let a = match annotation {
                    Some(t) => t
                    None => self.c.infer(value, self.ctx.as_slice(), true, core.DEPTH)?
                }
                let erased = self.proposition(a)
                self.push(name, a, erased)
                let at = self.ctx.len() - 1
                if is_var || rebound {
                    if !rebound && self.owner(at).is_none() {
                        self.pop()
                        return Err(error(sp, "a var holds a buffer or heap data"))
                    }
                    self.mutable[at] = true
                }
                let inner = match expected {
                    Some(t) => Some(self.c.shift(t, 1, 0, core.DEPTH)?)
                    None => None
                }
                let rest = self.lets(stmts, tail, inner, depth - 1)
                let rest: Result(u32, diag.Diag) = match rest {
                    Ok(r) => if ghost { Ok(r) } else { self.settle(r, 1) }
                    Err(d) => Err(d)
                }
                self.pop()
                let f = self.c.add(core.Term.Lam(erased, a, rest?), sp)?
                self.c.add(core.Term.App(f, value), sp)
            }
            Some((o, a)) => {
                // The kernel gives the owner back as itself: the rest goes
                // on with the same variable, so facts about it still hold.
                let t = self.type_at(o)?
                let r = self.c.add(core.Term.Ref(t), sp)?
                let f = self.c.add(core.Term.Lam(false, r, value), sp)?
                let back = self.c.shift(t, 1, 0, core.DEPTH)?
                self.push(name, a, false)
                if is_var {
                    let at = self.ctx.len() - 1
                    if self.owner(at).is_none() {
                        self.pop()
                        return Err(error(sp, "a var holds a buffer or heap data"))
                    }
                    self.mutable[at] = true
                }
                let inner = match expected {
                    Some(t) => Some(self.c.shift(t, 1, 0, core.DEPTH)?)
                    None => None
                }
                let rest = self.lets(stmts, tail, inner, depth - 1)
                let rest: Result(u32, diag.Diag) = match rest {
                    Ok(r) => if ghost { Ok(r) } else { self.give_back(r, o) }
                    Err(d) => Err(d)
                }
                self.pop()
                // fn(a, y) { rest }, where rest names the owner, not y.
                let rest = self.c.shift(rest?, 1, 0, core.DEPTH)?
                let g = self.c.add(core.Term.Lam(false, back, rest), sp)?
                let g = self.c.add(core.Term.Lam(false, a, g), sp)?
                let x = self.c.add(core.Term.Var((self.ctx.len() - 1 - o) as u32), sp)?
                self.c.add(core.Term.Lend(x, f, g), sp)
            }
        }
    }

    // The rest after a let that lends owner o, under the let's binder: the
    // owner is freed first if the rest does not use it, and the let's value
    // if it is owned and unused.
    fn give_back(inout self, rest: u32, o: i64) -> Result(u32, diag.Diag) {
        var value = self.settle(rest, 1)?
        let v = (self.ctx.len() - 1 - o) as u32
        match self.c.runtime_uses(value, v, self.ctx.as_slice(), []) {
            Ok(0) => {
                let ty = self.type_at(o)?
                value = self.release(v, ty, value)?
            }
            _ => {}
        }
        Ok(value)
    }

    // induct(fn(t) { T }, case..., r) on a borrow: structural recursion
    // that frees nothing. Each case receives the fields, heap ones
    // borrowed, then the result for each recursive field.
    fn borrowed_recursion(
        inout self,
        args: [ast.Expr],
        evidence: u32,
        inner: u32,
        sp: diag.Span,
        depth: u32
    ) -> Result(u32, diag.Diag) {
        let inner = self.c.normal(inner, core.DEPTH)?
        let core.Term.Ind(f, xs) = self.c.term(inner) else {
            return Err(error(sp, "induct on a borrow requires heap data"))
        }
        self.exposed(f, sp)?
        let count = self.c.families[f as i64].constructors.len()
        if args.len != count + 2 { return Err(error(sp, "induct requires one case per constructor")) }
        var ps = Vec(u32).new()
        for j in 0..self.c.families[f as i64].params as i64 { ps.push(xs[j]) }
        let p = self.data_motive(args[0], f, ps.as_slice(), true, depth - 1)?
        // Into a proposition: a proof by induction over the value the borrow
        // reads, Deref(r), as over an owned value. Evidence never runs.
        if self.proposition_motive(p)? {
            let value = self.c.add(core.Term.Deref(evidence), sp)?
            var cases = Vec(u32).new()
            for k in 0..count {
                let expected = self.c.recursion_case_type(
                    f,
                    k as u32,
                    p,
                    ps.as_slice(),
                    true,
                    sp,
                    core.DEPTH
                )?
                let minimum = self.c.case_arity(f, k as u32, true)
                self.ghost += 1
                let case = self.function_case(args[k + 1], expected, minimum, depth - 1)
                self.ghost -= 1
                cases.push(case?)
            }
            return self.c.add(core.Term.Elim(f, p, cases, value), sp)
        }
        let core.Term.Lam(_, family, body) = self.c.term(p) else {
            return Err(error(sp, "unreachable"))
        }
        // A result that mentions the value is a motive over the borrow, which
        // reads what its value was: fn(t) { T(t) } is fn(r) { T(Deref(r)) }.
        let t = match self.c.shift(body, -1, 0, core.DEPTH) {
            Ok(t) => t
            Err(_) => {
                let body = self.c.reading(body, core.DEPTH)?
                let r = self.c.add(core.Term.Ref(family), sp)?
                self.c.add(core.Term.Lam(false, r, body), sp)?
            }
        }
        var cases = Vec(u32).new()
        for k in 0..count {
            let expected = self.c.view_case_type(
                f,
                k as u32,
                ps.as_slice(),
                t,
                true,
                sp,
                core.DEPTH
            )?
            let minimum = self.c.case_arity(f, k as u32, true)
            cases.push(self.function_case(args[k + 1], expected, minimum, depth - 1)?)
        }
        self.c.add(core.Term.View(true, f, t, cases, evidence), sp)
    }

    // A case that gives at least `minimum` binders of its type by name, each
    // of a function result's arguments either here or by a lambda inside, and
    // whose function result ends in lambdas, as lowering needs.
    fn function_case(
        inout self,
        e: ast.Expr,
        expected: u32,
        minimum: i64,
        depth: u32
    ) -> Result(u32, diag.Diag) {
        let arity = match e.kind {
            Lambda(ps, _, _) => ps.len()
            _ => minimum
        }
        if arity < minimum { return Err(error(e.span, "wrong number of lambda parameters")) }
        let case = self.proof_case(e, expected, arity, depth)?
        self.expand(case, expected)
    }

    // A term of type ty, with one lambda for each of the function type's
    // arguments.
    fn expand(inout self, term: u32, ty: u32) -> Result(u32, diag.Diag) {
        let sp = self.c.nodes[term as i64].span
        let normal = self.c.normal(ty, core.DEPTH)?
        let core.Term.Pi(erased, domain, rest) = self.c.term(normal) else { return Ok(term) }
        match self.c.term(term) {
            Lam(e, d, body) => {
                let body = self.expand(body, rest)?
                self.c.add(core.Term.Lam(e, d, body), sp)
            }
            _ => {
                let shifted = self.c.shift(term, 1, 0, core.DEPTH)?
                let v = self.c.add(core.Term.Var(0), sp)?
                let applied = self.c.add(core.Term.App(shifted, v), sp)?
                let body = self.expand(applied, rest)?
                self.c.add(core.Term.Lam(erased, domain, body), sp)
            }
        }
    }

    // Whether Var(v) occurs in a term.
    fn mentions(inout self, t: u32, v: u32) -> bool {
        self.c.shift(t, -1, v, core.DEPTH).is_err()
    }

    // A type of the current context under `binders` new binders, the
    // outermost for the scrutinee at variable v and the next for the
    // generalized evidence: each occurrence reads the new binder instead.
    // The scrutinee's binder is a borrow, or, with `owned`, the value a borrow
    // of it reads.
    fn abstracted(
        inout self,
        t: u32,
        binders: i64,
        v: u32,
        general: [i64],
        owned: bool,
        sp: diag.Span
    ) -> Result(u32, diag.Diag) {
        var out = self.c.shift(t, binders, 0, core.DEPTH)?
        var value = self.c.add(core.Term.Var((binders - 1) as u32), sp)?
        if owned { value = self.c.add(core.Term.Borrow(value), sp)? }
        out = self.c.rewrite(out, v + binders as u32, value, core.DEPTH)?
        for j, g in general {
            if j as i64 >= binders - 1 { break }
            let old = (self.ctx.len() - 1 - g + binders) as u32
            let new = self.c.add(core.Term.Var((binders - 2 - j as i64) as u32), sp)?
            out = self.c.rewrite(out, old, new, core.DEPTH)?
        }
        Ok(out)
    }

    // The motive of a match on a borrow at variable v: fn(r) { (g...) -> t },
    // over r and the evidence that mentions it, whose types the match refines.
    fn general_motive(
        inout self,
        domain: u32,
        v: u32,
        general: [i64],
        t: u32,
        owned: bool,
        sp: diag.Span
    ) -> Result(u32, diag.Diag) {
        let n = general.len as i64
        var body = self.abstracted(t, n + 1, v, general, owned, sp)?
        var j = n
        while j > 0 {
            j -= 1
            let ty = self.type_at(general[j])?
            let ty = self.abstracted(ty, j + 1, v, general, owned, sp)?
            body = self.c.add(core.Term.Pi(true, ty, body), sp)?
        }
        self.c.add(core.Term.Lam(false, domain, body), sp)
    }

    // Lambdas (erased, domain) around a body.
    fn wrap(inout self, binders: [(bool, u32)], body: u32) -> Result(u32, diag.Diag) {
        let sp = self.c.nodes[body as i64].span
        var value = body
        var i = binders.len
        while i > 0 {
            i -= 1
            let (erased, domain) = binders[i]
            value = self.c.add(core.Term.Lam(erased, domain, value), sp)?
        }
        Ok(value)
    }

    // balance over cases that are each `arity` lambdas around a body.
    fn balance_cases(inout self, cases: [u32], arities: [i64]) -> Result(Vec(u32), diag.Diag) {
        var binders = Vec(Vec((bool, u32))).new()
        var bodies = Vec(u32).new()
        var peeled = Vec(u32).new()
        for k, case in cases {
            var bs = Vec((bool, u32)).new()
            var body = case
            for _ in 0..arities[k] {
                let core.Term.Lam(erased, domain, rest) = self.c.term(body) else { break }
                bs.push((erased, domain))
                body = rest
            }
            binders.push(bs)
            bodies.push(body)
            peeled.push(body)
        }
        let bodies = self.balance(binders.as_slice(), bodies.as_slice())?
        var out = Vec(u32).new()
        for k, body in bodies {
            if body == peeled[k] { out.push(cases[k]); continue }
            out.push(self.wrap(binders[k].as_slice(), body)?)
        }
        Ok(out)
    }

    // The value assigned to `name` that no later binder shadows, if any: its
    // context length and term.
    fn assigned(self, name: str) -> Option((i64, u32)) {
        var i = self.names.len()
        var binder: i64 = -1
        while i > 0 {
            i -= 1
            if self.names[i] == name { binder = i; break }
        }
        var j = self.aliases.len()
        while j > 0 {
            j -= 1
            let (n, at, term) = self.aliases[j]
            if n == name { return if at > binder { Some((at, term)) } else { None } }
        }
        None
    }

    fn name(inout self, name: str, sp: diag.Span) -> Result(u32, diag.Diag) {
        if name == "_" { return Err(error(sp, "a discarded binding is not a value")) }
        match self.assigned(name) {
            Some((at, term)) => return self.c.shift(term, self.ctx.len() - at, 0, core.DEPTH)
            None => {}
        }
        var i = self.names.len()
        while i > 0 {
            i -= 1
            if self.names[i] == name {
                return self.c.add(core.Term.Var((self.names.len() - 1 - i) as u32), sp)
            }
        }
        match self.scope(name) {
            Some((module, n)) => for i, d in self.c.definitions {
                let (owner, public) = self.definitions[i]
                if owner == module && d.name == n && (module == self.module || public) {
                    return self.c.add(core.Term.Global(i as u32), sp)
                }
            }
            None => {}
        }
        Err(error(sp, ("unknown name (or recursive/forward definition): " + name).as_str()))
    }

    fn imported(self, alias: str) -> bool {
        for (a, _) in self.imports { if a == alias { return true } }
        false
    }

    // A source name belongs to this module, or to one explicitly imported
    // alias. Never fall back to a declaration loaded through another module.
    fn scope(self, name: str) -> Option((u32, String)) {
        let Some(dot) = name.find(".") else { return Some((self.module, name.to_string())) }
        let alias = name[..dot]
        let member = name[dot + 1..]
        if member.find(".").is_some() { return None }
        for (a, module) in self.imports {
            if a == alias { return Some((module, member.to_string())) }
        }
        None
    }

    fn family_visible(self, f: u32) -> bool {
        let (owner, public) = self.families[f as i64]
        owner == self.module || public
    }

    fn field_visible(self, f: u32, field: i64) -> bool {
        if self.families[f as i64].0 == self.module { return true }
        for s in self.structs { if s.0 == f { return s.2[field] } }
        true
    }

    // Constructors and induction expose every field, unlike a named match
    // pattern with `..`. Enforce privacy before elaborating their bodies.
    fn exposed(inout self, f: u32, sp: diag.Span) -> Result((), diag.Diag) {
        if !self.family_visible(f) { return Err(error(
            sp,
            "a private type cannot be inspected here"
        )) }
        match self.struct_fields(f) {
            Some(names) => for i, name in names {
                if !self.field_visible(f, i) {
                    return Err(error(sp, ("private struct field: " + name).as_str()))
                }
            }
            None => {}
        }
        Ok(())
    }

    // The field names of a struct.
    fn struct_fields(self, f: u32) -> Option(Vec(String)) {
        for s in self.structs { if s.0 == f { return Some(s.1.clone()) } }
        None
    }

    // `Name` or `alias.Name` as an expression: the name.
    fn path_name(self, e: ast.Expr) -> Option(String) {
        match e.kind {
            Name(n) => Some(n.clone())
            Field(base, n) => {
                let ast.ExprKind.Name(alias) = base.kind else { return None }
                if self.imported(alias.as_str()) {
                    for local in self.names { if local == alias { return None } }
                    Some(alias.as_str() + "." + n.as_str())
                } else { None }
            }
            _ => None
        }
    }

    fn find_family(self, name: str) -> Option(u32) {
        let Some((module, n)) = self.scope(name) else { return None }
        for i, f in self.c.families {
            let (owner, public) = self.families[i]
            if owner == module && f.name == n && (module == self.module || public) {
                return Some(i as u32)
            }
        }
        None
    }

    // A proposition's constructor; data constructors are qualified.
    fn find_constructor(self, name: str) -> Option((u32, u32)) {
        let Some((module, n)) = self.scope(name) else { return None }
        for i, f in self.c.families {
            let (owner, public) = self.families[i]
            if f.data || owner != module || (module != self.module && !public) { continue }
            for k, c in f.constructors { if c.name == n { return Some((i as u32, k as u32)) } }
        }
        None
    }

    // `E.V` or `E(indices).V` for a data type E.
    fn find_variant(self, e: ast.Expr) -> Option((u32, u32)) {
        let ast.ExprKind.Field(base, variant) = e.kind else { return None }
        let family = match base.kind {
            Call(f, _) => f.deref()
            _ => base.deref()
        }
        let Some(name) = self.path_name(family) else { return None }
        let Some(f) = self.find_family(name.as_str()) else { return None }
        if !self.c.families[f as i64].data { return None }
        for k, c in self.c.families[f as i64].constructors {
            if c.name == variant { return Some((f, k as u32)) }
        }
        None
    }

    // Explicit family indices supply context for a constructor's fields,
    // including when the surrounding expression has no expected type.
    fn variant(
        inout self,
        e: ast.Expr,
        f: u32,
        k: u32,
        args: [ast.Expr],
        expected: Option(u32),
        sp: diag.Span,
        depth: u32
    ) -> Result(u32, diag.Diag) {
        let ast.ExprKind.Field(base, _) = e.kind else {
            return Err(error(sp, "malformed data constructor"))
        }
        match base.kind {
            Call(_, _) => {
                self.exposed(f, sp)?
                let annotation = self.type_expr(base.deref(), depth - 1)?
                // Check before normalization: conversion may discard invalid
                // evidence in an index, but a written annotation must be valid.
                let _ = self.c.infer(annotation, self.ctx.as_slice(), true, core.DEPTH)?
                let value = self.construct(f, k, args, Some(annotation), sp, depth)?
                self.c.require(value, annotation, self.ctx.as_slice(), true, core.DEPTH)?
                Ok(value)
            }
            _ => self.construct(f, k, args, expected, sp, depth)
        }
    }

    // A constructor, fully applied; each field is elaborated against the
    // telescope instantiated so far.
    fn construct(
        inout self,
        f: u32,
        k: u32,
        args: [ast.Expr],
        expected: Option(u32),
        sp: diag.Span,
        depth: u32
    ) -> Result(u32, diag.Diag) {
        self.exposed(f, sp)?
        var ty = self.c.families[f as i64].constructors[k as i64].ty
        var fields = Vec(u32).new()
        // A data type's parameters come from the expected type.
        let params = self.c.families[f as i64].params as i64
        if params > 0 {
            let message = "a value of a parameterized type needs its expected type"
            let Some(t) = expected else { return Err(error(sp, message)) }
            let t = self.c.normal(t, core.DEPTH)?
            let core.Term.Ind(g, xs) = self.c.term(t) else { return Err(error(sp, message)) }
            if g != f { return Err(error(sp, "a value of another type was expected")) }
            for j in 0..params {
                let normal = self.c.normal(ty, core.DEPTH)?
                let core.Term.Pi(_, _, result) = self.c.term(normal) else {
                    return Err(error(sp, "malformed constructor"))
                }
                fields.push(xs[j])
                ty = self.c.substitute(result, xs[j], core.DEPTH)?
            }
        }
        for a in args {
            let normal = self.c.normal(ty, core.DEPTH)?
            let core.Term.Pi(_, domain, result) = self.c.term(normal) else {
                return Err(error(sp, "too many constructor arguments"))
            }
            let field = self.expr(a, Some(domain), depth - 1)?
            fields.push(field)
            ty = self.c.substitute(result, field, core.DEPTH)?
        }
        let normal = self.c.normal(ty, core.DEPTH)?
        let core.Term.Ind(_, _) = self.c.term(normal) else {
            return Err(error(sp, "a constructor requires all of its fields"))
        }
        self.c.add(core.Term.Con(f, k, fields), sp)
    }

    // `match v { V(x, ...) => e, ... }` on a data value, one arm per
    // variant, into the expected type: case analysis with a motive that
    // does not depend on the value.
    fn case_analysis(
        inout self,
        scrutinee: ast.Expr,
        arms: [ast.Arm],
        expected: Option(u32),
        sp: diag.Span,
        depth: u32
    ) -> Result(u32, diag.Diag) {
        // With no context, the first constructor arm determines a constant
        // result type. It must not mention that arm's local fields.
        var t = match expected { Some(t) => t, None => self.u64(sp)? }
        let x = self.expr(scrutinee, None, depth - 1)?
        let ty = self.c.infer(x, self.ctx.as_slice(), true, core.DEPTH)?
        var ty = self.c.normal(ty, core.DEPTH)?
        // A borrow is read without being consumed.
        let borrowed = match self.c.term(ty) {
            Ref(inner) => {
                ty = self.c.normal(inner, core.DEPTH)?
                true
            }
            _ => false
        }
        let core.Term.Ind(f, _) = self.c.term(ty) else {
            return Err(error(scrutinee.span, "match requires a value of a data type"))
        }
        if !self.c.families[f as i64].data {
            return Err(error(scrutinee.span, "match requires a value of a data type; use induct"))
        }
        let core.Term.Ind(_, xs) = self.c.term(ty) else { return Err(error(sp, "unreachable")) }
        if !self.family_visible(f) { return Err(error(
            sp,
            "a private type cannot be inspected here"
        )) }
        let (initial_p, ps) = self.constant_motive(f, xs.as_slice(), t, sp)?
        var p = initial_p
        let count = self.c.families[f as i64].constructors.len()
        if arms.len != count { return Err(error(sp, "match requires one arm per variant")) }
        if count == 0 && expected.is_none() { return Err(error(
            sp,
            "an empty match needs an expected type"
        )) }
        var ghost = self.proposition(t)
        // A match on a borrowed variable refines what mentions it: the
        // expected type, and evidence in scope, which each arm sees anew under
        // its own name.
        var general = Vec(i64).new()
        var scrutinee_var: Option(u32) = None
        if expected.is_some() && (
            borrowed || (self.c.is_boxed(f) && !ghost && params_only(self.c.families[f as i64]))
        ) {
            match self.c.term(x) {
                Var(v) => {
                    scrutinee_var = Some(v)
                    for i in self.ctx.len() - v as i64..self.ctx.len() {
                        if !self.ctx[i].erased { continue }
                        let ty = self.type_at(i)?
                        var depends = self.mentions(ty, v)
                        for g in general {
                            if self.mentions(ty, (self.ctx.len() - 1 - g) as u32) { depends = true }
                        }
                        if depends { general.push(i) }
                    }
                }
                _ => {}
            }
        }
        let dependent = match scrutinee_var {
            Some(v) => general.len() > 0 || self.mentions(t, v)
            None => false
        }
        // A proof by cases reads the value the borrow reads: evidence never
        // runs, so nothing is lent or freed. Otherwise the view's motive is
        // over the borrow.
        var proof_by_cases = borrowed && ghost
        let family = self.c.add(core.Term.Ind(f, xs.clone()), sp)?
        var motive = match scrutinee_var {
            Some(v) if dependent && borrowed => {
                let domain = if proof_by_cases { family } else {
                    self.c.add(core.Term.Ref(family), sp)?
                }
                self.general_motive(
                    domain,
                    v,
                    general.as_slice(),
                    t,
                    proof_by_cases,
                    sp
                )?
            }
            _ => if proof_by_cases { p } else { t }
        }
        // A match on an owned variable of heap data takes it apart: the
        // expected type then reads the node, so an arm can prove what the
        // function promises about the value it started with.
        var owned_motive = match scrutinee_var {
            Some(v) if !borrowed && dependent => self.general_motive(
                family,
                v,
                general.as_slice(),
                t,
                false,
                sp
            )?
            _ => p
        }
        var cases = Vec(u32).new()
        var arities = Vec(i64).new()
        for k in 0..count {
            let name = self.c.families[f as i64].constructors[k].name.clone()
            var found: Option(i64) = None
            for i, arm in arms {
                if self.variant_name(arm.pat, f) == Some(name.clone()) {
                    if found.is_some() { return Err(error(arm.span, "duplicate match arm")) }
                    found = Some(i)
                }
            }
            let Some(i) = found else { return Err(error(
                sp,
                ("match has no arm for " + name.as_str()).as_str()
            )) }
            let arm = arms[i]
            if arm.guard.is_some() { return Err(error(arm.span, "match guards are unsupported")) }
            let binders = match arm.pat.kind {
                Variant(_, pats) => {
                    if self.struct_fields(f).is_some() {
                        return Err(error(arm.span, "a struct pattern uses named fields"))
                    }
                    pats.clone()
                }
                Struct(_, given, rest) => {
                    // In the order of the struct's fields; `..` leaves the rest.
                    let Some(names) = self.struct_fields(f) else {
                        return Err(error(arm.span, "only a struct has named fields"))
                    }
                    // Reject unknown/duplicate fields as well as private
                    // fields, including explicit `_` patterns.
                    for i, g in given {
                        var found = false
                        for j, n in names {
                            if g.name == n {
                                found = true
                                if !self.field_visible(f, j) {
                                    return Err(error(
                                        g.pat.span,
                                        ("private struct field: " + n).as_str()
                                    ))
                                }
                            }
                        }
                        if !found { return Err(error(g.pat.span, "unknown struct pattern field")) }
                        for j in 0..i {
                            if given[j].name == g.name { return Err(error(
                                g.pat.span,
                                "duplicate struct pattern field"
                            )) }
                        }
                    }
                    var out = Vec(ast.Pat).new()
                    for n in names {
                        var found = false
                        for g in given {
                            if g.name == n {
                                out.push(g.pat.clone())
                                found = true
                            }
                        }
                        if !found {
                            if !rest { return Err(error(
                                arm.span,
                                ("missing field: " + n).as_str()
                            )) }
                            out.push(ast.Pat { kind: ast.PatKind.Wild, span: arm.span })
                        }
                    }
                    out
                }
                _ => Vec(ast.Pat).new()
            }
            var result = if proof_by_cases {
                self.c.data_case_type(f, k as u32, motive, ps.as_slice(), sp, core.DEPTH)?
            } else if borrowed {
                self.c.view_case_type(f, k as u32, ps.as_slice(), motive, false, sp, core.DEPTH)?
            } else { self.c.data_case_type(
                f,
                k as u32,
                owned_motive,
                ps.as_slice(),
                sp,
                core.DEPTH
            )? }
            var domains = Vec((bool, u32)).new()
            for b in binders {
                let binder = match b.kind {
                    Name(n, false) if !reserved(n.as_str()) => n.clone()
                    Wild => "_".to_string()
                    _ => return Err(error(b.span, "variant fields bind names or _"))
                }
                let normal = self.c.normal(result, core.DEPTH)?
                let core.Term.Pi(erased, domain, rest) = self.c.term(normal) else {
                    return Err(error(b.span, "too many variant fields"))
                }
                self.push(binder.as_str(), domain, erased)
                // A field taken out of owned data is the arm's to change.
                if !borrowed && !erased {
                    let at = self.ctx.len() - 1
                    if self.owner(at).is_some() { self.mutable[at] = true }
                }
                domains.push((erased, domain))
                result = rest
            }
            if domains.len() != self.c.case_arity(f, k as u32, false) {
                for _ in 0..domains.len() { self.pop() }
                return Err(error(arm.span, "a match arm binds every field"))
            }
            // The arm sees the evidence the match refines under its own name.
            for g in general {
                let normal = self.c.normal(result, core.DEPTH)?
                let core.Term.Pi(erased, domain, rest) = self.c.term(normal) else {
                    return Err(error(arm.span, "unreachable"))
                }
                let name = self.names[g].clone()
                self.push(name.as_str(), domain, erased)
                domains.push((erased, domain))
                result = rest
            }
            let normal = self.c.normal(result, core.DEPTH)?
            match self.c.term(normal) {
                Pi(_, _, _) => {
                    for _ in 0..domains.len() { self.pop() }
                    return Err(error(arm.span, "a match arm binds every field"))
                }
                _ => {}
            }
            let infer_result = expected.is_none() && k == 0
            var value = self.scope_expr(
                arm.body,
                if infer_result { None } else { Some(result) },
                depth - 1
            )?
            if infer_result {
                let inferred = self.c.infer(value, self.ctx.as_slice(), true, core.DEPTH)?
                // Normalization may remove a local index that is irrelevant
                // to the result, but cannot turn invalid evidence into a type.
                let inferred = self.c.normal(inferred, core.DEPTH)?
                t = match self.c.shift(inferred, -domains.len(), 0, core.DEPTH) {
                    Ok(t) => t
                    Err(_) => return Err(error(
                        arm.span,
                        "a field-dependent match result needs an expected type"
                    ))
                }
                let (new_p, _) = self.constant_motive(f, xs.as_slice(), t, sp)?
                p = new_p
                ghost = self.proposition(inferred)
                if borrowed && ghost { return Err(error(
                    arm.span,
                    "a proof by borrowed cases needs an expected type"
                )) }
                proof_by_cases = borrowed && ghost
                motive = if proof_by_cases { p } else { t }
                owned_motive = p
            }
            // A field the arm does not use is freed.
            if !ghost { value = self.settle(value, domains.len())? }
            arities.push(domains.len())
            var j = domains.len()
            while j > 0 {
                j -= 1
                let (erased, domain) = domains[j]
                self.pop()
                value = self.c.add(core.Term.Lam(erased, domain, value), arm.span)?
            }
            cases.push(value)
        }
        // One arm runs: what one uses, the others free.
        if !ghost { cases = self.balance_cases(cases.as_slice(), arities.as_slice())? }
        if borrowed {
            var term = if proof_by_cases {
                let value = self.c.add(core.Term.Deref(x), sp)?
                self.c.add(core.Term.Case(f, motive, cases, value), sp)?
            } else { self.c.add(core.Term.View(false, f, motive, cases, x), sp)? }
            for g in general {
                let v = self.c.add(core.Term.Var((self.ctx.len() - 1 - g) as u32), sp)?
                term = self.c.add(core.Term.App(term, v), sp)?
            }
            return Ok(term)
        }
        // On heap data, one level: the node is freed, its fields are given.
        if self.c.is_boxed(f) {
            var term = self.c.add(core.Term.Case(f, owned_motive, cases, x), sp)?
            for g in general {
                let v = self.c.add(core.Term.Var((self.ctx.len() - 1 - g) as u32), sp)?
                term = self.c.add(core.Term.App(term, v), sp)?
            }
            return Ok(term)
        }
        self.c.add(core.Term.Elim(f, p, cases, x), sp)
    }

    // The motive of a match, fn(indices..., x) { t }, which ignores the
    // value, and the parameters of the scrutinee's type xs.
    fn constant_motive(
        inout self,
        f: u32,
        xs: [u32],
        t: u32,
        sp: diag.Span
    ) -> Result((u32, Vec(u32)), diag.Diag) {
        let params = self.c.families[f as i64].params as i64
        let r = xs.len - params
        var ps = Vec(u32).new()
        for j in 0..params { ps.push(xs[j]) }
        var indices = Vec(u32).new()
        for q in ps { indices.push(self.c.shift(q, r, 0, core.DEPTH)?) }
        for j in 0..r { indices.push(self.c.add(core.Term.Var((r - 1 - j) as u32), sp)?) }
        let family = self.c.add(core.Term.Ind(f, indices), sp)?
        let body = self.c.shift(t, r + 1, 0, core.DEPTH)?
        var p = self.c.add(core.Term.Lam(false, family, body), sp)?
        let u = self.u64(sp)?
        for _ in 0..r { p = self.c.add(core.Term.Lam(false, u, p), sp)? }
        Ok((p, ps))
    }

    // Whether a data motive's values are propositions.
    fn proposition_motive(inout self, p: u32) -> Result(bool, diag.Diag) {
        let ty = self.c.infer(p, self.ctx.as_slice(), true, core.DEPTH)?
        var t = self.c.normal(ty, core.DEPTH)?
        loop {
            let core.Term.Pi(_, _, rest) = self.c.term(t) else { break }
            t = rest
        }
        Ok(self.c.term(t) == core.Term.Prop)
    }

    // fn(x) { P(x) }, a proposition about a value of data type f with
    // parameters ps; source data types have no other indices. With
    // `arguments`, fn(x, a: A, ...) { T } is a motive whose values are
    // functions of those arguments.
    fn data_motive(
        inout self,
        e: ast.Expr,
        f: u32,
        params: [u32],
        arguments: bool,
        depth: u32
    ) -> Result(u32, diag.Diag) {
        let ast.ExprKind.Lambda(ps, ret, body) = e.kind else {
            return Err(error(e.span, "a data motive requires fn(x) { proposition }"))
        }
        if ps.len() == 0 || ret.is_some() || reserved(ps[0].name.as_str()) ||
            (ps.len() != 1 && !arguments) {
            return Err(error(e.span, "a data motive requires a binder and no return annotation"))
        }
        if body.stmts.len() != 0 { return Err(error(body.span, "a data motive is one proposition")) }
        let Some(tail) = body.tail else { return Err(error(
            body.span,
            "a data motive is one proposition"
        )) }
        if self.c.families[f as i64].arity as i64 != params.len {
            return Err(error(e.span, "induct on an indexed data type needs a .jhc motive"))
        }
        var indices = Vec(u32).new()
        for q in params { indices.push(q) }
        let family = self.c.add(core.Term.Ind(f, indices), e.span)?
        self.parameter_annotation(ps[0], family, false)?
        self.push(ps[0].name.as_str(), family, false)
        var binders = Vec((bool, u32)).new()
        var failure: Option(diag.Diag) = None
        for j in 1..ps.len() {
            let parameter = ps[j]
            let Some(t) = parameter.ty else {
                failure = Some(error(parameter.span, "a motive's arguments have types"))
                break
            }
            if reserved(parameter.name.as_str()) {
                failure = Some(error(parameter.span, "a reserved name binds nothing"))
                break
            }
            for k in 0..j {
                if ps[k].name == parameter.name {
                    failure = Some(error(parameter.span, "duplicate motive parameter"))
                    break
                }
            }
            if failure.is_some() { break }
            match self.domain(t) {
                Ok((erased, domain)) => {
                    self.push(parameter.name.as_str(), domain, erased)
                    binders.push((erased, domain))
                }
                Err(d) => { failure = Some(d); break }
            }
        }
        let proposition: Result(u32, diag.Diag) = match failure {
            Some(d) => Err(d)
            None => self.type_expr(tail.deref(), depth - 1)
        }
        for _ in 0..binders.len() { self.pop() }
        self.pop()
        var result = proposition?
        var j = binders.len()
        while j > 0 {
            j -= 1
            let (erased, domain) = binders[j]
            result = self.c.add(core.Term.Pi(erased, domain, result), e.span)?
        }
        self.c.add(core.Term.Lam(false, family, result), e.span)
    }

    fn taken(self, name: str) -> bool {
        if self.imported(name) { return true }
        for i, d in self.c.definitions {
            if self.definitions[i].0 == self.module && d.name == name { return true }
        }
        self.find_family(name).is_some() || self.find_constructor(name).is_some()
    }

    // Qualified patterns must resolve to the scrutinee's actual family,
    // not merely share its final spelling with an unrelated type.
    fn variant_name(self, p: ast.Pat, family: u32) -> Option(String) {
        match p.kind {
            Name(n, false) => Some(n.clone())
            Struct(path, _, _) => {
                let name = self.type_path(path.as_slice())
                if self.find_family(name.as_str()) == Some(family) {
                    Some(self.c.families[family as i64].name.clone())
                } else { None }
            }
            Variant(path, _) => {
                if path.len() == 1 { return Some(path[0].clone()) }
                let name = self.type_path(path.as_slice()[..path.len() - 1])
                if self.find_family(name.as_str()) == Some(family) {
                    Some(path[path.len() - 1].clone())
                } else { None }
            }
            _ => None
        }
    }

    fn type_path(self, path: [String]) -> String {
        var name = String.new()
        for i, part in path {
            if i > 0 { name.push_str(".") }
            name.push_str(part.as_str())
        }
        name
    }

    // A family applied to U64 index expressions.
    fn indexed(
        inout self,
        f: u32,
        args: [ast.Expr],
        sp: diag.Span,
        depth: u32
    ) -> Result(u32, diag.Diag) {
        if args.len != self.c.families[f as i64].arity as i64 {
            return Err(error(sp, "wrong number of family indices"))
        }
        let u = self.u64(sp)?
        var xs = Vec(u32).new()
        for a in args { xs.push(self.expr(a, Some(u), depth - 1)?) }
        self.c.add(core.Term.Ind(f, xs), sp)
    }

    // Literal-only arithmetic has no signedness until context supplies it.
    // Look through both operands so `1 + n` and `(1 + 2) + n` infer the
    // same type as `n + 1`. This chooses a type, never converts an operand;
    // the kernel still rejects mixed signed/unsigned expressions.
    fn numeric_hint(inout self, e: ast.Expr, depth: u32) -> Result(Option(bool), diag.Diag) {
        if depth == 0 { return Err(error(e.span, "elaboration nesting limit reached")) }
        match e.kind {
            Int(_) => Ok(None)
            Unary(ast.UnOp.Neg, _) => Ok(Some(false))
            Binary(_, a, b) => {
                let left = self.numeric_hint(a.deref(), depth - 1)?
                if left.is_some() { return Ok(left) }
                self.numeric_hint(b.deref(), depth - 1)
            }
            _ => {
                let value = self.expr(e, None, depth - 1)?
                let ty = self.c.infer(value, self.ctx.as_slice(), true, core.DEPTH)?
                let ty = self.c.normal(ty, core.DEPTH)?
                Ok(Some(self.c.term(ty) == core.Term.U64))
            }
        }
    }

    // The expected scalar type wins; otherwise use a nonliteral operand.
    fn is_u64(inout self, e: ast.Expr, expected: Option(u32)) -> Result(bool, diag.Diag) {
        match expected {
            Some(t) => {
                let t = self.c.normal(t, core.DEPTH)?
                return Ok(self.c.term(t) == core.Term.U64)
            }
            None => {}
        }
        Ok(match self.numeric_hint(e, core.DEPTH)? { Some(unsigned) => unsigned, None => false })
    }

    fn u64(inout self, sp: diag.Span) -> Result(u32, diag.Diag) {
        self.c.add(core.Term.U64, sp)
    }

    // A type or proposition: evidence, which never runs.
    fn type_expr(inout self, e: ast.Expr, depth: u32) -> Result(u32, diag.Diag) {
        self.ghost += 1
        let result = self.proposition_expr(e, depth)
        self.ghost -= 1
        result
    }

    fn proposition_expr(inout self, e: ast.Expr, depth: u32) -> Result(u32, diag.Diag) {
        if depth == 0 { return Err(error(e.span, "elaboration nesting limit reached")) }
        match e.kind {
            Type(t) => self.ty(t, depth - 1)
            Name(n) if n == "u64" => self.u64(e.span)
            Name(n) if n == "i64" => self.c.add(core.Term.I64, e.span)
            Call(f, args) => {
                let Some(n) = self.path_name(f.deref()) else { return Err(error(
                    e.span,
                    "unsupported type"
                )) }
                match self.find_family(n.as_str()) {
                    Some(family) => return self.indexed(family, args.as_slice(), e.span, depth)
                    None => {}
                }
                if n == "refine" && args.len() == 1 {
                    let p = self.family(args[0], 1, depth - 1)?
                    return self.c.add(core.Term.Refine(p), e.span)
                }
                if n == "buffer" && args.len() == 1 {
                    let u = self.u64(e.span)?
                    let length = self.expr(args[0], Some(u), depth - 1)?
                    return self.c.add(core.Term.Buffer(length), e.span)
                }
                if (n != "Lt" && n != "Eq") || args.len() != 2 {
                    return Err(error(
                        e.span,
                        "expected Lt(i, n), Eq(a, b) or a declared proposition"
                    ))
                }
                let u = self.u64(e.span)?
                let a = self.expr(args[0], Some(u), depth - 1)?
                let b = self.expr(args[1], Some(u), depth - 1)?
                let proposition = if n == "Eq" { core.Term.Eq(a, b) } else { core.Term.Lt(a, b) }
                self.c.add(proposition, e.span)
            }
            Name(_) | Field(_, _) => {
                let Some(n) = self.path_name(e) else { return Err(error(
                    e.span,
                    "unsupported type in dependent_core"
                )) }
                let Some(family) = self.find_family(n.as_str()) else {
                    return Err(error(e.span, "unsupported type in dependent_core"))
                }
                self.indexed(family, [], e.span, depth)
            }
            _ => Err(error(e.span, "unsupported type in dependent_core"))
        }
    }

    fn ty(inout self, t: ast.Ty, depth: u32) -> Result(u32, diag.Diag) {
        self.ghost += 1
        let result = self.type_of(t, depth)
        self.ghost -= 1
        result
    }

    fn type_of(inout self, t: ast.Ty, depth: u32) -> Result(u32, diag.Diag) {
        if depth == 0 { return Err(error(t.span, "elaboration nesting limit reached")) }
        match t.kind {
            Path(path, args) if path.len() == 1 || (
                path.len() == 2 && self.imported(path[0].as_str())
            ) => {
                let name = self.type_path(path.as_slice())
                let n = name.as_str()
                match self.find_family(n) {
                    Some(family) => return match args {
                        Some(args) => self.indexed(family, args.as_slice(), t.span, depth)
                        None => self.indexed(family, [], t.span, depth)
                    }
                    None => {}
                }
                match args {
                    None => {
                        if n == "u64" { return self.u64(t.span) }
                        if n == "i64" { return self.c.add(core.Term.I64, t.span) }
                    }
                    Some(args) => {
                        if n == "buffer" {
                            if args.len() != 1 { return Err(error(t.span, "expected buffer(n)")) }
                            let u = self.u64(t.span)?
                            let length = self.expr(args[0], Some(u), depth - 1)?
                            return self.c.add(core.Term.Buffer(length), t.span)
                        }
                        if n == "refine" {
                            if args.len() != 1 { return Err(error(
                                t.span,
                                "expected refine(fn(x) { proposition })"
                            )) }
                            let p = self.family(args[0], 1, depth - 1)?
                            return self.c.add(core.Term.Refine(p), t.span)
                        }
                        if (n == "Lt" || n == "Eq") && args.len() == 2 {
                            let u = self.u64(t.span)?
                            let a = self.expr(args[0], Some(u), depth - 1)?
                            let b = self.expr(args[1], Some(u), depth - 1)?
                            let proposition = if n == "Eq" { core.Term.Eq(a, b) }
                            else { core.Term.Lt(a, b) }
                            return self.c.add(proposition, t.span)
                        }
                    }
                }
                Err(error(t.span, "unsupported type in dependent_core"))
            }
            // Function types list unnamed domains, all in the outer source
            // context. Shift them under the preceding Pi binders without
            // introducing names that could capture an outer index.
            Fn(params, result) => {
                if params.len() == 0 { return Err(error(
                    t.span, "a dependent function type needs at least one parameter"
                )) }
                let Some(result) = result else { return Err(error(
                    t.span, "a dependent function type needs an explicit result"
                )) }
                var domains = Vec((bool, u32)).new()
                for p in params {
                    if p.mode != ast.Mode.Let { return Err(error(
                        p.ty.span, "function type parameters use plain types or erased(T)"
                    )) }
                    let (erased, domain) = self.domain_at(p.ty, depth - 1)?
                    let _ = self.c.infer(domain, self.ctx.as_slice(), true, core.DEPTH)?
                    domains.push((erased, domain))
                }
                var ty = self.ty(result.deref(), depth - 1)?
                let _ = self.c.infer(ty, self.ctx.as_slice(), true, core.DEPTH)?
                ty = self.c.shift(ty, params.len(), 0, core.DEPTH)?
                var i = domains.len()
                while i > 0 {
                    i -= 1
                    let (erased, domain) = domains[i]
                    let domain = self.c.shift(domain, i, 0, core.DEPTH)?
                    ty = self.c.add(core.Term.Pi(erased, domain, ty), t.span)?
                }
                let _ = self.c.infer(ty, self.ctx.as_slice(), true, core.DEPTH)?
                Ok(ty)
            }
            // `ref T`: a borrow of a buffer or heap data.
            Ref(inner, false) => {
                let inner = self.ty(inner.deref(), depth - 1)?
                self.c.add(core.Term.Ref(inner), t.span)
            }
            Array(element, length) => {
                let element = self.ty(element.deref(), depth - 1)?
                if self.c.term(element) != core.Term.I64 { return Err(error(
                    t.span,
                    "arrays require i64 elements"
                )) }
                let u = self.u64(t.span)?
                let n = self.expr(length.deref(), Some(u), depth - 1)?
                self.c.add(core.Term.Array(n), t.span)
            }
            _ => Err(error(t.span, "unsupported type in dependent_core"))
        }
    }

    fn domain(inout self, t: ast.Ty) -> Result((bool, u32), diag.Diag) {
        self.domain_at(t, core.DEPTH)
    }

    fn domain_at(inout self, t: ast.Ty, depth: u32) -> Result((bool, u32), diag.Diag) {
        if let_erased(t) {
            let ast.TyKind.Path(_, Some(args)) = t.kind else { return Err(error(
                t.span,
                "expected erased(P)"
            )) }
            if args.len() != 1 { return Err(error(t.span, "expected erased(P)")) }
            return Ok((true, self.type_expr(args[0], depth)?))
        }
        Ok((false, self.ty(t, depth)?))
    }

    // Context decides relevance. An optional annotation checks the domain;
    // spelling erased(T) additionally asserts that the binder is erased.
    fn parameter_annotation(
        inout self,
        p: ast.LambdaParam,
        domain: u32,
        erased: bool
    ) -> Result((), diag.Diag) {
        let Some(t) = p.ty else { return Ok(()) }
        let (annotated_erased, annotation) = self.domain(t)?
        // Check before conversion: reduction may erase invalid evidence in
        // an annotation, and annotations do not survive into the final term.
        let _ = self.c.infer(annotation, self.ctx.as_slice(), true, core.DEPTH)?
        if (annotated_erased && !erased) || !self.c.equal(annotation, domain, core.DEPTH)? {
            return Err(error(
                t.span,
                "lambda parameter annotation does not match its expected type"
            ))
        }
        Ok(())
    }

    fn block(
        inout self,
        b: ast.Block,
        expected: Option(u32),
        depth: u32
    ) -> Result(u32, diag.Diag) {
        let Some(tail) = b.tail else {
            // A function with no result gives back evidence of nothing.
            if !self.unit { return Err(error(b.span, "dependent_core blocks require a value")) }
            let value = unit_value(b.span)
            return self.lets(b.stmts.as_slice(), value, expected, depth)
        }
        self.lets(b.stmts.as_slice(), tail.deref(), expected, depth)
    }

    fn family(inout self, e: ast.Expr, arity: i64, depth: u32) -> Result(u32, diag.Diag) {
        if depth == 0 { return Err(error(e.span, "elaboration nesting limit reached")) }
        let ast.ExprKind.Lambda(ps, ret, body) = e.kind else {
            return Err(error(e.span, "proof family requires fn(...) { proposition }"))
        }
        if ps.len() != arity || ret.is_some() {
            return Err(error(e.span, "wrong proof family arity"))
        }
        for i, p in ps {
            if reserved(p.name.as_str()) {
                return Err(error(p.span, "a reserved name binds nothing"))
            }
            for j in 0..i {
                if ps[j].name == p.name { return Err(error(p.span, "duplicate family parameter")) }
            }
        }
        if body.stmts.len() != 0 { return Err(error(
            body.span,
            "proof family requires a single proposition"
        )) }
        let Some(tail) = body.tail else { return Err(error(
            body.span,
            "proof family requires a proposition"
        )) }
        let u = self.u64(e.span)?
        for p in ps {
            self.parameter_annotation(p, u, false)?
            self.push(p.name.as_str(), u, false)
        }
        var proposition = self.type_expr(tail.deref(), depth - 1)?
        for _ in 0..ps.len() {
            self.pop()
            proposition = self.c.add(core.Term.Lam(false, u, proposition), e.span)?
        }
        Ok(proposition)
    }

    // A case of a proof: evidence, which never runs.
    fn evidence_case(
        inout self,
        e: ast.Expr,
        expected: u32,
        arity: i64,
        depth: u32
    ) -> Result(u32, diag.Diag) {
        self.ghost += 1
        let result = self.proof_case(e, expected, arity, depth)
        self.ghost -= 1
        result
    }

    // Without context, a fully annotated lambda supplies its own Pi telescope.
    // Keep annotation validation before normalization, then reuse proof_case's
    // body checking, erasure and ownership settlement.
    fn lambda_type(inout self, e: ast.Expr, depth: u32) -> Result(u32, diag.Diag) {
        if depth == 0 { return Err(error(e.span, "elaboration nesting limit reached")) }
        let ast.ExprKind.Lambda(ps, ret, _) = e.kind else {
            return Err(error(e.span, "expected a lambda"))
        }
        if ps.len() == 0 { return Err(error(
            e.span,
            "a lambda without context needs at least one parameter"
        )) }
        let Some(ret) = ret else { return Err(error(
            e.span,
            "a lambda without context needs a result annotation"
        )) }
        var domains = Vec((bool, u32)).new()
        for i, p in ps {
            if reserved(p.name.as_str()) {
                return Err(error(p.span, "a reserved name binds nothing"))
            }
            for j in 0..i {
                if ps[j].name == p.name { return Err(error(p.span, "duplicate lambda parameter")) }
            }
            let Some(t) = p.ty else { return Err(error(
                p.span,
                "a lambda without context needs parameter annotations"
            )) }
            let (erased, domain) = self.domain(t)?
            let _ = self.c.infer(domain, self.ctx.as_slice(), true, core.DEPTH)?
            domains.push((erased, domain))
            self.push(p.name.as_str(), domain, erased)
        }
        var result = self.ty(ret, depth - 1)?
        let _ = self.c.infer(result, self.ctx.as_slice(), true, core.DEPTH)?
        var i = domains.len()
        while i > 0 {
            i -= 1
            let (erased, domain) = domains[i]
            self.pop()
            result = self.c.add(core.Term.Pi(erased, domain, result), e.span)?
        }
        let _ = self.c.infer(result, self.ctx.as_slice(), true, core.DEPTH)?
        Ok(result)
    }

    fn proof_case(
        inout self,
        e: ast.Expr,
        expected: u32,
        arity: i64,
        depth: u32
    ) -> Result(u32, diag.Diag) {
        if depth == 0 { return Err(error(e.span, "elaboration nesting limit reached")) }
        let ast.ExprKind.Lambda(ps, ret, body) = e.kind else {
            return self.expr(e, Some(expected), depth - 1)
        }
        if ps.len() != arity { return Err(error(
            e.span,
            "wrong number of lambda parameters"
        )) }
        var domains = Vec((bool, u32)).new()
        var result = expected
        for i, p in ps {
            if reserved(p.name.as_str()) {
                return Err(error(p.span, "a reserved name binds nothing"))
            }
            for j in 0..i {
                if ps[j].name == p.name { return Err(error(p.span, "duplicate lambda parameter")) }
            }
            let normal = self.c.normal(result, core.DEPTH)?
            let core.Term.Pi(erased, domain, rest) = self.c.term(normal) else {
                return Err(error(p.span, "too many lambda parameters"))
            }
            self.parameter_annotation(p, domain, erased)?
            self.push(p.name.as_str(), domain, erased)
            // An owned value given to this code is its own to change.
            let at = self.ctx.len() - 1
            if self.owner(at).is_some() { self.mutable[at] = true }
            domains.push((erased, domain))
            result = rest
        }
        match ret {
            Some(t) => {
                let annotation = self.ty(t, depth - 1)?
                let _ = self.c.infer(annotation, self.ctx.as_slice(), true, core.DEPTH)?
                if !self.c.equal(annotation, result, core.DEPTH)? {
                    return Err(error(
                        t.span,
                        "lambda result annotation does not match its expected type"
                    ))
                }
            }
            None => {}
        }
        var value = self.block(body, Some(result), depth - 1)?
        // A binder the body does not use is freed.
        if !self.proposition(result) { value = self.settle(value, domains.len())? }
        var i = domains.len()
        while i > 0 {
            i -= 1
            let (erased, domain) = domains[i]
            self.pop()
            value = self.c.add(core.Term.Lam(erased, domain, value), e.span)?
        }
        Ok(value)
    }

    // An expression of a proposition is evidence, which never runs.
    fn expr(inout self, e: ast.Expr, expected: Option(u32), depth: u32) -> Result(u32, diag.Diag) {
        match self.giving(e, expected)? {
            Some(t) => return self.give(e, t, depth)
            None => {}
        }
        let evidence = self.ghost == 0 && match expected {
            Some(t) => self.proposition(t)
            None => false
        }
        if !evidence { return self.value(e, expected, depth) }
        self.evidence(e, expected, depth)
    }

    fn evidence(
        inout self,
        e: ast.Expr,
        expected: Option(u32),
        depth: u32
    ) -> Result(u32, diag.Diag) {
        self.ghost += 1
        let result = self.value(e, expected, depth)
        self.ghost -= 1
        result
    }

    // A function applied to its arguments, each elaborated at the type the
    // function gives it.
    fn apply(
        inout self,
        f: u32,
        args: [ast.Expr],
        sp: diag.Span,
        depth: u32
    ) -> Result(u32, diag.Diag) {
        var function = f
        var ty = self.c.infer(function, self.ctx.as_slice(), true, core.DEPTH)?
        for a in args {
            let a = match addressed(a) { Some(inner) => inner, None => a }
            let normal = self.c.normal(ty, core.DEPTH)?
            let core.Term.Pi(erased, domain, result) = self.c.term(normal) else {
                return Err(error(sp, "application requires a dependent function"))
            }
            let lent = self.c.normal(domain, core.DEPTH)?
            let named = match a.kind { Name(_) => true, _ => false }
            let arg = match self.c.term(lent) {
                Ref(inner) if self.ghost > 0 || erased => self.borrowed(
                    a,
                    inner,
                    depth - 1
                )?
                Ref(_) if !named => return Err(error(
                    a.span,
                    "a borrow is of a named value: bind this one with let first"
                ))
                _ if erased => self.evidence(a, Some(domain), depth - 1)?
                _ => self.expr(a, Some(domain), depth - 1)?
            }
            function = self.c.add(core.Term.App(function, arg), sp)?
            ty = self.c.substitute(result, arg, core.DEPTH)?
        }
        Ok(function)
    }

    // A declared function's arguments: their number, and `&x` where a
    // parameter is inout.
    fn check_arguments(self, g: u32, args: [ast.Expr], sp: diag.Span) -> Result((), diag.Diag) {
        if args.len != self.arities[g as i64] { return Err(error(
            sp,
            "wrong argument count (evidence is explicit)"
        )) }
        for j, a in args {
            let changes = self.inouts[g as i64][j]
            if changes != addressed(a).is_some() { return Err(error(
                a.span,
                if changes { "an inout parameter takes &x" }
                else { "only an inout parameter takes &x" }
            )) }
        }
        Ok(())
    }

    // In types and evidence, an argument where a borrow is expected: a
    // borrow is passed on, and any other value of the owned type is
    // borrowed in place, since nothing there runs. The kernel checks that
    // such a borrow occurs only in types and evidence.
    fn borrowed(inout self, e: ast.Expr, inner: u32, depth: u32) -> Result(u32, diag.Diag) {
        let v = self.evidence(e, Some(inner), depth)?
        let ty = self.c.infer(v, self.ctx.as_slice(), true, core.DEPTH)?
        let ty = self.c.normal(ty, core.DEPTH)?
        match self.c.term(ty) {
            Ref(_) => Ok(v)
            _ => self.c.add(core.Term.Borrow(v), e.span)
        }
    }

    fn value(inout self, e: ast.Expr, expected: Option(u32), depth: u32) -> Result(u32, diag.Diag) {
        if depth == 0 { return Err(error(e.span, "elaboration nesting limit reached")) }
        let sp = e.span
        match e.kind {
            Name(n) => {
                // An owned local where a borrow is expected is lent.
                match expected {
                    Some(t) => {
                        let t = self.c.normal(t, core.DEPTH)?
                        match self.c.term(t) {
                            Ref(_) => match self.borrow(n.as_str(), sp)? {
                                Some(r) => return Ok(r)
                                None => {}
                            }
                            _ => {}
                        }
                    }
                    None => {}
                }
                self.name(n.as_str(), sp)
            }
            Int(n) => {
                var unsigned = false
                match expected {
                    Some(t) => {
                        let t = self.c.normal(t, core.DEPTH)?
                        unsigned = self.c.term(t) == core.Term.U64
                    }
                    None => {}
                }
                if unsigned { self.c.add(core.Term.Natural(n), sp) }
                else {
                    if n > 0x7fffffffffffffff { return Err(error(sp, "I64 literal overflow")) }
                    self.c.add(core.Term.Integer(n as i64), sp)
                }
            }
            Unary(ast.UnOp.Neg, value) => {
                let ast.ExprKind.Int(n) = value.kind else { return Err(error(
                    sp,
                    "only literal negation is supported"
                )) }
                if n > 0x8000000000000000 { return Err(error(sp, "I64 literal underflow")) }
                self.c.add(core.Term.Integer((0 - n as i128) as i64), sp)
            }
            Array(values) => {
                let i = self.c.add(core.Term.I64, sp)?
                var xs = Vec(u32).new()
                for v in values { xs.push(self.expr(v, Some(i), depth - 1)?) }
                self.c.add(core.Term.Elements(xs), sp)
            }
            Block(b) => self.block(b, expected, depth - 1)
            // A function where its type is known, such as a recursion's result.
            Lambda(ps, _, _) => {
                let t = match expected {
                    Some(t) => t
                    None => self.lambda_type(e, depth - 1)?
                }
                let value = self.proof_case(e, t, ps.len(), depth - 1)?
                if expected.is_none() {
                    let ghost = self.ghost > 0 || self.proposition(t)
                    self.c.require(value, t, self.ctx.as_slice(), ghost, core.DEPTH)?
                }
                Ok(value)
            }
            Field(_, _) => {
                let Some((f, k)) = self.find_variant(e) else { return Err(error(
                    sp,
                    "unsupported expression in dependent_core"
                )) }
                self.variant(e, f, k, [], expected, sp, depth)
            }
            // `S { field: value, ... }`, every field once.
            StructLit(path, inits) => {
                let Some(name) = self.path_name(path.deref()) else { return Err(error(
                    sp,
                    "unsupported expression in dependent_core"
                )) }
                let Some(f) = self.find_family(name.as_str()) else { return Err(error(
                    sp,
                    "unknown struct"
                )) }
                let Some(names) = self.struct_fields(f) else { return Err(error(
                    sp,
                    "unknown struct"
                )) }
                if inits.len() != names.len() { return Err(error(
                    sp,
                    "a struct value gives every field"
                )) }
                var args = Vec(ast.Expr).new()
                for n in names {
                    var found = false
                    for init in inits {
                        if init.name == n {
                            args.push(init.value.clone())
                            found = true
                        }
                    }
                    if !found { return Err(error(sp, ("missing field: " + n).as_str())) }
                }
                self.construct(f, 0, args.as_slice(), expected, sp, depth)
            }
            Match(scrutinee, arms) => self.case_analysis(
                scrutinee.deref(),
                arms.as_slice(),
                expected,
                sp,
                depth
            )
            Binary(op, a, b) => {
                let plus = match op { Add => true, _ => false }
                let unsigned = self.is_u64(e, expected)?
                if unsigned && !plus { return Err(error(
                    sp,
                    "u64 has only +; use sub(a, b, p) with p: Lt(b, a + 1)"
                )) }
                if unsigned {
                    // In the naturals; overflow traps at run time.
                    let u = self.u64(sp)?
                    let a = self.expr(a.deref(), Some(u), depth - 1)?
                    let b = self.expr(b.deref(), Some(u), depth - 1)?
                    return self.c.add(core.Term.UAdd(a, b), sp)
                }
                let arith = match op {
                    Add => core.Arith.Add
                    Sub => core.Arith.Sub
                    Mul => core.Arith.Mul
                    _ => return Err(error(sp, "dependent_core supports only i64 + - and *"))
                }
                // u64 has only addition: subtraction and products would
                // need evidence or a meaning in the naturals.
                let i = self.c.add(core.Term.I64, sp)?
                let a = self.expr(a.deref(), Some(i), depth - 1)?
                let b = self.expr(b.deref(), Some(i), depth - 1)?
                self.c.add(core.Term.Arith(arith, a, b), sp)
            }
            Call(f, args) => {
                let permitted = mem.replace(&self.allowed, false)
                if !permitted {
                    for a in args { if addressed(a).is_some() { return Err(error(
                        a.span,
                        "a call with &x is a let's value, a statement or a block's value"
                    )) } }
                }
                match self.find_variant(f.deref()) {
                    Some((family, k)) => return self.variant(
                        f.deref(),
                        family,
                        k,
                        args.as_slice(),
                        expected,
                        sp,
                        depth
                    )
                    None => {}
                }
                let qualified = self.path_name(f.deref())
                let is_field = match f.kind { Field(_, _) => true, _ => false }
                if is_field && qualified.is_some() {
                    let Some(n) = qualified else { return Err(error(sp, "unreachable")) }
                    match self.find_constructor(n.as_str()) {
                        Some((family, k)) => return self.construct(
                            family,
                            k,
                            args.as_slice(),
                            expected,
                            sp,
                            depth
                        )
                        None => {}
                    }
                    let function = self.name(n.as_str(), f.span)?
                    let core.Term.Global(g) = self.c.term(function) else {
                        return Err(error(f.span, "only declared functions can be called"))
                    }
                    self.check_arguments(g, args.as_slice(), sp)?
                    return self.apply(function, args.as_slice(), sp, depth)
                }
                let ast.ExprKind.Name(n) = f.kind else {
                    // A function-valued call or fully annotated lambda, applied directly.
                    let is_call = match f.kind { Call(_, _) | Lambda(_, _, _) => true, _ => false }
                    if !is_call { return Err(error(f.span, "calls require a named function")) }
                    let function = self.expr(f.deref(), None, depth - 1)?
                    return self.apply(function, args.as_slice(), sp, depth)
                }
                if n == "old" {
                    if args.len() != 1 { return Err(error(sp, "old requires a variable")) }
                    if self.ghost == 0 { return Err(error(sp, "old is evidence only")) }
                    let ast.ExprKind.Name(x) = args[0].kind else {
                        return Err(error(sp, "old requires a variable"))
                    }
                    // The outermost binding of the name: what it started as.
                    for i, m in self.names {
                        if m == x {
                            return self.c.add(core.Term.Var((self.names.len() - 1 - i) as u32), sp)
                        }
                    }
                    return Err(error(sp, ("unknown name: " + x).as_str()))
                }
                if n == "absurd" {
                    if args.len() != 1 { return Err(error(
                        sp,
                        "absurd requires evidence of Lt(i, 0)"
                    )) }
                    let Some(t) = expected else { return Err(error(
                        sp,
                        "absurd needs an expected type"
                    )) }
                    let p = self.evidence(args[0], None, depth - 1)?
                    return self.c.add(core.Term.Absurd(t, p), sp)
                }
                if n == "if_lt" || n == "if_eq" {
                    if args.len() != 4 { return Err(error(
                        sp,
                        (n.as_str() + " requires four arguments").as_str()
                    )) }
                    let u = self.u64(sp)?
                    let a = self.expr(args[0], Some(u), depth - 1)?
                    let b = self.expr(args[1], Some(u), depth - 1)?
                    let ast.ExprKind.Lambda(ps, ret, yes) = args[2].kind else {
                        return Err(error(args[2].span, "conditional requires fn(p) { value }"))
                    }
                    if ps.len() != 1 || reserved(
                        ps[0].name.as_str()
                    ) {
                        return Err(error(
                            args[2].span,
                            "conditional requires one proof binder"
                        ))
                    }
                    let proposition = if n == "if_eq" { core.Term.Eq(a, b) } else { core.Term.Lt(
                        a,
                        b
                    ) }
                    let p = self.c.add(proposition, sp)?
                    var inner_expected = match expected {
                        Some(t) => Some(self.c.shift(t, 1, 0, core.DEPTH)?)
                        None => None
                    }
                    self.parameter_annotation(ps[0], p, true)?
                    self.push(ps[0].name.as_str(), p, true)
                    match ret {
                        Some(annotation) => {
                            let t = self.ty(annotation, depth - 1)?
                            let _ = self.c.infer(t, self.ctx.as_slice(), true, core.DEPTH)?
                            match inner_expected {
                                Some(expected) => if !self.c.equal(t, expected, core.DEPTH)? {
                                    return Err(error(
                                        annotation.span,
                                        "lambda result annotation does not match its expected type"
                                    ))
                                }
                                None => inner_expected = Some(t)
                            }
                        }
                        None => {}
                    }
                    let yes = self.block(yes, inner_expected, depth - 1)?
                    let result = match expected {
                        Some(t) => t
                        None => {
                            let t = self.c.infer(yes, self.ctx.as_slice(), true, core.DEPTH)?
                            match inner_expected {
                                Some(annotation) => if !self.c.equal(t, annotation, core.DEPTH)? {
                                    return Err(error(
                                        sp,
                                        "conditional body does not match its result annotation"
                                    ))
                                }
                                None => {}
                            }
                            let t = self.c.normal(t, core.DEPTH)?
                            match self.c.shift(t, -1, 0, core.DEPTH) {
                                Ok(t) => t
                                Err(_) => return Err(error(
                                    sp,
                                    "a proof-dependent conditional result needs an expected type"
                                ))
                            }
                        }
                    }
                    self.pop()
                    let no = self.scope_expr(args[3], Some(result), depth - 1)?
                    // One branch runs: what one uses, the other frees.
                    var binders = Vec(Vec((bool, u32))).new()
                    var evidence = Vec((bool, u32)).new()
                    evidence.push((true, p))
                    binders.push(evidence)
                    binders.push(Vec((bool, u32)).new())
                    let ghost = self.proposition(result)
                    let (yes, no) = if ghost { (yes, no) } else {
                        let both = self.balance(binders.as_slice(), [yes, no])?
                        (both[0], both[1])
                    }
                    let branch = if n == "if_eq" { core.Term.IfEq(a, b, yes, no) }
                    else { core.Term.IfLt(a, b, yes, no) }
                    return self.c.add(branch, sp)
                }
                if n == "index" {
                    if args.len() != 3 { return Err(error(
                        sp,
                        "index requires array, index and evidence"
                    )) }
                    // An owned buffer is lent for the read.
                    let lent = match args[0].kind {
                        Name(x) if self.ghost == 0 => self.borrow(x.as_str(), args[0].span)?
                        _ => None
                    }
                    let a = match lent {
                        Some(r) => r
                        None => self.expr(args[0], None, depth - 1)?
                    }
                    let u = self.u64(sp)?
                    let i = self.expr(args[1], Some(u), depth - 1)?
                    let p = self.evidence(args[2], None, depth - 1)?
                    return self.c.add(core.Term.Index(a, i, p), sp)
                }
                if n == "sub" {
                    if args.len() != 3 { return Err(error(
                        sp,
                        "sub requires a, b and evidence of Lt(b, a + 1)"
                    )) }
                    let u = self.u64(sp)?
                    let a = self.expr(args[0], Some(u), depth - 1)?
                    let b = self.expr(args[1], Some(u), depth - 1)?
                    let p = self.evidence(args[2], None, depth - 1)?
                    return self.c.add(core.Term.USub(a, b, p), sp)
                }
                if n == "pack" {
                    // The predicate comes from the expected refinement.
                    if args.len() != 2 { return Err(error(
                        sp,
                        "pack requires a value and its evidence"
                    )) }
                    let Some(t) = expected else { return Err(error(
                        sp,
                        "pack needs an expected refine(...) type"
                    )) }
                    let t = self.c.normal(t, core.DEPTH)?
                    let core.Term.Refine(p) = self.c.term(t) else {
                        return Err(error(sp, "pack needs an expected refine(...) type"))
                    }
                    let u = self.u64(sp)?
                    let a = self.expr(args[0], Some(u), depth - 1)?
                    let q = self.evidence(args[1], None, depth - 1)?
                    return self.c.add(core.Term.Pack(p, a, q), sp)
                }
                if n == "alloc" {
                    if args.len() != 2 { return Err(error(
                        sp,
                        "alloc requires a length and a value"
                    )) }
                    let u = self.u64(sp)?
                    let length = self.expr(args[0], Some(u), depth - 1)?
                    let i = self.c.add(core.Term.I64, sp)?
                    let x = self.expr(args[1], Some(i), depth - 1)?
                    return self.c.add(core.Term.Alloc(length, x), sp)
                }
                if n == "store" {
                    if args.len() != 4 { return Err(error(
                        sp,
                        "store requires a buffer, an index, a value and evidence"
                    )) }
                    let target = match addressed(args[0]) { Some(inner) => inner, None => args[0] }
                    let b = self.expr(target, None, depth - 1)?
                    let u = self.u64(sp)?
                    let i = self.expr(args[1], Some(u), depth - 1)?
                    let t = self.c.add(core.Term.I64, sp)?
                    let v = self.expr(args[2], Some(t), depth - 1)?
                    let p = self.evidence(args[3], None, depth - 1)?
                    return self.c.add(core.Term.Store(b, i, v, p), sp)
                }
                if n == "free" {
                    if args.len() != 2 { return Err(error(
                        sp,
                        "free requires an owned value and the rest"
                    )) }
                    let b = self.expr(args[0], None, depth - 1)?
                    let ty = self.c.infer(b, self.ctx.as_slice(), true, core.DEPTH)?
                    let ty = self.c.normal(ty, core.DEPTH)?
                    let rest = self.expr(args[1], expected, depth - 1)?
                    // A buffer, or heap data with every node it owns.
                    return match self.c.term(ty) {
                        Ind(f, _) if self.c.is_boxed(f) => self.c.add(
                            core.Term.Drop(f, b, rest),
                            sp
                        )
                        _ => self.c.add(core.Term.Free(b, rest), sp)
                    }
                }
                if n == "load" {
                    if args.len() != 4 { return Err(error(
                        sp,
                        "load requires a buffer, an index, evidence and fn(x, b) { ... }"
                    )) }
                    let Some(t) = expected else { return Err(error(
                        sp,
                        "load needs an expected type"
                    )) }
                    let b = self.expr(args[0], None, depth - 1)?
                    let ty = self.c.infer(b, self.ctx.as_slice(), true, core.DEPTH)?
                    let ty = self.c.normal(ty, core.DEPTH)?
                    let core.Term.Buffer(length) = self.c.term(ty) else {
                        return Err(error(args[0].span, "load requires a buffer"))
                    }
                    let u = self.u64(sp)?
                    let i = self.expr(args[1], Some(u), depth - 1)?
                    let p = self.evidence(args[2], None, depth - 1)?
                    // fn(x: i64, b: buffer(n)) -> T
                    let i64 = self.c.add(core.Term.I64, sp)?
                    let length = self.c.shift(length, 1, 0, core.DEPTH)?
                    let again = self.c.add(core.Term.Buffer(length), sp)?
                    let result = self.c.shift(t, 2, 0, core.DEPTH)?
                    let inner = self.c.add(core.Term.Pi(false, again, result), sp)?
                    let k_ty = self.c.add(core.Term.Pi(false, i64, inner), sp)?
                    let k = self.proof_case(args[3], k_ty, 2, depth - 1)?
                    return self.c.add(core.Term.Load(b, i, p, k), sp)
                }
                if n == "witness" || n == "proof" {
                    if args.len() != 1 { return Err(error(
                        sp,
                        (n.as_str() + " requires one refinement").as_str()
                    )) }
                    let s = if n == "proof" { self.evidence(args[0], None, depth - 1)? }
                    else { self.expr(args[0], None, depth - 1)? }
                    let term = if n == "witness" { core.Term.Witness(s) } else { core.Term.Proof(s) }
                    return self.c.add(term, sp)
                }
                if n == "zero_le" {
                    if args.len() != 1 { return Err(error(sp, "zero_le requires one u64 value")) }
                    let u = self.u64(sp)?
                    let a = self.evidence(args[0], Some(u), depth - 1)?
                    return self.c.add(core.Term.ZeroLe(a), sp)
                }
                if n == "lt_add" || n == "lt_cancel" || n == "lt_le" {
                    let count = if n == "lt_le" { 5 } else { 4 }
                    if args.len() != count { return Err(error(
                        sp,
                        (n.as_str() + " requires three u64 values and its evidence").as_str()
                    )) }
                    let u = self.u64(sp)?
                    var xs = Vec(u32).new()
                    for k in 0..3 { xs.push(self.evidence(args[k], Some(u), depth - 1)?) }
                    for k in 3..count { xs.push(self.evidence(args[k], None, depth - 1)?) }
                    let rule = if n == "lt_add" { core.Term.LtAdd(xs[0], xs[1], xs[2], xs[3]) }
                    else if n == "lt_cancel" { core.Term.LtCancel(xs[0], xs[1], xs[2], xs[3]) }
                    else { core.Term.LtLe(xs[0], xs[1], xs[2], xs[3], xs[4]) }
                    return self.c.add(rule, sp)
                }
                if n == "fold" && args.len() == 4 {
                    // fold(n, fn(k) { T }, init, fn(i, p, acc) { ... }): T(k)
                    // is the accumulator's type after k iterations.
                    let u = self.u64(sp)?
                    let count = self.expr(args[0], Some(u), depth - 1)?
                    let t = self.family(args[1], 1, depth - 1)?
                    let proof = self.proposition_motive(t)?
                    if proof { self.ghost += 1 }
                    let zero = self.c.add(core.Term.Natural(0), sp)?
                    let first = self.c.add(core.Term.App(t, zero), sp)?
                    let init = self.expr(args[2], Some(first), depth - 1)
                    let ty = self.c.loop_body_type(count, t, proof, sp, core.DEPTH)
                    let saved = mem.replace(&self.barrier, self.ctx.len())
                    let body = match ty {
                        Ok(ty) => self.proof_case(args[3], ty, 3, depth - 1)
                        Err(d) => Err(d)
                    }
                    self.barrier = saved
                    if proof { self.ghost -= 1 }
                    return self.c.add(core.Term.Loop(count, t, init?, body?), sp)
                }
                if n == "fold" {
                    if args.len() != 3 { return Err(error(
                        sp,
                        "fold requires a count, an initial value and fn(i, p, acc) { body }"
                    )) }
                    let u = self.u64(sp)?
                    let count = self.expr(args[0], Some(u), depth - 1)?
                    // The accumulator is an i64, or a buffer of the expected type.
                    let acc = match expected {
                        Some(t) => t
                        None => self.c.add(core.Term.I64, sp)?
                    }
                    let init = self.expr(args[1], Some(acc), depth - 1)?
                    let acc = self.c.infer(init, self.ctx.as_slice(), true, core.DEPTH)?
                    let ty = self.c.fold_body_type(count, acc, sp, core.DEPTH)?
                    let saved = mem.replace(&self.barrier, self.ctx.len())
                    let body = self.proof_case(args[2], ty, 3, depth - 1)
                    self.barrier = saved
                    return self.c.add(core.Term.Fold(count, init, body?), sp)
                }
                if n == "induct" {
                    if args.len() < 2 { return Err(error(
                        sp,
                        "induct requires a motive, one case per constructor and evidence"
                    )) }
                    let evidence = self.expr(args[args.len() - 1], None, depth - 1)?
                    let ty = self.c.infer(evidence, self.ctx.as_slice(), true, core.DEPTH)?
                    let ty = self.c.normal(ty, core.DEPTH)?
                    match self.c.term(ty) {
                        Ref(inner) => return self.borrowed_recursion(
                            args.as_slice(),
                            evidence,
                            inner,
                            sp,
                            depth
                        )
                        _ => {}
                    }
                    let core.Term.Ind(f, xs) = self.c.term(ty) else {
                        return Err(error(
                            args[args.len() - 1].span,
                            "induct requires evidence of a declared proposition"
                        ))
                    }
                    self.exposed(f, sp)?
                    let data = self.c.families[f as i64].data
                    var ps = Vec(u32).new()
                    for j in 0..self.c.families[f as i64].params as i64 { ps.push(xs[j]) }
                    let count = self.c.families[f as i64].constructors.len()
                    if args.len() != count + 2 { return Err(error(
                        sp,
                        "induct requires one case per constructor"
                    )) }
                    let p = if data { self.data_motive(args[0], f, ps.as_slice(), false, depth - 1)? }
                    else { self.family(args[0], self.c.families[f as i64].arity as i64, depth - 1)? }
                    var cases = Vec(u32).new()
                    var arities = Vec(i64).new()
                    for k in 0..count {
                        let expected = if data && self.c.is_boxed(f) {
                            // Structural recursion: results for recursive fields.
                            let proof = self.proposition_motive(p)?
                            self.c.recursion_case_type(
                                f,
                                k as u32,
                                p,
                                ps.as_slice(),
                                proof,
                                sp,
                                core.DEPTH
                            )?
                        } else if data {
                            self.c.data_case_type(f, k as u32, p, ps.as_slice(), sp, core.DEPTH)?
                        } else { self.c.case_type(f, k as u32, p, sp, core.DEPTH)? }
                        // Fields, then one hypothesis per recursive field.
                        var arity = 0
                        var rest = self.c.normal(expected, core.DEPTH)?
                        loop {
                            let core.Term.Pi(_, _, inner) = self.c.term(rest) else { break }
                            arity += 1
                            rest = inner
                        }
                        // A recursion's case runs once per node; flat data's, once.
                        let saved = self.barrier
                        if data && self.c.is_boxed(f) { self.barrier = self.ctx.len() }
                        let case = self.proof_case(args[k + 1], expected, arity, depth - 1)
                        self.barrier = saved
                        cases.push(case?)
                        arities.push(arity)
                    }
                    // Case analysis of flat data into a type runs one case.
                    if data && !self.c.is_boxed(f) && !self.proposition_motive(p)? {
                        cases = self.balance_cases(cases.as_slice(), arities.as_slice())?
                    }
                    return self.c.add(core.Term.Elim(f, p, cases, evidence), sp)
                }
                match self.find_constructor(n.as_str()) {
                    Some((f, k)) => return self.construct(
                        f,
                        k,
                        args.as_slice(),
                        expected,
                        sp,
                        depth
                    )
                    None => {}
                }
                if n == "refl" {
                    if args.len() != 1 { return Err(error(sp, "refl requires one U64 argument")) }
                    let u = self.u64(sp)?
                    let a = self.evidence(args[0], Some(u), depth - 1)?
                    return self.c.add(core.Term.Refl(a), sp)
                }
                if n == "transport" {
                    if args.len() != 3 { return Err(error(
                        sp,
                        "transport requires family, equality and proof"
                    )) }
                    let family = self.family(args[0], 1, depth - 1)?
                    let equality = self.evidence(args[1], None, depth - 1)?
                    let proof = self.evidence(args[2], None, depth - 1)?
                    return self.c.add(core.Term.Transport(family, equality, proof), sp)
                }
                if n == "decide_lt" {
                    if args.len() != 2 { return Err(error(sp, "decide_lt requires two arguments")) }
                    let u = self.u64(sp)?
                    let a = self.evidence(args[0], Some(u), depth - 1)?
                    let b = self.evidence(args[1], Some(u), depth - 1)?
                    return self.c.add(core.Term.Decide(a, b), sp)
                }
                let mut_f = self.name(n.as_str(), f.span)?
                match self.c.term(mut_f) {
                    Global(g) => self.check_arguments(g, args.as_slice(), sp)?
                    // A recursion's result in its case.
                    Var(_) => {
                        let ty = self.c.infer(mut_f, self.ctx.as_slice(), true, core.DEPTH)?
                        let ty = self.c.normal(ty, core.DEPTH)?
                        match self.c.term(ty) {
                            Pi(_, _, _) => {}
                            _ => return Err(error(f.span, "only declared functions can be called"))
                        }
                    }
                    _ => return Err(error(f.span, "only declared functions can be called"))
                }
                self.apply(mut_f, args.as_slice(), sp, depth)
            }
            _ => Err(error(sp, "unsupported expression in dependent_core"))
        }
    }

    // `trait Name(i: u64, ...) { fn ctor(fields) -> Name(indices) }` declares
    // an inductive proposition. Its constructor signatures are elaborated
    // with the family already in scope; the kernel checks positivity.
    fn inductive(inout self, item: ast.Item, t: ast.TraitDecl) -> Result((), diag.Diag) {
        if item.attrs.len() != 0 || t.supertraits.len() != 0 { return Err(error(
            item.span,
            "inductive propositions have no attributes or supertraits"
        )) }
        if reserved(t.name.as_str()) || self.taken(t.name.as_str()) {
            return Err(error(item.span, "duplicate or reserved proposition name"))
        }
        for i, p in t.params {
            let valid = match p.ty {
                Some(ty) => match ty.kind { Path(path, None) => path.len() == 1 && path[0] == "u64", _ => false }
                None => false
            }
            // The parser marks a trait's parameters compile-time ones.
            let mode = p.mode == ast.Mode.Let || p.mode == ast.Mode.Comptime
            if !mode || p.bounds.len() != 0 || !valid || reserved(p.name.as_str()) {
                return Err(error(p.span, "inductive propositions are indexed by u64 parameters"))
            }
            for j in 0..i {
                if t.params[j].name == p.name { return Err(error(p.span, "duplicate index")) }
            }
        }
        let f = self.c.families.len() as u32
        self.families.push((self.module, item.public))
        self.c.families.push(core.Family {
            name: t.name.clone(),
            data: false,
            params: 0,
            arity: t.params.len() as u32,
            constructors: Vec(core.Constructor).new(),
            globals: self.c.definitions.len() as u32,
            span: item.span
        })
        for it in t.items {
            let ast.ItemKind.Fn(c) = it.kind else { return Err(error(
                it.span,
                "inductive propositions contain only constructor signatures"
            )) }
            let ast.RetMode.Value = c.ret_mode else { return Err(error(
                it.span,
                "borrowed results are unsupported"
            )) }
            let normal = match c.kind { Normal => true, _ => false }
            if it.attrs.len() != 0 || c.is_unsafe || c.variadic || c.requires.len() != 0 ||
                c.ensures.len() != 0 || c.body.is_some() || !normal {
                return Err(error(it.span, "constructors are plain signatures without a body"))
            }
            if reserved(c.name.as_str()) || self.taken(c.name.as_str()) {
                return Err(error(c.name_span, "duplicate or reserved constructor name"))
            }
            var domains = Vec((bool, u32)).new()
            for p in c.params {
                if p.mode != ast.Mode.Let || p.bounds.len() != 0 || reserved(p.name.as_str()) {
                    return Err(error(p.span, "constructor fields are u64 values or erased(P)"))
                }
                for name in self.names {
                    if name == p.name { return Err(error(p.span, "duplicate field")) }
                }
                let Some(ty) = p.ty else { return Err(error(p.span, "field needs an explicit type")) }
                let (erased, domain) = self.domain(ty)?
                domains.push((erased, domain))
                self.push(p.name.as_str(), domain, erased)
            }
            let Some(ret) = c.ret else { return Err(error(it.span, "constructor needs its result")) }
            var ty = self.ty(ret, core.DEPTH)?
            var i = domains.len()
            while i > 0 {
                i -= 1
                let (erased, domain) = domains[i]
                ty = self.c.add(core.Term.Pi(erased, domain, ty), it.span)?
                self.pop()
            }
            self.c.families[f as i64].constructors.push(core.Constructor {
                name: c.name.clone(),
                ty
            })
        }
        self.c.extend()
    }

    // `enum E { V(T, ...) ... }` declares a data type. Its variants'
    // fields are positional: u64, i64, refinements, earlier data types or
    // erased(P), and cannot name each other; a refinement field carries
    // what is known about a value. The kernel checks the declaration.
    fn data_type(inout self, item: ast.Item, e: ast.EnumDecl) -> Result((), diag.Diag) {
        if item.attrs.len() != 0 { return Err(error(item.span, "data types have no attributes")) }
        if reserved(e.name.as_str()) || self.taken(e.name.as_str()) {
            return Err(error(item.span, "duplicate or reserved data type name"))
        }
        // `enum E(n: u64, ...)`: u64 parameters, which the variants' fields
        // may use. Each constructor binds them first, erased.
        for i, p in e.params {
            let valid = match p.ty {
                Some(ty) => match ty.kind { Path(path, None) => path.len() == 1 && path[0] == "u64", _ => false }
                None => false
            }
            let mode = p.mode == ast.Mode.Let || p.mode == ast.Mode.Comptime
            if !mode || p.bounds.len() != 0 || !valid || reserved(p.name.as_str()) {
                return Err(error(p.span, "data types are parameterized by u64 values"))
            }
            for j in 0..i {
                if e.params[j].name == p.name { return Err(error(p.span, "duplicate parameter")) }
            }
        }
        let params = e.params.len()
        let f = self.c.families.len() as u32
        self.families.push((self.module, item.public))
        self.c.families.push(core.Family {
            name: e.name.clone(),
            data: true,
            params: params as u32,
            arity: params as u32,
            constructors: Vec(core.Constructor).new(),
            globals: self.c.definitions.len() as u32,
            span: item.span
        })
        let u = self.u64(item.span)?
        for p in e.params { self.push(p.name.as_str(), u, true) }
        let result = self.variants(f, e, params)
        for _ in 0..params { self.pop() }
        result?
        self.c.extend()
    }

    // `struct S { a: u64, b: buffer(a), p: erased(Lt(0, a)) }`: heap data with
    // one constructor, whose fields may name the fields before them.
    fn structure(inout self, item: ast.Item, s: ast.StructDecl) -> Result((), diag.Diag) {
        if item.attrs.len() != 0 || s.params.len() != 0 || s.invariants.len() != 0 {
            return Err(error(item.span, "a dependent_core struct has fields only"))
        }
        if reserved(s.name.as_str()) || self.taken(s.name.as_str()) {
            return Err(error(item.span, "duplicate or reserved data type name"))
        }
        let f = self.c.families.len() as u32
        self.families.push((self.module, item.public))
        self.c.families.push(core.Family {
            name: s.name.clone(),
            data: true,
            params: 0,
            arity: 0,
            constructors: Vec(core.Constructor).new(),
            globals: self.c.definitions.len() as u32,
            span: item.span
        })
        var names = Vec(String).new()
        var domains = Vec((bool, u32)).new()
        var failure: Option(diag.Diag) = None
        for field in s.fields {
            if reserved(field.name.as_str()) {
                failure = Some(error(field.span, "reserved dependent_core name"))
                break
            }
            let mut_name = field.name.clone()
            var duplicate = false
            for n in names { if n == mut_name { duplicate = true } }
            if duplicate {
                failure = Some(error(field.span, "duplicate field"))
                break
            }
            match self.domain(field.ty) {
                Ok((erased, domain)) => {
                    domains.push((erased, domain))
                    self.push(field.name.as_str(), domain, erased)
                    names.push(mut_name)
                }
                Err(d) => {
                    failure = Some(d)
                    break
                }
            }
        }
        var ty_result: Result(u32, diag.Diag) = self.c.add(
            core.Term.Ind(f, Vec(u32).new()),
            item.span
        )
        var j = domains.len()
        while j > 0 {
            j -= 1
            let (erased, domain) = domains[j]
            self.pop()
            ty_result = match ty_result {
                Ok(ty) => self.c.add(core.Term.Pi(erased, domain, ty), item.span)
                Err(d) => Err(d)
            }
        }
        match failure { Some(d) => return Err(d), None => {} }
        self.c.families[f as i64].constructors.push(core.Constructor {
            name: s.name.clone(),
            ty: ty_result?
        })
        var public = Vec(bool).new()
        for field in s.fields { public.push(field.public) }
        self.structs.push((f, names, public))
        self.c.extend()
    }

    // Each variant's constructor: (erased params...) -> (fields...) ->
    // E(params...). Fields are elaborated with only the parameters in scope.
    fn variants(inout self, f: u32, e: ast.EnumDecl, params: i64) -> Result((), diag.Diag) {
        for i, v in e.variants {
            if reserved(v.name.as_str()) { return Err(error(v.span, "reserved variant name")) }
            for j in 0..i {
                if e.variants[j].name == v.name { return Err(error(v.span, "duplicate variant")) }
            }
            var domains = Vec((bool, u32)).new()
            for t in v.fields { domains.push(self.domain(t)?) }
            let m = params + domains.len()
            var indices = Vec(u32).new()
            for j in 0..params { indices.push(self.c.add(
                core.Term.Var((m - 1 - j) as u32),
                v.span
            )?) }
            var ty = self.c.add(core.Term.Ind(f, indices), v.span)?
            var j = domains.len()
            while j > 0 {
                j -= 1
                let (erased, domain) = domains[j]
                // A field sees the parameters, not the fields before it.
                let domain = self.c.shift(domain, j, 0, core.DEPTH)?
                ty = self.c.add(core.Term.Pi(erased, domain, ty), v.span)?
            }
            let u = self.u64(v.span)?
            for _ in 0..params { ty = self.c.add(core.Term.Pi(true, u, ty), v.span)? }
            self.c.families[f as i64].constructors.push(core.Constructor {
                name: v.name.clone(),
                ty
            })
        }
        Ok(())
    }

    fn definition(inout self, item: ast.Item, entry: bool) -> Result((), diag.Diag) {
        match item.kind {
            Trait(t) => return self.inductive(item, t)
            Enum(e) => return self.data_type(item, e)
            Struct(s) => return self.structure(item, s)
            // Modules are elaborated in the order of their imports.
            Import(_) => return Ok(())
            _ => {}
        }
        let ast.ItemKind.Fn(f) = item.kind else { return Err(error(
            item.span,
            "dependent_core supports only function definitions and inductive propositions"
        )) }
        if item.attrs.len() != 0 || f.is_unsafe || f.variadic || f.requires.len() != 0 ||
            f.ensures.len() != 0 { return Err(error(
            item.span,
            "attributes, unsafe and contracts are unsupported in dependent_core"
        )) }
        let ast.RetMode.Value = f.ret_mode else { return Err(error(
            item.span,
            "borrowed results are unsupported"
        )) }
        let exported = match f.kind {
            Export => {
                if f.name == "main" { return Err(error(
                    f.name_span,
                    "main must be an ordinary function"
                )) }
                true
            }
            Normal => entry && f.name == "main"
            Extern => return Err(error(
                item.span,
                "foreign declarations are unsupported in dependent_core"
            ))
        }
        if reserved(f.name.as_str()) { return Err(error(
            f.name_span,
            "reserved dependent_core name"
        )) }
        if self.taken(f.name.as_str()) { return Err(error(f.name_span, "duplicate definition")) }
        var domains = Vec((bool, u32)).new()
        var flags = Vec(bool).new()
        var changing = Vec(i64).new()
        for p in f.params {
            let inout_param = p.mode == ast.Mode.Inout
            if (p.mode != ast.Mode.Let && !inout_param) || p.bounds.len() != 0 { return Err(error(
                p.span,
                "use erased(P) for evidence; comptime and sink are unsupported"
            )) }
            if reserved(p.name.as_str()) { return Err(error(p.span, "reserved dependent_core name")) }
            for name in self.names {
                if name == p.name { return Err(error(p.span, "duplicate parameter")) }
            }
            let Some(t) = p.ty else { return Err(error(p.span, "parameter needs an explicit type")) }
            let (erased, domain) = self.domain(t)?
            domains.push((erased, domain))
            self.push(p.name.as_str(), domain, erased)
            flags.push(inout_param)
            if inout_param {
                let at = self.ctx.len() - 1
                if erased || self.owner(at).is_none() { return Err(error(
                    p.span,
                    "an inout parameter is a buffer or heap data"
                )) }
                self.mutable[at] = true
                changing.push(at)
                self.givers.push(p.name.clone())
            }
        }
        // The result's type sees each inout parameter as it ends, and
        // old(x) as it started.
        var owners = Vec(u32).new()
        for at in changing {
            let t = self.type_at(at)?
            owners.push(t)
            let name = self.names[at].clone()
            self.push(name.as_str(), t, false)
        }
        self.unit = f.ret.is_none() && changing.len() > 0
        let mut_ret = match f.ret {
            Some(ret) => self.ty(ret, core.DEPTH)?
            None => {
                if !self.unit { return Err(error(item.span, "result needs an explicit type")) }
                let zero = self.c.add(core.Term.Natural(0), item.span)?
                let one = self.c.add(core.Term.Natural(1), item.span)?
                self.c.add(core.Term.Lt(zero, one), item.span)?
            }
        }
        var mut_ret = mut_ret
        var j = owners.len()
        while j > 0 {
            j -= 1
            let erased = self.proposition(mut_ret)
            self.pop()
            let m = self.c.add(core.Term.Lam(false, owners[j], mut_ret), item.span)?
            mut_ret = self.c.add(core.Term.Back(erased, owners[j], m), item.span)?
        }
        let Some(body) = f.body else { return Err(error(item.span, "function needs a body")) }
        var mut_body = self.block(body, Some(mut_ret), core.DEPTH)?
        self.unit = false
        self.givers = Vec(String).new()
        // A parameter the body does not use is freed.
        if !self.proposition(mut_ret) { mut_body = self.settle(mut_body, domains.len())? }
        var ty = mut_ret
        var value = mut_body
        var i = domains.len()
        while i > 0 {
            i -= 1
            let (erased, domain) = domains[i]
            ty = self.c.add(core.Term.Pi(erased, domain, ty), item.span)?
            value = self.c.add(core.Term.Lam(erased, domain, value), item.span)?
            self.pop()
        }
        if entry && f.name == "main" && (domains.len() != 0 || self.c.term(ty) != core.Term.I64) {
            return Err(error(item.span, "dependent_core main must have signature fn main() -> i64"))
        }
        // Foreign symbol names remain global even though source names do not.
        if exported {
            for d in self.c.definitions {
                if d.exported && d.name == f.name {
                    return Err(error(f.name_span, "duplicate exported symbol"))
                }
            }
        }
        self.definitions.push((self.module, item.public))
        self.c.definitions.push(core.Definition {
            name: f.name.clone(),
            ty,
            value,
            exported,
            span: item.span
        })
        self.arities.push(f.params.len())
        self.inouts.push(flags)
        // Make previously checked definitions available for type-directed
        // application elaboration. Lowering independently rechecks all terms.
        self.c.extend()
    }
}

// Whether a family has parameters and no true indices.
fn params_only(f: core.Family) -> bool { f.arity == f.params }

// x in `&x`.
fn addressed(e: ast.Expr) -> Option(ref ast.Expr) {
    match e.kind {
        Unary(ast.UnOp.Addr, inner) => Some(inner.deref())
        _ => None
    }
}

fn is_changing(e: ast.Expr) -> bool {
    let ast.ExprKind.Call(_, args) = e.kind else { return false }
    for a in args { if addressed(a).is_some() { return true } }
    false
}

fn is_store(e: ast.Expr) -> bool {
    let ast.ExprKind.Call(f, _) = e.kind else { return false }
    if !is_changing(e) { return false }
    match f.kind { Name(n) => n == "store", _ => false }
}

// decide_lt(0, 1): the evidence a function with no result gives back.
fn unit_value(sp: diag.Span) -> ast.Expr {
    var args = Vec(ast.Expr).new()
    args.push(ast.Expr { kind: ast.ExprKind.Int(0), span: sp })
    args.push(ast.Expr { kind: ast.ExprKind.Int(1), span: sp })
    let f = ast.Expr { kind: ast.ExprKind.Name("decide_lt".to_string()), span: sp }
    ast.Expr { kind: ast.ExprKind.Call(Box.new(f), args), span: sp }
}

fn let_erased(t: ast.Ty) -> bool {
    match t.kind { Path(p, _) => p.len() == 1 && p[0] == "erased", _ => false }
}

// Each module after the modules it imports.
fn module_order(a: load.Ast) -> Vec(i64) {
    var order = Vec(i64).new()
    var seen = Vec(bool).new()
    for _ in a.modules { seen.push(false) }
    visit_module(a, a.root as i64, &seen, &order)
    order
}

fn visit_module(a: load.Ast, i: i64, inout seen: Vec(bool), inout order: Vec(i64)) {
    if seen[i] { return }
    seen[i] = true
    for imp in a.modules[i].imports { visit_module(a, imp.module as i64, &seen, &order) }
    order.push(i)
}

pub fn compile(
    a: load.Ast,
    tgt: target.Target,
    library: bool,
    codegen: target.Codegen
) -> Result(mir.Program, diag.Diag) {
    let module = a.modules[a.root as i64].ast
    for attr in module.attrs {
        if attr != "dependent_core" { return Err(error(
            diag.Span.new(module.file, 0, 0),
            "dependent_core supports only the native profile"
        )) }
    }
    var e = Elaborator {
        c: core.Core.new(),
        names: Vec(String).new(),
        ctx: Vec(core.Binding).new(),
        arities: Vec(i64).new(),
        frames: Vec(Frame).new(),
        ghost: 0,
        mutable: Vec(bool).new(),
        inouts: Vec(Vec(bool)).new(),
        givers: Vec(String).new(),
        barrier: 0,
        allowed: false,
        aliases: Vec((String, i64, u32)).new(),
        structs: Vec((u32, Vec(String), Vec(bool))).new(),
        module: a.root,
        definitions: Vec((u32, bool)).new(),
        families: Vec((u32, bool)).new(),
        imports: Vec((String, u32)).new(),
        unit: false
    }
    // Imported modules first: the loader's order is one where a module comes
    // before the modules that import it, the root last. Each module has its
    // own namespace; only the root has an entry point.
    for i in module_order(a) {
        let m = a.modules[i].ast
        for attr in m.attrs {
            if attr != "dependent_core" { return Err(error(
                diag.Span.new(m.file, 0, 0),
                "dependent_core supports only the native profile"
            )) }
        }
        if m.attrs.len() == 0 { return Err(error(
            diag.Span.new(m.file, 0, 0),
            "a dependent_core module imports only dependent_core modules"
        )) }
        e.module = i as u32
        e.imports = Vec((String, u32)).new()
        for imp in a.modules[i].imports {
            if reserved(imp.alias.as_str()) || e.imported(imp.alias.as_str()) {
                return Err(error(imp.span, "duplicate or reserved import alias"))
            }
            e.imports.push((imp.alias.clone(), imp.module))
        }
        for item in m.items { e.definition(item, i == a.root as i64 && !library)? }
    }
    var p = core_lower.compile(mem.replace(&e.c, core.Core.new()), tgt)?
    p.codegen = codegen
    if !library {
        for i in 0..p.fns.len() {
            if p.fns[i].name == "main" {
                p.fns[i].symbol = "__jihoo_dependent_main".to_string()
                p.fns[i].linkage = mir.Linkage.Internal
                p.entry = Some(i as u32)
            }
        }
        if p.entry.is_none() { return Err(error(
            diag.Span.new(module.file, 0, 0),
            "missing fn main() -> i64; use --lib for exports"
        )) }
    }
    Ok(p)
}
