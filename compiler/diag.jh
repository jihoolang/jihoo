// Source positions and error messages.

pub struct Span {
    pub file: u32
    pub lo: u32
    pub hi: u32
}

impl Span {
    pub fn new(file: u32, lo: i64, hi: i64) -> Span {
        Span { file: file, lo: lo as u32, hi: hi as u32 }
    }

    pub fn to(self, other: Span) -> Span {
        if self.file != other.file {
            return self
        }
        Span { file: self.file, lo: min(self.lo, other.lo), hi: max(self.hi, other.hi) }
    }
}

// A further line of an error: where the instance came from, a hint.
pub struct Note {
    pub span: Option(Span)
    pub msg: String
}

pub struct Diag {
    pub span: Span
    pub msg: String
    pub notes: Vec(Note)
    // Further errors of the same run, reported after this one.
    pub more: Vec(Diag)
}

// At most this many errors are shown.
pub const MAX_ERRORS: i64 = 20

impl Diag {
    pub fn new(span: Span, msg: str) -> Diag {
        Diag { span: span, msg: msg.to_string(), notes: Vec(Note).new(), more: Vec(Diag).new() }
    }

    // The first of several errors, carrying the others, in source order.
    pub fn several(sink errors: Vec(Diag)) -> Diag {
        var errors = errors
        sort_by(&errors, fn(a, b) { a.span.file < b.span.file || (a.span.file == b.span.file && a.span.lo < b.span.lo) })
        var first: Option(Diag) = None
        var rest = Vec(Diag).new()
        for d in errors.into_iter() {
            match first {
                Some(_) => rest.push(d)
                None => first = Some(d)
            }
        }
        var d = first.expect("no errors")
        d.more = rest
        d
    }

    pub fn note(sink self, span: Option(Span), msg: str) -> Diag {
        var d = self
        d.notes.push(Note { span: span, msg: msg.to_string() })
        d
    }
}

pub struct SourceFile {
    pub path: String
    pub text: String
}

pub struct Sources {
    pub files: Vec(SourceFile)
}

impl Sources {
    pub fn new() -> Sources {
        Sources { files: Vec(SourceFile).new() }
    }

    pub fn add(inout self, sink path: String, sink text: String) -> u32 {
        self.files.push(SourceFile { path: path, text: text })
        (self.files.len() - 1) as u32
    }

    // 1-based line and column of a span's start.
    pub fn line_col(self, span: Span) -> (i64, i64) {
        if span.file as i64 >= self.files.len() {
            return (0, 0)
        }
        let text = self.files[span.file as i64].text.as_str()
        let lo = min(span.lo as i64, text.len)
        var line = 1
        var col = 1
        for b in text[0..lo] {
            if b == '\n' {
                line += 1
                col = 1
            } else {
                col += 1
            }
        }
        (line, col)
    }

    pub fn where_(self, span: Span) -> String {
        let lc = self.line_col(span)
        var s = String.new()
        if span.file as i64 >= self.files.len() {
            s.push_str("?")
        } else {
            s.push_str(self.files[span.file as i64].path.as_str())
        }
        s.push_str(":")
        lc.0.show(&s)
        s.push_str(":")
        lc.1.show(&s)
        s
    }

    // An error, its notes, and the errors after it.
    pub fn render(self, d: Diag) -> String {
        var s = String.new()
        self.render_one(&s, d)
        let n = d.more.len() + 1
        var shown = 1
        for m in d.more {
            if shown == MAX_ERRORS {
                break
            }
            s.push_str("\n\n")
            self.render_one(&s, m)
            shown += 1
        }
        if n > 1 {
            s.push_str("\n\n")
            n.show(&s)
            s.push_str(" errors")
            if n > shown {
                s.push_str(" (the first ")
                shown.show(&s)
                s.push_str(" shown)")
            }
        }
        s
    }

    fn render_one(self, inout s: String, d: Diag) {
        s.push_str("error: ")
        s.push_str(self.where_(d.span).as_str())
        s.push_str(": ")
        s.push_str(d.msg.as_str())
        self.snippet(&s, d.span)
        for n in d.notes {
            match n.span {
                Some(sp) => {
                    s.push_str("\nnote: ")
                    s.push_str(self.where_(sp).as_str())
                    s.push_str(": ")
                    s.push_str(n.msg.as_str())
                    self.snippet(&s, sp)
                }
                None => {
                    s.push_str("\nnote: ")
                    s.push_str(n.msg.as_str())
                }
            }
        }
    }

    // The span's line, with `^` under the span.
    fn snippet(self, inout s: String, span: Span) {
        if span.file as i64 >= self.files.len() {
            return
        }
        let text = self.files[span.file as i64].text.as_str()
        let lo = min(span.lo as i64, text.len)
        var ls = lo
        while ls > 0 && text[ls - 1] != '\n' {
            ls -= 1
        }
        var le = lo
        while le < text.len && text[le] != '\n' {
            le += 1
        }
        let width = max(min(span.hi as i64, le), lo + 1) - lo
        s.push_str("\n    ")
        push_lossy(&s, text[ls..le])
        s.push_str("\n    ")
        repeat(&s, ' ', lo - ls)
        repeat(&s, '^', width)
    }
}

fn repeat(inout s: String, b: u8, n: i64) {
    for _ in 0..n {
        s.push(b)
    }
}

// The length of the UTF-8 character at `s[i]`, or, if the bytes there are
// not one, minus the length of the invalid part (at least one byte): the
// longest prefix of a character that is valid so far, as Rust's
// `from_utf8_lossy` counts them.
pub fn utf8_at(s: str, i: i64) -> i64 {
    let c = s[i]
    if c < 0x80 {
        return 1
    }
    if c < 0xc2 || c > 0xf4 {
        return -1
    }
    let n = if c < 0xe0 { 2 } else if c < 0xf0 { 3 } else { 4 }
    // The second byte's range rules out overlong forms, surrogates and code
    // points past U+10FFFF.
    var lo: u8 = 0x80
    var hi: u8 = 0xbf
    if c == 0xe0 {
        lo = 0xa0
    } else if c == 0xed {
        hi = 0x9f
    } else if c == 0xf0 {
        lo = 0x90
    } else if c == 0xf4 {
        hi = 0x8f
    }
    for j in 1..n {
        if i + j >= s.len || s[i + j] < lo || s[i + j] > hi {
            return 0 - j
        }
        lo = 0x80
        hi = 0xbf
    }
    n
}

// `s` with each invalid part replaced by U+FFFD.
pub fn push_lossy(inout out: String, s: str) {
    var i = 0
    while i < s.len {
        let n = utf8_at(s, i)
        if n > 0 {
            out.push_str(s[i..i + n])
            i += n
        } else {
            out.push_str("\xef\xbf\xbd")
            i -= n
        }
    }
}
