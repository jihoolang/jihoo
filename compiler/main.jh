// The jihoo compiler, written in jihoo. It was ported from the Rust
// compiler (`crates/jihoo`) one pass at a time; each pass has a command that
// prints what it makes, in the same format as the Rust compiler, so the two
// can be compared (docs/internals/self-hosting.md).

import std.env
import std.fs
import std.process
import std.sys
import astdump
import diag
import lex
import load
import parse
import target
import types
import mir
import sema
import interp
import body
import builtins
import check
import elab
import fmt
import format
import llvm
import backend
import os
import pat

// The release this compiler belongs to; flake.nix checks that it matches
// the package version.
const VERSION = "0.2.1"

const USAGE = "usage:\n  jihoo fmt <file.jh> [--check] [--width N]                format source or check its layout\n  jihoo check <file.jh> [--lib]                check without generating code\n  jihoo run <file.jh> [link inputs] [-- args]   compile and run a program\n  jihoo build <file.jh> [-o out] [link inputs]  compile a program\n  jihoo emit-mir <file.jh>                      print the compiler's MIR\n  jihoo emit-llvm <file.jh> [-o out]            print LLVM IR\n  jihoo emit-obj <file.jh> [-o out.o]           emit an object with LLVM\n  jihoo emit-tokens <file.jh>                   print the tokens of one file\n  jihoo emit-ast <file.jh>                      print the syntax tree of one file\n  jihoo emit-program <file.jh>                  print every module a program loads\n  jihoo --version                               print the compiler's version\n\noptions:\n  -O0 -O1 -O2 -O3   optimization (default -O2)\n  --release         integer overflow wraps instead of trapping\n  --target <t>      x86_64 or aarch64 (Linux)\n  -I <dir>          also look for modules in <dir>\n  -o <file>         output file\n  --lib             omit the entry point (check/emit-obj/emit-llvm)\n  --keep-ll         keep the LLVM IR next to the output\n  --error-format=text|json   source diagnostics (default text)\n  --comptime-report <path>   write interpreter resource measurements as JSON"

fn main() {
    // The parser and sema recurse once per level of nesting, and a frame
    // can be large: give them room for the deepest code the parser
    // accepts, as the Rust compiler does.
    os.with_stack(256 << 20, run)
}

fn run(_arg: *u8) -> *u8 {
    drive()
    null
}

fn drive() {
    let args = env.args()
    if args.len() < 2 {
        fail(USAGE, 2)
    }
    let cmd = args[1]
    if cmd == "--version" || cmd == "-V" {
        println("jihoo " + VERSION)
        return
    }
    if cmd == "--help" || cmd == "-h" {
        println(USAGE)
        return
    }
    var file: Option(str) = None
    var out: Option(str) = None
    var opt = "-O2"
    var search = Vec(String).new()
    var tgt = target.Target.host()
    var checked = true
    var library = false
    var link = Vec(str).new()
    var prog_args = Vec(str).new()
    var keep_ll = false
    var json_errors = false
    var comptime_report: Option(str) = None
    var format_check = false
    var format_width = format.DEFAULT_WIDTH
    // Without the standard library: for comparing sema between the two
    // compilers on small programs (not in the usage).
    var no_prelude = false
    var i = 2
    while i < args.len() {
        let a = args[i]
        if a == "--" {
            for j in i + 1..args.len() {
                prog_args.push(args[j])
            }
            break
        } else if a == "-o" {
            if cmd == "check" || cmd == "fmt" {
                fail("error: " + cmd + " does not accept output options", 2)
            }
            i += 1
            if i < args.len() {
                out = Some(args[i])
            }
        } else if a == "-I" {
            i += 1
            if i < args.len() {
                search.push(args[i].to_string())
            }
        } else if a == "--target" {
            i += 1
            var t: Option(target.Target) = None
            if i < args.len() {
                t = target.Target.parse(args[i])
            }
            match t {
                Some(t) => tgt = t
                None => fail("error: unknown target; use x86_64 or aarch64", 2)
            }
        } else if a == "--width" && cmd == "fmt" {
            i += 1
            if i >= args.len() { fail("error: --width requires an integer from 20 to 1000", 2) }
            match parse_width(args[i]) {
                Some(n) => format_width = n
                None => fail("error: --width requires an integer from 20 to 1000", 2)
            }
        } else if a == "--check" && cmd == "fmt" {
            format_check = true
        } else if a == "--comptime-report" {
            i += 1
            if i >= args.len() { fail("error: --comptime-report requires a path", 2) }
            comptime_report = Some(args[i])
        } else if a == "--error-format=json" {
            json_errors = true
        } else if a == "--error-format=text" {
            json_errors = false
        } else if a == "--release" {
            checked = false
        } else if a == "--keep-ll" {
            keep_ll = true
        } else if a == "--no-prelude" {
            no_prelude = true
        } else if a == "--lib" {
            library = true
        } else if a == "-O0" || a == "-O1" || a == "-O2" || a == "-O3" {
            opt = a
        } else if a == "-h" || a == "--help" {
            println(USAGE)
            return
        } else if a.ends_with(".jh") && file.is_none() {
            file = Some(a)
        } else if a.starts_with("-") && !a.starts_with("-l") && !a.starts_with("-L") {
            fail("error: unknown option `" + a + "`\n\n" + USAGE, 2)
        } else {
            link.push(a)
        }
        i += 1
    }
    let file = match file {
        Some(f) => f
        None => fail("error: no source file\n\n" + USAGE, 2)
    }
    if comptime_report.is_some() &&
        (cmd == "fmt" || cmd == "emit-tokens" || cmd == "emit-ast" || cmd == "emit-program") {
        fail("error: --comptime-report requires checking or code generation", 2)
    }
    if cmd == "check" && (keep_ll || link.len() > 0 || prog_args.len() > 0) {
        fail("error: check does not accept output options, link inputs or program arguments", 2)
    }
    if cmd == "fmt" {
        if keep_ll || link.len() > 0 || prog_args.len() > 0 {
            fail("error: fmt does not accept output options, link inputs or program arguments", 2)
        }
        format_file(file, format_check, json_errors, format_width)
        return
    }
    if cmd == "emit-tokens" || cmd == "emit-ast" {
        emit_syntax(file, cmd == "emit-ast", json_errors)
        return
    }
    var sources = diag.Sources.new()
    if cmd == "emit-program" {
        match load.load(file, load.default_search(search), tgt.name(), &sources, no_prelude) {
            Ok(p) => print(astdump.program(p))
            Err(d) => source_error(sources, d, json_errors)
        }
        return
    }
    // Source to MIR, checked and with drops elaborated (before elaboration
    // with `JIHOO_NO_ELAB` set).
    let a = match load.load(file, load.default_search(search), tgt.name(), &sources, no_prelude) {
        Ok(a) => a
        Err(d) => source_error(sources, d, json_errors)
    }
    if library && (cmd == "build" || cmd == "run") {
        fail("error: use `emit-obj --lib` to build a C-linkable library object", 2)
    }
    match comptime_report {
        Some(path) => match os.canonical(path) {
            Some(destination) => {
                for source in sources.files {
                    match os.canonical(source.path.as_str()) {
                        Some(input) => if input == destination { fail(
                            "error: compile-time report would overwrite a source file",
                            2
                        ) }
                        None => {}
                    }
                }
            }
            None => {}
        }
        None => {}
    }
    var evaluations = Vec(interp.Report).new()
    let compiled = sema.compile(a, tgt, checked, library, comptime_report.is_some(), &evaluations)
    match comptime_report {
        Some(path) => {
            let report = interp.report_json(evaluations, sources, tgt.name(), checked)
            match fs.write_file(path, report.as_str()) {
                Ok(_) => {}
                Err(e) => fail(("error: cannot write compile-time report: " +
                    e.as_str()).as_str(), 1)
            }
        }
        None => {}
    }
    var prog = match compiled {
        Ok(p) => p
        Err(d) => source_error(sources, d, json_errors)
    }
    // A check must always validate moves and borrows, even when the debug
    // switch for dumping unelaborated MIR is set in the environment.
    if cmd == "check" || env.get("JIHOO_NO_ELAB").is_none() {
        // Every function is checked; their errors are reported together.
        var errors = Vec(diag.Diag).new()
        var initialized = Vec(bool).new()
        for i in 0..prog.fns.len() {
            match elab.run(&prog.fns[i]) {
                Ok(_) => initialized.push(true)
                Err(d) => {
                    initialized.push(false)
                    errors.push(d)
                    continue
                }
            }
        }
        let effects = check.infer_effects(prog.types, prog.fns)
        for i, f in prog.fns {
            if initialized[i] {
                match check.run_with_effects(prog.types, f, effects) {
                    Ok(_) => {}
                    Err(d) => errors.push(d)
                }
            }
        }
        if errors.len() > 0 {
            source_error(sources, diag.Diag.several(errors), json_errors)
        }
    }
    if cmd == "check" {
        return
    } else if cmd == "emit-mir" {
        var text = String.new()
        for f in prog.fns {
            text.push_str(mir.show_function(prog, f).as_str())
        }
        print(text)
    } else if cmd == "emit-llvm" {
        let ll = llvm.emit(prog)
        match out {
            Some(o) => match fs.write_file(o, ll.as_str()) {
                Ok(_) => {}
                Err(e) => fail(("error: cannot write " + o + ": " + e.as_str()).as_str(), 1)
            }
            None => print(ll)
        }
    } else if cmd == "emit-obj" {
        let freestanding = prog.freestanding
        let ll = llvm.emit(prog)
        let output = match out {
            Some(o) => String.from(o)
            None => with_extension(file_stem(file), "o")
        }
        match backend.object(ll.as_str(), output.as_str(), opt, tgt, freestanding) {
            Ok(_) => {}
            Err(e) => fail(("error: " + e.as_str()).as_str(), 1)
        }
    } else if cmd == "build" || cmd == "run" {
        let freestanding = prog.freestanding
        let ll = llvm.emit(prog)
        var exe = String.new()
        match out {
            Some(o) => exe = String.from(o)
            None => {
                if cmd == "build" {
                    exe = String.from(file_stem(file))
                } else {
                    exe = os.join(os.temp_dir().as_str(), ("jihoo-run-" +
                        fmt.n(os.pid() as i128).as_str()).as_str())
                }
            }
        }
        match link_exe(ll.as_str(), exe.as_str(), opt, tgt, freestanding, link, keep_ll) {
            Ok(_) => {}
            Err(e) => fail(("error: " + e.as_str()).as_str(), 1)
        }
        if cmd == "run" {
            let status = process.run(exe.as_str(), prog_args.as_slice())
            if out.is_none() {
                os.remove(exe.as_str())
            }
            match status {
                Ok(s) => match s {
                    Code(c) => sys.exit(c)
                    Signal(sig) => sys.exit(128 + sig)
                }
                Err(e) => fail(("error: cannot run " + exe.as_str() + ": " +
                    e.as_str()).as_str(), 1)
            }
        }
    } else {
        fail("error: unknown command `" + cmd + "`\n\n" + USAGE, 2)
    }
}

// Where the file name starts in a path.
fn name_start(path: str) -> i64 {
    var start = 0
    for i in 0..path.len {
        if path[i] == '/' {
            start = i + 1
        }
    }
    start
}

// The file name without its directory and extension (Rust's `file_stem`).
fn file_stem(path: str) -> str {
    let name = path[name_start(path)..path.len]
    var end = name.len
    for i in 1..name.len {
        if name[i] == '.' {
            end = i
        }
    }
    name[0..end]
}

// The path with its extension replaced (Rust's `with_extension`).
fn with_extension(path: str, ext: str) -> String {
    path[0..name_start(path)] + file_stem(path) + "." + ext
}

// Writes the IR and has clang (`JIHOO_CC`) optimize and link it. If clang
// fails, its messages, without warnings, are the error.
fn link_exe(
    ll: str,
    exe: str,
    opt: str,
    tgt: target.Target,
    freestanding: bool,
    link: Vec(str),
    keep: bool
) -> Result((), String) {
    let selected = match env.get("JIHOO_BACKEND") {
        Some(s) => s
        None => "llvm"
    }
    if selected == "llvm" {
        return link_object(ll, exe, opt, tgt, freestanding, link, keep)
    }
    if selected != "clang" {
        return Err(String.from("unknown JIHOO_BACKEND; use llvm or clang"))
    }
    var ll_path = String.new()
    if keep {
        ll_path = with_extension(exe, "ll")
    } else {
        let name = "jihoo-" + fmt.n(os.pid() as i128).as_str() + "-" +
            exe[name_start(exe)..exe.len] + ".ll"
        ll_path = os.join(os.temp_dir().as_str(), name.as_str())
    }
    match fs.write_file(ll_path.as_str(), ll) {
        Ok(_) => {}
        Err(e) => return Err("cannot write " + ll_path.as_str() + ": " + e.as_str())
    }
    let cc = match env.get("JIHOO_CC") {
        Some(c) => c
        None => "clang"
    }
    var c = Vec(str).new()
    c.push(opt)
    c.push("-w")
    c.push("-target")
    c.push(tgt.triple())
    c.push("-x")
    c.push("ir")
    c.push(ll_path.as_str())
    c.push("-x")
    c.push("none")
    if freestanding {
        // sections per function, so that unused ones (the 128-bit helpers of
        // std.rt) are left out
        c.push("-nostdlib")
        c.push("-static")
        c.push("-fuse-ld=lld")
        c.push("-ffunction-sections")
        c.push("-Wl,--gc-sections")
    }
    for l in link {
        c.push(l)
    }
    if !freestanding {
        c.push("-lm")
    }
    c.push("-o")
    c.push(exe)
    let r = process.output(cc, c.as_slice())
    if !keep {
        os.remove(ll_path.as_str())
    }
    let o = match r {
        Ok(o) => o
        Err(e) => return Err("cannot run " + cc + ": " + e.as_str() + " (set JIHOO_CC to clang)")
    }
    if !o.status.success() {
        var msg = cc + " failed:\n"
        var first = true
        for l in o.stderr.as_str().lines() {
            if l.contains("warning:") {
                continue
            }
            if !first {
                msg.push('\n')
            }
            msg.push_str(l)
            first = false
        }
        return Err(msg)
    }
    Ok(())
}

fn link_object(
    ll: str,
    exe: str,
    opt: str,
    tgt: target.Target,
    freestanding: bool,
    link: Vec(str),
    keep: bool
) -> Result((), String) {
    if keep {
        let path = with_extension(exe, "ll")
        match fs.write_file(path.as_str(), ll) {
            Ok(_) => {}
            Err(e) => return Err("cannot write " + path.as_str() + ": " + e.as_str())
        }
    }
    let name = "jihoo-" + fmt.n(os.pid() as i128).as_str() + "-" +
        exe[name_start(exe)..exe.len] + ".o"
    let obj = os.join(os.temp_dir().as_str(), name.as_str())
    let r = object_and_link(ll, obj.as_str(), exe, opt, tgt, freestanding, link)
    os.remove(obj.as_str())
    r
}

fn object_and_link(
    ll: str,
    obj: str,
    exe: str,
    opt: str,
    tgt: target.Target,
    freestanding: bool,
    link: Vec(str)
) -> Result((), String) {
    backend.object(ll, obj, opt, tgt, freestanding)?
    let driver = if freestanding {
        match env.get("JIHOO_LD") {
            Some(s) => s
            None => "ld.lld"
        }
    } else {
        match env.get("JIHOO_CC") {
            Some(s) => s
            None => if tgt.name() == target.Target.host().name() { "cc" } else { "clang" }
        }
    }
    var c = Vec(str).new()
    if freestanding {
        c.push("-m")
        c.push(match tgt { X86_64 => "elf_x86_64", Aarch64 => "aarch64linux" })
        c.push("-static")
        c.push("--gc-sections")
        c.push("-e")
        c.push("_start")
    } else {
        c.push(opt)
        c.push("-w")
        if driver.contains("clang") {
            c.push("-target")
            c.push(tgt.triple())
        }
    }
    c.push(obj)
    for l in link { c.push(l) }
    if !freestanding {
        c.push("-lm")
        c.push("-ldl")
    }
    c.push("-o")
    c.push(exe)
    let o = match process.output(driver, c.as_slice()) {
        Ok(o) => o
        Err(e) => {
            let set = if freestanding {
                "JIHOO_LD to ld.lld"
            } else {
                "JIHOO_CC to a C linker driver"
            }
            return Err("cannot run " + driver + ": " + e.as_str() + " (set " + set + ")")
        }
    }
    if !o.status.success() {
        var msg = driver + " failed:\n"
        var first = true
        for l in o.stderr.as_str().lines() {
            if l.contains("warning:") { continue }
            if !first { msg.push('\n') }
            msg.push_str(l)
            first = false
        }
        return Err(msg)
    }
    Ok(())
}

fn fail(msg: str, code: i32) -> never {
    eprintln(msg)
    sys.exit(code)
}

fn parse_width(text: str) -> Option(i64) {
    var n = 0
    for b in text {
        if !is_digit(b) { return None }
        n = n * 10 + (b - '0') as i64
        if n > 1000 { return None }
    }
    if n < 20 { None } else { Some(n) }
}

fn format_file(file: str, check_only: bool, json_errors: bool, width: i64) {
    var sources = diag.Sources.new()
    let text = match fs.read_file(file) {
        Ok(t) => t
        Err(_) => {
            if json_errors {
                source_error(sources, diag.Diag.new(diag.Span.new(0, 0, 0), "cannot read " +
                    file), true)
            }
            fail("error: cannot read " + file, 1)
        }
    }
    let id = sources.add(file.to_string(), text)
    let original = sources.files[id as i64].text.as_str()
    let formatted = match format.source(id, original, width) {
        Ok(s) => s
        Err(d) => source_error(sources, d, json_errors)
    }
    if check_only {
        if formatted != original { fail(file + ": needs formatting", 1) }
    } else {
        print(formatted)
    }
}

// Both formats consume the same diagnostic, including its related notes.
fn source_error(sources: diag.Sources, d: diag.Diag, json_errors: bool) -> never {
    if json_errors { fail(sources.render_json(d).as_str(), 1) }
    fail(sources.render(d).as_str(), 1)
}

// The tokens of one file, one per line: its byte range, whether a newline
// came before it, and the token; or its syntax tree.
fn emit_syntax(file: str, ast: bool, json_errors: bool) {
    var sources = diag.Sources.new()
    let text = match fs.read_file(file) {
        Ok(t) => t
        Err(_) => {
            if json_errors {
                source_error(sources, diag.Diag.new(diag.Span.new(0, 0, 0), "cannot read " +
                    file), true)
            }
            fail("error: cannot read " + file, 1)
        }
    }
    let id = sources.add(file.to_string(), text)
    let toks = match lex.lex(id, sources.files[id as i64].text.as_str()) {
        Ok(t) => t
        Err(d) => source_error(sources, d, json_errors)
    }
    if ast {
        match parse.parse_module(id, toks) {
            Ok(m) => print(astdump.module(m))
            Err(d) => source_error(sources, d, json_errors)
        }
        return
    }
    var out = String.new()
    for t in toks {
        t.span.lo.show(&out)
        out.push(' ')
        t.span.hi.show(&out)
        out.push_str(if t.nl_before { " 1 " } else { " 0 " })
        match t.tok {
            Ident => {
                out.push_str("ident ")
                out.push_str(t.text.as_str())
            }
            Int => {
                out.push_str("int ")
                t.int.show(&out)
            }
            Float => {
                out.push_str("float ")
                var f = t.float
                unsafe { *(&f as *u64) }.show(&out)
            }
            Str => {
                out.push_str("str ")
                for b in t.text.as_str() {
                    out.push(hex(b >> 4))
                    out.push(hex(b & 15))
                }
            }
            Char => {
                out.push_str("char ")
                t.int.show(&out)
            }
            OpAssign => {
                out.push_str(t.op.text())
                out.push('=')
            }
            Eof => out.push_str("eof")
            k => out.push_str(lex.tok_text(k))
        }
        out.push('\n')
    }
    print(out)
}

fn hex(d: u8) -> u8 {
    if d < 10 { '0' + d } else { 'a' + d - 10 }
}
