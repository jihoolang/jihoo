// The jihoo compiler, written in jihoo. It was ported from the Rust
// compiler (`crates/jihoo`) one pass at a time; each pass has a command that
// prints what it makes, in the same format as the Rust compiler, so the two
// can be compared (docs/internals/self-hosting.md).

import std.env
import std.fs
import std.process
import std.sys
import astdump
import diag
import lex
import load
import parse
import target
import types
import mir
import sema
import interp
import body
import builtins
import check
import elab
import fmt
import format
import llvm
import lsp
import backend
import os
import pat
import timing

// The release this compiler belongs to; flake.nix checks that it matches
// the package version.
const VERSION = "0.4.1"

const USAGE = "usage:\n  jihoo fmt <paths> [--check|--write] [--width N]  format source or check its layout\n  jihoo check <file.jh> [--lib]                check without generating code\n  jihoo lsp [-I dir] [--target t]               serve the Language Server Protocol on stdio\n  jihoo run <file.jh> [link inputs] [-- args]   compile and run a program\n  jihoo build <file.jh> [-o out] [link inputs]  compile a program\n  jihoo emit-mir <file.jh>                      print the compiler's MIR\n  jihoo emit-llvm <file.jh> [-o out]            print LLVM IR\n  jihoo emit-obj <file.jh> [-o out.o]           emit an object with LLVM\n  jihoo emit-tokens <file.jh>                   print the tokens of one file\n  jihoo emit-ast <file.jh>                      print the syntax tree of one file\n  jihoo emit-program <file.jh>                  print every module a program loads\n  jihoo --version                               print the compiler's version\n\noptions:\n  -O0 -O1 -O2 -O3   optimization (default -O2)\n  --release         integer overflow wraps instead of trapping\n  --target <t>      x86_64 or aarch64 (Linux, or UEFI with #![uefi])\n  -I <dir>          also look for modules in <dir>\n  -o <file>         output file\n  --lib             omit the entry point (check/emit-obj/emit-llvm)\n  --keep-ll         keep the LLVM IR next to the output\n  --error-format=text|json   diagnostics for every failure (default text)\n  --comptime-report <path>   write interpreter resource measurements as JSON\n  --time-passes     report the time and memory of each phase on standard error"

fn main() {
    // The parser and sema recurse once per level of nesting, and a frame
    // can be large: give them room for the deepest code the parser
    // accepts, as the Rust compiler does.
    os.with_stack(256 << 20, run)
}

fn run(_arg: *u8) -> *u8 {
    drive()
    null
}

fn drive() {
    let args = env.args()
    if args.len() < 2 {
        if json_requested() { usage("no command") }
        fail(USAGE, 2)
    }
    let cmd = args[1]
    if cmd == "--version" || cmd == "-V" {
        println("jihoo " + VERSION)
        return
    }
    if cmd == "--help" || cmd == "-h" {
        println(USAGE)
        return
    }
    var file: Option(str) = None
    var out: Option(str) = None
    var opt = "-O2"
    var search = Vec(String).new()
    var tgt = target.Target.host()
    var checked = true
    var library = false
    var link = Vec(str).new()
    var prog_args = Vec(str).new()
    var keep_ll = false
    var json_errors = false
    var comptime_report: Option(str) = None
    var time_passes = false
    var format_check = false
    var format_write = false
    // `fmt` takes several files and directories.
    var paths = Vec(str).new()
    var format_width = format.DEFAULT_WIDTH
    // Without the standard library: for comparing sema between the two
    // compilers on small programs (not in the usage).
    var no_prelude = false
    var i = 2
    while i < args.len() {
        let a = args[i]
        if a == "--" {
            for j in i + 1..args.len() {
                prog_args.push(args[j])
            }
            break
        } else if a == "-o" {
            if cmd == "check" || cmd == "fmt" {
                usage(cmd + " does not accept output options")
            }
            i += 1
            if i < args.len() {
                out = Some(args[i])
            }
        } else if a == "-I" {
            i += 1
            if i < args.len() {
                search.push(args[i].to_string())
            }
        } else if a == "--target" {
            i += 1
            var t: Option(target.Target) = None
            if i < args.len() {
                t = target.Target.parse(args[i])
            }
            match t {
                Some(t) => tgt = t
                None => usage("unknown target; use x86_64 or aarch64")
            }
        } else if a == "--width" && cmd == "fmt" {
            i += 1
            if i >= args.len() { usage("--width requires an integer from 20 to 1000") }
            match parse_width(args[i]) {
                Some(n) => format_width = n
                None => usage("--width requires an integer from 20 to 1000")
            }
        } else if a == "--check" && cmd == "fmt" {
            format_check = true
        } else if a == "--write" && cmd == "fmt" {
            format_write = true
        } else if a == "--comptime-report" {
            i += 1
            if i >= args.len() { usage("--comptime-report requires a path") }
            comptime_report = Some(args[i])
        } else if a == "--time-passes" {
            time_passes = true
        } else if a == "--error-format=json" {
            json_errors = true
        } else if a == "--error-format=text" {
            json_errors = false
        } else if a == "--release" {
            checked = false
        } else if a == "--keep-ll" {
            keep_ll = true
        } else if a == "--no-prelude" {
            no_prelude = true
        } else if a == "--lib" {
            library = true
        } else if a == "-O0" || a == "-O1" || a == "-O2" || a == "-O3" {
            opt = a
        } else if a == "-h" || a == "--help" {
            println(USAGE)
            return
        } else if cmd == "fmt" && !a.starts_with("-") {
            paths.push(a)
        } else if a.ends_with(".jh") && file.is_none() {
            file = Some(a)
        } else if a.starts_with("-") && !a.starts_with("-l") && !a.starts_with("-L") {
            usage_help("unknown option `" + a + "`")
        } else {
            link.push(a)
        }
        i += 1
    }
    if cmd == "lsp" {
        if file.is_some() || paths.len() > 0 || link.len() > 0 || out.is_some() {
            usage("lsp takes no files; it reads the protocol on standard input")
        }
        sys.exit(lsp.serve(search, tgt, VERSION))
    }
    if comptime_report.is_some() &&
        (cmd == "fmt" || cmd == "emit-tokens" || cmd == "emit-ast" || cmd == "emit-program") {
        usage("--comptime-report requires checking or code generation")
    }
    if time_passes &&
        (cmd == "fmt" || cmd == "emit-tokens" || cmd == "emit-ast" || cmd == "emit-program") {
        usage("--time-passes requires checking or code generation")
    }
    if cmd == "fmt" {
        if keep_ll || link.len() > 0 || prog_args.len() > 0 {
            usage("fmt does not accept output options, link inputs or program arguments")
        }
        if paths.len() == 0 { usage_help("no source file") }
        if format_check && format_write { usage("fmt accepts --check or --write, not both") }
        format_paths(paths, format_check, format_write, json_errors, format_width)
        return
    }
    let file = match file {
        Some(f) => f
        None => usage_help("no source file")
    }
    if cmd == "check" && (keep_ll || link.len() > 0 || prog_args.len() > 0) {
        usage("check does not accept output options, link inputs or program arguments")
    }
    if cmd == "emit-tokens" || cmd == "emit-ast" {
        emit_syntax(file, cmd == "emit-ast", json_errors)
        return
    }
    var sources = diag.Sources.new()
    if cmd == "emit-program" {
        match load.load(file, load.default_search(search), tgt.name(), &sources, no_prelude) {
            Ok(p) => print(astdump.program(p))
            Err(d) => source_error(sources, d, json_errors)
        }
        return
    }
    // Source to MIR, checked and with drops elaborated (before elaboration
    // with `JIHOO_NO_ELAB` set).
    var timer = timing.Timer.start()
    let a = match load.load(file, load.default_search(search), tgt.name(), &sources, no_prelude) {
        Ok(a) => a
        Err(d) => {
            timer.lap("load")
            report_times(timer, time_passes)
            source_error(sources, d, json_errors)
        }
    }
    timer.lap("load")
    if library && (cmd == "build" || cmd == "run") {
        usage("use `emit-obj --lib` to build a C-linkable library object")
    }
    match comptime_report {
        Some(path) => match os.canonical(path) {
            Some(destination) => {
                for source in sources.files {
                    match os.canonical(source.path.as_str()) {
                        Some(input) => if input == destination {
                            usage("compile-time report would overwrite a source file")
                        }
                        None => {}
                    }
                }
            }
            None => {}
        }
        None => {}
    }
    var evaluations = Vec(interp.Report).new()
    let compiled = sema.compile(a, tgt, checked, library, comptime_report.is_some(), &evaluations)
    timer.lap("sema")
    match comptime_report {
        Some(path) => {
            let report = interp.report_json(evaluations, sources, tgt.name(), checked)
            match fs.write_file(path, report.as_str()) {
                Ok(_) => {}
                Err(e) => failure(
                    diag.Kind.Io,
                    ("cannot write compile-time report: " + e.to_string().as_str()).as_str()
                )
            }
            timer.lap("comptime report")
        }
        None => {}
    }
    var prog = match compiled {
        Ok(p) => p
        Err(d) => {
            report_times(timer, time_passes)
            source_error(sources, d, json_errors)
        }
    }
    // A check must always validate moves and borrows, even when the debug
    // switch for dumping unelaborated MIR is set in the environment.
    if cmd == "check" || env.get("JIHOO_NO_ELAB").is_none() {
        match check.program(&prog, &timer) {
            Ok(_) => {}
            Err(d) => {
                report_times(timer, time_passes)
                source_error(sources, d, json_errors)
            }
        }
    }
    if cmd == "check" {
        report_times(timer, time_passes)
        return
    } else if cmd == "emit-mir" {
        var text = String.new()
        for f in prog.fns {
            text.push_str(mir.show_function(prog, f).as_str())
        }
        timer.lap("MIR text")
        report_times(timer, time_passes)
        print(text)
    } else if cmd == "emit-llvm" {
        let ll = llvm.emit(prog)
        timer.lap("IR generation")
        report_times(timer, time_passes)
        match out {
            Some(o) => match fs.write_file(o, ll.as_str()) {
                Ok(_) => {}
                Err(e) => failure(
                    diag.Kind.Io,
                    ("cannot write " + o + ": " + e.to_string().as_str()).as_str()
                )
            }
            None => print(ll)
        }
    } else if cmd == "emit-obj" {
        let profile = prog.profile
        let ll = llvm.emit(prog)
        timer.lap("IR generation")
        let output = match out {
            Some(o) => String.from(o)
            None => with_extension(file_stem(file), "o")
        }
        match backend.object(ll.as_str(), output.as_str(), opt, tgt, profile, &timer) {
            Ok(_) => {}
            Err(e) => {
                report_times(timer, time_passes)
                failure(diag.Kind.Backend, e.as_str())
            }
        }
        report_times(timer, time_passes)
    } else if cmd == "build" || cmd == "run" {
        let profile = prog.profile
        let uefi = match profile { Uefi => true, _ => false }
        if uefi && cmd == "run" {
            failure(
                diag.Kind.Usage,
                "a UEFI program runs in firmware, not here; build it and boot the .efi file"
            )
        }
        let ll = llvm.emit(prog)
        // Nothing refers to the syntax trees any more; LLVM can use their
        // memory.
        drop(a)
        timer.lap("IR generation")
        var exe = String.new()
        match out {
            Some(o) => exe = String.from(o)
            None => {
                if cmd == "build" {
                    exe = String.from(file_stem(file))
                    if uefi { exe.push_str(".efi") }
                } else {
                    exe = os.join(os.temp_dir().as_str(), ("jihoo-run-" +
                        fmt.n(os.pid() as i128).as_str()).as_str())
                }
            }
        }
        let linked = link_exe(
            ll.as_str(),
            exe.as_str(),
            opt,
            tgt,
            profile,
            link,
            keep_ll,
            &timer
        )
        // The phases end before the program runs.
        report_times(timer, time_passes)
        match linked {
            Ok(_) => {}
            Err(e) => failure(diag.Kind.Backend, e.as_str())
        }
        if cmd == "run" {
            let status = process.run(exe.as_str(), prog_args.as_slice())
            if out.is_none() {
                os.remove(exe.as_str())
            }
            match status {
                Ok(s) => match s {
                    Code(c) => sys.exit(c)
                    Signal(sig) => sys.exit(128 + sig)
                }
                Err(e) => failure(
                    diag.Kind.Io,
                    ("cannot run " + exe.as_str() + ": " + e.to_string().as_str()).as_str()
                )
            }
        }
    } else {
        usage_help("unknown command `" + cmd + "`")
    }
}

// Where the file name starts in a path.
fn name_start(path: str) -> i64 {
    var start = 0
    for i in 0..path.len {
        if path[i] == '/' {
            start = i + 1
        }
    }
    start
}

// The file name without its directory and extension (Rust's `file_stem`).
fn file_stem(path: str) -> str {
    let name = path[name_start(path)..path.len]
    var end = name.len
    for i in 1..name.len {
        if name[i] == '.' {
            end = i
        }
    }
    name[0..end]
}

// The path with its extension replaced (Rust's `with_extension`).
fn with_extension(path: str, ext: str) -> String {
    path[0..name_start(path)] + file_stem(path) + "." + ext
}

// Writes the IR and has clang (`JIHOO_CC`) optimize and link it. If clang
// fails, its messages, without warnings, are the error.
fn link_exe(
    ll: str,
    exe: str,
    opt: str,
    tgt: target.Target,
    profile: target.Profile,
    link: Vec(str),
    keep: bool,
    inout timer: timing.Timer
) -> Result((), String) {
    let selected = match env.get("JIHOO_BACKEND") {
        Some(s) => s
        None => "llvm"
    }
    if selected == "llvm" {
        return link_object(ll, exe, opt, tgt, profile, link, keep, &timer)
    }
    if selected != "clang" {
        return Err(String.from("unknown JIHOO_BACKEND; use llvm or clang"))
    }
    let freestanding = match profile {
        Native => false
        Freestanding => true
        Uefi => return Err(String.from("JIHOO_BACKEND=clang does not build UEFI programs"))
    }
    var ll_path = String.new()
    if keep {
        ll_path = with_extension(exe, "ll")
    } else {
        let name = "jihoo-" + fmt.n(os.pid() as i128).as_str() + "-" +
            exe[name_start(exe)..exe.len] + ".ll"
        ll_path = os.join(os.temp_dir().as_str(), name.as_str())
    }
    match fs.write_file(ll_path.as_str(), ll) {
        Ok(_) => {}
        Err(e) => return Err("cannot write " + ll_path.as_str() + ": " + e.to_string().as_str())
    }
    let cc = match env.get("JIHOO_CC") {
        Some(c) => c
        None => "clang"
    }
    var c = Vec(str).new()
    c.push(opt)
    c.push("-w")
    c.push("-target")
    c.push(tgt.triple())
    c.push("-x")
    c.push("ir")
    c.push(ll_path.as_str())
    c.push("-x")
    c.push("none")
    if freestanding {
        // sections per function, so that unused ones (the 128-bit helpers of
        // std.rt) are left out
        c.push("-nostdlib")
        c.push("-static")
        c.push("-fuse-ld=lld")
        c.push("-ffunction-sections")
        c.push("-Wl,--gc-sections")
    }
    for l in link {
        c.push(l)
    }
    if !freestanding {
        c.push("-lm")
    }
    c.push("-o")
    c.push(exe)
    let r = process.output(cc, c.as_slice())
    if !keep {
        os.remove(ll_path.as_str())
    }
    timer.lap("clang")
    let o = match r {
        Ok(o) => o
        Err(e) => return Err(
            "cannot run " + cc + ": " + e.to_string().as_str() + " (set JIHOO_CC to clang)"
        )
    }
    if !o.status.success() {
        var msg = cc + " failed:\n"
        var first = true
        for l in o.stderr.as_str().lines() {
            if l.contains("warning:") {
                continue
            }
            if !first {
                msg.push('\n')
            }
            msg.push_str(l)
            first = false
        }
        return Err(msg)
    }
    Ok(())
}

fn link_object(
    ll: str,
    exe: str,
    opt: str,
    tgt: target.Target,
    profile: target.Profile,
    link: Vec(str),
    keep: bool,
    inout timer: timing.Timer
) -> Result((), String) {
    if keep {
        let path = with_extension(exe, "ll")
        match fs.write_file(path.as_str(), ll) {
            Ok(_) => {}
            Err(e) => return Err("cannot write " + path.as_str() + ": " + e.to_string().as_str())
        }
    }
    let name = "jihoo-" + fmt.n(os.pid() as i128).as_str() + "-" +
        exe[name_start(exe)..exe.len] + "."
    let stem = os.join(os.temp_dir().as_str(), name.as_str())
    let objs = backend.objects(ll, stem.as_str(), opt, tgt, profile, &timer)?
    let r = link_objects(objs, exe, opt, tgt, profile, link)
    for o in objs {
        os.remove(o.as_str())
    }
    timer.lap("link")
    r
}

fn link_objects(
    objs: Vec(String),
    exe: str,
    opt: str,
    tgt: target.Target,
    profile: target.Profile,
    link: Vec(str)
) -> Result((), String) {
    let freestanding = profile.bare()
    let uefi = match profile { Uefi => true, _ => false }
    let driver = if freestanding {
        match env.get("JIHOO_LD") {
            Some(s) => s
            None => "ld.lld"
        }
    } else {
        match env.get("JIHOO_CC") {
            Some(s) => s
            None => if tgt.name() == target.Target.host().name() { "cc" } else { "clang" }
        }
    }
    let out = "/out:" + exe
    var c = Vec(str).new()
    if uefi {
        // lld's COFF linker, which `ld.lld` also is with `-flavor link`
        c.push("-flavor")
        c.push("link")
        c.push("/subsystem:efi_application")
        c.push("/entry:efi_main")
        c.push("/nodefaultlib")
        c.push("/opt:ref")
        c.push(match tgt { X86_64 => "/machine:x64", Aarch64 => "/machine:arm64" })
    } else if freestanding {
        c.push("-m")
        c.push(match tgt { X86_64 => "elf_x86_64", Aarch64 => "aarch64linux" })
        c.push("-static")
        c.push("--gc-sections")
        c.push("-e")
        c.push("_start")
    } else {
        c.push(opt)
        c.push("-w")
        if driver.contains("clang") {
            c.push("-target")
            c.push(tgt.triple())
        }
    }
    for o in objs { c.push(o.as_str()) }
    for l in link { c.push(l) }
    if !freestanding {
        c.push("-lm")
        c.push("-ldl")
    }
    if uefi {
        c.push(out.as_str())
    } else {
        c.push("-o")
        c.push(exe)
    }
    let o = match process.output(driver, c.as_slice()) {
        Ok(o) => o
        Err(e) => {
            let set = if freestanding {
                "JIHOO_LD to ld.lld"
            } else {
                "JIHOO_CC to a C linker driver"
            }
            return Err(
                "cannot run " + driver + ": " + e.to_string().as_str() + " (set " + set + ")"
            )
        }
    }
    if !o.status.success() {
        var msg = driver + " failed:\n"
        var first = true
        for l in o.stderr.as_str().lines() {
            if l.contains("warning:") { continue }
            if !first { msg.push('\n') }
            msg.push_str(l)
            first = false
        }
        return Err(msg)
    }
    Ok(())
}

// The phase timings on standard error, if `--time-passes` asked for them.
fn report_times(timer: timing.Timer, requested: bool) {
    if requested { eprintln(timer.report()) }
}

fn fail(msg: str, code: i32) -> never {
    eprintln(msg)
    sys.exit(code)
}

// Whether the last `--error-format` option before `--` selects JSON. It is
// looked up again when a failure is reported, so that options given after
// the one that failed still apply.
fn json_requested() -> bool {
    let args = env.args()
    var json = false
    for i in 1..args.len() {
        let a = args[i]
        if a == "--" { break }
        if a == "--error-format=json" {
            json = true
        } else if a == "--error-format=text" {
            json = false
        }
    }
    json
}

// A failure outside the program's source, exiting with status 1.
fn failure(kind: diag.Kind, msg: str) -> never {
    let d = diag.Diag.failure(kind, None, msg)
    if json_requested() { fail(diag.Sources.new().render_json(d).as_str(), 1) }
    fail("error: " + msg, 1)
}

// An invalid command line, exiting with status 2.
fn usage(msg: str) -> never {
    let d = diag.Diag.failure(diag.Kind.Usage, None, msg)
    if json_requested() { fail(diag.Sources.new().render_json(d).as_str(), 2) }
    fail("error: " + msg, 2)
}

// An invalid command line, followed by the usage in text.
fn usage_help(msg: str) -> never {
    if json_requested() { usage(msg) }
    fail("error: " + msg + "\n\n" + USAGE, 2)
}

fn parse_width(text: str) -> Option(i64) {
    var n = 0
    for b in text {
        if !is_digit(b) { return None }
        n = n * 10 + (b - '0') as i64
        if n > 1000 { return None }
    }
    if n < 20 { None } else { Some(n) }
}

// Formats files, and the `.jh` files in directories and the directories in
// them, except those whose names start with `.`. One file is printed;
// several are checked or rewritten, and every failure among them is
// reported, in order, once all were formatted.
fn format_paths(paths: Vec(str), check_only: bool, write: bool, json_errors: bool, width: i64) {
    var files = Vec(String).new()
    var visited = Vec(String).new()
    var single = paths.len() == 1
    for p in paths {
        match fs.read_dir(p) {
            Ok(_) => {
                single = false
                source_files(p, &files, &visited)
            }
            Err(_) => files.push(p.to_string())
        }
    }
    if !single && !check_only && !write {
        usage("fmt prints one file; use --check or --write for several files or a directory")
    }
    var sources = diag.Sources.new()
    var failed = Vec(diag.Diag).new()
    for file in files {
        let text = match fs.read_file(file.as_str()) {
            Ok(t) => t
            Err(_) => {
                failed.push(diag.Diag.failure(diag.Kind.Io, None, "cannot read " + file.as_str()))
                continue
            }
        }
        let id = sources.add(file.clone(), text)
        let original = sources.files[id as i64].text.as_str()
        let formatted = match format.source(id, original, width) {
            Ok(s) => s
            Err(d) => {
                failed.push(d)
                continue
            }
        }
        if !check_only && !write {
            print(formatted)
        } else if formatted != original {
            if check_only {
                // Located at the first byte that differs.
                let f = formatted.as_str()
                var at = 0
                while at < original.len && at < f.len && original[at] == f[at] {
                    at += 1
                }
                let span = Some(diag.Span.new(id, at, at))
                failed.push(diag.Diag.failure(diag.Kind.Format, span, "needs formatting"))
            } else {
                match fs.write_file(file.as_str(), formatted.as_str()) {
                    Ok(_) => {}
                    Err(_) => failed.push(diag.Diag.failure(
                        diag.Kind.Io,
                        None,
                        "cannot write " + file.as_str()
                    ))
                }
            }
        }
    }
    if failed.len() == 0 { return }
    if json_errors {
        var first: Option(diag.Diag) = None
        var rest = Vec(diag.Diag).new()
        for d in failed.into_iter() {
            match first {
                Some(_) => rest.push(d)
                None => first = Some(d)
            }
        }
        var d = first.expect("no failures")
        d.more = rest
        fail(sources.render_json(d).as_str(), 1)
    }
    var text = String.new()
    for i, d in failed {
        if i > 0 { text.push('\n') }
        match d.kind {
            Format => {
                text.push_str(sources.files[d.span.file as i64].path.as_str())
                text.push_str(": needs formatting")
            }
            _ => text.push_str(sources.render(d).as_str())
        }
    }
    fail(text.as_str(), 1)
}

// The `.jh` files under a directory, sorted, without hidden entries and
// without visiting a directory twice through links.
fn source_files(dir: str, inout files: Vec(String), inout visited: Vec(String)) {
    match os.canonical(dir) {
        Some(c) => {
            for v in visited {
                if v == c { return }
            }
            visited.push(c)
        }
        None => {}
    }
    let names = match fs.read_dir(dir) {
        Ok(n) => n
        Err(_) => return
    }
    for n in names {
        if n.as_str().starts_with(".") { continue }
        let path = if dir.ends_with("/") { dir + n.as_str() } else { dir + "/" + n.as_str() }
        match fs.read_dir(path.as_str()) {
            Ok(_) => source_files(path.as_str(), &files, &visited)
            Err(_) => if n.as_str().ends_with(".jh") { files.push(path) }
        }
    }
}

// Both formats consume the same diagnostic, including its related notes.
fn source_error(sources: diag.Sources, d: diag.Diag, json_errors: bool) -> never {
    // Before any source was read, the error is that the root file could not be.
    if sources.files.len() == 0 { failure(diag.Kind.Io, d.msg.as_str()) }
    if json_errors { fail(sources.render_json(d).as_str(), 1) }
    fail(sources.render(d).as_str(), 1)
}

// The tokens of one file, one per line: its byte range, whether a newline
// came before it, and the token; or its syntax tree.
fn emit_syntax(file: str, ast: bool, json_errors: bool) {
    var sources = diag.Sources.new()
    let text = match fs.read_file(file) {
        Ok(t) => t
        Err(_) => failure(diag.Kind.Io, "cannot read " + file)
    }
    let id = sources.add(file.to_string(), text)
    let toks = match lex.lex(id, sources.files[id as i64].text.as_str()) {
        Ok(t) => t
        Err(d) => source_error(sources, d, json_errors)
    }
    if ast {
        match parse.parse_module(id, toks) {
            Ok(m) => print(astdump.module(m))
            Err(d) => source_error(sources, d, json_errors)
        }
        return
    }
    var out = String.new()
    for t in toks {
        t.span.lo.show(&out)
        out.push(' ')
        t.span.hi.show(&out)
        out.push_str(if t.nl_before { " 1 " } else { " 0 " })
        match t.tok {
            Ident => {
                out.push_str("ident ")
                out.push_str(t.text.as_str())
            }
            Int => {
                out.push_str("int ")
                t.int.show(&out)
            }
            Float => {
                out.push_str("float ")
                var f = t.float
                unsafe { *(&f as *u64) }.show(&out)
            }
            Str => {
                out.push_str("str ")
                for b in t.text.as_str() {
                    out.push(hex(b >> 4))
                    out.push(hex(b & 15))
                }
            }
            Char => {
                out.push_str("char ")
                t.int.show(&out)
            }
            OpAssign => {
                out.push_str(t.op.text())
                out.push('=')
            }
            Eof => out.push_str("eof")
            k => out.push_str(lex.tok_text(k))
        }
        out.push('\n')
    }
    print(out)
}

fn hex(d: u8) -> u8 {
    if d < 10 { '0' + d } else { 'a' + d - 10 }
}
