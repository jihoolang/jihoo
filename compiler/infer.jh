// Untrusted loop invariant inference for verification (Houdini): propose
// simple facts at every cut point that has no written invariant, then drop
// each one that is not proved on entry or after an iteration, until the
// rest are. Whatever it returns is checked again like written invariants,
// so its bugs lose proofs only.

import std.sort
import fm
import linear
import vc

pub fn successors(t: vc.Term) -> Vec(i64) {
    var out = Vec(i64).new()
    match t {
        Goto(b) => out.push(b)
        Switch(_, a, b) => {
            out.push(a)
            out.push(b)
        }
        Assert(_, _, b, _) => out.push(b)
        Any(bs) => {
            for b in bs { out.push(b) }
        }
        Call(_, b, _) => out.push(b)
        _ => {}
    }
    out
}

// The targets of back edges in a depth-first walk from the entry: every
// cycle has one, so with a cut point at each, no path runs a block twice.
pub fn loop_heads(f: vc.Function) -> Vec(i64) {
    let n = f.blocks.len()
    // 0: not reached, 1: on the walk's stack, 2: done.
    var color = Vec(i64).filled(n, 0)
    var head = Vec(bool).filled(n, false)
    var stack = Vec((i64, i64)).new()
    if n == 0 { return Vec(i64).new() }
    color[0] = 1
    stack.push((0, 0))
    loop {
        let Some(top) = stack.pop() else { break }
        let succ = successors(f.blocks[top.0].term)
        if top.1 < succ.len() {
            stack.push((top.0, top.1 + 1))
            let s = succ[top.1]
            if color[s] == 1 {
                head[s] = true
            } else if color[s] == 0 {
                color[s] = 1
                stack.push((s, 0))
            }
        } else { color[top.0] = 2 }
    }
    var out = Vec(i64).new()
    for b in 0..n {
        if head[b] { out.push(b) }
    }
    out
}

// The blocks that more than one edge reaches (or the entry, if any does).
pub fn joins(f: vc.Function) -> Vec(i64) {
    var preds = Vec(i64).filled(f.blocks.len(), 0)
    preds[0] = 1
    for b in f.blocks {
        for s in successors(b.term) { preds[s] += 1 }
    }
    var out = Vec(i64).new()
    for i, n in preds {
        if n >= 2 { out.push(i) }
    }
    out
}

// Paths that may reach one block from the cut points before it.
pub const MAX_PATHS_TO_BLOCK: i64 = 32

// More cut points, so that at most `MAX_PATHS_TO_BLOCK` paths from cut
// points reach each block: in an order where each block comes after the
// blocks that reach it without passing a cut point, a block that too many
// paths reach becomes a cut point, and one path leaves it. `cuts` (the
// loop heads) leaves no cycle.
pub fn bounded(f: vc.Function, cuts: [i64]) -> Vec(i64) {
    let n = f.blocks.len()
    var is_cut = Vec(bool).filled(n, false)
    for c in cuts { is_cut[c] = true }
    // Depth-first postorder over the edges that do not enter a cut point.
    var order = Vec(i64).new()
    var state = Vec(i64).filled(n, 0)
    var stack = Vec((i64, i64)).new()
    if n == 0 { return Vec(i64).new() }
    state[0] = 1
    stack.push((0, 0))
    loop {
        let Some(top) = stack.pop() else { break }
        let succ = successors(f.blocks[top.0].term)
        if top.1 < succ.len() {
            stack.push((top.0, top.1 + 1))
            let s = succ[top.1]
            if !is_cut[s] && state[s] == 0 {
                state[s] = 1
                stack.push((s, 0))
            }
        } else { order.push(top.0) }
    }
    // The walks also start at every cut point.
    for c in cuts {
        if state[c] == 0 {
            state[c] = 1
            stack.push((c, 0))
            loop {
                let Some(top) = stack.pop() else { break }
                let succ = successors(f.blocks[top.0].term)
                if top.1 < succ.len() {
                    stack.push((top.0, top.1 + 1))
                    let s = succ[top.1]
                    if !is_cut[s] && state[s] == 0 {
                        state[s] = 1
                        stack.push((s, 0))
                    }
                } else { order.push(top.0) }
            }
        }
    }
    var paths = Vec(i64).filled(n, 0)
    var out = Vec(i64).new()
    paths[0] = 1
    for c in cuts { paths[c] = 1 }
    // Reverse postorder: every block after those that reach it.
    var k = order.len()
    while k > 0 {
        k -= 1
        let b = order[k]
        if paths[b] > MAX_PATHS_TO_BLOCK && !is_cut[b] {
            is_cut[b] = true
            out.push(b)
            paths[b] = 1
        }
        for s in successors(f.blocks[b].term) {
            if !is_cut[s] {
                paths[s] += paths[b]
                if paths[s] > MAX_PATHS_TO_BLOCK + 1 { paths[s] = MAX_PATHS_TO_BLOCK + 1 }
            }
        }
    }
    out
}

// Gives each block in `cuts` an invariant without facts, if it has none.
pub fn cut(inout f: vc.Function, cuts: [i64]) {
    for b in cuts {
        var has = false
        for inv in f.invariants {
            if inv.0 == b { has = true }
        }
        if !has { f.invariants.push((b, Vec(vc.Fact).new())) }
    }
}

fn operand_local(o: vc.Operand, inout out: Vec(bool)) {
    match o {
        Local(l) => out[l] = true
        _ => {}
    }
}

// The integers the function compares or computes with: the only ones an
// invariant about them can help.
fn interesting(f: vc.Function) -> Vec(bool) {
    var out = Vec(bool).filled(f.kinds.len(), false)
    for b in f.blocks {
        for s in b.stmts {
            match s {
                Assign(dst, rv, _, _) => match rv {
                    Add(x, y) | Sub(x, y) | Mul(x, y) | AddWrap(x, y) | SubWrap(x, y) | Compare(
                        _,
                        x,
                        y
                    ) => {
                        out[dst] = true
                        operand_local(x, &out)
                        operand_local(y, &out)
                    }
                    Cast(x) => {
                        out[dst] = true
                        operand_local(x, &out)
                    }
                    _ => {}
                }
                Check(_, _) => {}
            }
        }
    }
    out
}

// The number of blocks that assign each variable.
fn assigned_in(f: vc.Function) -> Vec(i64) {
    var count = Vec(i64).filled(f.kinds.len(), 0)
    for b in f.blocks {
        var here = Vec(i64).new()
        for s in b.stmts {
            match s {
                Assign(dst, _, _, _) => here.push(dst)
                Check(_, _) => {}
            }
        }
        match b.term {
            Call(dst, _, site) => {
                if dst >= 0 { here.push(dst) }
                for a in site.args {
                    match a {
                        Lent(x) => here.push(x)
                        _ => {}
                    }
                }
                for x in site.changes { here.push(x) }
            }
            _ => {}
        }
        sort.sort(&here)
        for i, l in here {
            if i == 0 || here[i - 1] != l { count[l] += 1 }
        }
    }
    count
}

fn is_int(f: vc.Function, l: i64) -> bool {
    match f.kinds[l] {
        Int(_, _) => true
        Other => false
    }
}

// Candidates per cut point, at most this many.
pub const MAX_CANDIDATES: i64 = 96

// The variables a comparison puts beside one of `moving`.
fn compared_with(f: vc.Function, moving: [bool]) -> Vec(bool) {
    var out = Vec(bool).filled(f.kinds.len(), false)
    for b in f.blocks {
        for s in b.stmts {
            match s {
                Assign(_, rv, _, _) => match rv {
                    Compare(_, Local(x), Local(y)) => {
                        if moving[x] { out[y] = true }
                        if moving[y] { out[x] = true }
                    }
                    _ => {}
                }
                Check(_, _) => {}
            }
        }
    }
    out
}

// Each round of inference generates every obligation again, so the
// functions larger than this get no candidates about ranges' ends.
pub const MAX_BLOCKS_FOR_ENDS: i64 = 400

// What each variable assigned once may be a copy of: the variable a `use`
// copies, or the fields a call it is the result of is given (`len()`
// returns one).
fn copied_from(f: vc.Function, count: [i64]) -> Vec(Vec(i64)) {
    var out = Vec(Vec(i64)).new()
    for _ in 0..f.kinds.len() { out.push(Vec(i64).new()) }
    for b in f.blocks {
        for s in b.stmts {
            match s {
                Assign(dst, rv, _, _) => match rv {
                    Use(Local(w)) => if count[dst] == 1 { out[dst].push(w) }
                    _ => {}
                }
                Check(_, _) => {}
            }
        }
        match b.term {
            Call(dst, _, site) => if dst >= 0 && count[dst] == 1 {
                for x in site.fields {
                    if x.param > 0 { out[dst].push(x.v) }
                }
            }
            _ => {}
        }
    }
    out
}

// Variables a loop counts with (assigned in two blocks or more: before the
// loop and in it), and what they are compared with (never assigned:
// arguments and lengths). A variable assigned once that a counter is
// compared with, such as a range's end, is proposed to be at least the
// counter, and equal to what it is a copy of, through a few copies.
fn candidates(f: vc.Function) -> Vec(vc.Fact) {
    let count = assigned_in(f)
    let useful = interesting(f)
    var moving = Vec(i64).new()
    var is_moving = Vec(bool).filled(f.kinds.len(), false)
    var fixed = Vec(i64).new()
    for l in 1..f.kinds.len() {
        if is_int(f, l) && useful[l] {
            if count[l] >= 2 {
                moving.push(l)
                is_moving[l] = true
            }
            if count[l] == 0 { fixed.push(l) }
        }
    }
    // Lengths are never assigned by a statement of their own view's
    // reading, but are what loops count to.
    for p in f.callee.lengths {
        if count[p.1] == 0 && !useful[p.1] { fixed.push(p.1) }
    }
    let beside = compared_with(f, is_moving.as_slice())
    let copies = copied_from(f, count.as_slice())
    var out = Vec(vc.Fact).new()
    for v in moving {
        match f.kinds[v] {
            Int(lo, _) => if lo < 0 { out.push(vc.fact(
                vc.Cmp.Le,
                vc.Operand.Const(0),
                vc.Operand.Local(v)
            )) }
            Other => {}
        }
    }
    for v in 1..f.kinds.len() {
        if f.blocks.len() > MAX_BLOCKS_FOR_ENDS { break }
        if !beside[v] || count[v] != 1 || !is_int(f, v) { continue }
        for w in moving { out.push(vc.fact(vc.Cmp.Le, vc.Operand.Local(w), vc.Operand.Local(v))) }
        var seen = Vec(i64).new()
        var todo = copies[v].clone()
        while todo.len() > 0 && seen.len() < 8 {
            let w = todo.pop().unwrap()
            var again = false
            for x in seen {
                if x == w { again = true }
            }
            if again || w == v || !is_int(f, w) { continue }
            seen.push(w)
            if count[w] <= 1 { out.push(vc.fact(
                vc.Cmp.Eq,
                vc.Operand.Local(v),
                vc.Operand.Local(w)
            )) }
            for x in copies[w] { todo.push(x) }
        }
    }
    for v in moving {
        for w in moving {
            if w != v { out.push(vc.fact(vc.Cmp.Le, vc.Operand.Local(v), vc.Operand.Local(w))) }
        }
        for w in fixed {
            out.push(vc.fact(vc.Cmp.Le, vc.Operand.Local(v), vc.Operand.Local(w)))
            out.push(vc.fact(vc.Cmp.Le, vc.Operand.Local(w), vc.Operand.Local(v)))
        }
        if out.len() >= MAX_CANDIDATES { break }
    }
    out.truncate(MAX_CANDIDATES)
    out
}

pub const MAX_ROUNDS: i64 = 20
// The facts in the goals proved over all rounds, at most: inference in a
// large function that does not settle soon gives up.
pub const MAX_WORK: i64 = 500000

pub fn proved(goals: [linear.Goal]) -> bool {
    for g in goals {
        let ok = match fm.prove(g) {
            Ok(c) => linear.check(g, c).is_ok()
            Err(_) => false
        }
        if !ok { return false }
    }
    true
}

// `f` with candidates proposed for its cut points in `heads`, after the
// facts written there, kept while they check; a written fact is never
// dropped. The cut points in `joins`, where many paths meet, get the facts
// of the written invariants: one inside a loop must carry them on to the
// loop's head.
pub fn infer(inout f: vc.Function, heads: [i64], joins: [i64], contracts: [Option(vc.Callee)]) {
    let proposed = candidates(f)
    var written = Vec(vc.Fact).new()
    for inv in f.invariants {
        for x in inv.1 { written.push(x.clone()) }
    }
    if proposed.len() == 0 && written.len() == 0 { return }
    // Per invariant, the index of its first fact this adds (its length if
    // none).
    var first = Vec(i64).new()
    for i in 0..f.invariants.len() {
        first.push(f.invariants[i].1.len())
        for h in heads {
            if h == f.invariants[i].0 {
                for x in proposed { f.invariants[i].1.push(x.clone()) }
            }
        }
        if first[i] == 0 {
            for h in joins {
                if h == f.invariants[i].0 {
                    for x in written { f.invariants[i].1.push(x.clone()) }
                }
            }
        }
    }
    var work = 0
    for _ in 0..MAX_ROUNDS {
        let obs = vc.generate(f, contracts, Vec(Option(vc.Lift)).new().as_slice())
        if obs.errors.len() > 0 { break }
        var failed = Vec(Vec(bool)).new()
        for inv in f.invariants { failed.push(Vec(bool).filled(inv.1.len(), false)) }
        var any = false
        for o in obs.list {
            match o.source {
                Invariant(i, j) => if j >= first[i] && !failed[i][j] {
                    for g in o.goals { work += g.facts.len() }
                    if !proved(o.goals.as_slice()) {
                        failed[i][j] = true
                        any = true
                    }
                }
                _ => {}
            }
        }
        if !any { return }
        if work > MAX_WORK { break }
        for i in 0..f.invariants.len() {
            var kept = Vec(vc.Fact).new()
            for j, x in f.invariants[i].1 {
                if !failed[i][j] { kept.push(x.clone()) }
            }
            f.invariants[i].1 = kept
        }
    }
    // Not settled: drop what was proposed, which leaves the cut points.
    for i in 0..f.invariants.len() { f.invariants[i].1.truncate(first[i]) }
}
