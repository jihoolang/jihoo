// The trusted checker of verification (docs/internals/verification.md):
// linear integer implications with Farkas certificates. It finds nothing;
// it only adds up the weighted facts a prover proposes.

// sum(k * x_v for each (v, k) in terms) + constant, read as a fact `>= 0`.
// The terms are sparse, by increasing variable, with no zero coefficient.
pub struct Lin {
    pub terms: Vec((i64, i128))
    pub constant: i128
}

impl Lin {
    pub fn num(c: i128) -> Lin {
        Lin { terms: Vec((i64, i128)).new(), constant: c }
    }

    pub fn of(v: i64) -> Lin {
        var terms = Vec((i64, i128)).new()
        terms.push((v, 1))
        Lin { terms, constant: 0 }
    }

    pub fn coef(self, v: i64) -> i128 {
        for t in self.terms {
            if t.0 == v { return t.1 }
            if t.0 > v { return 0 }
        }
        0
    }

    // self * a + other * b, merging the two sorted lists of terms.
    pub fn combine(self, a: i128, other: Lin, b: i128) -> Lin {
        var terms = Vec((i64, i128)).with_capacity(self.terms.len() + other.terms.len())
        var i = 0
        var j = 0
        while i < self.terms.len() || j < other.terms.len()
            invariant 0 <= i && i <= self.terms.len()
            invariant 0 <= j && j <= other.terms.len()
        {
            var v: i64 = 0
            var k: i128 = 0
            if j == other.terms.len() || (
                i < self.terms.len() && self.terms[i].0 < other.terms[j].0
            ) {
                v = self.terms[i].0
                k = self.terms[i].1 * a
                i += 1
            } else if i == self.terms.len() || other.terms[j].0 < self.terms[i].0 {
                v = other.terms[j].0
                k = other.terms[j].1 * b
                j += 1
            } else {
                v = self.terms[i].0
                k = self.terms[i].1 * a + other.terms[j].1 * b
                i += 1
                j += 1
            }
            if k != 0 { terms.push((v, k)) }
        }
        Lin { terms, constant: self.constant * a + other.constant * b }
    }

    pub fn plus(self, other: Lin) -> Lin { self.combine(1, other, 1) }
    pub fn minus(self, other: Lin) -> Lin { self.combine(1, other, -1) }

    pub fn scale(self, k: i128) -> Lin {
        var terms = Vec((i64, i128)).with_capacity(self.terms.len())
        if k != 0 {
            for t in self.terms { terms.push((t.0, t.1 * k)) }
        }
        Lin { terms, constant: self.constant * k }
    }

    pub fn shift(self, k: i128) -> Lin {
        Lin { terms: self.terms.clone(), constant: self.constant + k }
    }

    // The largest absolute value among the coefficients and the constant.
    pub fn magnitude(self) -> i128 {
        var m = abs(self.constant)
        for t in self.terms {
            if abs(t.1) > m { m = abs(t.1) }
        }
        m
    }

    pub fn is_constant(self) -> bool { self.terms.len() == 0 }

    // Every coefficient and the constant are in [-max, max]; unlike
    // `magnitude`, for any numbers.
    pub fn within(self, max: i128) -> bool {
        if self.constant < 0 - max || self.constant > max { return false }
        for t in self.terms {
            if t.1 < 0 - max || t.1 > max { return false }
        }
        true
    }
}

impl Clone for Lin {
    fn clone(self) -> Lin {
        Lin { terms: self.terms.clone(), constant: self.constant }
    }
}

// Every fact `>= 0` together implies `claim >= 0`, for all integer values.
pub struct Goal {
    pub facts: Vec(Lin)
    pub claim: Lin
}

// One non-negative weight per fact, then one for the negated claim
// `-claim - 1 >= 0`.
pub struct Certificate {
    pub weights: Vec(i128)
}

pub fn abs(x: i128) -> i128 { if x < 0 { 0 - x } else { x } }

// The checker computes only within these bounds, where no product or sum
// can leave an i128: each term is at most 2^65 * 2^50 = 2^115, and at most
// 2^11 of them are added.
pub const MAX_VALUE: i128 = 1 << 65
pub const MAX_WEIGHT: i128 = 1 << 50
pub const MAX_FACTS: i64 = 2047

// A form is well made: its terms are by increasing variable and none is
// zero. `combine` relies on it, so the checker checks it of its inputs.
fn sorted(x: Lin) -> bool {
    var i = 0
    while i < x.terms.len()
        invariant 0 <= i
    {
        let t = x.terms[i]
        if t.1 == 0 || t.0 < 0 { return false }
        if i > 0 && x.terms[i - 1].0 >= t.0 { return false }
        i += 1
    }
    true
}

// Sound because an integer point satisfying the facts and the negated claim
// makes the weighted sum non-negative, while the sum is a negative constant.
// Returns the number of facts used.
pub fn check(g: Goal, c: Certificate) -> Result(i64, str) {
    let n = g.facts.len()
    if n > MAX_FACTS { return Err("too many facts to check") }
    if c.weights.len() != n + 1 {
        return Err("a certificate needs one weight per fact and one for the claim")
    }
    for i in 0..n
        invariant c.weights.len() == n + 1 && g.facts.len() == n
    {
        let x = g.facts[i]
        if !sorted(x) { return Err("a fact is not a well-made form") }
        if !x.within(MAX_VALUE) { return Err("a fact's numbers are too large to check") }
    }
    if !sorted(g.claim) { return Err("the claim is not a well-made form") }
    if !g.claim.within(MAX_VALUE - 1) { return Err("the claim's numbers are too large to check") }
    for i in 0..c.weights.len()
        invariant c.weights.len() == n + 1 && g.facts.len() == n
    {
        let w = c.weights[i]
        if w < 0 { return Err("negative weight") }
        if w > MAX_WEIGHT { return Err("a weight is too large to check") }
    }
    var sum = g.claim.scale(-1).shift(-1).scale(c.weights[n])
    for i in 0..n
        invariant c.weights.len() == n + 1 && g.facts.len() == n
    {
        if c.weights[i] != 0 { sum = sum.plus(g.facts[i].scale(c.weights[i])) }
    }
    if !sum.is_constant() { return Err("the weighted facts do not cancel") }
    if sum.constant >= 0 { return Err("the weighted facts are not contradictory") }
    var used = 0
    var i = 0
    while i < c.weights.len()
        invariant 0 <= used && used <= i
    {
        if c.weights[i] > 0 { used += 1 }
        i += 1
    }
    Ok(used)
}

#[test]
fn checks_a_certificate() {
    // x >= 0 and 3 - x >= 0 imply 5 - x >= 0: 1 * (3 - x) + 1 * (x - 6) = -3.
    var facts = Vec(Lin).new()
    facts.push(Lin.of(0))
    facts.push(Lin.of(0).scale(-1).shift(3))
    let g = Goal { facts, claim: Lin.of(0).scale(-1).shift(5) }
    var w = Vec(i128).new()
    w.push(0)
    w.push(1)
    w.push(1)
    assert(check(g, Certificate { weights: w }).is_ok(), "accepted")
    var bad = Vec(i128).new()
    bad.push(1)
    bad.push(0)
    bad.push(1)
    assert(check(g, Certificate { weights: bad }).is_err(), "rejected")
}

#[test]
fn rejects_unsorted_forms() {
    var terms = Vec((i64, i128)).new()
    terms.push((1, 1))
    terms.push((0, 1))
    var facts = Vec(Lin).new()
    facts.push(Lin { terms, constant: 0 })
    let g = Goal { facts, claim: Lin.num(-1) }
    var w = Vec(i128).new()
    w.push(0)
    w.push(1)
    assert(check(g, Certificate { weights: w }).is_err(), "rejected")
}
