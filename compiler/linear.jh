// The trusted checker of verification (docs/internals/verification.md):
// linear integer implications with Farkas certificates. It finds nothing;
// it only adds up the weighted facts a prover proposes.
//
// It has no check that can trap: its sums are computed with `add` and
// `mul`, which report overflow (with the `overflowing_*` builtins, whose
// meaning is exact), and a certificate whose sum does not fit an i128 is
// rejected. Its loops are `while` loops, without the wrapping counters of
// range `for`, so that lib/proof's model of it follows the code. `jihoo verify compiler/main.jh` keeps no check in
// this file, and the verify suite tests that it stays so. The generator's
// arithmetic on forms, which traps, is `forms.jh`.

// sum(k * x_v for each (v, k) in terms) + constant, read as a fact `>= 0`.
// The terms are sparse, by increasing variable, with no zero coefficient.
pub struct Lin {
    pub terms: Vec((i64, i128))
    pub constant: i128
}

impl Lin {
    pub fn num(c: i128) -> Lin {
        Lin { terms: Vec((i64, i128)).new(), constant: c }
    }

    pub fn of(v: i64) -> Lin {
        var terms = Vec((i64, i128)).new()
        terms.push((v, 1))
        Lin { terms, constant: 0 }
    }

    pub fn coef(self, v: i64) -> i128 {
        for t in self.terms {
            if t.0 == v { return t.1 }
            if t.0 > v { return 0 }
        }
        0
    }

    pub fn is_constant(self) -> bool { self.terms.len() == 0 }

    // self + other * w, merging the two sorted lists of terms, or None when
    // a number does not fit an i128.
    pub fn add_scaled(self, other: Lin, w: i128) -> Option(Lin) {
        var terms = Vec((i64, i128)).with_capacity(self.terms.len())
        var i = 0
        var j = 0
        while i < self.terms.len() || j < other.terms.len()
            invariant 0 <= i && i <= self.terms.len()
            invariant 0 <= j && j <= other.terms.len()
        {
            var v: i64 = 0
            var k: i128 = 0
            if j == other.terms.len() || (
                i < self.terms.len() && self.terms[i].0 < other.terms[j].0
            ) {
                v = self.terms[i].0
                k = self.terms[i].1
                i += 1
            } else {
                let Some(p) = mul(other.terms[j].1, w) else { return None }
                if i == self.terms.len() || other.terms[j].0 < self.terms[i].0 {
                    v = other.terms[j].0
                    k = p
                } else {
                    v = self.terms[i].0
                    let Some(s) = add(self.terms[i].1, p) else { return None }
                    k = s
                    i += 1
                }
                j += 1
            }
            if k != 0 { terms.push((v, k)) }
        }
        let Some(p) = mul(other.constant, w) else { return None }
        let Some(c) = add(self.constant, p) else { return None }
        Some(Lin { terms, constant: c })
    }
}

impl Clone for Lin {
    fn clone(self) -> Lin {
        Lin { terms: self.terms.clone(), constant: self.constant }
    }
}

// a + b, or None when it does not fit an i128.
pub fn add(a: i128, b: i128) -> Option(i128) {
    let (s, over) = overflowing_add(a, b)
    if over { return None }
    Some(s)
}

// a * b, or None when it does not fit an i128.
pub fn mul(a: i128, b: i128) -> Option(i128) {
    let (p, over) = overflowing_mul(a, b)
    if over { return None }
    Some(p)
}

// Every fact `>= 0` together implies `claim >= 0`, for all integer values.
pub struct Goal {
    pub facts: Vec(Lin)
    pub claim: Lin
}

// One non-negative weight per fact, then one for the negated claim
// `-claim - 1 >= 0`.
pub struct Certificate {
    pub weights: Vec(i128)
}

// The generator and the provers keep their numbers within these bounds,
// so that the checker's sums fit an i128 and certificates are accepted:
// each term is at most 2^65 * 2^50 = 2^115, and at most 2^11 of them are
// added. The checker's soundness does not depend on them.
pub const MAX_VALUE: i128 = 1 << 65
pub const MAX_WEIGHT: i128 = 1 << 50
pub const MAX_FACTS: i64 = 2047

// A form is well made: its terms are by increasing variable and none is
// zero. `add_scaled` relies on it, so the checker checks it of its inputs.
fn sorted(x: Lin) -> bool {
    var i = 0
    while i < x.terms.len()
        invariant 0 <= i
    {
        let t = x.terms[i]
        if t.1 == 0 || t.0 < 0 { return false }
        if i > 0 && x.terms[i - 1].0 >= t.0 { return false }
        i += 1
    }
    true
}

// Sound because an integer point satisfying the facts and the negated claim
// makes the weighted sum non-negative, while the sum is a negative constant.
// Every sum is exact: one that does not fit an i128 rejects the
// certificate. Returns the number of facts used.
pub fn check(g: Goal, c: Certificate) -> Result(i64, str) {
    let n = g.facts.len()
    if n > MAX_FACTS { return Err("too many facts to check") }
    if c.weights.len() != n + 1 {
        return Err("a certificate needs one weight per fact and one for the claim")
    }
    var i = 0
    while i < n
        invariant 0 <= i && c.weights.len() == n + 1 && g.facts.len() == n
    {
        if !sorted(g.facts[i]) { return Err("a fact is not a well-made form") }
        i += 1
    }
    if !sorted(g.claim) { return Err("the claim is not a well-made form") }
    i = 0
    while i < n + 1
        invariant 0 <= i && c.weights.len() == n + 1 && g.facts.len() == n
    {
        if c.weights[i] < 0 { return Err("negative weight") }
        i += 1
    }
    // The negated claim, -claim - 1 >= 0.
    let Some(negated) = Lin.num(-1).add_scaled(g.claim, -1) else {
        return Err("the claim's numbers are too large to check")
    }
    let Some(first) = Lin.num(0).add_scaled(negated, c.weights[n]) else {
        return Err("the weighted sum does not fit an i128")
    }
    var sum = first
    i = 0
    while i < n
        invariant 0 <= i && c.weights.len() == n + 1 && g.facts.len() == n
    {
        if c.weights[i] != 0 {
            let Some(s) = sum.add_scaled(g.facts[i], c.weights[i]) else {
                return Err("the weighted sum does not fit an i128")
            }
            sum = s
        }
        i += 1
    }
    if !sum.is_constant() { return Err("the weighted facts do not cancel") }
    if sum.constant >= 0 { return Err("the weighted facts are not contradictory") }
    var used = 0
    i = 0
    while i < c.weights.len()
        invariant 0 <= used && used <= i
    {
        if c.weights[i] > 0 { used += 1 }
        i += 1
    }
    Ok(used)
}

fn weights(ws: [i128]) -> Certificate {
    var w = Vec(i128).new()
    for x in ws { w.push(x) }
    Certificate { weights: w }
}

#[test]
fn checks_a_certificate() {
    // x >= 0 and 3 - x >= 0 imply 5 - x >= 0: 1 * (3 - x) + 1 * (x - 6) = -3.
    var facts = Vec(Lin).new()
    facts.push(Lin.of(0))
    facts.push(Lin.num(3).add_scaled(Lin.of(0), -1).unwrap())
    let g = Goal { facts, claim: Lin.num(5).add_scaled(Lin.of(0), -1).unwrap() }
    assert(check(g, weights([0, 1, 1])).is_ok(), "accepted")
    assert(check(g, weights([1, 0, 1])).is_err(), "rejected")
    assert(check(g, weights([0, 1, 1, 0])).is_err(), "one weight per fact")
    assert(check(g, weights([-1, 1, 1])).is_err(), "negative weight")
}

#[test]
fn rejects_unsorted_forms() {
    var terms = Vec((i64, i128)).new()
    terms.push((1, 1))
    terms.push((0, 1))
    var facts = Vec(Lin).new()
    facts.push(Lin { terms, constant: 0 })
    let g = Goal { facts, claim: Lin.num(-1) }
    assert(check(g, weights([0, 1])).is_err(), "rejected")
}

// Numbers for the tests, computed while compiling.
const BIG: i128 = 1 << 126
const MINUS_BIG: i128 = 0 - BIG
const MAX: i128 = BIG + (BIG - 1)
const MIN: i128 = 0 - MAX - 1
const MINUS_MAX: i128 = 0 - MAX
const HALVES: i128 = (1 << 64) + 3
const HALVES2: i128 = (1 << 62) + 5
const HALVES_PRODUCT: i128 = BIG + 5 * (1 << 64) + 3 * (1 << 62) + 15
const P100: i128 = 1 << 100
const MINUS_P64: i128 = 0 - (1 << 64)

#[test]
fn rejects_sums_that_overflow() {
    // x - 2^126 >= 0, and -x - 2^126 >= 0, with x's weight wrapping: a sum
    // computed with wrapping arithmetic would cancel x and be negative.
    var facts = Vec(Lin).new()
    facts.push(Lin.num(MINUS_BIG).add_scaled(Lin.of(0), 1).unwrap())
    facts.push(Lin.num(MINUS_BIG).add_scaled(Lin.of(0), -1).unwrap())
    let g = Goal { facts, claim: Lin.num(0) }
    assert(check(g, weights([2, 2, 0])).is_err(), "overflow rejected")
    assert(check(g, weights([1, 1, 0])).is_ok(), "x - 2^126 and -x - 2^126")
}

#[test]
fn exact_arithmetic() {
    assert(add(MAX, 1).is_none(), "max + 1")
    assert(add(MIN, -1).is_none(), "min - 1")
    assert(add(MIN, MAX).unwrap() == -1, "min + max")
    assert(mul(P100, 1 << 26).unwrap() == BIG, "2^126")
    assert(mul(P100, 1 << 27).is_none(), "2^127")
    assert(mul(MINUS_P64, 1 << 62).unwrap() == MINUS_BIG, "negative")
    assert(mul(MAX, -1).unwrap() == MINUS_MAX, "max * -1")
    assert(mul(MIN, -1).is_none(), "min * -1")
    assert(mul(MIN, 1).unwrap() == MIN, "min fits")
    assert(mul(3, -7).unwrap() == -21, "small")
    assert(mul(0, MIN).unwrap() == 0, "zero")
    assert(mul(HALVES, HALVES2).unwrap() == HALVES_PRODUCT, "halves")
}
