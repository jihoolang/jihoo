{-# OPTIONS --safe --without-K #-}
------------------------------------------------------------------------
-- Adequacy: what lib/proof/refine.jh's theorem says about numbers.
--
-- refine.jh proves, in Horn rules (the theory `Theory`, generated by
-- agda/theory.jh), the goal
--
--   fn.check (Goal.mk fs cl) (Certificate.mk ws) (Ok m), sat fs x,
--   le (add (val cl x) z1) z0  ⊢  false
--
-- and lib/proof (with Horn's own checker) accepts the certificate. Horn's
-- agda/Schematic.agda and agda/Implication.agda prove each form of a
-- certificate sound in every model of the rules (`Rules.Model`): a set of
-- ground judgments closed under the rules and supported by them. So the
-- goal is `Valid` in every model. This file gives one that reads the
-- theory in an ordered commutative ring (Integers.agda: the integers):
--
-- * `eq`, `le` and `false` are equality, order and falsity of values,
--   with `⟦_⟧` the value of an expression of sort Z; `look` at a point
--   `pt l` is the value `l` gives the variable;
-- * every other judgment holds when it is derivable by the rules, with
--   true `eq` and `le` judgments as axioms (`OD`). That is what the rules
--   `jihoo emit-horn` writes mean: `fn.check …` holds when the code, run
--   on those values, returns `Ok`, each comparison on its path true.
--
-- The rules that conclude `eq`, `le` or `false` are the ring's axioms,
-- the defining equations of `look`, `ev` and `val`, and `efq` rules; each
-- holds in the ring (`known-ok`), and Agda checks by evaluation that no
-- other rule of the theory concludes one (`classified`). The theorem
-- `sound` then says: when `check` returns `Ok` for facts `fs`, claim `cl`
-- and weights `ws`, no point `x` makes every fact non-negative and the
-- claim negative.
--
-- No library is imported: Schematic.agda's prelude is used.
------------------------------------------------------------------------
module Adequacy where

open import Schematic
open import Theory
open Rule
open Σ

------------------------------------------------------------------------
-- Ordered commutative rings, with ring.jh's axioms as laws

record OrderedRing : Set₁ where
  infixl 6 _+ᴿ_
  infixl 7 _*ᴿ_
  infix 4 _≈ᴿ_ _≤ᴿ_
  field
    A         : Set
    _≈ᴿ_ _≤ᴿ_ : A → A → Set
    0ᴿ 1ᴿ     : A
    _+ᴿ_ _*ᴿ_ : A → A → A
    negᴿ      : A → A
    _≈?_      : (a b : A) → Dec (a ≈ᴿ b)
    ≈ᴿ-refl    : ∀ {a} → a ≈ᴿ a
    ≈ᴿ-sym     : ∀ {a b} → a ≈ᴿ b → b ≈ᴿ a
    ≈ᴿ-trans   : ∀ {a b c} → a ≈ᴿ b → b ≈ᴿ c → a ≈ᴿ c
    +ᴿ-cong    : ∀ {a b c d} → a ≈ᴿ b → c ≈ᴿ d → a +ᴿ c ≈ᴿ b +ᴿ d
    *ᴿ-cong    : ∀ {a b c d} → a ≈ᴿ b → c ≈ᴿ d → a *ᴿ c ≈ᴿ b *ᴿ d
    neg-cong  : ∀ {a b} → a ≈ᴿ b → negᴿ a ≈ᴿ negᴿ b
    +ᴿ-comm    : ∀ a b → a +ᴿ b ≈ᴿ b +ᴿ a
    +ᴿ-assoc   : ∀ a b c → a +ᴿ b +ᴿ c ≈ᴿ a +ᴿ (b +ᴿ c)
    +ᴿ-zero    : ∀ a → a +ᴿ 0ᴿ ≈ᴿ a
    +ᴿ-neg     : ∀ a → a +ᴿ negᴿ a ≈ᴿ 0ᴿ
    *ᴿ-comm    : ∀ a b → a *ᴿ b ≈ᴿ b *ᴿ a
    *ᴿ-assoc   : ∀ a b c → a *ᴿ b *ᴿ c ≈ᴿ a *ᴿ (b *ᴿ c)
    *ᴿ-one     : ∀ a → a *ᴿ 1ᴿ ≈ᴿ a
    *ᴿ-dist    : ∀ a b c → a *ᴿ (b +ᴿ c) ≈ᴿ a *ᴿ b +ᴿ a *ᴿ c
    ≤ᴿ-resp    : ∀ {a b c d} → a ≤ᴿ b → a ≈ᴿ c → b ≈ᴿ d → c ≤ᴿ d
    ≤ᴿ-refl    : ∀ {a} → a ≤ᴿ a
    ≤ᴿ-antisym : ∀ {a b} → a ≤ᴿ b → b ≤ᴿ a → a ≈ᴿ b
    ≤ᴿ-trans   : ∀ {a b c} → a ≤ᴿ b → b ≤ᴿ c → a ≤ᴿ c
    ≤ᴿ-add     : ∀ {a b} c → a ≤ᴿ b → a +ᴿ c ≤ᴿ b +ᴿ c
    ≤ᴿ-mul     : ∀ {a b} → 0ᴿ ≤ᴿ a → 0ᴿ ≤ᴿ b → 0ᴿ ≤ᴿ a *ᴿ b
    0≤1       : 0ᴿ ≤ᴿ 1ᴿ
    1≰0       : ¬ (1ᴿ ≤ᴿ 0ᴿ)

------------------------------------------------------------------------
-- The signature, with the goal's variables fs, cl, ws, m, x as 0 … 4

goalSorts : List ℕ
goalSorts = ˢVec⟨Lin⟩ ∷ ˢLin ∷ ˢVec⟨i128⟩ ∷ ˢZ ∷ ˢX ∷ []

sig : Signature
sig = record { out = λ c → nth outT c junk ; ins = λ c → nth insT c [] ; vs = λ y → nth goalSorts y 0 }

open Signature sig
open Rules sig rules
open Calculus sig rules using (RuleWF; ruleWF?; headSort)

-- The goal refine.jh proves.
goalH : List Tm
goalH = #fn·check (#Goal·mk (var 0) (var 1)) (#Certificate·mk (var 2)) (#Result⟨i64ˌstr⟩·Ok (var 3))
      ∷ #sat (var 0) (var 4)
      ∷ #le (#add (#val (var 1) (var 4)) #z1) #z0
      ∷ []

goalJ : Tm
goalJ = #false

-- The judgments read as truth in the ring: by their predicate.
head : Tm → ℕ
head (var _)    = head #false
head (node f _) = f

-- Symbol numbers, read off the theory's pattern synonyms.
EQ LE Z1 ADD MUL NEG PT LOOK EV VAL CONS MK LIN : ℕ
EQ   = head (#eq #z0 #z0)
LE   = head (#le #z0 #z0)
Z1   = head #z1
ADD  = head (#add #z0 #z0)
MUL  = head (#mul #z0 #z0)
NEG  = head (#neg #z0)
PT   = head (#pt #z0)
LOOK = head (#look #z0 #z0)
EV   = head (#ev #z0 #z0)
VAL  = head (#val #z0 #z0)
CONS = head (#Vec⟨⟨i64ˌi128⟩⟩·cons #z0 #z0)
MK   = head (#Tup⟨ZˌZ⟩·mk #z0 #z0)
LIN  = head (#Lin·mk #z0 #z0)

Arith : Tm → Set
Arith t = (head t ≡ head (#eq #z0 #z0)) ⊎ ((head t ≡ head (#le #z0 #z0)) ⊎ (head t ≡ head #false))

arith? : (t : Tm) → Dec (Arith t)
arith? t = (head t ≟ _) ⊎? ((head t ≟ _) ⊎? (head t ≟ _))
  where
    _⊎?_ : {P Q : Set} → Dec P → Dec Q → Dec (P ⊎ Q)
    yes p ⊎? _     = yes (inl p)
    no _  ⊎? yes q = yes (inr q)
    no n  ⊎? no m  = no (λ { (inl p) → n p ; (inr q) → m q })

-- A rule keeps its conclusion's predicate in every instance.
keep : (c : Tm) (σ : Subst) → ¬ Arith c → ¬ Arith (sub σ c)
keep (var y)    σ na = ⊥-elim (na (inr (inr refl)))
keep (node f _) σ na = na

-- Every rule of the theory has well-sorted judgments (the checker's
-- parser ensures it; Agda checks it again).
wf : All RuleWF rules
wf = witness (all? ruleWF? rules) tt

-- Ground and well-sorted: z0, and terms built from such.
gz0 : GroundWS #z0 ˢZ
gz0 = (λ x → λ { (arg ()) }) , node refl []

------------------------------------------------------------------------
-- The model, in an ordered commutative ring

module Adequate (Rg : OrderedRing) where
  open OrderedRing Rg

  -- The value of an expression of sort Z, and of the model's functions.
  -- Symbols are told apart by number (Agda does not match on large
  -- literals), so each clause tests the symbols its shape may have.
  mutual
    ⟦_⟧ : Tm → A
    ⟦ var _ ⟧     = 0ᴿ
    ⟦ node f ts ⟧ = app f ts

    app : ℕ → List Tm → A
    app f []           = pick (f ≟ Z1) 1ᴿ 0ᴿ
    app f (a ∷ [])     = pick (f ≟ NEG) (negᴿ ⟦ a ⟧) 0ᴿ
    app f (a ∷ b ∷ []) =
      pick (f ≟ ADD) (⟦ a ⟧ +ᴿ ⟦ b ⟧) (pick (f ≟ MUL) (⟦ a ⟧ *ᴿ ⟦ b ⟧)
        (pick (f ≟ LOOK) (look a ⟦ b ⟧) (pick (f ≟ EV) (ev a b) (pick (f ≟ VAL) (val a b) 0ᴿ))))
    app f (_ ∷ _ ∷ _ ∷ _) = 0ᴿ

    -- A point `pt l` gives a variable the value of its first entry in l.
    look : Tm → A → A
    look (node f (l ∷ [])) v = pick (f ≟ PT) (assoc l v) 0ᴿ
    look _                 v = 0ᴿ

    assoc : Tm → A → A
    assoc (node f (node g (k ∷ a ∷ []) ∷ l ∷ [])) v =
      pick (f ≟ CONS) (pick (g ≟ MK) (pick (⟦ k ⟧ ≈? v) ⟦ a ⟧ (assoc l v)) 0ᴿ) 0ᴿ
    assoc _ v = 0ᴿ

    -- The sum of a form's terms at x, and a linear form's value.
    ev : Tm → Tm → A
    ev (node f (node g (v ∷ k ∷ []) ∷ r ∷ [])) x =
      pick (f ≟ CONS) (pick (g ≟ MK) (⟦ k ⟧ *ᴿ look x ⟦ v ⟧ +ᴿ ev r x) 0ᴿ) 0ᴿ
    ev _ x = 0ᴿ

    val : Tm → Tm → A
    val (node f (t ∷ c ∷ [])) x = pick (f ≟ LIN) (ev t x +ᴿ ⟦ c ⟧) 0ᴿ
    val _                     x = 0ᴿ

  -- Equal variables have equal values.
  assoc-cong : (l : Tm) {a b : A} → a ≈ᴿ b → assoc l a ≈ᴿ assoc l b
  assoc-cong (node f (node g (k ∷ c ∷ []) ∷ l ∷ [])) {u} {w} e with f ≟ CONS | g ≟ MK
  ... | no _  | _    = ≈ᴿ-refl
  ... | yes _ | no _ = ≈ᴿ-refl
  ... | yes _ | yes _ with ⟦ k ⟧ ≈? u | ⟦ k ⟧ ≈? w
  ...   | yes _ | yes _ = ≈ᴿ-refl
  ...   | yes p | no n  = ⊥-elim (n (≈ᴿ-trans p e))
  ...   | no n  | yes p = ⊥-elim (n (≈ᴿ-trans p (≈ᴿ-sym e)))
  ...   | no _  | no _  = assoc-cong l e
  assoc-cong (var _)                                        e = ≈ᴿ-refl
  assoc-cong (node f [])                                    e = ≈ᴿ-refl
  assoc-cong (node f (var _ ∷ _))                           e = ≈ᴿ-refl
  assoc-cong (node f (node g [] ∷ _))                       e = ≈ᴿ-refl
  assoc-cong (node f (node g (_ ∷ []) ∷ _))                 e = ≈ᴿ-refl
  assoc-cong (node f (node g (_ ∷ _ ∷ _ ∷ _) ∷ _))          e = ≈ᴿ-refl
  assoc-cong (node f (node g (_ ∷ _ ∷ []) ∷ []))            e = ≈ᴿ-refl
  assoc-cong (node f (node g (_ ∷ _ ∷ []) ∷ _ ∷ _ ∷ _))     e = ≈ᴿ-refl

  look-cong : (x : Tm) {a b : A} → a ≈ᴿ b → look x a ≈ᴿ look x b
  look-cong (node f (l ∷ [])) e with f ≟ PT
  ... | yes _ = assoc-cong l e
  ... | no _  = ≈ᴿ-refl
  look-cong (var _)               e = ≈ᴿ-refl
  look-cong (node f [])           e = ≈ᴿ-refl
  look-cong (node f (_ ∷ _ ∷ _))  e = ≈ᴿ-refl

  -- What `eq`, `le` and `false` say.
  pickS : {P : Set} → Dec P → Set → Set → Set
  pickS (yes _) a b = a
  pickS (no _)  a b = b

  Truth : Tm → Set
  Truth (node f (a ∷ b ∷ [])) = pickS (f ≟ EQ) (⟦ a ⟧ ≈ᴿ ⟦ b ⟧) (pickS (f ≟ LE) (⟦ a ⟧ ≤ᴿ ⟦ b ⟧) ⊥)
  Truth _                     = ⊥

  data Atom : Tm → Set where
    eqA : {a b : Tm} → GroundWS a ˢZ → GroundWS b ˢZ → Atom (#eq a b)
    leA : {a b : Tm} → GroundWS a ˢZ → GroundWS b ˢZ → Atom (#le a b)

  -- What holds: true comparisons of ground values, and what the rules
  -- derive from them, `eq`, `le` and `false` excepted.
  data OD : Tm → Set where
    truth : {t : Tm} → Atom t → Truth t → OD t
    by    : {r : Rule} → r ∈ rules → (σ : Subst) → (∀ y → OccR y r → GroundWS (σ y) (rs r y))
          → ¬ Arith (sub σ (concl r)) → All (λ p → OD (sub σ p)) (prem r) → OD (sub σ (concl r))

  od-truth : {t : Tm} → OD t → Arith t → Truth t
  od-truth (truth _ tr)    _ = tr
  od-truth (by _ _ _ na _) a = ⊥-elim (na a)

  od-false : ¬ OD #false
  od-false d = od-truth d (inr (inr refl))

  eqT : {a b : Tm} → OD (#eq a b) → ⟦ a ⟧ ≈ᴿ ⟦ b ⟧
  eqT d = od-truth d (inl refl)

  leT : {a b : Tm} → OD (#le a b) → ⟦ a ⟧ ≤ᴿ ⟦ b ⟧
  leT d = od-truth d (inr (inl refl))

  -- A true ground comparison holds.
  args : {f : ℕ} {a b : Tm} {s : ℕ} → nth insT f [] ≡ (ˢZ ∷ ˢZ ∷ []) → GroundWS (node f (a ∷ b ∷ [])) s
       → GroundWS a ˢZ × GroundWS b ˢZ
  args {f} e (g , node _ w) with nth insT f [] | e
  args e (g , node _ (wa ∷ wb ∷ [])) | _ | refl =
    ((λ x o → g x (arg (hd o))) , wa) , ((λ x o → g x (arg (tl (hd o)))) , wb)

  atom : (t : Tm) {s : ℕ} → GroundWS t s → Truth t → OD t
  atom (node f (a ∷ b ∷ [])) w tr with f ≟ EQ | f ≟ LE
  ... | yes refl | _        = truth (eqA (fst (args refl w)) (snd (args refl w))) tr
  ... | no _     | yes refl = truth (leA (fst (args refl w)) (snd (args refl w))) tr
  ... | no _     | no _     = ⊥-elim tr
  atom (var _)                   _ ()
  atom (node f [])               _ ()
  atom (node f (a ∷ []))         _ ()
  atom (node f (a ∷ b ∷ c ∷ cs)) _ ()

  ----------------------------------------------------------------------
  -- The rules that conclude `eq`, `le` or `false`, and why each holds

  Known : Set
  Known = List Tm × Tm

  KnownOK : Known → Set
  KnownOK k = (σ : Subst) → All (λ p → OD (sub σ p)) (fst k) → Truth (sub σ (snd k))

  v0 v1 v2 v3 : Tm
  v0 = var 0
  v1 = var 1
  v2 = var 2
  v3 = var 3

  known : List Known
  known =
      ([] , #eq v0 v0)                                                          -- eq.refl
    ∷ ((#eq v0 v1 ∷ []) , #eq v1 v0)                                            -- eq.sym
    ∷ ((#eq v0 v1 ∷ #eq v1 v2 ∷ []) , #eq v0 v2)                                -- eq.trans
    ∷ ((#eq v0 v1 ∷ #eq v2 v3 ∷ []) , #eq (#add v0 v2) (#add v1 v3))            -- eq.add
    ∷ ((#eq v0 v1 ∷ #eq v2 v3 ∷ []) , #eq (#mul v0 v2) (#mul v1 v3))            -- eq.mul
    ∷ ((#eq v0 v1 ∷ []) , #eq (#neg v0) (#neg v1))                              -- eq.neg
    ∷ ([] , #eq (#add v0 v1) (#add v1 v0))                                      -- add.comm
    ∷ ([] , #eq (#add (#add v0 v1) v2) (#add v0 (#add v1 v2)))                  -- add.assoc
    ∷ ([] , #eq (#add v0 #z0) v0)                                               -- add.zero
    ∷ ([] , #eq (#add v0 (#neg v0)) #z0)                                        -- add.neg
    ∷ ([] , #eq (#mul v0 v1) (#mul v1 v0))                                      -- mul.comm
    ∷ ([] , #eq (#mul (#mul v0 v1) v2) (#mul v0 (#mul v1 v2)))                  -- mul.assoc
    ∷ ([] , #eq (#mul v0 #z1) v0)                                               -- mul.one
    ∷ ([] , #eq (#mul v0 (#add v1 v2)) (#add (#mul v0 v1) (#mul v0 v2)))        -- mul.dist
    ∷ ((#le v0 v1 ∷ #eq v0 v2 ∷ #eq v1 v3 ∷ []) , #le v2 v3)                    -- le.eq
    ∷ ([] , #le v0 v0)                                                          -- le.refl
    ∷ ((#le v0 v1 ∷ #le v1 v0 ∷ []) , #eq v0 v1)                                -- le.antisym
    ∷ ((#le v0 v1 ∷ #le v1 v2 ∷ []) , #le v0 v2)                                -- le.trans
    ∷ ((#le v0 v1 ∷ []) , #le (#add v0 v2) (#add v1 v2))                        -- le.add
    ∷ ((#le #z0 v0 ∷ #le #z0 v1 ∷ []) , #le #z0 (#mul v0 v1))                   -- le.mul
    ∷ ([] , #le #z0 #z1)                                                        -- le.one
    ∷ ((#le #z1 #z0 ∷ []) , #false)                                             -- absurd
    ∷ ((#eq v0 v1 ∷ []) , #eq (#look v2 v0) (#look v2 v1))                      -- eq.look
    ∷ ([] , #eq (#ev #Vec⟨⟨i64ˌi128⟩⟩·nil v0) #z0)                              -- ev.nil
    ∷ ([] , #eq (#ev (#Vec⟨⟨i64ˌi128⟩⟩·cons (#Tup⟨ZˌZ⟩·mk v0 v1) v2) v3)
                (#add (#mul v1 (#look v3 v0)) (#ev v2 v3)))                     -- ev.cons
    ∷ ([] , #eq (#val (#Lin·mk v0 v1) v2) (#add (#ev v0 v2) v1))                -- val.lin
    ∷ ((#false ∷ []) , #eq v0 v1)                                               -- efq.eq
    ∷ ((#false ∷ []) , #le v0 v1)                                               -- efq.le
    ∷ []

  known-ok : All KnownOK known
  known-ok =
      (λ σ _ → ≈ᴿ-refl)
    ∷ (λ { σ (p ∷ []) → ≈ᴿ-sym (eqT p) })
    ∷ (λ { σ (p ∷ q ∷ []) → ≈ᴿ-trans (eqT p) (eqT q) })
    ∷ (λ { σ (p ∷ q ∷ []) → +ᴿ-cong (eqT p) (eqT q) })
    ∷ (λ { σ (p ∷ q ∷ []) → *ᴿ-cong (eqT p) (eqT q) })
    ∷ (λ { σ (p ∷ []) → neg-cong (eqT p) })
    ∷ (λ σ _ → +ᴿ-comm _ _)
    ∷ (λ σ _ → +ᴿ-assoc _ _ _)
    ∷ (λ σ _ → +ᴿ-zero _)
    ∷ (λ σ _ → +ᴿ-neg _)
    ∷ (λ σ _ → *ᴿ-comm _ _)
    ∷ (λ σ _ → *ᴿ-assoc _ _ _)
    ∷ (λ σ _ → *ᴿ-one _)
    ∷ (λ σ _ → *ᴿ-dist _ _ _)
    ∷ (λ { σ (p ∷ q ∷ s ∷ []) → ≤ᴿ-resp (leT p) (eqT q) (eqT s) })
    ∷ (λ σ _ → ≤ᴿ-refl)
    ∷ (λ { σ (p ∷ q ∷ []) → ≤ᴿ-antisym (leT p) (leT q) })
    ∷ (λ { σ (p ∷ q ∷ []) → ≤ᴿ-trans (leT p) (leT q) })
    ∷ (λ { σ (p ∷ []) → ≤ᴿ-add _ (leT p) })
    ∷ (λ { σ (p ∷ q ∷ []) → ≤ᴿ-mul (leT p) (leT q) })
    ∷ (λ σ _ → 0≤1)
    ∷ (λ { σ (p ∷ []) → 1≰0 (leT p) })
    ∷ (λ { σ (p ∷ []) → look-cong (σ 2) (eqT p) })
    ∷ (λ σ _ → ≈ᴿ-refl)
    ∷ (λ σ _ → ≈ᴿ-refl)
    ∷ (λ σ _ → ≈ᴿ-refl)
    ∷ (λ { σ (p ∷ []) → ⊥-elim (od-false p) })
    ∷ (λ { σ (p ∷ []) → ⊥-elim (od-false p) })
    ∷ []

  -- Every rule concludes another predicate or is one of those, which
  -- Agda checks by evaluation.
  Classified : Rule → Set
  Classified r = ¬ Arith (concl r) ⊎ Any (λ k → (prem r ≡ fst k) × (concl r ≡ snd k)) known

  classify? : (r : Rule) → Dec (Classified r)
  classify? r with not? (arith? (concl r))
  ... | yes n = yes (inl n)
  ... | no a with any? (λ k → (prem r ≟ₜs fst k) ×? (concl r ≟ₜ snd k)) known
  ...   | yes m = yes (inr m)
  ...   | no n  = no (λ { (inl x) → a x ; (inr x) → n x })

  classified : All Classified rules
  classified = witness (all? classify? rules) tt

  ----------------------------------------------------------------------
  -- OD is a model of the rules

  -- A rule instance is ground and well-sorted where its rule is.
  instance-gws : {r : Rule} → RuleWF r → (σ : Subst) → (∀ y → OccR y r → GroundWS (σ y) (rs r y))
               → GroundWS (sub σ (concl r)) (headSort (concl r))
  instance-gws {r} (_ , _ , w) σ ok =
      ground-sub σ (concl r) (λ x o → fst (ok x (inr o)))
    , ws-sub′ σ w (λ x o → snd (ok x (inr o)))

  closure : {r : Rule} → r ∈ rules → (σ : Subst) → (∀ y → OccR y r → GroundWS (σ y) (rs r y))
          → All (λ p → OD (sub σ p)) (prem r) → OD (sub σ (concl r))
  closure {r} m σ ok ps with all-∈ classified m
  ... | inl na = by m σ ok (keep (concl r) σ na) ps
  ... | inr km with all-any known-ok km
  ...   | k , okk , (e₁ , e₂) =
          atom (sub σ (concl r)) (instance-gws (all-∈ wf m) σ ok)
            (transport (λ c → Truth (sub σ c)) (sym e₂)
              (okk σ (transport (λ qs → All (λ p → OD (sub σ p)) qs) e₁ ps)))

  -- Instances binding the first variables to given terms, z0 after.
  bind2 : Tm → Tm → Subst
  bind2 a b zero          = a
  bind2 a b (suc zero)    = b
  bind2 a b (suc (suc _)) = #z0

  bind3 : Tm → Tm → Tm → Subst
  bind3 a b c zero       = a
  bind3 a b c (suc y)    = bind2 b c y

  support : {t : Tm} → OD t
          → Σ Rule (λ r → (r ∈ rules) × Σ Subst (λ σ →
              (∀ y → OccR y r → GroundWS (σ y) (rs r y)) × All (λ p → OD (sub σ p)) (prem r)
              × (t ≡ sub σ (concl r))))
  support (by m σ ok _ ps) = _ , m , σ , ok , ps , refl
  -- a = b by symmetry from b = a.
  support (truth (eqA {a} {b} ga gb) tr) =
    ʳeq·sym , lookup-∈ rules ⁱeq·sym refl , bind2 b a , ok
    , (truth (eqA gb ga) (≈ᴿ-sym tr) ∷ []) , refl
    where
      ok : ∀ y → OccR y ʳeq·sym → GroundWS (bind2 b a y) (rs ʳeq·sym y)
      ok zero          _ = gb
      ok (suc zero)    _ = ga
      ok (suc (suc _)) _ = gz0
  -- a ≤ b by transitivity from a ≤ a and a ≤ b.
  support (truth (leA {a} {b} ga gb) tr) =
    ʳle·trans , lookup-∈ rules ⁱle·trans refl , bind3 a a b , ok
    , (truth (leA ga ga) ≤ᴿ-refl ∷ truth (leA ga gb) tr ∷ []) , refl
    where
      ok : ∀ y → OccR y ʳle·trans → GroundWS (bind3 a a b y) (rs ʳle·trans y)
      ok zero                _ = ga
      ok (suc zero)          _ = ga
      ok (suc (suc zero))    _ = gb
      ok (suc (suc (suc _))) _ = gz0

  model : Model
  model = record { holds = OD ; closure = closure ; support = support }

  open CalculusIn sig rules model using (Valid; GW; Vars)

  ----------------------------------------------------------------------
  -- The theorem

  -- `fs` is a list of facts, each non-negative at x.
  data Facts (x : Tm) : Tm → Set where
    []  : Facts x #Vec⟨Lin⟩·nil
    _∷_ : {f fs : Tm} → 0ᴿ ≤ᴿ val f x → Facts x fs → Facts x (#Vec⟨Lin⟩·cons f fs)

  gval : {l x : Tm} → GroundWS l ˢLin → GroundWS x ˢX → GroundWS (#val l x) ˢZ
  gval (gl , wl) (gx , wx) =
      (λ { y (arg (hd o)) → gl y o ; y (arg (tl (hd o))) → gx y o ; y (arg (tl (tl ()))) })
    , node refl (wl ∷ wx ∷ [])

  -- True facts make `sat` hold.
  sat-od : {fs x : Tm} → Facts x fs → GroundWS fs ˢVec⟨Lin⟩ → GroundWS x ˢX → OD (#sat fs x)
  sat-od {x = x} [] _ gx =
    by (lookup-∈ rules ⁱsat·nil refl) (bind2 x #z0) ok (λ { (inl ()) ; (inr (inl ())) ; (inr (inr ())) }) []
    where
      ok : ∀ y → OccR y ʳsat·nil → GroundWS (bind2 x #z0 y) (rs ʳsat·nil y)
      ok zero          _ = gx
      ok (suc zero)    _ = gz0
      ok (suc (suc _)) _ = gz0
  sat-od {x = x} (_∷_ {f} {fs} p ps) (g , node _ (wf′ ∷ wfs ∷ [])) gx =
    by (lookup-∈ rules ⁱsat·cons refl) (bind3 f x fs) ok (λ { (inl ()) ; (inr (inl ())) ; (inr (inr ())) })
      (atom (#le #z0 (#val f x)) (gle , node refl (snd gz0 ∷ snd (gval gf gx) ∷ [])) p
       ∷ sat-od ps gfs gx ∷ [])
    where
      gf : GroundWS f ˢLin
      gf = (λ y o → g y (arg (hd o))) , wf′

      gfs : GroundWS fs ˢVec⟨Lin⟩
      gfs = (λ y o → g y (arg (tl (hd o)))) , wfs

      gle : Ground (#le #z0 (#val f x))
      gle y (arg (hd (arg ())))
      gle y (arg (tl (hd o))) = fst (gval gf gx) y o
      gle y (arg (tl (tl ())))

      ok : ∀ y → OccR y ʳsat·cons → GroundWS (bind3 f x fs y) (rs ʳsat·cons y)
      ok zero                _ = gf
      ok (suc zero)          _ = gx
      ok (suc (suc zero))    _ = gfs
      ok (suc (suc (suc _))) _ = gz0

  -- When `check` returns `Ok` (its rules hold of the values it ran on),
  -- no point satisfies the facts and the negated claim.
  sound : Valid goalH goalJ
        → {fs cl ws m x : Tm}
        → GroundWS fs ˢVec⟨Lin⟩ → GroundWS cl ˢLin → GroundWS ws ˢVec⟨i128⟩ → GroundWS m ˢZ → GroundWS x ˢX
        → OD (#fn·check (#Goal·mk fs cl) (#Certificate·mk ws) (#Result⟨i64ˌstr⟩·Ok m))
        → Facts x fs
        → val cl x +ᴿ 1ᴿ ≤ᴿ 0ᴿ
        → ⊥
  sound v {fs} {cl} {ws} {m} {x} gfs gcl gws gm gx ran facts claim =
    od-false (v γ gw (ran ∷ sat-od facts gfs gx ∷ atom _ (gle , node refl (wadd ∷ snd gz0 ∷ [])) claim ∷ []))
    where
      γ : Subst
      γ zero                            = fs
      γ (suc zero)                      = cl
      γ (suc (suc zero))                = ws
      γ (suc (suc (suc zero)))          = m
      γ (suc (suc (suc (suc zero))))    = x
      γ (suc (suc (suc (suc (suc _))))) = #z0

      gw : GW γ (Vars goalH goalJ)
      gw zero                            _ = gfs
      gw (suc zero)                      _ = gcl
      gw (suc (suc zero))                _ = gws
      gw (suc (suc (suc zero)))          _ = gm
      gw (suc (suc (suc (suc zero))))    _ = gx
      gw (suc (suc (suc (suc (suc _))))) _ = gz0

      wadd : WS (#add (#val cl x) #z1) ˢZ
      wadd = node refl (snd (gval gcl gx) ∷ node refl [] ∷ [])

      gle : Ground (#le (#add (#val cl x) #z1) #z0)
      gle y (arg (hd (arg (hd o))))          = fst (gval gcl gx) y o
      gle y (arg (hd (arg (tl (hd (arg ()))))))
      gle y (arg (hd (arg (tl (tl ())))))
      gle y (arg (tl (hd (arg ()))))
      gle y (arg (tl (tl ())))
