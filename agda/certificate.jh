// args: RULES OUTDIR. Export the exact theory, goals and certificate used
// to prove linear.check sound. OUTDIR must already exist. Consumers must
// check the proof themselves; generating these files is not verification.
import std.env
import std.fs
import std.sys
import proof.refine

fn write(dir: str, name: str, text: str) {
    match fs.write_file(dir + "/" + name, text) {
        Ok(_) => {}
        Err(e) => {
            eprintln("cannot write " + name + ": " + e.to_string().as_str())
            sys.exit(1)
        }
    }
}

fn main() {
    let a = env.args()
    if a.len() != 3 {
        eprintln("usage: certificate.jh RULES OUTDIR")
        sys.exit(1)
    }
    let Ok(rules) = fs.read_file(a[1]) else {
        eprintln("cannot read " + a[1])
        sys.exit(1)
    }
    let theory = refine.theory(rules.as_str())
    let goals = refine.goals()
    let proof = refine.certificate(theory.as_str())
    write(a[2], "check.theory", theory.as_str())
    write(a[2], "check.goals", goals.as_str())
    write(a[2], "check.proof", proof.as_str())
}
