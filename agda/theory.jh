// args: RULES. Prints, as the Agda module `Theory`, the theory in which
// lib/proof/refine.jh proves `check` sound: RULES (what `jihoo emit-horn
// --lib compiler/linear.jh --fn check` writes), the model and the proof's
// own rules. agda/Adequacy.agda reads it.
import std.env
import std.fs
import std.sys
import proof.refine
import proof.schematic

fn main() {
    let a = env.args()
    let Ok(rules) = fs.read_file(a[1]) else {
        println("cannot read " + a[1])
        sys.exit(1)
    }
    match schematic.agda(refine.theory(rules.as_str()).as_str(), "Theory") {
        Ok(text) => print(text)
        Err(e) => {
            println("invalid theory: " + e.as_str())
            sys.exit(1)
        }
    }
}
