import Jihoo.MixedTelescopeBridge
import Jihoo.CoreBridgeExamples

namespace Jihoo.CoreBridge.MixedBridge

/-- n, p : n=n, m, q : m<n, in that order. -/
def interleaved : Telescope := .proof
  (.natural (.proof (.natural .empty) (.eq (.var 0) (.var 0))))
  (.lt (.var 0) (.var 1))

theorem interleaved_wf : WellFormed interleaved := by
  refine .proof (.natural (.proof (.natural .empty) .eq ?_)) .lt ?_
  all_goals constructor <;> (dsimp only [Ty.Scoped, Index.Scoped]; decide)

theorem earlier_typed : SourceTyping interleaved.naturals interleaved.proofs
    (.var 1) (.eq (.var 1) (.var 1)) := by
  exact .var rfl ⟨by dsimp only [Index.Scoped]; decide,
    by dsimp only [Index.Scoped]; decide⟩

theorem recent_typed : SourceTyping interleaved.naturals interleaved.proofs
    (.var 0) (.lt (.var 0) (.var 1)) := by
  exact .var rfl ⟨by dsimp only [Index.Scoped]; decide,
    by dsimp only [Index.Scoped]; decide⟩

/-- The older proof is unified slot 2; the newest index is slot 1. -/
theorem interleaved_positions : interleaved.values 1 = 2 ∧ interleaved.indices 0 = 1 := by
  constructor <;> rfl

theorem earlier_true (hv : Indexed.Mixed.Valid interleaved.erase ρ) :
    Indexed.Mixed.Holds (.eq (.var 1) (.var 1)) ρ :=
  semantic_sound (A := .eq (.var 1) (.var 1)) interleaved_wf .eq earlier_typed hv

def universal : Telescope := .natural
  (.proof (.natural .empty) (.pi (.eq (.var 1) (.var 1))))

theorem universal_wf : WellFormed universal := by
  refine .natural (.proof (.natural .empty) (.all .eq) ?_)
  exact ⟨by dsimp only [Index.Scoped]; decide, by dsimp only [Index.Scoped]; decide⟩

def seven : Index := .lit ⟨7, by decide⟩

theorem universal_typed : SourceTyping universal.naturals universal.proofs
    (.app (.var 0) seven) (.eq (.var 1) (.var 1)) := by
  apply SourceTyping.app (B := .eq (.var 2) (.var 2))
  · exact .var rfl ⟨by dsimp only [Index.Scoped]; decide,
      by dsimp only [Index.Scoped]; decide⟩
  · trivial

/-- Every emitted declaration carries a derivation; adding an unproved example
cannot silently extend the generated fixture. -/
structure CheckedExample where
  name : String
  telescope : Telescope
  type : Ty
  term : Term
  formed : WellFormed telescope
  proposition : Indexed.Mixed.Proposition type.erase
  typed : SourceTyping telescope.naturals telescope.proofs term type

def checkedExamples : List CheckedExample := [
  ⟨"mixed_earlier", interleaved, .eq (.var 1) (.var 1), .var 1,
    interleaved_wf, .eq, earlier_typed⟩,
  ⟨"mixed_recent", interleaved, .lt (.var 0) (.var 1), .var 0,
    interleaved_wf, .lt, recent_typed⟩,
  ⟨"mixed_universal", universal, .eq (.var 1) (.var 1), .app (.var 0) seven,
    universal_wf, .eq, universal_typed⟩]

theorem CheckedExample.typed_closed (e : CheckedExample) :
    Raw.HasType (fun _ => none)
      (e.telescope.closeTerm (e.term.encode e.telescope.indices e.telescope.values))
      (e.telescope.closeType (e.type.encode e.telescope.indices)) :=
  closed_translation e.formed e.typed

theorem CheckedExample.true_in_valid_environment (e : CheckedExample)
    (hv : Indexed.Mixed.Valid e.telescope.erase ρ) : Indexed.Mixed.Holds e.type.erase ρ :=
  semantic_sound e.formed e.proposition e.typed hv

def generatedMixedProgram : Option String := do
  let declarations ← checkedExamples.mapM fun e => do
    let A ← (e.telescope.closeType (e.type.encode e.telescope.indices)).render 1024 []
    let t ← (e.telescope.closeTerm (e.term.encode e.telescope.indices e.telescope.values)).render 1024 []
    return "(def " ++ e.name ++ " " ++ A ++ " " ++ t ++ ")"
  return "; Generated by proofs/EmitMixedTelescope.lean. Do not edit by hand.\n" ++
    "; Each declaration has a source witness and a closed Raw typing theorem.\n" ++
    String.intercalate "\n" declarations ++ "\n"

end Jihoo.CoreBridge.MixedBridge
