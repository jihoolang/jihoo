import Jihoo.MixedProofTranslation
import Jihoo.MixedProofFunctionsExamples
import Jihoo.CoreBridgeExamples

namespace Jihoo.MixedProofFunctions.Bridge
open Arithmetic (Expr)
open Examples

/-- Every generated declaration requires both an actual source derivation and
representability; the unadmitted total helper cannot enter this fixture. -/
structure CheckedExample where
  name : String
  type : Formula
  value : Term
  typed : Derives 0 [] value type
  admitted : TermAdmitted value

def universalValue : Term :=
  .proofLam (.all same) (.naturalLam (.naturalApp (.hyp 0) (.var 0)))

def applied : Term := .proofApp (.naturalApp retain (.lit 7)) (.refl (.lit 7))

theorem applied_typed : Derives 0 [] applied (.all (.eq (.lit 7) (.lit 7))) :=
  .proofApp (.naturalApp retain_typed trivial) (.refl trivial)

def zeroValue : Term := .naturalLam (.zeroLe (.var 0))

theorem zero_typed : Derives 0 [] zeroValue (.all (.lt (.lit 0) (.add (.var 0) (.lit 1)))) :=
  .naturalLam (.zeroLe (by dsimp [Expr.Scoped]; decide))

def checkedExamples : List CheckedExample := [
  ⟨"translated_retain", .all (.arrow same (.all (.eq (.var 1) (.var 1)))), retain,
    retain_typed, ⟨⟨trivial, trivial⟩, trivial⟩⟩,
  ⟨"translated_higher", .all (.arrow (.arrow same same) (.arrow same same)), higher,
    higher_typed, ⟨⟨⟨trivial, trivial⟩, ⟨trivial, trivial⟩⟩,
      ⟨⟨trivial, trivial⟩, ⟨trivial, trivial⟩⟩⟩⟩,
  ⟨"translated_universal", .arrow (.all same) (.all same), universalValue,
    universal_argument, ⟨⟨trivial, trivial⟩, ⟨trivial, trivial⟩⟩⟩,
  ⟨"translated_applied", .all (.eq (.lit 7) (.lit 7)), applied,
    applied_typed, ⟨⟨⟨⟨trivial, trivial⟩, trivial⟩, by dsimp [IndexAdmitted]; decide⟩, by dsimp [TermAdmitted, IndexAdmitted]; decide⟩⟩,
  ⟨"translated_zero", .all (.lt (.lit 0) (.add (.var 0) (.lit 1))), zeroValue,
    zero_typed, trivial⟩,
  ⟨"translated_literal_bound", .lt (.lit 0) (.lit 1), .decide 0 1,
    .decide (by decide), ⟨by decide, by decide⟩⟩]

theorem CheckedExample.target_typed (e : CheckedExample) :
    CoreBridge.Raw.Beta.HasType (fun _ => none) (term id id e.value) (formula id e.type) :=
  translate_closed e.typed e.admitted

theorem CheckedExample.source_true (e : CheckedExample) (ρ : Arithmetic.Env) : e.type.Holds ρ :=
  e.typed.sound (by intro x P hx; simp at hx)

theorem subtraction_excluded : ¬ TermAdmitted (.refl (.sub (.lit 2) (.lit 1))) := by
  intro h
  exact h

theorem oversized_literal_excluded : ¬ TermAdmitted (.refl (.lit CoreBridge.wordBound)) :=
  Nat.lt_irrefl _

def generatedProgram : Option String := do
  let declarations ← checkedExamples.mapM fun e => do
    let A ← (formula id e.type).render 1024 []
    let t ← (term id id e.value).render 1024 []
    return "(def " ++ e.name ++ " " ++ A ++ " " ++ t ++ ")"
  return "; Generated by proofs/EmitMixedProofTranslation.lean. Do not edit.\n" ++
    "; Each declaration has source semantics and a ghost Raw.Beta typing proof.\n" ++
    String.intercalate "\n" declarations ++ "\n"

end Jihoo.MixedProofFunctions.Bridge
