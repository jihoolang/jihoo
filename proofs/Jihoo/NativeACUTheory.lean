import Jihoo.NativeACUAffine

/-! A structural quotient characterization of pure ACU on complete native terms.
This is the additive structural layer, separate from the extension containing
beta/projections/arithmetic. In particular its injectivity theorem is not claimed
for the full extension before the remaining modulo-confluence proof exists. -/
namespace Jihoo.NativeKernel.ACU

open Conversion (ListRel)

inductive Theory : Term → Term → Prop where
  | refl (t : Term) : Theory t t
  | symm : Theory a b → Theory b a
  | trans : Theory a b → Theory b c → Theory a c
  | node (op : Op) : ListRel Theory xs ys → Theory (.node op xs) (.node op ys)
  | assoc (a b c : Term) :
      Theory (.node .uadd [.node .uadd [a,b],c]) (.node .uadd [a,.node .uadd [b,c]])
  | comm (a b : Term) : Theory (.node .uadd [a,b]) (.node .uadd [b,a])
  | zero (a : Term) : Theory (.node .uadd [a,.node (.natural 0) []]) a

theorem Theory.toConv (h : Theory a b) : Conv a b := by
  induction h using Theory.rec
    (motive_2 := fun xs ys _ => ListRel Conv xs ys) with
  | refl => exact .refl _
  | symm _ ih => exact .symm ih
  | trans _ _ ia ib => exact ia.trans ib
  | node op _ ih => exact .node op ih
  | assoc a b c => exact .assoc a b c
  | comm a b => exact .comm a b
  | zero a => exact .zero a
  | nil => exact .nil
  | cons _ _ ia ib => exact .cons ia ib

theorem Theory.renaming (h : Theory a b) (ρ : Nat → Nat) : Theory (a.rename ρ) (b.rename ρ) := by
  induction h using Theory.rec
    (motive_2 := fun xs ys _ => ∀ op offset ρ,
      ListRel Theory (renameArgs op ρ offset xs) (renameArgs op ρ offset ys)) generalizing ρ with
  | refl => exact .refl _
  | symm _ ih => exact .symm (ih ρ)
  | trans _ _ ih₁ ih₂ => exact .trans (ih₁ ρ) (ih₂ ρ)
  | node op _ ih => simpa only [Term.rename] using Theory.node op (ih op 0 ρ)
  | assoc a b c =>
      simpa [Term.rename, renameArgs, Op.binders, liftRenaming] using
        Theory.assoc (a.rename ρ) (b.rename ρ) (c.rename ρ)
  | comm a b =>
      simpa [Term.rename, renameArgs, Op.binders, liftRenaming] using Theory.comm (a.rename ρ) (b.rename ρ)
  | zero a =>
      simpa [Term.rename, renameArgs, Op.binders, liftRenaming] using Theory.zero (a.rename ρ)
  | nil => simp [renameArgs]; exact .nil
  | cons _ _ ihx ihxs =>
      rename_i op offset ρ
      simp only [renameArgs]
      exact .cons (ihx _) (ihxs op (offset+1) ρ)

theorem Theory.substitution (h : Theory a b) (σ : Nat → Term) : Theory (a.subst σ) (b.subst σ) := by
  induction h using Theory.rec
    (motive_2 := fun xs ys _ => ∀ op offset σ,
      ListRel Theory (substArgs op σ offset xs) (substArgs op σ offset ys)) generalizing σ with
  | refl => exact .refl _
  | symm _ ih => exact .symm (ih σ)
  | trans _ _ ih₁ ih₂ => exact .trans (ih₁ σ) (ih₂ σ)
  | node op _ ih => simpa only [Term.subst] using Theory.node op (ih op 0 σ)
  | assoc a b c =>
      simpa [Term.subst, substArgs, Op.binders, liftSub] using
        Theory.assoc (a.subst σ) (b.subst σ) (c.subst σ)
  | comm a b =>
      simpa [Term.subst, substArgs, Op.binders, liftSub] using Theory.comm (a.subst σ) (b.subst σ)
  | zero a =>
      simpa [Term.subst, substArgs, Op.binders, liftSub] using Theory.zero (a.subst σ)
  | nil => simp [substArgs]; exact .nil
  | cons _ _ ihx ihxs =>
      rename_i op offset σ
      simp only [substArgs]
      exact .cons (ihx _) (ihxs op (offset+1) σ)


private theorem listRel_refl (r : ∀ x, R x x) (xs : List Term) : ListRel R xs xs := by
  induction xs with
  | nil => exact .nil
  | cons x xs ih => exact .cons (r x) ih

private theorem listRel_symm (s : ∀ {x y}, R x y → R y x) (h : ListRel R xs ys) :
    ListRel R ys xs := by
  induction h with
  | nil => exact .nil
  | cons h _ ia => exact .cons (s h) ia

private theorem listRel_trans (t : ∀ {x y z}, R x y → R y z → R x z)
    (h : ListRel R xs ys) (k : ListRel R ys zs) : ListRel R xs zs := by
  induction h generalizing zs with
  | nil => cases k; exact .nil
  | cons h hs ih => cases k with | cons k ks => exact .cons (t h k) (ih ks)

private theorem listRel_append (h : ListRel R xs ys) (k : ListRel R us vs) :
    ListRel R (xs ++ us) (ys ++ vs) := by
  induction h with
  | nil => exact k
  | cons h _ ih => exact .cons h ih

private theorem listRel_length (h : ListRel R xs ys) : xs.length = ys.length := by
  induction h <;> simp_all

/-- Equality of unordered spines generated by permutation and pointwise atom
relation, with explicit equivalence closure. No sorting order is postulated. -/
inductive Bag (R : Term → Term → Prop) : List Term → List Term → Prop where
  | refl (xs) : Bag R xs xs
  | symm : Bag R xs ys → Bag R ys xs
  | trans : Bag R xs ys → Bag R ys zs → Bag R xs zs
  | perm : xs.Perm ys → Bag R xs ys
  | pointwise : ListRel R xs ys → Bag R xs ys

theorem Bag.length (h : Bag R xs ys) : xs.length = ys.length := by
  induction h with
  | refl => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ia ib => exact ia.trans ib
  | perm h => exact h.length_eq
  | pointwise h => exact listRel_length h

theorem Bag.append_right (r : ∀ x, R x x) (h : Bag R xs ys) (zs : List Term) :
    Bag R (xs ++ zs) (ys ++ zs) := by
  induction h with
  | refl => exact .refl _
  | symm _ ih => exact .symm ih
  | trans _ _ ia ib => exact ia.trans ib
  | perm h => exact .perm (h.append_right _)
  | pointwise h => exact .pointwise (listRel_append h (listRel_refl r zs))

theorem Bag.append_left (r : ∀ x, R x x) (xs : List Term) (h : Bag R ys zs) :
    Bag R (xs ++ ys) (xs ++ zs) := by
  induction h with
  | refl => exact .refl _
  | symm _ ih => exact .symm ih
  | trans _ _ ia ib => exact ia.trans ib
  | perm h => exact .perm (h.append_left _)
  | pointwise h => exact .pointwise (listRel_append (listRel_refl r xs) h)

theorem Bag.append (r : ∀ x, R x x) (h : Bag R xs ys) (k : Bag R us vs) :
    Bag R (xs ++ us) (ys ++ vs) :=
  (h.append_right r us).trans (k.append_left r ys)

theorem Bag.singleton (r : ∀ x, R x x) (s : ∀ {x y}, R x y → R y x)
    (t : ∀ {x y z}, R x y → R y z → R x z) (h : Bag R [a] [b]) : R a b := by
  have main : ∀ {xs ys}, Bag R xs ys → ∀ a b, xs = [a] → ys = [b] → R a b := by
    intro xs ys h
    induction h with
    | refl xs =>
        intro a b ha hb
        have eq : a = b := by simpa [ha] using hb
        exact eq ▸ r a
    | symm _ ih => intro a b ha hb; exact s (ih b a hb ha)
    | trans h k ia ib =>
        intro a b ha hb
        have len := h.length
        rw [ha] at len
        obtain ⟨c, hc⟩ := List.length_eq_one_iff.mp len.symm
        exact t (ia a c ha hc) (ib c b hc hb)
    | perm h =>
        intro a b ha hb
        rw [ha,hb] at h
        have eq : a = b := List.singleton_perm_singleton.mp h
        exact eq ▸ r a
    | pointwise h =>
        intro a b ha hb
        rw [ha,hb] at h
        cases h with | cons h hs => exact h
  exact main h a b rfl rfl

private theorem listRel_perm_right (h : ListRel R xs ys) (p : ys.Perm zs) :
    ∃ us, xs.Perm us ∧ ListRel R us zs := by
  induction p generalizing xs with
  | nil => cases h; exact ⟨[],.nil,.nil⟩
  | cons y p ih =>
      cases h with
      | cons hx hs =>
          obtain ⟨us, hu, hr⟩ := ih hs
          exact ⟨_ :: us, hu.cons _, .cons hx hr⟩
  | swap a b ys =>
      cases h with
      | cons hb hs => cases hs with
        | cons ha hs => exact ⟨_ :: _ :: _, .swap _ _ _, .cons ha (.cons hb hs)⟩
  | trans p q ip iq =>
      obtain ⟨us, hu, hr⟩ := ip h
      obtain ⟨vs, hv, hs⟩ := iq hr
      exact ⟨vs,hu.trans hv,hs⟩

/-- Concrete matching characterization of the quotient bag relation. -/
theorem Bag.matching (r : ∀ x, R x x) (s : ∀ {x y}, R x y → R y x)
    (t : ∀ {x y z}, R x y → R y z → R x z) (h : Bag R xs ys) :
    ∃ zs, xs.Perm zs ∧ ListRel R zs ys := by
  induction h with
  | refl xs => exact ⟨xs,.refl _,listRel_refl r xs⟩
  | perm h => exact ⟨_,h,listRel_refl r _⟩
  | pointwise h => exact ⟨_,.refl _,h⟩
  | symm h ih =>
      obtain ⟨us,hp,hr⟩ := ih
      exact listRel_perm_right (listRel_symm s hr) hp.symm
  | trans h k ia ib =>
      obtain ⟨us,hp,hr⟩ := ia
      obtain ⟨vs,kp,kr⟩ := ib
      obtain ⟨ws,wp,wr⟩ := listRel_perm_right hr kp
      exact ⟨ws,hp.trans wp,listRel_trans t wr kr⟩

/-- Only the top additive spine is flattened; children of atoms retain their
full binding-aware syntax and their own recursively justified theory. -/
def flatten : Term → List Term
  | .node .uadd [a,b] => flatten a ++ flatten b
  | .node (.natural 0) [] => []
  | t => [t]
termination_by t => sizeOf t
decreasing_by all_goals simp_wf; all_goals omega

inductive AtomRel : Term → Term → Prop where
  | var (x : Nat) : AtomRel (.var x) (.var x)
  | node (op : Op) : ListRel Theory xs ys → AtomRel (.node op xs) (.node op ys)

theorem AtomRel.refl (t : Term) : AtomRel t t := by
  cases t with
  | var x => exact .var x
  | node op xs => exact .node op (listRel_refl Theory.refl xs)

theorem AtomRel.symm (h : AtomRel a b) : AtomRel b a := by
  cases h with
  | var x => exact .var x
  | node op h => exact .node op (listRel_symm Theory.symm h)

theorem AtomRel.trans (h : AtomRel a b) (k : AtomRel b c) : AtomRel a c := by
  cases h with
  | var x => cases k; exact .var x
  | node op h => cases k with | node _ k => exact .node op (listRel_trans Theory.trans h k)

def Model (a b : Term) : Prop := Bag AtomRel (flatten a) (flatten b)

private theorem Model.node (op : Op) (h : ListRel Theory xs ys) (ih : ListRel Model xs ys) :
    Model (.node op xs) (.node op ys) := by
  have atom : Bag AtomRel [.node op xs] [.node op ys] := .pointwise (.cons (.node op h) .nil)
  unfold Model
  cases op <;> try (simpa only [flatten] using atom)
  case uadd =>
    cases h with
    | nil => simpa only [flatten] using atom
    | cons ha hs =>
        cases hs with
        | nil => simpa only [flatten] using atom
        | cons hb hs =>
            cases hs with
            | nil =>
                cases ih with
                | cons ia is => cases is with | cons ib is =>
                    simpa only [flatten] using Bag.append AtomRel.refl ia ib
            | cons hc hs => simpa only [flatten] using atom
  case natural n =>
    cases n with
    | zero => cases h with
      | nil => simp only [flatten]; exact .refl []
      | cons ha hs => simpa only [flatten] using atom
    | succ n => simpa only [flatten] using atom

/-- Sound structural quotient semantics for all full native terms, including
malformed arities. This uses actual congruence proofs for every atom's children. -/
theorem Theory.model (h : Theory a b) : Model a b := by
  induction h using Theory.rec
    (motive_2 := fun xs ys _ => ListRel Model xs ys) with
  | refl => exact .refl _
  | symm _ ih => exact .symm ih
  | trans _ _ ia ib => exact ia.trans ib
  | node op h ih => exact Model.node op h ih
  | assoc a b c => simp only [Model, flatten, List.append_assoc]; exact .refl _
  | comm a b => simp only [Model, flatten]; exact .perm List.perm_append_comm
  | zero a => simp only [Model, flatten, List.append_nil]; exact .refl _
  | nil => exact .nil
  | cons _ _ ia ib => exact .cons ia ib

/-- Genuine rigid-constructor injectivity for pure ACU. The hypotheses merely
state that both displayed terms are atoms in the additive-spine decomposition. -/
theorem Theory.rigid_node_injective (h : Theory (.node op xs) (.node op' ys))
    (left : flatten (.node op xs) = [.node op xs])
    (right : flatten (.node op' ys) = [.node op' ys]) :
    op = op' ∧ ListRel Theory xs ys := by
  have hm := h.model
  unfold Model at hm
  rw [left,right] at hm
  have ha := hm.singleton AtomRel.refl AtomRel.symm AtomRel.trans
  cases ha with
  | node op h => exact ⟨rfl,h⟩

theorem Theory.pi_injective
    (h : Theory (.node (.pi e) [A,B]) (.node (.pi e') [A',B'])) :
    e = e' ∧ Theory A A' ∧ Theory B B' := by
  obtain ⟨eq, kids⟩ := h.rigid_node_injective (by simp only [flatten]) (by simp only [flatten])
  cases eq
  cases kids with
  | cons ha hs => cases hs with | cons hb _ => exact ⟨rfl,ha,hb⟩

theorem Theory.addCong (ha : Theory a a') (hb : Theory b b') :
    Theory (.node .uadd [a,b]) (.node .uadd [a',b']) :=
  .node .uadd (.cons ha (.cons hb .nil))

theorem Theory.zero_left (a : Term) : Theory (.node .uadd [.node (.natural 0) [],a]) a :=
  (Theory.comm _ _).trans (.zero a)

theorem Theory.sumTerms_append (xs ys : List Term) :
    Theory (.node .uadd [sumTerms xs,sumTerms ys]) (sumTerms (xs ++ ys)) := by
  induction xs with
  | nil => exact .zero_left _
  | cons x xs ih =>
      exact (Theory.assoc x (sumTerms xs) (sumTerms ys)).trans (.addCong (.refl x) ih)

theorem Theory.sumTerms_perm {xs ys : List Term} (h : xs.Perm ys) :
    Theory (sumTerms xs) (sumTerms ys) := by
  induction h with
  | nil => exact .refl _
  | cons x _ ih => exact .addCong (.refl x) ih
  | swap a b xs =>
      exact (Theory.assoc b a (sumTerms xs)).symm.trans
        ((Theory.addCong (Theory.comm b a) (.refl _)).trans (.assoc a b (sumTerms xs)))
  | trans _ _ ia ib => exact ia.trans ib

/-- Flattening uses genuine ACU equations, including the singleton's zero unit. -/
theorem Theory.flatten (t : Term) : Theory t (sumTerms (flatten t)) := by
  fun_induction ACU.flatten t with
  | case1 a b ia ib => exact (Theory.addCong ia ib).trans (Theory.sumTerms_append _ _)
  | case2 => exact .refl _
  | case3 t _ _ => exact (Theory.zero t).symm

theorem AtomRel.toTheory (h : AtomRel a b) : Theory a b := by
  cases h with
  | var x => exact .refl _
  | node op h => exact .node op h

theorem Bag.toTheory (h : Bag AtomRel xs ys) : Theory (sumTerms xs) (sumTerms ys) := by
  induction h with
  | refl => exact .refl _
  | symm _ ih => exact .symm ih
  | trans _ _ ia ib => exact ia.trans ib
  | perm h => exact Theory.sumTerms_perm h
  | pointwise h =>
      induction h with
      | nil => exact .refl _
      | cons ha hs ih => exact .addCong ha.toTheory ih

/-- Completeness of the structural additive quotient, proved by explicit ACU
reassociation/permutation derivations rather than an assumed interpretation. -/
theorem Model.complete (h : Model a b) : Theory a b :=
  (Theory.flatten a).trans (h.toTheory.trans (Theory.flatten b).symm)

theorem theory_iff_model (a b : Term) : Theory a b ↔ Model a b :=
  ⟨Theory.model, Model.complete⟩

end Jihoo.NativeKernel.ACU
