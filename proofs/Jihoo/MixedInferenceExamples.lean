import Jihoo.MixedInference
import Jihoo.MixedTelescopeBridgeExamples

namespace Jihoo.CoreBridge.Checked
open MixedBridge

private def num (n : Nat) (h : n < wordBound := by decide) : Index := .lit ⟨n, h⟩
private def int3 : Signed := ⟨3, by decide⟩

/-- No source typing witness is stored: the checker must compute the verdict. -/
structure Case where
  name : String
  telescope : Telescope
  type : Ty
  term : Term
  modelAccepts : Bool
  coreAccepts : Bool
  diagnostic : String := "core: type mismatch"

def cases : List Case := [
  ⟨"natural", .empty, .u64, .natural (num 7), true, true, ""⟩,
  ⟨"integer", .empty, .i64, .integer int3, true, true, ""⟩,
  ⟨"elements", .empty, .array (num 1), .elements [int3], true, true, ""⟩,
  ⟨"decide", .empty, .lt (num 2) (num 4), .decide ⟨2, by decide⟩ ⟨4, by decide⟩ (by decide), true, true, ""⟩,
  ⟨"reflexivity", .empty, .eq (num 7) (num 7), .refl (num 7), true, true, ""⟩,
  ⟨"array-index", .empty, .i64,
    .index (.elements [int3]) (num 0) (.decide ⟨0, by decide⟩ ⟨1, by decide⟩ (by decide)), true, true, ""⟩,
  ⟨"lambda", .empty, .pi (.eq (.var 0) (.var 0)), .lam (.refl (.var 0)), true, true, ""⟩,
  ⟨"application", .empty, .eq (num 7) (num 7), .app (.lam (.refl (.var 0))) (num 7), true, true, ""⟩,
  ⟨"proof-let", .empty, .pi (.eq (num 7) (num 7)),
    .letValue (.eq (num 7) (num 7)) (.refl (num 7)) (.lam (.var 0)), true, true, ""⟩,
  ⟨"mixed-variable", interleaved, .eq (.var 1) (.var 1), .var 1, true, true, ""⟩,
  ⟨"mixed-universal", universal, .eq (.var 1) (.var 1), .app (.var 0) (num 7), true, true, ""⟩,
  ⟨"wrong-index-proof", .empty, .i64,
    .index (.elements [int3]) (num 0) (.decide ⟨0, by decide⟩ ⟨2, by decide⟩ (by decide)), false, false, "core: type mismatch"⟩,
  ⟨"wrong-let-annotation", .empty, .eq (num 0) (num 1),
    .letValue (.eq (num 0) (num 1)) (.refl (num 0)) (.var 0), false, false, "core: type mismatch"⟩,
  ⟨"wrong-result", .empty, .eq (num 0) (num 1), .refl (num 0), false, false, "core: type mismatch"⟩,
  -- Intentional scope differences: Core supports these, SourceTyping does not.
  ⟨"excluded-zero-le", .empty, .lt (num 0) (.add (num 7) (num 1)), .zeroLe (num 7), false, true, ""⟩,
  ⟨"excluded-conversion", .empty, .eq (.add (num 1) (num 1)) (num 2),
    .letValue (.eq (.add (num 1) (num 1)) (num 2)) (.refl (num 2)) (.var 0), false, true, ""⟩]

/-- Kernel-checked computation of every model verdict, including exclusions. -/
theorem model_verdicts : cases.all (fun c =>
    check c.telescope.naturals c.telescope.proofs c.term c.type == c.modelAccepts) = true := by
  decide

theorem missing_variable : inferType 0 [] (.var 0) = none := rfl

theorem out_of_scope_index : inferType 0 [] (.refl (.var 0)) = none := rfl

theorem malformed_context_entry : inferType 0 [.eq (.var 0) (.var 0)] (.var 0) = none := rfl

theorem nonfunction_application : inferType 0 [] (.app (.natural (num 7)) (num 0)) = none := rfl

/-- The fixture reports both verdicts so intentional model exclusions are never
misrepresented as bugs or as a completeness claim about the actual checker. -/
def generatedInferenceCases : Option String := do
  let lines ← cases.mapM fun c => do
    if check c.telescope.naturals c.telescope.proofs c.term c.type != c.modelAccepts then none else do
      let A ← (c.telescope.closeType (c.type.encode c.telescope.indices)).render 1024 []
      let t ← (c.telescope.closeTerm (c.term.encode c.telescope.indices c.telescope.values)).render 1024 []
      return String.intercalate "\t" [c.name, toString c.modelAccepts, toString c.coreAccepts,
        c.diagnostic, "(def checked_case " ++ A ++ " " ++ t ++ ")"]
  return "# Generated by proofs/EmitMixedInference.lean; model and Core verdicts are distinct.\n" ++
    String.intercalate "\n" lines ++ "\n"

end Jihoo.CoreBridge.Checked
